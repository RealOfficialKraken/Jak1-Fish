;;-*-Lisp-*-
(in-package goal)
(bundles "JUN.DGO")

;;name: fish-main-menu.gc

(define *main-menu-camera-prepare-time* 0.0)

(define *main-menu-setting-owner* (the-as (pointer process) #f))

(defun main-menu-remove-owned-settings! ()
  (when *main-menu-setting-owner*
    (remove-setting
      *setting-control*
      (the-as process *main-menu-setting-owner*)
      #t)

    (set!
      *main-menu-setting-owner*
      (the-as (pointer process) #f)))

  (none))


(defun turn-to-scene-camera ((tpos vector) (cam-vec vector))
  (process-grab? *target*)

  (set-vector!
    (-> *target* control trans)
    (-> tpos x)
    (-> tpos y)
    (-> tpos z)
    1.0)

  (send-event
    *camera*
    'teleport-to-vector-start-string
    cam-vec)

  (send-event *target* 'draw #f)

  (none))

(defun revert-scene-camera ()
  (process-release? *target*)
  (send-event *target* 'draw #t)
  (none)
)

(defun main-menu-maintain-camera! ()
  (when
    (and
      in-main-menu?
      *main-menu-camera-ready?*
      (not *main-menu-new-game-transition?*)
      *target*
      *camera*)

    (set-vector! (-> *target* control trans) (-> *main-menu-target-pos* x) (-> *main-menu-target-pos* y) (-> *main-menu-target-pos* z) 1.0)

    (send-event *camera* 'teleport-to-vector-start-string *main-menu-camera-pos*))

  (none))

(defun main-menu-clear-fish! ()
  (kill-by-name "main-menu-precursor-towertop" *default-pool*)
  (kill-by-name "main-menu-orb-a" *default-pool*)
  (kill-by-name "main-menu-orb-b" *default-pool*)
  (kill-by-name "main-menu-orb-c" *default-pool*)
  (kill-by-name "main-menu-fish" *default-pool*)
  (kill-by-name "main-menu-fish-agent" *active-pool*)
  (set! *main-menu-fish-active-count* 0)
  (none))

(defun launch-main-mmenu ()
  (main-menu-remove-owned-settings!)

  (set!
    *main-menu-saved-default-allow-pause*
    (-> *setting-control* default allow-pause))

  (set! (-> *setting-control* default allow-pause) #f)
  (set! (-> *setting-control* target allow-pause) #f)
  (set! (-> *setting-control* current allow-pause) #f)

  (set! *main-menu-extra-blackout-set?* #f)
  (set! *main-menu-camera-ready?* #f)
  (set! *main-menu-initialized?* #f)
  (set! *main-menu-start-accepted?* #f)
  (set! *main-menu-progress-was-paused?* #f)
  (set! *main-menu-music-resumed?* #f)
  (set! *main-menu-music-paused-by-game?* #f)
  (set! *main-menu-pause-enabled?* #f)
  (set! *main-menu-new-game-transition?* #f)
  (set! *main-menu-new-game-transition-requested?* #f)
  (set! *main-menu-new-game-transition-time* 0.0)
  (set! *main-menu-transition-fish-cleared?* #f)
  (set! *main-menu-transition-warp-requested?* #f)
  (set! *main-menu-transition-warp-wait-time* 0.0)
  (set! *main-menu-bubble-time* 0.0)
  (set! *main-menu-camera-prepare-time* 0.0)

  (set-blackout-frames (seconds 2.0))
  (set! *main-menu-extra-blackout-set?* #t)

  (main-menu-clear-fish!)
  (set! *main-menu-fish-target-count* *main-menu-fish-type-count*)
  (set! *main-menu-next-fish-spawn-time* 2.0)
  (set! *main-menu-next-fish-type* 0)
  (set! *main-menu-next-fish-lower?* (rand-vu-percent? 0.5))
  (set! *main-menu-made-by-time* 0.0)
  (set! *main-menu-made-by-y* 112.0)
  (set! in-main-menu? #t)
  (none))

(defun main-menu-prepare-camera! ()
  (when
    (and
      in-main-menu?
      (not *main-menu-camera-ready?*)
      *target*
      *camera*
      *level*
      *spawn-actors*
      *display*
      (-> *level* play?))

    (cond
      ((or
          (= (-> *target* next-state name) 'target-warp-in)
          (= (-> *target* next-state name) 'target-warp-out))

        (set! *main-menu-camera-prepare-time* 0.0))

      (else
        (+!
          *main-menu-camera-prepare-time*
          (-> *display* seconds-per-frame))

        (when
          (>= *main-menu-camera-prepare-time* 1.0)

          (vector-copy!
            *main-menu-saved-jak-pos*
            (target-pos 0))

          (turn-to-scene-camera
            *main-menu-target-pos*
            *main-menu-camera-pos*)

          (set! *main-menu-camera-ready?* #t)))))

  (none))

(defun main-menu-initialize! ()
  (when
    (and
      in-main-menu?
      *main-menu-extra-blackout-set?*
      *main-menu-camera-ready?*
      (not *main-menu-initialized?*)
      *display*
      *game-info*
      (>=
        (current-time)
        (-> *game-info* blackout-time)))

    (set!
      *main-menu-saved-music-volume*
      (-> *setting-control* current music-volume))

    (set!
      *main-menu-setting-owner*
      (the-as (pointer process)
        (with-pp pp)))

    (set-setting! 'music-volume 'abs 0.0 0)
    (set-setting! 'allow-pause #f 0.0 0)
    (set-setting! 'allow-progress #t 0.0 0)
    (apply-settings *setting-control*)

    (play-main-music "menu-theme.mp3" 100)

    (set! *main-menu-made-by-time* 0.0)
    (set! *main-menu-made-by-y* 112.0)
    (set! *main-menu-initialized?* #t))

  (none))

(defun main-menu-restore-time-of-day! ()
  (when *time-of-day-proc*
    (let ((resume-ratio
          (if
            (> *main-menu-saved-time-ratio* 0.0)
            *main-menu-saved-time-ratio*
            (if *time-of-day-fast* 18000.0 300.0))))

      (set!
        (-> *time-of-day-proc* 0 time-ratio)
        resume-ratio))

    (set! *main-menu-time-frozen?* #f))

  (none))

(defun main-menu-update-time-of-day! ()
  (when *time-of-day-proc*
    (cond
      (in-main-menu?
        (when
          (not *main-menu-time-frozen?*)

          (set!
            *main-menu-saved-time-ratio*
            (if
              (> (-> *time-of-day-proc* 0 time-ratio) 0.0)
              (-> *time-of-day-proc* 0 time-ratio)
              (if *time-of-day-fast* 18000.0 300.0)))

          (set-time-of-day 8.1)

          (set! *main-menu-time-frozen?* #t))

        (set!
          (-> *time-of-day-proc* 0 time-ratio)
          0.0))

      (else
        (main-menu-restore-time-of-day!))))

  (none))

(defun main-menu-fish-species ((index int))
  (cond
    ((< index *fisher-species-count*) index)
    ((= index 7) (the-as int (fisher-species largemouth-ecofish)))
    ((= index 8) (the-as int (fisher-species eco-drum)))
    (else (the-as int (fisher-species eco-drum)))))

(defun main-menu-fish-suffix ((index int))
  (cond
    ((= index 7) 7)
    ((= index 8) 8)
    ((= index 9) 9)
    ((= index 10) 10)
    (else 2)))

(defun main-menu-fish-skelgroup ((index int))
  (cond
    ((= index 7) *catch-fishb-sgc*)
    ((= index 8) *catch-fisha-sgc*)
    ((or (= index 9) (= index 10)) *catch-fisha-sgc*)
    (else
      (the-as skeleton-group
        (->
          (fisher-species-info-for
            (main-menu-fish-species index))
          skeleton)))))

(defun main-menu-apply-fish-appearance!
  ((fish-proc manipy) (index int))

  (let* ((species (main-menu-fish-species index))
      (suffix (main-menu-fish-suffix index))
      (info (fisher-species-info-for species))
      (base-scale
        (fmax
          0.30
          (fmin 0.62 (* (-> info game-scale) 1.20))))
      (x-scale 1.0)
      (y-scale 1.0)
      (z-scale 1.0)
      (r (-> info color-r))
      (g (-> info color-g))
      (b (-> info color-b)))

    (cond
      ((= species (the-as int (fisher-species scout-fly)))
        (set! base-scale 0.40))

      ((= species (the-as int (fisher-species fire-canyon-cellfish)))
        (set! base-scale 0.30))

      ((= suffix 7)
        (set! base-scale 0.42)
        (set! r 0.62)
        (set! g 0.36)
        (set! b 0.12))

      ((= suffix 8)
        (set! base-scale 0.42)
        (set! r 0.56)
        (set! g 0.18)
        (set! b 0.88))

      ((= suffix 9)
        (set! base-scale 0.46)
        (set! r 0.56)
        (set! g 0.82)
        (set! b 0.62)
        (set! x-scale 0.13)
        (set! y-scale 0.20)
        (set! z-scale 2.35))

      ((= suffix 10)
        (set! base-scale 0.44)
        (set! r 0.82)
        (set! g 0.48)
        (set! b 0.16)
        (set! x-scale 1.18)
        (set! y-scale 1.12)
        (set! z-scale 1.18)))

    (set-vector!
      (-> fish-proc root scale)
      (* base-scale x-scale)
      (* base-scale y-scale)
      (* base-scale z-scale)
      1.0)

    (set! (-> fish-proc draw color-mult r) r)
    (set! (-> fish-proc draw color-mult g) g)
    (set! (-> fish-proc draw color-mult b) b)
    (set! (-> fish-proc draw color-mult a) 1.0))

  (none))

(defun main-menu-spawn-fish-attachments!
  ((self main-menu-fish-agent) (fish-proc manipy))

  (let ((suffix (main-menu-fish-suffix (-> self fish-index))))
    (cond
      ((= suffix 7)
        (set! (-> self attachment-a)
          (fisher-spawn-rare-attachment!
            fish-proc
            *towertop-sgc*
            *fisher-precursor-attachment-offset-game*
            0.020
            "main-menu-precursor-towertop")))

      ((= suffix 10)
        (set! (-> self attachment-a)
          (fisher-spawn-rare-attachment!
            fish-proc
            *money-sgc*
            *fisher-orb-attachment-offset-a-game*
            0.50
            "main-menu-orb-a"))

        (set! (-> self attachment-b)
          (fisher-spawn-rare-attachment!
            fish-proc
            *money-sgc*
            *fisher-orb-attachment-offset-b-game*
            0.46
            "main-menu-orb-b"))

        (set! (-> self attachment-c)
          (fisher-spawn-rare-attachment!
            fish-proc
            *money-sgc*
            *fisher-orb-attachment-offset-c-game*
            0.48
            "main-menu-orb-c")))))

  (none))

(defun main-menu-build-camera-basis! ()
  (when
    (and
      *camera*
      (> (-> *camera* num-slaves) 0))

    (let ((cam-mat
          (-> *camera* slave 0 0 tracking inv-mat)))

      (vector-copy!
        *main-menu-camera-right*
        (-> cam-mat vector 0))

      (set! (-> *main-menu-camera-right* w) 0.0)

      (singlefish-vector-normalize-safe!
        *main-menu-camera-right*
        1.0)

      (vector-copy!
        *main-menu-camera-up*
        (-> cam-mat vector 1))

      (set! (-> *main-menu-camera-up* w) 0.0)

      (singlefish-vector-normalize-safe!
        *main-menu-camera-up*
        1.0)

      (vector-copy!
        *main-menu-camera-forward*
        (-> cam-mat vector 2))

      (set! (-> *main-menu-camera-forward* w) 0.0)

      (singlefish-vector-normalize-safe!
        *main-menu-camera-forward*
        1.0)))

  (none))

(defun main-menu-fish-agent-remove! ((self main-menu-fish-agent))
  (when (-> self attachment-a)
    (let ((proc (ppointer->process (-> self attachment-a))))
      (when proc (deactivate proc)))
    (set! (-> self attachment-a) (the-as (pointer manipy) #f)))

  (when (-> self attachment-b)
    (let ((proc (ppointer->process (-> self attachment-b))))
      (when proc (deactivate proc)))
    (set! (-> self attachment-b) (the-as (pointer manipy) #f)))

  (when (-> self attachment-c)
    (let ((proc (ppointer->process (-> self attachment-c))))
      (when proc (deactivate proc)))
    (set! (-> self attachment-c) (the-as (pointer manipy) #f)))

  (when (-> self visual)
    (let ((proc (ppointer->process (-> self visual))))
      (when proc (deactivate proc)))
    (set! (-> self visual) (the-as (pointer manipy) #f)))

  (when (> *main-menu-fish-active-count* 0)
    (-! *main-menu-fish-active-count* 1))

  (none))

(defun singlefish-vector-normalize-safe! ((vec vector) (wanted-length float))
  (let ((current-length
        (singlefish-vector-length-safe vec)))

    (when (> current-length 0.000001)
      (let ((scale
            (/ wanted-length current-length)))

        (set! (-> vec x) (* (-> vec x) scale))
        (set! (-> vec y) (* (-> vec y) scale))
        (set! (-> vec z) (* (-> vec z) scale)))))

  vec)

(defun main-menu-fish-agent-position! ((self main-menu-fish-agent))
  (when
    (and
      (-> self visual)
      *camera*
      (> (-> *camera* num-slaves) 0))

    (main-menu-build-camera-basis!)

    (let* ((cam-slave
          (-> *camera* slave 0 0))

        (fish-proc
          (the-as manipy
            (-> (-> self visual) 0 self)))

        (position
          (new 'stack-no-clear 'vector))

        (offset
          (new 'stack-no-clear 'vector))

        (fish-forward
          (new 'stack-no-clear 'vector))

        (fish-down
          (new 'stack-no-clear 'vector))

        (rot
          (new 'stack-no-clear 'matrix))

        (screen-x
          (-
            (-> self travel)
            (meters 40.0))))

      (singlefish-vector-copy-safe!
        position
        (-> cam-slave trans))

      (singlefish-vector-scale-safe!
        offset
        *main-menu-camera-forward*
        (-
          (-> self depth)
          (meters 8.0)))

      (singlefish-vector-add-safe!
        position
        position
        offset)

      (singlefish-vector-scale-safe!
        offset
        *main-menu-camera-right*
        (* screen-x (-> self direction)))

      (singlefish-vector-add-safe!
        position
        position
        offset)

      (singlefish-vector-scale-safe!
        offset
        *main-menu-camera-up*
        (+
          (-> self height)
          (*
            (meters 0.06)
            (sin
              (+
                (*
                  (degrees 75.0)
                  *main-menu-made-by-time*)
                (*
                  (-> self height)
                  0.5))))))

      (singlefish-vector-add-safe!
        position
        position
        offset)

      (set!
        (-> fish-proc root trans quad)
        (-> position quad))

      (singlefish-vector-scale-safe!
        fish-forward
        *main-menu-camera-right*
        (-> self direction))

      (set! (-> fish-forward w) 0.0)

      (singlefish-vector-scale-safe!
        fish-down
        *main-menu-camera-up*
        -1.0)

      (set! (-> fish-down w) 0.0)

      (singlefish-vector-normalize-safe!
        fish-down
        1.0)

      (forward-down->inv-matrix
        rot
        fish-forward
        fish-down)

      (matrix->quaternion
        (-> fish-proc root quat)
        rot)))

  (none))

(defbehavior main-menu-fish-agent-init-by-other main-menu-fish-agent
  ((fish-index int)
    (start-travel float)
    (height float)
    (depth float)
    (direction float))

  (set! (-> self visual) (the-as (pointer manipy) #f))
  (set! (-> self attachment-a) (the-as (pointer manipy) #f))
  (set! (-> self attachment-b) (the-as (pointer manipy) #f))
  (set! (-> self attachment-c) (the-as (pointer manipy) #f))
  (set! (-> self fish-index) fish-index)
  (set! (-> self direction) direction)
  (set! (-> self speed) (rand-vu-float-range (meters 1.25) (meters 2.35)))
  (set! (-> self travel) start-travel)
  (set! (-> self height) height)
  (set! (-> self transition-start-height) height)
  (set! (-> self depth) depth)

  (when
    (and
      *camera*
      (> (-> *camera* num-slaves) 0))

    (let ((spawn-pos
          (new 'stack-no-clear 'vector)))

      (vector-copy!
        spawn-pos
        (-> *camera* slave 0 0 trans))

      (set!
        (-> self visual)
        (manipy-spawn
          spawn-pos
          #f
          (main-menu-fish-skelgroup fish-index)
          #f
          :from *default-dead-pool*
          :to *default-pool*
          :name "main-menu-fish"))

      (when (-> self visual)
        (let ((fish-proc
              (the-as manipy
                (-> (-> self visual) 0 self))))

          (send-event fish-proc 'anim-mode 'loop)
          (fisher-randomize-manipy-anim-frame! fish-proc)
          (main-menu-apply-fish-appearance! fish-proc fish-index)

          (send-event
            fish-proc
            'max-vis-dist
            (meters 999999.0))

          (main-menu-spawn-fish-attachments! self fish-proc)

          (+! *main-menu-fish-active-count* 1)

          (main-menu-fish-agent-position! self)))))

  (go-virtual main-menu-fish-swim))

(defstate main-menu-fish-swim (main-menu-fish-agent)
  :virtual #t
  :code
  (behavior ()
    (loop
      (when
        (or
          (not in-main-menu?)
          (not *main-menu-initialized?*)
          (not (-> self visual)))

        (main-menu-fish-agent-remove! self)
        (process-deactivate))

      (when
        (paused?)

        (suspend))

      (cond
        ((and
            *main-menu-new-game-transition?*
            (< *main-menu-new-game-transition-time* 4.0)
            (-> self visual))

          (let* ((linear-t
                (/ *main-menu-new-game-transition-time* 4.0))

              (smooth-t
                (*
                  linear-t
                  linear-t
                  (-
                    3.0
                    (* 2.0 linear-t)))))

            (set!
              (-> self height)
              (+
                (-> self transition-start-height)
                (*
                  (meters 36.0)
                  smooth-t)))

            (main-menu-fish-agent-position! self)))

        ((not *main-menu-new-game-transition?*)
          (+!
            (-> self travel)
            (*
              (-> self speed)
              (-> *display* seconds-per-frame)))

          (main-menu-fish-agent-position! self)

          (when
            (> (-> self travel) (meters 80.0))

            (main-menu-fish-agent-remove! self)
            (process-deactivate))))

      (when
        (and
          (= (main-menu-fish-suffix (-> self fish-index)) 8)
          (-> self visual)
          (zero? (mod (current-time) 6)))
        (let ((fish-proc (-> (-> self visual) 0 self)))
          (when fish-proc
            (launch-particles
              :system *sp-particle-system-3d*
              (-> *part-id-table* 3569)
              (-> (the-as manipy fish-proc) root trans)))))

      (suspend))))

(defun main-menu-spawn-fish-agent! ()
  (when
    (and
      in-main-menu?
      *main-menu-initialized?*
      (not *main-menu-new-game-transition?*)
      (< *main-menu-fish-active-count* *main-menu-fish-target-count*))

    (let ((spawn-height
          (if
            *main-menu-next-fish-lower?*
            (rand-vu-float-range
              (meters 3.0)
              (meters 11.0))
            (rand-vu-float-range
              (meters -11.0)
              (meters -3.0)))))

      (process-spawn
        main-menu-fish-agent
        *main-menu-next-fish-type*
        0.0
        spawn-height
        (rand-vu-float-range
          (meters 5.0)
          (meters 10.0))
        (if (rand-vu-percent? 0.5) 1.0 -1.0)
        :name "main-menu-fish-agent"
        *active-pool*)

      (set!
        *main-menu-next-fish-type*
        (mod
          (+ *main-menu-next-fish-type* 1)
          *main-menu-fish-type-count*))

      (set!
        *main-menu-next-fish-lower?*
        (not *main-menu-next-fish-lower?*))))

  (none))

(defun main-menu-update-fish! ()
  (when
    (and
      in-main-menu?
      *main-menu-initialized?*
      (>=
        *main-menu-made-by-time*
        *main-menu-next-fish-spawn-time*)
      (<
        *main-menu-fish-active-count*
        *main-menu-fish-target-count*))

    (main-menu-spawn-fish-agent!)

    (set!
      *main-menu-next-fish-spawn-time*
      (+
        *main-menu-made-by-time*
        (rand-vu-float-range 0.85 1.75))))

  (none))

(defun main-menu-update-bubbles! ()
  (when
    (and
      in-main-menu?
      *main-menu-initialized?*
      (not *main-menu-new-game-transition?*)
      *display*)

    (-!
      *main-menu-bubble-time*
      (-> *display* seconds-per-frame))

    (when
      (<= *main-menu-bubble-time* 0.0)

      (let ((bubble-pos
            (new 'stack-no-clear 'vector))

          (bubble-offset
            (new 'stack-no-clear 'vector)))

        (main-menu-build-camera-basis!)

        (vector-copy!
          bubble-pos
          *main-menu-camera-pos*)

        (singlefish-vector-scale-safe!
          bubble-offset
          *main-menu-camera-forward*
          (rand-vu-float-range
            (meters 1.0)
            (meters 6.0)))

        (singlefish-vector-add-safe!
          bubble-pos
          bubble-pos
          bubble-offset)

        (singlefish-vector-scale-safe!
          bubble-offset
          *main-menu-camera-right*
          (rand-vu-float-range
            (meters -8.0)
            (meters 8.0)))

        (singlefish-vector-add-safe!
          bubble-pos
          bubble-pos
          bubble-offset)

        (singlefish-vector-scale-safe!
          bubble-offset
          *main-menu-camera-up*
          (rand-vu-float-range
            (meters -8.0)
            (meters -3.0)))

        (singlefish-vector-add-safe!
          bubble-pos
          bubble-pos
          bubble-offset)

        (launch-particles
          :system *sp-particle-system-3d*
          (-> *part-id-table* 3574)
          bubble-pos))

      (set!
        *main-menu-bubble-time*
        (rand-vu-float-range 0.08 0.24))))

  (none))

(defun main-menu-update-progress-music! ()
  (when
    (and
      in-main-menu?
      *main-menu-initialized?*
      (not *main-menu-new-game-transition?*))

    (cond
      ((and
          (paused?)
          (not *main-menu-music-paused-by-game?*))

        (pause-main-music)
        (set! *main-menu-music-paused-by-game?* #t)
        (set! *main-menu-progress-was-paused?* #t))

      ((and
          (not (paused?))
          *main-menu-progress-was-paused?*)

        (resume-main-music)

        (set! *main-menu-music-paused-by-game?* #f)
        (set! *main-menu-progress-was-paused?* #f)
        (set! *main-menu-music-resumed?* #t)

        (set! *main-menu-start-accepted?* #f)

        (cpad-clear! 0 start)
        (cpad-clear! 0 x))))

  (none))

(defun main-menu-update-pause-lock! ()
  (when
    (and
      in-main-menu?
      *main-menu-initialized?*
      *setting-control*)

    (cond
      ((< *main-menu-made-by-time* 12.0)
        (set! (-> *setting-control* default allow-pause) #f)
        (set! (-> *setting-control* target allow-pause) #f)
        (set! (-> *setting-control* current allow-pause) #f)

        (set-setting! 'allow-pause #f 0.0 0)
        (apply-settings *setting-control*)

        (set! (-> *setting-control* target allow-pause) #f)
        (set! (-> *setting-control* current allow-pause) #f)
        (set! *main-menu-pause-enabled?* #f)

        (cpad-clear! 0 start))

      ((and
          (not *main-menu-new-game-transition?*)
          (not *main-menu-new-game-transition-requested?*)
          (not *main-menu-pause-enabled?*))

        (set!
          (-> *setting-control* default allow-pause)
          *main-menu-saved-default-allow-pause*)

        (remove-setting! 'allow-pause)
        (apply-settings *setting-control*)

        (set! *main-menu-pause-enabled?* #t))))

  (none))

(defun main-menu-update-title-screen! ()
  (when
    (and
      in-main-menu?
      *main-menu-initialized?*
      *display*
      (current-frame)
      (-> (current-frame) global-buf))

    (when
      (and
        (and
          (not *main-menu-start-accepted?*)
          (not *main-menu-new-game-transition?*))
        (>= *main-menu-made-by-time* 8.322))

      (draw-mod-menu-text-custom
        "THE"
        474
        36
        #f
        #f
        #t))

    (when
      (and
        (and
          (not *main-menu-start-accepted?*)
          (not *main-menu-new-game-transition?*))
        (>= *main-menu-made-by-time* 8.868))

      (draw-mod-menu-text-custom
        "FISHING"
        458
        60
        #f
        #f
        #t))

    (when
      (and
        (and
          (not *main-menu-start-accepted?*)
          (not *main-menu-new-game-transition?*))
        (>= *main-menu-made-by-time* 9.389))

      (draw-mod-menu-text-custom
        "LEGACY"
        442
        84
        #f
        #f
        #t))

    (when
      (and
        (and
          (not *main-menu-start-accepted?*)
          (not *main-menu-new-game-transition?*))
        (>= *main-menu-made-by-time* 12.0))

      (when
        (=
          (logand
            (the int (- *main-menu-made-by-time* 12.0))
            1)
          0)

        (draw-mod-menu-text-custom
          "PRESS START"
          256
          196
          #f
          #t
          #f))

      (when
        (and
          (not *main-menu-start-accepted?*)
          (not *main-menu-new-game-transition?*)
          (or
            (cpad-pressed? 0 start)
            (cpad-pressed? 0 x)))

        (cpad-clear! 0 start)
        (cpad-clear! 0 x)

        (set! *main-menu-start-accepted?* #t)
        (set! *main-menu-progress-was-paused?* #f)
        (set! *main-menu-music-resumed?* #f)

        (pause-main-music)

        (activate-progress
          *dproc*
          (progress-screen title)))))

  (none))

(defun main-menu-update-made-by! ()
  (when
    (and
      in-main-menu?
      *main-menu-initialized?*
      *display*)

    (+!
      *main-menu-made-by-time*
      (-> *display* seconds-per-frame))

    (when
      (and
        (current-frame)
        (-> (current-frame) global-buf))

      (cond
        ((< *main-menu-made-by-time* 4.0)
          (set! *main-menu-made-by-y* 112.0)

          (draw-mod-menu-text-custom
            "MADE BY KRAKEN"
            256
            (the int *main-menu-made-by-y*)
            #f
            #t
            #f))

        ((< *main-menu-made-by-time* 6.0)
          (let* ((transition
                (/ (- *main-menu-made-by-time* 4.0) 2.0))

              (back-strength
                1.70158)

              (bounce-out
                (*
                  transition
                  transition
                  (-
                    (* (+ back-strength 1.0) transition)
                    back-strength))))

            (set!
              *main-menu-made-by-y*
              (-
                112.0
                (* 320.0 bounce-out)))

            (draw-mod-menu-text-custom
              "MADE BY KRAKEN"
              256
              (the int *main-menu-made-by-y*)
              #f
              #t
              #f))))))

  (none))

(defun main-menu-request-new-game-transition! ()
  (when
    (and
      in-main-menu?
      *main-menu-initialized?*
      (not *main-menu-new-game-transition?*)
      (not *main-menu-new-game-transition-requested?*))

    (set! *main-menu-new-game-transition-requested?* #t)
    (set! *main-menu-start-accepted?* #t)
    (set! *main-menu-progress-was-paused?* #f)

    (hide-progress-screen)
    (set-master-mode 'game)
    (set-blackout-frames 0)

    (set! *main-menu-music-paused-by-game?* #f)
    (set! *main-menu-music-resumed?* #f)

    (sound-group-continue
      (sound-group
        sfx
        music
        dialog
        sog3
        ambient
        sog5
        sog6
        sog7)))

  (none))

(defun main-menu-start-new-game-transition! ()
  (when
    (and
      in-main-menu?
      *main-menu-initialized?*
      (not *main-menu-new-game-transition?*)
      *target*
      *camera*
      (> (-> *camera* num-slaves) 0))

    (stop-main-music)

    (set-master-mode 'game)
    (set-blackout-frames 0)

    (set-setting!
      'music-volume
      'abs
      (-> *pc-settings* memcard-volume-music)
      0)

    (set-setting!
      'sfx-volume
      'abs
      (-> *pc-settings* memcard-volume-sfx)
      0)

    (set-setting!
      'dialog-volume
      'abs
      (-> *pc-settings* memcard-volume-dialog)
      0)

    (apply-settings *setting-control*)

    (sound-group-continue
      (sound-group
        sfx
        music
        dialog
        sog3
        ambient
        sog5
        sog6
        sog7))

    (turn-to-scene-camera
      *main-menu-target-pos*
      *main-menu-camera-pos*)

    (vector-copy!
      *main-menu-new-game-camera-start*
      *main-menu-camera-pos*)

    (vector-copy!
      *main-menu-new-game-jak-start*
      *main-menu-target-pos*)

    (set! *main-menu-new-game-transition-requested?* #f)
    (set! *main-menu-new-game-transition-time* 0.0)
    (set! *main-menu-transition-fish-cleared?* #f)
    (set! *main-menu-transition-warp-requested?* #f)
    (set! *main-menu-transition-warp-wait-time* 0.0)
    (set! *main-menu-new-game-transition?* #t)
    (set! *main-menu-start-accepted?* #t)
    (set! *main-menu-progress-was-paused?* #f)
    (set! *main-menu-music-resumed?* #f))

  (none))

(defun main-menu-restore-gameplay-settings! ()
  (main-menu-remove-owned-settings!)

  (set-master-mode 'game)

  (set! *main-menu-saved-default-allow-pause* #t)
  (set! (-> *setting-control* default allow-pause) #t)
  (set! (-> *setting-control* default allow-progress) #t)

  (set!
    (-> *setting-control* default music-volume)
    (-> *pc-settings* memcard-volume-music))

  (set!
    (-> *setting-control* default sfx-volume)
    (-> *pc-settings* memcard-volume-sfx))

  (set!
    (-> *setting-control* default dialog-volume)
    (-> *pc-settings* memcard-volume-dialog))

  (apply-settings *setting-control*)

  (set! (-> *setting-control* target allow-pause) #t)
  (set! (-> *setting-control* current allow-pause) #t)
  (set! (-> *setting-control* target allow-progress) #t)
  (set! (-> *setting-control* current allow-progress) #t)

  (sound-group-continue
    (sound-group
      sfx
      music
      dialog
      sog3
      ambient
      sog5
      sog6
      sog7))

  (sound-set-volume
    (sound-group music)
    (-> *pc-settings* memcard-volume-music))

  (sound-set-volume
    (sound-group sfx)
    (-> *pc-settings* memcard-volume-sfx))

  (sound-set-volume
    (sound-group sog3)
    (-> *pc-settings* memcard-volume-sfx))

  (sound-set-volume
    (sound-group ambient)
    (-> *pc-settings* memcard-volume-sfx))

  (sound-set-volume
    (sound-group dialog)
    (-> *pc-settings* memcard-volume-dialog))

  (when *target*
    (process-release? *target*)
    (send-event *target* 'draw #t))

  (none))

(defun main-menu-finish-new-game-transition! ()
  (cond
    ((not *main-menu-transition-warp-requested?*)
      (main-menu-clear-fish!)

      (main-menu-restore-time-of-day!)

      (main-menu-remove-owned-settings!)

      (set!
        (-> *setting-control* default allow-pause)
        *main-menu-saved-default-allow-pause*)

      (set! (-> *setting-control* default allow-progress) #t)
      (apply-settings *setting-control*)

      (sound-group-continue
        (sound-group
          sfx
          music
          dialog
          sog3
          ambient
          sog5
          sog6
          sog7))

      (set-blackout-frames 0)

      (vector-copy!
        *main-menu-warp-in-end*
        *main-menu-saved-jak-pos*)

      (vector-copy!
        *main-menu-warp-in-start*
        *main-menu-saved-jak-pos*)

      (+!
        (-> *main-menu-warp-in-start* y)
        (meters 2.2))

      (when *target*
        (set!
          (-> *target* control trans quad)
          (-> *main-menu-warp-in-start* quad))

        (process-release? *target*)

        (logclear!
          (-> *target* draw status)
          (draw-status hidden))

        (send-event *target* 'draw #t)

        (let ((warp-event
              (new 'stack-no-clear 'event-message-block)))

          (set! (-> warp-event from) *target*)
          (set! (-> warp-event num-params) 3)
          (set! (-> warp-event message) 'change-state)
          (set! (-> warp-event param 0) (the-as uint target-warp-in))
          (set! (-> warp-event param 1) (the-as uint *main-menu-warp-in-start*))
          (set! (-> warp-event param 2) (the-as uint *main-menu-warp-in-end*))

          (send-event-function
            *target*
            warp-event)))

      (set! *main-menu-transition-warp-requested?* #t)
      (set! *main-menu-transition-warp-wait-time* 0.0))

    (else
      (+!
        *main-menu-transition-warp-wait-time*
        (-> *display* seconds-per-frame))

      (set-blackout-frames 0)

      (when
        (>= *main-menu-transition-warp-wait-time* 2.0)

        (main-menu-restore-gameplay-settings!)

        (when *camera*
          (send-event
            *camera*
            'change-state
            *camera-base-mode*
            0.0))

        (set! jak-warp-out #f)
        (set! *main-menu-new-game-transition?* #f)
        (set! *main-menu-new-game-transition-requested?* #f)
        (set! *main-menu-new-game-transition-time* 0.0)
        (set! *main-menu-transition-fish-cleared?* #f)
        (set! *main-menu-transition-warp-requested?* #f)
        (set! *main-menu-transition-warp-wait-time* 0.0)
        (set! *main-menu-pause-enabled?* #t)
        (set! *main-menu-extra-blackout-set?* #f)
        (set! *main-menu-camera-ready?* #f)
        (set! *main-menu-initialized?* #f)
        (set! *main-menu-start-accepted?* #f)
        (set! *main-menu-progress-was-paused?* #f)
        (set! *main-menu-music-resumed?* #f)
        (set! *main-menu-music-paused-by-game?* #f)
        (set! *main-menu-bubble-time* 0.0)
        (set! *main-menu-camera-prepare-time* 0.0)
        (set! in-main-menu? #f))))

  (none))

(defun main-menu-update-new-game-transition! ()
  (when
    (and
      in-main-menu?
      *main-menu-new-game-transition?*
      *display*
      *target*
      *camera*)

    (process-grab? *target*)

    (+!
      *main-menu-new-game-transition-time*
      (-> *display* seconds-per-frame))

    (cond
      ((< *main-menu-new-game-transition-time* 4.0)
        (process-grab? *target*)

        (set!
          (-> *target* control trans quad)
          (-> *main-menu-target-pos* quad))

        (send-event
          *camera*
          'teleport-to-vector-start-string
          *main-menu-camera-pos*)

        (set!
          (-> *target* control trans quad)
          (-> *main-menu-target-pos* quad)))

      ((< *main-menu-new-game-transition-time* 12.0)
        (when
          (not *main-menu-transition-fish-cleared?*)

          (main-menu-clear-fish!)
          (set! *main-menu-transition-fish-cleared?* #t))

        (let* ((pan-time
              (- *main-menu-new-game-transition-time* 4.0))

            (camera-linear-t
              (min
                1.0
                (/ pan-time 6.0)))

            (camera-smooth-t
              (*
                camera-linear-t
                camera-linear-t
                (-
                  3.0
                  (* 2.0 camera-linear-t))))

            (jak-linear-t
              (min
                1.0
                (/ pan-time 8.0)))

            (jak-smooth-t
              (*
                jak-linear-t
                jak-linear-t
                (-
                  3.0
                  (* 2.0 jak-linear-t)))))

          (vector-lerp!
            *main-menu-new-game-camera-current*
            *main-menu-new-game-camera-start*
            *main-menu-new-game-camera-pos*
            camera-smooth-t)

          (vector-lerp!
            *main-menu-new-game-jak-current*
            *main-menu-new-game-jak-start*
            *main-menu-saved-jak-pos*
            jak-smooth-t)

          (process-grab? *target*)

          (set!
            (-> *target* control trans quad)
            (-> *main-menu-new-game-jak-current* quad))

          (send-event
            *camera*
            'teleport-to-vector-start-string
            *main-menu-new-game-camera-current*)

          (set!
            (-> *target* control trans quad)
            (-> *main-menu-new-game-jak-current* quad))))

      (else
        (main-menu-finish-new-game-transition!))))

  (none))

(defun main-menu-exit-for-load! ()
  (when in-main-menu?
    (stop-main-music)

    (main-menu-clear-fish!)

    (when *target*
      (process-release? *target*)
      (logclear!
        (-> *target* draw status)
        (draw-status hidden))
      (send-event *target* 'draw #t))

    (when *camera*
      (send-event
        *camera*
        'change-state
        *camera-base-mode*
        0.0))

    (main-menu-restore-time-of-day!)

    (main-menu-remove-owned-settings!)

    (set! (-> *setting-control* default allow-pause) #t)
    (set! (-> *setting-control* default allow-progress) #t)

    (set-setting!
      'music-volume
      'abs
      (-> *pc-settings* memcard-volume-music)
      0)

    (set-setting!
      'sfx-volume
      'abs
      (-> *pc-settings* memcard-volume-sfx)
      0)

    (set-setting!
      'dialog-volume
      'abs
      (-> *pc-settings* memcard-volume-dialog)
      0)

    (apply-settings *setting-control*)

    (set! (-> *setting-control* target allow-pause) #t)
    (set! (-> *setting-control* current allow-pause) #t)
    (set! (-> *setting-control* target allow-progress) #t)
    (set! (-> *setting-control* current allow-progress) #t)

    (sound-group-continue
      (sound-group
        sfx
        music
        dialog
        sog3
        ambient
        sog5
        sog6
        sog7))

    (set! jak-warp-out #f)
    (set! *main-menu-extra-blackout-set?* #f)
    (set! *main-menu-camera-ready?* #f)
    (set! *main-menu-initialized?* #f)
    (set! *main-menu-start-accepted?* #f)
    (set! *main-menu-progress-was-paused?* #f)
    (set! *main-menu-music-resumed?* #f)
    (set! *main-menu-music-paused-by-game?* #f)
    (set! *main-menu-pause-enabled?* #t)
    (set! *main-menu-new-game-transition?* #f)
    (set! *main-menu-new-game-transition-requested?* #f)
    (set! *main-menu-new-game-transition-time* 0.0)
    (set! *main-menu-transition-fish-cleared?* #f)
    (set! *main-menu-transition-warp-requested?* #f)
    (set! *main-menu-transition-warp-wait-time* 0.0)
    (set! *main-menu-bubble-time* 0.0)
    (set! *main-menu-camera-prepare-time* 0.0)
    (set! in-main-menu? #f))

  (none))

(defun main-menu-abort-for-blackout! ()
  (set! jak-warp-out #f)
  (stop-main-music)

  (main-menu-clear-fish!)

  (set-setting!
    'music-volume
    'abs
    (-> *pc-settings* memcard-volume-music)
    0)

  (set-setting!
    'sfx-volume
    'abs
    (-> *pc-settings* memcard-volume-sfx)
    0)

  (set-setting!
    'dialog-volume
    'abs
    (-> *pc-settings* memcard-volume-dialog)
    0)

  (sound-group-continue
    (sound-group
      sfx
      music
      dialog
      sog3
      ambient
      sog5
      sog6
      sog7))

  (remove-setting! 'process-mask)

  (logior!
    (-> *setting-control* default process-mask)
    (process-mask pause menu))

  (set-setting! 'allow-pause #t 0.0 0)
  (set-setting! 'allow-progress #t 0.0 0)
  (apply-settings *setting-control*)

  (when *target*
    (process-release? *target*)
    (send-event *target* 'draw #t))

  (when *camera*
    (send-event
      *camera*
      'change-state
      *camera-base-mode*
      0.0))

  (main-menu-restore-time-of-day!)

  (main-menu-restore-gameplay-settings!)

  (set! *main-menu-time-frozen?* #f)
  (set! *main-menu-extra-blackout-set?* #f)
  (set! *main-menu-camera-ready?* #f)
  (set! *main-menu-initialized?* #f)
  (set! *main-menu-start-accepted?* #f)
  (set! *main-menu-progress-was-paused?* #f)
  (set! *main-menu-music-resumed?* #f)
  (set! *main-menu-music-paused-by-game?* #f)
  (set! *main-menu-pause-enabled?* #t)
  (set! *main-menu-new-game-transition?* #f)
  (set! *main-menu-new-game-transition-requested?* #f)
  (set! *main-menu-new-game-transition-time* 0.0)
  (set! *main-menu-transition-fish-cleared?* #f)
  (set! *main-menu-transition-warp-requested?* #f)
  (set! *main-menu-transition-warp-wait-time* 0.0)
  (set! *main-menu-bubble-time* 0.0)
  (set! *main-menu-camera-prepare-time* 0.0)
  (set! in-main-menu? #f)

  (none))

(defun main-menu-update! ()
  (when
    (and
      in-main-menu?
      *main-menu-initialized?*
      *game-info*
      (<
        (current-time)
        (-> *game-info* blackout-time)))

    (cond
      ((or
          *main-menu-new-game-transition-requested?*
          *main-menu-new-game-transition?*)

        (set-blackout-frames 0))

      (else
        (main-menu-abort-for-blackout!))))

  (main-menu-update-time-of-day!)

  (when in-main-menu?
    (main-menu-prepare-camera!)

    (when *main-menu-camera-ready?*
      (main-menu-maintain-camera!))

    (main-menu-initialize!)

    (when *main-menu-initialized?*
      (main-menu-update-pause-lock!)

      (cond
        (*main-menu-new-game-transition?*
          (main-menu-update-new-game-transition!))

        ((not (paused?))
          (main-menu-update-made-by!)
          (main-menu-update-bubbles!)
          (main-menu-update-fish!)
          (main-menu-update-title-screen!)))))

  (when
    (not in-main-menu?)
    (main-menu-update-fish!))

  (main-menu-update-progress-music!)

  (when
    (and
      in-main-menu?
      *main-menu-new-game-transition-requested?*
      (not (paused?)))

    (main-menu-start-new-game-transition!))
  (none))
