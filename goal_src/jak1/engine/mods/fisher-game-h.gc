;; Fish catalogue / geologist shared declarations.  These are implemented in
;; fish-spawnings.gc, but several are referenced earlier in that file and/or
;; from other mod files, so keep the header authoritative for forward refs.
(define-extern *fisher-catalog-world-preview-active?* symbol)
(define *fisher-geologist-dialogue-lines*
  (new 'static
    'boxed-array
    :type string
    "YOU TWO ARE HELPING OUT MY FRIEND"
    "WITH FISHING ARE YOU?"
    ""
    ""
    "WELL, WHILE I AM AGAINST THE NATURE"
    "OF FISHING FOR COMMODITY, I THINK IT'S"
    "NOBLE OF YOU GUYS TO HELP HIM FISH"
    "BACK POWER CELLS"
    "...MAYBE YOU TWO COULD HELP ME OUT"
    "AS WELL?"
    "I'VE GOT A RESEARCH PROJECT GOING."
    ""
    "I AM CATALOGING ALL FISH IN EVERY AREA."
    "IT'S A DIFFICULT TASK TO DO ALONE, BUT IF"
    "YOU TWO COULD BRING BACK THE FISH"
    "YOU FIND, IT WOULD MEAN THE WORLD TO ME."))
