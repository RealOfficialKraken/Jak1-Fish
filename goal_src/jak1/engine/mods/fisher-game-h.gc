(deftype main-menu-fish-agent (process)
  ((visual       (pointer manipy))
    (attachment-a (pointer manipy))
    (attachment-b (pointer manipy))
    (attachment-c (pointer manipy))
    (fish-index    int)
    (direction    float)
    (speed        float)
    (travel       float)
    (height       float)
    (transition-start-height float)
    (depth        float)
  )
  (:state-methods
    main-menu-fish-swim
  )
)

(defskelgroup *fisher-sgc*
  fisher
  fisher-lod0-jg
  fisher-idle-more-often-ja
  ((fisher-lod0-mg (meters 20)) (fisher-lod1-mg (meters 40)) (fisher-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 -6 0 14)
  :shadow fisher-shadow-mg)

(deftype fisher-man (process-taskable)
  ((dialogue-type         int)
    (dialogue-kind         int)
    (dialogue-page         int)
    (dialogue-hint-index   int)
    (level-name            symbol)
    (dialogue-char-count   int)
    (dialogue-char-timer   float)
    (dialogue-grabbed?     symbol)
    (shop-offset          float)
    (shop-message-time    float)
  )
  (:states
    idle
    dialogue
    shop
  )
)

(define *fisher-man* (the (pointer fisher-man) #f))

(deftype fisher-geologist (process-taskable)
  ((level-name          symbol)
    (dialogue-page       int)
    (dialogue-char-count int)
    (dialogue-char-timer float)
    (dialogue-grabbed?   symbol)
    (catalog-index       int)
    (catalog-model       (pointer manipy))
    (catalog-model-row   int)
    (catalog-yaw         float)
    (catalog-pitch       float)
    (catalog-saved-camera-read-analog symbol))
  (:states
    fisher-geologist-idle
    fisher-geologist-dialogue
    fisher-geologist-catalog))

(define *fisher-geologist* (the (pointer fisher-geologist) #f))
(define *fisher-catalog-row-count* 34)
