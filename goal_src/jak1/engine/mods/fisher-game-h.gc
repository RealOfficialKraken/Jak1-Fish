;;main menu fishing area type
(deftype main-menu-fish-agent (process)
  ((visual       (pointer manipy))
    (direction    float)
    (speed        float)
    (travel       float)
    (height       float)
    (transition-start-height float)
    (depth        float)
  )
  (:state-methods
    main-menu-fish-swim
  )
)

;;fisher man skeleton and custom taskable
(defskelgroup *fisher-sgc*
  fisher
  fisher-lod0-jg
  fisher-idle-more-often-ja
  ((fisher-lod0-mg (meters 20)) (fisher-lod1-mg (meters 40)) (fisher-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 -6 0 14)
  :shadow fisher-shadow-mg)

(deftype fisher-man (process-taskable)
  ((dialogue-type         int)
    (dialogue-kind         int)
    (dialogue-page         int)
    (dialogue-hint-index   int)
    (level-name            symbol)
    (dialogue-char-count   int)
    (dialogue-char-timer   float)
    (dialogue-grabbed?     symbol)
  )
  (:states
    idle
    dialogue
  )
)

(define *fisher-man* (the (pointer fisher-man) #f))

(deftype swimmer-pontoon (process-drawable)
  ((pontoon-type int)
  )
  (:states
    swimmer-pontoon-idle
    swimmer-pontoon-die
  )
)

(deftype swimmer-pontoonfive (swimmer-pontoon) ())

(deftype swimmer-pontoonten (swimmer-pontoon) ())

(define matt-str (new 'global 'string 2048 (the-as string #f)))

(define *pc-encoded-matt-str* (new 'global 'string 2048 (the-as string #f)))

(define *fish-ui-str* (new 'global 'string 256 (the-as string #f)))

(define *fisher-max-fish-slots* 22)

(deftype fisher-fish-slot (structure)
  ((visual             (pointer manipy))
    (species            int)
    (level              int)
    (suffix             int)
    (weight-tenths      int)
    (power-cell-task    int)
    (distance           float)
    (lane               float)
    (depth              float)
    (direction          float)
    (speed              float)
    (cooldown           float)
    (turn-time          float)
    (turn-old-direction float)
    (turn-side          float)
  )
)

;; My first Boxed external storage. Surprising I made 3 mode before doing stuff this way.
(deftype fisher-fish-runtime (basic)
  ((slot fisher-fish-slot 22 :inline) ;;max fish in a pool is 22
  )
)

(define *fisher-fish-runtime* (new 'global 'fisher-fish-runtime))

;;the master type for the minigame

(deftype fisher-game (process)
  ((location-id                   int)
    (pos                          vector :inline)
    (fishing-player-pos           vector :inline)
    (casted?                      symbol)
    (fisher-cam                   vector :inline)
    (fisher-look                  vector :inline)
    (camera-state                 symbol)
    (saved-camera-read-analog     symbol)
    (saved-external-cam-mode      symbol)
    (water-level                  float)
    (camera-underwater?           symbol)
    (cast-state                   symbol)
    (cast-charge                  float)
    (cast-charge-direction        float)
    (lure-pos                     vector :inline)
    (lure-cast-start              vector :inline)
    (lure-cast-end                vector :inline)
    (lure-cast-axis               vector :inline)
    (lure-camera-offset           vector :inline)
    (lure-camera-pos              vector :inline)
    (lure-camera-look             vector :inline)
    (cast-time                    float)
    (cast-duration                float)
    (camera-blend                 float)
    (lure-fall-speed              float)
    (lure-reel-x-speed            float)
    (lure-reel-y-speed            float)
    (lure-x-velocity              float)
    (lure-y-velocity              float)
    (playfield-angle              float)
    (playfield-axis               vector :inline)
    (camera-angle                 float)
    (camera-axis                  vector :inline)
    (camera-radius                float)
    (bubble-time                  float)
    (stored-music-vol             float)
    (reel-hint-time               float)
    (lure-stop-active?            symbol)
    (lure-stop-used?              symbol)
    (lure-stop-time               float)
    (lure-stop-cooldown           float)
    (lure-sink-active?            symbol)
    (lure-sink-used?              symbol)
    (lure-sink-time               float)
    (lure-sink-cooldown           float)
    (tug-line-active?             symbol)
    (tug-line-time                float)
    (tug-line-cooldown            float)
    (lure-snake                   (pointer manipy))
    (lure-snake-angle             vector :inline)
    (lure-snake-angular-speed     vector :inline)
    (lure-snake-last-anchor       vector :inline)
    (lure-snake-flow-time         float)
    (underwater-wave-time         float)
    (background-mist-time         float)
    (background-curtain-phase     float)
    (hooked-fish                  basic)
    (fish-state                   symbol)
    (fish-message                 basic)
    (fish-message-time            float)
    (fish-approach-speed          float)
    (buzzer-victory-pending?      symbol)
    (caught-buzzer-count          int)
    (caught-buzzer-task           int)
    (power-cell-victory-pending?  symbol)
    (caught-power-cell-task       int)
    (fish-count                   int)
    (fish-data                    fisher-fish-runtime)
    (hooked-fish-slot             int)
    (fish-hook-time               float)
    (fish-reel-progress           float)
    (fish-fight-time              float)
    (fish-fight-phase             float)
    (fish-fight-base-y            float)
    (reel-camera-blend            float)
    (hooked-fish-facing           vector :inline)
    (hooked-fish-last-hook-pos    vector :inline)
    (fish-fighting?               symbol)
    (hooked-fish-poison-dps       float)
    (fish-scare-on-arrival?       symbol)
    (caught-weight-tenths         int)
    (caught-orb-value             int)
    (caught-fish-species          int)
    (caught-fish-suffix           int)
    (caught-fish-level            int)
    (caught-fish-xp               int)
    (catch-transition-time        float)
    (catch-menu-offset            float)
    (sandover-eco-count           int)
    (sandover-largemouth-count    int)
    (fish-level-min               int)
    (fish-level-max               int)
  )
  (:state-methods idle fishing exit dead)
)

;; This type is in charge of labeling the fish with stats and mechanics for all species
(deftype singlefish-base (process-drawable)
  ((owner                       (pointer fisher-game))
    (species-name                string)
    (color-name                  string)
    (tier                        symbol)
    (prefix                      symbol)
    (level                       int)
    (weight-tenths               int)
    (orb-value                   int)
    (base-orb-value              int)
    (min-weight-tenths           int)
    (max-weight-tenths           int)
    (base-scale                  float)
    (visual-scale                float)
    (swim-speed                  float)
    (approach-speed              float)
    (nose-offset                 float)
    (model-forward-sign          float)
    (direction                   float)
    (home-y                      float)
    (lane-offset                 float)
    (left-distance               float)
    (right-distance              float)
    (turning?                    symbol)
    (turn-time                   float)
    (turn-duration               float)
    (turn-old-direction          float)
    (turn-side                   float)
    (hook-time                   float)
    (scared-time                 float)
    (next-fight-time             float)
    (fight-time                  float)
    (fight-phase                 float)
    (fight-base-y                float)
    (fight-pull                  float)
    (fighting?                   symbol)
    (caught?                     symbol)
    (session-id                  int)
    (forward                     vector :inline)
    (base-color                  vector :inline)
    (fish-color                  vector :inline)
  )
  (:state-methods
    singlefish-patrol
    singlefish-approach
    singlefish-hook-window
    singlefish-scared
    singlefish-reeling
    singlefish-catch-display
    singlefish-dead
  )
)

(deftype eco-drum (singlefish-base) ())

(define in-dialogue? #f)

(define di-s1 "")

(define di-s2 "")

(define di-s3 "")

(define di-s4 "")

(define log-id 0)

(define log-sec 0)

