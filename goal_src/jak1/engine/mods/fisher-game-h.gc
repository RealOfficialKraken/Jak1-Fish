(deftype singlefish-base (process-drawable)
  ((owner                       (pointer fisher-game))
    (species-name                string)
    (color-name                  string)
    (tier                        symbol)
    (prefix                      symbol)
    (level                       int)
    (weight-tenths               int)
    (orb-value                   int)
    (base-orb-value              int)
    (min-weight-tenths           int)
    (max-weight-tenths           int)
    (base-scale                  float)
    (visual-scale                float)
    (swim-speed                  float)
    (nose-offset                 float)
    (model-forward-sign          float)
    (direction                   float)
    (home-y                      float)
    (lane-offset                 float)
    (left-distance               float)
    (right-distance              float)
    (turning?                    symbol)
    (turn-time                   float)
    (turn-duration               float)
    (turn-old-direction          float)
    (turn-side                   float)
    (hook-time                   float)
    (scared-time                 float)
    (next-fight-time             float)
    (fight-time                  float)
    (fight-phase                 float)
    (fight-base-y                float)
    (fight-pull                  float)
    (fighting?                   symbol)
    (caught?                     symbol)
    (session-id                  int)
    (forward                     vector :inline)
    (base-color                  vector :inline)
    (fish-color                  vector :inline))
  (:state-methods
    singlefish-patrol
    singlefish-approach
    singlefish-hook-window
    singlefish-scared
    singlefish-reeling
    singlefish-catch-display
    singlefish-dead))

(deftype eco-drum (singlefish-base) ())

(define in-dialogue? #f)

(define di-s1 "")

(define di-s2 "")

(define di-s3 "")

(define di-s4 "")

(define log-id 0)

(define log-sec 0)

