  (lurker-shark 3)
  (scout-fly 4)
  (poisonous-eelfish 5)
  (fire-canyon-cellfish 6)
  (electric-grubfish 7)
  (electric-eelfish 8)
  (electric-lurker-shark 9)
  (swamp-guppie 10)
  (sludge-crappie 11)
  (black-lurker-shark 12)
  (lava-drum 13)
  (magma-serpent 14)
  (inferno-shark 15)
  (frost-biter 16)
  (crystal-fish 17)
  (ice-shark 18)
  (helix-voidfish 19)
  (dark-precursor-fangfish 20)
  (phantasm-shark 21)
  (megaloviathan 22)
  (nuclear-bombfish 23))

(defenum fisher-zone
  (sandover-dock 0)
  (jungle-pillar 1)
  (training-lagoon 2)
  (sentinel-pontoon 3)
  (misty-island 4)
  (village2-electric 5)
  (sunken-voltage 6)
  (swamp-sludge 7)
  (village3-lava 8)
  (snow-ice 9)
  (maincave-dark-eco 10)
  (finalboss-nuclear 11))

(deftype fisher-species-info (basic)
  ((name                 string)
    (skeleton             basic)
    (min-weight-tenths    int32)
    (max-weight-tenths    int32)
    (orb-value-multiplier float)
    (catch-scale          float)
    (game-scale           float)
    (color-r              float)
    (color-g              float)
    (color-b              float)
    (depth-min            float)
    (depth-max            float)
    (fight-chance         float)
    (fight-mode           int32)
    (fight-pull-speed     float)
    (fight-recover-min    float)
    (fight-recover-max    float)
    (button-count-min     int32)
    (button-count-max     int32)
    (button-launch-min    float)
    (button-launch-max    float)
    (button-rise-speed    float)
    (button-gravity       float)
    (button-damage-scale  float)
    (button-miss-scale    float)
    (snap-on-bite?        symbol)))

(deftype fisher-zone-info (basic)
  ((level-min               int32)
    (level-max               int32)
    (normal-fish-count-min  int32)
    (normal-fish-count-max  int32)
    (golden-fish-count-min  int32)
    (golden-fish-count-max  int32)
    (species                int32 4)
    (normal-min             int32 4)
    (normal-max             int32 4)
    (golden-min             int32 4)
    (golden-max             int32 4)
    (shark-chance           float)
    (fire-canyon-cellfish?  symbol)))

(define *fisher-species-count* 24)
(define *fisher-zone-count* 12)

(deftype fisher-species-table (basic)
  ((entry fisher-species-info 24 :inline)))

(deftype fisher-zone-table (basic)
  ((entry fisher-zone-info 12 :inline)))

(define *fisher-species-table* (new 'global 'fisher-species-table))
(define *fisher-zone-table* (new 'global 'fisher-zone-table))

(defmacro fisher-species-info-for (species)
  `(-> *fisher-species-table* entry (the-as int ,species)))

(defmacro fisher-zone-info-for (zone)
  `(-> *fisher-zone-table* entry (the-as int ,zone)))


(deftype fisher-fish-slot (structure)
  ((visual             (pointer manipy))
    (species            int)
    (level              int)
    (suffix             int)
    (weight-tenths      int)
    (power-cell-task    int)
    (distance           float)
    (lane               float)
    (depth              float)
    (direction          float)
    (speed              float)
    (cooldown           float)
    (turn-time          float)
    (turn-old-direction float)
    (turn-side          float)
  )
)

(deftype fisher-fish-runtime (basic)
  ((slot fisher-fish-slot 30 :inline)
  )
)

(define *fisher-fish-runtime* (new 'global 'fisher-fish-runtime))


