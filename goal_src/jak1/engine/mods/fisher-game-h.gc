;;-*-Lisp-*-
(in-package goal)
(bundles "JUN.DGO")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Shared fishing declarations
;; Compile this file before every other fishing source file.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *fisher-level-cap* 20)

(define *fisher-line-hp-max* 100.0)

(define *fisher-line-hp* 100.0)

(define *fisher-line-broken?* #f)

(define *singlefish-session-id* 0)

(define *singlefish-session-active?* #f)

(define *fisher-in-debug?* #f)

(define *fisher-underwater-haze-override?* #f)

(define *fisher-underwater-haze-color* (new 'global 'vector))

(define *fisher-spawn-player-pos* (new 'global 'vector))

(define *singlefish-dead-pool* (new 'global 'dead-pool 22 (* 128 1024) '*singlefish-dead-pool*))

(define in-main-menu? #f)

(define *main-menu-extra-blackout-set?* #f)

(define *main-menu-camera-ready?* #f)

(define *main-menu-initialized?* #f)

(define *main-menu-time-frozen?* #f)

