(define *main-menu-bubble-time* 0.0)

(define *main-menu-fish-type-count* 3)

(define *main-menu-fish-target-count* 9)

(define *main-menu-fish-active-count* 0)

(define *main-menu-next-fish-spawn-time* 2.0)

(define *main-menu-next-fish-lower?* #f)

(define *main-menu-camera-forward* (new 'global 'vector))

(define *main-menu-camera-right* (new 'global 'vector))

(define *main-menu-camera-up* (new 'global 'vector))

(define *main-menu-made-by-time* 0.0)

(define *main-menu-made-by-y* 112.0)

(define *main-menu-saved-music-volume* 0.0)

(define *training-pontoon-spawned?* #f)

(define *main-menu-saved-jak-pos*
  (new 'global 'vector))

(define *main-menu-camera-pos*
  (new 'static 'vector
    :x (meters -1298.6059)
    :y (meters 152.8300)
    :z (meters 1044.6289)
    :w 1.0))

(define *main-menu-target-pos*
  (new 'static 'vector
    :x (meters -1312.8790)
    :y (meters 189.8300)
    :z (meters 1062.1098)
    :w 1.0))

(define *main-menu-new-game-camera-pos*
  (new 'static 'vector
    :x (meters -1298.4235)
    :y (meters 14.5129)
    :z (meters 1030.8201)
    :w 1.0))

(define *main-menu-new-game-camera-start*
  (new 'global 'vector))

(define *main-menu-new-game-jak-start*
  (new 'global 'vector))

(define *main-menu-new-game-camera-current*
  (new 'global 'vector))

(define *main-menu-new-game-jak-current*
  (new 'global 'vector))

(define *main-menu-warp-in-start*
  (new 'global 'vector))

(define *main-menu-warp-in-end*
  (new 'global 'vector))

(deftype main-menu-fish-agent (process)
  ((visual       (pointer manipy))
    (direction    float)
    (speed        float)
    (travel       float)
    (height       float)
    (transition-start-height float)
    (depth        float))
  (:state-methods
    main-menu-fish-swim))

(defskelgroup *fisher-sgc*
  fisher
  fisher-lod0-jg
  fisher-idle-more-often-ja
  ((fisher-lod0-mg (meters 20)) (fisher-lod1-mg (meters 40)) (fisher-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 -6 0 14)
  :shadow fisher-shadow-mg)

(deftype fisher-man (process-taskable)
  ((dialogue-type         int)
   (dialogue-kind         int)
   (dialogue-page         int)
   (level-name            symbol)
   (dialogue-char-count   int)
   (dialogue-char-timer   float)
   (dialogue-grabbed?     symbol))
  (:states
    idle
    dialogue))

(define *fisher-man* (the (pointer fisher-man) #f))

(deftype swimmer-pontoon (process-drawable)
  ((pontoon-type int))
  (:states
    swimmer-pontoon-idle
    swimmer-pontoon-die))

(deftype swimmer-pontoonfive (swimmer-pontoon) ())

(deftype swimmer-pontoonten (swimmer-pontoon) ())

(define matt-str (new 'global 'string 2048 (the-as string #f)))

(define *pc-encoded-matt-str* (new 'global 'string 2048 (the-as string #f)))

(define *fish-ui-str* (new 'global 'string 256 (the-as string #f)))

