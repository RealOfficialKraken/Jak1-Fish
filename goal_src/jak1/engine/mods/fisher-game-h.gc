(deftype singlefish-base (process-drawable)
  ((owner                       (pointer fisher-game))
    (species-name                string)
    (color-name                  string)
    (tier                        symbol)
    (prefix                      symbol)
    (level                       int)
    (weight-tenths               int)
    (orb-value                   int)
    (base-orb-value              int)
    (min-weight-tenths           int)
    (max-weight-tenths           int)
    (base-scale                  float)
    (visual-scale                float)
    (swim-speed                  float)
    (approach-speed              float)
    (nose-offset                 float)
    (model-forward-sign          float)
    (direction                   float)
    (home-y                      float)
    (lane-offset                 float)
    (left-distance               float)
    (right-distance              float)
    (turning?                    symbol)
    (turn-time                   float)
