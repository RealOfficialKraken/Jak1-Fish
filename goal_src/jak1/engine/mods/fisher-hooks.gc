(defun fisher-finalboss-target-on-ground? ()
  (and
    *target*
    (logtest?
      (-> *target* control status)
      (cshape-moving-flags onsurf onground tsurf))))

(defun fisher-finalboss-spawn-back-fish! ()
  (let ((rt *fisher-finalboss-runtime*))
    (when (not (-> rt carry-fish))
      (let ((fish
            (manipy-spawn
              (target-pos 0)
              #f
              *sharkey-sgc*
              #f
              :from *default-dead-pool*
              :to *default-pool*
              :name "fisher-finalboss-bombfish-back")))
        (set! (-> rt carry-fish) fish)
        (when fish
          (let ((fp (the-as manipy (ppointer->process fish))))
            (when fp
              (send-event fp 'anim-mode 'loop)
              (send-event fp 'max-vis-dist (meters 999999.0))
              (set-vector! (-> fp root scale) 0.279 0.324 0.698 1.0)
              (set-vector! (-> fp draw color-mult) 0.0 0.0 0.0 8.0)
              (set-vector! (-> fp draw color-emissive) 0.0 0.0 0.0 1.0)))))))
  (none))

(defun fisher-finalboss-update-back-fish! ()
  (let ((rt *fisher-finalboss-runtime*))
    (when (and *target* (-> rt carry-fish))
      (let ((fp (the-as manipy (ppointer->process (-> rt carry-fish)))))
        (when fp
          (let ((back (new 'stack-no-clear 'vector))
                (down (new 'stack-no-clear 'vector))
                (rot (new 'stack-no-clear 'matrix))
                (yaw (y-angle (-> *target* control))))
            (set-vector! back (- (sin yaw)) 0.0 (- (cos yaw)) 0.0)
            (vector-normalize! back 1.0)
            (vector-copy! (-> fp root trans) (-> *target* control trans))
            (vector+float*! (-> fp root trans) (-> fp root trans) back (meters 0.28))
            (+! (-> fp root trans y) (meters 1.35))
            (set! (-> fp root trans w) 1.0)
            (set-vector! down 0.0 -1.0 0.0 0.0)
            (forward-down->inv-matrix rot back down)
            (matrix->quaternion (-> fp root quat) rot))))))
  (none))

(defun fisher-finalboss-pulse-back-fish! ((elapsed float))
  (let ((fish (-> *fisher-finalboss-runtime* carry-fish)))
    (when fish
      (let ((fp (the-as manipy (ppointer->process fish))))
        (when fp
          (let ((p (+ 1.0 (* 0.12 (sin (* (degrees 720.0) elapsed))))))
            (set-vector! (-> fp root scale) (* 0.279 p) (* 0.324 p) (* 0.698 p) 1.0)
            (set-vector! (-> fp draw color-mult) 1.25 0.003 0.003 8.0))))))
  (none))

(defun fisher-finalboss-begin-carry! ()
  (let ((rt *fisher-finalboss-runtime*))
    (fisher-finalboss-spawn-back-fish!)
    (when *target* (process-grab? *target*))
    (set! (-> rt state) 'carry)
    (set! (-> rt carry-time) 0.0)
    (set! (-> rt prompt-time) 0.0))
  (none))

(defun fisher-finalboss-begin-throw! ()
  (let ((rt *fisher-finalboss-runtime*))
    (when (and (-> rt carry-fish) (ppointer->process (-> rt carry-fish)))
      (vector-copy!
        (-> rt throw-start)
        (-> (the-as manipy (ppointer->process (-> rt carry-fish))) root trans)))
    (vector-copy! (-> rt throw-target) *fisher-finalboss-robot-head-target*)
    (set! (-> rt throw-time) 0.0)
    (set! (-> rt state) 'throwing)
    (when *target* (process-release? *target*)))
  (none))

(defun fisher-finalboss-update-throw! ()
  (let* ((rt *fisher-finalboss-runtime*)
         (dt (-> *display* seconds-per-frame)))
    (+! (-> rt throw-time) dt)
    (let ((t (fmin 1.0 (/ (-> rt throw-time) 1.20))))
      (when (and (-> rt carry-fish) (ppointer->process (-> rt carry-fish)))
        (let ((fp (the-as manipy (ppointer->process (-> rt carry-fish)))))
          (vector-lerp! (-> fp root trans) (-> rt throw-start) (-> rt throw-target) t)
          (+! (-> fp root trans y) (* (meters 5.0) 4.0 t (- 1.0 t)))
          (set! (-> fp root trans w) 1.0)))
      (when (>= t 1.0)
        (when (-> rt carry-fish)
          (let ((p (ppointer->process (-> rt carry-fish))))
            (if p (deactivate p))))
        (set! (-> rt carry-fish) (the-as (pointer manipy) #f))
        (when *fisher-finalboss-hold-music-mute?*
          (remove-setting! 'music-volume)
          (set! *fisher-finalboss-hold-music-mute?* #f))
        (when *fisher-finalboss-danger-music-active?*
          (stop-main-music)
          (set! *fisher-finalboss-danger-music-active?* #f))
        (set! (-> rt state) 'done)
        (set! (-> rt progress) 5)
        (set! *boss-defeated* #t))))
  (none))

(defun maintain-fisher-finalboss-intermission! ()
  (let* ((inside (when *level* (level-get-target-inside *level*)))
         (in-finalboss? (and inside (= (-> inside name) 'finalboss))))
    (cond
      ((not in-finalboss?)
        ;; IMPORTANT: do not touch the Final Boss runtime object at all outside
        ;; FIN.  This hook runs during Village 1 startup and every other level.
        ;; Mark it cold so the next actual Final Boss frame performs a safe reset.
        (when *fisher-finalboss-danger-music-active?*
          (stop-main-music)
          (set! *fisher-finalboss-danger-music-active?* #f))
        (when *fisher-finalboss-hold-music-mute?*
          (remove-setting! 'music-volume)
          (set! *fisher-finalboss-hold-music-mute?* #f))
        (set! *fisher-finalboss-runtime-level-active?* #f))

      (else
        (let ((rt *fisher-finalboss-runtime*)
              (dt (-> *display* seconds-per-frame)))
          ;; First safe frame inside FIN owns initialization.  Never do this from
          ;; Jak spawn/death callbacks while the level loader is still settling.
          (when (not *fisher-finalboss-runtime-level-active?*)
            (fisher-finalboss-runtime-reset!)
            (set! *fisher-finalboss-runtime-level-active?* #t))
        ;; First freeze: spawn the deep pool encounter.
        (when (and (= (-> rt progress) 0)
                   (= (-> rt state) 'idle)
                   *boss-waiting-for-2nd-phase*)
          (set! *boss-activate-blue-eco* #f)
          (set! (-> rt stage) 1)
          (set! (-> rt difficulty) 1)
          (set! (-> rt area-enabled?) #t)
          (set! (-> rt session-primed?) #f)
          (set! (-> rt state) 'available))

        ;; Second freeze: respawn with the fish already held at midpoint.
        (when (and (= (-> rt progress) 1)
                   (= (-> rt state) 'idle)
                   *boss-waiting-for-3rd-phase*)
          (set! *boss-activate-blue-eco* #f)
          (set! (-> rt stage) 2)
          (set! (-> rt difficulty) 2)
          (set! (-> rt area-enabled?) #t)
          (set! (-> rt session-primed?) #f)
          (set! (-> rt state) 'available))

        ;; There is intentionally no fishing during the next freeze.  Release
        ;; Red -> Yellow immediately and remember that the final fishing visit
        ;; belongs after Yellow is destroyed.
        (when (and (= (-> rt progress) 2) *boss-waiting-for-4th-phase*)
          (set! *boss-activate-blue-eco* #f)
          (set! (-> rt area-enabled?) #f)
          (set! *boss-enter-4th-phase* #t)
          (set! (-> rt progress) 3)
          (set! (-> rt state) 'idle))

        ;; Final fishing visit after the Yellow gun phase.
        (when (and (= (-> rt progress) 3)
                   (= (-> rt state) 'idle)
                   *boss-waiting-for-5th-phase*)
          (set! *boss-activate-blue-eco* #f)
          (set! (-> rt stage) 3)
          (set! (-> rt difficulty) 3)
          (set! (-> rt area-enabled?) #t)
          (set! (-> rt session-primed?) #f)
          (set! (-> rt state) 'available))

        ;; Stage 1/2 ticking exits fishing and enables Blue Eco.  The eight-second
        ;; bomb clock begins only after the fishing session has actually released
        ;; Jak.  The bomb MUST fire; then we wait for the blast to put Jak in the
        ;; air and only advance the boss after he lands again.
        (when (= (-> rt state) 'exit-wait)
          (when (not *fisher-session-active?*)
            ;; Blue Eco and its eight-second survival window begin only after Jak
            ;; is fully back out of the fishing process.
            (set! *boss-activate-blue-eco* #t)
            (cond
              ((not (-> rt bomb-fired?))
                (-! (-> rt bomb-time) dt)
                (when (< (-> rt bomb-time) 0.0)
                  (set! (-> rt bomb-time) 0.0))

                ;; Visible survival clock while Jak has Blue Eco.  Use tenths so
                ;; the player can read the real remaining fuse instead of only
                ;; guessing from the pulsing fish sequence that just ended.
                (let ((tenths
                        (the int
                          (+ 0.999 (* (fmax 0.0 (-> rt bomb-time)) 10.0)))))
                  (clear *fish-ui-str*)
                  (format *fish-ui-str* "EXPLOSION IN ~D.~D"
                    (the int (/ tenths 10))
                    (mod tenths 10))
                  (draw-fisher-large-font-scaled *fish-ui-str* 256 64 0.48))

                (when (<= (-> rt bomb-time) 0.0)
                  (set! (-> rt bomb-time) 0.0)
                  (set! (-> rt bomb-fired?) #t)
                  (set! *boss-trigger-blue-bomb-explosion* #t)
                  ;; The silence lasts THROUGH the countdown.  The bomb firing
                  ;; is the exact handoff point where normal boss music may return.
                  (when *fisher-finalboss-hold-music-mute?*
                    (remove-setting! 'music-volume)
                    (set! *fisher-finalboss-hold-music-mute?* #f))))

              (else
                ;; Do not mistake the grounded frame immediately before the blast
                ;; for the requested post-explosion landing.  We must first see
                ;; Jak leave the ground at least once.
                (cond
                  ((not (fisher-finalboss-target-on-ground?))
                    (set! (-> rt saw-airborne?) #t))

                  ((and
                      (-> rt saw-airborne?)
                      (fisher-finalboss-target-on-ground?))
                    (set! *boss-activate-blue-eco* #f)
                    (set! (-> rt area-enabled?) #f)
                    (when *fisher-finalboss-danger-music-active?*
                      (stop-main-music)
                      (set! *fisher-finalboss-danger-music-active?* #f))
                    (cond
                      ((= (-> rt stage) 1)
                        (set! *boss-enter-2nd-phase* #t)
                        (set! (-> rt progress) 1))
                      (else
                        (set! *boss-enter-3rd-phase* #t)
                        (set! (-> rt progress) 2)))
                    (set! (-> rt state) 'idle)))))))

        ;; The catch card has closed and fishing has released Jak: attach the
        ;; actual black sharkey body to his back and grab his process.
        (when (= (-> rt state) 'carry-pending)
          (when (not *fisher-session-active?*)
            (fisher-finalboss-begin-carry!)))

        (when (= (-> rt state) 'carry)
          (fisher-finalboss-update-back-fish!)
          (+! (-> rt carry-time) dt)
          (when (>= (-> rt carry-time) 2.0)
            ;; The fish becomes primed on Jak's back at this exact moment too.
            ;; Fire the same cue as an SFX immediately, rather than waiting for
            ;; any later camera/state transition.
            (play-sound-file
              "death-is-coming.mp3"
              (the int (-> *setting-control* current sfx-volume)))
            (set! *boss-enter-5th-phase* #t)
            (set! (-> rt state) 'carry-ticking)
            (set! (-> rt carry-time) 0.0)
            (set! (-> rt prompt-time) 0.0)))

        (when (= (-> rt state) 'carry-ticking)
          (fisher-finalboss-update-back-fish!)
          (+! (-> rt carry-time) dt)
          (fisher-finalboss-pulse-back-fish! (-> rt carry-time))
          (when (>= (-> rt carry-time) 3.0)
            (draw-mod-menu-text-custom
              "PRESS <PAD_SQUARE> TO HURL THE FISH!"
              256 150 #f #t #f)
            (+! (-> rt prompt-time) dt)
            (cond
              ((cpad-pressed? 0 square)
                (cpad-clear! 0 square)
                (fisher-finalboss-begin-throw!))
              ((>= (-> rt prompt-time) 5.0)
                (set! *boss-trigger-blue-bomb-explosion* #t)
                (when *fisher-finalboss-hold-music-mute?*
                  (remove-setting! 'music-volume)
                  (set! *fisher-finalboss-hold-music-mute?* #f))
                (when *fisher-finalboss-danger-music-active?*
                  (stop-main-music)
                  (set! *fisher-finalboss-danger-music-active?* #f))
                (when *target* (process-release? *target*))
                (set! (-> rt state) 'failed)))))

        (when (= (-> rt state) 'throwing)
          (fisher-finalboss-update-throw!)))))
        )
  (none))

(defun maintain-fisher-game! ()
  (let ((inside (when *level* (level-get-target-inside *level*)))
      (wanted-location-id -1))

    (when inside
      (cond
        ((= (-> inside name) 'village1) (set! wanted-location-id 0))
        ((= (-> inside name) 'jungle) (set! wanted-location-id 1))
        ((= (-> inside name) 'training) (set! wanted-location-id 2))
        ((= (-> inside name) 'beach) (set! wanted-location-id 3))
        ((= (-> inside name) 'misty) (set! wanted-location-id 4))
        ((= (-> inside name) 'village2) (set! wanted-location-id 5))
        ((= (-> inside name) 'sunken) (set! wanted-location-id 6))
        ((= (-> inside name) 'swamp) (set! wanted-location-id 7))
        ((= (-> inside name) 'village3) (set! wanted-location-id 8))
        ((= (-> inside name) 'snow) (set! wanted-location-id 9))
        ((= (-> inside name) 'maincave) (set! wanted-location-id 10))
        ((and
            (= (-> inside name) 'finalboss)
            (-> *fisher-finalboss-runtime* area-enabled?))
          (set! wanted-location-id 11))))

    ;; Hysteresis prevents repeated spawning right on the boundary.
    (when
      (and
        *fisher-game*
        (or
          (!= *fisher-active-location-id* wanted-location-id)
          (not
            (fisher-player-near-location?
              *fisher-active-location-id*
              (meters 50.0)))))
      (fisher-despawn-current-area!))

    (when
      (and
        (not *fisher-game*)
        inside
        (>= wanted-location-id 0)
        (fisher-player-near-location? wanted-location-id (meters 50.0)))
      (fisher-spawn-area-for-level! (-> inside name)))

    (when *fisher-game*
      (let ((game (the-as fisher-game (-> *fisher-game* 0))))
        (fisher-update-camera-water! game)
        (fisher-maintain-pool-rendering! game)

        ;; The normal fishing state submits these debug lines itself.  Submit
        ;; them here as well while outside fishing so in-debug remains useful
        ;; around a persistent nearby fishbox.
        (when
          (and *fisher-in-debug?* (not *fisher-session-active?*))
          (fisher-draw-playfield-debug! game)
          (dotimes (slot *fisher-max-fish-slots*)
            (fisher-debug-draw-logical-fish-marker! game slot))))))

  (none))

(defun runs-every-frame ()
  (if *show-input-display* (input-display-on) (input-display-off))

  (when in-main-menu?
    (main-menu-update!)
  )

  (when
    (and
      *target*
      (= (pause-allowed?) #t)
      (= (paused?) #f)
    )
    ;; Do loader/death cleanup here, not from the death callback itself.
    ;; Then maintain-fisher-snow-water! can immediately recreate the patch.
    (when *fisher-snow-water-reset-pending?*
      (kill-by-name "fisher-snow-water" *entity-pool*)
      (set! *fisher-snow-water* (the-as (pointer fisher-snow-water) #f))
      (set! *fisher-snow-water-reset-pending?* #f))

    (maintain-fisher-snow-water!)
    (maintain-training-pontoon!)
    (maintain-sentinel-pontoon!)
    (maintain-misty-pontoon!)
    (maintain-fisher-finalboss-intermission!)
    (maintain-fisher-game!)

    (when
      (and
        *fisher-cell-repair-pending?*
        (not *fisher-session-active?*)
        (not *fisher-power-cell-reward-active?*))

      (cond
        ((handle->process (-> *game-info* other-camera-handle))
          (set! *fisher-cell-repair-clear-frames* 0))

        (else
          (+! *fisher-cell-repair-clear-frames* 1)

          (when (>= *fisher-cell-repair-clear-frames* 2)
            (when *target*
              (send-event *target* 'blend-shape #f)
              (send-event *target* 'end-mode))

            (when *camera*
              (send-event *camera* 'no-intro)
              (send-event *camera* 'clear-entity)
              (send-event
                *camera*
                'change-state
                *camera-base-mode*
                (seconds 0.25)))

            (set! *camera-read-analog* #t)
            (set! *external-cam-mode* #f)

            (set! *fisher-cell-repair-pending?* #f)
            (set! *fisher-cell-repair-clear-frames* 0)))))
  )
  (when
    (and
      *level*
      *target*
      (= (pause-allowed?) #t)
      (= (paused?) #f))

    (let ((current-level
          (-> (level-get-target-inside *level*) name)))
      (when
        (and
          *fisher-man*
          (or
            (!=
              current-level
              (-> *fisher-man* 0 level-name))
            (and
              (= current-level 'ogre)
              (task-complete? *game-info* (game-task ogre-end)))
            (and
              (= current-level 'lavatube)
              (task-complete? *game-info* (game-task lavatube-end)))))

        (kill-by-name "fisher-man" *active-pool*)
        (set! *fisher-man* #f))
      (when
        (not *fisher-man*)

        (cond
          ((= current-level 'training)
            (spawn-fisher-man
              (new 'static 'vector
                :x (meters -1307.8538)
                :y (meters 7.4157)
                :z (meters 1021.6666)
                :w 1.0)
              0
              'training))

          ((= current-level 'village1)
            (spawn-fisher-man
              (new 'static 'vector
                :x (meters -56.7375)
                :y (meters 9.4762)
                :z (meters 54.4226)
                :w 1.0)
              1
              'village1))

          ((and
              (= current-level 'ogre)
              (not
                (task-complete?
                  *game-info*
                  (game-task ogre-end))))
            (spawn-fisher-man
              (new 'static 'vector
                :x (meters 206.9792)
                :y (meters 40.3659)
                :z (meters -1999.4272)
                :w 1.0)
              2
              'ogre))

          ((and
              (= current-level 'lavatube)
              (not
                (task-complete?
                  *game-info*
                  (game-task lavatube-end))))
            (spawn-fisher-man
              (new 'static 'vector
                :x (meters 1311.4960)
                :y (meters 43.5360)
                :z (meters -3572.3410)
                :w 1.0)
              4
              'lavatube))

          ((= current-level 'firecanyon)
            (spawn-fisher-man
              (new 'static 'vector
                :x (meters -24.4163)
                :y (meters 34.0139)
                :z (meters -153.9701)
                :w 1.0)
              3
              'firecanyon)

            ;; This placement faces the crossing after a 90-degree Y rotation.
            (when *fisher-man*
              (let ((firecanyon-fisher-rot
                    (new 'stack-no-clear 'matrix)))
                (matrix-rotate-y!
                  firecanyon-fisher-rot
                  (degrees 90.0))
                (matrix->quaternion
                  (-> *fisher-man* 0 root quat)
                  firecanyon-fisher-rot))))))))

  ;; ensure orb-placer is spawned/killed as requested, debug menu is updated
  (when *debug-segment* (orb-placer-maintenance))
  (none))

(defun runs-on-orb-pickup ((parent process-tree))
  (let* ((from-cache? (and parent (type-type? (-> parent type) orb-cache-top))))
    ;; Code here runs on ANY orb pickup
    (when from-cache?
      ;; Code here runs only if the orb was from an orb cache
    )
    (when (not from-cache?)
  ))
  (none))

(defun runs-on-fly-pickup ()
  ;; Code here runs on any scout fly pickup
  (none))

(defun runs-on-cell-pickup ((cell-event symbol))
  (case cell-event
    (('pickup)
      (when (not *fisher-power-cell-reward-active?*)
        (set! *fisher-cell-repair-pending?* #t)
        (set! *fisher-cell-repair-clear-frames* 0)))

    (('cutscene-end)
      (when (not *fisher-power-cell-reward-active?*)
        (set! *fisher-cell-repair-pending?* #t)
        (set! *fisher-cell-repair-clear-frames* 0))))

  (none))

(defun runs-on-eco-pickup ((eco-type pickup-type) (parent process-tree))
  (let* ((from-vent? (and parent (type-type? (-> parent type) vent))))
    ;; Code here runs as soon as you pickup ANY eco
    (case eco-type
      (((pickup-type eco-yellow))
        ;; Code here runs as soon as you pickup yellow eco
      )
      (((pickup-type eco-red))
        ;; Code here runs as soon as you pickup red eco
      )
      (((pickup-type eco-blue))
        ;; Code here runs as soon as you pickup blue eco
      )
      (((pickup-type eco-pill))
        ;; Code here runs as soon as you pickup small green eco
      )
      (((pickup-type eco-green))
        ;; Code here runs as soon as you pickup big green eco
    ))
    (when from-vent?
  ))
  (none))

(defun runs-on-jak-spawn ()
  (fisher-refill-lures!)
  ;; Never touch Final Boss runtime during spawn/load callbacks.
  (set! *fisher-finalboss-runtime-level-active?* #f)
  ;; The level loader may have killed the runtime Snow-water process while
  ;; leaving our raw pointer value behind.  Reset it on the first safe frame.
  (when *fisher-snow-water*
    (set! *fisher-snow-water-reset-pending?* #t))
  ;; This callback can occur while level/art loading is still settling.
  ;; Queue cleanup instead of destroying process or art objects here.
  (when *fisher-game*
    (set! *fisher-blackout-cleanup-pending?* #t)
    (set! *fisher-blackout-cleanup-frames* 0))
  (none))

(defun runs-on-jak-death ((death-event symbol))
  ;; The net is not owned by fisher-game, so remove it immediately on death.
  (kill-by-name "test-fisher-net" *default-pool*)
  (when *fisher-finalboss-danger-music-active?*
    (stop-main-music)
    (set! *fisher-finalboss-danger-music-active?* #f))
  (when *fisher-finalboss-hold-music-mute?*
    (remove-setting! 'music-volume)
    (set! *fisher-finalboss-hold-music-mute?* #f))
  (case death-event
    (('dying)
      (fisher-refill-lures!)
      (set! *fisher-finalboss-runtime-level-active?* #f)
      (when *fisher-snow-water*
        (set! *fisher-snow-water-reset-pending?* #t)))
    (('blackout)
      (fisher-refill-lures!)
      (set! *fisher-finalboss-runtime-level-active?* #f)
      (when *fisher-snow-water*
        (set! *fisher-snow-water-reset-pending?* #t))))
  ;; Do not walk or kill the fish/manipy process tree from a death or blackout
  ;; callback.  These callbacks may overlap the loader's art-record iteration.
  ;; Queue one delayed teardown instead.
  (when *fisher-game*
    (case death-event
      (('dying)
        (set! *fisher-blackout-cleanup-pending?* #t)
        (set! *fisher-blackout-cleanup-frames* 0))
      (('blackout)
        (let ((blackout?
          (and
            *game-info*
            (< (current-time) (-> *game-info* blackout-time)))))
    (cond
      (blackout?
        (when (not *fisher-blackout-cleaned?*)
          (set! *fisher-blackout-cleaned?* #t)
          (set! *fisher-blackout-cleanup-pending?* #t)
          (set! *fisher-blackout-cleanup-frames* 0)
          (set! *fisher-session-active?* #f)
          (set! *fisher-background-cloud-visible?* #f)
          (set! *fisher-background-cloud-session-active?* #f)
          (set! *fisher-underwater-haze-override?* #f)))

      (else
        (set! *fisher-blackout-cleaned?* #f)
        (when *fisher-blackout-cleanup-pending?*
          (cond
            ((and
               *level*
               *target*
               (= (pause-allowed?) #t)
               (= (paused?) #f))
              (+! *fisher-blackout-cleanup-frames* 1)
              (when (>= *fisher-blackout-cleanup-frames* 8)
                (set! *fisher-blackout-cleanup-pending?* #f)
                (set! *fisher-blackout-cleanup-frames* 0)
                (set! *singlefish-session-active?* #f)
                (+! *singlefish-session-id* 1)
                (kill-by-name "fisher-gameplay-fish" *default-pool*)
                (kill-by-name "test-fisher-net" *default-pool*)
                (kill-by-name "fisher-game" *active-pool*)
                (set!
                  *fisher-game*
                  (the-as (pointer fisher-game) #f))
                (set! *fisher-session-active?* #f)
                (set! *fisher-active-location-id* -1)))
            (else
              (set! *fisher-blackout-cleanup-frames* 0))))
            )
          )
        )
        (set! *fisher-blackout-cleanup-pending?* #t)
        (set! *fisher-blackout-cleanup-frames* 0))))
  (none))

(defun in-dialogue! ((log int) (sec int))
  (set! in-dialogue? #t)
  (set! log-id log)
  (set! log-sec sec)
  (set! di-s1 "")
  (set! di-s2 "")
  (set! di-s3 "")
  (set! di-s4 "")
  (none)
)
