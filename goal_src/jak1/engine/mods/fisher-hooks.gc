;;-*-Lisp-*-
(in-package goal)
(bundles "JUN.DGO")

;; name: fisher-hooks.gc

(define *fisher-active-location-id* -1)

(define *fisher-cell-repair-pending?* #f)
(define *fisher-cell-repair-clear-frames* 0)
(define *fisher-blackout-cleaned?* #f)
(define *fisher-blackout-cleanup-pending?* #f)
(define *fisher-blackout-cleanup-frames* 0)


(define *fisher-pool-center-village1* (new 'static 'vector :x (meters -31.6360) :y (meters 2.3620) :z (meters 91.6117) :w 1.0))
(define *fisher-pool-center-jungle* (new 'static 'vector :x (meters 473.7614) :y (meters 1.6762) :z (meters -224.9244) :w 1.0))
(define *fisher-pool-center-training* (new 'static 'vector :x (meters -1332.0715) :y (meters 1.1072) :z (meters 922.7199) :w 1.0))
(define *fisher-pool-center-beach* (new 'static 'vector :x (meters -293.0688) :y (meters 1.7276) :z (meters -272.6693) :w 1.0))
(define *fisher-pool-center-misty* (new 'static 'vector :x (meters 103.0522) :y (meters 1.7121) :z (meters 992.6285) :w 1.0))
(define *fisher-pool-center-village2* (new 'static 'vector :x (meters 457.0053) :y (meters 1.9815) :z (meters -1679.8937) :w 1.0))
(define *fisher-pool-center-sunken* (new 'static 'vector :x (meters 856.0955) :y (meters -143.8908) :z (meters -1761.6607) :w 1.0))
(define *fisher-pool-center-swamp* (new 'static 'vector :x (meters 571.2822) :y (meters 0.3981) :z (meters -2116.4223) :w 1.0))
(define *fisher-pool-center-village3* (new 'static 'vector :x (meters 1050.9093) :y (meters 40.2031) :z (meters -3456.7578) :w 1.0))

(defun fisher-pool-center-for-location ((location-id int))
  (cond
    ((= location-id 0) *fisher-pool-center-village1*)
    ((= location-id 1) *fisher-pool-center-jungle*)
    ((= location-id 2) *fisher-pool-center-training*)
    ((= location-id 3) *fisher-pool-center-beach*)
    ((= location-id 4) *fisher-pool-center-misty*)
    ((= location-id 5) *fisher-pool-center-village2*)
    ((= location-id 6) *fisher-pool-center-sunken*)
    ((= location-id 7) *fisher-pool-center-swamp*)
    ((= location-id 8) *fisher-pool-center-village3*)
    (else (the-as vector #f))))

(defun fisher-player-near-location? ((location-id int) (max-distance meters))
  (when (and *target* (>= location-id 0))
    (let ((center (fisher-pool-center-for-location location-id)))
      (when center
        (return
          (<=
            (vector-vector-distance (target-pos 0) center)
            max-distance)))))
  #f)

(defun fisher-despawn-current-area! ()
  ;; Distance teardown must not walk the resident table or call
  ;; cleanup-for-death on each stored manipy.  A stale child pointer can make
  ;; that cleanup path loop forever.  Remove the named fish processes directly
  ;; from their pool, then discard the owner/table as one object.
  (when *fisher-game*
    (when *fisher-session-active?*
      (set! *fisher-background-cloud-visible?* #f)
      (set! *fisher-background-cloud-session-active?* #f)
      (set! *fisher-underwater-haze-override?* #f)
      (set! *camera-read-analog* #t)
      (set! *external-cam-mode* #f)
      (remove-setting! 'music-volume)
      (stop-main-music)

      (when *target*
        (send-event *target* 'end-mode)
        (process-release? *target*))

      (when *camera*
        (send-event *camera* 'no-intro)
        (send-event *camera* 'clear-entity)
        (send-event *camera* 'change-state *camera-base-mode* (seconds 0.25))))

    (set! *fisher-session-active?* #f)
    (set! *singlefish-session-active?* #f)
    (+! *singlefish-session-id* 1)

    ;; All resident fish/manipys use this exact process name and live in the
    ;; default pool.  Killing by name avoids dereferencing the logical table.
    (kill-by-name "fisher-gameplay-fish" *default-pool*)

    ;; Killing the owner discards the logical fish table without traversing it.
    (kill-by-name "fisher-game" *active-pool*)

    (set!
      *fisher-game*
      (the-as (pointer fisher-game) #f)))

  (set! *fisher-active-location-id* -1)

  (none))

