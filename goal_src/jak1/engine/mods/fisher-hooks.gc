;;-*-Lisp-*-
(in-package goal)
(bundles "JUN.DGO")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Engine hooks and dialogue compatibility globals/functions
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *fisher-active-location-id* -1)

(defun fisher-despawn-current-area! ()
  (when *fisher-game*
    (set! *singlefish-session-active?* #f)
    (+! *singlefish-session-id* 1)

    (kill-by-name
      "fisher-game"
      *active-pool*)

    (set!
      *fisher-game*
      (the-as (pointer fisher-game) #f)))

  (set! *fisher-active-location-id* -1)

  (none))

(defun fisher-spawn-area-for-level! ((level-name symbol))
  (cond
    ;; Sandover Village.
    ((= level-name 'village1)
      (spawn-fisher-game
        0
        (new 'static 'vector
          :x (meters -31.6360)
          :y (meters 2.3620)
          :z (meters 91.6117)
          :w 1.0)
        (new 'static 'vector
          :x (meters -31.6360)
          :y (meters 2.3620)
          :z (meters 91.6117)
          :w 1.0)
        (new 'static 'vector
          :x (meters -22.4873)
          :y (meters 9.6994)
          :z (meters 75.4411)
          :w 1.0)
        (meters 0)
        (degrees 0)
        (degrees 90))

      (set! *fisher-active-location-id* 0))

    ;; Forbidden Jungle.
    ((= level-name 'jungle)
      (spawn-fisher-game
        1
        (new 'static 'vector
          :x (meters 473.7614)
          :y (meters 1.6762)
          :z (meters -224.9244)
          :w 1.0)
        (new 'static 'vector
          :x (meters 478.2005)
          :y (meters 2.4101)
          :z (meters -227.9264)
          :w 1.0)
        (new 'static 'vector
          :x (meters 492.6069)
          :y (meters 7.3909)
          :z (meters -238.3063)
          :w 1.0)
        (meters 0)
        (degrees -35)
        (degrees 55))

      (set! *fisher-active-location-id* 1))

    ;; Sentinel Beach pontoon.
    ((= level-name 'beach)
      (spawn-fisher-game
        3
        (new 'static 'vector
          :x (meters -293.0688)
          :y (meters 1.7276)
          :z (meters -272.6693)
          :w 1.0)
        (new 'static 'vector
          :x (meters -291.4147)
          :y (meters 1.4129)
          :z (meters -273.1604)
          :w 1.0)
        (new 'static 'vector
          :x (meters -308.8099)
          :y (meters 5.1921)
          :z (meters -278.8588)
          :w 1.0)
        (meters 0.4322)
        (degrees 65)
        (degrees -35))

      (set! *fisher-active-location-id* 3))

    ;; Training lagoon.
    ((= level-name 'training)
      (spawn-fisher-game
        2
        (new 'static 'vector
          :x (meters -1332.0715)
          :y (meters 1.1072)
          :z (meters 922.7199)
          :w 1.0)
        (new 'static 'vector
          :x (meters -1331.3082)
          :y (meters 1.1357)
          :z (meters 925.2125)
          :w 1.0)
        (new 'static 'vector
          :x (meters -1341.0826)
          :y (meters 4.2468)
          :z (meters 935.4356)
          :w 1.0)
        (meters 0.3323)
        (degrees -35.3237)
        (degrees 234))

      (set! *fisher-active-location-id* 2)))

  (none))

(defun maintain-fisher-game! ()
  (let ((inside
        (when *level*
          (level-get-target-inside *level*)))

      (wanted-location-id
        -1))

    (when inside
      (cond
        ((= (-> inside name) 'village1)
          (set! wanted-location-id 0))

        ((= (-> inside name) 'jungle)
          (set! wanted-location-id 1))

        ((= (-> inside name) 'training)
          (set! wanted-location-id 2))

        ((= (-> inside name) 'beach)
          (set! wanted-location-id 3))))

    ;; Remove the process when Jak leaves a supported level or enters
    ;; a different fishing level.
    (when
      (and
        *fisher-game*
        (!=
          *fisher-active-location-id*
          wanted-location-id))

      (fisher-despawn-current-area!))

    ;; Spawn the fishing process for Jak's current level.
    (when
      (and
        (not *fisher-game*)
        inside
        (>= wanted-location-id 0))

      (fisher-spawn-area-for-level!
        (-> inside name))))

  (none))

(defun runs-every-frame ()
  ;;(increase-power-cell-by-one) This is a call to increase-power-cell-by-one defined in mod-common-functions.gc
  (if *show-input-display* (input-display-on) (input-display-off))

  (when in-main-menu?
    (main-menu-update!)
  )

  ;; Spawn the custom pontoon once while the player is inside Training.
  (when
    (and
      *target*
      (= (pause-allowed?) #t)
      (= (paused?) #f)
    )
    (maintain-training-pontoon!)
    (maintain-sentinel-pontoon!)
    (maintain-fisher-game!)
  )
(when
  (and
    *level*
    *target*
    (= (pause-allowed?) #t)
    (= (paused?) #f))

  (let ((current-level
        (-> (level-get-target-inside *level*) name)))
    (when
      (and
        *fisher-man*
        (!=
          current-level
          (-> *fisher-man* 0 level-name)))

      (kill-by-name "fisher-man" *active-pool*)
      (set! *fisher-man* #f))
    (when
      (not *fisher-man*)

      (cond
        ((= current-level 'training)
          (spawn-fisher-man
            (new 'static 'vector
              :x (meters -1307.8538)
              :y (meters 7.4157)
              :z (meters 1021.6666)
              :w 1.0)
            0
            'training))

        ((= current-level 'village1)
          (spawn-fisher-man
            (new 'static 'vector
              :x (meters -56.7375)
              :y (meters 9.4762)
              :z (meters 54.4226)
              :w 1.0)
            1
            'village1))))))

  ;; ensure orb-placer is spawned/killed as requested, debug menu is updated
  (when *debug-segment* (orb-placer-maintenance))
  (none))

(defun runs-on-orb-pickup ((parent process-tree))
  (let* ((from-cache? (and parent (type-type? (-> parent type) orb-cache-top))))
    ;; Code here runs on ANY orb pickup
    (when from-cache?
      ;; Code here runs only if the orb was from an orb cache
    )
    (when (not from-cache?)
      ;; Code here runs only if the orb was NOT from an orb cache
  ))
  (none))

(defun runs-on-fly-pickup ()
  ;; Code here runs on any scout fly pickup
  (none))

(defun runs-on-cell-pickup ((cell-event symbol))
  (case cell-event
    (('pickup)
      ;; Code here runs as soon as you pickup a powercell
    )
    (('cutscene-end)
      ;; Code here runs at the end of any powercell cutscene
  ))
  (none))

(defun runs-on-eco-pickup ((eco-type pickup-type) (parent process-tree))
  (let* ((from-vent? (and parent (type-type? (-> parent type) vent))))
    ;; Code here runs as soon as you pickup ANY eco
    (case eco-type
      (((pickup-type eco-yellow))
        ;; Code here runs as soon as you pickup yellow eco
      )
      (((pickup-type eco-red))
        ;; Code here runs as soon as you pickup red eco
      )
      (((pickup-type eco-blue))
        ;; Code here runs as soon as you pickup blue eco
      )
      (((pickup-type eco-pill))
        ;; Code here runs as soon as you pickup small green eco
      )
      (((pickup-type eco-green))
        ;; Code here runs as soon as you pickup big green eco
    ))
    (when from-vent?
      ;; Code here runs only if the eco was picked up from a vent
  ))
  (none))

(defun runs-on-jak-spawn ()
  ;; The every-frame level watcher owns spawning. Calling it here simply
  ;; makes the correct area appear immediately when this hook does fire.
  (maintain-fisher-game!)
  (none))

(defun runs-on-jak-death ((death-event symbol))
  (case death-event
    (('dying) (set! *singlefish-session-active?* #f) (+! *singlefish-session-id* 1)
    )
    (('blackout)
      (fisher-despawn-current-area!)
  ))
  (none))

(defun in-dialogue! ((log int) (sec int))
  (set! in-dialogue? #t)
  (set! log-id log)
  (set! log-sec sec)
  (set! di-s1 "")
  (set! di-s2 "")
  (set! di-s3 "")
  (set! di-s4 "")
  (none)
)
