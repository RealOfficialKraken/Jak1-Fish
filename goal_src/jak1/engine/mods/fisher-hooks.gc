;;-*-Lisp-*-
(in-package goal)
(bundles "JUN.DGO")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Engine hooks and dialogue compatibility globals/functions
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *fisher-active-location-id* -1)

;; Normal power-cell movies can leave Jak in clone/movie mode even after the
;; temporary othercam disappears. Queue a repair from the real pickup hook and
;; perform it only after the movie has been gone for two complete frames.
(define *fisher-cell-repair-pending?* #f)
(define *fisher-cell-repair-clear-frames* 0)

(defun fisher-despawn-current-area! ()
  (when *fisher-game*
    ;; fisher-game exists while the shoreline prompt is idle. Only perform
    ;; modal fishing cleanup when Jak actually entered the fishing state.
    (when *fisher-session-active?*
      (set! *singlefish-session-active?* #f)
      (+! *singlefish-session-id* 1)
      (set! *fisher-background-cloud-visible?* #f)
      (set! *fisher-background-cloud-session-active?* #f)
      (set! *fisher-underwater-haze-override?* #f)
      ;; Never disable *particles-flag* here. It is global engine state used
      ;; by blue eco and other non-fishing particles.
      (set! *camera-read-analog* #t)
      (set! *external-cam-mode* #f)
      (remove-setting! 'music-volume)
      (stop-main-music)

      (when *target*
        (send-event *target* 'end-mode)
        (process-release? *target*))

      (when *camera*
        (send-event *camera* 'no-intro)
        (send-event *camera* 'clear-entity)
        (send-event *camera* 'change-state *camera-base-mode* (seconds 0.25))))

    (set! *fisher-session-active?* #f)

    (kill-by-name
      "fisher-game"
      *active-pool*)

    (set!
      *fisher-game*
      (the-as (pointer fisher-game) #f)))

  (set! *fisher-active-location-id* -1)

  (none))

(defun fisher-spawn-area-for-level! ((level-name symbol))
  (cond
    ;; Sandover Village.
    ((= level-name 'village1)
      (spawn-fisher-game
        0
        (new 'static 'vector
          :x (meters -31.6360)
          :y (meters 2.3620)
          :z (meters 91.6117)
          :w 1.0)
        (new 'static 'vector
          :x (meters -31.6360)
          :y (meters 2.3620)
          :z (meters 91.6117)
          :w 1.0)
        (new 'static 'vector
          :x (meters -22.4873)
          :y (meters 9.6994)
          :z (meters 75.4411)
          :w 1.0)
        (meters 0)
        (degrees 0)
        (degrees 90))

      (set! *fisher-active-location-id* 0))

    ;; Forbidden Jungle.
    ((= level-name 'jungle)
      (spawn-fisher-game
        1
        (new 'static 'vector
          :x (meters 473.7614)
          :y (meters 1.6762)
          :z (meters -224.9244)
          :w 1.0)
        (new 'static 'vector
          :x (meters 478.2005)
          :y (meters 2.4101)
          :z (meters -227.9264)
          :w 1.0)
        (new 'static 'vector
          :x (meters 492.6069)
          :y (meters 7.3909)
          :z (meters -238.3063)
          :w 1.0)
        (meters 0)
        (degrees -35)
        (degrees 55))

      (set! *fisher-active-location-id* 1))

    ;; Sentinel Beach pontoon.
    ((= level-name 'beach)
      (spawn-fisher-game
        3
        (new 'static 'vector
          :x (meters -293.0688)
          :y (meters 1.7276)
          :z (meters -272.6693)
          :w 1.0)
        (new 'static 'vector
          :x (meters -291.4147)
          :y (meters 1.4129)
          :z (meters -273.1604)
          :w 1.0)
        (new 'static 'vector
          :x (meters -308.8099)
          :y (meters 5.1921)
          :z (meters -278.8588)
          :w 1.0)
        (meters 0.4322)
        (degrees 65)
        (degrees -35))

      (set! *fisher-active-location-id* 3))

    ;; Training lagoon.
    ((= level-name 'training)
      (spawn-fisher-game
        2
        (new 'static 'vector
          :x (meters -1332.0715)
          :y (meters 1.1072)
          :z (meters 922.7199)
          :w 1.0)
        (new 'static 'vector
          :x (meters -1331.3082)
          :y (meters 1.1357)
          :z (meters 925.2125)
          :w 1.0)
        (new 'static 'vector
          :x (meters -1341.0826)
          :y (meters 4.2468)
          :z (meters 935.4356)
          :w 1.0)
        (meters 0.3323)
        (degrees -35.3237)
        (degrees 234))

      (set! *fisher-active-location-id* 2))

    ;; Misty Island pontoon fishing area. Camera angle is derived from the
    ;; Fishnet->Camera horizontal vector; playfield angle is derived from the
    ;; supplied target->facing-point vector.
    ((= level-name 'misty)
      (spawn-fisher-game
        4
        (new 'static 'vector
          :x (meters 103.0522)
          :y (meters 1.7121)
          :z (meters 992.6285)
          :w 1.0)
        (new 'static 'vector
          :x (meters 103.8267)
          :y (meters 1.7334)
          :z (meters 990.2062)
          :w 1.0)
        (new 'static 'vector
          :x (meters 107.1148)
          :y (meters 6.5783)
          :z (meters 1005.8063)
          :w 1.0)
        (meters 0.6031)
        (degrees -180.8659)
        (degrees 80.3413))

      (set! *fisher-active-location-id* 4)))

  (none))

(defun maintain-fisher-game! ()
  (let ((inside
        (when *level*
          (level-get-target-inside *level*)))

      (wanted-location-id
        -1))

    (when inside
      (cond
        ((= (-> inside name) 'village1)
          (set! wanted-location-id 0))

        ((= (-> inside name) 'jungle)
          (set! wanted-location-id 1))

        ((= (-> inside name) 'training)
          (set! wanted-location-id 2))

        ((= (-> inside name) 'beach)
          (set! wanted-location-id 3))

        ((= (-> inside name) 'misty)
          (set! wanted-location-id 4))))

    ;; Remove the process when Jak leaves a supported level or enters
    ;; a different fishing level.
    (when
      (and
        *fisher-game*
        (!=
          *fisher-active-location-id*
          wanted-location-id))

      (fisher-despawn-current-area!))

    ;; Spawn the fishing process for Jak's current level.
    (when
      (and
        (not *fisher-game*)
        inside
        (>= wanted-location-id 0))

      (fisher-spawn-area-for-level!
        (-> inside name))))

  (none))

(defun runs-every-frame ()
  ;;(increase-power-cell-by-one) This is a call to increase-power-cell-by-one defined in mod-common-functions.gc
  (if *show-input-display* (input-display-on) (input-display-off))

  (when in-main-menu?
    (main-menu-update!)
  )

  ;; Spawn the custom pontoon once while the player is inside Training.
  (when
    (and
      *target*
      (= (pause-allowed?) #t)
      (= (paused?) #f)
    )
    (maintain-training-pontoon!)
    (maintain-sentinel-pontoon!)
    (maintain-misty-pontoon!)
    (maintain-fisher-game!)

    ;; runs-on-cell-pickup is reliably called for the actual pickup, while a
    ;; synthetic 'cutscene-end hook is not guaranteed to be called at all.
    ;; Wait until othercam has stayed gone for two frames, then clear the
    ;; leftover clone/movie mode and recreate only the idle fishing process.
    (when
      (and
        *fisher-cell-repair-pending?*
        (not *fisher-session-active?*)
        (not *fisher-power-cell-reward-active?*))

      (cond
        ((handle->process (-> *game-info* other-camera-handle))
          (set! *fisher-cell-repair-clear-frames* 0))

        (else
          (+! *fisher-cell-repair-clear-frames* 1)

          (when (>= *fisher-cell-repair-clear-frames* 2)
            ;; The retail movie is over, but Jak may still be left in its
            ;; clone-animation mode. This is the state a Jak reload was
            ;; clearing and is what prevents fisher-game from grabbing him.
            (when *target*
              (send-event *target* 'blend-shape #f)
              (send-event *target* 'end-mode))

            (when *camera*
              (send-event *camera* 'no-intro)
              (send-event *camera* 'clear-entity)
              (send-event
                *camera*
                'change-state
                *camera-base-mode*
                (seconds 0.25)))

            (set! *camera-read-analog* #t)
            (set! *external-cam-mode* #f)

            (set! *fisher-cell-repair-pending?* #f)
            (set! *fisher-cell-repair-clear-frames* 0)))))
  )
(when
  (and
    *level*
    *target*
    (= (pause-allowed?) #t)
    (= (paused?) #f))

  (let ((current-level
        (-> (level-get-target-inside *level*) name)))
    (when
      (and
        *fisher-man*
        (!=
          current-level
          (-> *fisher-man* 0 level-name)))

      (kill-by-name "fisher-man" *active-pool*)
      (set! *fisher-man* #f))
    (when
      (not *fisher-man*)

      (cond
        ((= current-level 'training)
          (spawn-fisher-man
            (new 'static 'vector
              :x (meters -1307.8538)
              :y (meters 7.4157)
              :z (meters 1021.6666)
              :w 1.0)
            0
            'training))

        ((= current-level 'village1)
          (spawn-fisher-man
            (new 'static 'vector
              :x (meters -56.7375)
              :y (meters 9.4762)
              :z (meters 54.4226)
              :w 1.0)
            1
            'village1))))))

  ;; ensure orb-placer is spawned/killed as requested, debug menu is updated
  (when *debug-segment* (orb-placer-maintenance))
  (none))

(defun runs-on-orb-pickup ((parent process-tree))
  (let* ((from-cache? (and parent (type-type? (-> parent type) orb-cache-top))))
    ;; Code here runs on ANY orb pickup
    (when from-cache?
      ;; Code here runs only if the orb was from an orb cache
    )
    (when (not from-cache?)
      ;; Code here runs only if the orb was NOT from an orb cache
  ))
  (none))

(defun runs-on-fly-pickup ()
  ;; Code here runs on any scout fly pickup
  (none))

(defun runs-on-cell-pickup ((cell-event symbol))
  (case cell-event
    (('pickup)
      ;; Fishing's own carrier reward performs its cleanup inside the fishing
      ;; exit state. Queue this repair only for ordinary world power cells.
      (when (not *fisher-power-cell-reward-active?*)
        (set! *fisher-cell-repair-pending?* #t)
        (set! *fisher-cell-repair-clear-frames* 0)))

    (('cutscene-end)
      ;; Keep compatibility with builds that do emit this event, but let the
      ;; frame-based repair above decide when othercam is truly finished.
      (when (not *fisher-power-cell-reward-active?*)
        (set! *fisher-cell-repair-pending?* #t)
        (set! *fisher-cell-repair-clear-frames* 0))))

  (none))

(defun runs-on-eco-pickup ((eco-type pickup-type) (parent process-tree))
  (let* ((from-vent? (and parent (type-type? (-> parent type) vent))))
    ;; Code here runs as soon as you pickup ANY eco
    (case eco-type
      (((pickup-type eco-yellow))
        ;; Code here runs as soon as you pickup yellow eco
      )
      (((pickup-type eco-red))
        ;; Code here runs as soon as you pickup red eco
      )
      (((pickup-type eco-blue))
        ;; Code here runs as soon as you pickup blue eco
      )
      (((pickup-type eco-pill))
        ;; Code here runs as soon as you pickup small green eco
      )
      (((pickup-type eco-green))
        ;; Code here runs as soon as you pickup big green eco
    ))
    (when from-vent?
      ;; Code here runs only if the eco was picked up from a vent
  ))
  (none))

(defun runs-on-jak-spawn ()
  ;; A same-level load/respawn must discard a genuinely active fishing
  ;; session. Do not run modal cleanup merely because the idle prompt process
  ;; exists; that was corrupting the normal HUD/camera before fishing began.
  (when
    (and *fisher-game* *fisher-session-active?*)
    (fisher-despawn-current-area!))
  (maintain-fisher-game!)
  (none))

(defun runs-on-jak-death ((death-event symbol))
  (when *fisher-session-active?*
    (case death-event
      (('dying)
        (fisher-despawn-current-area!))
      (('blackout)
        (fisher-despawn-current-area!))))
  (none))

(defun in-dialogue! ((log int) (sec int))
  (set! in-dialogue? #t)
  (set! log-id log)
  (set! log-sec sec)
  (set! di-s1 "")
  (set! di-s2 "")
  (set! di-s3 "")
  (set! di-s4 "")
  (none)
)
