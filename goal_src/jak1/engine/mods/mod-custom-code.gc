(defun fisher-reset-cast! ((self fisher-game))
  (set! (-> self cast-state) 'ready)
  (set! (-> self camera-state) 'before-cast)
  (set! (-> self cast-charge-direction) 1.0)
  (set! (-> self cast-charge) 0.0)
  (set! (-> self cast-time) 0.0)
  (set! (-> self camera-blend) 0.0)
  (set! (-> self casted?) #f)

  (set! (-> self lure-x-velocity) 0.0)
  (set! (-> self lure-y-velocity) 0.0)
  (vector-reset! (-> self lure-pos))
  (vector-reset! (-> self lure-cast-start))
  (vector-reset! (-> self lure-cast-end))
  (vector-reset! (-> self lure-cast-axis))
  (vector-reset! (-> self lure-camera-offset))
  (vector-reset! (-> self lure-camera-pos))
  (vector-reset! (-> self lure-camera-look))
  (stop-sound-file "water-waves.wav")
  (fisher-remove-lure-snake! self)
  (set!
    (-> self reel-hint-time)
    0.0)
  (set!
    (-> self bubble-time)
  -2.0)

  (none)
)

(defun fisher-launch-camera-bubble! ((self fisher-game))
  (when
    (and
      *camera*
      (> (-> *camera* num-slaves) 0))

    (let ((cam-slave
            (-> *camera* slave 0 0))

          (bubble-pos
            (new 'stack-no-clear 'vector))

          (forward
            (new 'stack-no-clear 'vector))

          (right
            (new 'stack-no-clear 'vector))

          (depth
            (rand-vu-float-range
              (meters 2.0)
              (meters 9.0)))

          (horizontal-offset
            0.0)

          (vertical-offset
            0.0))

      (vector-!
        forward
        (-> self lure-camera-look)
        (-> cam-slave trans))

      (set!
        (-> forward w)
        0.0)

      (vector-normalize!
        forward
        1.0)

      (vector-cross!
        right
        forward
        (-> *camera* local-down))

      (set!
        (-> right w)
        0.0)

      (vector-normalize!
        right
        1.0)

      (set!
        horizontal-offset
        (rand-vu-float-range
          (- (* depth 0.65))
          (* depth 0.65)))

      (set!
        vertical-offset
        (rand-vu-float-range
          (- (* depth 0.38))
          (* depth 0.38)))

      (vector+float*!
        bubble-pos
        (-> cam-slave trans)
        forward
        depth)

      (vector+float*!
        bubble-pos
        bubble-pos
        right
        horizontal-offset)

      (vector+float*!
        bubble-pos
        bubble-pos
        (-> *camera* local-down)
        vertical-offset)

      (when
        (>=
          (-> bubble-pos y)
          (-> self water-level))

        (set!
          (-> bubble-pos y)
          (- (-> self water-level)
             (meters 0.25)))
      )

      (set!
        (-> bubble-pos w)
        1.0)

      (launch-particles
        :system *sp-particle-system-2d*
        (-> *part-id-table* 3570)
        bubble-pos)
    )
  )

  (none)
)

(defun fisher-update-camera-bubbles! ((self fisher-game))
  (let ((dt
          (-> *display* seconds-per-frame)))

    (cond
      ((and
         (-> self casted?)
         (-> self camera-underwater?)
         (<
           (-> self lure-pos y)
           (-> self water-level)))

        (cond
          ((< (-> self bubble-time) 0.0)
            (+!
              (-> self bubble-time)
              dt)

            (when
              (>= (-> self bubble-time) 0.0)

              (fisher-launch-camera-bubble! self)

              (set!
                (-> self bubble-time)
                (rand-vu-float-range
                  6.0
                  15.0)))
          )

          (else
            (-!
              (-> self bubble-time)
              dt)

            (when
              (<= (-> self bubble-time) 0.0)

              (fisher-launch-camera-bubble! self)

              (set!
                (-> self bubble-time)
                (rand-vu-float-range
                  6.0
                  15.0)))
          )
        )
      )

      (else
        (set!
          (-> self bubble-time)
          -2.0))
    )
  )

  (none)
)

(defun fisher-start-cast! ((self fisher-game))
  (set!
    *fisher-line-hp-max*
    (+
      15.0
      (* 85.0
         (-> self cast-charge))))

  (fisher-reset-line-hp!)

  (let ((cast-distance
          (+
            (meters 2.0)
            (* (meters 28.0)
               (-> self cast-charge)))))

    (vector-copy!
      (-> self lure-cast-start)
      (target-pos 0))

    (play-sound-file
      "cast.wav"
      (the int
        (-> *setting-control* current sfx-volume)))

    (+!
      (-> self lure-cast-start y)
      (meters 1.4))

    (vector-copy!
      (-> self lure-cast-axis)
      (-> self playfield-axis))

    (vector+float*!
      (-> self lure-cast-end)
      (-> self lure-cast-start)
      (-> self lure-cast-axis)
      cast-distance)

    (set!
      (-> self lure-cast-end y)
      (-> self water-level))

    (set!
      (-> self lure-cast-end w)
      1.0)

    (vector-copy!
      (-> self lure-pos)
      (-> self lure-cast-start))

    (fisher-remove-lure-snake! self)

    (let ((snake-anchor
            (new 'stack-no-clear 'vector))

          (snake-root
            (new 'stack-no-clear 'vector)))

      (vector-copy!
        snake-anchor
        (-> self lure-pos))

      (set!
        (-> snake-anchor w)
        1.0)

      (vector-copy!
        snake-root
        snake-anchor)

      (-!
        (-> snake-root y)
        (meters 1.0666667))

      (set!
        (-> snake-root w)
        1.0)

      (vector-copy!
        (-> self lure-snake-last-anchor)
        snake-anchor)

      (vector-reset!
        (-> self lure-snake-angle))

      (vector-reset!
        (-> self lure-snake-angular-speed))

      (set!
        (-> self lure-snake-flow-time)
        0.0)

      (set!
        (-> self lure-snake)
        (spawn-fisher-lure-snake
          snake-root))
    )

    (let ((cam-slave
            (-> *camera* slave 0 0)))

      (vector-float*!
        (-> self lure-camera-offset)
        (-> self camera-axis)
        (- (-> self camera-radius)))

      (set!
        (-> self lure-camera-offset y)
        0.0)

      (set!
        (-> self lure-camera-offset w)
        0.0)

      (vector-copy!
        (-> self fisher-cam)
        (-> cam-slave trans))
    )

    (set! (-> self cast-time) 0.0)
    (set! (-> self camera-blend) 0.0)
    (set! (-> self cast-duration) 1.0)
    (set! (-> self casted?) #t)
    (set!
      (-> self reel-hint-time)
      3.0)

    (set! (-> self lure-x-velocity) 0.0)
    (set! (-> self lure-y-velocity) 0.0)

    (set! (-> self cast-state) 'casting)
    (set! (-> self camera-state) 'follow-lure)
  )

  (none)
)

(defun fisher-update-cast-arc! ((self fisher-game))
  (let* ((dt (-> *display* seconds-per-frame))
         (t
           (fmin
             1.0
             (/ (-> self cast-time)
                (-> self cast-duration))))
         (arc-height
           (* (meters 5.0)
              (* 4.0
                 t
                 (- 1.0 t)))))

    (vector-lerp!
      (-> self lure-pos)
      (-> self lure-cast-start)
      (-> self lure-cast-end)
      t)

    (+!
      (-> self lure-pos y)
      arc-height)

    (+!
      (-> self cast-time)
      dt)

    (when (>= t 1.0)
  (vector-copy!
    (-> self lure-pos)
    (-> self lure-cast-end))

  (set!
    (-> self lure-x-velocity)
    0.87)

  (set!
    (-> self lure-y-velocity)
    -2.0)

  (fisher-launch-water-entry-bubbles! self)
  (play-sound-file "splash.wav" (the int (-> *setting-control* current sfx-volume)))

  (set!
    (-> self cast-state)
    'water-entry))
  )

  (none)
)

(defun fisher-update-underwater-background! ((self fisher-game))
  (fisher-update-camera-water! self)
  (fisher-update-underwater-waves! self)

  (cond
    ((-> self camera-underwater?)
      (fisher-force-underwater-background!)
    )

    (else
      (fisher-restore-normal-background!)
    )
  )

  (none)
)

(defun fisher-update-water-entry! ((self fisher-game))
  (let* ((dt
           (-> *display* seconds-per-frame))

         (entry-depth
           (meters 3.0))

         (entry-bottom
           (- (-> self water-level)
              entry-depth))

         (current-depth
           (fmax
             0.0
             (-
               (-> self water-level)
               (-> self lure-pos y))))

         (depth-progress
           (fmin
             1.0
             (/ current-depth
                entry-depth)))

         (smooth-progress
           (*
             depth-progress
             depth-progress
             (-
               3.0
               (* 2.0 depth-progress))))

         (starting-y-speed
           -2.0)

         (ending-y-speed
           (- (-> self lure-fall-speed))))

    (set!
      (-> self lure-y-velocity)
      (+
        (* starting-y-speed
           (- 1.0 smooth-progress))

        (* ending-y-speed
           smooth-progress)))

    (set!
      (-> self lure-x-velocity)
      (*
        0.87
        (- 1.0 smooth-progress)))

    (vector+float*!
      (-> self lure-pos)
      (-> self lure-pos)
      (-> self lure-cast-axis)
      (* (meters 1.0)
         (-> self lure-x-velocity)
         dt))

    (+!
      (-> self lure-pos y)
      (* (meters 1.0)
         (-> self lure-y-velocity)
         dt))

    (when
      (<=
        (-> self lure-pos y)
        entry-bottom)

      (set!
        (-> self lure-pos y)
        entry-bottom)

      (set!
        (-> self lure-x-velocity)
        0.0)

      (set!
        (-> self lure-y-velocity)
        (- (-> self lure-fall-speed)))

      (set!
        (-> self cast-state)
        'line-active))
  )

  (none)
)

(defun fisher-camera-follow-lure! ((self fisher-game))
  (when (and *camera* (> (-> *camera* num-slaves) 0))
    (let ((cam-slave (-> *camera* slave 0 0))
          (desired-camera (new 'stack-no-clear 'vector))
          (desired-look (new 'stack-no-clear 'vector))
          (forward (new 'stack-no-clear 'vector))
          (blend-value 0.0)
          (blend-speed 2.5))

      (vector+!
        desired-camera
        (-> self lure-pos)
        (-> self lure-camera-offset))

      (vector-copy!
        desired-look
        (-> self lure-pos))

      (+!
        (-> desired-look y)
        (meters 0.5))

      (when
        (< (-> self camera-blend)
           1.0)

        (+!
          (-> self camera-blend)
          (* blend-speed
             (-> *display* seconds-per-frame)))

        (when
          (> (-> self camera-blend)
             1.0)

          (set!
            (-> self camera-blend)
            1.0))
      )

      (set!
        blend-value
        (parameter-ease-sin-clamp
          (-> self camera-blend)))

      (vector-lerp!
        (-> self lure-camera-pos)
        (-> self fisher-cam)
        desired-camera
        blend-value)

      (vector-lerp!
        (-> self lure-camera-look)
        (-> self fisher-look)
        desired-look
        blend-value)

      (set!
        (-> cam-slave saved-pt quad)
        (-> self lure-camera-pos quad))

      (set!
        (-> cam-slave trans quad)
        (-> self lure-camera-pos quad))

      (vector-!
  forward
  (-> self lure-camera-look)
  (-> self lure-camera-pos))

(let ((horizontal-length
        (sqrtf
          (+
            (* (-> forward x)
               (-> forward x))

            (* (-> forward z)
               (-> forward z))))))

  (when (> horizontal-length 0.0)
    (set!
      (-> forward x)
      (*
        (/ (-> forward x)
           horizontal-length)

        (cos (degrees -5))))

    (set!
      (-> forward z)
      (*
        (/ (-> forward z)
           horizontal-length)

        (cos (degrees -5))))

    (set!
      (-> forward y)
      (sin (degrees -5)))

    (set!
      (-> forward w)
      0.0))
)

(vector-normalize!
  forward
  1.0)

      (forward-down->inv-matrix
        (-> cam-slave tracking inv-mat)
        forward
        (-> *camera* local-down))
    )
  )

  (none)
)

(defun fisher-camera-before-cast! ((self fisher-game))
  (when (and *camera* (> (-> *camera* num-slaves) 0))
    (let ((cam-slave (-> *camera* slave 0 0))
          (forward (new 'stack-no-clear 'vector))
          (look-pos (new 'stack-no-clear 'vector))
          (camera-pos (new 'stack-no-clear 'vector)))

      (vector+float*!
        camera-pos
        (-> self pos)
        (-> self camera-axis)
        (- (-> self camera-radius)))

      (set!
        (-> camera-pos y)
        (-> self fisher-cam y))

      (set!
        (-> camera-pos w)
        1.0)

      (vector-copy!
        look-pos
        (-> self pos))

      (+!
        (-> look-pos y)
        (meters 1.0))

      (vector-copy!
        (-> self fisher-look)
        look-pos)

      (set!
        (-> cam-slave saved-pt quad)
        (-> camera-pos quad))

      (set!
        (-> cam-slave trans quad)
        (-> camera-pos quad))

      (vector-!
        forward
        look-pos
        camera-pos)

      (vector-normalize!
        forward
        1.0)

      (forward-down->inv-matrix
        (-> cam-slave tracking inv-mat)
        forward
        (-> *camera* local-down))
    )
  )

  (none)
)

(defun fisher-update-lure! ((self fisher-game))
  (let ((dt (-> *display* seconds-per-frame))
        (from-jak (new 'stack-no-clear 'vector))
        (horizontal-distance 0.0)
        (saved-y 0.0)
        (top-y
          (- (-> self water-level)
             (meters 3.0)))
        (bottom-y
          (- (-> self water-level)
             (meters 20.0)))
        (current-speed -0.18)
        (bottom-current-speed -0.28))

    (vector-!
      from-jak
      (-> self lure-pos)
      (-> self pos))

    (set!
      horizontal-distance
      (vector-dot
        from-jak
        (-> self lure-cast-axis)))

    (cond
      ((cpad-hold? 0 x)
        (vector+float*!
          (-> self lure-pos)
          (-> self lure-pos)
          (-> self lure-cast-axis)
          (-
            (* (meters 1.0)
               (-> self lure-reel-x-speed)
               dt)))

        (+!
          (-> self lure-pos y)
          (* (meters 1.0)
             (-> self lure-reel-y-speed)
             dt))

        (set!
          (-> self lure-x-velocity)
          (- (-> self lure-reel-x-speed)))

        (set!
          (-> self lure-y-velocity)
          0.0)
      )

      (else
        (cond
          ((> horizontal-distance
              (meters 2.0))

            (cond
              ((<=
                 (-> self lure-pos y)
                 (+ bottom-y
                    (meters 0.75)))

                (set!
                  (-> self lure-x-velocity)
                  bottom-current-speed)
              )

              (else
                (set!
                  (-> self lure-x-velocity)
                  current-speed)
              )
            )

            (vector+float*!
              (-> self lure-pos)
              (-> self lure-pos)
              (-> self lure-cast-axis)
              (* (meters 1.0)
                 (-> self lure-x-velocity)
                 dt))
          )

          (else
            (set!
              (-> self lure-x-velocity)
              0.0)
          )
        )

        (-!
          (-> self lure-y-velocity)
          (* 1.2 dt))

        (when
          (< (-> self lure-y-velocity)
             (- (-> self lure-fall-speed)))

          (set!
            (-> self lure-y-velocity)
            (- (-> self lure-fall-speed)))
        )

        (+!
          (-> self lure-pos y)
          (* (meters 1.0)
             (-> self lure-y-velocity)
             dt))
      )
    )

    (vector-!
      from-jak
      (-> self lure-pos)
      (-> self pos))

    (set!
      horizontal-distance
      (vector-dot
        from-jak
        (-> self lure-cast-axis)))

    (set!
      saved-y
      (-> self lure-pos y))

    (cond
      ((< horizontal-distance
          (meters 2.0))

        (vector+float*!
          (-> self lure-pos)
          (-> self pos)
          (-> self lure-cast-axis)
          (meters 2.0))

        (set!
          (-> self lure-pos y)
          saved-y)

        (set!
          (-> self lure-x-velocity)
          0.0)
      )

      ((> horizontal-distance
          (meters 30.0))

        (vector+float*!
          (-> self lure-pos)
          (-> self pos)
          (-> self lure-cast-axis)
          (meters 30.0))

        (set!
          (-> self lure-pos y)
          saved-y)

        (set!
          (-> self lure-x-velocity)
          0.0)
      )
    )

    (when
      (> (-> self lure-pos y)
         top-y)

      (set!
        (-> self lure-pos y)
        top-y)

      (when
        (> (-> self lure-y-velocity)
           0.0)

        (set!
          (-> self lure-y-velocity)
          0.0))
    )

    (when
      (< (-> self lure-pos y)
         bottom-y)

      (set!
        (-> self lure-pos y)
        bottom-y)

      (set!
        (-> self lure-y-velocity)
        0.48)
    )

    (vector-!
      from-jak
      (-> self lure-pos)
      (-> self pos))

    (set!
      horizontal-distance
      (vector-dot
        from-jak
        (-> self lure-cast-axis)))

    (when
      (and
        (>=
          (-> self lure-pos y)
          (- (-> self water-level)
             (meters 3.05)))

        (<=
          horizontal-distance
          (meters 4.0)))

      (fisher-reset-cast! self))
  )

  (none)
)

(defun fisher-draw-line! ((self fisher-game))
  (when (and *target* (-> self casted?))
    (let ((line-start (new 'stack-no-clear 'vector))
          (line-end (new 'stack-no-clear 'vector))
          (line-step (new 'stack-no-clear 'vector))
          (segment-start (new 'stack-no-clear 'vector))
          (segment-end (new 'stack-no-clear 'vector))
          (line-offset (new-stack-vector0))
          (line-color (new 'static 'rgba
                      :r #x20
                      :g #xe0
                      :b #x40
                      :a #xc0))
         )
      (fisher-set-line-color! line-color)
      (vector-copy!
        line-start
        (target-pos 0))

      (+!
        (-> line-start y)
        (meters 3.25))

      (vector-copy!
        line-end
        (-> self lure-pos))

      (vector-!
        line-step
        line-end
        line-start)

      (vector-float*!
        line-step
        line-step
        (/ 1.0 32.0))

      (vector-copy!
        segment-start
        line-start)

      (dotimes (i 32)
        (vector+!
          segment-end
          segment-start
          line-step)

        (add-debug-line
          #t
          (bucket-id debug-no-zbuf)
          segment-start
          segment-end
          line-color
          #f
          line-color)

        (vector-copy!
          segment-start
          segment-end)
      )
    )
  )

  (none)
)

(defun fisher-update-casting! ((self fisher-game))
  (cond
    ((= (-> self cast-state) 'ready)
      (fisher-restore-normal-background!)

      (draw-mod-menu-text-custom
        "PRESS <PAD_X> TO CAST"
        256
        160
        #f
        #t
        #f)

      (when (cpad-pressed? 0 x)
        (cpad-clear! 0 x)
        (set! (-> self cast-state) 'charging)
        (set! (-> self cast-charge) 0.0)
        (set! (-> self cast-charge-direction) 1.0))
    )

    ((= (-> self cast-state) 'charging)
        (fisher-restore-normal-background!)

        (fisher-draw-cast-bar
          (-> self cast-charge))

        (when (cpad-pressed? 0 x)
          (cpad-clear! 0 x)
          (fisher-start-cast! self))

        (when (= (-> self cast-state) 'charging)
          (+!
            (-> self cast-charge)
            (*
              (-> self cast-charge-direction)
              (-> *display* seconds-per-frame)))

          (cond
            ((>= (-> self cast-charge) 1.0)
              (set!
                (-> self cast-charge)
                1.0)

              (set!
                (-> self cast-charge-direction)
                -1.0)
            )

            ((<= (-> self cast-charge) 0.0)
              (set!
                (-> self cast-charge)
                0.0)

              (fisher-reset-cast! self)
            )
          )
        )
      )

    ((= (-> self cast-state) 'casting)
      (fisher-update-cast-arc! self)
      (fisher-update-reel-hint! self)
      (fisher-camera-follow-lure! self)
      (fisher-update-underwater-background! self)
      (fisher-update-camera-bubbles! self)
      (fisher-update-lure-snake! self)
      (fisher-draw-line-hp-bar)
      (fisher-draw-line! self)
    )

    ((= (-> self cast-state) 'water-entry)
      (fisher-update-water-entry! self)
      (fisher-camera-follow-lure! self)
      (fisher-update-reel-hint! self)
      (fisher-update-underwater-background! self)
      (fisher-update-camera-bubbles! self)
      (fisher-update-lure-snake! self)
      (fisher-draw-line-hp-bar)
      (fisher-draw-line! self)
    )

    ((= (-> self cast-state) 'line-active)
      (fisher-update-lure! self)
      (fisher-camera-follow-lure! self)
      (fisher-update-reel-hint! self)
      (fisher-update-underwater-background! self)
      (fisher-update-camera-bubbles! self)
      (fisher-update-lure-snake! self)
      (fisher-draw-line-hp-bar)
      (fisher-draw-line! self)
    )
  )

  (none)
)

(defun fisher-face-jak-right-side! ((self fisher-game))
  (when *target*
    (let ((jak-forward (new 'stack-no-clear 'vector))
          (jak-rot (new 'stack-no-clear 'matrix)))

      (vector-copy!
        jak-forward
        (-> self playfield-axis))

      (set! (-> jak-forward y) 0.0)
      (set! (-> jak-forward w) 0.0)

      (vector-normalize!
        jak-forward
        1.0)

      (forward-down->inv-matrix
        jak-rot
        jak-forward
        (-> *camera* local-down))

      (matrix->quaternion
        (-> *target* control quat-for-control)
        jak-rot)

      (quaternion-copy!
        (-> *target* control quat)
        (-> *target* control quat-for-control))

      (rot->dir-targ!
        (-> *target* control))
    )
  )

  (none)
)

(defun spawn-fisher-game
  ((loc string)
   (player-pos vector)
   (camera-pos vector)
   (water-height float)
   (camera-angle float)
   (playfield-angle float))

  (let ((angles
          (new 'stack-no-clear 'vector)))

    (set!
      (-> angles x)
      camera-angle)

    (set!
      (-> angles y)
      playfield-angle)

    (set!
      (-> angles z)
      0.0)

    (set!
      (-> angles w)
      0.0)

    (set!
      *fisher-game*
      (process-spawn
        fisher-game
        loc
        player-pos
        camera-pos
        water-height
        angles
        :name "fisher-game"
        *active-pool*))
  )

  (none)
)

(defstate idle (fisher-game)
    :virtual #t
    :code (behavior ()
        (loop
            (when (<= (vector-vector-distance (target-pos 0) (-> self pos)) (meters 5))
                (draw-mod-menu-text-custom
                "PRESS <PAD_CIRCLE> TO START FISHING"
                256
                160
                #f
                #t
                #f)
                (when (cpad-pressed? 0 circle)
                  (cpad-clear! 0 circle)
                  (set! (-> self camera-state) 'before-cast)
                  (send-event *camera* 'change-state cam-fixed 0)
                  (go-virtual fishing)
                )
            )
            (suspend)
        )
    )
)

(defstate fishing (fisher-game)
  :virtual #t

  :enter
    (behavior ()
      (process-grab? *target*)
      (play-main-music "fishing-theme-a.wav" (the int (-> *setting-control* current sfx-volume)))
      (set! (-> self stored-music-vol) (-> *setting-control* current music-volume))
      (set-setting! 'music-volume 'abs 0.0 0)
      (set!
        (-> self saved-camera-read-analog)
        *camera-read-analog*)

      (set!
        (-> self saved-external-cam-mode)
        *external-cam-mode*)

      (set! *camera-read-analog* #f)
      (set! *external-cam-mode* #f)

      (fisher-reset-cast! self)
    )

  :code
    (behavior ()
      (loop
        (when (= (-> self camera-state) 'before-cast)
          (fisher-face-jak-right-side! self)
          (fisher-camera-before-cast! self)
        )

        (fisher-update-casting! self)

        (when
          (and
            (= (-> self cast-state) 'ready)
            (cpad-pressed? 0 triangle))

          (cpad-clear! 0 triangle)
          (go-virtual exit)
        )

        (cpad-clear! 0 x)
        (cpad-clear! 0 circle)
        (cpad-clear! 0 square)
        (cpad-clear! 0 triangle)

        (suspend)
      )
    )
)

(defstate exit (fisher-game)
  :virtual #t
  :code
    (behavior ()
      (set!
        *camera-read-analog*
        (-> self saved-camera-read-analog))

      (set!
        *external-cam-mode*
        (-> self saved-external-cam-mode))
      (remove-setting! 'music-volume)
      (stop-main-music)
      (send-event
        *camera*
        'change-state
        *camera-base-mode*
        (seconds 0.5))

      (fisher-remove-lure-snake! self)
      (process-release? *target*)
      (go-virtual idle)
    )
)

