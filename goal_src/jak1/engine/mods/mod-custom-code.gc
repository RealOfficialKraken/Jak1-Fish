(defun turn-to-scene-camera ((tpos vector) (cam-vec vector))
  (set-vector! (-> *target* control trans) (-> tpos x) (-> tpos y) (-> tpos z) 1.0)
  (send-event *camera* 'teleport-to-vector-start-string cam-vec)
  (send-event *target* 'draw #f)
  (process-grab? *target*)
  (none)
)

(defun revert-scene-camera ()
  (process-release? *target*)
  (send-event *target* 'draw #t)
  (none)
)

(defun main-menu-maintain-camera! ()
  (when
    (and
      in-main-menu?
      *main-menu-camera-ready?*
      (not *main-menu-new-game-transition?*)
      *target*
      *camera*)

    (set-vector!
      (-> *target* control trans)
      (-> *main-menu-target-pos* x)
      (-> *main-menu-target-pos* y)
      (-> *main-menu-target-pos* z)
      1.0)

    (send-event
      *camera*
      'teleport-to-vector-start-string
      *main-menu-camera-pos*))

  (none))

(deftype main-menu-fish-agent (process)
  ((visual       (pointer manipy))
    (direction    float)
    (speed        float)
    (travel       float)
    (height       float)
    (transition-start-height float)
    (depth        float))
  (:state-methods
    main-menu-fish-swim))

