(defun fisher-update-reel-hint! ((self fisher-game))
  (when
    (> (-> self reel-hint-time)
       0.0)

    (draw-mod-menu-text-custom ;;change this for progression skills
      "<PAD_X> TO REEL"
      10
      200
      #t
      #f
      #f)

    (-!
      (-> self reel-hint-time)
      (-> *display* seconds-per-frame))

    (when
      (< (-> self reel-hint-time)
         0.0)

      (set!
        (-> self reel-hint-time)
        0.0))
  )

  (none)
)

(defun fisher-launch-water-entry-bubbles! ((self fisher-game))
  (let ((spray-pos
          (new 'stack-no-clear 'vector)))

    (vector-copy!
      spray-pos
      (-> self lure-pos))

    (set!
      (-> spray-pos y)
      (- (-> self water-level)
         (meters 0.05)))

    (set!
      (-> spray-pos w)
      1.0)

    (launch-particles
      :system *sp-particle-system-2d*
      (-> *part-id-table* 3571)
      spray-pos)
  )

  (none)
)

(defun fisher-force-underwater-background! ()
  (when *time-of-day-context*
    (let ((hour
            (-> *time-of-day-context* time))

          (blend
            0.0)

          (r
            0.0)

          (g
            0.0)

          (b
            0.0))

      (cond
        ((and
           (>= hour 4.0)
           (< hour 7.0))

          (set!
            blend
            (/ (- hour 4.0)
               3.0))

          (set!
            r
            (+ 9.0
               (* (- 34.0 9.0)
                  blend)))

          (set!
            g
            (+ 88.0
               (* (- 110.0 88.0)
                  blend)))

          (set!
            b
            (+ 97.0
               (* (- 97.0 97.0)
                  blend)))
        )

        ((and
           (>= hour 7.0)
           (< hour 9.0))

          (set!
            blend
            (/ (- hour 7.0)
               2.0))

          (set!
            r
            (+ 34.0
               (* (- 62.0 34.0)
                  blend)))

          (set!
            g
            (+ 110.0
               (* (- 164.0 110.0)
                  blend)))

          (set!
            b
            (+ 97.0
               (* (- 175.0 97.0)
                  blend)))
        )

        ((and
          (>= hour 9.0)
          (< hour 12.0))

          (set! r 62.0)
          (set! g 164.0)
          (set! b 175.0)
        )

        ((and
          (>= hour 12.0)
          (< hour 18.0))

          (set!
            blend
            (/ (- hour 12.0)
              6.0))

          (set!
            r
            (+ 62.0
              (* (- 30.0 62.0)
                  blend)))

          (set!
            g
            (+ 164.0
              (* (- 72.0 164.0)
                  blend)))

          (set!
            b
            (+ 175.0
              (* (- 57.0 175.0)
                  blend)))
        )

        ((and
           (>= hour 18.0)
           (< hour 19.0))

          (set!
            blend
            (- hour 18.0))

          (set!
            r
            (+ 30.0
               (* (- 11.0 30.0)
                  blend)))

          (set!
            g
            (+ 72.0
               (* (- 44.0 72.0)
                  blend)))

          (set!
            b
            (+ 57.0
               (* (- 96.0 57.0)
                  blend)))
        )

        (else
          (cond
            ((and
              (>= hour 19.0)
              (< hour 24.0))

              (set! r 11.0)
              (set! g 44.0)
              (set! b 96.0)
            )

            ((< hour 3.0)
              (set! r 11.0)
              (set! g 44.0)
              (set! b 96.0)
            )

            (else
              (set!
                blend
                (- hour 3.0))

              (set!
                r
                (+ 11.0
                  (* (- 9.0 11.0)
                      blend)))

              (set!
                g
                (+ 44.0
                  (* (- 88.0 44.0)
                      blend)))

              (set!
                b
                (+ 96.0
                  (* (- 97.0 96.0)
                      blend)))
            )
          )
        )
      )

      (dotimes (i 12)
        (set!
          (-> sky-base-polygons i col x)
          r)

        (set!
          (-> sky-base-polygons i col y)
          g)

        (set!
          (-> sky-base-polygons i col z)
          b)

        (set!
          (-> sky-base-polygons i col w)
          128.0))
      (fisher-force-underwater-horizon! r g b)
    )
  )

  (none)
)

(defun fisher-update-camera-water! ((self fisher-game))
  (when (and *camera* (> (-> *camera* num-slaves) 0))
    (let ((cam-slave (-> *camera* slave 0 0)))
      (set!
        (-> self camera-underwater?)
        (< (-> cam-slave trans y)
           (-> self water-level)))
    )
  )

  (none)
)

