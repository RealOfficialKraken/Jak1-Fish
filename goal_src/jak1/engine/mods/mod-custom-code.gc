(defun fisher-roll-fish-suffix ()
  (let ((roll
        (rand-vu-int-range 0 99999)))

    (cond
      ((fisher-green-sun-hour?)
        (cond
          ((< roll 26000) 0)
          ((< roll 47000) 1)
          ((< roll 76000) 2)
          ((< roll 87000) 3)
          ((< roll 96750) 4)
          ((< roll 99750) 5)
          (else 6)))

      ((fisher-golden-hour?)
        (cond
          ((< roll 31000) 0)
          ((< roll 55500) 1)
          ((< roll 85000) 2)
          ((< roll 92500) 3)
          ((< roll 97900) 4)
          ((< roll 99900) 5)
          (else 6)))

      (else
        (cond
          ((< roll 35000) 0)
          ((< roll 62000) 1)
          ((< roll 93000) 2)
          ((< roll 97000) 3)
          ((< roll 99490) 4)
          ((< roll 99990) 5)
          (else 6))))))

(defun fisher-suffix-name ((suffix int))
  (cond
    ((= suffix 0) "MALNUTRITIONED")
    ((= suffix 1) "STRESSED")
    ((= suffix 2) "HEALTHY")
    ((= suffix 3) "MUTANT")
    ((= suffix 4) "RARE")
    ((= suffix 5) "LEGENDARY")
    (else "GOLDEN")))

(defun fisher-species-name ((species int)) (cond ((= species 1) "LARGEMOUTH ECOFISH") ((= species 2) "BABAK ECOFISH") (else "ECO DRUM")))

(defun fisher-suffix-value-multiplier ((suffix int))
  (cond
    ((= suffix 0) 0.50)
    ((= suffix 1) 0.75)
    ((= suffix 2) 1.00)
    ((= suffix 3) 1.50)
    ((= suffix 4) 2.00)
    ((= suffix 5) 3.00)
    (else 5.00)))

(defun fisher-assign-table-slots!
  ((self fisher-game) (eco-count int) (largemouth-count int) (babak-count int))

  (let* ((requested-count
        (+ eco-count largemouth-count babak-count))

      (new-count (min 22 requested-count))

      (babak-slots (min babak-count new-count))

      (largemouth-slots (min largemouth-count (- new-count babak-slots)))

      (i
        0))

    (set! (-> self fish-count) new-count)

    (while (< i new-count)
      (cond
        ((< i babak-slots) (fisher-set-fish-species! self i 2))

        ((< i (+ babak-slots largemouth-slots)) (fisher-set-fish-species! self i 1))

        (else
          (fisher-set-fish-species!
            self
            i
            0)))

      (fisher-set-fish-suffix! self i (fisher-roll-fish-suffix))

      (+! i 1)))

  (none))

(defun fisher-configure-sandover-table! ((self fisher-game))
  (let ((eco-count 0)
      (largemouth-count 0))

    (cond
      ((fisher-golden-hour?) (set! eco-count (rand-vu-int-range 6 8)) (set! largemouth-count (rand-vu-int-range 2 6)))

      (else
        (set! eco-count (rand-vu-int-range 2 3))
        (set! largemouth-count (rand-vu-int-range 1 3))))

    (set! (-> self sandover-eco-count) eco-count)
    (set! (-> self sandover-largemouth-count) largemouth-count)

    (fisher-assign-table-slots!
      self
      eco-count
      largemouth-count
      0))

  (none))

(defun fisher-configure-jungle-pillar-table! ((self fisher-game))
  (let ((total-count 0)
      (eco-count 0)
      (largemouth-count 0)
      (babak-count 0)
      (remaining-count 0))

    (cond
      ((fisher-golden-hour?) (set! total-count (rand-vu-int-range 16 23)) (set! babak-count (rand-vu-int-range 4 7)))

      (else
        (set! total-count (rand-vu-int-range 8 15))
        (set! babak-count (rand-vu-int-range 1 4))))

    (set! remaining-count (- total-count babak-count))

    (set! largemouth-count (rand-vu-int-range 1 remaining-count))

    (set! eco-count (- remaining-count largemouth-count))

    (set! (-> self sandover-eco-count) eco-count)
    (set! (-> self sandover-largemouth-count) largemouth-count)

    (fisher-assign-table-slots!
      self
      eco-count
      largemouth-count
      babak-count))

  (none))

(defun fisher-configure-location-table! ((self fisher-game))
  (if (= (-> self location-id) 1) (fisher-configure-jungle-pillar-table! self) (fisher-configure-sandover-table! self))

  (none))

(defun fisher-apply-slot-appearance!
  ((self fisher-game) (slot int) (fish-proc manipy) (catch-display? symbol))

  (let* ((suffix
        (fisher-fish-suffix self slot))

      (species (fisher-fish-species self slot))

      (base-scale
        (cond
          ((= species 2) (if catch-display? 0.95 0.75))

          (catch-display? 0.55)

          (else
            0.30)))

      (x-scale 1.0)

      (y-scale 1.0)

      (z-scale 1.0)

      (r (cond ((= species 1) 0.32) ((= species 2) 1.00) (else 0.25)))

      (g (cond ((= species 1) 0.78) ((= species 2) 1.00) (else 0.88)))

      (b
        (cond
          ((= species 1) 0.25)
          ((= species 2) 1.00)
          (else 1.00))))

    (cond
      ((= suffix 0) (set! x-scale 0.84) (set! z-scale 1.10))

      ((= suffix 1) (*! r 0.72) (*! g 0.72) (*! b 0.72))

      ((= suffix 3)
        (let ((color-roll
              (mod
                (+ (* slot 3) species)
                5)))

          (cond
            ((= color-roll 0) (set! r 0.20) (set! g 0.95) (set! b 0.25))

            ((= color-roll 1) (set! r 0.65) (set! g 0.20) (set! b 1.00))

            ((= color-roll 2) (set! r 0.10) (set! g 0.85) (set! b 0.95))

            ((= color-roll 3) (set! r 0.95) (set! g 0.15) (set! b 0.55))

            (else
              (set! r 0.85)
              (set! g 0.85)
              (set! b 0.15)))))

      ((= suffix 4) (*! r 1.10) (*! g 1.10) (*! b 1.10))

      ((= suffix 5) (*! x-scale 2.0) (*! y-scale 2.0) (*! z-scale 2.0))

      ((= suffix 6)
        (set! r 1.00)
        (set! g 0.72)
        (set! b 0.06)))

    (set-vector! (-> fish-proc root scale) (* base-scale x-scale) (* base-scale y-scale) (* base-scale z-scale) 1.0)

    (set! (-> fish-proc draw color-mult r) r)
    (set! (-> fish-proc draw color-mult g) g)
    (set! (-> fish-proc draw color-mult b) b)
    (set! (-> fish-proc draw color-mult a) 1.0))

  (none))

