  (fisher-set-fish-direction! self slot new-direction)

  (fisher-set-fish-turn-side! self slot (if (rand-vu-percent? 0.5) 1.0 -1.0))

  (fisher-set-fish-turn-time! self slot 0.0001)

  (none))

