(defun fisher-randomize-fish-slot!
  ((self fisher-game) (slot int))

  (fisher-set-fish-distance! self slot (rand-vu-float-range (meters 4.0) (meters 55.0)))

  (fisher-set-fish-lane! self slot (rand-vu-float-range (meters -1.35) (meters 1.35)))

  (fisher-set-fish-depth!
    self
    slot
    (cond
      ((= (fisher-fish-species self slot) 1) (rand-vu-float-range (meters 18.0) (meters 21.0)))

      ((= (fisher-fish-species self slot) 2) (rand-vu-float-range (meters 26.0) (meters 29.0)))

      (else
        (rand-vu-float-range
          (meters 10.0)
          (meters 13.0)))))

  (fisher-set-fish-direction! self slot (if (rand-vu-percent? 0.5) 1.0 -1.0))

  (fisher-set-fish-speed! self slot (rand-vu-float-range (meters 0.75) (meters 1.55)))

  (fisher-set-fish-cooldown! self slot 0.0)

  (fisher-set-fish-turn-time! self slot 0.0)

  (fisher-set-fish-turn-old-direction! self slot (fisher-fish-direction self slot))

  (fisher-set-fish-suffix! self slot (fisher-roll-fish-suffix))

  (none))

(defun fisher-fish-position!
  ((self fisher-game) (slot int) (dst vector))

  (let ((side-axis
        (new 'stack-no-clear 'vector)))

    (set! (-> side-axis x) (-> self playfield-axis z))
    (set! (-> side-axis y) 0.0)
    (set! (-> side-axis z) (- (-> self playfield-axis x)))
    (set! (-> side-axis w) 0.0)

    (singlefish-vector-normalize-safe! side-axis 1.0)

    (singlefish-vector-add-scaled-safe! dst (-> self fishing-player-pos) (-> self playfield-axis) (fisher-fish-distance self slot))

    (singlefish-vector-add-scaled-safe! dst dst side-axis (fisher-fish-lane self slot))

    (set! (-> dst y) (- (-> self water-level) (fisher-fish-depth self slot)))

    (set! (-> dst w) 1.0))

  dst)

(defun fisher-set-manipy-facing!
  ((self fisher-game) (slot int) (fish-proc manipy))

  (let ((forward
        (new 'stack-no-clear 'vector))

      (side-forward (new 'stack-no-clear 'vector))

      (side-axis (new 'stack-no-clear 'vector))

      (down (new 'stack-no-clear 'vector))

      (rot (new 'stack-no-clear 'matrix))

      (turn-time
        (fisher-fish-turn-time self slot)))

    (cond
      ((> turn-time 0.0)
        (let* ((duration
              0.42)

            (progress (fmin 1.0 (/ turn-time duration)))

            (angle
              (* (degrees 180.0) progress)))

          (singlefish-vector-scale-safe! forward (-> self playfield-axis) (* (fisher-fish-turn-old-direction self slot) (cos angle)))

          (set! (-> side-axis x) (-> self playfield-axis z))
          (set! (-> side-axis y) 0.0)
          (set! (-> side-axis z) (- (-> self playfield-axis x)))
          (set! (-> side-axis w) 0.0)

          (singlefish-vector-normalize-safe! side-axis 1.0)

          (singlefish-vector-scale-safe! side-forward side-axis (* (fisher-fish-turn-side self slot) (sin angle)))

          (singlefish-vector-add-safe! forward forward side-forward)

          (+! turn-time (-> *display* seconds-per-frame))

          (if
            (>= turn-time duration)

            (fisher-set-fish-turn-time! self slot 0.0)

            (fisher-set-fish-turn-time!
              self
              slot
              turn-time))))

      (else
        (singlefish-vector-scale-safe!
          forward
          (-> self playfield-axis)
          (fisher-fish-direction self slot))))

    (set! (-> forward y) 0.0)
    (set! (-> forward w) 0.0)

    (singlefish-vector-normalize-safe! forward 1.0)

    (set-vector! down 0.0 -1.0 0.0 0.0)

    (forward-down->inv-matrix rot forward down)

    (matrix->quaternion
      (-> fish-proc root quat)
      rot))

  (none))

(defun fisher-spawn-gameplay-fish
  ((owner fisher-game) (slot int))

  (let ((pos
        (new 'stack-no-clear 'vector))

      (fish
        (the-as (pointer manipy) #f)))

    (fisher-fish-position! owner slot pos)

    (set!
      fish
      (the-as
        (pointer manipy)
        (manipy-spawn
          pos
          #f
          (cond
            ((= (fisher-fish-species owner slot) 1) *catch-fishb-sgc*)

            ((= (fisher-fish-species owner slot) 2) *fisher-junglefish-sg*)

            (else
              *catch-fisha-sgc*))
          #f
          :from *default-dead-pool*
          :to *default-pool*
          :name "fisher-gameplay-fish")))

    (when fish
      (let ((fish-proc
            (-> fish 0 self)))

        (when fish-proc
          (send-event fish-proc 'anim-mode 'loop)
          (send-event fish-proc 'max-vis-dist (meters 999999.0))

          (set! (-> (the-as manipy fish-proc) root trans quad) (-> pos quad))

          (fisher-apply-slot-appearance! owner slot (the-as manipy fish-proc) #f)

          (fisher-set-manipy-facing!
            owner
            slot
            (the-as manipy fish-proc)))))

    fish))

(defun fisher-refill-missing-fish! ((self fisher-game))
  (dotimes (i 22)
    (when
      (and (< i (-> self fish-count)) (not (fisher-fish-pointer self i)))

      (fisher-randomize-fish-slot! self i)

      (fisher-set-fish-pointer!
        self
        i
        (fisher-spawn-gameplay-fish
          self
          i))))

  (none))

(defun singlefish-start-session! ((self fisher-game))
  (dotimes (i 22)
    (let ((old-fish
          (fisher-fish-pointer self i)))

      (when old-fish (deactivate (-> old-fish 0)))

      (fisher-set-fish-pointer!
        self
        i
        (the-as (pointer manipy) #f))))

  (+! *singlefish-session-id* 1)
  (set! *singlefish-session-active?* #t)
  (set! (-> self hooked-fish) #f)
  (set! (-> self hooked-fish-slot) -1)
  (set! (-> self fish-state) 'free)

  (fisher-configure-location-table! self)

  (set! (-> self fish-hook-time) 0.0)
  (set! (-> self fish-reel-progress) 0.0)
  (set! (-> self fish-fight-time) 0.0)
  (set! (-> self fish-fighting?) #f)

  (dotimes (i 22)
    (fisher-randomize-fish-slot! self i)

    (fisher-set-fish-pointer!
      self
      i
      (if
        (< i (-> self fish-count))
        (fisher-spawn-gameplay-fish self i)
        (the-as (pointer manipy) #f))))

  (none))

(defun fisher-manipy-distance-to-lure
  ((self fisher-game) (fish-proc manipy))

  (let ((delta
        (new 'stack-no-clear 'vector)))

    (singlefish-vector-sub-safe! delta (-> self lure-pos) (-> fish-proc root trans))

    (singlefish-vector-length-safe
      delta)))

(defun fisher-debug-draw-logical-fish-marker!
  ((self fisher-game) (slot int))

  (when
    (and *fisher-in-debug?* (< slot (-> self fish-count)))

    (let ((center (new 'stack-no-clear 'vector))
        (left (new 'stack-no-clear 'vector))
        (right (new 'stack-no-clear 'vector))
        (top (new 'stack-no-clear 'vector))
        (bottom (new 'stack-no-clear 'vector))
        (front (new 'stack-no-clear 'vector))
        (back (new 'stack-no-clear 'vector))
        (color
          (if
            (= (fisher-fish-species self slot) 2)
            (new 'static 'rgba :r #xff :g #x20 :b #xff :a #xff)
            (new 'static 'rgba :r #xff :g #xff :b #xff :a #xff))))

      (fisher-fish-position! self slot center)
      (singlefish-vector-copy-safe! left center)
      (singlefish-vector-copy-safe! right center)
      (singlefish-vector-copy-safe! top center)
      (singlefish-vector-copy-safe! bottom center)
      (singlefish-vector-copy-safe! front center)
      (singlefish-vector-copy-safe! back center)

      (-! (-> left x) (meters 0.6))
      (+! (-> right x) (meters 0.6))
      (+! (-> top y) (meters 0.6))
      (-! (-> bottom y) (meters 0.6))
      (+! (-> front z) (meters 0.6))
      (-! (-> back z) (meters 0.6))

      (fisher-debug-line! left right color)
      (fisher-debug-line! top bottom color)
      (fisher-debug-line! front back color)))

  (none))

(defun fisher-debug-draw-fish-cone!
  ((self fisher-game) (slot int) (fish-proc manipy))

  (when *fisher-in-debug?*
    (let ((origin
          (new 'stack-no-clear 'vector))

        (forward (new 'stack-no-clear 'vector))

        (upper-edge (new 'stack-no-clear 'vector))

        (forward-end (new 'stack-no-clear 'vector))

        (upper-end (new 'stack-no-clear 'vector))

        (arc-a (new 'stack-no-clear 'vector))

        (arc-b (new 'stack-no-clear 'vector))

        (color (new 'static 'rgba :r #x20 :g #xff :b #xff :a #xff))

        (range
          (meters 4.0)))

      (singlefish-vector-copy-safe! origin (-> fish-proc root trans))

      (singlefish-vector-scale-safe! forward (-> self playfield-axis) (fisher-fish-direction self slot))

      (set! (-> forward y) 0.0)
      (set! (-> forward w) 0.0)

      (singlefish-vector-normalize-safe! forward 1.0)

      (set! (-> upper-edge x) (* (-> forward x) 0.8191520))

      (set! (-> upper-edge y) 0.5735764)

      (set! (-> upper-edge z) (* (-> forward z) 0.8191520))

      (set! (-> upper-edge w) 0.0)

      (singlefish-vector-normalize-safe! upper-edge 1.0)

      (singlefish-vector-add-scaled-safe! forward-end origin forward range)

      (singlefish-vector-add-scaled-safe! upper-end origin upper-edge range)

      (fisher-debug-line! origin forward-end color)

      (fisher-debug-line! origin upper-end color)

      (dotimes (i 7)
        (let ((angle-a
              (* 5.0 (the float i)))

            (angle-b (* 5.0 (the float (+ i 1))))

            (dir-a (new 'stack-no-clear 'vector))

            (dir-b
              (new 'stack-no-clear 'vector)))

          (set! (-> dir-a x) (* (-> forward x) (cos (degrees angle-a))))

          (set! (-> dir-a y) (sin (degrees angle-a)))

          (set! (-> dir-a z) (* (-> forward z) (cos (degrees angle-a))))

          (set! (-> dir-a w) 0.0)

          (set! (-> dir-b x) (* (-> forward x) (cos (degrees angle-b))))

          (set! (-> dir-b y) (sin (degrees angle-b)))

          (set! (-> dir-b z) (* (-> forward z) (cos (degrees angle-b))))

          (set! (-> dir-b w) 0.0)

          (singlefish-vector-add-scaled-safe! arc-a origin dir-a range)

          (singlefish-vector-add-scaled-safe! arc-b origin dir-b range)

          (fisher-debug-line!
            arc-a
            arc-b
            color)))))

  (none))

(defun fisher-manipy-can-sense-lure?
  ((self fisher-game) (slot int) (fish-proc manipy))

  (let ((to-lure
        (new 'stack-no-clear 'vector))

      (forward (new 'stack-no-clear 'vector))

      (distance 0.0)

      (horizontal-distance 0.0)

      (facing-dot
        0.0))

    (singlefish-vector-sub-safe! to-lure (-> self lure-pos) (-> fish-proc root trans))

    (set! distance (singlefish-vector-length-safe to-lure))

    (set! (-> to-lure y) 0.0)
    (set! (-> to-lure w) 0.0)

    (set! horizontal-distance (singlefish-vector-length-safe to-lure))

    (when (> horizontal-distance (meters 0.001)) (singlefish-vector-normalize-safe! to-lure 1.0))

    (singlefish-vector-scale-safe! forward (-> self playfield-axis) (fisher-fish-direction self slot))

    (set! (-> forward y) 0.0)
    (set! (-> forward w) 0.0)

    (singlefish-vector-normalize-safe! forward 1.0)

    (set! facing-dot (vector-dot forward to-lure))

    (and
      (<= distance (meters 5.0))
      (> horizontal-distance (meters 0.001))
      (>= facing-dot 0.8191520))))

(defun fisher-move-manipy-toward!
  ((fish-proc manipy) (target vector) (speed float))

  (let ((delta
        (new 'stack-no-clear 'vector))

      (distance 0.0)

      (step
        0.0))

    (singlefish-vector-sub-safe! delta target (-> fish-proc root trans))

    (set! distance (singlefish-vector-length-safe delta))

    (when (> distance (meters 0.001))
      (singlefish-vector-normalize-safe! delta 1.0)

      (set! step (fmin distance (* speed (-> *display* seconds-per-frame))))

      (singlefish-vector-add-scaled-safe!
        (-> fish-proc root trans)
        (-> fish-proc root trans)
        delta
        step))

    distance))

(defun fisher-fish-scared-off!
  ((self fisher-game) (slot int))

  (let ((fish
        (fisher-fish-pointer
          self
          slot))

      (from-origin (new 'stack-no-clear 'vector))

      (side-axis
        (new 'stack-no-clear 'vector)))

    (when fish
      (let ((fish-proc
            (the-as manipy
              (-> fish 0 self))))

        (singlefish-vector-sub-safe! from-origin (-> fish-proc root trans) (-> self fishing-player-pos))

        (set! (-> side-axis x) (-> self playfield-axis z))
        (set! (-> side-axis y) 0.0)
        (set! (-> side-axis z) (- (-> self playfield-axis x)))
        (set! (-> side-axis w) 0.0)

        (singlefish-vector-normalize-safe! side-axis 1.0)

        (fisher-set-fish-distance! self slot (fmax (meters 3.5) (fmin (meters 55.5) (vector-dot from-origin (-> self playfield-axis)))))

        (fisher-set-fish-lane! self slot (fmax (meters -1.5) (fmin (meters 1.5) (vector-dot from-origin side-axis))))

        (fisher-set-fish-depth!
          self
          slot
          (-
            (-> self water-level)
            (-> fish-proc root trans y))))))

  (fisher-set-fish-direction! self slot (if (rand-vu-percent? 0.5) 1.0 -1.0))

  (fisher-set-fish-turn-time! self slot 0.0)

  (fisher-set-fish-cooldown! self slot 2.0)

  (set! (-> self hooked-fish-slot) -1)
  (set! (-> self fish-state) 'free)
  (set! (-> self fish-scare-on-arrival?) #f)
  (set! (-> self fish-hook-time) 0.0)
  (set! (-> self fish-reel-progress) 0.0)
  (set! (-> self fish-fighting?) #f)
  (set! (-> self fish-fight-time) 0.0)
  (set! (-> self fish-fight-phase) 0.0)
  (set! (-> self fish-message) "SCARED OFF")
  (set! (-> self fish-message-time) 1.5)

  (none))

(defun fisher-finish-manipy-catch!
  ((self fisher-game) (slot int))

  (fisher-play-fish-win-sound!)

  (let* ((species
        (fisher-fish-species self slot))

      (suffix (fisher-fish-suffix self slot))

      (base-weight
        (cond
          ((= species 1) (rand-vu-int-range 20 50))

          ((= species 2) (rand-vu-int-range 20 41))

          (else
            (rand-vu-int-range 10 20))))

      (weight
        (cond
          ((= suffix 0) (max 1 (the int (* (the float base-weight) (rand-vu-float-range 0.45 0.65)))))

          ((= suffix 1) (max 1 (the int (* (the float base-weight) (rand-vu-float-range 0.72 0.88)))))

          ((= suffix 5) (* base-weight 2))

          ((= suffix 6) (* base-weight 18))

          (else
            base-weight)))

      (value-mult (fisher-suffix-value-multiplier suffix))

      (base-value
        (if
          (or (= species 1) (= species 2))
          2.0
          1.0)))

    (set! (-> self caught-fish-species) species)

    (set! (-> self caught-fish-suffix) suffix)

    (set! (-> self caught-weight-tenths) weight)

    (set!
      (-> self caught-orb-value)
      (max
        1
        (the int
          (+
            (* (the float weight) 0.1 base-value value-mult 0.5)
            0.5)))))

  (set! (-> self fish-state) 'catch-return)
  (set! (-> self cast-state) 'catch-transition)
  (set! (-> self catch-transition-time) 0.0)
  (set! (-> self catch-menu-offset) 150.0)
  (set! (-> self camera-state) 'before-cast)
  (set! (-> self casted?) #f)
  (set! (-> self fish-fighting?) #f)
  (set! (-> self fish-fight-time) 0.0)
  (set! (-> self fish-fight-phase) 0.0)
  (set! (-> self fish-fight-base-y) 0.0)
  (stop-sound-file "water-waves.wav")
  (fisher-remove-lure-snake! self)

  (none))

(defun fisher-smoothstep ((value float)) (* value value (- 3.0 (* 2.0 value))))

(defun fisher-catch-display-fish-position!
  ((self fisher-game) (dst vector))

  (let ((camera-forward
        (new 'stack-no-clear 'vector)))

    (singlefish-vector-sub-safe! camera-forward (-> self fisher-look) (-> self fisher-cam))

    (singlefish-vector-normalize-safe! camera-forward 1.0)

    (singlefish-vector-add-scaled-safe! dst (-> self fisher-cam) camera-forward (meters 5.0))

    (+! (-> dst y) (+ (meters 0.55) (* (meters -0.030) (-> self catch-menu-offset))))

    (set! (-> dst w) 1.0))

  dst)

(defun fisher-spawn-catch-display-fish! ((self fisher-game))
  (let ((slot
        (-> self hooked-fish-slot))

      (pos (new 'stack-no-clear 'vector))

      (fish
        (the-as (pointer manipy) #f)))

    (when (>= slot 0)
      (fisher-set-fish-species! self slot (-> self caught-fish-species))

      (fisher-set-fish-suffix! self slot (-> self caught-fish-suffix))

      (fisher-catch-display-fish-position! self pos)

      (set!
        fish
        (the-as
          (pointer manipy)
          (manipy-spawn
            pos
            #f
            (cond
              ((= (-> self caught-fish-species) 1) *catch-fishb-sgc*)

              ((= (-> self caught-fish-species) 2) *fisher-junglefish-sg*)

              (else
                *catch-fisha-sgc*))
            #f
            :from *default-dead-pool*
            :to *default-pool*
            :name "fisher-catch-display-fish")))

      (fisher-set-fish-pointer! self slot fish)

      (when fish
        (let ((fish-proc
              (the-as manipy
                (-> fish 0 self))))

          (send-event fish-proc 'anim-mode 'loop)

          (send-event fish-proc 'max-vis-dist (meters 999999.0))

          (set! (-> fish-proc root trans quad) (-> pos quad))

          (fisher-apply-slot-appearance!
            self
            slot
            fish-proc
            #t)))))

  (none))

(defun fisher-update-catch-return! ((self fisher-game))
  (let* ((dt
        (-> *display* seconds-per-frame))

      (slot (-> self hooked-fish-slot))

      (fish (if (>= slot 0) (fisher-fish-pointer self slot) (the-as (pointer manipy) #f)))

      (jak-pos (new 'stack-no-clear 'vector))

      (delta (new 'stack-no-clear 'vector))

      (distance
        0.0))

    (+! (-> self catch-transition-time) dt)

    (when
      (and *camera* (> (-> *camera* num-slaves) 0))

      (let* ((cam-slave
            (-> *camera* slave 0 0))

          (camera-blend (fmin 1.0 (* dt 3.2)))

          (camera-pos (new 'stack-no-clear 'vector))

          (camera-forward
            (new 'stack-no-clear 'vector)))

        (vector-lerp! camera-pos (-> cam-slave trans) (-> self fisher-cam) camera-blend)

        (set! (-> cam-slave saved-pt quad) (-> camera-pos quad))

        (set! (-> cam-slave trans quad) (-> camera-pos quad))

        (vector-! camera-forward (-> self fisher-look) camera-pos)

        (when
          (> (singlefish-vector-length-safe camera-forward) (meters 0.001))

          (singlefish-vector-normalize-safe! camera-forward 1.0)

          (forward-down->inv-matrix
            (-> cam-slave tracking inv-mat)
            camera-forward
            (-> *camera* local-down)))))

    (when fish
      (let ((fish-proc
            (the-as manipy
              (-> fish 0 self))))

        (vector-copy! jak-pos (target-pos 0))

        (+! (-> jak-pos y) (meters 1.15))

        (vector-! delta jak-pos (-> fish-proc root trans))

        (set! distance (singlefish-vector-length-safe delta))

        (when (> distance (meters 0.001))
          (singlefish-vector-normalize-safe! delta (fmin distance (* (meters 12.0) dt)))

          (vector+!
            (-> fish-proc root trans)
            (-> fish-proc root trans)
            delta))

        (when
          (or (<= distance (meters 0.30)) (>= (-> self catch-transition-time) 2.0))

          (deactivate (-> fish 0))

          (fisher-set-fish-pointer! self slot (the-as (pointer manipy) #f))

          (fisher-spawn-catch-display-fish! self)

          (set! (-> self fish-state) 'catch-enter)
          (set! (-> self cast-state) 'catch-display)
          (set! (-> self catch-transition-time) 0.0)
          (set! (-> self catch-menu-offset) 150.0)))))

  (none))

(defun fisher-sell-manipy-catch!
  ((self fisher-game))

  (when *target* (send-event *target* 'get-pickup (pickup-type money) (the float (-> self caught-orb-value))))

  (let ((slot
        (-> self hooked-fish-slot)))

    (when (>= slot 0)
      (let ((fish
            (fisher-fish-pointer
              self
              slot)))

        (when fish (deactivate (-> fish 0)))

        (fisher-set-fish-pointer! self slot (the-as (pointer manipy) #f))

        (fisher-randomize-fish-slot!
          self
          slot))))

  (set! (-> self hooked-fish-slot) -1)
  (set! (-> self fish-state) 'free)
  (set! (-> self fish-message) "FISH SOLD")
  (set! (-> self fish-message-time) 1.25)
  (set! (-> self caught-weight-tenths) 0)
  (set! (-> self caught-orb-value) 0)
  (set! (-> self catch-transition-time) 0.0)
  (set! (-> self catch-menu-offset) 0.0)

  (fisher-reset-cast! self)

  (none))

(defun fisher-update-catch-menu-animation! ((self fisher-game))
  (let ((dt
        (-> *display* seconds-per-frame)))

    (+! (-> self catch-transition-time) dt)

    (cond
      ((= (-> self fish-state) 'catch-enter)
        (let* ((duration
              0.65)

            (progress (fmin 1.0 (/ (-> self catch-transition-time) duration)))

            (ease (fisher-smoothstep progress))

            (bounce
              (*
                10.0
                (sin (* (degrees 540.0) progress))
                (- 1.0 progress))))

          (set! (-> self catch-menu-offset) (+ (* 150.0 (- 1.0 ease)) bounce))

          (when (>= progress 1.0)
            (set! (-> self catch-menu-offset) 0.0)
            (set! (-> self catch-transition-time) 0.0)
            (set! (-> self fish-state) 'catch-display))))

      ((= (-> self fish-state) 'catch-exit)
        (let* ((duration
              0.48)

            (progress (fmin 1.0 (/ (-> self catch-transition-time) duration)))

            (ease
              (fisher-smoothstep progress)))

          (set! (-> self catch-menu-offset) (* 150.0 ease))

          (when (>= progress 1.0)
            (fisher-sell-manipy-catch!
              self))))))

  (none))

(defun fisher-draw-manipy-fish-marker!
  ((fish (pointer manipy)))

  (when
    (and *fisher-in-debug?* fish)

    (let ((fish-proc
          (-> fish 0 self)))

      (when fish-proc
        (let ((left (new 'stack-no-clear 'vector))
            (right (new 'stack-no-clear 'vector))
            (top (new 'stack-no-clear 'vector))
            (bottom (new 'stack-no-clear 'vector))
            (front (new 'stack-no-clear 'vector))
            (back (new 'stack-no-clear 'vector))
            (color
              (new 'static
                'rgba
                :r #xff
                :g #xff
                :b #xff
                :a #xff)))

          (singlefish-vector-copy-safe! left (-> (the-as manipy fish-proc) root trans))

          (singlefish-vector-copy-safe! right (-> (the-as manipy fish-proc) root trans))

          (singlefish-vector-copy-safe! top (-> (the-as manipy fish-proc) root trans))

          (singlefish-vector-copy-safe! bottom (-> (the-as manipy fish-proc) root trans))

          (singlefish-vector-copy-safe! front (-> (the-as manipy fish-proc) root trans))

          (singlefish-vector-copy-safe! back (-> (the-as manipy fish-proc) root trans))

          (-! (-> left x) (meters 1.0))
          (+! (-> right x) (meters 1.0))
          (+! (-> top y) (meters 1.0))
          (-! (-> bottom y) (meters 1.0))
          (+! (-> front z) (meters 1.0))
          (-! (-> back z) (meters 1.0))

          (fisher-debug-line! left right color)
          (fisher-debug-line! top bottom color)
          (fisher-debug-line! front back color)))))

  (none))

(defun fisher-hook-target!
  ((self fisher-game) (dst vector))

  (cond
    ((-> self lure-snake) (singlefish-vector-copy-safe! dst (-> (the-as manipy (-> (-> self lure-snake) 0 self)) root trans)))

    (else
      (singlefish-vector-copy-safe!
        dst
        (-> self lure-pos))))

  (set! (-> dst w) 1.0)
  dst)

(defun fisher-camera-catch-display!
  ((self fisher-game))

  (when
    (and *camera* (> (-> *camera* num-slaves) 0))

    (let ((cam-slave
          (-> *camera* slave 0 0))

        (forward
          (new 'stack-no-clear 'vector)))

      (set! (-> cam-slave saved-pt quad) (-> self fisher-cam quad))

      (set! (-> cam-slave trans quad) (-> self fisher-cam quad))

      (vector-! forward (-> self fisher-look) (-> self fisher-cam))

      (when
        (> (singlefish-vector-length-safe forward) (meters 0.001))

        (vector-normalize! forward 1.0)

        (forward-down->inv-matrix
          (-> cam-slave tracking inv-mat)
          forward
          (-> *camera* local-down)))))

  (none))

(defun fisher-hooked-fish-mouth-offset
  ((self fisher-game))

  (cond
    ((< (-> self hooked-fish-slot) 0) (meters 0.42))

    ((= (fisher-fish-species self (-> self hooked-fish-slot)) 1) (meters 0.55))

    ((= (fisher-fish-species self (-> self hooked-fish-slot)) 2) (meters 0.48))

    (else
      (meters 0.42))))

(defun fisher-begin-hook-transition!
  ((self fisher-game) (fish-proc manipy) (hook-pos vector))

  (let ((facing
        (new 'stack-no-clear 'vector))

      (mouth-pos (new 'stack-no-clear 'vector))

      (mouth-offset
        (fisher-hooked-fish-mouth-offset self)))

    (singlefish-vector-sub-safe! facing hook-pos (-> fish-proc root trans))

    (set! (-> facing w) 0.0)

    (when
      (<= (singlefish-vector-length-safe facing) 0.001)

      (singlefish-vector-scale-safe!
        facing
        (-> self playfield-axis)
        -1.0))

    (singlefish-vector-normalize-safe! facing 1.0)

    (singlefish-vector-copy-safe! (-> self hooked-fish-facing) facing)

    (singlefish-vector-add-scaled-safe! mouth-pos (-> fish-proc root trans) facing mouth-offset)

    (singlefish-vector-copy-safe!
      (-> self hooked-fish-last-hook-pos)
      mouth-pos))

  (none))

(defun fisher-animate-hooked-fish!
  ((self fisher-game) (fish-proc manipy) (hook-pos vector) (fighting? symbol))

  (let ((target-facing
        (new 'stack-no-clear 'vector))

      (smoothed-facing (new 'stack-no-clear 'vector))

      (side-axis (new 'stack-no-clear 'vector))

      (active-hook (new 'stack-no-clear 'vector))

      (root-pos (new 'stack-no-clear 'vector))

      (down (new 'stack-no-clear 'vector))

      (rot (new 'stack-no-clear 'matrix))

      (dt (-> *display* seconds-per-frame))

      (face-blend 0.0)

      (hook-blend 1.0)

      (turn-angle 0.0)

      (fight-pitch 0.0)

      (mouth-offset
        (fisher-hooked-fish-mouth-offset self)))

    (set! (-> side-axis x) (-> (-> self playfield-axis) z))

    (set! (-> side-axis y) 0.0)

    (set! (-> side-axis z) (- (-> (-> self playfield-axis) x)))

    (set! (-> side-axis w) 0.0)

    (singlefish-vector-normalize-safe! side-axis 1.0)

    (cond
      (fighting?
        (set! turn-angle (fmin (degrees 180.0) (-> self fish-fight-phase)))

        (singlefish-vector-scale-safe! target-facing (-> self playfield-axis) (- (cos turn-angle)))

        (singlefish-vector-add-scaled-safe! target-facing target-facing side-axis (sin turn-angle))

        (when
          (>= (-> self fish-fight-phase) (degrees 180.0))

          (set!
            fight-pitch
            (*
              0.28
              (sin
                (-
                  (-> self fish-fight-phase)
                  (degrees 180.0))))))

        (set!
          (-> target-facing y)
          fight-pitch))

      (else
        (cond
          ((> (-> self fish-fight-phase) 0.0)
            (-! (-> self fish-fight-phase) (* (degrees 360.0) dt))

            (when
              (< (-> self fish-fight-phase) 0.0)

              (set!
                (-> self fish-fight-phase)
                0.0))

            (set! turn-angle (-> self fish-fight-phase))

            (singlefish-vector-scale-safe! target-facing (-> self playfield-axis) (- (cos turn-angle)))

            (singlefish-vector-add-scaled-safe! target-facing target-facing side-axis (sin turn-angle))

            (set!
              (-> target-facing y)
              0.0))

          (else
            (singlefish-vector-scale-safe! target-facing (-> self playfield-axis) -1.0)

            (set!
              (-> target-facing y)
              0.72)))))

    (set! (-> target-facing w) 0.0)

    (singlefish-vector-normalize-safe! target-facing 1.0)

    (set! face-blend (fmin 1.0 (* dt 6.5)))

    (set! (-> smoothed-facing x) (+ (-> (-> self hooked-fish-facing) x) (* (- (-> target-facing x) (-> (-> self hooked-fish-facing) x)) face-blend)))

    (set! (-> smoothed-facing y) (+ (-> (-> self hooked-fish-facing) y) (* (- (-> target-facing y) (-> (-> self hooked-fish-facing) y)) face-blend)))

    (set! (-> smoothed-facing z) (+ (-> (-> self hooked-fish-facing) z) (* (- (-> target-facing z) (-> (-> self hooked-fish-facing) z)) face-blend)))

    (set! (-> smoothed-facing w) 0.0)

    (singlefish-vector-normalize-safe! smoothed-facing 1.0)

    (singlefish-vector-copy-safe! (-> self hooked-fish-facing) smoothed-facing)

    (when
      (= (-> self fish-state) 'hook-window)

      (set!
        hook-blend
        (fmin
          1.0
          (* dt 7.5))))

    (set!
      (-> active-hook x)
      (+
        (-> (-> self hooked-fish-last-hook-pos) x)
        (*
          (- (-> hook-pos x) (-> (-> self hooked-fish-last-hook-pos) x))
          hook-blend)))

    (set!
      (-> active-hook y)
      (+
        (-> (-> self hooked-fish-last-hook-pos) y)
        (*
          (- (-> hook-pos y) (-> (-> self hooked-fish-last-hook-pos) y))
          hook-blend)))

    (set!
      (-> active-hook z)
      (+
        (-> (-> self hooked-fish-last-hook-pos) z)
        (*
          (- (-> hook-pos z) (-> (-> self hooked-fish-last-hook-pos) z))
          hook-blend)))

    (set! (-> active-hook w) 1.0)

    (singlefish-vector-copy-safe! (-> self hooked-fish-last-hook-pos) active-hook)

    (singlefish-vector-add-scaled-safe! root-pos active-hook smoothed-facing (- mouth-offset))

    (set! (-> fish-proc root trans quad) (-> root-pos quad))

    (set-vector! down 0.0 -1.0 0.0 0.0)

    (forward-down->inv-matrix rot smoothed-facing down)

    (matrix->quaternion
      (-> fish-proc root quat)
      rot))

  (none))

(defun fisher-update-lure! ((self fisher-game))
  (let ((dt (-> *display* seconds-per-frame))
      (from-jak (new 'stack-no-clear 'vector))
      (horizontal-distance 0.0)
      (saved-y 0.0)
      (top-y (- (-> self water-level) (meters 3.0)))
      (bottom-y (- (-> self water-level) (meters 36.0)))
      (current-speed -0.18)
      (bottom-current-speed -0.28))

    (vector-! from-jak (-> self lure-pos) (-> self fishing-player-pos))

    (set! horizontal-distance (vector-dot from-jak (-> self lure-cast-axis)))

    (cond
      ((cpad-hold? 0 x)
        (vector+float*! (-> self lure-pos) (-> self lure-pos) (-> self lure-cast-axis) (- (* (meters 1.0) (-> self lure-reel-x-speed) dt)))

        (+! (-> self lure-pos y) (* (meters 1.0) (-> self lure-reel-y-speed) dt))

        (set! (-> self lure-x-velocity) (- (-> self lure-reel-x-speed)))

        (set! (-> self lure-y-velocity) 0.0)
      )

      (else
        (cond
          ((> horizontal-distance
              (meters 2.0))

            (cond
              ((<=
                  (-> self lure-pos y)
                  (+ bottom-y
                    (meters 0.75)))

                (set! (-> self lure-x-velocity) bottom-current-speed)
              )

              (else (set! (-> self lure-x-velocity) current-speed))
            )

            (vector+float*! (-> self lure-pos) (-> self lure-pos) (-> self lure-cast-axis) (* (meters 1.0) (-> self lure-x-velocity) dt))
          )

          (else (set! (-> self lure-x-velocity) 0.0))
        )

        (-! (-> self lure-y-velocity) (* 1.2 dt))

        (when
          (< (-> self lure-y-velocity) (- (-> self lure-fall-speed)))

          (set! (-> self lure-y-velocity) (- (-> self lure-fall-speed)))
        )

        (+! (-> self lure-pos y) (* (meters 1.0) (-> self lure-y-velocity) dt))
      )
    )

    (vector-! from-jak (-> self lure-pos) (-> self fishing-player-pos))

    (set! horizontal-distance (vector-dot from-jak (-> self lure-cast-axis)))

    (set! saved-y (-> self lure-pos y))

    (cond
      ((< horizontal-distance
          (meters 2.0))

        (vector+float*! (-> self lure-pos) (-> self fishing-player-pos) (-> self lure-cast-axis) (meters 2.0))

        (set! (-> self lure-pos y) saved-y)

        (set! (-> self lure-x-velocity) 0.0)
      )

      ((> horizontal-distance
          (meters 55.5))

        (vector+float*! (-> self lure-pos) (-> self fishing-player-pos) (-> self lure-cast-axis) (meters 55.5))

        (set! (-> self lure-pos y) saved-y)

        (set! (-> self lure-x-velocity) 0.0)
      )
    )

    (when
      (> (-> self lure-pos y) top-y)

      (set! (-> self lure-pos y) top-y)

      (when
        (> (-> self lure-y-velocity) 0.0)

        (set!
          (-> self lure-y-velocity)
          0.0))
    )

    (when
      (< (-> self lure-pos y) bottom-y)

      (set! (-> self lure-pos y) bottom-y)

      (set! (-> self lure-y-velocity) 0.48)
    )

    (vector-! from-jak (-> self lure-pos) (-> self fishing-player-pos))

    (set! horizontal-distance (vector-dot from-jak (-> self lure-cast-axis)))

    (when
      (and
        (>= (-> self lure-pos y) (- (-> self water-level) (meters 3.05)))

        (<=
          horizontal-distance
          (meters 4.0)))

      (fisher-reset-cast! self))
  )

  (none)
)

(defun fisher-update-manipy-reeling!
  ((self fisher-game))

  (let* ((dt
        (-> *display* seconds-per-frame))

      (from-jak (new 'stack-no-clear 'vector))

      (horizontal-distance 0.0)

      (top-y
        (- (-> self water-level)
          (meters 3.0))))

    (cond
      ((-> self fish-fighting?)
        (+! (-> self fish-fight-phase) (* (degrees 420.0) dt))

        (vector+float*! (-> self lure-pos) (-> self lure-pos) (-> self lure-cast-axis) (* (meters 1.35) dt))

        (set! (-> self lure-pos y) (+ (-> self fish-fight-base-y) (* (meters 0.055) (sin (-> self fish-fight-phase)))))

        (when (cpad-hold? 0 x)
          (fisher-damage-line!
            (*
              (if (and (>= (-> self hooked-fish-slot) 0) (= (fisher-fish-species self (-> self hooked-fish-slot)) 1)) 52.0 34.0)
              dt)))

        (when *fisher-line-broken?*
          (let ((slot
                (-> self hooked-fish-slot)))

            (fisher-reset-cast! self)
            (set! (-> self fish-message) "LINE BROKEN")
            (set! (-> self fish-message-time) 1.75)

            (when (>= slot 0)
              (fisher-fish-scared-off!
                self
                slot)))))

      (else
        (fisher-update-lure! self)

        (vector-! from-jak (-> self lure-pos) (-> self pos))

        (set! horizontal-distance (vector-dot from-jak (-> self lure-cast-axis)))

        (when
          (and (<= horizontal-distance (meters 2.05)) (>= (-> self lure-pos y) (- top-y (meters 0.10))))

          (fisher-finish-manipy-catch!
            self
            (-> self hooked-fish-slot))))))

  (none))

(defun fisher-update-gameplay-fish-one!
  ((self fisher-game) (slot int) (fish (pointer manipy)))

  (when fish
    (let ((fish-proc-basic
          (-> fish 0 self)))

      (when fish-proc-basic
        (let* ((fish-proc
              (the-as manipy fish-proc-basic))

            (dt (-> *display* seconds-per-frame))

            (wanted-pos (new 'stack-no-clear 'vector))

            (hook-target (new 'stack-no-clear 'vector))

            (distance (fisher-fish-distance self slot))

            (direction
              (fisher-fish-direction self slot)))

          (cond
            ((= slot (-> self hooked-fish-slot))
              (cond
                ((= (-> self fish-state) 'approaching)
                  (fisher-hook-target! self hook-target)

                  (let ((remaining
                        (fisher-move-manipy-toward!
                          fish-proc
                          hook-target
                          (meters 6.60))))

                    (when
                      (<= remaining (meters 0.20))

                      (fisher-begin-hook-transition! self fish-proc hook-target)

                      (cond
                        ((-> self fish-scare-on-arrival?)
                          (set! (-> self fish-scare-on-arrival?) #f)

                          (fisher-fish-scared-off!
                            self
                            slot))

                        (else
                          (set! (-> self fish-hook-time) 1.15)

                          (fisher-play-fish-bite-sound!)

                          (set!
                            (-> self fish-state)
                            'hook-window))))))

                ((= (-> self fish-state) 'hook-window)
                  (fisher-hook-target! self hook-target)

                  (fisher-animate-hooked-fish! self fish-proc hook-target #f)

                  (-! (-> self fish-hook-time) dt)

                  (when
                    (<= (-> self fish-hook-time) 0.0)

                    (fisher-fish-scared-off!
                      self
                      slot)))

                ((= (-> self fish-state) 'reeling)
                  (fisher-hook-target! self hook-target)

                  (fisher-animate-hooked-fish! self fish-proc hook-target (-> self fish-fighting?))

                  (when (> (-> self fish-hook-time) 0.0)
                    (-! (-> self fish-hook-time) dt)

                    (when (< (-> self fish-hook-time) 0.0)
                      (set! (-> self fish-hook-time) 0.0)))

                  (when (> (-> self fish-fight-time) 0.0)
                    (-! (-> self fish-fight-time) dt)

                    (set! (-> self fish-fighting?) #t)

                    (when
                      (<= (-> self fish-fight-time) 0.0)

                      (set! (-> self fish-fighting?) #f)

                      (set!
                        (-> self fish-fight-phase)
                        (degrees 180.0))))

                  (when
                    (and (<= (-> self fish-hook-time) 0.0) (not (-> self fish-fighting?)) (rand-vu-percent? (* dt 0.18)))

                    (set! (-> self fish-fight-time) (rand-vu-float-range 1.0 2.1))

                    (fisher-play-random-fight-sound!)

                    (set! (-> self fish-fighting?) #t)

                    (set! (-> self fish-fight-phase) 0.0)

                    (set!
                      (-> self fish-fight-base-y)
                      (-> self lure-pos y))))

                ((or
                    (= (-> self fish-state) 'catch-enter)
                    (= (-> self fish-state) 'catch-display)
                    (= (-> self fish-state) 'catch-exit))
                  (fisher-catch-display-fish-position! self hook-target)

                  (set! (-> fish-proc root trans quad) (-> hook-target quad))

                  (fisher-set-manipy-facing! self slot fish-proc)

                  (set-vector!
                    (-> fish-proc root scale)
                    0.55
                    0.55
                    0.55
                    1.0))))

            (else
              (fisher-fish-position! self slot wanted-pos)

              (cond
                ((> (fisher-fish-cooldown self slot) 0.0)
                  (let ((speed-scale
                        (if
                          (> (fisher-fish-cooldown self slot) 1.6)
                          1.35
                          1.0)))

                    (+! distance (* direction (fisher-fish-speed self slot) speed-scale dt))

                    (cond
                      ((<= distance (meters 3.5)) (set! distance (meters 3.5)) (fisher-set-fish-direction! self slot 1.0))

                      ((>= distance (meters 55.5))
                        (set! distance (meters 55.5))
                        (fisher-set-fish-direction!
                          self
                          slot
                          -1.0)))

                    (fisher-set-fish-distance! self slot distance)

                    (fisher-fish-position! self slot wanted-pos)

                    (set!
                      (-> fish-proc root trans quad)
                      (-> wanted-pos quad)))

                  (fisher-set-fish-cooldown!
                    self
                    slot
                    (fmax
                      0.0
                      (-
                        (fisher-fish-cooldown self slot)
                        dt))))

                (else
                  (when
                    (<= (fisher-fish-turn-time self slot) 0.0)

                    (+! distance (* direction (fisher-fish-speed self slot) dt))

                    (cond
                      ((<= distance (meters 3.5))
                        (set! distance (meters 3.5))

                        (fisher-start-manipy-turn!
                          self
                          slot
                          1.0))

                      ((>= distance (meters 55.5))
                        (set! distance (meters 55.5))

                        (fisher-start-manipy-turn!
                          self
                          slot
                          -1.0)))

                    (fisher-set-fish-distance!
                      self
                      slot
                      distance))

                  (fisher-fish-position! self slot wanted-pos)

                  (set!
                    (-> fish-proc root trans quad)
                    (-> wanted-pos quad))))

              (set! (-> fish-proc root trans quad) (-> wanted-pos quad))

              (fisher-set-manipy-facing! self slot fish-proc)

              (fisher-debug-draw-fish-cone! self slot fish-proc)

              (when
                (and
                  (= (-> self hooked-fish-slot) -1)
                  (= (-> self fish-state) 'free)
                  (= (-> self cast-state) 'line-active)
                  (<= (fisher-fish-cooldown self slot) 0.0)
                  (fisher-manipy-can-sense-lure?
                    self
                    slot
                    fish-proc))

                (set! (-> self hooked-fish-slot) slot)

                (set!
                  (-> self fish-state)
                  'approaching))))

          (fisher-apply-slot-appearance! self slot fish-proc (= (-> self fish-state) 'catch-display))

          (fisher-draw-manipy-fish-marker!
            fish)))))

  (none))

(defun fisher-update-all-fish-debug! ((self fisher-game))
  (dotimes (i 22) (fisher-update-gameplay-fish-one! self i (fisher-fish-pointer self i)))

  (none))

(defun fisher-remove-debug-fish!
  ((fish (pointer manipy)))

  (when fish (deactivate (-> fish 0)))

  (none))

(defun singlefish-end-session! ((self fisher-game))
  (set! *singlefish-session-active?* #f)
  (+! *singlefish-session-id* 1)
  (set! (-> self hooked-fish) #f)
  (set! (-> self hooked-fish-slot) -1)
  (set! (-> self fish-state) 'free)

  (dotimes (i 22)
    (let ((fish
          (fisher-fish-pointer self i)))

      (when fish (deactivate (-> fish 0)))

      (fisher-set-fish-pointer!
        self
        i
        (the-as (pointer manipy) #f))))

  (set! (-> self fish-count) 0)

  (none))

(defstate singlefish-patrol (singlefish-base)
  :virtual #t
  :code
  (behavior ()
    (ja-no-eval :num! (loop!) :frame-num 0.0)

    (loop
      (when (not (singlefish-session-valid? self)) (process-deactivate))

      (singlefish-patrol-step! self 1.0)

      (when (singlefish-can-see-lure? self) (singlefish-begin-approach! self))

      (suspend)

      (ja
        :num! (loop! 1.0))))
  :post singlefish-post)

(defstate singlefish-approach (singlefish-base)
  :virtual #t
  :code
  (behavior ()
    (loop
      (when (not (singlefish-session-valid? self)) (singlefish-remove-visual! self) (process-deactivate))

      (when (not (singlefish-owner-still-hooked? self)) (go-virtual singlefish-patrol))

      (let* ((owner
            (the-as fisher-game (-> self owner)))

          (dt (-> *display* seconds-per-frame))

          (to-lure (new 'stack-no-clear 'vector))

          (target-root (new 'stack-no-clear 'vector))

          (move-dir (new 'stack-no-clear 'vector))

          (distance 0.0)

          (step
            0.0))

        (singlefish-set-visible! self #t)

        (singlefish-vector-sub-safe! to-lure (-> owner lure-pos) (-> self root trans))

        (set! (-> to-lure w) 0.0)
        (singlefish-face-vector! self to-lure)

        (singlefish-vector-add-scaled-safe! target-root (-> owner lure-pos) (-> self forward) (- (-> self nose-offset)))

        (singlefish-vector-sub-safe! move-dir target-root (-> self root trans))

        (set! distance (singlefish-vector-length-safe move-dir))

        (cond
          ((<= distance (meters 0.12))
            (set! (-> self root trans quad) (-> target-root quad))

            (set! (-> self hook-time) 1.0)
            (fisher-play-fish-bite-sound!)
            (set! (-> owner fish-state) 'hook-window)
            (go-virtual singlefish-hook-window))

          (else
            (singlefish-vector-normalize-safe! move-dir 1.0)

            (set! step (fmin distance (* (meters 2.20) dt)))

            (singlefish-vector-add-scaled-safe!
              (-> self root trans)
              (-> self root trans)
              move-dir
              step)))

        (set! (-> self root trans w) 1.0))

      (suspend)))
  :post singlefish-post)

(defstate singlefish-hook-window (singlefish-base)
  :virtual #t
  :code
  (behavior ()
    (loop
      (when (not (singlefish-session-valid? self)) (singlefish-remove-visual! self) (process-deactivate))

      (when (not (singlefish-owner-still-hooked? self)) (go-virtual singlefish-patrol))

      (singlefish-set-visible! self #t)
      (singlefish-pin-nose-to-lure! self)

      (-! (-> self hook-time) (-> *display* seconds-per-frame))

      (when (<= (-> self hook-time) 0.0) (singlefish-fail-hook! self))

      (suspend)))
  :post singlefish-post)

(defstate singlefish-scared (singlefish-base)
  :virtual #t
  :code
  (behavior ()
    (loop
      (when (not (singlefish-session-valid? self)) (singlefish-remove-visual! self) (process-deactivate))

      (singlefish-patrol-step! self (if (> (-> self scared-time) 4.6) 1.35 1.0))

      (-! (-> self scared-time) (-> *display* seconds-per-frame))

      (when (<= (-> self scared-time) 0.0) (set! (-> self scared-time) 0.0) (go-virtual singlefish-patrol))

      (suspend)))
  :post singlefish-post)

(defstate singlefish-reeling (singlefish-base)
  :virtual #t
  :code
  (behavior ()
    (loop
      (when (not (singlefish-session-valid? self)) (singlefish-remove-visual! self) (process-deactivate))

      (singlefish-set-visible! self #t)
      (singlefish-update-reeling! self)
      (suspend)))
  :post singlefish-post)

(defstate singlefish-catch-display (singlefish-base)
  :virtual #t
  :code
  (behavior ()
    (loop
      (when (not (singlefish-session-valid? self)) (singlefish-remove-visual! self) (process-deactivate))

      (singlefish-position-catch-model! self)
      (suspend)))
  :post singlefish-post)

(defstate singlefish-dead (singlefish-base) :virtual #t :code (behavior () (process-deactivate)) :post singlefish-post)

(defun fisher-launch-camera-bubble! ((self fisher-game))
  (when
    (and *camera* (> (-> *camera* num-slaves) 0))

    (let ((cam-slave
          (-> *camera* slave 0 0))

        (bubble-pos (new 'stack-no-clear 'vector))

        (forward (new 'stack-no-clear 'vector))

        (right (new 'stack-no-clear 'vector))

        (lane
          (rand-vu-float-range
            (meters -5.5)
            (meters 5.5))))

      (vector-! forward (-> self lure-camera-look) (-> cam-slave trans))

      (set! (-> forward w) 0.0)
      (vector-normalize! forward 1.0)

      (vector-cross! right forward (-> *camera* local-down))

      (set! (-> right w) 0.0)
      (vector-normalize! right 1.0)

      (vector+float*! bubble-pos (-> cam-slave trans) forward (meters 6.0))

      (vector+float*! bubble-pos bubble-pos right lane)

      (vector+float*! bubble-pos bubble-pos (-> *camera* local-down) (meters 4.5))

      (when
        (>= (-> bubble-pos y) (-> self water-level))

        (set!
          (-> bubble-pos y)
          (- (-> self water-level)
            (meters 4.0))))

      (set! (-> bubble-pos w) 1.0)

      (launch-particles
        :system *sp-particle-system-2d*
        (-> *part-id-table* 3570)
        bubble-pos))
  )

  (none))

(defun fisher-update-camera-bubbles! ((self fisher-game))
  (let ((dt
        (-> *display* seconds-per-frame)))

    (cond
      ((and
          (-> self casted?)
          (-> self camera-underwater?)
          (<
            (-> self lure-pos y)
            (-> self water-level)))

        (cond
          ((< (-> self bubble-time) 0.0)
            (+! (-> self bubble-time) dt)

            (when
              (>= (-> self bubble-time) 0.0)

              (fisher-launch-camera-bubble! self)

              (set!
                (-> self bubble-time)
                (rand-vu-float-range
                  0.35
                  1.10)))
          )

          (else
            (-! (-> self bubble-time) dt)

            (when
              (<= (-> self bubble-time) 0.0)

              (fisher-launch-camera-bubble! self)

              (set!
                (-> self bubble-time)
                (rand-vu-float-range
                  0.35
                  1.10)))
          )
        )
      )

      (else (set! (-> self bubble-time) -2.0))
    )
  )

  (none)
)

(defun fisher-start-cast! ((self fisher-game))
  (fisher-refill-missing-fish! self)

  (set! *fisher-line-hp-max* (+ 15.0 (* 85.0 (-> self cast-charge))))

  (fisher-reset-line-hp!)

  (let ((cast-distance
        (+
          (meters 3.5)
          (* (meters 52.0)
            (-> self cast-charge)))))

    (vector-copy! (-> self lure-cast-start) (target-pos 0))

    (play-sound-file "cast.wav" (the int (-> *setting-control* current sfx-volume)))

    (+! (-> self lure-cast-start y) (meters 1.4))

    (vector-copy! (-> self lure-cast-axis) (-> self playfield-axis))

    (vector+float*! (-> self lure-cast-end) (-> self lure-cast-start) (-> self lure-cast-axis) cast-distance)

    (set! (-> self lure-cast-end y) (-> self water-level))

    (set! (-> self lure-cast-end w) 1.0)

    (vector-copy! (-> self lure-pos) (-> self lure-cast-start))

    (fisher-remove-lure-snake! self)

    (let ((snake-anchor
          (new 'stack-no-clear 'vector))

        (snake-root
          (new 'stack-no-clear 'vector)))

      (vector-copy! snake-anchor (-> self lure-pos))

      (set! (-> snake-anchor w) 1.0)

      (vector-copy! snake-root snake-anchor)

      (-! (-> snake-root y) (meters 1.0666667))

      (set! (-> snake-root w) 1.0)

      (vector-copy! (-> self lure-snake-last-anchor) snake-anchor)

      (vector-reset! (-> self lure-snake-angle))

      (vector-reset! (-> self lure-snake-angular-speed))

      (set! (-> self lure-snake-flow-time) 0.0)

      (set! (-> self lure-snake) (spawn-fisher-lure-snake snake-root))
    )

    (let ((cam-slave
          (-> *camera* slave 0 0)))

      (vector-float*! (-> self lure-camera-offset) (-> self camera-axis) (- (-> self camera-radius)))

      (set! (-> self lure-camera-offset y) 0.0)

      (set! (-> self lure-camera-offset w) 0.0)

      (vector-copy! (-> self fisher-cam) (-> cam-slave trans))
    )

    (set! (-> self cast-time) 0.0)
    (set! (-> self camera-blend) 0.0)
    (set! (-> self cast-duration) 1.0)
    (set! (-> self casted?) #t)
    (set! (-> self reel-hint-time) 3.0)

    (set! (-> self lure-x-velocity) 0.0)
    (set! (-> self lure-y-velocity) 0.0)

    (set! (-> self cast-state) 'casting)
    (set! (-> self camera-state) 'follow-lure)
  )

  (none)
)

(defun fisher-update-cast-arc! ((self fisher-game))
  (let* ((dt (-> *display* seconds-per-frame))
      (t (fmin 1.0 (/ (-> self cast-time) (-> self cast-duration))))
      (arc-height
        (* (meters 5.0)
          (* 4.0
            t
            (- 1.0 t)))))

    (vector-lerp! (-> self lure-pos) (-> self lure-cast-start) (-> self lure-cast-end) t)

    (+! (-> self lure-pos y) arc-height)

    (+! (-> self cast-time) dt)

    (when (>= t 1.0)
      (vector-copy! (-> self lure-pos) (-> self lure-cast-end))

      (set! (-> self lure-x-velocity) 0.87)

      (set! (-> self lure-y-velocity) -2.0)

      (fisher-launch-water-entry-bubbles! self)
      (play-sound-file "splash.wav" (the int (-> *setting-control* current sfx-volume)))

      (set!
        (-> self cast-state)
        'water-entry))
  )

  (none)
)

(defun fisher-update-underwater-background! ((self fisher-game))
  (fisher-update-camera-water! self)
  (fisher-update-underwater-waves! self)
  (fisher-restore-sky-base-position!)

  (when
    (-> self casted?)

    (set!
      *particles-flag*
      #t))

  (cond
    ((-> self camera-underwater?) (fisher-force-underwater-background!))

    (else
      (set!
        *fisher-underwater-haze-override?*
        #f)))

  (none)
)

(defun fisher-update-water-entry! ((self fisher-game))
  (let* ((dt
        (-> *display* seconds-per-frame))

      (entry-depth (meters 3.0))

      (entry-bottom (- (-> self water-level) entry-depth))

      (current-depth (fmax 0.0 (- (-> self water-level) (-> self lure-pos y))))

      (depth-progress (fmin 1.0 (/ current-depth entry-depth)))

      (smooth-progress (* depth-progress depth-progress (- 3.0 (* 2.0 depth-progress))))

      (starting-y-speed -2.0)

      (ending-y-speed
        (- (-> self lure-fall-speed))))

    (set!
      (-> self lure-y-velocity)
      (+
        (* starting-y-speed (- 1.0 smooth-progress))

        (* ending-y-speed
          smooth-progress)))

    (set! (-> self lure-x-velocity) (* 0.87 (- 1.0 smooth-progress)))

    (vector+float*! (-> self lure-pos) (-> self lure-pos) (-> self lure-cast-axis) (* (meters 1.0) (-> self lure-x-velocity) dt))

    (+! (-> self lure-pos y) (* (meters 1.0) (-> self lure-y-velocity) dt))

    (when
      (<= (-> self lure-pos y) entry-bottom)

      (set! (-> self lure-pos y) entry-bottom)

      (set! (-> self lure-x-velocity) 0.0)

      (set! (-> self lure-y-velocity) (- (-> self lure-fall-speed)))

      (set!
        (-> self cast-state)
        'line-active))
  )

  (none)
)

(defun fisher-camera-follow-lure! ((self fisher-game))
  (when (and *camera* (> (-> *camera* num-slaves) 0))
    (let ((cam-slave (-> *camera* slave 0 0))
        (desired-camera (new 'stack-no-clear 'vector))
        (desired-look (new 'stack-no-clear 'vector))
        (forward (new 'stack-no-clear 'vector))
        (blend-value 0.0)
        (blend-speed 2.5))

      (vector+! desired-camera (-> self lure-pos) (-> self lure-camera-offset))

      (vector-copy! desired-look (-> self lure-pos))

      (+! (-> desired-look y) (meters 0.5))

      (when
        (< (-> self camera-blend) 1.0)

        (+! (-> self camera-blend) (* blend-speed (-> *display* seconds-per-frame)))

        (when
          (> (-> self camera-blend) 1.0)

          (set!
            (-> self camera-blend)
            1.0))
      )

      (set! blend-value (parameter-ease-sin-clamp (-> self camera-blend)))

      (vector-lerp! (-> self lure-camera-pos) (-> self fisher-cam) desired-camera blend-value)

      (vector-lerp! (-> self lure-camera-look) (-> self fisher-look) desired-look blend-value)

      (set! (-> cam-slave saved-pt quad) (-> self lure-camera-pos quad))

      (set! (-> cam-slave trans quad) (-> self lure-camera-pos quad))

      (vector-! forward (-> self lure-camera-look) (-> self lure-camera-pos))

      (let ((horizontal-length
            (sqrtf
              (+
                (* (-> forward x) (-> forward x))

                (* (-> forward z)
                  (-> forward z))))))

        (when (> horizontal-length 0.0)
          (set!
            (-> forward x)
            (*
              (/ (-> forward x) horizontal-length)

              (cos (degrees -5))))

          (set!
            (-> forward z)
            (*
              (/ (-> forward z) horizontal-length)

              (cos (degrees -5))))

          (set! (-> forward y) (sin (degrees -5)))

          (set!
            (-> forward w)
            0.0))
      )

      (vector-normalize! forward 1.0)

      (forward-down->inv-matrix (-> cam-slave tracking inv-mat) forward (-> *camera* local-down))
    )
  )

  (none)
)

(defun fisher-camera-before-cast! ((self fisher-game))
  (when (and *camera* (> (-> *camera* num-slaves) 0))
    (let ((cam-slave (-> *camera* slave 0 0))
        (forward (new 'stack-no-clear 'vector))
        (look-pos (new 'stack-no-clear 'vector))
        (camera-pos (new 'stack-no-clear 'vector)))

      (cond
        ((= (-> self location-id) 1) (vector-copy! camera-pos (-> self fisher-cam)))

        (else
          (vector+float*! camera-pos (-> self pos) (-> self camera-axis) (- (-> self camera-radius)))

          (set! (-> camera-pos y) (-> self fisher-cam y))

          (set!
            (-> camera-pos w)
            1.0)))

      (vector-copy! look-pos (-> self pos))

      (+! (-> look-pos y) (meters 1.0))

      (vector-copy! (-> self fisher-look) look-pos)

      (set! (-> cam-slave saved-pt quad) (-> camera-pos quad))

      (set! (-> cam-slave trans quad) (-> camera-pos quad))

      (vector-! forward look-pos camera-pos)

      (vector-normalize! forward 1.0)

      (forward-down->inv-matrix (-> cam-slave tracking inv-mat) forward (-> *camera* local-down))
    )
  )

  (none)
)

(defun fisher-draw-retail-line!
  ((line-start vector)
   (line-end vector)
   (line-color rgba))

  (when
    (and
      (current-frame)
      (-> (current-frame) global-buf))

    (let ((screen-start
          (new 'stack-no-clear 'vector4w))

        (screen-end
          (new 'stack-no-clear 'vector4w)))

      (when
        (and
          (transform-point-qword!
            screen-start
            line-start)

          (transform-point-qword!
            screen-end
            line-end))

        (let* ((start-x
                (the int
                  (+
                    -1792
                    (/ (-> screen-start x) 16))))

            (start-y
              (the int
                (+
                  -1855
                  (/ (-> screen-start y) 16))))

            (end-x
              (the int
                (+
                  -1792
                  (/ (-> screen-end x) 16))))

            (end-y
              (the int
                (+
                  -1855
                  (/ (-> screen-end y) 16))))

            (delta-x
              (- end-x start-x))

            (delta-y
              (- end-y start-y)))

          (with-dma-buffer-add-bucket
            ((buf (-> (current-frame) global-buf))
             (bucket-id subtitle))

            (dotimes (i 64)
              (let ((line-t
                    (/ (the float i) 63.0)))

                (draw-sprite2d-xy
                  buf
                  (+
                    start-x
                    (the int
                      (* (the float delta-x) line-t)))
                  (+
                    start-y
                    (the int
                      (* (the float delta-y) line-t)))
                  3
                  3
                  line-color))))))))

  (none))

(defun fisher-draw-line! ((self fisher-game))
  (when
    (and
      *target*
      (-> self casted?))

    (let ((line-start
          (new 'stack-no-clear 'vector))

        (line-end
          (new 'stack-no-clear 'vector))

        (line-color
          (new 'static 'rgba
            :r #x20
            :g #xe0
            :b #x40
            :a #xc0)))

      (fisher-set-line-color!
        line-color)

      (vector-copy!
        line-start
        (target-pos 0))

      (+!
        (-> line-start y)
        (meters 3.25))

      (vector-copy!
        line-end
        (-> self lure-pos))

      (fisher-draw-retail-line!
        line-start
        line-end
        line-color)))

  (none))

(defun fisher-handle-fish-input! ((self fisher-game))
  (cond
    ((and
        (= (-> self fish-state) 'approaching)
        (cpad-pressed? 0 x))

      (cpad-clear! 0 x)
      (set!
        (-> self fish-scare-on-arrival?)
        #t))

    ((and
        (= (-> self fish-state) 'hook-window)
        (cpad-pressed? 0 x))

      (cpad-clear! 0 x)
      (set! (-> self fish-state) 'reeling)
      (set! (-> self fish-scare-on-arrival?) #f)
      (set! (-> self fish-reel-progress) 0.0)
      (set! (-> self fish-fight-phase) 0.0)
      (set! (-> self fish-fight-base-y) (-> self lure-pos y))
      (set! (-> self reel-camera-blend) 0.0)

      (set! (-> self fish-hook-time) 2.0)
      (set! (-> self fish-fight-time) 0.0)
      (set! (-> self fish-fighting?) #f))

    ((and
        (= (-> self fish-state) 'catch-display)
        (cpad-pressed? 0 x))

      (cpad-clear! 0 x)
      (set! (-> self fish-state) 'catch-exit)
      (set! (-> self catch-transition-time) 0.0)))

  (none))

(defun fisher-draw-fish-status! ((self fisher-game))
  (when (> (-> self fish-message-time) 0.0)
    (when (-> self fish-message) (draw-mod-menu-text-custom (the-as string (-> self fish-message)) 256 116 #f #t #f))

    (-! (-> self fish-message-time) (-> *display* seconds-per-frame))

    (when (<= (-> self fish-message-time) 0.0)
      (set! (-> self fish-message-time) 0.0)
      (set! (-> self fish-message) #f)))

  (cond
    ((= (-> self fish-state) 'approaching) (draw-mod-menu-text-custom "?" 256 116 #f #t #f))

    ((= (-> self fish-state) 'hook-window) (draw-mod-menu-text-custom "PRESS <PAD_X> TO HOOK" 256 116 #f #t #f))

    ((= (-> self fish-state) 'reeling)
      (cond
        ((-> self fish-fighting?) (draw-mod-menu-text-custom "DON'T REEL!" 256 116 #f #t #f))

        (else
          (draw-mod-menu-text-custom
            "PRESS <PAD_X> TO REEL"
            256
            116
            #f
            #t
            #f)))))

  (none))

(defun fisher-format-catch-name! ((self fisher-game))
  (clear *fish-ui-str*)

  (format
    *fish-ui-str*
    (fisher-suffix-name
      (-> self caught-fish-suffix)))

  (format
    *fish-ui-str*
    " ")

  (format
    *fish-ui-str*
    (fisher-species-name
      (-> self caught-fish-species)))

  *fish-ui-str*)


(defun fisher-draw-catch-ui! ((self fisher-game))
  (when
    (or (= (-> self fish-state) 'catch-enter) (= (-> self fish-state) 'catch-display) (= (-> self fish-state) 'catch-exit))

    (let* ((menu-offset
          (the int
            (-> self catch-menu-offset)))

        (whole-lbs (the int (/ (-> self caught-weight-tenths) 10)))

        (decimal-lbs
          (mod
            (-> self caught-weight-tenths)
            10)))

      (with-dma-buffer-add-bucket
        ((buf (-> (current-frame) global-buf)) (bucket-id subtitle))

        (draw-sprite2d-xy buf 82 (+ 98 menu-offset) 348 104 (new 'static 'rgba :r #x04 :g #x10 :b #x18 :a #xc8))

        (draw-sprite2d-xy
          buf
          86
          (+ 102 menu-offset)
          340
          96
          (new 'static 'rgba
            :r #x10
            :g #x38
            :b #x48
            :a #xa8)))

      (draw-fisher-small-text
        (fisher-format-catch-name! self)
        256
        (+ 116 menu-offset))

      (clear *fish-ui-str*)
      (format *fish-ui-str* "~D.~D LBS" whole-lbs decimal-lbs)

      (draw-fisher-small-text *fish-ui-str* 256 (+ 142 menu-offset))

      (clear *fish-ui-str*)
      (format *fish-ui-str* "WORTH: ~D PRECURSOR ORBS" (-> self caught-orb-value))

      (draw-fisher-small-text *fish-ui-str* 256 (+ 164 menu-offset))

      (draw-mod-menu-text-custom
        "PRESS <PAD_X> TO CONTINUE"
        256
        (+ 181 menu-offset)
        #f
        #t
        #f)))

  (none))

(defun fisher-update-casting! ((self fisher-game))
  (fisher-handle-fish-input! self)
  (fisher-draw-playfield-debug! self)

  (dotimes (slot 22) (fisher-debug-draw-logical-fish-marker! self slot))

  (fisher-update-all-fish-debug! self)

  (cond
    ((= (-> self cast-state) 'ready)
      (fisher-restore-normal-background!)

      (draw-mod-menu-text-custom "PRESS <PAD_X> TO CAST" 256 160 #f #t #f)

      (when (cpad-pressed? 0 x)
        (cpad-clear! 0 x)
        (set! (-> self cast-state) 'charging)
        (set! (-> self cast-charge) 0.0)
        (set! (-> self cast-charge-direction) 1.0)))

    ((= (-> self cast-state) 'charging)
      (fisher-restore-normal-background!)
      (fisher-draw-cast-bar (-> self cast-charge))

      (when (cpad-pressed? 0 x) (cpad-clear! 0 x) (fisher-start-cast! self))

      (when (= (-> self cast-state) 'charging)
        (+! (-> self cast-charge) (* (-> self cast-charge-direction) (-> *display* seconds-per-frame)))

        (cond
          ((>= (-> self cast-charge) 1.0) (set! (-> self cast-charge) 1.0) (set! (-> self cast-charge-direction) -1.0))

          ((<= (-> self cast-charge) 0.0)
            (set! (-> self cast-charge) 0.0)
            (fisher-reset-cast! self)))))

    ((= (-> self cast-state) 'casting)
      (fisher-update-cast-arc! self)
      (fisher-update-reel-hint! self)
      (fisher-camera-follow-lure! self)
      (fisher-update-underwater-background! self)
      (fisher-update-camera-bubbles! self)
      (fisher-update-lure-snake! self)
      (fisher-draw-line-hp-bar)
      (fisher-draw-line! self))

    ((= (-> self cast-state) 'water-entry)
      (fisher-update-water-entry! self)
      (fisher-camera-follow-lure! self)
      (fisher-update-reel-hint! self)
      (fisher-update-underwater-background! self)
      (fisher-update-background-mist! self)
      (fisher-update-camera-bubbles! self)
      (fisher-update-lure-snake! self)
      (fisher-draw-line-hp-bar)
      (fisher-draw-line! self))

    ((= (-> self cast-state) 'line-active)
      (cond
        ((or (= (-> self fish-state) 'free) (= (-> self fish-state) 'approaching)) (fisher-update-lure! self))

        ((= (-> self fish-state) 'reeling)
          (fisher-update-manipy-reeling! self)))

      (cond
        ((= (-> self fish-state) 'reeling) (fisher-camera-follow-lure! self))

        (else
          (fisher-camera-follow-lure! self)))

      (fisher-update-reel-hint! self)
      (fisher-update-underwater-background! self)
      (fisher-update-background-mist! self)
      (fisher-update-camera-bubbles! self)
      (fisher-update-lure-snake! self)
      (fisher-draw-line-hp-bar)
      (fisher-draw-line! self))

    ((= (-> self cast-state) 'catch-transition) (fisher-restore-normal-background!) (fisher-update-catch-return! self))

    ((= (-> self cast-state) 'catch-display)
      (fisher-restore-normal-background!)
      (fisher-camera-catch-display! self)
      (fisher-update-catch-menu-animation! self)
      (fisher-draw-catch-ui! self)))

  (fisher-draw-fish-status! self)
  (none))

(defun fisher-face-jak-right-side! ((self fisher-game))
  (when *target*
    (let ((jak-forward (new 'stack-no-clear 'vector))
        (jak-rot (new 'stack-no-clear 'matrix)))

      (vector-copy! jak-forward (-> self playfield-axis))

      (set! (-> jak-forward y) 0.0)
      (set! (-> jak-forward w) 0.0)

      (vector-normalize! jak-forward 1.0)

      (forward-down->inv-matrix jak-rot jak-forward (-> *camera* local-down))

      (matrix->quaternion (-> *target* control quat-for-control) jak-rot)

      (quaternion-copy! (-> *target* control quat) (-> *target* control quat-for-control))

      (rot->dir-targ! (-> *target* control))
    )
  )

  (none)
)

(defun spawn-fisher-game
  ((location-id int) (fishnet-pos vector) (player-pos vector) (camera-pos vector) (water-height float) (camera-angle float) (playfield-angle float))

  (let ((angles
        (new 'stack-no-clear 'vector)))

    (set! (-> angles x) camera-angle)

    (set! (-> angles y) playfield-angle)

    (set! (-> angles z) 0.0)

    (set! (-> angles w) 0.0)

    (vector-copy! *fisher-spawn-player-pos* player-pos)

    (set! *fisher-game* (process-spawn fisher-game location-id fishnet-pos camera-pos water-height angles :name "fisher-game" *active-pool*))
  )

  (none)
)

(defstate idle (fisher-game)
  :virtual #t
  :code (behavior ()
    (loop
      (when (<= (vector-vector-distance (target-pos 0) (-> self pos)) (meters 5))
        (draw-mod-menu-text-custom "PRESS <PAD_CIRCLE> TO START FISHING" 256 160 #f #t #f)
        (when (cpad-pressed? 0 circle)
          (cpad-clear! 0 circle)
          (set! (-> self camera-state) 'before-cast)
          (send-event *camera* 'change-state cam-fixed 0)
          (go-virtual fishing)
        )
      )
      (suspend)
    )
  )
)

(defstate fishing (fisher-game)
  :virtual #t

  :enter
  (behavior ()
    (process-grab? *target*)

    (set! (-> *target* root trans quad) (-> self fishing-player-pos quad))

    (set! (-> *target* control trans quad) (-> self fishing-player-pos quad))

    (play-main-music "fishing-theme-a.wav" (the int (-> *setting-control* current sfx-volume)))
    (set! (-> self stored-music-vol) (-> *setting-control* current music-volume))
    (set-setting! 'music-volume 'abs 0.0 0)
    (set! (-> self saved-camera-read-analog) *camera-read-analog*)

    (set! (-> self saved-external-cam-mode) *external-cam-mode*)

    (set! *camera-read-analog* #f)
    (set! *external-cam-mode* #f)

    (fisher-reset-cast! self)
    (singlefish-start-session! self)
  )

  :code
  (behavior ()
    (loop
      (when (= (-> self camera-state) 'before-cast) (fisher-face-jak-right-side! self) (fisher-camera-before-cast! self))

      (fisher-update-casting! self)

      (when
        (and (= (-> self cast-state) 'ready) (cpad-pressed? 0 triangle))

        (cpad-clear! 0 triangle)
        (go-virtual exit)
      )

      (cpad-clear! 0 x)
      (cpad-clear! 0 circle)
      (cpad-clear! 0 square)
      (cpad-clear! 0 triangle)

      (suspend)
    )
  )
)

(defstate exit (fisher-game)
  :virtual #t
  :code
  (behavior ()
    (set! *camera-read-analog* (-> self saved-camera-read-analog))

    (set! *external-cam-mode* (-> self saved-external-cam-mode))
    (remove-setting! 'music-volume)
    (stop-main-music)
    (send-event *camera* 'change-state *camera-base-mode* (seconds 0.5))

    (singlefish-end-session! self)
    (fisher-remove-lure-snake! self)
    (fisher-restore-normal-background!)
    (process-release? *target*)
    (go-virtual idle)
  )
)

