(deftype singlefish-base (process-drawable)
  ((owner                       (pointer fisher-game))
    (species-name                string)
    (color-name                  string)
    (tier                        symbol)
    (prefix                      symbol)
    (weight-tenths               int)
    (orb-value                   int)
    (base-orb-value              int)
    (min-weight-tenths           int)
    (max-weight-tenths           int)
    (base-scale                  float)
    (visual-scale                float)
    (swim-speed                  float)
    (nose-offset                 float)
    (model-forward-sign          float)
    (direction                   float)
    (home-y                      float)
    (lane-offset                 float)
    (left-distance               float)
    (right-distance              float)
    (turning?                    symbol)
    (turn-time                   float)
    (turn-duration               float)
    (turn-old-direction          float)
    (turn-side                   float)
    (hook-time                   float)
    (scared-time                 float)
    (next-fight-time             float)
    (fight-time                  float)
    (fight-phase                 float)
    (fight-base-y                float)
    (fight-pull                  float)
    (fighting?                   symbol)
    (caught?                     symbol)
    (session-id                  int)
    (forward                     vector :inline)
    (base-color                  vector :inline)
    (fish-color                  vector :inline))
  (:state-methods
    singlefish-patrol
    singlefish-approach
    singlefish-hook-window
    singlefish-scared
    singlefish-reeling
    singlefish-catch-display
    singlefish-dead))

(deftype eco-drum (singlefish-base) ())

(define-extern fisher-debug-line! (function vector vector rgba none))

(define-extern fisher-hook-target! (function fisher-game vector vector))

(defbehavior fisher-game-init-by-other fisher-game
  ((location-id int) (vec vector) (camera-vec vector) (water-height float) (angles vector))

  (set! (-> self location-id) location-id)

  (set! (-> self stored-music-vol) (-> *setting-control* current sfx-volume))
  (vector-copy! (-> self pos) vec)

  (vector-copy! (-> self fishing-player-pos) *fisher-spawn-player-pos*)

  (vector-copy! (-> self fisher-cam) camera-vec)

  (let ((camera-offset
        (new 'stack-no-clear 'vector)))

    (vector-! camera-offset camera-vec vec)

    (set! (-> camera-offset y) 0.0)

    (set! (-> camera-offset w) 0.0)

    (set! (-> self camera-radius) (vector-length camera-offset))
  )

  (vector-reset! (-> self lure-snake-angle))

  (vector-reset! (-> self lure-snake-angular-speed))

  (vector-reset! (-> self lure-snake-last-anchor))

  (set! (-> self lure-snake-flow-time) 0.0)

  (set! (-> self water-level) water-height)

  (set! (-> self camera-angle) (-> angles x))

  (set! (-> self playfield-angle) (-> angles y))

  (set! (-> self camera-axis x) (sin (-> self camera-angle)))

  (set! (-> self camera-axis y) 0.0)

  (set! (-> self camera-axis z) (cos (-> self camera-angle)))

  (set! (-> self camera-axis w) 0.0)

  (vector-normalize! (-> self camera-axis) 1.0)

  (set! (-> self playfield-axis x) (sin (-> self playfield-angle)))

  (set! (-> self playfield-axis y) 0.0)

  (set! (-> self playfield-axis z) (cos (-> self playfield-angle)))

  (set! (-> self playfield-axis w) 0.0)

  (vector-normalize! (-> self playfield-axis) 1.0)

  (set! (-> self saved-camera-read-analog) #t)

  (set! (-> self saved-external-cam-mode) #f)

  (set! (-> self casted?) #f)

  (set! (-> self camera-state) 'before-cast)

  (set! (-> self camera-underwater?) #f)

  (set! (-> self cast-state) 'ready)

  (set! (-> self cast-charge) 0.0)

  (set! (-> self cast-charge-direction) 0.0)

  (set! (-> self cast-time) 0.0)

  (set! (-> self cast-duration) 1.0)

  (set! (-> self camera-blend) 0.0)

  (set! (-> self lure-fall-speed) 1.25)

  (set! (-> self lure-reel-x-speed) 4.0)

  (set! (-> self lure-reel-y-speed) 3.0)

  (set! (-> self lure-x-velocity) 0.0)

  (set! (-> self reel-hint-time) 0.0)

  (set! (-> self lure-y-velocity) 0.0)

  (set! (-> self bubble-time) -2.0)

  (set! (-> self underwater-wave-time) 0.0)

  (set! (-> self background-mist-time) 0.0)

  (set! (-> self hooked-fish) #f)
  (set! (-> self fish-state) 'free)
  (set! (-> self fish-scare-on-arrival?) #f)
  (set! (-> self fish-message) #f)
  (set! (-> self fish-message-time) 0.0)
  (set! (-> self fish-count) 0)
  (set! (-> self fish-0) (the-as (pointer manipy) #f))
