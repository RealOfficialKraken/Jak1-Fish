;;-*-Lisp-*-
(in-package goal)

;; name: mod-custom-code.gc
;; name in dgo: mod-custom-code
;; dgos: TODO

;;;;;;;;;;;;;;;;;;;;;;;;;;
;; What is this file for.
;;;;;;;;;;;;;;;;;;;;;;;;;;

#|
 This file contains function defenitions that are pre placed in the mod base,
    so if you place custom code inside of these functions, it will exectue based on
    the name of the function, for example, if you place (set! (-> *game-info* fuel) (+ (-> *game-info* fuel) 1))
    to the function named runs-on-orb-pickup, then jaks powercell count will increase each time you collect
    an orb
|#

(define *fisher-line-hp-max* 100.0)
(define *fisher-line-hp* 100.0)
(define *fisher-line-broken?* #f)
(define *fisher-saved-fog* (new 'global 'vector))
(define *fisher-fog-overridden?* #f)

(defpart 3570
  :init-specs
  ((:texture (lakedrop effects))
   (:num 1.0)
   (:scale-x (meters 0.08) (meters 0.10))
   (:scale-y :copy scale-x)
   (:r 220.0)
   (:g 240.0)
   (:b 255.0)
   (:a 88.0)
   (:vel-x (meters -0.00002) (meters 0.00004))
   (:vel-y (meters 0.000025) (meters 0.000025))
   (:vel-z (meters -0.00002) (meters 0.00004))
   (:scalevel-x (meters 0.00001))
   (:scalevel-y :copy scalevel-x)
   (:fade-a -0.025)
   (:timer (seconds 30.0))
   (:flags (bit2 bit3))))

(defpart 3571
  :init-specs
  ((:texture (lakedrop effects))
   (:num 12.0)
   (:scale-x (meters 0.05) (meters 0.08))
   (:scale-y :copy scale-x)
   (:r 220.0)
   (:g 240.0)
   (:b 255.0)
   (:a 112.0)
   (:vel-x (meters -0.006) (meters 0.012))
   (:vel-y (meters 0.002) (meters 0.006))
   (:vel-z (meters -0.006) (meters 0.012))
   (:scalevel-x (meters 0.00008))
   (:scalevel-y :copy scalevel-x)
   (:fade-a -0.30)
   (:timer (seconds 2.0))
   (:flags (bit2 bit3))))

(defskelgroup *fish-net-sgc*
  fish-net
  fish-net-lod0-jg
  fish-net-fishing-ja
  ((fish-net-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 4))

(defskelgroup *junglesnake-sgc*
  junglesnake
  junglesnake-lod0-jg
  junglesnake-idle-ja
  ((junglesnake-lod0-mg (meters 999999)))
  :bounds (static-spherem 0 14 0 18)
  :longest-edge (meters 2.5))

(defun spawn-fisher-net-at ((pos vector))
  (let ((net
          (manipy-spawn
            pos
            #f
            *fish-net-sgc*
            #f
            :from *default-dead-pool*
            :to *default-pool*
            :name "test-fisher-net")))

    (when net
      (let ((net-proc
              (-> net 0 self))

            (rot
              (new 'stack-no-clear 'matrix)))

        (send-event
          net-proc
          'anim-mode
          'still)

        (send-event
          net-proc
          'set-frame-num
          10.0)

        (set!
          (-> (the-as manipy net-proc) root trans quad)
          (-> pos quad))

        (matrix-rotate-x!
          rot
          (degrees 180))

        (matrix->quaternion
          (-> (the-as manipy net-proc) root quat)
          rot)

        (send-event
          net-proc
          'max-vis-dist
          (meters 999999.0))))

    net)
)

(defun spawn-fisher-lure-snake ((pos vector))
  (let ((snake
          (manipy-spawn
            pos
            #f
            *junglesnake-sgc*
            #f
            :from *default-dead-pool*
            :to *default-pool*
            :name "fisher-lure-snake")))

    (when snake
      (let ((snake-proc
              (-> snake 0 self)))

        (send-event
          snake-proc
          'anim-mode
          'loop)

        (set!
          (-> (the-as manipy snake-proc) root trans quad)
          (-> pos quad))

        (set-vector!
          (-> (the-as manipy snake-proc) root scale)
          0.0333333
          0.0333333
          0.0333333
          1.0)

        (send-event
          snake-proc
          'max-vis-dist
          (meters 999999.0))))

    snake)
)

(define matt-str (new 'global 'string 2048 (the-as string #f)))
(define *pc-encoded-matt-str* (new 'global 'string 2048 (the-as string #f)))

(defun draw-mod-menu-text-custom ((text string)
                                  (text-x-pos int)
                                  (text-y-pos int)
                                  (left? symbol)
                                  (middle? symbol)
                                  (right? symbol))
  (clear matt-str)
  (clear *pc-encoded-matt-str*)

  (format matt-str text)
  (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)

  (with-dma-buffer-add-bucket
    ((buf (-> (current-frame) debug-buf))
     (bucket-id debug-no-zbuf))

    (let ((font-ctx
            (new 'stack
                 'font-context
                 *font-default-matrix*
                 text-x-pos
                 text-y-pos
                 0.0
                 (font-color white)
                 (cond
                   (middle?
                     (font-flags large middle shadow kerning))
                   (right?
                     (font-flags large right shadow kerning))
                   (else
                     (font-flags large shadow kerning))))))

      (draw-string
        *pc-encoded-matt-str*
        buf
        font-ctx)
    )
  )

  (none)
)


(defun fisher-restore-normal-background! ()
  (when
    (and
      *sky-tng-data*
      *fisher-fog-overridden?*)

    (set!
      (-> *sky-tng-data* fog quad)
      (-> *fisher-saved-fog* quad))

    (set!
      *fisher-fog-overridden?*
      #f)
  )

  (none)
)

;;name: fisher-game.gc

(deftype fisher-game (process)
  ((location                    string)
   (pos                         vector :inline)
   (casted?                     symbol)
   (fisher-cam                  vector :inline)
   (fisher-look                 vector :inline)
   (camera-state                symbol)
   (saved-camera-read-analog    symbol)
   (saved-external-cam-mode     symbol)
   (water-level                 float)
   (camera-underwater?          symbol)
   (cast-state                  symbol)
   (cast-charge                 float)
   (cast-charge-direction       float)
   (lure-pos                    vector :inline)
   (lure-cast-start             vector :inline)
   (lure-cast-end               vector :inline)
   (lure-cast-axis              vector :inline)
   (lure-camera-offset          vector :inline)
   (lure-camera-pos             vector :inline)
   (lure-camera-look            vector :inline)
   (cast-time                   float)
   (cast-duration               float)
   (camera-blend                float)
   (lure-fall-speed             float)
   (lure-reel-x-speed           float)
   (lure-reel-y-speed           float)
   (lure-x-velocity             float)
   (lure-y-velocity             float)
   (playfield-angle             float)
   (playfield-axis              vector :inline)
   (camera-angle                float)
   (camera-axis                 vector :inline)
   (camera-radius               float)
   (bubble-time                 float)
   (stored-music-vol            float)
   (reel-hint-time              float)
   (lure-snake                  (pointer manipy))
   (lure-snake-angle            vector :inline)
   (lure-snake-angular-speed    vector :inline)
   (lure-snake-last-anchor      vector :inline)
   (lure-snake-flow-time        float)
   (underwater-wave-time        float)
  )
  (:state-methods
    idle
    fishing
    exit
    dead
  )
)

(defbehavior fisher-game-init-by-other fisher-game
  ((loc string)
   (vec vector)
   (camera-vec vector)
   (water-height float)
   (angles vector))

  (set!
    (-> self location)
    loc)
  (set! (-> self stored-music-vol) (-> *setting-control* current sfx-volume))
  (vector-copy!
    (-> self pos)
    vec)

  (vector-copy!
    (-> self fisher-cam)
    camera-vec)

  (let ((camera-offset
        (new 'stack-no-clear 'vector)))

  (vector-!
    camera-offset
    camera-vec
    vec)

  (set!
    (-> camera-offset y)
    0.0)

  (set!
    (-> camera-offset w)
    0.0)

  (set!
  (-> self camera-radius)
  (vector-length camera-offset))
)

  (vector-reset!
    (-> self lure-snake-angle))

  (vector-reset!
    (-> self lure-snake-angular-speed))

  (vector-reset!
    (-> self lure-snake-last-anchor))

  (set!
    (-> self lure-snake-flow-time)
    0.0)

  (set!
    (-> self water-level)
    water-height)

  (set!
    (-> self camera-angle)
    (-> angles x))

  (set!
    (-> self playfield-angle)
    (-> angles y))

  (set!
    (-> self camera-axis x)
    (sin (-> self camera-angle)))

  (set!
    (-> self camera-axis y)
    0.0)

  (set!
    (-> self camera-axis z)
    (cos (-> self camera-angle)))

  (set!
    (-> self camera-axis w)
    0.0)

  (vector-normalize!
    (-> self camera-axis)
    1.0)

  (set!
    (-> self playfield-axis x)
    (sin (-> self playfield-angle)))

  (set!
    (-> self playfield-axis y)
    0.0)

  (set!
    (-> self playfield-axis z)
    (cos (-> self playfield-angle)))

  (set!
    (-> self playfield-axis w)
    0.0)

  (vector-normalize!
    (-> self playfield-axis)
    1.0)

  (set!
    (-> self saved-camera-read-analog)
    #t)

  (set!
    (-> self saved-external-cam-mode)
    #f)

  (set!
    (-> self casted?)
    #f)

  (set!
    (-> self camera-state)
    'before-cast)

  (set!
    (-> self camera-underwater?)
    #f)

  (set!
    (-> self cast-state)
    'ready)

  (set!
    (-> self cast-charge)
    0.0)

  (set!
    (-> self cast-charge-direction)
    0.0)

  (set!
    (-> self cast-time)
    0.0)

  (set!
    (-> self cast-duration)
    1.0)

  (set!
    (-> self camera-blend)
    0.0)

  (set!
    (-> self lure-fall-speed)
    1.25)

  (set!
    (-> self lure-reel-x-speed)
    4.0)

  (set!
    (-> self lure-reel-y-speed)
    3.0)

  (set!
    (-> self lure-x-velocity)
    0.0)
  
  (set!
    (-> self reel-hint-time)
    0.0)

  (set!
    (-> self lure-y-velocity)
    0.0)

  (set!
    (-> self bubble-time)
    -2.0)

  (set!
    (-> self underwater-wave-time)
    0.0)

  (vector-reset!
    (-> self lure-pos))

  (vector-reset!
    (-> self lure-cast-start))

  (vector-reset!
    (-> self lure-cast-end))

  (vector-reset!
    (-> self lure-cast-axis))

  (vector-reset!
    (-> self lure-camera-offset))

  (vector-reset!
    (-> self lure-camera-pos))

  (vector-reset!
    (-> self lure-camera-look))

  (spawn-fisher-net-at
  (-> self pos))

  (set!
  (-> self lure-snake)
  (the-as (pointer manipy) #f))

  (go-virtual idle)
)

(defun fisher-update-underwater-waves! ((self fisher-game))
  (let ((dt
          (-> *display* seconds-per-frame)))

    (when
      (> (-> self underwater-wave-time)
         0.0)

      (-!
        (-> self underwater-wave-time)
        dt)

      (when
        (< (-> self underwater-wave-time)
           0.0)

        (set!
          (-> self underwater-wave-time)
          0.0))
    )

    (when
      (and
        (-> self camera-underwater?)
        (<=
          (-> self underwater-wave-time)
          0.0))

      (play-sound-file
        "water-waves.wav"
        (the int
          (*
            (the float
              (-> *setting-control* current sfx-volume))
            1.0)))

      (set!
        (-> self underwater-wave-time)
        49.0))
  )

  (none)
)

(defun fisher-force-underwater-horizon! ((r float) (g float) (b float))
  (when
    (and
      *time-of-day-context*
      *math-camera*
      (-> *time-of-day-context* moods 0))

    (let* ((mood
             (-> *time-of-day-context* moods 0))

           (fog-hour
             (-> mood fog-interp hour 4))

           (snapshot-1
             (-> fog-hour snapshot1))

           (snapshot-2
             (-> fog-hour snapshot2))

           (fog-blend
             (-> fog-hour morph-start))

           (fog-1
             (-> mood mood-fog-table data snapshot-1))

           (fog-2
             (-> mood mood-fog-table data snapshot-2))

           (green-fog-dists
             (new 'stack-no-clear 'vector)))

      (vector4-lerp!
        green-fog-dists
        (-> fog-1 fog-dists)
        (-> fog-2 fog-dists)
        fog-blend)

      (set-vector!
        (-> *time-of-day-context* current-fog fog-color)
        r
        g
        b
        128.0)

      (set-vector!
        (-> *time-of-day-context* current-fog erase-color)
        r
        g
        b
        128.0)

      (set!
        (-> *time-of-day-context* current-fog fog-dists quad)
        (-> green-fog-dists quad))

      (set!
        *fog-color*
        (new 'static
          'rgba
          :r (the int r)
          :g (the int g)
          :b (the int b)
          :a #x80))

      (set!
        (-> *time-of-day-context* erase-color)
        (new 'static
          'rgba
          :r (the int r)
          :g (the int g)
          :b (the int b)
          :a #x80))

      (set!
        (-> *math-camera* fog-start)
        (-> green-fog-dists x))

      (set!
        (-> *math-camera* fog-end)
        (-> green-fog-dists y))

      (set!
        (-> *math-camera* fog-max)
        (-> green-fog-dists z))

      (set!
        (-> *math-camera* fog-min)
        (-> green-fog-dists w))

      (dotimes (i 12)
        (set!
          (-> sky-base-polygons i col x)
          r)

        (set!
          (-> sky-base-polygons i col y)
          g)

        (set!
          (-> sky-base-polygons i col z)
          b)

        (set!
          (-> sky-base-polygons i col w)
          128.0))
    )
  )

  (none)
)

(defun fisher-remove-lure-snake! ((self fisher-game))
  (when
    (-> self lure-snake)

    (deactivate
      (-> (-> self lure-snake) 0))

    (set!
        (-> self lure-snake)
        (the-as (pointer manipy) #f))
    )
    (vector-reset!
    (-> self lure-snake-angle))

  (vector-reset!
    (-> self lure-snake-angular-speed))

  (vector-reset!
    (-> self lure-snake-last-anchor))

  (set!
    (-> self lure-snake-flow-time)
    0.0)

  (none)
)

(defun fisher-update-lure-snake! ((self fisher-game))
  (when
    (and
      (-> self casted?)
      (-> self lure-snake))

    (let* ((snake-proc
             (-> (-> self lure-snake) 0 self))

           (snake
             (the-as manipy snake-proc))

           (dt
             (-> *display* seconds-per-frame))

           (anchor
             (new 'stack-no-clear 'vector))

           (movement
             (new 'stack-no-clear 'vector))

           (target-angle
             (new 'stack-no-clear 'vector))

           (pivot-offset
             (new 'stack-no-clear 'vector))

           (rotated-pivot
             (new 'stack-no-clear 'vector))

           (root-pos
             (new 'stack-no-clear 'vector))

           (rot
             (new 'stack-no-clear 'matrix))

           (forward-speed
             0.0)

           (vertical-speed
             0.0)

           (spring
             0.0)

           (damping
             0.0))

      (vector-copy!
        anchor
        (-> self lure-pos))

      (set!
        (-> anchor w)
        1.0)

      (vector-!
        movement
        anchor
        (-> self lure-snake-last-anchor))

      (when (> dt 0.0)
        (set!
          forward-speed
          (/
            (/
              (vector-dot
                movement
                (-> self lure-cast-axis))
              (meters 1.0))
            dt))

        (set!
          vertical-speed
          (/
            (/
              (-> movement y)
              (meters 1.0))
            dt))
      )

      (+!
        (-> self lure-snake-flow-time)
        dt)

      (cond
        ((= (-> self cast-state) 'casting)
          (set!
            spring
            4.0)

          (set!
            damping
            1.4)

          (set!
            (-> target-angle x)
            (degrees
              (fmax
                -75.0
                (fmin
                  75.0
                  (* vertical-speed 15.0)))))

          (set!
            (-> target-angle y)
            (degrees
              (+
                (* forward-speed 11.0)

                (* 28.0
                  (sin
                    (*
                      (degrees 210.0)
                      (-> self lure-snake-flow-time)))))))

          (set!
            (-> target-angle z)
            (degrees
              (fmax
                -65.0
                (fmin
                  65.0
                  (* forward-speed -13.0)))))
        )

        (else
          (set!
            spring
            19.0)

          (set!
            damping
            2.0)

          (set!
            (-> target-angle x)
            (degrees
              (+
                (fmax
                  -24.0
                  (fmin
                    24.0
                    (* vertical-speed 3.0)))

                (* 7.0
                  (sin
                    (*
                      (degrees 38.0)
                      (-> self lure-snake-flow-time)))))))

          (set!
            (-> target-angle y)
            (degrees
              (+
                (* forward-speed 1.8)

                (* 10.0
                  (sin
                    (*
                      (degrees 25.0)
                      (-> self lure-snake-flow-time)))))))

          (set!
            (-> target-angle z)
            (degrees
              (+
                (fmax
                  -28.0
                  (fmin
                    28.0
                    (* forward-speed -3.2)))

                (* 6.0
                  (cos
                    (*
                      (degrees 31.0)
                      (-> self lure-snake-flow-time)))))))
        )
      )

      (set!
        (-> target-angle w)
        0.0)

      (+!
        (-> self lure-snake-angular-speed x)
        (*
          (-
            (*
              (-
                (-> target-angle x)
                (-> self lure-snake-angle x))
              spring)

            (*
              (-> self lure-snake-angular-speed x)
              damping))
          dt))

      (+!
        (-> self lure-snake-angular-speed y)
        (*
          (-
            (*
              (-
                (-> target-angle y)
                (-> self lure-snake-angle y))
              spring)

            (*
              (-> self lure-snake-angular-speed y)
              damping))
          dt))

      (+!
        (-> self lure-snake-angular-speed z)
        (*
          (-
            (*
              (-
                (-> target-angle z)
                (-> self lure-snake-angle z))
              spring)

            (*
              (-> self lure-snake-angular-speed z)
              damping))
          dt))

      (+!
        (-> self lure-snake-angle x)
        (*
          (-> self lure-snake-angular-speed x)
          dt))

      (+!
        (-> self lure-snake-angle y)
        (*
          (-> self lure-snake-angular-speed y)
          dt))

      (+!
        (-> self lure-snake-angle z)
        (*
          (-> self lure-snake-angular-speed z)
          dt))

      (matrix-rotate-xyz!
        rot
        (-> self lure-snake-angle))

      (matrix->quaternion
        (-> snake root quat)
        rot)

      (set-vector!
        pivot-offset
        0.0
        (meters 1.0666667)
        0.0
        0.0)

      (vector-matrix*!
        rotated-pivot
        pivot-offset
        rot)

      (vector-!
        root-pos
        anchor
        rotated-pivot)

      (set!
        (-> root-pos w)
        1.0)

      (set!
        (-> snake root trans quad)
        (-> root-pos quad))

      (set-vector!
        (-> snake root scale)
        0.0333333
        0.0333333
        0.0333333
        1.0)

      (vector-copy!
        (-> self lure-snake-last-anchor)
        anchor)
    )
  )

  (none)
)

(defun fisher-reset-line-hp! ()
  (set!
    *fisher-line-hp*
    *fisher-line-hp-max*)

  (set!
    *fisher-line-broken?*
    #f)

  (none)
)

(defun fisher-damage-line! ((damage float))
  (-!
    *fisher-line-hp*
    damage)

  (when
    (<= *fisher-line-hp* 0.0)

    (set!
      *fisher-line-hp*
      0.0)

    (set!
      *fisher-line-broken?*
      #t))

  (none)
)

(defun fisher-heal-line! ((amount float))
  (+!
    *fisher-line-hp*
    amount)

  (when
    (> *fisher-line-hp*
       *fisher-line-hp-max*)

    (set!
      *fisher-line-hp*
      *fisher-line-hp-max*))

  (when
    (> *fisher-line-hp* 0.0)

    (set!
      *fisher-line-broken?*
      #f))

  (none)
)

(defun fisher-set-line-color! ((color rgba))
  (let ((health-ratio
          (fmax
            0.0
            (fmin
              1.0
              (/ *fisher-line-hp*
                 *fisher-line-hp-max*))))

        (blend
          0.0))

    (cond
      ((>= health-ratio 0.5)
        (set!
          blend
          (* (- 1.0 health-ratio)
             2.0))

        (set!
          (-> color r)
          (the uint8
            (+ 32.0
               (* (- 240.0 32.0)
                  blend))))

        (set!
          (-> color g)
          (the uint8
            (+ 224.0
               (* (- 208.0 224.0)
                  blend))))

        (set!
          (-> color b)
          (the uint8
            (+ 64.0
               (* (- 32.0 64.0)
                  blend))))
      )

      (else
        (set!
          blend
          (* (- 0.5 health-ratio)
             2.0))

        (set!
          (-> color r)
          240)

        (set!
          (-> color g)
          (the uint8
            (+ 208.0
               (* (- 32.0 208.0)
                  blend))))

        (set!
          (-> color b)
          32)
      )
    )

    (set!
      (-> color a)
      #xc0)
  )

  (none)
)

(defun fisher-draw-line-hp-number ()
  (let ((display-hp
          (the int
            (fmax
              0.0
              (fmin
                *fisher-line-hp-max*
                *fisher-line-hp*)))))

    (clear matt-str)
    (clear *pc-encoded-matt-str*)

    (format
      matt-str
      "~D"
      display-hp)

    (pc-encode-utf8-string
      matt-str
      *pc-encoded-matt-str*)

    (with-dma-buffer-add-bucket
      ((buf (-> (current-frame) debug-buf))
       (bucket-id debug-no-zbuf))

      (let ((font-ctx
              (new 'stack
                   'font-context
                   *font-default-matrix*
                   472
                   39
                   0.0
                   (font-color white)
                   (font-flags large middle shadow kerning))))

        (draw-string
          *pc-encoded-matt-str*
          buf
          font-ctx)
      )
    )
  )

  (none)
)

