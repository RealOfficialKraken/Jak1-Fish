(defun draw-mod-menu-text-custom ((text string)
    (text-x-pos int)
    (text-y-pos int)
    (left? symbol)
    (middle? symbol)
    (right? symbol))
  (clear matt-str)
  (clear *pc-encoded-matt-str*)

  (format matt-str text)
  (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)

  (with-dma-buffer-add-bucket
    ((buf (-> (current-frame) global-buf)) (bucket-id subtitle))

    (let ((font-ctx
          (new 'stack
            'font-context
            *font-default-matrix*
            text-x-pos
            text-y-pos
            0.0
            (font-color white)
            (cond
              (middle? (font-flags large middle shadow kerning))
              (right? (font-flags large right shadow kerning))
              (else
                (font-flags large shadow kerning))))))

      (draw-string *pc-encoded-matt-str* buf font-ctx)
    )
  )

  (none)
)

(defun draw-fisher-small-text
  ((text string) (text-x-pos int) (text-y-pos int))

  (clear matt-str)
  (clear *pc-encoded-matt-str*)

  (format matt-str text)
  (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)

  (with-dma-buffer-add-bucket
    ((buf (-> (current-frame) global-buf)) (bucket-id subtitle))

    (let ((font-ctx
          (new 'stack
            'font-context
            *font-default-matrix*
            text-x-pos
            text-y-pos
            0.0
            (font-color white)
            (font-flags middle shadow kerning))))

      (set! (-> font-ctx scale) 0.55)

      (draw-string
        *pc-encoded-matt-str*
        buf
        font-ctx)))

  (none))


(defun draw-fisher-small-font-scaled
  ((text string) (text-x-pos int) (text-y-pos int) (text-scale float))

  (clear matt-str)
  (clear *pc-encoded-matt-str*)
  (format matt-str text)
  (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)

  (with-dma-buffer-add-bucket
    ((buf (-> (current-frame) global-buf))
      (bucket-id subtitle))

    ;; Use the normal Latin glyph page.  The `large` flag selects a different
    ;; atlas and produces Japanese glyphs when scaled down for lore text.
    (draw-string-xy-scaled
      *pc-encoded-matt-str*
      buf
      text-x-pos
      text-y-pos
      (font-color white)
      (font-flags middle shadow kerning)
      text-scale))

  (none))

(defun draw-fisher-large-font-scaled ((text string) (text-x-pos int) (text-y-pos int) (text-scale float))
  (clear matt-str)
  (clear *pc-encoded-matt-str*)
  (format matt-str text)
  (pc-encode-utf8-string
    matt-str
    *pc-encoded-matt-str*)
  (with-dma-buffer-add-bucket
    ((buf (-> (current-frame) global-buf))
      (bucket-id subtitle))
    (draw-string-xy-scaled
      *pc-encoded-matt-str*
      buf
      text-x-pos
      text-y-pos
      (font-color white)
      (font-flags large middle shadow kerning)
      text-scale))
  (none))

(defun singlefish-vector-reset-safe! ((dst vector)) (set! (-> dst x) 0.0) (set! (-> dst y) 0.0) (set! (-> dst z) 0.0) (set! (-> dst w) 1.0) dst)

(defun singlefish-vector-copy-safe! ((dst vector) (src vector))
  (set! (-> dst x) (-> src x))
  (set! (-> dst y) (-> src y))
  (set! (-> dst z) (-> src z))
  (set! (-> dst w) (-> src w))
  dst)

(defun singlefish-vector-add-safe! ((dst vector) (a vector) (b vector))
  (set! (-> dst x) (+ (-> a x) (-> b x)))
  (set! (-> dst y) (+ (-> a y) (-> b y)))
  (set! (-> dst z) (+ (-> a z) (-> b z)))
  (set! (-> dst w) 1.0)
  dst)

(defun singlefish-vector-sub-safe! ((dst vector) (a vector) (b vector))
  (set! (-> dst x) (- (-> a x) (-> b x)))
  (set! (-> dst y) (- (-> a y) (-> b y)))
  (set! (-> dst z) (- (-> a z) (-> b z)))
  (set! (-> dst w) 1.0)
  dst)

(defun singlefish-vector-scale-safe! ((dst vector) (src vector) (scale float))
  (set! (-> dst x) (* (-> src x) scale))
  (set! (-> dst y) (* (-> src y) scale))
  (set! (-> dst z) (* (-> src z) scale))
  (set! (-> dst w) 1.0)
  dst)

(defun singlefish-vector-add-scaled-safe!
  ((dst vector) (origin vector) (axis vector) (scale float))

  (set! (-> dst x) (+ (-> origin x) (* (-> axis x) scale)))
  (set! (-> dst y) (+ (-> origin y) (* (-> axis y) scale)))
  (set! (-> dst z) (+ (-> origin z) (* (-> axis z) scale)))
  (set! (-> dst w) 1.0)
  dst)

(defun singlefish-vector-length-safe ((vec vector)) (sqrtf (+ (* (-> vec x) (-> vec x)) (* (-> vec y) (-> vec y)) (* (-> vec z) (-> vec z)))))

(defun singlefish-vector-cross-safe! ((dst vector) (a vector) (b vector))
  (let ((x
        (-
          (* (-> a y) (-> b z))
          (* (-> a z) (-> b y))))

      (y (- (* (-> a z) (-> b x)) (* (-> a x) (-> b z))))

      (z
        (-
          (* (-> a x) (-> b y))
          (* (-> a y) (-> b x)))))

    (set! (-> dst x) x)
    (set! (-> dst y) y)
    (set! (-> dst z) z)
    (set! (-> dst w) 0.0))

  dst)

