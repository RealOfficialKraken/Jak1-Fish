;;-*-Lisp-*-
(in-package goal)
(bundles "JUN.DGO" "GAME.CGO")

(when (< (-> *part-id-table* length) 4096)
  (let ((old-part-id-table *part-id-table*)
      (old-part-count (-> *part-id-table* length))
      (new-part-id-table
        (new 'global 'boxed-array sparticle-launcher 4096)))

    (dotimes (part-index old-part-count)
      (set!
        (-> new-part-id-table part-index)
        (-> old-part-id-table part-index)))

    (set! *part-id-table* new-part-id-table)))

(when (< (-> *part-group-id-table* length) 4096)
  (let ((old-part-group-id-table *part-group-id-table*)
      (old-part-group-count (-> *part-group-id-table* length))
      (new-part-group-id-table
        (new 'global 'boxed-array sparticle-launch-group 4096)))

    (dotimes (group-index old-part-group-count)
      (set!
        (-> new-part-group-id-table group-index)
        (-> old-part-group-id-table group-index)))

    (set! *part-group-id-table* new-part-group-id-table)))

