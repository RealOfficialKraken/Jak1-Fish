;;-*-Lisp-*-
(in-package goal)
(bundles "JUN.DGO")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Core fishing minigame, lure, casting, reeling, catches, fish behavior, camera and UI
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Underwater fishing background curtain colors
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *fisher-background-cloud-visible?* #f)
(define *fisher-background-cloud-session-active?* #f)

(define *fisher-curtain-color-0a* (new 'static 'rgba :r #x1c :g #x70 :b #x8c :a #xff))
(define *fisher-curtain-color-0b* (new 'static 'rgba :r #x20 :g #x7a :b #x94 :a #xff))
(define *fisher-curtain-color-1a* (new 'static 'rgba :r #x16 :g #x60 :b #x80 :a #xff))
(define *fisher-curtain-color-1b* (new 'static 'rgba :r #x1a :g #x6a :b #x88 :a #xff))
(define *fisher-curtain-color-2a* (new 'static 'rgba :r #x10 :g #x52 :b #x74 :a #xff))
(define *fisher-curtain-color-2b* (new 'static 'rgba :r #x14 :g #x5c :b #x7c :a #xff))
(define *fisher-curtain-color-3a* (new 'static 'rgba :r #x0c :g #x44 :b #x66 :a #xff))
(define *fisher-curtain-color-3b* (new 'static 'rgba :r #x10 :g #x4e :b #x6e :a #xff))
(define *fisher-curtain-color-4a* (new 'static 'rgba :r #x09 :g #x36 :b #x58 :a #xff))
(define *fisher-curtain-color-4b* (new 'static 'rgba :r #x0c :g #x40 :b #x60 :a #xff))
(define *fisher-curtain-color-5a* (new 'static 'rgba :r #x06 :g #x28 :b #x48 :a #xff))
(define *fisher-curtain-color-5b* (new 'static 'rgba :r #x09 :g #x30 :b #x50 :a #xff))

(defun fisher-set-particle-fishbox-rotation!
  ((self fisher-game))

  ;; The curtain plane is built from self.camera-axis:
  ;;
  ;;   camera-axis.x = sin(camera-angle)
  ;;   camera-axis.z = cos(camera-angle)
  ;;
  ;; Therefore its actual world-space orientation is camera-angle around Y.
  ;; Use that exact same yaw for every 3D underwater particle. Do not derive
  ;; this from playfield-angle and do not use screen-space rot-z.
  (let ((curtain-yaw
          (-> self camera-angle)))

    ;; All four definitions place rot-y at init-spec index 5.
    (set!
      (-> *part-id-table* 3570 init-specs 5 initial-valuef)
      curtain-yaw)

    (set!
      (-> *part-id-table* 3571 init-specs 5 initial-valuef)
      curtain-yaw)

    (set!
      (-> *part-id-table* 3572 init-specs 5 initial-valuef)
      curtain-yaw)

    (set!
      (-> *part-id-table* 3574 init-specs 5 initial-valuef)
      curtain-yaw)

    (set!
      (-> *part-id-table* 3575 init-specs 5 initial-valuef)
      curtain-yaw))

  (none))


(define *fisher-level-up-window-state* 'hidden)
(define *fisher-level-up-window-time* 0.0)
(define *fisher-level-up-window-offset* 150.0)
(define *fisher-power-cell-reward-active?* #f)
;; True only while Jak is actually inside the modal fishing state.
;; The area process also exists while idle, so hooks must not use *fisher-game*
;; alone as proof that fishing owns the HUD/camera/player.
(define *fisher-session-active?* #f)

(define *fisher-stop-lure-cooldown-color*
  (new 'static 'rgba :r #xe8 :g #xb8 :b #x38 :a #xe8))

(define *fisher-sink-lure-cooldown-color*
  (new 'static 'rgba :r #x28 :g #xb8 :b #xe8 :a #xe8))

;; Reddish-purple so Tug Line is visually distinct from Sink Lure.
(define *fisher-tug-line-cooldown-color*
  (new 'static 'rgba :r #xb8 :g #x38 :b #x78 :a #xe8))

(defun fisher-level-up-window-active? ()
  (!= *fisher-level-up-window-state* 'hidden))

(defun fisher-level-up-blocking? ()
  (or
    *fisher-level-up-window-pending?*
    *fisher-level-up-window-request?*
    (fisher-level-up-window-active?)))

(defun fisher-reset-level-up-window! ()
  (set! *fisher-level-up-window-state* 'hidden)
  (set! *fisher-level-up-window-time* 0.0)
  (set! *fisher-level-up-window-offset* 150.0)
  (set! *fisher-level-up-window-pending?* #f)
  (set! *fisher-level-up-window-request?* #f)
  (set! *fisher-level-up-window-old-level* 1)
  (set! *fisher-level-up-window-new-level* 1)
  (set! *fisher-level-up-window-skill-mask* 0)
  (none))

(defun fisher-begin-level-up-window! ()
  (when
    (and
      *fisher-level-up-window-request?*
      (= *fisher-level-up-window-state* 'hidden))

    (set! *fisher-level-up-window-request?* #f)
    (set! *fisher-level-up-window-state* 'enter)
    (set! *fisher-level-up-window-time* 0.0)
    (set! *fisher-level-up-window-offset* 150.0))

  (none))

(defun fisher-update-level-up-window! ()
  (fisher-begin-level-up-window!)

  (when
    (fisher-level-up-window-active?)

    (let ((dt
          (-> *display* seconds-per-frame)))

      (+! *fisher-level-up-window-time* dt)

      (cond
        ((= *fisher-level-up-window-state* 'enter)
          (let* ((duration
                0.65)

              (progress
                (fmin
                  1.0
                  (/ *fisher-level-up-window-time* duration)))

              (ease
                (fisher-smoothstep progress))

              (bounce
                (*
                  10.0
                  (sin (* (degrees 540.0) progress))
                  (- 1.0 progress))))

            (set!
              *fisher-level-up-window-offset*
              (+ (* 150.0 (- 1.0 ease)) bounce))

            (when
              (>= progress 1.0)

              (set! *fisher-level-up-window-offset* 0.0)
              (set! *fisher-level-up-window-time* 0.0)
              (set! *fisher-level-up-window-state* 'display))))

        ((= *fisher-level-up-window-state* 'display)
          (when
            (cpad-pressed? 0 x)

            (cpad-clear! 0 x)
            (set! *fisher-level-up-window-state* 'exit)
            (set! *fisher-level-up-window-time* 0.0)))

        ((= *fisher-level-up-window-state* 'exit)
          (let* ((duration
                0.48)

              (progress
                (fmin
                  1.0
                  (/ *fisher-level-up-window-time* duration)))

              (ease
                (fisher-smoothstep progress)))

            (set!
              *fisher-level-up-window-offset*
              (* 150.0 ease))

            (when
              (>= progress 1.0)

              (set! *fisher-level-up-window-state* 'hidden)
              (set! *fisher-level-up-window-time* 0.0)
              (set! *fisher-level-up-window-offset* 150.0)
              (set! *fisher-level-up-window-skill-mask* 0)))))))

  (none))

(defun fisher-draw-level-up-title!
  ((text string)
   (text-x-pos int)
   (text-y-pos int)
   (text-scale float))

  (clear matt-str)
  (clear *pc-encoded-matt-str*)
  (format matt-str text)
  (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)

  (with-dma-buffer-add-bucket
    ((buf (-> (current-frame) global-buf))
     (bucket-id subtitle))

    (draw-string-xy-scaled
      *pc-encoded-matt-str*
      buf
      text-x-pos
      text-y-pos
      (font-color orange)
      (font-flags large middle shadow kerning)
      text-scale))

  (none))

(defun fisher-draw-level-up-window! ()
  (when
    (and
      (fisher-level-up-window-active?)
      (current-frame)
      (-> (current-frame) global-buf))

    (let ((menu-offset
          (the int *fisher-level-up-window-offset*))

        (skill-mask
          *fisher-level-up-window-skill-mask*)

        ;; Keep the complete card inside Jak 1's visible 240-line UI area.
        ;; Skill cards use a taller layout, but still stop at y = 230.
        (panel-y
          (if
            (> *fisher-level-up-window-skill-mask* 0)
            12
            38))

        (window-height
          (if
            (> *fisher-level-up-window-skill-mask* 0)
            218
            164))

        (inner-height
          (if
            (> *fisher-level-up-window-skill-mask* 0)
            210
            156))

        (continue-y
          (if
            (> *fisher-level-up-window-skill-mask* 0)
            216
            186)))

      (with-dma-buffer-add-bucket
        ((buf (-> (current-frame) global-buf))
         (bucket-id subtitle))

        ;; Outer shadow/backplate.
        (draw-sprite2d-xy
          buf
          48
          (+ panel-y menu-offset)
          416
          window-height
          (new 'static 'rgba
            :r #x03
            :g #x0c
            :b #x14
            :a #xe8))

        ;; Inner blue panel.
        (draw-sprite2d-xy
          buf
          52
          (+ (+ panel-y 4) menu-offset)
          408
          inner-height
          (new 'static 'rgba
            :r #x0d
            :g #x30
            :b #x42
            :a #xc8))

        ;; Top title accent.
        (draw-sprite2d-xy
          buf
          68
          (+ (+ panel-y 38) menu-offset)
          376
          2
          (new 'static 'rgba
            :r #xd0
            :g #x98
            :b #x38
            :a #xb0))

        ;; Separate the general level-up information from the unlocked skill.
        (when
          (> skill-mask 0)

          (draw-sprite2d-xy
            buf
            72
            (+ 122 menu-offset)
            368
            2
            (new 'static 'rgba
              :r #x60
              :g #x98
              :b #xa8
              :a #x98))))

      (clear *fish-ui-str*)
      (format
        *fish-ui-str*
        "LEVEL UP!  LV. ~D"
        *fisher-level-up-window-new-level*)

      (fisher-draw-level-up-title!
        *fish-ui-str*
        256
        (+ (if (> skill-mask 0) 34 60) menu-offset)
        0.62)

      (draw-fisher-large-font-scaled
        "YOUR FISHING POWER HAS INCREASED."
        256
        (+ (if (> skill-mask 0) 62 88) menu-offset)
        0.40)

      ;; Tighter line spacing and shorter copy keep this readable without
      ;; allowing the text to run through the bottom of the screen.
      (draw-fisher-large-font-scaled
        "LOWER LEVEL FISH DEAL LESS LINE DAMAGE,"
        256
        (+ (if (> skill-mask 0) 82 108) menu-offset)
        0.36)

      (draw-fisher-large-font-scaled
        "BUT ALSO GRANT LESS XP."
        256
        (+ (if (> skill-mask 0) 99 125) menu-offset)
        0.38)

      (cond
        ((= skill-mask 1)
          (fisher-draw-level-up-title!
            "SKILL UNLOCKED: STOP LURE"
            256
            (+ 140 menu-offset)
            0.46)

          (draw-fisher-large-font-scaled
            "PRESS <PAD_SQUARE> TO FREEZE THE LURE"
            256
            (+ 164 menu-offset)
            0.36)

          (draw-fisher-large-font-scaled
            "FOR 3 SECONDS - 20 SECOND COOLDOWN."
            256
            (+ 181 menu-offset)
            0.36))

        ((= skill-mask 2)
          (fisher-draw-level-up-title!
            "SKILL UNLOCKED: SINK LURE"
            256
            (+ 140 menu-offset)
            0.46)

          (fisher-draw-reel-hint-text-red
            "R1"
            106
            (+ 163 menu-offset)
            0.37)

          (fisher-draw-reel-hint-text
            " SINKS THE LURE 3X FASTER"
            126
            (+ 163 menu-offset)
            0.37)

          (draw-fisher-large-font-scaled
            "FOR 3.5 SECONDS - 15 SECOND COOLDOWN."
            256
            (+ 181 menu-offset)
            0.35)

          (draw-fisher-large-font-scaled
            "REELING OR A FISH BITE ENDS IT EARLY."
            256
            (+ 197 menu-offset)
            0.32))

        ((= skill-mask 4)
          (fisher-draw-level-up-title!
            "SKILL UNLOCKED: TUG LINE"
            256
            (+ 140 menu-offset)
            0.46)

          (fisher-draw-reel-hint-text-red
            "L1"
            98
            (+ 163 menu-offset)
            0.37)

          (fisher-draw-reel-hint-text
            " REELS A HOOKED FISH 2X FASTER"
            118
            (+ 163 menu-offset)
            0.35)

          (draw-fisher-large-font-scaled
            "FOR 2 SECONDS - 35 SECOND COOLDOWN."
            256
            (+ 181 menu-offset)
            0.35)

          (draw-fisher-large-font-scaled
            "THE SPEED CHANGE IS IMMEDIATE."
            256
            (+ 197 menu-offset)
            0.32))

        ((= skill-mask 8)
          (fisher-draw-level-up-title!
            "SKILL UNLOCKED: FISHING CLOCK"
            256
            (+ 140 menu-offset)
            0.44)

          (draw-fisher-large-font-scaled
            "THE CURRENT TIME IS NOW ALWAYS SHOWN"
            256
            (+ 164 menu-offset)
            0.34)

          (draw-fisher-large-font-scaled
            "WHILE FISHING. GOLDEN HOURS GLOW YELLOW."
            256
            (+ 181 menu-offset)
            0.32))

        ((> skill-mask 0)
          ;; This compact combined card also handles debug/REPL XP grants that
          ;; skip across more than one skill-unlock level at once.
          (fisher-draw-level-up-title!
            "SKILLS UNLOCKED"
            256
            (+ 137 menu-offset)
            0.46)

          (when
            (nonzero? (logand skill-mask 1))
            (draw-fisher-large-font-scaled
              "<PAD_SQUARE> STOP LURE: 3 SEC / 20 SEC COOLDOWN."
              256
              (+ 157 menu-offset)
              0.30))

          (when
            (nonzero? (logand skill-mask 2))
            (fisher-draw-reel-hint-text-red
              "R1"
              74
              (+ 174 menu-offset)
              0.32)

            (fisher-draw-reel-hint-text
              " SINK LURE: 3X DOWN FOR 3.5 SECONDS."
              94
              (+ 174 menu-offset)
              0.30))

          (when
            (nonzero? (logand skill-mask 4))
            (fisher-draw-reel-hint-text-red
              "L1"
              74
              (+ 191 menu-offset)
              0.32)

            (fisher-draw-reel-hint-text
              " TUG LINE: 2X REEL FOR 2 SECONDS."
              94
              (+ 191 menu-offset)
              0.30))))

      (draw-fisher-large-font-scaled
        "PRESS <PAD_X> TO CONTINUE"
        256
        (+ continue-y menu-offset)
        0.43)))

  (none))

(defun spawn-fisher-net-at ((pos vector))
  (let ((net
        (manipy-spawn
          pos
          #f
          *fish-net-sgc*
          #f
          :from *default-dead-pool*
          :to *default-pool*
          :name "test-fisher-net")))

    (when net
      (let ((net-proc
            (-> net 0 self))

          (rot
            (new 'stack-no-clear 'matrix)))

        (send-event net-proc 'anim-mode 'still)

        (send-event net-proc 'set-frame-num 10.0)

        (set! (-> (the-as manipy net-proc) root trans quad) (-> pos quad))

        (matrix-rotate-x! rot (degrees 180))

        (matrix->quaternion (-> (the-as manipy net-proc) root quat) rot)

        (send-event
          net-proc
          'max-vis-dist
          (meters 999999.0))))

    net)
)

(defun spawn-fisher-lure-snake ((pos vector))
  (let ((snake
        (manipy-spawn
          pos
          #f
          *junglesnake-sgc*
          #f
          :from *default-dead-pool*
          :to *default-pool*
          :name "fisher-lure-snake")))

    (when snake
      (let ((snake-proc
            (-> snake 0 self)))

        (send-event snake-proc 'anim-mode 'loop)

        (set! (-> (the-as manipy snake-proc) root trans quad) (-> pos quad))

        (set-vector! (-> (the-as manipy snake-proc) root scale) 0.0333333 0.0333333 0.0333333 1.0)

        (send-event
          snake-proc
          'max-vis-dist
          (meters 999999.0))))

    snake)
)

(defun fisher-restore-normal-background! ()
  (set! *fisher-underwater-haze-override?* #f)

  (none)
)

(defbehavior fisher-game-init-by-other fisher-game
  ((location-id int)
   (vec vector)
   (camera-vec vector)
   (water-height float)
   (angles vector))

  (set! (-> self location-id) location-id)

  (set! (-> self stored-music-vol) (-> *setting-control* current sfx-volume))
  (vector-copy! (-> self pos) vec)

  (vector-copy!
    (-> self fishing-player-pos)
    *fisher-spawn-player-pos*)

  (vector-copy! (-> self fisher-cam) camera-vec)

  (let ((camera-offset
        (new 'stack-no-clear 'vector)))

    (vector-! camera-offset camera-vec vec)

    (set! (-> camera-offset y) 0.0)

    (set! (-> camera-offset w) 0.0)

    (set! (-> self camera-radius) (vector-length camera-offset))
  )

  (vector-reset! (-> self lure-snake-angle))

  (vector-reset! (-> self lure-snake-angular-speed))

  (vector-reset! (-> self lure-snake-last-anchor))

  (set! (-> self lure-snake-flow-time) 0.0)

  (set! (-> self water-level) water-height)

  (set! (-> self camera-angle) (-> angles x))

  (set! (-> self playfield-angle) (-> angles y))

  (set! (-> self camera-axis x) (sin (-> self camera-angle)))

  (set! (-> self camera-axis y) 0.0)

  (set! (-> self camera-axis z) (cos (-> self camera-angle)))

  (set! (-> self camera-axis w) 0.0)

  (vector-normalize! (-> self camera-axis) 1.0)

  (set! (-> self playfield-axis x) (sin (-> self playfield-angle)))

  (set! (-> self playfield-axis y) 0.0)

  (set! (-> self playfield-axis z) (cos (-> self playfield-angle)))

  (set! (-> self playfield-axis w) 0.0)

  (vector-normalize! (-> self playfield-axis) 1.0)

  (set! (-> self saved-camera-read-analog) #t)

  (set! (-> self saved-external-cam-mode) #f)

  (set! (-> self casted?) #f)

  (set! (-> self camera-state) 'before-cast)

  (set! (-> self camera-underwater?) #f)

  (set! (-> self cast-state) 'ready)

  (set! (-> self cast-charge) 0.0)

  (set! (-> self cast-charge-direction) 0.0)

  (set! (-> self cast-time) 0.0)

  (set! (-> self cast-duration) 1.0)

  (set! (-> self camera-blend) 0.0)

  (set! (-> self lure-fall-speed) 1.25)

  (set! (-> self lure-reel-x-speed) 4.0)

  (set! (-> self lure-reel-y-speed) 3.0)

  (set! (-> self lure-x-velocity) 0.0)

  (set! (-> self reel-hint-time) 0.0)

  (fisher-reset-level-up-window!)
  (set! (-> self lure-stop-active?) #f)
  (set! (-> self lure-stop-used?) #f)
  (set! (-> self lure-stop-time) 0.0)
  (set! (-> self lure-stop-cooldown) 0.0)
  (set! (-> self lure-sink-active?) #f)
  (set! (-> self lure-sink-used?) #f)
  (set! (-> self lure-sink-time) 0.0)
  (set! (-> self lure-sink-cooldown) 0.0)
  (set! (-> self tug-line-active?) #f)
  (set! (-> self tug-line-time) 0.0)
  (set! (-> self tug-line-cooldown) 0.0)

  (set! (-> self lure-y-velocity) 0.0)

  (set! (-> self bubble-time) -2.0)

  (set! (-> self underwater-wave-time) 0.0)

  (set! (-> self background-mist-time) 0.0)

  (set! (-> self background-curtain-phase) 0.0)

  (set! (-> self hooked-fish) #f)
  (set! (-> self fish-state) 'free)
  (set! (-> self fish-scare-on-arrival?) #f)
  (set! (-> self fish-message) #f)
  (set! (-> self fish-message-time) 0.0)
  (set! (-> self fish-approach-speed) 2.20)
  (set! (-> self buzzer-victory-pending?) #f)
  (set! (-> self caught-buzzer-count) 0)
  (set! (-> self caught-buzzer-task) 0)
  (set! (-> self power-cell-victory-pending?) #f)
  (set! (-> self caught-power-cell-task) 0)
  (set! (-> self fish-count) 0)
  (set! (-> self fish-0) (the-as (pointer manipy) #f))
  (set! (-> self fish-1) (the-as (pointer manipy) #f))
  (set! (-> self fish-2) (the-as (pointer manipy) #f))
  (set! (-> self fish-3) (the-as (pointer manipy) #f))
  (set! (-> self fish-4) (the-as (pointer manipy) #f))
  (set! (-> self fish-5) (the-as (pointer manipy) #f))
  (set! (-> self fish-6) (the-as (pointer manipy) #f))
  (set! (-> self fish-7) (the-as (pointer manipy) #f))
  (set! (-> self fish-8) (the-as (pointer manipy) #f))
  (set! (-> self fish-9) (the-as (pointer manipy) #f))
  (set! (-> self fish-10) (the-as (pointer manipy) #f))
  (set! (-> self fish-11) (the-as (pointer manipy) #f))
  (set! (-> self fish-12) (the-as (pointer manipy) #f))
  (set! (-> self fish-13) (the-as (pointer manipy) #f))
  (set! (-> self fish-14) (the-as (pointer manipy) #f))
  (set! (-> self fish-15) (the-as (pointer manipy) #f))
  (set! (-> self fish-16) (the-as (pointer manipy) #f))
  (set! (-> self fish-17) (the-as (pointer manipy) #f))
  (set! (-> self fish-18) (the-as (pointer manipy) #f))
  (set! (-> self fish-19) (the-as (pointer manipy) #f))
  (set! (-> self fish-20) (the-as (pointer manipy) #f))
  (set! (-> self fish-21) (the-as (pointer manipy) #f))
  (set! (-> self hooked-fish-slot) -1)
  (set! (-> self fish-hook-time) 0.0)
  (set! (-> self fish-reel-progress) 0.0)
  (set! (-> self fish-fight-time) 0.0)
  (set! (-> self fish-fight-phase) 0.0)
  (set! (-> self fish-fight-base-y) 0.0)
  (set! (-> self reel-camera-blend) 0.0)
  (vector-copy! (-> self hooked-fish-facing) (-> self lure-cast-axis))
  (vector-reset! (-> self hooked-fish-last-hook-pos))
  (set! (-> self fish-fighting?) #f)
  (set! (-> self hooked-fish-poison-dps) 0.0)
  (set! (-> self fish-scare-on-arrival?) #f)
  (set! (-> self caught-weight-tenths) 0)
  (set! (-> self caught-orb-value) 0)
  (set! (-> self caught-fish-species) 0)
  (set! (-> self caught-fish-suffix) 2)
  (set! (-> self caught-fish-level) 1)
  (set! (-> self caught-fish-xp) 0)
  (set! (-> self catch-transition-time) 0.0)
