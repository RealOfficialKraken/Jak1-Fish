(defun fisher-set-particle-fishbox-rotation!
  ((self fisher-game)
  )
  (let (
      (curtain-yaw (-> self camera-angle))
    )
    (set!
      (-> *part-id-table* 3570 init-specs 5 initial-valuef)
      curtain-yaw)
    (set!
      (-> *part-id-table* 3571 init-specs 5 initial-valuef)
      curtain-yaw)
    (set!
      (-> *part-id-table* 3572 init-specs 5 initial-valuef)
      curtain-yaw)
    (set!
      (-> *part-id-table* 3574 init-specs 5 initial-valuef)
      curtain-yaw)
    (set!
      (-> *part-id-table* 3575 init-specs 5 initial-valuef)
      curtain-yaw)
    (set!
      (-> *part-id-table* 3576 init-specs 5 initial-valuef)
      curtain-yaw)
    (set!
      (-> *part-id-table* 3577 init-specs 5 initial-valuef)
      curtain-yaw)
    (set!
      (-> *part-id-table* 3579 init-specs 5 initial-valuef)
      curtain-yaw)
    (set!
      (-> *part-id-table* 3580 init-specs 5 initial-valuef)
      curtain-yaw))
  (none))

(defun fisher-set-lava-puff-mode! ((self fisher-game) (mode int))
  (set!
    (-> *part-id-table* 3573 init-specs 4 initial-valuef)
    (degrees -90))
  (set!
    (-> *part-id-table* 3573 init-specs 5 initial-valuef)
    0.0)
  (set!
    (-> *part-id-table* 3573 init-specs 6 initial-valuef)
    0.0)

  (cond
    ((= mode 0)
      (set! (-> *part-id-table* 3573 init-specs 2 initial-valuef) 1.0)
      (set! (-> *part-id-table* 3573 init-specs 3 initial-valuef) (meters 0.78))
      (set! (-> *part-id-table* 3573 init-specs 7 initial-valuef) (meters 0.78))
      (set! (-> *part-id-table* 3573 init-specs 8 initial-valuef) 255.0)
      (set! (-> *part-id-table* 3573 init-specs 9 initial-valuef) 255.0)
      (set! (-> *part-id-table* 3573 init-specs 10 initial-valuef) 255.0)
      (set! (-> *part-id-table* 3573 init-specs 11 initial-valuef) 92.0)
      (set! (-> *part-id-table* 3573 init-specs 18 initial-valuef) -0.16)
      (set! (-> *part-id-table* 3573 init-specs 19 initial-value) (seconds 1.8)))

    ((= mode 1)
      (set! (-> *part-id-table* 3573 init-specs 2 initial-valuef) 1.0)
      (set! (-> *part-id-table* 3573 init-specs 3 initial-valuef) (meters 0.34))
      (set! (-> *part-id-table* 3573 init-specs 7 initial-valuef) (meters 0.34))
      (set! (-> *part-id-table* 3573 init-specs 8 initial-valuef) 2.0)
      (set! (-> *part-id-table* 3573 init-specs 9 initial-valuef) 2.0)
      (set! (-> *part-id-table* 3573 init-specs 10 initial-valuef) 2.0)
      (set! (-> *part-id-table* 3573 init-specs 11 initial-valuef) 64.0)
      (set! (-> *part-id-table* 3573 init-specs 18 initial-valuef) -0.40)
      (set! (-> *part-id-table* 3573 init-specs 19 initial-value) (seconds 0.9)))

    ((= mode 2)
      (set! (-> *part-id-table* 3573 init-specs 2 initial-valuef) 2.0)
      (set! (-> *part-id-table* 3573 init-specs 3 initial-valuef) (meters 6.0))
      (set! (-> *part-id-table* 3573 init-specs 7 initial-valuef) (meters 6.0))
      (set! (-> *part-id-table* 3573 init-specs 8 initial-valuef) 255.0)
      (set! (-> *part-id-table* 3573 init-specs 9 initial-valuef) 72.0)
      (set! (-> *part-id-table* 3573 init-specs 10 initial-valuef) 0.0)
      (set! (-> *part-id-table* 3573 init-specs 11 initial-valuef) 118.0)
      (set! (-> *part-id-table* 3573 init-specs 18 initial-valuef) -0.65)
      (set! (-> *part-id-table* 3573 init-specs 19 initial-value) (seconds 0.42)))

    ((= mode 3)
      (set! (-> *part-id-table* 3573 init-specs 2 initial-valuef) 2.0)
      (set! (-> *part-id-table* 3573 init-specs 3 initial-valuef) (meters 6.30))
      (set! (-> *part-id-table* 3573 init-specs 7 initial-valuef) (meters 5.25))
      (set! (-> *part-id-table* 3573 init-specs 8 initial-valuef) 255.0)
      (set! (-> *part-id-table* 3573 init-specs 9 initial-valuef) 58.0)
      (set! (-> *part-id-table* 3573 init-specs 10 initial-valuef) 0.0)
      (set! (-> *part-id-table* 3573 init-specs 11 initial-valuef) 118.0)
      (set! (-> *part-id-table* 3573 init-specs 18 initial-valuef) -0.70)
      (set! (-> *part-id-table* 3573 init-specs 19 initial-value) (seconds 0.34)))

    ((= mode 4)
      (set! (-> *part-id-table* 3573 init-specs 2 initial-valuef) 1.0)
      (set! (-> *part-id-table* 3573 init-specs 3 initial-valuef) (meters 2.16))
      (set! (-> *part-id-table* 3573 init-specs 7 initial-valuef) (meters 2.76))
      (set! (-> *part-id-table* 3573 init-specs 8 initial-valuef) 255.0)
      (set! (-> *part-id-table* 3573 init-specs 9 initial-valuef) 48.0)
      (set! (-> *part-id-table* 3573 init-specs 10 initial-valuef) 0.0)
      (set! (-> *part-id-table* 3573 init-specs 11 initial-valuef) 104.0)
      (set! (-> *part-id-table* 3573 init-specs 18 initial-valuef) -0.60)
      (set! (-> *part-id-table* 3573 init-specs 19 initial-value) (seconds 0.42)))

    (else
      (set! (-> *part-id-table* 3573 init-specs 2 initial-valuef) 2.0)
      (set! (-> *part-id-table* 3573 init-specs 3 initial-valuef) (meters 0.58))
      (set! (-> *part-id-table* 3573 init-specs 7 initial-valuef) (meters 0.58))
      (set! (-> *part-id-table* 3573 init-specs 8 initial-valuef) 0.0)
      (set! (-> *part-id-table* 3573 init-specs 9 initial-valuef) 0.0)
      (set! (-> *part-id-table* 3573 init-specs 10 initial-valuef) 0.0)
      (set! (-> *part-id-table* 3573 init-specs 11 initial-valuef) 76.0)
      (set! (-> *part-id-table* 3573 init-specs 18 initial-valuef) -0.22)
      (set! (-> *part-id-table* 3573 init-specs 19 initial-value) (seconds 1.3))))
  (none))

(defun fisher-submit-lava-yellow-trail!
  ((self fisher-game) (pos vector))
  (when
    (= (-> self location-id) (the-as int (fisher-zone village3-lava)))
    (launch-particles
      :system *sp-particle-system-3d*
      (-> *part-id-table* 3578)
      pos)

    (dotimes (trail-index 4)
      (let ((trail-pos (new 'stack-no-clear 'vector)))
        (vector-copy! trail-pos pos)
        (-! (-> trail-pos y) (* (meters 0.22) (+ (the float trail-index) 1.0)))
        (set! (-> trail-pos w) 1.0)
        (launch-particles
          :system *sp-particle-system-3d*
          (-> *part-id-table* 3568)
          trail-pos))))
  (none))

(defun fisher-submit-village3-heat-distortion!
  ((self fisher-game) (side-axis vector))
  (dotimes (heat-index 5)
    (let ((heat-pos (new 'stack-no-clear 'vector)))
      (singlefish-vector-add-scaled-safe!
        heat-pos
        (-> self fishing-player-pos)
        (-> self playfield-axis)
        (rand-vu-float-range (meters 8.0) (meters 50.0)))
      (singlefish-vector-add-scaled-safe!
        heat-pos
        heat-pos
        side-axis
        (rand-vu-float-range (meters -9.0) (meters 9.0)))
      (set! (-> heat-pos y)
        (- (-> self water-level)
          (rand-vu-float-range (meters 0.5) (meters 24.0))))
      (set! (-> heat-pos w) 1.0)
      (launch-particles
        :system *sp-particle-system-2d*
        (-> *part-id-table* 1850)
        heat-pos)))
  (none))

(define *fisher-level-up-window-state* 'hidden)
(define *fisher-level-up-window-time* 0.0)
(define *fisher-level-up-window-offset* 150.0)
(define *fisher-power-cell-reward-active?* #f)
(define *fisher-power-cell-camera-active?* #f)
(define *fisher-session-active?* #f)
(define *fisher-button-world-down*
  (new 'static 'vector :x 0.0 :y -1.0 :z 0.0 :w 0.0))

(define *fisher-stop-lure-cooldown-color*
  (new 'static 'rgba :r #xe8 :g #xb8 :b #x38 :a #xe8)
)

(define *fisher-sink-lure-cooldown-color*
  (new 'static 'rgba :r #x28 :g #xb8 :b #xe8 :a #xe8)
)

(define *fisher-tug-line-cooldown-color*
  (new 'static 'rgba :r #xb8 :g #x38 :b #x78 :a #xe8)
)

(define *fisher-rip-line-cooldown-color*
  (new 'static 'rgba :r #xe8 :g #x58 :b #x28 :a #xe8)
)

(define *fisher-heal-line-cooldown-color*
  (new 'static 'rgba :r #x38 :g #xe8 :b #x78 :a #xe8)
)


(defun fisher-level-lure-speed-multiplier ()
  (fmin
    2.0
    (+
      1.0
      (* (the float (fisher-current-level)) 0.05))))

(defun fisher-level-up-window-active? ()
  (!= *fisher-level-up-window-state* 'hidden)
)

(defun fisher-level-up-blocking? ()
  (or
    *fisher-level-up-window-pending?*
    *fisher-level-up-window-request?*
    (fisher-level-up-window-active?)))

(defun fisher-modal-ui-active? ((self fisher-game))
  (or
    (= (-> self cast-state) 'catch-transition)
    (= (-> self cast-state) 'power-cell-ui-wait)
    (fisher-level-up-blocking?)
    (= (-> self fish-state) 'catch-enter)
    (= (-> self fish-state) 'catch-display)
    (= (-> self fish-state) 'catch-exit)
    (= (-> self fish-state) 'rare-enter)
    (= (-> self fish-state) 'rare-display)
    (= (-> self fish-state) 'rare-exit)))

(defun fisher-reset-level-up-window! ()
  (set! *fisher-level-up-window-state* 'hidden)
  (set! *fisher-level-up-window-time* 0.0)
  (set! *fisher-level-up-window-offset* 150.0)
  (set! *fisher-level-up-window-pending?* #f)
  (set! *fisher-level-up-window-request?* #f)
  (set! *fisher-level-up-window-old-level* 1)
  (set! *fisher-level-up-window-new-level* 1)
  (set! *fisher-level-up-window-skill-mask* 0)
  (none))

(defun fisher-begin-level-up-window! ()
  (when
    (and
      *fisher-level-up-window-request?*
      (= *fisher-level-up-window-state* 'hidden))

    (set! *fisher-level-up-window-request?* #f)
    (set! *fisher-level-up-window-state* 'enter)
    (set! *fisher-level-up-window-time* 0.0)
    (set! *fisher-level-up-window-offset* 150.0))

  (none))

(defun fisher-update-level-up-window! ()
  (fisher-begin-level-up-window!)

  (when
    (fisher-level-up-window-active?)

    (let ((dt
          (-> *display* seconds-per-frame)))

      (+! *fisher-level-up-window-time* dt)

      (cond
        ((= *fisher-level-up-window-state* 'enter)
          (let* ((duration
                0.65)

              (progress
                (fmin
                  1.0
                  (/ *fisher-level-up-window-time* duration)))

              (ease
                (fisher-smoothstep progress))

              (bounce
                (*
                  10.0
                  (sin (* (degrees 540.0) progress))
                  (- 1.0 progress))))

            (set!
              *fisher-level-up-window-offset*
              (+ (* 150.0 (- 1.0 ease)) bounce))

            (when
              (>= progress 1.0)

              (set! *fisher-level-up-window-offset* 0.0)
              (set! *fisher-level-up-window-time* 0.0)
              (set! *fisher-level-up-window-state* 'display))))

        ((= *fisher-level-up-window-state* 'display)
          (when
            (cpad-pressed? 0 x)

            (cpad-clear! 0 x)
            (set! *fisher-level-up-window-state* 'exit)
            (set! *fisher-level-up-window-time* 0.0)))

        ((= *fisher-level-up-window-state* 'exit)
          (let* ((duration
                0.48)

              (progress
                (fmin
                  1.0
                  (/ *fisher-level-up-window-time* duration)))

              (ease
                (fisher-smoothstep progress)))

            (set!
              *fisher-level-up-window-offset*
              (* 150.0 ease))

            (when
              (>= progress 1.0)

              (set! *fisher-level-up-window-state* 'hidden)
              (set! *fisher-level-up-window-time* 0.0)
              (set! *fisher-level-up-window-offset* 150.0)
              (set! *fisher-level-up-window-skill-mask* 0)))))))

  (none))

(defun fisher-draw-level-up-title!
  ((text string)
    (text-x-pos int)
    (text-y-pos int)
    (text-scale float))

  (clear matt-str)
  (clear *pc-encoded-matt-str*)
  (format matt-str text)
  (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)

  (with-dma-buffer-add-bucket
    ((buf (-> (current-frame) global-buf))
      (bucket-id subtitle))

    (draw-string-xy-scaled
      *pc-encoded-matt-str*
      buf
      text-x-pos
      text-y-pos
      (font-color orange)
      (font-flags large middle shadow kerning)
      text-scale))

  (none))

(defun fisher-draw-level-up-window! ()
  (when
    (and
      (fisher-level-up-window-active?)
      (current-frame)
      (-> (current-frame) global-buf))

    (let ((menu-offset
          (- (the int *fisher-level-up-window-offset*) 10))

        (skill-mask
          *fisher-level-up-window-skill-mask*)

        (panel-y
          (if
            (> *fisher-level-up-window-skill-mask* 0)
            12
            38))

        (window-height
          (if
            (> *fisher-level-up-window-skill-mask* 0)
            218
            164))

        (inner-height
          (if
            (> *fisher-level-up-window-skill-mask* 0)
            210
            156))

        (continue-y
          (if
            (> *fisher-level-up-window-skill-mask* 0)
            216
            186)))

      (with-dma-buffer-add-bucket
        ((buf (-> (current-frame) global-buf))
          (bucket-id subtitle))

        (draw-sprite2d-xy
          buf
          48
          (+ panel-y menu-offset)
          416
          window-height
          (new 'static 'rgba
            :r #x03
            :g #x0c
            :b #x14
            :a #xe8))

        (draw-sprite2d-xy
          buf
          52
          (+ (+ panel-y 4) menu-offset)
          408
          inner-height
          (new 'static 'rgba
            :r #x0d
            :g #x30
            :b #x42
            :a #xc8))

        (draw-sprite2d-xy
          buf
          68
          (+ (+ panel-y 38) menu-offset)
          376
          2
          (new 'static 'rgba
            :r #xd0
            :g #x98
            :b #x38
            :a #xb0))

        (when
          (> skill-mask 0)

          (draw-sprite2d-xy
            buf
            72
            (+ 122 menu-offset)
            368
            2
            (new 'static 'rgba
              :r #x60
              :g #x98
              :b #xa8
              :a #x98))))

      (clear *fish-ui-str*)
      (format
        *fish-ui-str*
        "LEVEL UP!  LV. ~D"
        *fisher-level-up-window-new-level*)

      (fisher-draw-level-up-title!
        *fish-ui-str*
        256
        (+ (if (> skill-mask 0) 34 60) menu-offset)
        0.62)

      (draw-fisher-large-font-scaled
        "YOUR FISHING POWER HAS INCREASED."
        256
        (+ (if (> skill-mask 0) 62 88) menu-offset)
        0.40)

      (draw-fisher-large-font-scaled
        "YOUR LINE IS STRONGER, AND YOU CAN"
        256
        (+ (if (> skill-mask 0) 82 108) menu-offset)
        0.36)

      (draw-fisher-large-font-scaled
        "REEL FASTER!"
        256
        (+ (if (> skill-mask 0) 99 125) menu-offset)
        0.38)

      (cond
        ((= skill-mask 1)
          (fisher-draw-level-up-title!
            "SKILL UNLOCKED: STOP LURE"
            256
            (+ 140 menu-offset)
            0.46)

          (draw-fisher-large-font-scaled
            "PRESS <PAD_SQUARE> TO FREEZE THE LURE"
            256
            (+ 150 menu-offset)
            0.36)

          (draw-fisher-large-font-scaled
            "FOR 3 SECONDS - 20 SECOND COOLDOWN."
            256
            (+ 181 menu-offset)
            0.36))

        ((= skill-mask 2)
          (fisher-draw-level-up-title!
            "SKILL UNLOCKED: SINK LURE"
            256
            (+ 140 menu-offset)
            0.46)

          (fisher-draw-reel-hint-text-red
            "R1"
            106
            (+ 163 menu-offset)
            0.37)

          (fisher-draw-reel-hint-text
            " SINKS THE LURE 3X FASTER"
            126
            (+ 163 menu-offset)
            0.37)

          (draw-fisher-large-font-scaled
            "FOR 3.5 SECONDS - 15 SECOND COOLDOWN."
            256
            (+ 181 menu-offset)
            0.35))

        ((= skill-mask 4)
          (fisher-draw-level-up-title!
            "SKILL UNLOCKED: FAST REEL"
            256
            (+ 140 menu-offset)
            0.46)

          (fisher-draw-reel-hint-text-red
            "L1"
            98
            (+ 163 menu-offset)
            0.37)

          (fisher-draw-reel-hint-text
            " REELS A HOOKED FISH 2X FASTER"
            118
            (+ 163 menu-offset)
            0.35)

          (draw-fisher-large-font-scaled
            "FOR 2 SECONDS - 35 SECOND COOLDOWN."
            256
            (+ 181 menu-offset)
            0.35)

          (draw-fisher-large-font-scaled
            "THE SPEED CHANGE IS IMMEDIATE."
            256
            (+ 197 menu-offset)
            0.32))

        ((= skill-mask 8)
          (fisher-draw-level-up-title!
            "SKILL UNLOCKED: FISHING CLOCK"
            256
            (+ 140 menu-offset)
            0.44)

          (draw-fisher-large-font-scaled
            "THE CURRENT TIME IS NOW ALWAYS SHOWN"
            256
            (+ 150 menu-offset)
            0.34)

          (draw-fisher-large-font-scaled
            "WHILE FISHING. GOLDEN HOURS GLOW YELLOW."
            256
            (+ 181 menu-offset)
            0.32))

        ((= skill-mask 16)
          (fisher-draw-level-up-title!
            "SKILL UNLOCKED: TUG LINE"
            256
            (+ 140 menu-offset)
            0.46)

          (draw-fisher-large-font-scaled
            "PRESS <PAD_CIRCLE> DURING A FISH FIGHT"
            256
            (+ 160 menu-offset)
            0.34)

          (draw-fisher-large-font-scaled
            "TO END IT AND BLOCK FIGHTS FOR 4 SECONDS."
            256
            (+ 178 menu-offset)
            0.31)

          (draw-fisher-large-font-scaled
            "35 SECOND COOLDOWN."
            256
            (+ 197 menu-offset)
            0.34))

        ((= skill-mask 32)
          (fisher-draw-level-up-title!
            "SKILL UNLOCKED: HEAL LINE"
            256
            (+ 140 menu-offset)
            0.46)

          (fisher-draw-reel-hint-text
            "PRESS "
            104
            (+ 160 menu-offset)
            0.34)

          (fisher-draw-reel-hint-text-red
            "R2"
            148
            (+ 160 menu-offset)
            0.34)

          (fisher-draw-reel-hint-text
            " TO RESTORE 65 LINE HP."
            168
            (+ 160 menu-offset)
            0.34)

          (draw-fisher-large-font-scaled
            "26 SECOND COOLDOWN."
            256
            (+ 181 menu-offset)
            0.36))

        ((= skill-mask 64)
          (fisher-draw-level-up-title!
            "UPGRADE UNLOCKED: REINFORCED LINE"
            256
            (+ 140 menu-offset)
            0.42)

          (draw-fisher-large-font-scaled
