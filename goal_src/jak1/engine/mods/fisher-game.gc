(defun fisher-swamp-curtain-color!
  ((dst vector))

  (set-vector! dst 20.0 22.0 22.0 1.0)
  dst)

(defun fisher-village3-curtain-color!
  ((self fisher-game) (dst vector))

  (let* ((phase (-> self background-curtain-phase))
      (half-phase
        (if
          (>= phase (degrees 360.0))
          (- phase (degrees 360.0))
          phase))
      (swapped? (>= phase (degrees 360.0)))
      (blend 0.0)
      (target-r 0.0)
      (target-g 0.0)
      (target-b 0.0))

    (cond
      ((< half-phase (degrees 90.0))
        (set! blend (/ half-phase (degrees 90.0)))
        (set! target-r (if swapped? 229.0 218.0))
        (set! target-g (if swapped? 123.0 113.0))
        (set! target-b (if swapped? 11.0 20.0))
        (set! (-> dst x) (+ 232.0 (* (- target-r 232.0) blend)))
        (set! (-> dst y) (+ 130.0 (* (- target-g 130.0) blend)))
        (set! (-> dst z) (+ 18.0 (* (- target-b 18.0) blend))))

      ((< half-phase (degrees 180.0))
        (set! blend (/ (- half-phase (degrees 90.0)) (degrees 90.0)))
        (set! target-r (if swapped? 229.0 218.0))
        (set! target-g (if swapped? 123.0 113.0))
        (set! target-b (if swapped? 11.0 20.0))
        (set! (-> dst x) (+ target-r (* (- 232.0 target-r) blend)))
        (set! (-> dst y) (+ target-g (* (- 130.0 target-g) blend)))
        (set! (-> dst z) (+ target-b (* (- 18.0 target-b) blend))))

      ((< half-phase (degrees 270.0))
        (set! blend (/ (- half-phase (degrees 180.0)) (degrees 90.0)))
        (set! target-r (if swapped? 218.0 229.0))
        (set! target-g (if swapped? 113.0 123.0))
        (set! target-b (if swapped? 20.0 11.0))
        (set! (-> dst x) (+ 232.0 (* (- target-r 232.0) blend)))
        (set! (-> dst y) (+ 130.0 (* (- target-g 130.0) blend)))
        (set! (-> dst z) (+ 18.0 (* (- target-b 18.0) blend))))

      (else
        (set! blend (/ (- half-phase (degrees 270.0)) (degrees 90.0)))
        (set! target-r (if swapped? 218.0 229.0))
        (set! target-g (if swapped? 113.0 123.0))
        (set! target-b (if swapped? 20.0 11.0))
        (set! (-> dst x) (+ target-r (* (- 232.0 target-r) blend)))
        (set! (-> dst y) (+ target-g (* (- 130.0 target-g) blend)))
        (set! (-> dst z) (+ target-b (* (- 18.0 target-b) blend)))))

    (set! (-> dst w) 1.0))

  dst)

(defun fisher-background-color!
  ((dst vector))

  (let ((hour
        (if
          *time-of-day-context*
          (-> *time-of-day-context* time)
          12.0))

      (blend
        0.0))

    (cond
      ((and
          (>= hour 4.0)
          (< hour 7.0))

        (set! blend (/ (- hour 4.0) 3.0))

        (set! (-> dst x) (+ 9.0 (* (- 34.0 9.0) blend)))

        (set! (-> dst y) (+ 88.0 (* (- 110.0 88.0) blend)))

        (set!
          (-> dst z)
          97.0))

      ((and
          (>= hour 7.0)
          (< hour 9.0))

        (set! blend (/ (- hour 7.0) 2.0))

        (set! (-> dst x) (+ 34.0 (* (- 62.0 34.0) blend)))

        (set! (-> dst y) (+ 110.0 (* (- 164.0 110.0) blend)))

        (set!
          (-> dst z)
          (+ 97.0
            (* (- 175.0 97.0)
              blend))))

      ((and
          (>= hour 9.0)
          (< hour 12.0))

        (set! (-> dst x) 62.0)
        (set! (-> dst y) 164.0)
        (set! (-> dst z) 175.0))

      ((and
          (>= hour 12.0)
          (< hour 18.0))

        (set! blend (/ (- hour 12.0) 6.0))

        (set! (-> dst x) (+ 62.0 (* (- 30.0 62.0) blend)))

        (set! (-> dst y) (+ 164.0 (* (- 72.0 164.0) blend)))

        (set!
          (-> dst z)
          (+ 175.0
            (* (- 57.0 175.0)
              blend))))

      ((and
          (>= hour 18.0)
          (< hour 19.0))

        (set! blend (- hour 18.0))

        (set! (-> dst x) (+ 30.0 (* (- 11.0 30.0) blend)))

        (set! (-> dst y) (+ 72.0 (* (- 44.0 72.0) blend)))

        (set!
          (-> dst z)
          (+ 57.0
            (* (- 96.0 57.0)
              blend))))

      ((or
          (>= hour 19.0)
          (< hour 3.0))

        (set! (-> dst x) 11.0)
        (set! (-> dst y) 44.0)
        (set! (-> dst z) 96.0))

      (else
        (set! blend (- hour 3.0))

        (set! (-> dst x) (+ 11.0 (* (- 9.0 11.0) blend)))

        (set! (-> dst y) (+ 44.0 (* (- 88.0 44.0) blend)))

        (set!
          (-> dst z)
          (+ 96.0
            (* (- 97.0 96.0)
              blend)))))

    (set!
      (-> dst w)
      1.0))

  dst)

(defun fisher-restore-sky-base-position! ()
  (set! (-> sky-base-polygons 0 pos y) 0.0)
  (set! (-> sky-base-polygons 1 pos y) 0.0)
  (set! (-> sky-base-polygons 3 pos y) 0.0)
  (set! (-> sky-base-polygons 4 pos y) 0.0)
  (set! (-> sky-base-polygons 6 pos y) 0.0)
  (set! (-> sky-base-polygons 7 pos y) 0.0)
  (set! (-> sky-base-polygons 9 pos y) 0.0)
  (set! (-> sky-base-polygons 10 pos y) 0.0)

  (none))

(defun fisher-update-background-mist-color! ()
  (set!
    (-> *part-id-table* 3572 init-specs 8 initial-valuef)
    (-> *fisher-underwater-haze-color* x))

  (set!
    (-> *part-id-table* 3572 init-specs 9 initial-valuef)
    (-> *fisher-underwater-haze-color* y))

  (set!
    (-> *part-id-table* 3572 init-specs 10 initial-valuef)
    (-> *fisher-underwater-haze-color* z))

  (set!
    (-> *part-id-table* 3572 init-specs 11 initial-valuef)
    22.0)

  (none))

(defun fisher-submit-background-mist!
  ((self fisher-game))

  (when
    (and
      *fisher-background-cloud-session-active?*
      (-> self camera-underwater?))

    (let ((curtain-forward
          (new 'stack-no-clear 'vector))

        (particle-pos
          (new 'stack-no-clear 'vector))

        (lava-color
          (new 'stack-no-clear 'vector)))

      (singlefish-vector-copy-safe!
        curtain-forward
        (-> self camera-axis))

      (set! (-> curtain-forward y) 0.0)
      (set! (-> curtain-forward w) 0.0)
      (vector-normalize! curtain-forward 1.0)

      (fisher-update-background-mist-color!)

      (cond
        ((=
            (-> self location-id)
            (the-as int (fisher-zone village2-electric)))
          (set!
            (-> *part-id-table* 3572 init-specs 11 initial-valuef)
            8.0))

        ((=
            (-> self location-id)
            (the-as int (fisher-zone village3-lava)))
          (fisher-village3-curtain-color! self lava-color)
          (set! (-> *part-id-table* 3572 init-specs 8 initial-valuef) (-> lava-color x))
          (set! (-> *part-id-table* 3572 init-specs 9 initial-valuef) (-> lava-color y))
          (set! (-> *part-id-table* 3572 init-specs 10 initial-valuef) (-> lava-color z))
          (set! (-> *part-id-table* 3572 init-specs 11 initial-valuef) 12.0))

        ((=
            (-> self location-id)
            (the-as int (fisher-zone swamp-sludge)))
          (set!
            (-> *part-id-table* 3572 init-specs 8 initial-valuef)
            0.0)
          (set!
            (-> *part-id-table* 3572 init-specs 9 initial-valuef)
            0.0)
          (set!
            (-> *part-id-table* 3572 init-specs 10 initial-valuef)
            0.0)
          (set!
            (-> *part-id-table* 3572 init-specs 11 initial-valuef)
            5.0)))

      (fisher-set-particle-fishbox-rotation! self)

      (vector+float*!
        particle-pos
        (-> self fisher-cam)
        curtain-forward
        (meters 86.0))

      (vector+float*!
        particle-pos
        particle-pos
        (-> self playfield-axis)
        (meters 27.75))

      (set!
        (-> particle-pos y)
        (- (-> self water-level) (meters 54.0)))

      (set! (-> particle-pos w) 1.0)

      (launch-particles
        :system *sp-particle-system-3d*
        (-> *part-id-table* 3572)
        particle-pos)))

  (none))

(defun fisher-launch-background-mist!
  ((self fisher-game))

  (set! *fisher-background-cloud-session-active?* #t)
  (none))

(defun fisher-update-background-mist!
  ((self fisher-game))

  (none))


(defun fisher-set-god-ray-particle!
  ((width float)
    (height float)
    (roll float)
    (alpha float))

  (let ((ray-r
        (+
          (-> *fisher-underwater-haze-color* x)
          (*
            (- 255.0 (-> *fisher-underwater-haze-color* x))
            0.62)))

      (ray-g
        (+
          (-> *fisher-underwater-haze-color* y)
          (*
            (- 255.0 (-> *fisher-underwater-haze-color* y))
            0.72)))

      (ray-b
        (+
          (-> *fisher-underwater-haze-color* z)
          (*
            (- 255.0 (-> *fisher-underwater-haze-color* z))
            0.82))))

    (set!
      (-> *part-id-table* 3580 init-specs 3 initial-valuef)
      width)

    (set!
      (-> *part-id-table* 3580 init-specs 4 initial-valuef)
      (degrees -90.0))

    (set!
      (-> *part-id-table* 3580 init-specs 6 initial-valuef)
      roll)

    (set!
      (-> *part-id-table* 3580 init-specs 7 initial-valuef)
      height)

    (set!
      (-> *part-id-table* 3580 init-specs 8 initial-valuef)
      ray-r)

    (set!
      (-> *part-id-table* 3580 init-specs 9 initial-valuef)
      ray-g)

    (set!
      (-> *part-id-table* 3580 init-specs 10 initial-valuef)
      ray-b)

    (set!
      (-> *part-id-table* 3580 init-specs 11 initial-valuef)
      alpha))

  (none))

(defun fisher-submit-god-ray!
  ((self fisher-game)
    (lateral float)
    (depth float)
    (width float)
    (height float)
    (roll float)
    (alpha float))

  (let ((ray-forward
        (new 'stack-no-clear 'vector))

      (ray-side
        (new 'stack-no-clear 'vector))

      (ray-pos
        (new 'stack-no-clear 'vector)))

    (singlefish-vector-copy-safe!
      ray-forward
      (-> self camera-axis))

    (set! (-> ray-forward y) 0.0)
    (set! (-> ray-forward w) 0.0)
    (vector-normalize! ray-forward 1.0)

    (set! (-> ray-side x) (-> ray-forward z))
    (set! (-> ray-side y) 0.0)
    (set! (-> ray-side z) (- (-> ray-forward x)))
    (set! (-> ray-side w) 0.0)
    (vector-normalize! ray-side 1.0)

    (vector+float*!
      ray-pos
      (-> self fisher-cam)
      ray-forward
      depth)

    (vector+float*!
      ray-pos
      ray-pos
      (-> self playfield-axis)
      (meters 27.75))

    (vector+float*!
      ray-pos
      ray-pos
      ray-side
      lateral)

    (set!
      (-> ray-pos y)
      (-
        (-> self water-level)
        (* height 0.50)))

    (set! (-> ray-pos w) 1.0)

    (fisher-set-god-ray-particle!
      width
      height
      roll
      alpha)

    (fisher-set-particle-fishbox-rotation! self)

    (launch-particles
      :system *sp-particle-system-3d*
      (-> *part-id-table* 3580)
      ray-pos))

  (none))

(defun fisher-submit-animated-god-ray!
  ((self fisher-game)
    (base-lateral float)
    (depth float)
    (width float)
    (height float)
    (roll float)
    (max-alpha float)
    (phase float))

  (let ((cycle phase)
        (progress 0.0)
        (alpha 0.0)
        (ray-x base-lateral))

    (while
      (>= cycle (degrees 360.0))
      (-! cycle (degrees 360.0)))

    (set!
      progress
      (/ cycle (degrees 360.0)))

    (cond
      ((= base-lateral (meters -34.0))
        (when
          (and
            (< progress 0.08)
            *fisher-god-ray-reroll-0?*)
          (set!
            *fisher-god-ray-x-0*
            (+
              (meters -42.0)
              (* (meters 84.0) (rand-vu))))
          (set! *fisher-god-ray-reroll-0?* #f))
        (when (> progress 0.20)
          (set! *fisher-god-ray-reroll-0?* #t))
        (set! ray-x *fisher-god-ray-x-0*))

      ((= base-lateral (meters -17.0))
        (when
          (and
            (< progress 0.08)
            *fisher-god-ray-reroll-1?*)
          (set!
            *fisher-god-ray-x-1*
            (+
              (meters -42.0)
              (* (meters 84.0) (rand-vu))))
          (set! *fisher-god-ray-reroll-1?* #f))
        (when (> progress 0.20)
          (set! *fisher-god-ray-reroll-1?* #t))
        (set! ray-x *fisher-god-ray-x-1*))

      ((= base-lateral (meters 1.0))
        (when
          (and
            (< progress 0.08)
            *fisher-god-ray-reroll-2?*)
          (set!
            *fisher-god-ray-x-2*
            (+
              (meters -42.0)
              (* (meters 84.0) (rand-vu))))
          (set! *fisher-god-ray-reroll-2?* #f))
        (when (> progress 0.20)
          (set! *fisher-god-ray-reroll-2?* #t))
        (set! ray-x *fisher-god-ray-x-2*))

      ((= base-lateral (meters 21.0))
        (when
          (and
            (< progress 0.08)
            *fisher-god-ray-reroll-3?*)
          (set!
            *fisher-god-ray-x-3*
            (+
              (meters -42.0)
              (* (meters 84.0) (rand-vu))))
          (set! *fisher-god-ray-reroll-3?* #f))
        (when (> progress 0.20)
          (set! *fisher-god-ray-reroll-3?* #t))
        (set! ray-x *fisher-god-ray-x-3*))

      (else
        (when
          (and
            (< progress 0.08)
            *fisher-god-ray-reroll-4?*)
          (set!
            *fisher-god-ray-x-4*
            (+
              (meters -42.0)
              (* (meters 84.0) (rand-vu))))
          (set! *fisher-god-ray-reroll-4?* #f))
        (when (> progress 0.20)
          (set! *fisher-god-ray-reroll-4?* #t))
        (set! ray-x *fisher-god-ray-x-4*)))

    (cond
      ((< progress 0.10)
        (set! alpha 0.0))

      ((< progress 0.42)
        (let* ((t
                (/ (- progress 0.10) 0.32))

              (smooth
                (* t t (- 3.0 (* 2.0 t)))))

          (set! alpha (* max-alpha smooth))))

      ((< progress 0.88)
        (let* ((t
                (/ (- progress 0.42) 0.46))

              (smooth
                (* t t (- 3.0 (* 2.0 t)))))

          (set! alpha (* max-alpha (- 1.0 smooth)))))

      (else
        (set! alpha 0.0)))

    (fisher-submit-god-ray!
      self
      ray-x
      depth
      width
      height
      roll
      alpha))

  (none))

(defun fisher-submit-god-rays!
  ((self fisher-game))

  (when
    (and
      *fisher-background-cloud-session-active?*
      (-> self camera-underwater?))

    (let ((dt
          (-> *display* seconds-per-frame))

        (hour
          (if
            *time-of-day-context*
            (-> *time-of-day-context* time)
            12.0))

        (daylight 0.0)

        (phase
          (-> self background-mist-time)))

      (if
        (and
          (>= hour 7.0)
          (< hour 18.0))
        (set! daylight 1.0)
        (set! daylight 0.0))

      (+!
        (-> self background-mist-time)
        (* (degrees 60.0) dt))

      (when
        (>=
          (-> self background-mist-time)
          (degrees 360.0))

        (-!
          (-> self background-mist-time)
          (degrees 360.0)))

      (when (> daylight 0.0)
        (fisher-submit-animated-god-ray!
          self
          (meters -34.0)
          (meters 73.0)
          (meters 11.0)
          (meters 62.0)
          (degrees -34.0)
          (* daylight 30.0)
          (+ (* phase 0.83) (degrees 35.0)))

        (fisher-submit-animated-god-ray!
          self
          (meters -17.0)
          (meters 76.0)
          (meters 7.5)
          (meters 56.0)
          (degrees -28.0)
          (* daylight 24.0)
          (+ (* phase 1.07) (degrees 145.0)))

        (fisher-submit-animated-god-ray!
          self
          (meters 1.0)
          (meters 70.0)
          (meters 14.0)
          (meters 68.0)
          (degrees -38.0)
          (* daylight 34.0)
          (+ (* phase 0.71) (degrees 250.0)))

        (fisher-submit-animated-god-ray!
          self
          (meters 21.0)
          (meters 75.0)
          (meters 8.5)
          (meters 54.0)
          (degrees -30.0)
          (* daylight 25.0)
          (+ (* phase 1.13) (degrees 25.0)))

        (fisher-submit-animated-god-ray!
          self
          (meters 38.0)
          (meters 72.0)
          (meters 12.0)
          (meters 64.0)
          (degrees -26.0)
          (* daylight 28.0)
          (+ (* phase 0.76) (degrees 185.0)))))

  )

  (none))

(defun fisher-force-underwater-background! ()
  (when *time-of-day-context*
    (let ((hour
          (-> *time-of-day-context* time))

        (blend 0.0)

        (r 0.0)

        (g 0.0)

        (b
          0.0))

      (cond
        ((and
            (>= hour 4.0)
            (< hour 7.0))

          (set! blend (/ (- hour 4.0) 3.0))

          (set! r (+ 9.0 (* (- 34.0 9.0) blend)))

          (set! g (+ 88.0 (* (- 110.0 88.0) blend)))

          (set! b (+ 97.0 (* (- 97.0 97.0) blend)))
        )

        ((and
            (>= hour 7.0)
            (< hour 9.0))

          (set! blend (/ (- hour 7.0) 2.0))

          (set! r (+ 34.0 (* (- 62.0 34.0) blend)))

          (set! g (+ 110.0 (* (- 164.0 110.0) blend)))

          (set! b (+ 97.0 (* (- 175.0 97.0) blend)))
        )

        ((and
            (>= hour 9.0)
            (< hour 12.0))

          (set! r 62.0)
          (set! g 164.0)
          (set! b 175.0)
        )

        ((and
            (>= hour 12.0)
            (< hour 18.0))

          (set! blend (/ (- hour 12.0) 6.0))

          (set! r (+ 62.0 (* (- 30.0 62.0) blend)))

          (set! g (+ 164.0 (* (- 72.0 164.0) blend)))

          (set! b (+ 175.0 (* (- 57.0 175.0) blend)))
        )

        ((and
            (>= hour 18.0)
            (< hour 19.0))

          (set! blend (- hour 18.0))

          (set! r (+ 30.0 (* (- 11.0 30.0) blend)))

          (set! g (+ 72.0 (* (- 44.0 72.0) blend)))

          (set! b (+ 57.0 (* (- 96.0 57.0) blend)))
        )

        (else
          (cond
            ((and
                (>= hour 19.0)
                (< hour 24.0))

              (set! r 11.0)
              (set! g 44.0)
              (set! b 96.0)
            )

            ((< hour 3.0) (set! r 11.0) (set! g 44.0) (set! b 96.0))

            (else
              (set! blend (- hour 3.0))

              (set! r (+ 11.0 (* (- 9.0 11.0) blend)))

              (set! g (+ 44.0 (* (- 88.0 44.0) blend)))

              (set! b (+ 96.0 (* (- 97.0 96.0) blend)))
            )
          )
        )
      )

      (dotimes (i 12)
        (set! (-> sky-base-polygons i col x) r)

        (set! (-> sky-base-polygons i col y) g)

        (set! (-> sky-base-polygons i col z) b)

        (set!
          (-> sky-base-polygons i col w)
          128.0))
      (fisher-force-underwater-horizon! r g b)
    )
  )

  (none)
)

(defun fisher-force-swamp-underwater-background! ()
  (dotimes (i 12)
    (set! (-> sky-base-polygons i col x) 20.0)
    (set! (-> sky-base-polygons i col y) 22.0)
    (set! (-> sky-base-polygons i col z) 22.0)
    (set! (-> sky-base-polygons i col w) 128.0))

  (fisher-force-underwater-horizon! 20.0 22.0 22.0)
  (none))

(defun fisher-force-lava-underwater-background! ((self fisher-game))
  (let ((color (new 'stack-no-clear 'vector)))
    (fisher-village3-curtain-color! self color)
    (dotimes (i 12)
      (set! (-> sky-base-polygons i col x) (-> color x))
      (set! (-> sky-base-polygons i col y) (-> color y))
      (set! (-> sky-base-polygons i col z) (-> color z))
      (set! (-> sky-base-polygons i col w) 128.0))
    (fisher-force-underwater-horizon!
      (-> color x)
      (-> color y)
      (-> color z)))
  (none))

(defun fisher-update-camera-water! ((self fisher-game))
  (cond
    ((and
        *camera*
        (> (-> *camera* num-slaves) 0))

      (let ((cam-slave
            (-> *camera* slave 0 0)))

        (set!
          (-> self camera-underwater?)
          (<
            (-> cam-slave trans y)
            (-> self water-level)))

        (set!
          *fisher-background-cloud-visible?*
          (-> self camera-underwater?))))

    (else
      (set! (-> self camera-underwater?) #f)
      (set! *fisher-background-cloud-visible?* #f)))

  (none))

(defun fisher-draw-cast-bar ((charge float))
  (let ((fill-height (the int (* 116.0 charge)))
      (fill-y (the int (- 184.0 (* 116.0 charge)))))

    (with-dma-buffer-add-bucket
      ((buf (-> (current-frame) global-buf)) (bucket-id subtitle))

      (draw-sprite2d-xy buf 455 61 34 134 (new 'static 'rgba :r #x00 :g #x00 :b #x00 :a #x60))

      (draw-sprite2d-xy buf 458 64 28 128 (new 'static 'rgba :r #x70 :g #x78 :b #x70 :a #x80))

      (draw-sprite2d-xy buf 462 68 20 120 (new 'static 'rgba :r #x08 :g #x10 :b #x18 :a #x70))

      (when (> fill-height 0)
        (draw-sprite2d-xy buf 464 fill-y 16 fill-height (new 'static 'rgba :r #x20 :g #x70 :b #x80 :a #x80))

        (draw-sprite2d-xy buf 462 (- fill-y 2) 20 4 (new 'static 'rgba :r #x70 :g #x80 :b #x80 :a #x80))
      )

      (draw-sprite2d-xy buf 458 58 28 6 (new 'static 'rgba :r #x70 :g #x78 :b #x70 :a #x80))

      (draw-sprite2d-xy buf 458 192 28 6 (new 'static 'rgba :r #x70 :g #x78 :b #x70 :a #x80))
    )
  )

  (none)
)

(defun fisher-reset-cast! ((self fisher-game))
  (set! (-> self cast-state) 'ready)
  (set! (-> self camera-state) 'before-cast)
  (set! (-> self cast-charge-direction) 1.0)
  (set! (-> self cast-charge) 0.0)
  (set! (-> self cast-time) 0.0)
  (set! (-> self camera-blend) 0.0)
  (set! (-> self casted?) #f)
  (set! (-> self hooked-fish) #f)
  (set! (-> self fish-state) 'free)
  (set! (-> self dark-eco-displaced-slot) -1)
  (set! (-> self fish-message) #f)
  (set! (-> self fish-message-time) 0.0)
  (set! (-> self skill-message) #f)
  (set! (-> self skill-message-time) 0.0)
  (set! (-> self reel-camera-blend) 0.0)
  (set! (-> self hooked-fish-poison-dps) 0.0)
  (fisher-clear-button-fight! self)

  (set! (-> self lure-x-velocity) 0.0)
  (set! (-> self lure-y-velocity) 0.0)
  (vector-reset! (-> self lure-pos))
  (vector-reset! (-> self lure-cast-start))
  (vector-reset! (-> self lure-cast-end))
  (vector-reset! (-> self lure-cast-axis))
  (vector-reset! (-> self lure-camera-offset))
  (vector-reset! (-> self lure-camera-pos))
  (vector-reset! (-> self lure-camera-look))
  (vector-reset! (-> self hooked-fish-facing))
  (vector-reset! (-> self hooked-fish-last-hook-pos))
  (stop-sound-file "water-waves.wav")
  (fisher-remove-lure-snake! self)
  (set! (-> self reel-hint-time) 0.0)
  (set! (-> self lure-stop-active?) #f)
  (set! (-> self lure-stop-time) 0.0)
  (set! (-> self lure-sink-active?) #f)
  (set! (-> self lure-sink-time) 0.0)
  (set! (-> self tug-line-active?) #f)
  (set! (-> self tug-line-time) 0.0)
  (set! (-> self bubble-time) -2.0)
  (set! (-> self electric-slot) -1)
  (fisher-reset-electric-cycle! self)
  (fisher-reset-yellow-cycle! self)
  (fisher-reset-lava-fire-cycle! self)
  (set! (-> self lava-trail-time) 0.0)
  (set! (-> self lava-flame-time) 0.0)
  (set! (-> self lure-destroyed?) #f)
  (set! (-> self lure-incinerated?) #f)

  (none))


(defun fisher-debug-print-lure-loss! ((self fisher-game) (cause string))
  (when *fisher-in-debug?*
    (format #t "[FISHER] ========================================~%")
    (format #t "[FISHER] LURE LOST CAUSE: ~A~%" cause)
    (format #t "[FISHER] cast-state: ~A~%" (-> self cast-state))
    (format #t "[FISHER] fish-state: ~A~%" (-> self fish-state))
    (format #t "[FISHER] hooked-fish-slot: ~D~%" (-> self hooked-fish-slot))

    (when (>= (-> self hooked-fish-slot) 0)
      (format
        #t
        "[FISHER] species: ~A~%"
        (fisher-species-name
          self
          (fisher-fish-species self (-> self hooked-fish-slot)))))

    (format #t "[FISHER] ========================================~%"))

  (none))


(defun fisher-begin-lure-stolen-return! ((self fisher-game))
  (when *fisher-in-debug?*
    (format #t "[FISHER] >>> fisher-begin-lure-stolen-return! ENTERED <<<~%"))

  (when (!= (-> self cast-state) 'lure-stolen-return)
    (set! (-> self lure-destroyed?) #f)
    (set! (-> self lure-incinerated?) #f)
    (fisher-lose-lure!)
    (fisher-clear-button-fight! self)
    (set! (-> self cast-state) 'lure-stolen-return)
    (set! (-> self camera-state) 'lure-stolen-lure-return)
    (set! (-> self cast-time) 0.0)
    (set! (-> self fish-state) 'free)
    (set! (-> self hooked-fish) #f)
    (set! (-> self hooked-fish-slot) -1)
    (set! (-> self dark-eco-displaced-slot) -1)
    (set! (-> self fish-fighting?) #f)
    (set! (-> self hooked-fish-poison-dps) 0.0)
    (set! (-> self reel-camera-blend) 0.0)
    (set! (-> self lure-x-velocity) 0.0)
    (set! (-> self lure-y-velocity) 0.0)
    (set! (-> self fish-message) "LURE STOLEN")
    (set! (-> self fish-message-time) 1.75)

    (fisher-remove-lure-snake! self))

  (none))

(defun fisher-camera-lure-stolen-return! ((self fisher-game))
  (when (and *camera* (> (-> *camera* num-slaves) 0))
    (let ((cam-slave (-> *camera* slave 0 0))
        (desired-camera (new 'stack-no-clear 'vector))
        (desired-look (new 'stack-no-clear 'vector))
        (current-camera (new 'stack-no-clear 'vector))
        (blended-camera (new 'stack-no-clear 'vector))
        (forward (new 'stack-no-clear 'vector))
        (blend 0.0))

      (cond
        ((= (-> self location-id) 1)
          (vector-copy! desired-camera (-> self fisher-cam)))
        (else
          (vector+float*! desired-camera (-> self pos) (-> self camera-axis) (- (-> self camera-radius)))
          (set! (-> desired-camera y) (-> self fisher-cam y))
          (set! (-> desired-camera w) 1.0)))

      (vector-copy! desired-look (-> self pos))
      (+! (-> desired-look y) (meters 1.0))
      (set! (-> desired-look w) 1.0)

      (+! (-> self cast-time) (/ (-> *display* seconds-per-frame) 0.70))
      (when (> (-> self cast-time) 1.0)
        (set! (-> self cast-time) 1.0))

      (set! blend (parameter-ease-sin-clamp (-> self cast-time)))
      (vector-copy! current-camera (-> cam-slave trans))
      (vector-lerp! blended-camera current-camera desired-camera blend)
      (set! (-> cam-slave saved-pt quad) (-> blended-camera quad))
      (set! (-> cam-slave trans quad) (-> blended-camera quad))

      (vector-! forward desired-look blended-camera)
      (vector-normalize! forward 1.0)
      (forward-down->inv-matrix (-> cam-slave tracking inv-mat) forward (-> *camera* local-down))))

  (>= (-> self cast-time) 1.0))

(defun fisher-update-lure-stolen-return! ((self fisher-game))
  (let ((dt (-> *display* seconds-per-frame)))
    (cond
      ((= (-> self camera-state) 'lure-stolen-lure-return)
        (let ((return-pos (new 'stack-no-clear 'vector))
            (to-return (new 'stack-no-clear 'vector))
            (distance 0.0)
            (step (* (meters 15.0) dt)))

          (vector+float*!
            return-pos
            (-> self fishing-player-pos)
            (-> self playfield-axis)
            (meters 1.55))
          (+! (-> return-pos y) (meters 1.15))
          (set! (-> return-pos w) 1.0)

          (vector-! to-return return-pos (-> self lure-pos))
          (set! distance (vector-length to-return))

          (cond
            ((<= distance step)
              (vector-copy! (-> self lure-pos) return-pos)
              (set! (-> self camera-state) 'lure-stolen-camera-return)
              (set! (-> self cast-time) 0.0))
            (else
              (vector-normalize! to-return 1.0)
              (vector+float*!
                (-> self lure-pos)
                (-> self lure-pos)
                to-return
                step)))

          (fisher-camera-follow-lure! self)
          (fisher-update-underwater-background! self)
          (fisher-update-camera-bubbles! self)))

      ((= (-> self camera-state) 'lure-stolen-camera-return)
        (fisher-update-underwater-background! self)
        (fisher-update-camera-bubbles! self)

        (when (fisher-camera-lure-stolen-return! self)
          (let ((destroyed? (-> self lure-destroyed?))
              (incinerated? (-> self lure-incinerated?)))
            (fisher-reset-cast! self)
            (set!
              (-> self fish-message)
              (cond
                (incinerated? "LURE INCINERATED")
                (destroyed? "LURE DESTROYED")
                (else "LURE STOLEN")))
            (set! (-> self fish-message-time) (if incinerated? 2.0 1.75)))))))

  (none))

(defun singlefish-prefix-multiplier ((self singlefish-base))
  (cond
    ((= (-> self prefix) 'stressed) 0.50)
    ((= (-> self prefix) 'malnourished) 0.75)
    ((= (-> self prefix) 'common) 1.00)
    ((= (-> self prefix) 'healthy) 1.50)
    ((= (-> self prefix) 'royal) 2.00)
    ((= (-> self prefix) 'legendary) 3.00)
    (else 5.00)))

(defun singlefish-remove-visual! ((self singlefish-base)) (none))

(defun singlefish-session-valid? ((self singlefish-base))
  (and
    *singlefish-session-active?*
    (= (-> self session-id) *singlefish-session-id*)
    (-> self owner)))

(defun singlefish-apply-color! ((self singlefish-base))
  (set! (-> self draw color-mult r) (-> self fish-color x))

  (set! (-> self draw color-mult g) (-> self fish-color y))

  (set! (-> self draw color-mult b) (-> self fish-color z))

  (set! (-> self draw color-mult a) (-> self fish-color w))

  (cond
    ((= (-> self prefix) 'golden)
      (set! (-> self draw color-emissive r) 0.22)
      (set! (-> self draw color-emissive g) 0.14)
      (set! (-> self draw color-emissive b) 0.01)
      (set! (-> self draw color-emissive a) 1.0))

    (else
      (set! (-> self draw color-emissive r) 0.0)
      (set! (-> self draw color-emissive g) 0.0)
      (set! (-> self draw color-emissive b) 0.0)
      (set! (-> self draw color-emissive a) 1.0)))

  (none))

(defbehavior singlefish-post singlefish-base () (ja-post))

(defun fisher-debug-line!
  ((start vector)
    (end vector)
    (color rgba))

  (add-debug-line
    #t
    (bucket-id subtitle)
    start
    end
    color
    #f
    color)

  (none)
)

(defun fisher-draw-retail-line-segment!
  ((self fisher-game)
    (world-start vector)
    (world-end vector)
    (color rgba))

  (when
    (and
      (current-frame)
      (-> (current-frame) global-buf))

    (let ((screen-points
          (new 'stack 'vector4w-2))

        (line-colors
          (new 'stack 'vector4w-2))

        (projected-start
          (new 'stack 'vector4w-2))

        (projected-end
          (new 'stack 'vector4w-2))

        (draw-start
          (new 'stack-no-clear 'vector))

        (draw-end
          (new 'stack-no-clear 'vector))

        (camera-forward
          (new 'stack-no-clear 'vector))

        (camera-to-start
          (new 'stack-no-clear 'vector))

        (camera-to-end
          (new 'stack-no-clear 'vector))

        (start-depth 1.0)
        (end-depth 1.0)
        (clip-t 0.0)

        (start-x 32768)
        (start-y 35584)
        (start-z #x00ffffff)
        (end-x 32768)
        (end-y 32428)
        (end-z #x00ffffff))

      (vector-copy! draw-start world-start)
      (vector-copy! draw-end world-end)
      (set! (-> draw-start w) 1.0)
      (set! (-> draw-end w) 1.0)

      (when
        (and
          (fisher-finalboss-zone? self)
          *camera*
          (> (-> *camera* num-slaves) 0))

        (let ((cam-slave (-> *camera* slave 0 0)))
          (vector-copy! camera-forward (-> cam-slave tracking inv-mat vector 2))
          (set! (-> camera-forward w) 0.0)
          (singlefish-vector-normalize-safe! camera-forward 1.0)

          (vector-! camera-to-start draw-start (-> cam-slave trans))
          (vector-! camera-to-end draw-end (-> cam-slave trans))
          (set! start-depth (vector-dot camera-to-start camera-forward))
          (set! end-depth (vector-dot camera-to-end camera-forward))

          (when
            (and
              (< start-depth (meters 0.50))
              (> end-depth (meters 0.50))
              (> (- end-depth start-depth) (meters 0.001)))
            (set!
              clip-t
              (/ (- (meters 0.50) start-depth)
                 (- end-depth start-depth)))
            (set! clip-t (fmax 0.0 (fmin 1.0 clip-t)))
            (vector-lerp! camera-to-start draw-start draw-end clip-t)
            (vector-copy! draw-start camera-to-start)
            (set! (-> draw-start w) 1.0))))

      (transform-point-qword!
        (-> projected-start vector 0)
        draw-start)

      (set! start-x (-> projected-start vector 0 x))
      (set! start-y (-> projected-start vector 0 y))
      (set! start-z (+ (-> projected-start vector 0 z) -8192))

      (set! start-x (max 512 (min 65024 start-x)))
      (set! start-y (max 512 (min 65024 start-y)))

      (when (fisher-finalboss-zone? self)
        (transform-point-qword!
          (-> projected-end vector 0)
          draw-end)

        (set! end-x (-> projected-end vector 0 x))
        (set! end-y (-> projected-end vector 0 y))
        (set! end-z (+ (-> projected-end vector 0 z) -8192))

        (set! end-x (max 512 (min 65024 end-x)))
        (set! end-y (max 512 (min 65024 end-y)))

        (set! start-z (max 1 (min #x00fffffe start-z)))
        (set! end-z (max 1 (min #x00fffffe end-z))))

      (set! (-> line-colors vector 0 x) (the-as int (-> color r)))
      (set! (-> line-colors vector 0 y) (the-as int (-> color g)))
      (set! (-> line-colors vector 0 z) (the-as int (-> color b)))
      (set! (-> line-colors vector 0 w) (the-as int (-> color a)))
      (set! (-> line-colors vector 1 quad) (-> line-colors vector 0 quad))

      (let ((delta-x (- end-x start-x))
          (delta-y (- end-y start-y))
          (delta-z (- end-z start-z)))

        (dotimes (piece 4)
          (set!
            (-> screen-points vector 0 x)
            (+ start-x (/ (* delta-x piece) 4)))

          (set!
            (-> screen-points vector 0 y)
            (+ start-y (/ (* delta-y piece) 4)))

          (set!
            (-> screen-points vector 0 z)
            (+ start-z (/ (* delta-z piece) 4)))

          (set!
            (-> screen-points vector 1 x)
            (+ start-x (/ (* delta-x (+ piece 1)) 4)))

          (set!
            (-> screen-points vector 1 y)
            (+ start-y (/ (* delta-y (+ piece 1)) 4)))

          (set!
            (-> screen-points vector 1 z)
            (+ start-z (/ (* delta-z (+ piece 1)) 4)))

          (set! (-> screen-points vector 0 w) 1)
          (set! (-> screen-points vector 1 w) 1)

          (with-dma-buffer-add-bucket
            ((buf (-> (current-frame) global-buf))
              (bucket-id subtitle))

            (with-cnt-vif-block
              (buf)

              (dma-buffer-add-gif-tag
                buf
                (new 'static
                  'gif-tag64
                  :nloop 1
                  :eop 1
                  :pre 1
                  :nreg 4
                  :prim (gif-prim line))
                (gs-reg-list
                  rgbaq
                  xyzf2
                  rgbaq
                  xyzf2))

              (dma-buffer-add-uint128
                buf
                (-> line-colors quad 0)
                (-> screen-points quad 0)
                (-> line-colors quad 1)
                (-> screen-points quad 1))))))))

  (none))

(defun fisher-draw-retail-line!
  ((self fisher-game)
    (start vector)
    (end vector)
    (color rgba))

  (fisher-draw-retail-line-segment!
    self
    start
    end
    color)

  (none))

(defun fisher-debug-make-point!
  ((dst vector) (owner fisher-game) (axis vector) (side-axis vector) (distance float) (side-offset float) (height float))
  (singlefish-vector-add-scaled-safe! dst (-> owner fishing-player-pos) axis distance)
  (singlefish-vector-add-scaled-safe! dst dst side-axis side-offset)
  (set! (-> dst y) height)
  (set! (-> dst w) 1.0)
  dst)

(defun fisher-debug-draw-rectangle!
  ((owner fisher-game) (axis vector) (side-axis vector) (near-distance float) (far-distance float) (half-width float) (height float) (color rgba))
  (let ((near-left (new 'stack-no-clear 'vector))
      (near-right (new 'stack-no-clear 'vector))
      (far-left (new 'stack-no-clear 'vector))
      (far-right (new 'stack-no-clear 'vector)))
    (fisher-debug-make-point! near-left owner axis side-axis near-distance (- half-width) height)
    (fisher-debug-make-point! near-right owner axis side-axis near-distance half-width height)
    (fisher-debug-make-point! far-left owner axis side-axis far-distance (- half-width) height)
    (fisher-debug-make-point! far-right owner axis side-axis far-distance half-width height)
    (fisher-debug-line! near-left near-right color)
    (fisher-debug-line! far-left far-right color)
    (fisher-debug-line! near-left far-left color)
    (fisher-debug-line! near-right far-right color))
  (none))

(defun fisher-draw-playfield-debug! ((self fisher-game))
  (when *fisher-in-debug?*
    (let ((axis (new 'stack-no-clear 'vector))
        (side-axis (new 'stack-no-clear 'vector))
        (near-distance (meters 3.5))
        (far-distance (fisher-playfield-far-distance self))
        (half-width (meters 1.5))
        (top-height (- (-> self water-level) (meters 3.5)))
        (bottom-height (- (-> self water-level) (meters 35.5)))
        (topwater-height (- (-> self water-level) (meters 11.5)))
        (bottom-feeder-height (- (-> self water-level) (meters 19.5)))
        (deepwater-height (- (-> self water-level) (meters 27.5)))
        (boundary-color (new 'static 'rgba :r #xff :g #x10 :b #x10 :a #xff))
        (topwater-color (new 'static 'rgba :r #x20 :g #xff :b #x40 :a #xff))
        (bottom-feeder-color (new 'static 'rgba :r #xff :g #xd0 :b #x20 :a #xff))
        (deepwater-color (new 'static 'rgba :r #x20 :g #x80 :b #xff :a #xff))
        (nlt (new 'stack-no-clear 'vector))
        (nrt (new 'stack-no-clear 'vector))
        (flt (new 'stack-no-clear 'vector))
        (frt (new 'stack-no-clear 'vector))
        (nlb (new 'stack-no-clear 'vector))
        (nrb (new 'stack-no-clear 'vector))
        (flb (new 'stack-no-clear 'vector))
        (frb (new 'stack-no-clear 'vector)))
      (singlefish-vector-copy-safe! axis (-> self playfield-axis))
      (set! (-> axis y) 0.0)
      (set! (-> axis w) 0.0)
      (singlefish-vector-normalize-safe! axis 1.0)
      (set! (-> side-axis x) (-> axis z))
      (set! (-> side-axis y) 0.0)
      (set! (-> side-axis z) (- (-> axis x)))
      (set! (-> side-axis w) 0.0)
      (singlefish-vector-normalize-safe! side-axis 1.0)
      (fisher-debug-make-point! nlt self axis side-axis near-distance (- half-width) top-height)
      (fisher-debug-make-point! nrt self axis side-axis near-distance half-width top-height)
      (fisher-debug-make-point! flt self axis side-axis far-distance (- half-width) top-height)
      (fisher-debug-make-point! frt self axis side-axis far-distance half-width top-height)
      (fisher-debug-make-point! nlb self axis side-axis near-distance (- half-width) bottom-height)
      (fisher-debug-make-point! nrb self axis side-axis near-distance half-width bottom-height)
      (fisher-debug-make-point! flb self axis side-axis far-distance (- half-width) bottom-height)
      (fisher-debug-make-point! frb self axis side-axis far-distance half-width bottom-height)
      (fisher-debug-line! nlt nrt boundary-color)
      (fisher-debug-line! flt frt boundary-color)
      (fisher-debug-line! nlt flt boundary-color)
      (fisher-debug-line! nrt frt boundary-color)
      (fisher-debug-line! nlb nrb boundary-color)
      (fisher-debug-line! flb frb boundary-color)
      (fisher-debug-line! nlb flb boundary-color)
      (fisher-debug-line! nrb frb boundary-color)
      (fisher-debug-line! nlt nlb boundary-color)
      (fisher-debug-line! nrt nrb boundary-color)
      (fisher-debug-line! flt flb boundary-color)
      (fisher-debug-line! frt frb boundary-color)
      (fisher-debug-draw-rectangle! self axis side-axis near-distance far-distance half-width topwater-height topwater-color)
      (fisher-debug-draw-rectangle! self axis side-axis near-distance far-distance half-width bottom-feeder-height bottom-feeder-color)
      (fisher-debug-draw-rectangle! self axis side-axis near-distance far-distance half-width deepwater-height deepwater-color)))
  (none))

(defun singlefish-draw-debug-marker! ((self singlefish-base))
  (when *fisher-in-debug?*
    (let ((left (new 'stack-no-clear 'vector))
        (right (new 'stack-no-clear 'vector))
        (top (new 'stack-no-clear 'vector))
        (bottom (new 'stack-no-clear 'vector))
        (front (new 'stack-no-clear 'vector))
        (back (new 'stack-no-clear 'vector))
        (color (new 'static 'rgba :r #xff :g #xff :b #xff :a #xff)))
      (singlefish-vector-copy-safe! left (-> self root trans))
      (singlefish-vector-copy-safe! right (-> self root trans))
      (singlefish-vector-copy-safe! top (-> self root trans))
      (singlefish-vector-copy-safe! bottom (-> self root trans))
      (singlefish-vector-copy-safe! front (-> self root trans))
      (singlefish-vector-copy-safe! back (-> self root trans))
      (-! (-> left x) (meters 1.0))
      (+! (-> right x) (meters 1.0))
      (+! (-> top y) (meters 1.0))
      (-! (-> bottom y) (meters 1.0))
      (+! (-> front z) (meters 1.0))
      (-! (-> back z) (meters 1.0))
      (fisher-debug-line! left right color)
      (fisher-debug-line! top bottom color)
      (fisher-debug-line! front back color)))
  (none))

(defun singlefish-set-visible! ((self singlefish-base) (visible? symbol))
  (let ((scale
        (if visible?
          (-> self visual-scale)
          0.0001)))

    (set-vector!
      (-> self root scale)
      scale
      scale
      scale
      1.0))

  (none))

(defun singlefish-roll-prefix! ((self singlefish-base))
  (let ((roll (rand-vu-int-range 0 999)))
    (cond
      ((< roll 280) (set! (-> self prefix) 'stressed))
      ((< roll 540) (set! (-> self prefix) 'malnourished))
      ((< roll 690) (set! (-> self prefix) 'common))
      ((< roll 910) (set! (-> self prefix) 'healthy))
      ((< roll 970) (set! (-> self prefix) 'royal))
      ((< roll 990) (set! (-> self prefix) 'legendary))
      (else (set! (-> self prefix) 'golden))))

  (singlefish-vector-copy-safe! (-> self fish-color) (-> self base-color))

  (when (= (-> self prefix) 'golden) (set-vector! (-> self fish-color) 1.0 0.78 0.08 1.0))

  (none))

(defun singlefish-roll-weight-and-value! ((self singlefish-base))
  (let* ((owner
        (the-as fisher-game (-> self owner)))

      (weight-range
        (max
          1
          (-
            (-> self max-weight-tenths)
            (-> self min-weight-tenths))))

      (weight-ratio 0.0)

      (weight-lbs 0.0)

      (raw-value
        0.0)

      (levels-below
        (-
          (fisher-current-level)
          (-> self level))))

    (set! (-> self weight-tenths) (rand-vu-int-range (-> self min-weight-tenths) (-> self max-weight-tenths)))

    (set! weight-ratio (/ (the float (- (-> self weight-tenths) (-> self min-weight-tenths))) (the float weight-range)))

    (set! weight-lbs (* (the float (-> self weight-tenths)) 0.1))

    (set!
      raw-value
      (*
        (the float (-> self base-orb-value))
        weight-lbs
        (singlefish-prefix-multiplier self)
        (fisher-level-worth-multiplier
          (-> self level)
          (fisher-current-level))))

    (set! (-> self visual-scale) (* (-> self base-scale) (+ 0.88 (* 0.24 weight-ratio))))

    (set!
      (-> self orb-value)
      (if
        (>= levels-below 5)
        (max
          0
          (the int
            (+ raw-value 0.5)))
        (max
          1
          (the int
            (+ raw-value 0.5)))))

    (none)))

(defun singlefish-face-vector! ((self singlefish-base) (forward vector))
  (when *camera*
    (let ((rot
          (new 'stack-no-clear 'matrix))

        (safe-forward (new 'stack-no-clear 'vector))

        (safe-down
          (new 'stack-no-clear 'vector)))

      (singlefish-vector-copy-safe! safe-forward forward)

      (set! (-> safe-forward y) 0.0)
      (set! (-> safe-forward w) 0.0)

      (when
        (> (singlefish-vector-length-safe safe-forward) (meters 0.001))

        (singlefish-vector-normalize-safe! safe-forward (-> self model-forward-sign))

        (singlefish-vector-copy-safe! (-> self forward) safe-forward)

        (singlefish-vector-copy-safe! safe-down (-> *camera* local-down))

        (forward-down->inv-matrix rot safe-forward safe-down)

        (matrix->quaternion
          (-> self root quat)
          rot))))

  (none))

(defun singlefish-get-side-axis! ((self singlefish-base) (side-axis vector))
  (let ((owner
        (the-as fisher-game (-> self owner))))

    (set! (-> side-axis x) (-> owner playfield-axis z))
    (set! (-> side-axis y) 0.0)
    (set! (-> side-axis z) (- (-> owner playfield-axis x)))
    (set! (-> side-axis w) 0.0)

    (singlefish-vector-normalize-safe! side-axis 1.0))

  (none))

(defun singlefish-place-in-zone! ((self singlefish-base))
  (let* ((owner
        (the-as fisher-game (-> self owner)))

      (distance
        (rand-vu-float-range
          (meters 4.0)
          (- (fisher-playfield-far-distance owner) (meters 0.5))))

      (y-offset (rand-vu-float-range (meters 1.0) (meters 2.0)))

      (row-center 0.0)

      (row-bottom 0.0)

      (row-top 0.0)

      (side-axis
        (new 'stack-no-clear 'vector)))

    (when (rand-vu-percent? 0.5) (set! y-offset (- y-offset)))

    (cond
      ((= (-> self tier) 'topwater)
        (set! row-center (- (-> owner water-level) (meters 5.5)))
        (set! row-bottom (- (-> owner water-level) (meters 8.0)))
        (set! row-top (- (-> owner water-level) (meters 3.5))))

      ((= (-> self tier) 'bottom-feeder)
        (set! row-center (- (-> owner water-level) (meters 11.5)))
        (set! row-bottom (- (-> owner water-level) (meters 14.0)))
        (set! row-top (- (-> owner water-level) (meters 8.5))))

      (else
        (set! row-center (- (-> owner water-level) (meters 17.0)))
        (set! row-bottom (- (-> owner water-level) (meters 19.5)))
        (set! row-top (- (-> owner water-level) (meters 14.5)))))

    (set! (-> self home-y) (fmax row-bottom (fmin row-top (+ row-center y-offset))))

    (when
      (= (-> owner location-id) (the-as int (fisher-zone sunken-voltage)))
      (set! (-> self home-y)
        (fmax
          (- (-> owner water-level) (fisher-playfield-max-depth owner))
          (-> self home-y))))

    (set! (-> self lane-offset) (rand-vu-float-range (meters -1.5) (meters 1.5)))

    (set! (-> self direction) (if (rand-vu-percent? 0.5) 1.0 -1.0))

    (set! (-> self left-distance) (meters 3.5))
    (set! (-> self right-distance) (fisher-playfield-far-distance owner))

    (singlefish-vector-add-scaled-safe! (-> self root trans) (-> owner fishing-player-pos) (-> owner playfield-axis) distance)

    (singlefish-get-side-axis! self side-axis)

    (singlefish-vector-add-scaled-safe! (-> self root trans) (-> self root trans) side-axis (-> self lane-offset))

    (set! (-> self root trans y) (-> self home-y))
    (set! (-> self root trans w) 1.0)

    (let ((forward
          (new 'stack-no-clear 'vector)))

      (singlefish-vector-scale-safe! forward (-> owner playfield-axis) (-> self direction))

      (singlefish-face-vector! self forward)))

  (singlefish-set-visible! self #f)
  (none))

(defun singlefish-start-turn! ((self singlefish-base) (new-direction float))
  (set! (-> self turning?) #t)
  (set! (-> self turn-time) 0.0)
  (set! (-> self turn-duration) 0.42)
  (set! (-> self turn-old-direction) (-> self direction))
  (set! (-> self direction) new-direction)
  (set! (-> self turn-side) (if (rand-vu-percent? 0.5) 1.0 -1.0))
  (none))

(defun singlefish-update-turn! ((self singlefish-base) (dt float))
  (let* ((owner
        (the-as fisher-game (-> self owner)))

      (progress (fmin 1.0 (/ (-> self turn-time) (-> self turn-duration))))

      (angle (* (degrees 180.0) progress))

      (forward (new 'stack-no-clear 'vector))

      (side-forward (new 'stack-no-clear 'vector))

      (side-axis
        (new 'stack-no-clear 'vector)))

    (singlefish-vector-scale-safe! forward (-> owner playfield-axis) (* (-> self turn-old-direction) (cos angle)))

    (singlefish-get-side-axis! self side-axis)

    (singlefish-vector-scale-safe! side-forward side-axis (* (-> self turn-side) (sin angle)))

    (singlefish-vector-add-safe! forward forward side-forward)

    (singlefish-face-vector! self forward)

    (+! (-> self turn-time) dt)

    (when (>= (-> self turn-time) (-> self turn-duration))
      (set! (-> self turning?) #f)

      (singlefish-vector-scale-safe! forward (-> owner playfield-axis) (-> self direction))

      (singlefish-face-vector! self forward)))

  (none))

(defun singlefish-should-be-visible? ((self singlefish-base))
  (let ((owner (the-as fisher-game (-> self owner))))
    (and
      (-> owner casted?)
      (or
        (= (-> owner cast-state) 'water-entry)
        (= (-> owner cast-state) 'line-active)))))

(defun singlefish-patrol-step! ((self singlefish-base) (speed-scale float))
  (let* ((owner (the-as fisher-game (-> self owner)))
      (dt (-> *display* seconds-per-frame))
      (from-owner (new 'stack-no-clear 'vector))
      (distance 0.0)
      (current-lane 0.0)
      (wanted-lane 0.0)
      (side-axis (new 'stack-no-clear 'vector)))
    (singlefish-get-side-axis! self side-axis)
    (singlefish-set-visible! self (or *fisher-in-debug?* (singlefish-should-be-visible? self)))
    (cond
      ((-> self turning?) (singlefish-update-turn! self dt))
      (else
        (singlefish-vector-add-scaled-safe!
          (-> self root trans)
          (-> self root trans)
          (-> owner playfield-axis)
          (* (-> self direction) (-> self swim-speed) speed-scale dt))
        (set! (-> self root trans y) (seek (-> self root trans y) (-> self home-y) (* (meters 1.4) dt)))
        (singlefish-vector-sub-safe! from-owner (-> self root trans) (-> owner fishing-player-pos))
        (set! current-lane (vector-dot from-owner side-axis))
        (set! wanted-lane (seek current-lane (-> self lane-offset) (* (meters 1.0) dt)))
        (singlefish-vector-add-scaled-safe! (-> self root trans) (-> self root trans) side-axis (- wanted-lane current-lane))
        (singlefish-vector-sub-safe! from-owner (-> self root trans) (-> owner fishing-player-pos))
        (set! distance (vector-dot from-owner (-> owner playfield-axis)))
        (cond
          ((<= distance (-> self left-distance))
            (singlefish-vector-add-scaled-safe!
              (-> self root trans)
              (-> self root trans)
              (-> owner playfield-axis)
              (- (-> self left-distance) distance))
            (singlefish-start-turn! self 1.0))
          ((>= distance (-> self right-distance))
            (singlefish-vector-add-scaled-safe!
              (-> self root trans)
              (-> self root trans)
              (-> owner playfield-axis)
              (- (-> self right-distance) distance))
            (singlefish-start-turn! self -1.0)))))
    (set! (-> self root trans w) 1.0)
    (singlefish-draw-debug-marker! self))
  (none))

(defun singlefish-can-see-lure? ((self singlefish-base))
  (let* ((owner
        (the-as fisher-game (-> self owner)))

      (nose-pos (new 'stack-no-clear 'vector))

      (to-lure (new 'stack-no-clear 'vector))

      (front-distance 0.0)

      (vertical-distance 0.0)

      (total-distance
        0.0))

    (singlefish-vector-add-scaled-safe! nose-pos (-> self root trans) (-> self forward) (-> self nose-offset))

    (singlefish-vector-sub-safe! to-lure (-> owner lure-pos) nose-pos)

    (set! front-distance (vector-dot to-lure (-> self forward)))

    (set! vertical-distance (fmax (-> to-lure y) (- (-> to-lure y))))

    (set! total-distance (singlefish-vector-length-safe to-lure))

    (when
      (= (-> owner location-id) (the-as int (fisher-zone finalboss-nuclear)))
      (let ((x-distance (fabs (-> to-lure x)))
            (lure-depth (fmax 0.0 (- (-> owner water-level) (-> owner lure-pos y)))))
        (return
          (and
            (= (-> owner cast-state) 'line-active)
            (= (-> owner fish-state) 'free)
            (not (-> owner hooked-fish))
            (>= lure-depth (- *fisher-finalboss-bottom-depth* (meters 2.5)))
            (<= x-distance (meters 18.0))))))

    (and
      (= (-> owner cast-state) 'line-active)
      (= (-> owner fish-state) 'free)
      (not (-> owner hooked-fish))
      (>= front-distance (meters 0.65))
      (<= front-distance (meters 4.5))
      (<= vertical-distance (meters 1.8))
      (<= total-distance (meters 5.0)))))

(defun fisher-play-fish-bite-sound! ()
  (play-sound-file "fish-bite.wav" (the int (-> *setting-control* current sfx-volume)))

  (none))

(defun fisher-play-random-fight-sound! ()
  (if (rand-vu-percent? 0.5)
    (play-sound-file "fish-fighta.wav" (the int (-> *setting-control* current sfx-volume)))
    (play-sound-file "fish-fightb.wav" (the int (-> *setting-control* current sfx-volume)))
  )

  (none))

(defun fisher-play-fish-win-sound! ()
  (play-sound-file "fish-win.wav" (the int (-> *setting-control* current sfx-volume)))

  (none))

(defun singlefish-begin-approach! ((self singlefish-base))
  (let ((owner (the-as fisher-game (-> self owner))))
    (set! (-> owner hooked-fish) self)
    (set!
      (-> self approach-speed)
      (*
        (rand-vu-float-range
          *fisher-approach-speed-min*
          *fisher-approach-speed-max*)
        (if
          (= (-> owner location-id)
            (the-as int (fisher-zone village3-lava)))
          1.40
          1.0)))
    (set! (-> owner fish-state) 'approaching)
    (go-virtual singlefish-approach))

  (none))

(defun singlefish-owner-still-hooked? ((self singlefish-base)) (let ((owner (the-as fisher-game (-> self owner)))) (= (-> owner hooked-fish) self)))

(defun singlefish-pin-nose-to-lure! ((self singlefish-base))
  (let ((owner (the-as fisher-game (-> self owner))))
    (singlefish-vector-add-scaled-safe! (-> self root trans) (-> owner lure-pos) (-> self forward) (- (-> self nose-offset)))

    (set! (-> self root trans w) 1.0))

  (none))

(defun fisher-species-snap-on-bite? ((species int))
  (when
    (and
      (>= species 0)
      (< species *fisher-species-count*))
    (return
      (-> (fisher-species-info-for species) snap-on-bite?)))
  #f)

(defun singlefish-fail-hook! ((self singlefish-base))
  (let* ((owner (the-as fisher-game (-> self owner)))

      (snap-on-bite?
        (fisher-species-snap-on-bite?
          (fisher-fish-species owner (-> owner hooked-fish-slot)))))

    (when (= (-> owner hooked-fish) self) (set! (-> owner hooked-fish) #f) (set! (-> owner fish-state) 'free))

    (cond
      (snap-on-bite?
        (fisher-debug-print-lure-loss! owner "SINGLEFISH SNAP-ON-BITE / SCARED-OFF")
        (fisher-begin-lure-stolen-return! owner))

      (else
        (set! (-> owner fish-message) "SCARED OFF")
        (set! (-> owner fish-message-time) 1.5)))

    (set! (-> self direction) (if (rand-vu-percent? 0.5) 1.0 -1.0))
    (set! (-> self turning?) #f)
    (let ((escape-forward
          (new 'stack-no-clear 'vector)))

      (singlefish-vector-scale-safe! escape-forward (-> owner playfield-axis) (-> self direction))

      (singlefish-face-vector!
        self
        escape-forward))
    (set! (-> self scared-time) 5.0)
    (go-virtual singlefish-scared))

  (none))

(defun singlefish-hook-now! ((self singlefish-base))
  (let ((owner (the-as fisher-game (-> self owner))))
    (when
      (and (= (-> owner hooked-fish) self) (= (-> owner fish-state) 'hook-window))

      (set! (-> owner fish-state) 'reeling)
      (set! (-> self fighting?) #f)
      (set! (-> self next-fight-time) (rand-vu-float-range 1.5 3.5))
      (set! (-> self fight-time) 0.0)
      (set! (-> self fight-phase) 0.0)
      (set! (-> self fight-pull) 0.0)
      (go-virtual singlefish-reeling :proc self)))

  (none))

(defun singlefish-update-fight-rate-limit! ((self singlefish-base) (dt float))
  (when (> (-> self fight-rate-cooldown) 0.0)
    (-! (-> self fight-rate-cooldown) dt)
    (when (<= (-> self fight-rate-cooldown) 0.0)
      (set! (-> self fight-rate-cooldown) 0.0)))

  (when (> (-> self fight-window-time) 0.0)
    (-! (-> self fight-window-time) dt)
    (when (<= (-> self fight-window-time) 0.0)
      (set! (-> self fight-window-time) 0.0)
      (set! (-> self fight-window-count) 0)))

  (none))

(defun singlefish-try-start-fight! ((self singlefish-base))
  (let ((owner (the-as fisher-game (-> self owner))))
    (cond
      ((> (-> self fight-rate-cooldown) 0.0)
        (none))

      ((and (> (-> self fight-window-time) 0.0) (>= (-> self fight-window-count) 3))
        (set! (-> self fight-rate-cooldown) 3.0)
        (set! (-> self fight-window-time) 0.0)
        (set! (-> self fight-window-count) 0)
        (set! (-> self next-fight-time) 3.0))

      (else
        (when (<= (-> self fight-window-time) 0.0)
          (set! (-> self fight-window-time) 8.0)
          (set! (-> self fight-window-count) 0))

        (+! (-> self fight-window-count) 1)
        (fisher-play-random-fight-sound!)
        (set! (-> self fighting?) #t)
        (set! (-> self fight-time) (rand-vu-float-range 2.0 4.0))
        (set! (-> self fight-phase) 0.0)
        (set! (-> self fight-base-y) (-> owner lure-pos y))
        (set! (-> self fight-pull) 0.0))))

  (none))

(defun singlefish-break-line! ((self singlefish-base))
  (let ((owner (the-as fisher-game (-> self owner))))
    (fisher-debug-print-lure-loss! owner "SINGLEFISH LINE BROKEN")
    (fisher-begin-lure-stolen-return! owner)
    (set! (-> self fighting?) #f)
    (set! (-> self direction) (if (rand-vu-percent? 0.5) 1.0 -1.0))
    (set! (-> self turning?) #f)
    (let ((escape-forward
          (new 'stack-no-clear 'vector)))

      (singlefish-vector-scale-safe! escape-forward (-> owner playfield-axis) (-> self direction))

      (singlefish-face-vector!
        self
        escape-forward))
    (set! (-> self scared-time) 5.0)
    (go-virtual singlefish-scared))

  (none))

(defun singlefish-prefix->suffix
  ((self singlefish-base))

  (cond
    ((= (-> self prefix) 'malnourished) 0)
    ((= (-> self prefix) 'stressed) 1)
    ((or
        (= (-> self prefix) 'common)
        (= (-> self prefix) 'healthy))
      2)
    ((= (-> self prefix) 'royal) 4)
    ((= (-> self prefix) 'legendary) 5)
    (else 6)))

(defun singlefish-caught! ((self singlefish-base))
  (let* ((owner
        (the-as fisher-game (-> self owner)))

      (suffix
        (singlefish-prefix->suffix self))

      (catch-xp
        (fisher-calculate-catch-xp
          (-> self level)
          suffix)))

    (fisher-play-fish-win-sound!)
    (set! (-> self caught?) #t)
    (set! (-> self fighting?) #f)

    (set! (-> owner caught-fish-species) 0)
    (set! (-> owner caught-fish-suffix) suffix)
    (fisher-catalog-register-catch! 0 suffix)
    (set! (-> owner caught-fish-level) (-> self level))
    (set! (-> owner caught-weight-tenths) (-> self weight-tenths))
    (set!
      (-> owner caught-orb-value)
      (let ((uncapped-orb-value
            (if
              (string= (-> self species-name) "Lurker Shark")
              (max 1 (the int (+ (/ (the float (-> self orb-value)) 3.0) 0.5)))
              (-> self orb-value))))

        (if
          (fisher-rare-fish? suffix)
          uncapped-orb-value
          (+
            (min 50 uncapped-orb-value)
            (rand-vu-int-range 1 9)))))
    (set! (-> owner caught-fish-xp) (fisher-accepted-xp-amount catch-xp))

    (set! (-> owner fish-state) 'catch-display)
    (set! (-> owner cast-state) 'catch-display)
    (set! (-> owner camera-state) 'before-cast)
    (set! (-> owner casted?) #f)
    (set! (-> owner fish-message) #f)
    (set! (-> owner fish-message-time) 0.0)
    (stop-sound-file "water-waves.wav")
    (fisher-remove-lure-snake! owner)
    (go-virtual singlefish-catch-display))

  (none))

(defun singlefish-update-reeling! ((self singlefish-base))
  (let* ((owner
        (the-as fisher-game (-> self owner)))

      (dt (-> *display* seconds-per-frame))

      (from-owner (new 'stack-no-clear 'vector))

      (forward (new 'stack-no-clear 'vector))

      (horizontal-distance 0.0)

      (saved-y 0.0)

      (top-y (- (-> owner water-level) (meters 3.0)))

      (bottom-y
        (- (-> owner water-level) (fisher-playfield-max-depth owner)))

      (level-speed-mult
        (fisher-level-lure-speed-multiplier))

      (reel-mult
        (*
          level-speed-mult
          (if
            (-> owner tug-line-active?)
            *fisher-tug-line-reel-multiplier*
            1.0))))

    (singlefish-update-fight-rate-limit! self dt)

    (when
      (or (not (singlefish-owner-still-hooked? self)) (!= (-> owner fish-state) 'reeling))
      (set! (-> self scared-time) 5.0)
      (go-virtual singlefish-scared))

    (cond
      ((-> self fighting?)
        (singlefish-vector-copy-safe! forward (-> owner playfield-axis))

        (set! (-> forward y) 0.0)
        (set! (-> forward w) 0.0)

        (singlefish-vector-normalize-safe! forward 1.0)

        (singlefish-face-vector! self forward)

        (-! (-> self fight-time) dt)
        (+! (-> self fight-phase) (* (degrees 285.0) dt))

        (when (< (-> self fight-pull) (meters 2.25))
          (let ((pull-step
                (fmin
                  (* (meters 0.85) dt)
                  (- (meters 2.25) (-> self fight-pull)))))

            (+! (-> self fight-pull) pull-step)

            (singlefish-vector-add-scaled-safe!
              (-> owner lure-pos)
              (-> owner lure-pos)
              (-> owner playfield-axis)
              pull-step)))

        (set! (-> owner lure-pos y) (+ (-> self fight-base-y) (* (meters 0.55) (sin (-> self fight-phase)))))

        (when
          (and
            (not *fisher-in-debug?*)
            (cpad-hold? 0 x))

          (let* ((fish-level
                (-> self level))

              (jak-level
                (fisher-current-level))

              (weight-mult
                (fmax
                  0.45
                  (fmin
                    4.0
                    (/
                      (the float (max 1 (-> self weight-tenths)))
                      15.0)))))

            (fisher-damage-line!
              (*
                45.0
                weight-mult
                (fisher-level-fight-multiplier fish-level jak-level)
                dt))))

        (when *fisher-line-broken?* (singlefish-break-line! self))

        (when (<= (-> self fight-time) 0.0)
          (set! (-> self fighting?) #f)
          (set! (-> self next-fight-time) (rand-vu-float-range 1.5 4.5))))

      (else
        (singlefish-vector-scale-safe! forward (-> owner playfield-axis) -1.0)

        (set! (-> forward y) 0.72)
        (set! (-> forward w) 0.0)

        (singlefish-vector-normalize-safe! forward 1.0)

        (singlefish-face-vector! self forward)

        (-! (-> self next-fight-time) dt)

        (cond
          ((cpad-hold? 0 x)
            (singlefish-vector-add-scaled-safe!
              (-> owner lure-pos)
              (-> owner lure-pos)
              (-> owner playfield-axis)
              (-
                (*
                  (-> owner lure-reel-x-speed)
                  (meters 1.0)
                  reel-mult
                  dt)))

            (+!
              (-> owner lure-pos y)
              (*
                (-> owner lure-reel-y-speed)
                (meters 0.55)
                reel-mult
                dt)))

          (else
            (singlefish-vector-add-scaled-safe!
              (-> owner lure-pos)
              (-> owner lure-pos)
              (-> owner playfield-axis)
              (* (meters 0.10) dt))))

        (singlefish-vector-sub-safe! from-owner (-> owner lure-pos) (-> owner fishing-player-pos))

        (set! horizontal-distance (vector-dot from-owner (-> owner playfield-axis)))

        (when
          (and
            (<= (-> self next-fight-time) 0.0)
            (<= (-> self fight-rate-cooldown) 0.0)
            (> horizontal-distance (meters 5.0)))
          (singlefish-try-start-fight! self))))

    (singlefish-vector-sub-safe! from-owner (-> owner lure-pos) (-> owner pos))

    (set! horizontal-distance (vector-dot from-owner (-> owner playfield-axis)))

    (set! saved-y (-> owner lure-pos y))

    (cond
      ((< horizontal-distance (meters 2.0))
        (singlefish-vector-add-scaled-safe! (-> owner lure-pos) (-> owner fishing-player-pos) (-> owner playfield-axis) (meters 2.0))

        (set! (-> owner lure-pos y) saved-y)
        (set! horizontal-distance (meters 2.0)))

      ((> horizontal-distance (fisher-playfield-far-distance owner))
        (singlefish-vector-add-scaled-safe! (-> owner lure-pos) (-> owner fishing-player-pos) (-> owner playfield-axis) (fisher-playfield-far-distance owner))

        (set! (-> owner lure-pos y) saved-y)
        (set! horizontal-distance (fisher-playfield-far-distance owner))))

    (when (> (-> owner lure-pos y) top-y) (set! (-> owner lure-pos y) top-y))

    (when (< (-> owner lure-pos y) bottom-y) (set! (-> owner lure-pos y) bottom-y))

    (singlefish-pin-nose-to-lure! self)

    (when
      (and (not (-> self fighting?)) (<= horizontal-distance (meters 2.35)) (>= (-> owner lure-pos y) (- (-> owner water-level) (meters 3.15))))
      (singlefish-caught! self)))

  (none))

(defun singlefish-position-catch-model! ((self singlefish-base))
  (let ((owner (the-as fisher-game (-> self owner))))
    (when (and *camera* (> (-> *camera* num-slaves) 0))
      (let* ((cam-slave
            (-> *camera* slave 0 0))

          (forward (new 'stack-no-clear 'vector))

          (right (new 'stack-no-clear 'vector))

          (display-pos (new 'stack-no-clear 'vector))

          (display-scale
            (* (-> self visual-scale) 2.65)))

        (singlefish-vector-sub-safe! forward (-> owner fisher-look) (-> cam-slave trans))

        (set! (-> forward w) 0.0)
        (singlefish-vector-normalize-safe! forward 1.0)

        (singlefish-vector-cross-safe! right forward (-> *camera* local-down))

        (set! (-> right w) 0.0)
        (singlefish-vector-normalize-safe! right 1.0)

        (singlefish-vector-add-scaled-safe! display-pos (-> cam-slave trans) forward (meters 5.0))

        (singlefish-vector-add-scaled-safe! display-pos display-pos (-> *camera* local-down) (meters -1.15))

        (set! (-> display-pos w) 1.0)

        (set! (-> self root trans quad) (-> display-pos quad))

        (singlefish-face-vector! self right)

        (set-vector!
          (-> self root scale)
          display-scale
          display-scale
          display-scale
          1.0))))

  (none))

(defun singlefish-sell! ((self singlefish-base))
  (let ((owner
        (the-as fisher-game
          (-> self owner)))

      (xp-start
        (new 'stack-no-clear 'vector)))

    (when *target*
      (send-event
        *target*
        'get-pickup
        (pickup-type money)
        (the float (-> self orb-value))))

    (vector-copy! xp-start (-> self root trans))
    (set! (-> xp-start w) 1.0)

    (fisher-start-xp-gain-animation!
      xp-start
      (-> owner caught-fish-xp))

    (when
      (<= (-> owner caught-fish-xp) 0)

      (auto-save-command
        'auto-save
        0
        0
        *default-pool*))

    (when (> (-> owner fish-count) 0)
      (-! (-> owner fish-count) 1))

    (set! (-> owner caught-weight-tenths) 0)
    (set! (-> owner caught-orb-value) 0)
    (set! (-> owner caught-fish-level) 1)
    (set! (-> owner caught-fish-xp) 0)

    (fisher-reset-cast! owner)
    (set! (-> owner fish-message) "FISH SOLD")
    (set! (-> owner fish-message-time) 1.25)
    (go-virtual singlefish-dead :proc self))

  (none))

(defun singlefish-set-species-data!
  ((self singlefish-base)
    (species-name string)
    (color-name string)
    (tier symbol)
    (min-weight-tenths int)
    (max-weight-tenths int)
    (base-orb-value int))

  (set! (-> self species-name) species-name)
  (set! (-> self color-name) color-name)
  (set! (-> self tier) tier)
  (set! (-> self min-weight-tenths) min-weight-tenths)
  (set! (-> self max-weight-tenths) max-weight-tenths)
  (set! (-> self base-orb-value) base-orb-value)

  (none))

(defun singlefish-set-model-data!
  ((self singlefish-base) (base-scale float) (swim-speed float) (nose-offset float) (model-forward-sign float) (color vector))

  (set! (-> self base-scale) base-scale)
  (set! (-> self visual-scale) base-scale)
  (set! (-> self swim-speed) (* swim-speed (rand-vu-float-range 0.70 1.35)))

  (set! (-> self nose-offset) nose-offset)
  (set! (-> self model-forward-sign) model-forward-sign)

  (singlefish-vector-copy-safe! (-> self base-color) color)
  (singlefish-vector-copy-safe! (-> self fish-color) color)

  (none))

(defun singlefish-initialize!
  ((self singlefish-base) (owner (pointer fisher-game)) (skel-group skeleton-group))

  (set! (-> self owner) owner)
  (set!
    (-> self level)
    (fisher-roll-level-in-range
      (-> (the-as fisher-game owner) fish-level-min)
      (-> (the-as fisher-game owner) fish-level-max)))
  (set! (-> self turning?) #f)
  (set! (-> self turn-time) 0.0)
  (set! (-> self turn-duration) 0.42)
  (set! (-> self turn-old-direction) 1.0)
  (set! (-> self turn-side) 1.0)
  (set! (-> self hook-time) 0.0)
  (set! (-> self scared-time) 0.0)
  (set! (-> self next-fight-time) 0.0)
  (set! (-> self fight-window-time) 0.0)
  (set! (-> self fight-window-count) 0)
  (set! (-> self fight-rate-cooldown) 0.0)
  (set! (-> self fight-time) 0.0)
  (set! (-> self fight-phase) 0.0)
  (set! (-> self fight-base-y) 0.0)
  (set! (-> self fight-pull) 0.0)
  (set! (-> self fighting?) #f)
  (set! (-> self caught?) #f)
  (set! (-> self session-id) *singlefish-session-id*)

  (singlefish-vector-reset-safe! (-> self forward))

  (initialize-skeleton self skel-group '())

  (logior! (-> self skel status) (janim-status inited))

  (singlefish-roll-prefix! self)
  (singlefish-roll-weight-and-value! self)
  (singlefish-place-in-zone! self)
  (singlefish-apply-color! self)
  (singlefish-draw-debug-marker! self)

  (logclear! (-> self mask) (process-mask actor-pause))

  (go-virtual singlefish-patrol)
  (none))

(defbehavior singlefish-base-init-by-other singlefish-base ()
  (singlefish-set-species-data! self "FishA" "Blue-Green" 'topwater 10 20 1)

  (singlefish-set-model-data! self 0.30 (meters 1.20) (meters 0.42) 1.0 (new 'static 'vector :x 0.35 :y 0.90 :z 0.80 :w 1.0))

  (singlefish-initialize!
    self
    *fisher-game*
    *catch-fisha-sgc*))

(defbehavior eco-drum-init-by-other eco-drum
  ((owner (pointer fisher-game)))

  (singlefish-set-species-data! self "Eco Drum" "Eco Teal" 'topwater 10 20 1)

  (singlefish-set-model-data! self 0.30 (meters 1.20) (meters 0.42) 1.0 (new 'static 'vector :x 0.25 :y 0.88 :z 1.00 :w 1.0))

  (singlefish-initialize!
    self
    owner
    *catch-fisha-sgc*))

(defun fisher-smoothstep ((value float)) (* value value (- 3.0 (* 2.0 value))))

(defun fisher-catch-display-fish-position!
  ((self fisher-game) (dst vector))

  (let ((camera-forward
        (new 'stack-no-clear 'vector)))

    (singlefish-vector-sub-safe! camera-forward (-> self fisher-look) (-> self fisher-cam))

    (singlefish-vector-normalize-safe! camera-forward 1.0)

    (singlefish-vector-add-scaled-safe! dst (-> self fisher-cam) camera-forward (meters 5.0))

    (let ((fish-menu-offset
          (if
            (and
              (fisher-rare-fish? (-> self caught-fish-suffix))
              (or
                (= (-> self fish-state) 'catch-exit)
                (= (-> self fish-state) 'rare-enter)
                (= (-> self fish-state) 'rare-display)))
            0.0
            (-> self catch-menu-offset))))

      (+!
        (-> dst y)
        (+
          (meters 1.28)
          (* (meters -0.030) fish-menu-offset))))

    (set! (-> dst w) 1.0))

  dst)

(defun fisher-spawn-catch-display-fish! ((self fisher-game))
  (let ((slot
        (-> self hooked-fish-slot))

      (pos (new 'stack-no-clear 'vector))

      (fish
        (the-as (pointer manipy) #f)))

    (when (>= slot 0)
      (fisher-set-fish-species! self slot (-> self caught-fish-species))

      (fisher-set-fish-suffix! self slot (-> self caught-fish-suffix))

      (fisher-catch-display-fish-position! self pos)

      (set!
        fish
        (the-as
          (pointer manipy)
          (manipy-spawn
            pos
            #f
            (fisher-display-skeleton-for
              (-> self caught-fish-species)
              (-> self caught-fish-suffix))
            #f
            :from *default-dead-pool*
            :to *default-pool*
            :name "fisher-catch-display-fish")))

      (fisher-set-fish-pointer! self slot fish)

      (when fish
        (let ((fish-proc
              (the-as manipy
                (-> fish 0 self))))

          (send-event fish-proc 'anim-mode 'loop)
          (fisher-randomize-manipy-anim-frame! fish-proc)

          (send-event fish-proc 'max-vis-dist (meters 999999.0))

          (set! (-> fish-proc root trans quad) (-> pos quad))

          (fisher-apply-slot-appearance!
            self
            slot
            fish-proc
            #t)

          (fisher-spawn-rare-fish-attachments!
            fish-proc
            (-> self caught-fish-suffix)
            #t)

          (when
            (= (-> self location-id) (the-as int (fisher-zone snow-ice)))
            (fisher-spawn-snow-ice-crystal!
              fish-proc
              (-> self caught-fish-species)
              #t))))))

  (none))

(defun fisher-update-catch-return! ((self fisher-game))
  (let* ((dt
        (-> *display* seconds-per-frame))

      (slot (-> self hooked-fish-slot))

      (fish
        (if
          (>= slot 0)
          (fisher-fish-pointer self slot)
          (the-as (pointer manipy) #f)))

      (catch-target (new 'stack-no-clear 'vector))
      (delta (new 'stack-no-clear 'vector))
      (surface-y (+ (-> self water-level) (meters 0.65)))
      (distance 0.0)
      (surfaced? #f))

    (+! (-> self catch-transition-time) dt)

    (when
      (and *camera* (> (-> *camera* num-slaves) 0))

      (let* ((cam-slave
            (-> *camera* slave 0 0))

          (camera-blend (fmin 1.0 (* dt 3.2)))

          (camera-pos (new 'stack-no-clear 'vector))
          (camera-forward (new 'stack-no-clear 'vector)))

        (vector-lerp!
          camera-pos
          (-> cam-slave trans)
          (-> self fisher-cam)
          camera-blend)

        (set! (-> cam-slave saved-pt quad) (-> camera-pos quad))
        (set! (-> cam-slave trans quad) (-> camera-pos quad))

        (vector-! camera-forward (-> self fisher-look) camera-pos)

        (when
          (> (singlefish-vector-length-safe camera-forward) (meters 0.001))

          (singlefish-vector-normalize-safe! camera-forward 1.0)

          (forward-down->inv-matrix
            (-> cam-slave tracking inv-mat)
            camera-forward
            (-> *camera* local-down)))))

    (when fish
      (let ((fish-proc
            (the-as manipy
              (-> fish 0 self))))

        (set! surfaced?
          (>=
            (-> fish-proc root trans y)
            (- surface-y (meters 0.08))))

        (cond
          (surfaced?
            (vector-copy! catch-target (target-pos 0))
            (+! (-> catch-target y) (meters 1.15)))

          (else
            (vector-copy! catch-target (-> fish-proc root trans))
            (set! (-> catch-target y) surface-y)
            (set! (-> catch-target w) 1.0)))

        (vector-! delta catch-target (-> fish-proc root trans))
        (set! distance (singlefish-vector-length-safe delta))

        (when (> distance (meters 0.001))
          (singlefish-vector-normalize-safe!
            delta
            (fmin
              distance
              (*
                (if surfaced? (meters 12.0) (meters 18.0))
                dt)))

          (vector+!
            (-> fish-proc root trans)
            (-> fish-proc root trans)
            delta))

        (when
          (or
            (and surfaced? (<= distance (meters 0.30)))
            (>= (-> self catch-transition-time) 4.5))

          (fisher-destroy-manipy! fish)
          (fisher-set-fish-pointer! self slot (the-as (pointer manipy) #f))
          (fisher-spawn-catch-display-fish! self)

          (set! (-> self fish-state) 'catch-enter)
          (set! (-> self cast-state) 'catch-display)
          (set! (-> self catch-transition-time) 0.0)
          (set! (-> self catch-menu-offset) 150.0)))))

  (none))

(defun fisher-finish-buzzer-catch-menu! ((self fisher-game))
  (let* ((slot (-> self hooked-fish-slot))
      (fish
        (if
          (>= slot 0)
          (fisher-fish-pointer self slot)
          (the-as (pointer manipy) #f))))

    (when fish
      (fisher-destroy-manipy! fish))

    (when (>= slot 0)
      (fisher-set-fish-pointer!
        self
        slot
        (the-as (pointer manipy) #f)))

    (set! (-> self hooked-fish-slot) -1)
    (set! (-> self fish-state) 'free)
    (set! (-> self fish-message) "SCOUT FLY CAUGHT")
    (set! (-> self fish-message-time) 1.25)
    (set! (-> self caught-weight-tenths) 0)
    (set! (-> self caught-orb-value) 0)
    (set! (-> self caught-fish-level) 1)
    (set! (-> self caught-fish-xp) 0)
    (set! (-> self catch-transition-time) 0.0)
    (set! (-> self catch-menu-offset) 0.0)

    (cond
      ((-> self buzzer-victory-pending?)
        (set! (-> self cast-state) 'buzzer-exit))

      (else
        (when (>= slot 0)
          (fisher-set-fish-species! self slot 0)
          (fisher-set-fish-power-cell-task! self slot 0)
          (fisher-randomize-fish-slot! self slot))

        (let ((active-buzzer-count 0))
          (dotimes (fish-slot (-> self fish-count))
            (when (= (fisher-fish-species self fish-slot) 4)
              (+! active-buzzer-count 1)))

          (when (= active-buzzer-count 0)
            (fisher-add-buzzer-fish-slots! self)))

        (set! (-> self caught-buzzer-count) 0)
        (set! (-> self caught-buzzer-task) 0)
        (fisher-reset-cast! self))))

  (none))

(defun fisher-sell-manipy-catch!
  ((self fisher-game))

  (cond
    ((= (-> self caught-fish-species) 4)
      (fisher-finish-buzzer-catch-menu! self))

    (else
      (let ((carrier?
            (> (-> self caught-power-cell-task) 1)))

        (when *target*
          (send-event
            *target*
            'get-pickup
            (pickup-type money)
            (the float (-> self caught-orb-value))))

        (let ((slot
              (-> self hooked-fish-slot))

            (xp-start
              (new 'stack-no-clear 'vector)))

          (fisher-catch-display-fish-position! self xp-start)

          (when (>= slot 0)
            (let ((fish
                  (fisher-fish-pointer
                    self
                    slot)))

              (when fish
                (let ((fish-proc
                      (the-as manipy
                        (-> fish 0 self))))

                  (vector-copy!
                    xp-start
                    (-> fish-proc root trans))

                  (set! (-> xp-start w) 1.0))

                (fisher-destroy-manipy! fish))

              (fisher-set-fish-pointer!
                self
                slot
                (the-as (pointer manipy) #f))

              (fisher-set-fish-power-cell-task! self slot 0)

              (when
                (= (-> self caught-fish-species)
                  (the-as int (fisher-species fire-canyon-cellfish)))

                (fisher-set-fish-species!
                  self
                  slot
                  (fisher-default-species-for-location self))
                (fisher-set-fish-suffix! self slot 2))

              (fisher-randomize-fish-slot!
                self
                slot)))

          (unless carrier?
            (fisher-add-power-cell-fish-slot! self)
            (fisher-add-fire-canyon-cellfish-slot! self)
            (fisher-add-mountain-pass-cellfish-slots! self))

          (fisher-start-xp-gain-animation!
            xp-start
            (-> self caught-fish-xp))

          (when
            (and
              (not carrier?)
              (<= (-> self caught-fish-xp) 0))

            (auto-save-command
              'auto-save
              0
              0
              *default-pool*)))

        (set! (-> self hooked-fish-slot) -1)
        (set! (-> self fish-state) 'free)
        (set! (-> self fish-message) (if carrier? #f "FISH SOLD"))
        (set! (-> self fish-message-time) (if carrier? 0.0 1.25))
        (set! (-> self caught-weight-tenths) 0)
        (set! (-> self caught-orb-value) 0)
        (set! (-> self caught-fish-suffix) 2)
        (set! (-> self caught-fish-level) 1)
        (set! (-> self caught-fish-xp) 0)
        (set! (-> self catch-transition-time) 0.0)
        (set! (-> self catch-menu-offset) 0.0)

        (fisher-reset-cast! self)

        (when carrier?
          (set! (-> self power-cell-victory-pending?) #t)
          (set! (-> self cast-state) 'power-cell-ui-wait)))))

  (none))

(defun fisher-submit-forgotten-catch-particles! ((self fisher-game))
  (when
    (and
      (= (-> self caught-fish-suffix) 8)
      (or
        (= (-> self fish-state) 'catch-enter)
        (= (-> self fish-state) 'catch-display)
        (= (-> self fish-state) 'catch-exit))
      (zero? (mod (current-time) 6))
      (>= (-> self hooked-fish-slot) 0))
    (let ((fish (fisher-fish-pointer self (-> self hooked-fish-slot))))
      (when fish
        (let ((fish-proc (-> fish 0 self)))
          (when fish-proc
            (launch-particles
              :system *sp-particle-system-3d*
              (-> *part-id-table* 3569)
              (-> (the-as manipy fish-proc) root trans)))))))
  (none))

(defun fisher-update-catch-menu-animation! ((self fisher-game))
  (let ((dt
        (-> *display* seconds-per-frame)))

    (+! (-> self catch-transition-time) dt)

    (fisher-submit-forgotten-catch-particles! self)

    (cond
      ((or
          (= (-> self fish-state) 'catch-enter)
          (= (-> self fish-state) 'rare-enter))

        (let* ((duration 0.65)
            (progress (fmin 1.0 (/ (-> self catch-transition-time) duration)))
            (ease (fisher-smoothstep progress))
            (bounce
              (*
                10.0
                (sin (* (degrees 540.0) progress))
                (- 1.0 progress))))

          (set! (-> self catch-menu-offset)
            (+ (* 150.0 (- 1.0 ease)) bounce))

          (when (>= progress 1.0)
            (set! (-> self catch-menu-offset) 0.0)
            (set! (-> self catch-transition-time) 0.0)
            (set!
              (-> self fish-state)
              (if
                (= (-> self fish-state) 'rare-enter)
                'rare-display
                'catch-display)))))

      ((or
          (= (-> self fish-state) 'catch-exit)
          (= (-> self fish-state) 'rare-exit))

        (let* ((duration 0.48)
            (progress (fmin 1.0 (/ (-> self catch-transition-time) duration)))
            (ease (fisher-smoothstep progress)))

          (set! (-> self catch-menu-offset) (* 150.0 ease))

          (when (>= progress 1.0)
            (cond
              ((and
                  (= (-> self fish-state) 'rare-exit)
                  (= (-> self caught-fish-species) (the-as int (fisher-species nuclear-bombfish))))
                (fisher-finalboss-finish-catch-card! self))

              ((and
                  (= (-> self fish-state) 'catch-exit)
                  (or
                    (= (-> self caught-fish-species) (the-as int (fisher-species nuclear-bombfish)))
                    (fisher-rare-fish? (-> self caught-fish-suffix))))

                (set! (-> self fish-state) 'rare-enter)
                (set! (-> self catch-transition-time) 0.0)
                (set! (-> self catch-menu-offset) 150.0))

              (else
                (fisher-sell-manipy-catch! self))))))))

  (none))

(defun fisher-draw-manipy-fish-marker!
  ((fish (pointer manipy)))

  (when
    (and *fisher-in-debug?* fish)

    (let ((fish-proc
          (-> fish 0 self)))

      (when fish-proc
        (let ((left (new 'stack-no-clear 'vector))
            (right (new 'stack-no-clear 'vector))
            (top (new 'stack-no-clear 'vector))
            (bottom (new 'stack-no-clear 'vector))
            (front (new 'stack-no-clear 'vector))
            (back (new 'stack-no-clear 'vector))
            (color
              (new 'static
                'rgba
                :r #xff
                :g #xff
                :b #xff
                :a #xff)))

          (singlefish-vector-copy-safe! left (-> (the-as manipy fish-proc) root trans))

          (singlefish-vector-copy-safe! right (-> (the-as manipy fish-proc) root trans))

          (singlefish-vector-copy-safe! top (-> (the-as manipy fish-proc) root trans))

          (singlefish-vector-copy-safe! bottom (-> (the-as manipy fish-proc) root trans))

          (singlefish-vector-copy-safe! front (-> (the-as manipy fish-proc) root trans))

          (singlefish-vector-copy-safe! back (-> (the-as manipy fish-proc) root trans))

          (-! (-> left x) (meters 1.0))
          (+! (-> right x) (meters 1.0))
          (+! (-> top y) (meters 1.0))
          (-! (-> bottom y) (meters 1.0))
          (+! (-> front z) (meters 1.0))
          (-! (-> back z) (meters 1.0))

          (fisher-debug-line! left right color)
          (fisher-debug-line! top bottom color)
          (fisher-debug-line! front back color)))))

  (none))

(defun fisher-hook-target!
  ((self fisher-game) (dst vector))

  (cond
    ((-> self lure-snake) (singlefish-vector-copy-safe! dst (-> (the-as manipy (-> (-> self lure-snake) 0 self)) root trans)))

    (else
      (singlefish-vector-copy-safe!
        dst
        (-> self lure-pos))))

  (set! (-> dst w) 1.0)
  dst)

(defun fisher-camera-catch-display!
  ((self fisher-game))

  (when
    (and *camera* (> (-> *camera* num-slaves) 0))

    (let ((cam-slave
          (-> *camera* slave 0 0))

        (forward
          (new 'stack-no-clear 'vector)))

      (set! (-> cam-slave saved-pt quad) (-> self fisher-cam quad))

      (set! (-> cam-slave trans quad) (-> self fisher-cam quad))

      (vector-! forward (-> self fisher-look) (-> self fisher-cam))

      (when
        (> (singlefish-vector-length-safe forward) (meters 0.001))

        (vector-normalize! forward 1.0)

        (forward-down->inv-matrix
          (-> cam-slave tracking inv-mat)
          forward
          (-> *camera* local-down)))))

  (none))

(defun fisher-hooked-fish-mouth-offset
  ((self fisher-game))

  (cond
    ((< (-> self hooked-fish-slot) 0) (meters 0.42))

    ((= (fisher-fish-species self (-> self hooked-fish-slot)) 1) (meters 0.55))

    ((= (fisher-fish-species self (-> self hooked-fish-slot)) 2) (meters 0.48))

    ((= (fisher-fish-species self (-> self hooked-fish-slot)) 3) (meters 1.20))

    ((=
        (fisher-fish-species self (-> self hooked-fish-slot))
        (the-as int (fisher-species black-lurker-shark)))
      (meters 0.70))

    ((=
        (fisher-fish-species self (-> self hooked-fish-slot))
        (the-as int (fisher-species helix-voidfish)))
      (meters 0.78))

    ((=
        (fisher-fish-species self (-> self hooked-fish-slot))
        (the-as int (fisher-species phantasm-shark)))
      (meters 1.05))

    ((=
        (fisher-fish-species self (-> self hooked-fish-slot))
        (the-as int (fisher-species megaloviathan)))
      (meters 5.60))

    (else
      (meters 0.42))))

(defun fisher-begin-hook-transition!
  ((self fisher-game) (fish-proc manipy) (hook-pos vector))

  (let ((facing
        (new 'stack-no-clear 'vector))

      (mouth-pos (new 'stack-no-clear 'vector))

      (mouth-offset
        (fisher-hooked-fish-mouth-offset self)))

    (singlefish-vector-sub-safe! facing hook-pos (-> fish-proc root trans))

    (set! (-> facing w) 0.0)

    (when
      (<= (singlefish-vector-length-safe facing) 0.001)

      (singlefish-vector-scale-safe!
        facing
        (-> self playfield-axis)
        -1.0))

    (singlefish-vector-normalize-safe! facing 1.0)

    (singlefish-vector-copy-safe! (-> self hooked-fish-facing) facing)

    (singlefish-vector-add-scaled-safe! mouth-pos (-> fish-proc root trans) facing mouth-offset)

    (singlefish-vector-copy-safe!
      (-> self hooked-fish-last-hook-pos)
      mouth-pos))

  (none))

(defun fisher-animate-hooked-fish!
  ((self fisher-game) (fish-proc manipy) (hook-pos vector) (fighting? symbol))

  (let ((target-facing
        (new 'stack-no-clear 'vector))

      (smoothed-facing (new 'stack-no-clear 'vector))

      (side-axis (new 'stack-no-clear 'vector))

      (active-hook (new 'stack-no-clear 'vector))

      (root-pos (new 'stack-no-clear 'vector))

      (down (new 'stack-no-clear 'vector))

      (rot (new 'stack-no-clear 'matrix))

      (dt (-> *display* seconds-per-frame))

      (face-blend 0.0)

      (hook-blend 1.0)

      (turn-angle 0.0)

      (fight-pitch 0.0)

      (mouth-offset
        (fisher-hooked-fish-mouth-offset self)))

    (set! (-> side-axis x) (-> (-> self playfield-axis) z))

    (set! (-> side-axis y) 0.0)

    (set! (-> side-axis z) (- (-> (-> self playfield-axis) x)))

    (set! (-> side-axis w) 0.0)

    (singlefish-vector-normalize-safe! side-axis 1.0)

    (cond
      ((and fighting? (fisher-finalboss-zone? self))
        (singlefish-vector-scale-safe! target-facing (-> self playfield-axis) -0.16)
        (set! (-> target-facing y) -1.0))

      (fighting?
        (set! turn-angle (fmin (degrees 180.0) (-> self fish-fight-phase)))

        (singlefish-vector-scale-safe! target-facing (-> self playfield-axis) (- (cos turn-angle)))

        (singlefish-vector-add-scaled-safe! target-facing target-facing side-axis (sin turn-angle))

        (when
          (>= (-> self fish-fight-phase) (degrees 180.0))

          (set!
            fight-pitch
            (*
              0.28
              (sin
                (-
                  (-> self fish-fight-phase)
                  (degrees 180.0))))))

        (set!
          (-> target-facing y)
          fight-pitch))

      (else
        (cond
          ((> (-> self fish-fight-phase) 0.0)
            (-! (-> self fish-fight-phase) (* (degrees 360.0) dt))

            (when
              (< (-> self fish-fight-phase) 0.0)

              (set!
                (-> self fish-fight-phase)
                0.0))

            (set! turn-angle (-> self fish-fight-phase))

            (singlefish-vector-scale-safe! target-facing (-> self playfield-axis) (- (cos turn-angle)))

            (singlefish-vector-add-scaled-safe! target-facing target-facing side-axis (sin turn-angle))

            (set!
              (-> target-facing y)
              0.0))

          (else
            (singlefish-vector-scale-safe! target-facing (-> self playfield-axis) -1.0)

            (set!
              (-> target-facing y)
              0.72)))))

    (set! (-> target-facing w) 0.0)

    (singlefish-vector-normalize-safe! target-facing 1.0)

    (set! face-blend (fmin 1.0 (* dt 6.5)))

    (set! (-> smoothed-facing x) (+ (-> (-> self hooked-fish-facing) x) (* (- (-> target-facing x) (-> (-> self hooked-fish-facing) x)) face-blend)))

    (set! (-> smoothed-facing y) (+ (-> (-> self hooked-fish-facing) y) (* (- (-> target-facing y) (-> (-> self hooked-fish-facing) y)) face-blend)))

    (set! (-> smoothed-facing z) (+ (-> (-> self hooked-fish-facing) z) (* (- (-> target-facing z) (-> (-> self hooked-fish-facing) z)) face-blend)))

    (set! (-> smoothed-facing w) 0.0)

    (singlefish-vector-normalize-safe! smoothed-facing 1.0)

    (singlefish-vector-copy-safe! (-> self hooked-fish-facing) smoothed-facing)

    (when
      (= (-> self fish-state) 'hook-window)

      (set!
        hook-blend
        (fmin
          1.0
          (* dt 7.5))))

    (set!
      (-> active-hook x)
      (+
        (-> (-> self hooked-fish-last-hook-pos) x)
        (*
          (- (-> hook-pos x) (-> (-> self hooked-fish-last-hook-pos) x))
          hook-blend)))

    (set!
      (-> active-hook y)
      (+
        (-> (-> self hooked-fish-last-hook-pos) y)
        (*
          (- (-> hook-pos y) (-> (-> self hooked-fish-last-hook-pos) y))
          hook-blend)))

    (set!
      (-> active-hook z)
      (+
        (-> (-> self hooked-fish-last-hook-pos) z)
        (*
          (- (-> hook-pos z) (-> (-> self hooked-fish-last-hook-pos) z))
          hook-blend)))

    (set! (-> active-hook w) 1.0)

    (singlefish-vector-copy-safe! (-> self hooked-fish-last-hook-pos) active-hook)

    (singlefish-vector-add-scaled-safe! root-pos active-hook smoothed-facing (- mouth-offset))

    (set! (-> fish-proc root trans quad) (-> root-pos quad))

    (set-vector! down 0.0 -1.0 0.0 0.0)

    (forward-down->inv-matrix rot smoothed-facing down)

    (matrix->quaternion
      (-> fish-proc root quat)
      rot))

  (none))

(defun fisher-show-lure-skill-message!
  ((self fisher-game) (message string))
  (set! (-> self skill-message) message)
  (set! (-> self skill-message-time) 1.10)
  (none))

(defun fisher-update-ability-cooldowns! ((self fisher-game))
  (let ((dt (-> *display* seconds-per-frame)))
    (when *fisher-in-debug?*
      (set! (-> self lure-stop-cooldown) 0.0)
      (set! (-> self lure-sink-cooldown) 0.0)
      (set! (-> self tug-line-cooldown) 0.0)
      (set! (-> self rip-line-cooldown) 0.0)
      (set! (-> self heal-line-cooldown) 0.0)
      (set! (-> self lure-stop-used?) #f)
      (set! (-> self lure-sink-used?) #f))
    (when (> (-> self lure-stop-cooldown) 0.0)
      (-! (-> self lure-stop-cooldown) dt)

      (when (<= (-> self lure-stop-cooldown) 0.0)
        (set! (-> self lure-stop-cooldown) 0.0)
        (set! (-> self lure-stop-used?) #f)))

    (when (> (-> self lure-sink-cooldown) 0.0)
      (-! (-> self lure-sink-cooldown) dt)

      (when (<= (-> self lure-sink-cooldown) 0.0)
        (set! (-> self lure-sink-cooldown) 0.0)
        (set! (-> self lure-sink-used?) #f)))

    (when (> (-> self tug-line-cooldown) 0.0)
      (-! (-> self tug-line-cooldown) dt)

      (when (<= (-> self tug-line-cooldown) 0.0)
        (set! (-> self tug-line-cooldown) 0.0)))

    (when (> (-> self rip-line-cooldown) 0.0)
      (-! (-> self rip-line-cooldown) dt)

      (when (<= (-> self rip-line-cooldown) 0.0)
        (set! (-> self rip-line-cooldown) 0.0)))

    (when (> (-> self heal-line-cooldown) 0.0)
      (-! (-> self heal-line-cooldown) dt)

      (when (<= (-> self heal-line-cooldown) 0.0)
        (set! (-> self heal-line-cooldown) 0.0)))

    (when
      (and
        (or *fisher-in-debug?* (>= (fisher-current-level) *fisher-heal-line-unlock-level*))
        (-> self casted?)
        (= (-> self cast-state) 'line-active)
        (< *fisher-line-hp* *fisher-line-hp-max*)
        (<= (-> self heal-line-cooldown) 0.0)
        (cpad-pressed? 0 r2))

      (cpad-clear! 0 r2)
      (set!
        *fisher-line-hp*
        (fmin *fisher-line-hp-max* (+ *fisher-line-hp* *fisher-heal-line-amount*)))
      (set! *fisher-line-broken?* #f)
      (set! (-> self heal-line-cooldown) *fisher-heal-line-cooldown-seconds*)
      (play-sound-file "bwoop.wav" (the int (-> *setting-control* current sfx-volume)))
      (fisher-show-lure-skill-message! self "HEAL LINE"))

    (when
      (and
        (or *fisher-in-debug?* (>= (fisher-current-level) *fisher-rip-line-unlock-level*))
        (= (-> self fish-state) 'reeling)
        (>= (-> self hooked-fish-slot) 0)
        (-> self fish-fighting?)
        (not (-> self button-fight-data active?))
        (<= (-> self rip-line-cooldown) 0.0)
        (cpad-pressed? 0 circle))

      (cpad-clear! 0 circle)
      (set! (-> self fish-fighting?) #f)
      (set! (-> self fish-fight-time) 0.0)
      (set! (-> self fish-hook-time) *fisher-rip-line-suppress-seconds*)
      (set! (-> self fish-fight-phase) (degrees 180.0))
      (fisher-clear-button-fight! self)
      (set! (-> self rip-line-cooldown) *fisher-rip-line-cooldown-seconds*)
      (play-sound-file "bwoop.wav" (the int (-> *setting-control* current sfx-volume)))
      (fisher-show-lure-skill-message! self "TUG LINE"))

    (when
      (and
        (or *fisher-in-debug?* (>= (fisher-current-level) *fisher-tug-line-unlock-level*))
        (= (-> self fish-state) 'reeling)
        (not (-> self fish-fighting?))
        (not (-> self button-fight-data active?))
        (<= (-> self tug-line-cooldown) 0.0)
        (not (-> self tug-line-active?))
        (cpad-pressed? 0 l1))

      (cpad-clear! 0 l1)
      (set! (-> self tug-line-active?) #t)
      (set! (-> self tug-line-time) *fisher-tug-line-active-seconds*)
      (set! (-> self tug-line-cooldown) *fisher-tug-line-cooldown-seconds*)
      (play-sound-file "bwoop.wav" (the int (-> *setting-control* current sfx-volume)))
      (fisher-show-lure-skill-message! self "FAST REEL"))

    (when
      (-> self tug-line-active?)

      (-! (-> self tug-line-time) dt)

      (when
        (or
          (<= (-> self tug-line-time) 0.0)
          (!= (-> self fish-state) 'reeling))

        (set! (-> self tug-line-active?) #f)
        (set! (-> self tug-line-time) 0.0))))

  (none))

(defun fisher-draw-cooldown-segment!
  ((slot int) (skill-count int) (ready-ratio float) (fill-color rgba))

  (when
    (and
      (> skill-count 0)
      (>= slot 0)
      (< slot skill-count)
      (current-frame)
      (-> (current-frame) global-buf))

    (let* ((total-width 276)
        (segment-width
          (max
            1
            (the int
              (/
                (the float total-width)
                (the float skill-count)))))
        (segment-x (+ 118 (* slot segment-width)))
        (fill-width
          (the int
            (*
              (the float segment-width)
              (fmax 0.0 (fmin 1.0 ready-ratio))))))

      (with-dma-buffer-add-bucket
        ((buf (-> (current-frame) global-buf))
          (bucket-id subtitle))

        (draw-sprite2d-xy
          buf segment-x 200 segment-width 3
          (new 'static 'rgba
            :r #x10 :g #x18 :b #x20 :a #xd0))

        (when (> fill-width 0)
          (draw-sprite2d-xy
            buf segment-x 200 fill-width 3 fill-color))

        (when (> slot 0)
          (draw-sprite2d-xy
            buf (- segment-x 1) 200 1 3
            (new 'static 'rgba
              :r #x08 :g #x08 :b #x08 :a #xe0))))))

  (none))

(defun fisher-draw-skill-cooldowns! ((self fisher-game))
  (when
    (and
      (or *fisher-in-debug?* (>= (fisher-current-level) *fisher-stop-lure-unlock-level*))
      (current-frame)
      (-> (current-frame) global-buf))

    (let* ((level (fisher-current-level))
        (skill-count
          (cond
            ((>= level *fisher-heal-line-unlock-level*) 5)
            ((>= level *fisher-rip-line-unlock-level*) 4)
            ((>= level *fisher-tug-line-unlock-level*) 3)
            ((>= level *fisher-sink-lure-unlock-level*) 2)
            (else 1)))
        (stop-ready-ratio
          (if
            (<= *fisher-stop-lure-cooldown-seconds* 0.0)
            1.0
            (-
              1.0
              (/
                (-> self lure-stop-cooldown)
                *fisher-stop-lure-cooldown-seconds*))))
        (sink-ready-ratio
          (if
            (<= *fisher-sink-lure-cooldown-seconds* 0.0)
            1.0
            (-
              1.0
              (/
                (-> self lure-sink-cooldown)
                *fisher-sink-lure-cooldown-seconds*))))
        (tug-ready-ratio
          (if
            (<= *fisher-tug-line-cooldown-seconds* 0.0)
            1.0
            (-
              1.0
              (/
                (-> self tug-line-cooldown)
                *fisher-tug-line-cooldown-seconds*))))
        (rip-ready-ratio
          (if
            (<= *fisher-rip-line-cooldown-seconds* 0.0)
            1.0
            (-
              1.0
              (/
                (-> self rip-line-cooldown)
                *fisher-rip-line-cooldown-seconds*))))
        (heal-ready-ratio
          (if
            (<= *fisher-heal-line-cooldown-seconds* 0.0)
            1.0
            (-
              1.0
              (/
                (-> self heal-line-cooldown)
                *fisher-heal-line-cooldown-seconds*)))))

      (with-dma-buffer-add-bucket
        ((buf (-> (current-frame) global-buf))
          (bucket-id subtitle))

        (draw-sprite2d-xy
          buf 114 198 284 6
          (new 'static 'rgba
            :r #x08 :g #x08 :b #x08 :a #xb8))

        (draw-sprite2d-xy
          buf 116 199 280 4
          (new 'static 'rgba
            :r #x38 :g #x48 :b #x58 :a #xd0)))

      (fisher-draw-cooldown-segment!
        0
        skill-count
        stop-ready-ratio
        *fisher-stop-lure-cooldown-color*)

      (when
        (>= level *fisher-sink-lure-unlock-level*)

        (fisher-draw-cooldown-segment!
          1
          skill-count
          sink-ready-ratio
          *fisher-sink-lure-cooldown-color*))

      (when
        (>= level *fisher-tug-line-unlock-level*)

        (fisher-draw-cooldown-segment!
          2
          skill-count
          tug-ready-ratio
          *fisher-tug-line-cooldown-color*))

      (when
        (>= level *fisher-rip-line-unlock-level*)

        (fisher-draw-cooldown-segment!
          3
          skill-count
          rip-ready-ratio
          *fisher-rip-line-cooldown-color*))

      (when
        (>= level *fisher-heal-line-unlock-level*)

        (fisher-draw-cooldown-segment!
          4
          skill-count
          heal-ready-ratio
          *fisher-heal-line-cooldown-color*))))

  (none))

(defun fisher-hooked-fish-camera-distance ((self fisher-game))
  (let ((slot (-> self hooked-fish-slot)))
    (cond
      ((< slot 0) (meters 9.0))
      ((= (fisher-fish-species self slot) 3) (meters 17.0))
      ((= (fisher-fish-species self slot) 4) (meters 6.5))
      ((= (fisher-fish-species self slot) 1) (meters 10.5))
      ((= (fisher-fish-species self slot) 2) (meters 9.5))
      ((= (fisher-fish-species self slot) 5) (meters 10.0))
      ((= (fisher-fish-species self slot)
        (the-as int (fisher-species electric-grubfish))) (meters 9.0))
      ((= (fisher-fish-species self slot)
        (the-as int (fisher-species electric-eelfish))) (meters 10.5))
      ((= (fisher-fish-species self slot)
        (the-as int (fisher-species electric-lurker-shark))) (meters 18.0))
      ((= (fisher-fish-species self slot)
        (the-as int (fisher-species swamp-guppie))) (meters 7.5))
      ((= (fisher-fish-species self slot)
        (the-as int (fisher-species sludge-crappie))) (meters 8.0))
      ((= (fisher-fish-species self slot)
        (the-as int (fisher-species black-lurker-shark))) (meters 10.5))
      ((= (fisher-fish-species self slot)
        (the-as int (fisher-species lava-drum))) (meters 20.0))
      ((= (fisher-fish-species self slot)
        (the-as int (fisher-species magma-serpent))) (meters 15.0))
      ((= (fisher-fish-species self slot)
        (the-as int (fisher-species inferno-shark))) (meters 7.0))
      ((= (fisher-fish-species self slot)
        (the-as int (fisher-species frost-biter))) (meters 10.0))
      ((= (fisher-fish-species self slot)
        (the-as int (fisher-species crystal-fish))) (meters 16.0))
      ((= (fisher-fish-species self slot)
        (the-as int (fisher-species ice-shark))) (meters 7.0))
      (else (meters 8.5)))))

(defun fisher-update-lure! ((self fisher-game))
  (let* ((dt (-> *display* seconds-per-frame))
      (from-jak (new 'stack-no-clear 'vector))
      (horizontal-distance 0.0)
      (saved-y 0.0)
      (top-y (- (-> self water-level) (meters 3.0)))
      (bottom-y (- (-> self water-level) (fisher-playfield-max-depth self)))
      (current-speed -0.18)
      (bottom-current-speed -0.28)
      (level-speed-mult
        (fisher-level-lure-speed-multiplier))
      (reel-mult
        (*
          level-speed-mult
          (if
            (and
              (= (-> self fish-state) 'reeling)
              (-> self tug-line-active?))
            *fisher-tug-line-reel-multiplier*
            1.0))))

    (vector-! from-jak (-> self lure-pos) (-> self fishing-player-pos))

    (set! horizontal-distance (vector-dot from-jak (-> self lure-cast-axis)))

    (when
      (and
        (not (fisher-finalboss-zone? self))
        (or *fisher-in-debug?* (>= (fisher-current-level) *fisher-stop-lure-unlock-level*))
        (<= (-> self lure-stop-cooldown) 0.0)
        (!= (-> self fish-state) 'reeling)
        (not (-> self fish-fighting?))
        (not (-> self lure-stop-active?))
        (not (-> self lure-sink-active?))
        (cpad-pressed? 0 square))

      (cpad-clear! 0 square)
      (set! (-> self lure-stop-active?) #t)
      (set! (-> self lure-stop-used?) #t)
      (set! (-> self lure-stop-time) *fisher-stop-lure-active-seconds*)
      (set! (-> self lure-stop-cooldown) *fisher-stop-lure-cooldown-seconds*)
      (play-sound-file "bwoop.wav" (the int (-> *setting-control* current sfx-volume)))
      (fisher-show-lure-skill-message! self "FREEZE LURE")
      (set! (-> self lure-x-velocity) 0.0)
      (set! (-> self lure-y-velocity) 0.0))

    (when
      (and
        (not (fisher-finalboss-zone? self))
        (or *fisher-in-debug?* (>= (fisher-current-level) *fisher-sink-lure-unlock-level*))
        (<= (-> self lure-sink-cooldown) 0.0)
        (!= (-> self fish-state) 'reeling)
        (not (-> self fish-fighting?))
        (not (-> self lure-sink-active?))
        (not (-> self lure-stop-active?))
        (cpad-pressed? 0 r1))

      (cpad-clear! 0 r1)
      (set! (-> self lure-sink-active?) #t)
      (set! (-> self lure-sink-used?) #t)
      (set! (-> self lure-sink-time) *fisher-sink-lure-active-seconds*)
      (set! (-> self lure-sink-cooldown) *fisher-sink-lure-cooldown-seconds*)
      (play-sound-file "bwoop.wav" (the int (-> *setting-control* current sfx-volume)))
      (fisher-show-lure-skill-message! self "SINK LURE"))

    (when
      (and
        (cpad-hold? 0 x)
        (<= (-> self electric-line-stun-time) 0.0))

      (when
        (-> self lure-stop-active?)
        (set! (-> self lure-stop-active?) #f)
        (set! (-> self lure-stop-time) 0.0))

      (when
        (-> self lure-sink-active?)
        (set! (-> self lure-sink-active?) #f)
        (set! (-> self lure-sink-time) 0.0)))

    (when
      (-> self lure-sink-active?)

      (-! (-> self lure-sink-time) dt)

      (when
        (<= (-> self lure-sink-time) 0.0)

        (set! (-> self lure-sink-active?) #f)
        (set! (-> self lure-sink-time) 0.0)))

    (cond
      ((and
          (cpad-hold? 0 x)
          (<= (-> self electric-line-stun-time) 0.0))
        (vector+float*! (-> self lure-pos) (-> self lure-pos) (-> self lure-cast-axis) (- (* (meters 1.0) (-> self lure-reel-x-speed) reel-mult dt)))

        (+! (-> self lure-pos y) (* (meters 1.0) (-> self lure-reel-y-speed) reel-mult dt))

        (set!
          (-> self lure-x-velocity)
          (- (* (-> self lure-reel-x-speed) reel-mult)))

        (set! (-> self lure-y-velocity) 0.0)
      )

      ((-> self lure-stop-active?)
        (set! (-> self lure-x-velocity) 0.0)
        (set! (-> self lure-y-velocity) 0.0)

        (-! (-> self lure-stop-time) dt)

        (when
          (<= (-> self lure-stop-time) 0.0)

          (set! (-> self lure-stop-active?) #f)
          (set! (-> self lure-stop-time) 0.0))
      )

      (else
        (cond
          ((> horizontal-distance
              (meters 2.0))

            (cond
              ((<=
                  (-> self lure-pos y)
                  (+ bottom-y
                    (meters 0.75)))

                (set! (-> self lure-x-velocity) bottom-current-speed)
              )

              (else (set! (-> self lure-x-velocity) current-speed))
            )

            (vector+float*! (-> self lure-pos) (-> self lure-pos) (-> self lure-cast-axis) (* (meters 1.0) (-> self lure-x-velocity) dt))
          )

          (else (set! (-> self lure-x-velocity) 0.0))
        )

        (let ((sink-mult
              (if (-> self lure-sink-active?) 3.0 1.0)))

          (-!
            (-> self lure-y-velocity)
            (* 1.2 level-speed-mult sink-mult dt))

          (when
            (<
              (-> self lure-y-velocity)
              (- (* (-> self lure-fall-speed) level-speed-mult sink-mult)))

            (set!
              (-> self lure-y-velocity)
              (- (* (-> self lure-fall-speed) level-speed-mult sink-mult))))
        )

        (+! (-> self lure-pos y) (* (meters 1.0) (-> self lure-y-velocity) dt))
      )
    )

    (vector-! from-jak (-> self lure-pos) (-> self fishing-player-pos))

    (set! horizontal-distance (vector-dot from-jak (-> self lure-cast-axis)))

    (set! saved-y (-> self lure-pos y))

    (cond
      ((< horizontal-distance
          (meters 2.0))

        (vector+float*! (-> self lure-pos) (-> self fishing-player-pos) (-> self lure-cast-axis) (meters 2.0))

        (set! (-> self lure-pos y) saved-y)

        (set! (-> self lure-x-velocity) 0.0)
      )

      ((> horizontal-distance
          (fisher-playfield-far-distance self))

        (vector+float*! (-> self lure-pos) (-> self fishing-player-pos) (-> self lure-cast-axis) (fisher-playfield-far-distance self))

        (set! (-> self lure-pos y) saved-y)

        (set! (-> self lure-x-velocity) 0.0)
      )
    )

    (when
      (> (-> self lure-pos y) top-y)

      (set! (-> self lure-pos y) top-y)

      (when
        (> (-> self lure-y-velocity) 0.0)

        (set!
          (-> self lure-y-velocity)
          0.0))
    )

    (when
      (< (-> self lure-pos y) bottom-y)

      (set! (-> self lure-pos y) bottom-y)

      (set! (-> self lure-y-velocity) 0.48)
    )

    (vector-! from-jak (-> self lure-pos) (-> self fishing-player-pos))

    (set! horizontal-distance (vector-dot from-jak (-> self lure-cast-axis)))

    (when
      (and
        (< (-> self hooked-fish-slot) 0)

        (>= (-> self lure-pos y) (- (-> self water-level) (meters 3.05)))

        (<=
          horizontal-distance
          (meters 4.0)))

      (fisher-reset-cast! self))
  )

  (none)
)

(defun fisher-fish-weight-damage-multiplier
  ((self fisher-game) (slot int))

  (let* ((species
        (fisher-fish-species self slot))

      (weight
        (the float
          (max
            1
            (fisher-fish-weight-tenths self slot))))

      (reference-weight
        (cond
          ((= species 3) 260.0)
          ((= species (the-as int (fisher-species fire-canyon-cellfish))) 204.0)
          ((= species 5) 35.0)
          ((= species (the-as int (fisher-species electric-grubfish))) 45.0)
          ((= species (the-as int (fisher-species electric-eelfish))) 60.0)
          ((= species (the-as int (fisher-species electric-lurker-shark))) 450.0)
          ((= species (the-as int (fisher-species swamp-guppie))) 15.0)
          ((= species (the-as int (fisher-species sludge-crappie))) 25.0)
          ((= species (the-as int (fisher-species black-lurker-shark))) 80.0)
          ((= species (the-as int (fisher-species lava-drum))) 600.0)
          ((= species (the-as int (fisher-species magma-serpent))) 275.0)
          ((= species (the-as int (fisher-species inferno-shark))) 50.0)
          ((= species (the-as int (fisher-species frost-biter))) 75.0)
          ((= species (the-as int (fisher-species crystal-fish))) 125.0)
          ((= species (the-as int (fisher-species ice-shark))) 75.0)
          ((= species (the-as int (fisher-species helix-voidfish))) 165.0)
          ((= species (the-as int (fisher-species dark-precursor-fangfish))) 165.0)
          ((= species (the-as int (fisher-species phantasm-shark))) 250.0)
          ((= species (the-as int (fisher-species megaloviathan))) 3000.0)
          ((= species 1) 35.0)
          ((= species 2) 30.0)
          (else 15.0))))

    (fmax
      0.45
      (fmin
        4.0
        (/ weight reference-weight)))))

(defun fisher-fight-damage-per-second
  ((self fisher-game) (slot int))

  (let* ((species
        (fisher-fish-species self slot))

      (base-damage
        (cond
          ((or
              (= species (the-as int (fisher-species lurker-shark)))
              (= species (the-as int (fisher-species fire-canyon-cellfish))))
            105.0)
          ((= species 1) 52.0)
          ((= species 5) 38.0)
          ((= species (the-as int (fisher-species electric-grubfish))) 42.0)
          ((= species (the-as int (fisher-species electric-eelfish))) 48.0)
          ((= species (the-as int (fisher-species electric-lurker-shark))) 128.0)
          ((= species (the-as int (fisher-species swamp-guppie))) 40.0)
          ((= species (the-as int (fisher-species sludge-crappie))) 30.0)
          ((= species (the-as int (fisher-species black-lurker-shark))) 72.0)
          ((= species (the-as int (fisher-species lava-drum))) 56.0)
          ((= species (the-as int (fisher-species magma-serpent))) 52.0)
          ((= species (the-as int (fisher-species inferno-shark))) 38.0)
          ((= species (the-as int (fisher-species frost-biter))) 38.0)
          ((= species (the-as int (fisher-species crystal-fish))) 44.0)
          ((= species (the-as int (fisher-species ice-shark))) 58.0)
          ((= species (the-as int (fisher-species helix-voidfish))) 55.0)
          ((= species (the-as int (fisher-species dark-precursor-fangfish))) 45.0)
          ((= species (the-as int (fisher-species phantasm-shark))) 75.0)
          ((= species (the-as int (fisher-species megaloviathan))) 110.0)
          (else 34.0)))

      (fish-level
        (fisher-fish-level self slot))

      (jak-level
        (fisher-current-level))

      (level-mult
        (fisher-level-fight-multiplier fish-level jak-level)))

    (*
      base-damage
      (fisher-fish-weight-damage-multiplier self slot)
      (if
        (or
          (= species (the-as int (fisher-species lurker-shark)))
          (= species (the-as int (fisher-species fire-canyon-cellfish)))
          (= species (the-as int (fisher-species electric-lurker-shark)))
          (= species (the-as int (fisher-species black-lurker-shark))))
        (fmax 1.15 level-mult)
        level-mult))))

(defun fisher-finalboss-zone? ((self fisher-game))
  (= (-> self location-id) (the-as int (fisher-zone finalboss-nuclear))))

(defun fisher-finalboss-center-lure-horizontal! ((self fisher-game))
  (let ((saved-y (-> self lure-pos y)))
    (vector+float*!
      (-> self lure-pos)
      (-> self fishing-player-pos)
      (-> self playfield-axis)
      *fisher-finalboss-lure-distance*)
    (set! (-> self lure-pos y) saved-y)
    (set! (-> self lure-pos w) 1.0))
  (none))

(defun fisher-finalboss-runtime-reset! ()
  (set! *fisher-finalboss-danger-music-active?* #f)
  (when *fisher-finalboss-hold-music-mute?*
    (remove-setting! 'music-volume))
  (set! *fisher-finalboss-hold-music-mute?* #f)
  (let ((rt *fisher-finalboss-runtime*))
    (set! (-> rt progress) 0)
    (set! (-> rt stage) 0)
    (set! (-> rt difficulty) 1)
    (set! (-> rt state) 'idle)
    (set! (-> rt area-enabled?) #f)
    (set! (-> rt session-primed?) #f)
    (set! (-> rt resume-delay) 0.0)
    (set! (-> rt fail-count) 0)
    (set! (-> rt fight-kind) 0)
    (set! (-> rt mash-button) 0)
    (set! (-> rt mash-count) 0)
    (set! (-> rt mash-target) 0)
    (set! (-> rt wave-index) 0)
    (set! (-> rt wave-total) 0)
    (set! (-> rt wave-timer) 0.0)
    (set! (-> rt wave-count) 0)
    (dotimes (i 6)
      (set! (-> rt wave-button i) 0)
      (set! (-> rt wave-hit i) #f))
    (set! (-> rt guitar-total) 0)
    (set! (-> rt guitar-index) 0)
    (set! (-> rt guitar-button) 0)
    (set! (-> rt guitar-button2) -1)
    (set! (-> rt guitar-button3) -1)
    (set! (-> rt guitar-count) 1)
    (set! (-> rt guitar-hit-mask) 0)
    (set! (-> rt guitar-y) 0.0)
    (set! (-> rt guitar-hit-button) -1)
    (set! (-> rt guitar-hit-flash) 0.0)
    (set! (-> rt guitar-miss-mask) 0)
    (set! (-> rt guitar-miss-flash) 0.0)
    (set! (-> rt guitar-last-hit-count) 0)
    (set! (-> rt reel-target-y) 0.0)
    (set! (-> rt stick-last-zone) -1)
    (set! (-> rt stick-direction) 0)
    (set! (-> rt stick-quarter-count) 0)
    (set! (-> rt stick-rotations) 0)
    (set! (-> rt tick-time) 0.0)
    (set! (-> rt bomb-time) 0.0)
    (set! (-> rt landing-delay) 0.0)
    (set! (-> rt bomb-fired?) #f)
    (set! (-> rt saw-airborne?) #f)
    (set! (-> rt carry-time) 0.0)
    (set! (-> rt prompt-time) 0.0)
    (set! (-> rt throw-time) 0.0)
    (set! (-> rt carry-fish) (the-as (pointer manipy) #f))
    (vector-reset! (-> rt throw-start))
    (vector-reset! (-> rt throw-target)))
  (none))

(defun fisher-finalboss-pressed-button ()
  (cond
    ((cpad-pressed? 0 triangle) 0)
    ((cpad-pressed? 0 circle) 1)
    ((cpad-pressed? 0 x) 2)
    ((cpad-pressed? 0 square) 3)
    (else -1)))

(defun fisher-finalboss-button-pressed? ((button int))
  (cond
    ((= button 0) (cpad-pressed? 0 triangle))
    ((= button 1) (cpad-pressed? 0 circle))
    ((= button 2) (cpad-pressed? 0 x))
    ((= button 3) (cpad-pressed? 0 square))
    (else #f)))

(defun fisher-finalboss-clear-button! ((button int))
  (cond
    ((= button 0) (cpad-clear! 0 triangle))
    ((= button 1) (cpad-clear! 0 circle))
    ((= button 2) (cpad-clear! 0 x))
    ((= button 3) (cpad-clear! 0 square)))
  (none))

(defun fisher-finalboss-fail! ((self fisher-game))
  (let ((rt *fisher-finalboss-runtime*))
    (set! (-> rt area-enabled?) #f)
    (set! (-> rt state) 'failed)
    (set! (-> self fish-fighting?) #f)
    (fisher-clear-button-fight! self)
    (stop-main-music)
    (set-setting! 'music-volume 'abs 0.0 0)
    (set! *fisher-finalboss-hold-music-mute?* #t)
    (set! *boss-activate-blue-eco* #f)
    (set! *boss-trigger-blue-bomb-explosion* #t)
    (set! (-> self cast-state) 'buzzer-exit))
  (none))

(defun fisher-finalboss-add-fail! ((self fisher-game))
  (-! *fisher-line-hp* (/ *fisher-line-hp-max* 5.0))
  (when (<= *fisher-line-hp* 0.0)
    (set! *fisher-line-hp* 0.0)
    (fisher-finalboss-fail! self))
  (none))

(defun fisher-finalboss-reset-stick! ()
  (set! (-> *fisher-finalboss-runtime* stick-last-zone) -1)
  (set! (-> *fisher-finalboss-runtime* stick-direction) 0)
  (set! (-> *fisher-finalboss-runtime* stick-quarter-count) 0)
  (set! (-> *fisher-finalboss-runtime* stick-rotations) 0)
  (none))

(defun fisher-finalboss-stick-zone ()
  (let ((x (the int (-> *cpad-list* cpads 0 rightx)))
        (y (the int (-> *cpad-list* cpads 0 righty))))
    (cond
      ((and (>= x 190) (>= y 76) (<= y 180)) 0) ; right
      ((and (>= y 190) (>= x 76) (<= x 180)) 1) ; down
      ((and (<= x 66)  (>= y 76) (<= y 180)) 2) ; left
      ((and (<= y 66)  (>= x 76) (<= x 180)) 3) ; up
      (else -1))))

(defun fisher-finalboss-current-target-depth ((self fisher-game))
  (cond
    ((= (-> *fisher-finalboss-runtime* stage) 1) *fisher-finalboss-middle-depth*)
    ((= (-> *fisher-finalboss-runtime* stage) 2) *fisher-finalboss-topwater-depth*)
    (else (meters 2.5))))

(defun fisher-finalboss-reel-distance-per-round ()
  (cond
    ((= (-> *fisher-finalboss-runtime* stage) 1) (meters 5.0))
    ((= (-> *fisher-finalboss-runtime* stage) 2) (meters 7.0))
    (else (meters 5.5))))

(defun fisher-finalboss-set-red-pulse! ((self fisher-game) (elapsed float))
  (when (>= (-> self hooked-fish-slot) 0)
    (let ((fish (fisher-fish-pointer self (-> self hooked-fish-slot))))
      (when (and fish (-> fish 0 self))
        (let* ((fp (the-as manipy (-> fish 0 self)))
               (pulse (+ 1.0 (* 0.12 (sin (* (degrees 720.0) elapsed)))))
               (base 0.44))
          (set! (-> fp draw color-mult r) 1.25)
          (set! (-> fp draw color-mult g) 0.003)
          (set! (-> fp draw color-mult b) 0.003)
          (set! (-> fp draw color-mult a) 8.0)
          (set-vector!
            (-> fp root scale)
            (* base 0.62 pulse)
            (* base 0.72 pulse)
            (* base 1.55 pulse)
            1.0)))))
  (none))

(defun fisher-finalboss-wave-window ()
  (cond
    ((= (-> *fisher-finalboss-runtime* difficulty) 1) 3.5)
    ((= (-> *fisher-finalboss-runtime* difficulty) 2) 3.0)
    (else 2.5)))

(defun fisher-finalboss-begin-wave! ((self fisher-game))
  (let ((rt *fisher-finalboss-runtime*)
        (data (-> self button-fight-data)))
    (fisher-clear-button-fight! self)
    (set! (-> rt wave-timer) 0.0)
    (set! (-> rt wave-count) (rand-vu-int-range 4 6))
    (set! (-> data active?) #t)
    (set! (-> data total) (-> rt wave-count))
    (set! (-> data remaining) (-> rt wave-count))
    (set! (-> data elapsed) 0.0)
    (set! (-> data wrong-mask) 0)
    (set! (-> data hint-visible?) #f)

    (dotimes (i 6)
      (set! (-> rt wave-button i) (rand-vu-int-range 0 3))
      (set! (-> rt wave-hit i) (>= i (-> rt wave-count)))
      (set! (-> data slot i state) (if (< i (-> rt wave-count)) 1 0))
      (set! (-> data slot i button) (-> rt wave-button i))
      (set! (-> data slot i x)
        (+ 101.0 (* 62.0 (the float i)) (rand-vu-float-range -8.0 8.0)))
      (set! (-> data slot i y) (rand-vu-float-range 118.0 132.0))
      (set! (-> data slot i vel-x) (rand-vu-float-range -24.0 24.0))
      (set! (-> data slot i vel-y)
        (- (* 72.0 (rand-vu-float-range 0.90 1.10))))
      (set! (-> data slot i launch-time) 0.0)))
  (none))

(defun fisher-finalboss-next-guitar-note! ()
  (let* ((rt *fisher-finalboss-runtime*)
         (difficulty (-> rt difficulty)))
    (cond
      ((> (-> rt guitar-count) 1)
        (-! (-> rt guitar-count) 1)
        (set! (-> rt guitar-y) (fmax 8.0 (- (-> rt guitar-y) 34.0))))

      (else
        (let* ((roll (rand-vu-int-range 0 100))
               (remaining (- (-> rt guitar-total) (-> rt guitar-index)))
               (wanted
                 (cond
                   ((= difficulty 1) 1)
                   ((= difficulty 2) (if (< roll 45) 3 1))
                   (else
                     (cond
                       ((< roll 18) 1)
                       ((< roll 72) 3)
                       (else 4)))))
               (run (min wanted (if (< remaining 1) 1 remaining)))
               (old-button (-> rt guitar-button))
               (button (rand-vu-int-range 0 3)))
          (when (and (> difficulty 1) (> (-> rt guitar-index) 0))
            (while (= button old-button)
              (set! button (rand-vu-int-range 0 3))))
          (set! (-> rt guitar-button) button)
          (set! (-> rt guitar-button2) -1)
          (set! (-> rt guitar-button3) -1)
          (set! (-> rt guitar-count) run)
          (set! (-> rt guitar-last-hit-count) run)
          (set! (-> rt guitar-y) 8.0))))
    (set! (-> rt guitar-hit-mask) 0))
  (none))

(defun fisher-finalboss-begin-fight! ((self fisher-game))
  (let* ((rt *fisher-finalboss-runtime*)
         (kind (rand-vu-int-range 0 2)))
    (set! (-> rt state) 'fight)
    (set! (-> rt fight-kind) kind)
    (set! (-> self fish-fighting?) #t)
    (fisher-clear-button-fight! self)
    (set! (-> self fish-fight-base-y) (-> self lure-pos y))
    (set! (-> self fish-fight-phase) 0.0)

    (cond
      ((= kind 0)
        (set! (-> rt mash-button) (rand-vu-int-range 0 3))
        (set! (-> rt mash-count) 0)
        (set! (-> rt wave-timer) 0.0)
        (set! (-> rt mash-target)
          (min 42
            (+ (rand-vu-int-range 20 42)
               (* (- (-> rt difficulty) 1) 2)))))

      ((= kind 1)
        (set! (-> rt wave-index) 0)
        (set! (-> rt wave-total) 3)
        (fisher-finalboss-begin-wave! self))

      (else
        (set! (-> rt guitar-index) 0)
        (set! (-> rt guitar-total)
          (cond
            ((= (-> rt difficulty) 1)
              (rand-vu-int-range 3 6))
            (else
              (min 12
                (+ (rand-vu-int-range 5 12)
                   (- (-> rt difficulty) 1))))))
        (set! (-> rt guitar-hit-button) -1)
        (set! (-> rt guitar-hit-flash) 0.0)
        (set! (-> rt guitar-miss-mask) 0)
        (set! (-> rt guitar-miss-flash) 0.0)
        (set! (-> rt guitar-last-hit-count) 0)
        (fisher-finalboss-next-guitar-note!))))
  (none))

(defun fisher-finalboss-begin-reel! ((self fisher-game))
  (set! (-> *fisher-finalboss-runtime* state) 'reel)
  (set! (-> *fisher-finalboss-runtime* reel-target-y) (-> self lure-pos y))
  (set! (-> self fish-fighting?) #f)
  (fisher-clear-button-fight! self)
  (fisher-finalboss-reset-stick!)
  (play-sound-file "bwoop.wav" (the int (-> *setting-control* current sfx-volume)))
  (none))

(defun fisher-finalboss-update-fight! ((self fisher-game))
  (let* ((rt *fisher-finalboss-runtime*)
         (dt (-> *display* seconds-per-frame))
         (button (fisher-finalboss-pressed-button))
         (bottom-y (- (-> self water-level) *fisher-finalboss-bottom-depth*)))

    (-! (-> self lure-pos y)
      (*
        (cond
          ((= (-> rt difficulty) 1) (meters 0.48))
          ((= (-> rt difficulty) 2) (meters 0.58))
          (else (meters 0.70)))
        dt))
    (when (< (-> self lure-pos y) bottom-y)
      (set! (-> self lure-pos y) bottom-y))

    (cond
      ((= (-> rt fight-kind) 0)
        (when (> (-> rt wave-timer) 0.0)
          (-! (-> rt wave-timer) dt)
          (when (< (-> rt wave-timer) 0.0)
            (set! (-> rt wave-timer) 0.0)))
        (when (>= button 0)
          (fisher-finalboss-clear-button! button)
          (cond
            ((= button (-> rt mash-button))
              (+! (-> rt mash-count) 1)
              (set! (-> rt wave-timer) 0.12)
              (when (= (mod (-> rt mash-count) 4) 0)
                (fisher-launch-button-hit-effects! self 256.0 111.0)))
            (else
              (fisher-finalboss-add-fail! self))))
        (when (and (= (-> rt state) 'fight)
                   (>= (-> rt mash-count) (-> rt mash-target)))
          (fisher-finalboss-begin-reel! self)))

      ((= (-> rt fight-kind) 1)
        (let ((data (-> self button-fight-data)))
          (+! (-> data elapsed) dt)
          (dotimes (i (-> data total))
            (when (= (-> data slot i state) 1)
              (+! (-> data slot i vel-y) (* 92.0 dt))
              (*! (-> data slot i vel-x) (fmax 0.0 (- 1.0 (* 2.25 dt))))
              (+! (-> data slot i x) (* (-> data slot i vel-x) dt))
              (+! (-> data slot i y) (* (-> data slot i vel-y) dt))
              (when (< (-> data slot i x) 92.0)
                (set! (-> data slot i x) 92.0)
                (set! (-> data slot i vel-x) (fabs (-> data slot i vel-x))))
              (when (> (-> data slot i x) 420.0)
                (set! (-> data slot i x) 420.0)
                (set! (-> data slot i vel-x) (- (fabs (-> data slot i vel-x)))))
              (when (< (-> data slot i y) 88.0)
                (set! (-> data slot i y) 88.0)
                (set! (-> data slot i vel-y) (fabs (-> data slot i vel-y))))
              (when (> (-> data slot i y) 158.0)
                (set! (-> data slot i y) 158.0)
                (set! (-> data slot i vel-y) (- (fabs (-> data slot i vel-y)))))))

          (when (>= button 0)
            (fisher-finalboss-clear-button! button)
            (let ((found -1))
              (dotimes (i (-> data total))
                (when (and (< found 0)
                           (= (-> data slot i state) 1)
                           (= button (-> data slot i button)))
                  (set! found i)))
              (cond
                ((>= found 0)
                  (fisher-launch-button-hit-effects!
                    self
                    (-> data slot found x)
                    (-> data slot found y))
                  (set! (-> data slot found state) 2)
                  (set! (-> rt wave-hit found) #t)
                  (-! (-> data remaining) 1))
                (else
                  (fisher-finalboss-add-fail! self)))))

          (+! (-> rt wave-timer) dt)
          (when
            (and
              (= (-> rt state) 'fight)
              (or
                (<= (-> data remaining) 0)
                (>=
                  (-> rt wave-timer)
                  (fisher-finalboss-wave-window))))
            (when (> (-> data remaining) 0)
              (dotimes (i (-> data total))
                (when (= (-> data slot i state) 1)
                  (fisher-finalboss-add-fail! self))))
            (fisher-clear-button-fight! self)
            (when (= (-> rt state) 'fight)
              (+! (-> rt wave-index) 1)
              (if (>= (-> rt wave-index) (-> rt wave-total))
                (fisher-finalboss-begin-reel! self)
                (fisher-finalboss-begin-wave! self))))))

      (else
        (when (> (-> rt guitar-hit-flash) 0.0)
          (-! (-> rt guitar-hit-flash) dt)
          (when (< (-> rt guitar-hit-flash) 0.0)
            (set! (-> rt guitar-hit-flash) 0.0)))
        (when (> (-> rt guitar-miss-flash) 0.0)
          (-! (-> rt guitar-miss-flash) dt)
          (when (< (-> rt guitar-miss-flash) 0.0)
            (set! (-> rt guitar-miss-flash) 0.0)
            (set! (-> rt guitar-miss-mask) 0)))

        (let ((speed
              (cond
                ((= (-> rt difficulty) 1) 116.0)
                ((= (-> rt difficulty) 2) 124.0)
                (else 132.0))))
          (+! (-> rt guitar-y) (* speed dt)))

        (when (and (= (-> rt state) 'fight) (>= button 0))
          (fisher-finalboss-clear-button! button)
          (cond
            ((and
                (= button (-> rt guitar-button))
                (>= (-> rt guitar-y) 104.0)
                (<= (-> rt guitar-y) 164.0))
              (set! (-> rt guitar-hit-mask) 1)
              (fisher-launch-button-hit-effects!
                self
                (the float (fisher-finalboss-lane-x button))
                140.0)
              (set! (-> rt guitar-hit-button) button)
              (set! (-> rt guitar-hit-flash) 0.20)
              (play-sound-file
                "bwoop.wav"
                (the int (-> *setting-control* current sfx-volume)))
              (+! (-> rt guitar-index) 1)
              (when (< (-> rt guitar-index) (-> rt guitar-total))
                (fisher-finalboss-next-guitar-note!)))
            (else
              (set! (-> rt guitar-miss-mask) (ash 1 button))
              (set! (-> rt guitar-miss-flash) 0.28)
              (fisher-finalboss-add-fail! self))))

        (when
          (and
            (= (-> rt state) 'fight)
            (> (-> rt guitar-y) 168.0)
            (zero? (-> rt guitar-hit-mask)))
          (set! (-> rt guitar-miss-mask) (ash 1 (-> rt guitar-button)))
          (set! (-> rt guitar-miss-flash) 0.34)
          (fisher-finalboss-add-fail! self)
          (when (= (-> rt state) 'fight)
            (+! (-> rt guitar-index) 1)
            (when (< (-> rt guitar-index) (-> rt guitar-total))
              (fisher-finalboss-next-guitar-note!))))

        (when (and (= (-> rt state) 'fight)
                   (>= (-> rt guitar-index) (-> rt guitar-total)))
          (fisher-finalboss-begin-reel! self))))
    (none)))

(defun fisher-finalboss-start-ticking! ((self fisher-game))
  (set! (-> *fisher-finalboss-runtime* state) 'ticking)
  (set! (-> *fisher-finalboss-runtime* tick-time) 0.0)
  (set! (-> self fish-fighting?) #f)

  (stop-main-music)
  (set-setting! 'music-volume 'abs 0.0 0)
  (set! *fisher-finalboss-hold-music-mute?* #t)

  (play-sound-file
    "death-is-coming.mp3"
    (the int (-> *setting-control* current sfx-volume)))
  (none))

(defun fisher-finalboss-finish-stage-threshold! ((self fisher-game))
  (let ((rt *fisher-finalboss-runtime*))
    (set! (-> rt area-enabled?) #f)
    (set! (-> rt bomb-time) 8.0)
    (set! (-> rt landing-delay) 0.0)
    (set! (-> rt bomb-fired?) #f)
    (set! (-> rt saw-airborne?) #f)
    (set! (-> rt state) 'exit-wait)
    (set! (-> self cast-state) 'buzzer-exit))
  (none))

(defun fisher-finalboss-update-reel! ((self fisher-game))
  (let* ((rt *fisher-finalboss-runtime*)
         (dt (-> *display* seconds-per-frame))
         (zone (fisher-finalboss-stick-zone)))
    (when (>= zone 0)
      (let ((last (-> rt stick-last-zone)))
        (when (and (>= last 0) (!= zone last))
          (let ((cw (mod (+ last 1) 4))
                (ccw (mod (+ last 3) 4)))
            (cond
              ((= zone cw)
                (when (or (= (-> rt stick-direction) 0)
                          (= (-> rt stick-direction) 1))
                  (set! (-> rt stick-direction) 1)
                  (+! (-> rt stick-quarter-count) 1)))
              ((= zone ccw)
                (when (or (= (-> rt stick-direction) 0)
                          (= (-> rt stick-direction) -1))
                  (set! (-> rt stick-direction) -1)
                  (+! (-> rt stick-quarter-count) 1)))
              (else
                (set! (-> rt stick-direction) 0)
                (set! (-> rt stick-quarter-count) 0))))

          (when (> (-> rt stick-quarter-count) 0)
            (+! (-> rt reel-target-y)
              (/ (fisher-finalboss-reel-distance-per-round) 40.0))
            (let ((max-y (- (-> self water-level) (fisher-finalboss-current-target-depth self))))
              (when (> (-> rt reel-target-y) max-y)
                (set! (-> rt reel-target-y) max-y))))

          (when (>= (-> rt stick-quarter-count) 4)
            (+! (-> rt stick-rotations) 1)
            (set! (-> rt stick-quarter-count) 0)))
        (set! (-> rt stick-last-zone) zone)))

    (set! (-> self lure-pos y)
      (seek
        (-> self lure-pos y)
        (-> rt reel-target-y)
        (* (meters 3.2) dt)))

    (let ((depth (- (-> self water-level) (-> self lure-pos y))))
      (cond
        ((<= depth (fisher-finalboss-current-target-depth self))
          (cond
            ((< (-> rt stage) 3)
              (fisher-finalboss-start-ticking! self))
            (else
              (stop-main-music)
              (play-sound-file
                "victory.mp3"
                (the int (-> *setting-control* current sfx-volume)))
              (set-setting! 'music-volume 'abs 0.0 0)
              (set! *fisher-finalboss-hold-music-mute?* #t)
              (fisher-finish-manipy-catch! self (-> self hooked-fish-slot)))))
        ((and
            (>= (-> rt stick-rotations) 10)
            (>= (-> self lure-pos y) (- (-> rt reel-target-y) (meters 0.05))))
          (fisher-finalboss-begin-fight! self))))
  (none)))

(defun fisher-finalboss-update-reeling! ((self fisher-game))
  (let ((rt *fisher-finalboss-runtime*))
    (fisher-finalboss-center-lure-horizontal! self)
    (cond
      ((= (-> rt state) 'resume-delay)
        (+! (-> rt resume-delay) (-> *display* seconds-per-frame))
        (when (>= (-> rt resume-delay) 2.0)
          (set! (-> rt resume-delay) 0.0)
          (fisher-finalboss-begin-fight! self)))
      ((= (-> rt state) 'fight)
        (fisher-finalboss-update-fight! self))
      ((= (-> rt state) 'reel)
        (fisher-finalboss-update-reel! self))
      ((= (-> rt state) 'ticking)
        (+! (-> rt tick-time) (-> *display* seconds-per-frame))
        (fisher-finalboss-set-red-pulse! self (-> rt tick-time))
        (when (>= (-> rt tick-time) 3.0)
          (fisher-finalboss-finish-stage-threshold! self)))
      (else
        (fisher-finalboss-begin-fight! self)))
    (when (or (= (-> rt state) 'resume-delay)
              (= (-> rt state) 'fight)
              (= (-> rt state) 'reel)
              (= (-> rt state) 'ticking))
      (fisher-finalboss-center-lure-horizontal! self)))
  (none))

(defun fisher-finalboss-lane-x ((button int))
  (cond
    ((= button 2) 142)
    ((= button 1) 218)
    ((= button 3) 294)
    (else 370)))

(defun fisher-finalboss-draw-ui! ((self fisher-game))
  (let ((rt *fisher-finalboss-runtime*))
    (when (and (fisher-finalboss-zone? self)
               (= (-> self fish-state) 'reeling))
      (cond
        ((= (-> rt state) 'fight)
         (cond
           ((= (-> rt fight-kind) 0)
            (let* ((progress
                    (/
                     (the float (-> rt mash-count))
                     (the float (if (> (-> rt mash-target) 0) (-> rt mash-target) 1))))
                   (mash-scale (+ 0.82 (* 0.12 (fmin 1.0 progress)))))
              (when (> (-> rt wave-timer) 0.0)
                (set! mash-scale
                      (- mash-scale
                         (* 0.18
                            (fmin 1.0 (/ (-> rt wave-timer) 0.12))))))
              (draw-fisher-large-font-scaled "MASH!" 256 50 0.48)
              (draw-fisher-large-font-scaled
               (fisher-button-label (-> rt mash-button))
               256
               111
               mash-scale)
              (draw-fisher-large-font-scaled
               (if (>= progress 0.75) "ALMOST!" "KEEP PRESSING!")
               256
               154
               0.30)))

           ((= (-> rt fight-kind) 1)
            (draw-fisher-large-font-scaled "CLEAR THE BUTTONS!" 256 44 0.38)
            (let* ((remaining
                    (fmax 0.0
                          (- (fisher-finalboss-wave-window) (-> rt wave-timer))))
                   (tenths (the int (+ 0.999 (* remaining 10.0)))))
              (clear *fish-ui-str*)
              (format *fish-ui-str* "TIME: ~D.~D" (the int (/ tenths 10)) (mod tenths 10))
              (draw-fisher-large-font-scaled *fish-ui-str* 256 67 0.34))
            (fisher-draw-button-fight! self))

           (else
            (draw-fisher-large-font-scaled
             (if (> (-> rt guitar-last-hit-count) 1) "KEEP THE STREAK!" "HIT THE TARGET!")
             256
             38
             0.34)

            (with-dma-buffer-add-bucket
             ((buf (-> (current-frame) global-buf)) (bucket-id subtitle))
             (dotimes (b 4)
               (let* ((x (fisher-finalboss-lane-x b))
                      (left (- x 16))
                      (hit?
                       (and
                        (= b (-> rt guitar-hit-button))
                        (> (-> rt guitar-hit-flash) 0.0)))
                      (miss?
                       (and
                        (> (-> rt guitar-miss-flash) 0.0)
                        (nonzero? (logand (-> rt guitar-miss-mask) (ash 1 b)))))
                      (edge
                       (cond
                         (miss?
                          (new 'static 'rgba :r #xff :g #x18 :b #x18 :a #xff))
                         (hit?
                          (new 'static 'rgba :r #xff :g #xff :b #xff :a #xff))
                         (else
                          (new 'static 'rgba :r #x92 :g #xa0 :b #xb0 :a #xb8))))
                      (lane
                       (new 'static 'rgba :r #x08 :g #x0c :b #x12 :a #x42))
                      (pop (if (or hit? miss?) 2 0)))
                 (draw-sprite2d-xy buf (- x 1) 64 2 62 lane)
                 (draw-sprite2d-xy buf (- left pop) (- 128 pop) (+ 32 (* pop 2)) 2 edge)
                 (draw-sprite2d-xy buf (- left pop) (+ 150 pop) (+ 32 (* pop 2)) 2 edge)
                 (draw-sprite2d-xy buf (- left pop) (- 128 pop) 2 (+ 24 (* pop 2)) edge)
                 (draw-sprite2d-xy buf (+ left 30 pop) (- 128 pop) 2 (+ 24 (* pop 2)) edge))))

            (draw-fisher-large-font-scaled
             (fisher-button-label (-> rt guitar-button))
             (fisher-finalboss-lane-x (-> rt guitar-button))
             (the int (-> rt guitar-y))
             (+ 0.46 (* 0.0010 (fmin 168.0 (-> rt guitar-y)))))
            (when (and (> (-> rt guitar-count) 1) (> (- (-> rt guitar-y) 34.0) 2.0))
              (draw-fisher-large-font-scaled
               (fisher-button-label (-> rt guitar-button))
               (fisher-finalboss-lane-x (-> rt guitar-button))
               (the int (- (-> rt guitar-y) 34.0))
               0.40))
            (when (and (> (-> rt guitar-count) 2) (> (- (-> rt guitar-y) 68.0) 2.0))
              (draw-fisher-large-font-scaled
               (fisher-button-label (-> rt guitar-button))
               (fisher-finalboss-lane-x (-> rt guitar-button))
               (the int (- (-> rt guitar-y) 68.0))
               0.36))
            (when (and (> (-> rt guitar-count) 3) (> (- (-> rt guitar-y) 102.0) 2.0))
              (draw-fisher-large-font-scaled
               (fisher-button-label (-> rt guitar-button))
               (fisher-finalboss-lane-x (-> rt guitar-button))
               (the int (- (-> rt guitar-y) 102.0))
               0.32))

            (when (> (-> rt guitar-hit-flash) 0.0)
              (draw-fisher-large-font-scaled
               (if (> (-> rt guitar-last-hit-count) 1) "STREAK!" "GOOD!")
               256
               166
               0.27))
            (when (> (-> rt guitar-miss-flash) 0.0)
              (draw-fisher-large-font-scaled "MISS!" 256 166 0.27)))))

        ((= (-> rt state) 'reel)
         (draw-fisher-large-font-scaled "ROTATE THE RIGHT STICK!" 256 82 0.46))

        ((= (-> rt state) 'ticking)
         (draw-fisher-large-font-scaled "!!!" 256 86 0.46)))))
  (none))

(defun fisher-finalboss-prime-resume-line! ((self fisher-game))
  (let ((rt *fisher-finalboss-runtime*)
        (slot 0)
        (hook-pos (new 'stack-no-clear 'vector)))
    (set! (-> self hooked-fish-slot) slot)
    (set! (-> self hooked-fish) (ppointer->process (fisher-fish-pointer self slot)))
    (set! (-> self fish-state) 'reeling)
    (set! (-> self casted?) #t)
    (set! (-> self cast-state) 'line-active)
    (set! (-> self cast-charge) 1.0)
    (set! *fisher-line-hp-max* 100.0)
    (fisher-reset-line-hp!)
    (vector-copy! (-> self lure-cast-axis) (-> self playfield-axis))
    (vector+float*!
      hook-pos
      (-> self fishing-player-pos)
      (-> self playfield-axis)
      *fisher-finalboss-lure-distance*)
    (set! (-> hook-pos y)
      (- (-> self water-level)
        (if (= (-> rt stage) 2)
          *fisher-finalboss-middle-depth*
          *fisher-finalboss-topwater-depth*)))
    (set! (-> hook-pos w) 1.0)
    (vector-copy! (-> self lure-pos) hook-pos)
    (vector-copy! (-> self lure-cast-start) hook-pos)
    (vector-copy! (-> self lure-cast-end) hook-pos)

    (let ((resume-fish (fisher-fish-pointer self slot)))
      (when resume-fish
        (let ((resume-proc (the-as manipy (-> resume-fish 0 self))))
          (when resume-proc
            (logclear! (-> resume-proc draw status) (draw-status hidden))
            (vector-copy! (-> resume-proc root trans) hook-pos)))))
    (fisher-set-fish-cooldown! self slot 0.0)
    (set! (-> self fish-scare-on-arrival?) #f)

    (set! (-> self camera-state) 'follow-lure)
    (set! (-> self camera-blend) 0.0)
    (set! (-> self reel-camera-blend) 0.0)
    (set! (-> self fish-hook-time) 0.0)
    (set! (-> self fish-fight-time) 0.0)
    (set! (-> self fish-fight-base-y) (-> hook-pos y))
    (set! (-> self fish-fight-phase) 0.0)
    (set! (-> self hooked-fish-poison-dps) 0.0)

    (vector-copy! (-> self fisher-look) (-> self pos))
    (+! (-> self fisher-look y) (meters 1.0))
    (set! (-> self fisher-look w) 1.0)

    (vector-float*! (-> self lure-camera-offset)
      (-> self camera-axis)
      (- (-> self camera-radius)))
    (set! (-> self lure-camera-offset y) 0.0)
    (set! (-> self lure-camera-offset w) 0.0)

    (vector-copy! (-> self lure-camera-pos) (-> self fisher-cam))
    (vector-copy! (-> self lure-camera-look) (-> self fisher-look))

    (singlefish-vector-scale-safe!
      (-> self hooked-fish-facing)
      (-> self playfield-axis)
      -1.0)
    (set! (-> self hooked-fish-facing y) 0.72)
    (set! (-> self hooked-fish-facing w) 0.0)
    (singlefish-vector-normalize-safe! (-> self hooked-fish-facing) 1.0)
    (vector-copy! (-> self hooked-fish-last-hook-pos) hook-pos)

    (fisher-remove-lure-snake! self)
    (kill-by-name "fisher-lure-snake" *default-pool*)
    (let ((snake-anchor (new 'stack-no-clear 'vector))
          (snake-root (new 'stack-no-clear 'vector)))
      (vector-copy! snake-anchor hook-pos)
      (set! (-> snake-anchor w) 1.0)
      (vector-copy! snake-root snake-anchor)
      (-! (-> snake-root y) (meters 1.0666667))
      (set! (-> snake-root w) 1.0)
      (vector-copy! (-> self lure-snake-last-anchor) snake-anchor)
      (vector-reset! (-> self lure-snake-angle))
      (vector-reset! (-> self lure-snake-angular-speed))
      (set! (-> self lure-snake-flow-time) 0.0)
      (set! (-> self lure-snake) (spawn-fisher-lure-snake snake-root)))

    (set! (-> rt state) 'resume-delay)
    (set! (-> rt resume-delay) 0.0)
    (set! (-> self fish-fighting?) #f))
  (none))

(defun fisher-finalboss-prepare-session! ((self fisher-game))
  (when (fisher-finalboss-zone? self)
    (let ((rt *fisher-finalboss-runtime*))
      (set! (-> rt fail-count) 0)
      (set! (-> rt session-primed?) #t)
      (cond
        ((= (-> rt stage) 1)
          (set! (-> rt state) 'available))
        (else
          (fisher-finalboss-prime-resume-line! self)))))
  (none))

(defun fisher-finalboss-finish-catch-card! ((self fisher-game))
  (when (>= (-> self hooked-fish-slot) 0)
    (let ((fish (fisher-fish-pointer self (-> self hooked-fish-slot))))
      (when fish (fisher-destroy-manipy! fish))
      (fisher-set-fish-pointer! self (-> self hooked-fish-slot) (the-as (pointer manipy) #f))))
  (set! (-> *fisher-finalboss-runtime* progress) 4)
  (set! (-> *fisher-finalboss-runtime* state) 'carry-pending)
  (set! (-> *fisher-finalboss-runtime* area-enabled?) #f)
  (set! (-> self hooked-fish-slot) -1)
  (set! (-> self hooked-fish) #f)
  (set! (-> self fish-state) 'free)
  (set! (-> self caught-orb-value) 0)
  (set! (-> self caught-fish-xp) 0)
  (set! (-> self cast-state) 'buzzer-exit)
  (none))

(defun fisher-clear-button-fight! ((self fisher-game))
  (let ((data (-> self button-fight-data)))
    (set! (-> data active?) #f)
    (set! (-> data total) 0)
    (set! (-> data remaining) 0)
    (set! (-> data elapsed) 0.0)
    (set! (-> data wrong-mask) 0)
    (set! (-> data hint-visible?) #f)

    (dotimes (i *fisher-max-button-fight-slots*)
      (set! (-> data slot i state) 0)
      (set! (-> data slot i button) 0)
      (set! (-> data slot i x) 256.0)
      (set! (-> data slot i y) 250.0)
      (set! (-> data slot i vel-x) 0.0)
      (set! (-> data slot i vel-y) 0.0)
      (set! (-> data slot i launch-time) 0.0)))

  (none))

(defun fisher-button-held? ((button int))
  (cond
    ((= button 0) (cpad-hold? 0 triangle))
    ((= button 1) (cpad-hold? 0 circle))
    ((= button 2) (cpad-hold? 0 x))
    (else (cpad-hold? 0 square))))

(defun fisher-button-label ((button int))
  (cond
    ((= button 0) "<PAD_TRIANGLE>")
    ((= button 1) "<PAD_CIRCLE>")
    ((= button 2) "<PAD_X>")
    (else "<PAD_SQUARE>")))

(defun fisher-button-world-position!
  ((self fisher-game) (screen-x float) (screen-y float) (dst vector))

  (let ((camera-pos (new 'stack-no-clear 'vector))
      (origin (new 'stack-no-clear 'vector))
      (forward (new 'stack-no-clear 'vector))
      (right (new 'stack-no-clear 'vector))
      (up (new 'stack-no-clear 'vector))
      (anchored? #f))

    (cond
      ((and *camera* (> (-> *camera* num-slaves) 0))
        (vector-copy! camera-pos (-> *camera* slave 0 0 trans)))

      (else
        (vector-copy! camera-pos (-> self fisher-cam))))

    (when (>= (-> self hooked-fish-slot) 0)
      (let ((fish (fisher-fish-pointer self (-> self hooked-fish-slot))))
        (when (and fish (-> fish 0 self))
          (vector-copy! origin (-> (the-as manipy (-> fish 0 self)) root trans))
          (set! anchored? #t))))

    (unless anchored?
      (singlefish-vector-add-scaled-safe!
        origin
        camera-pos
        (-> self playfield-axis)
        (meters 2.40)))

    (vector-! forward origin camera-pos)
    (singlefish-vector-normalize-safe! forward 1.0)

    (singlefish-vector-cross-safe!
      right
      forward
      *fisher-button-world-down*)
    (singlefish-vector-normalize-safe! right 1.0)

    (singlefish-vector-cross-safe! up right forward)
    (singlefish-vector-normalize-safe! up 1.0)

    (vector-copy! dst origin)

    (singlefish-vector-add-scaled-safe!
      dst
      dst
      right
      (* (- screen-x 256.0) (meters 0.0062)))

    (singlefish-vector-add-scaled-safe!
      dst
      dst
      up
      (* (- 204.0 screen-y) (meters 0.0062)))

    (singlefish-vector-add-scaled-safe!
      dst
      dst
      forward
      (meters -0.10))

    (set! (-> dst w) 1.0))

  dst)

(defun fisher-launch-button-hit-effects!
  ((self fisher-game) (screen-x float) (screen-y float))

  (let ((particle-pos (new 'stack-no-clear 'vector)))
    (fisher-button-world-position! self screen-x screen-y particle-pos)
    (fisher-set-particle-fishbox-rotation! self)

    (launch-particles
      :system *sp-particle-system-3d*
      (-> *part-id-table* 3577)
      particle-pos)

    (launch-particles
      :system *sp-particle-system-3d*
      (-> *part-id-table* 3579)
      particle-pos))

  (none))

(defun fisher-record-button-fight-hint! ((self fisher-game))
  (let* ((task (game-task fisher-button-fight-hint))
      (control (get-task-control task))
      (hint-count (get-reminder control 0)))

    (set! (-> self button-fight-data hint-visible?) #f)

    (when
      (and
        (not (task-closed? task (task-status need-hint)))
        (< hint-count 2))

      (set! (-> self button-fight-data hint-visible?) #t)
      (+! hint-count 1)
      (save-reminder control hint-count 0)

      (when (>= hint-count 2)
        (close-specific-task! task (task-status need-hint)))))

  (none))

(defun fisher-start-button-fight! ((self fisher-game))
  (let* ((slot (-> self hooked-fish-slot))
      (species (fisher-fish-species self slot))
      (cell-task (fisher-fish-power-cell-task self slot))
      (info (fisher-species-info-for species))
      (data (-> self button-fight-data))
      (count
        (if
          (and
            (= species (the-as int (fisher-species fire-canyon-cellfish)))
            (or
              (= cell-task (the-as int (game-task lavatube-end)))
              (= cell-task (the-as int (game-task lavatube-buzzer)))
              (= cell-task (the-as int (game-task citadel-buzzer)))))
          (rand-vu-int-range 6 10)
          (rand-vu-int-range
            (-> info button-count-min)
            (-> info button-count-max))))
      (launch-time 0.0))

    (fisher-clear-button-fight! self)
    (set! (-> data active?) #t)
    (set! (-> data total) count)
    (set! (-> data remaining) count)
    (set! (-> data elapsed) 0.0)
    (set! (-> data wrong-mask) 0)

    (dotimes (i count)
      (set! (-> data slot i state) 0)
      (set! (-> data slot i button) (rand-vu-int-range 0 3))
      (set! (-> data slot i x) (rand-vu-float-range 248.0 264.0))
      (set! (-> data slot i y) (rand-vu-float-range 202.0 214.0))
      (set! (-> data slot i vel-x) (rand-vu-float-range -82.0 82.0))
      (set! (-> data slot i vel-y)
        (-
          (*
            (-> info button-rise-speed)
            (rand-vu-float-range 0.88 1.12))))
      (set! (-> data slot i launch-time) launch-time)
      (+! launch-time
        (rand-vu-float-range
          (-> info button-launch-min)
          (-> info button-launch-max))))

    (fisher-record-button-fight-hint! self))

  (none))

(defun fisher-hit-button! ((self fisher-game) (button int))
  (let ((data (-> self button-fight-data))
      (found-slot -1))

    (dotimes (i (-> data total))
      (when
        (and
          (< found-slot 0)
          (= (-> data slot i state) 1)
          (= (-> data slot i button) button))

        (set! found-slot i)))

    (cond
      ((>= found-slot 0)
        (fisher-launch-button-hit-effects!
          self
          (-> data slot found-slot x)
          (-> data slot found-slot y))
        (set! (-> data slot found-slot state) 2)
        (-! (-> data remaining) 1))

      (else
        (logior! (-> data wrong-mask) (ash 1 button)))))

  (none))

(defun fisher-update-button-fight-input! ((self fisher-game))
  (let ((data (-> self button-fight-data)))
    (dotimes (button 4)
      (when
        (and
          (logtest? (-> data wrong-mask) (ash 1 button))
          (not (fisher-button-held? button)))

        (logclear! (-> data wrong-mask) (ash 1 button))))

    (when (cpad-pressed? 0 triangle)
      (fisher-hit-button! self 0)
      (cpad-clear! 0 triangle))

    (when (cpad-pressed? 0 circle)
      (fisher-hit-button! self 1)
      (cpad-clear! 0 circle))

    (when (cpad-pressed? 0 x)
      (fisher-hit-button! self 2)
      (cpad-clear! 0 x))

    (when (cpad-pressed? 0 square)
      (fisher-hit-button! self 3)
      (cpad-clear! 0 square)))

  (none))

(defun fisher-finish-button-fight! ((self fisher-game))
  (let* ((slot (-> self hooked-fish-slot))
      (species (fisher-fish-species self slot))
      (info (fisher-species-info-for species)))

    (set! (-> self fish-fighting?) #f)
    (set! (-> self fish-fight-time) 0.0)
    (set! (-> self fish-hook-time)
      (rand-vu-float-range
        (fmax 0.85 (-> info fight-recover-min))
        (fmax 0.85 (-> info fight-recover-max))))
    (set! (-> self fish-fight-phase) (degrees 180.0))
    (fisher-clear-button-fight! self))

  (none))

(defun fisher-update-button-fight! ((self fisher-game))
  (let* ((data (-> self button-fight-data))
      (dt (-> *display* seconds-per-frame))
      (slot (-> self hooked-fish-slot))
      (species (fisher-fish-species self slot))
      (info (fisher-species-info-for species)))

    (+! (-> data elapsed) dt)
    (fisher-update-button-fight-input! self)

    (dotimes (i (-> data total))
      (when
        (and
          (= (-> data slot i state) 0)
          (>= (-> data elapsed) (-> data slot i launch-time)))

        (set! (-> data slot i state) 1))

      (when (= (-> data slot i state) 1)
        (+! (-> data slot i vel-y) (* (-> info button-gravity) dt))
        (*! (-> data slot i vel-x) (fmax 0.0 (- 1.0 (* 1.75 dt))))
        (+! (-> data slot i x) (* (-> data slot i vel-x) dt))
        (+! (-> data slot i y) (* (-> data slot i vel-y) dt))

        (when (< (-> data slot i x) 72.0)
          (set! (-> data slot i x) 72.0)
          (set! (-> data slot i vel-x) (fabs (-> data slot i vel-x))))

        (when (> (-> data slot i x) 440.0)
          (set! (-> data slot i x) 440.0)
          (set! (-> data slot i vel-x) (- (fabs (-> data slot i vel-x)))))

        (when (>= (-> data slot i y) 448.0)
          (fisher-clear-button-fight! self)
          (fisher-fish-scared-off! self slot)
          (fisher-debug-print-lure-loss! self "BUTTON FIGHT FAILED / PROMPT MISSED")
          (fisher-begin-lure-stolen-return! self)
          (return #t))))

    (when (<= (-> data remaining) 0)
      (fisher-finish-button-fight! self))

  #f))

(defun fisher-draw-button-fight! ((self fisher-game))
  (let ((data (-> self button-fight-data)))
    (when (-> data active?)
      (dotimes (i (-> data total))
        (when (= (-> data slot i state) 1)
          (let ((particle-pos (new 'stack-no-clear 'vector)))
            (fisher-button-world-position!
              self
              (-> data slot i x)
              (-> data slot i y)
              particle-pos)
            (fisher-set-particle-fishbox-rotation! self)
            (launch-particles
              :system *sp-particle-system-3d*
              (-> *part-id-table* 3577)
              particle-pos))

          (draw-fisher-large-font-scaled
            (fisher-button-label (-> data slot i button))
            (the int (-> data slot i x))
            (the int (-> data slot i y))
            0.62)))

      (when (-> data hint-visible?)
        (draw-fisher-large-font-scaled
          "HIT THE BUTTONS!"
          256
          151
          0.44))))

  (none))

(defun fisher-update-manipy-reeling!
  ((self fisher-game))

  (let* ((dt
        (-> *display* seconds-per-frame))

      (from-jak (new 'stack-no-clear 'vector))

      (horizontal-distance 0.0)

      (top-y
        (- (-> self water-level)
          (meters 3.0))))

    (cond
      ((and
          (fisher-finalboss-zone? self)
          (>= (-> self hooked-fish-slot) 0)
          (=
            (fisher-fish-species self (-> self hooked-fish-slot))
            (the-as int (fisher-species nuclear-bombfish))))
        (fisher-finalboss-update-reeling! self))
      (else

    (when
      (and
        (>= (-> self hooked-fish-slot) 0)
        (=
          (fisher-fish-species self (-> self hooked-fish-slot))
          5)
        (> (-> self hooked-fish-poison-dps) 0.0))

      (fisher-damage-line!
        (*
          (-> self hooked-fish-poison-dps)
          dt)))

    (cond
      (*fisher-line-broken?*
        (let ((slot (-> self hooked-fish-slot)))
          (when (>= slot 0)
            (fisher-fish-scared-off! self slot))

          (fisher-debug-print-lure-loss! self "LINE HP BROKEN")
          (fisher-begin-lure-stolen-return! self)))

      ((-> self fish-fighting?)
        (let* ((slot (-> self hooked-fish-slot))
            (species (fisher-fish-species self slot))
            (info (fisher-species-info-for species))
            (button-fight? (= (-> info fight-mode) 1)))

          (+! (-> self fish-fight-phase) (* (degrees 420.0) dt))

          (vector+float*!
            (-> self lure-pos)
            (-> self lure-pos)
            (-> self lure-cast-axis)
            (* (-> info fight-pull-speed) dt))

          (set! (-> self lure-pos y)
            (+
              (-> self fish-fight-base-y)
              (* (meters 0.055) (sin (-> self fish-fight-phase)))))

          (cond
            (button-fight?
              (unless (fisher-update-button-fight! self)
                (when
                  (and
                    (-> self fish-fighting?)
                    (nonzero? (-> self button-fight-data wrong-mask)))
                  (fisher-damage-line!
                    (*
                      (fisher-fight-damage-per-second self slot)
                      (-> info button-miss-scale)
                      10.0
                      dt)))))

            ((and
                (not *fisher-in-debug?*)
                (cpad-hold? 0 x)
                (<= (-> self electric-line-stun-time) 0.0))
              (fisher-damage-line!
                (*
                  (fisher-fight-damage-per-second self slot)
                  dt))))

          (when *fisher-line-broken?*
            (fisher-clear-button-fight! self)

            (when (>= slot 0)
              (fisher-fish-scared-off! self slot))

            (fisher-debug-print-lure-loss! self "BUTTON FIGHT LINE HP BROKEN")
            (fisher-begin-lure-stolen-return! self))))

      (else
        (fisher-update-lure! self)

        (vector-! from-jak (-> self lure-pos) (-> self fishing-player-pos))

        (set! horizontal-distance (vector-dot from-jak (-> self lure-cast-axis)))

        (when
          (and (<= horizontal-distance (meters 2.05)) (>= (-> self lure-pos y) (- top-y (meters 0.10))))

          (fisher-finish-manipy-catch!
            self
            (-> self hooked-fish-slot))))))
    ))

  (none))

(defun fisher-submit-power-cell-fish-particle!
  ((self fisher-game) (slot int) (fish-proc manipy))
  (when
    (and
      (> (fisher-fish-power-cell-task self slot) 1)
      (-> self camera-underwater?))
    (let ((particle-pos (new 'stack-no-clear 'vector)))
      (vector-copy! particle-pos (-> fish-proc root trans))
      (+! (-> particle-pos y) (meters 0.18))
      (set! (-> particle-pos w) 1.0)
      (fisher-set-particle-fishbox-rotation! self)
      (launch-particles
        :system *sp-particle-system-3d*
        (-> *part-id-table*
          (if
            (= (fisher-fish-species self slot)
              (the-as int (fisher-species fire-canyon-cellfish)))
            3576
            3575))
        particle-pos)))
  (none))

(defun fisher-megaloviathan-center!
  ((fish-proc manipy) (dst vector))
  (singlefish-vector-copy-safe! dst (-> fish-proc root trans))
  (+! (-> dst y) (meters 4.0))
  (set! (-> dst w) 1.0)
  dst)

(defun fisher-megaloviathan-face-point!
  ((self fisher-game) (slot int) (fish-proc manipy) (dst vector))
  (fisher-megaloviathan-center! fish-proc dst)
  (singlefish-vector-add-scaled-safe!
    dst
    dst
    (-> self playfield-axis)
    (* (fisher-fish-direction self slot) (meters 7.0)))
  (set! (-> dst w) 1.0)
  dst)

(defun fisher-megaloviathan-try-special!
  ((self fisher-game) (slot int) (fish-proc manipy))

  (when
    (and
      (= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
      (= (fisher-fish-species self slot) (the-as int (fisher-species megaloviathan)))
      (= (-> self cast-state) 'line-active)
      (-> self casted?)
      (not
        (logtest?
          (-> fish-proc draw status)
          (draw-status hidden))))

    (let ((mega-center (new 'stack-no-clear 'vector))
        (mega-face (new 'stack-no-clear 'vector))
        (hook-pos (new 'stack-no-clear 'vector)))

      (fisher-megaloviathan-center! fish-proc mega-center)
      (fisher-megaloviathan-face-point! self slot fish-proc mega-face)
      (fisher-hook-target! self hook-pos)

      (cond
        ((and
            (= (-> self fish-state) 'reeling)
            (>= (-> self hooked-fish-slot) 0)
            (!= (-> self hooked-fish-slot) slot)
            (!=
              (fisher-fish-species self (-> self hooked-fish-slot))
              (the-as int (fisher-species megaloviathan))))

          (let ((line-start (new 'stack-no-clear 'vector))
              (line-end (new 'stack-no-clear 'vector)))
            (vector-copy! line-start (target-pos 0))
            (+! (-> line-start y) (meters 3.25))
            (set! (-> line-start w) 1.0)
            (fisher-hook-target! self line-end)

            (when
              (fisher-point-near-segment?
                mega-face
                line-start
                line-end
                (meters 1.50))

              (set!
                (-> self dark-eco-displaced-slot)
                (-> self hooked-fish-slot))
              (fisher-clear-button-fight! self)
              (set! (-> self fish-fighting?) #f)
              (set! (-> self fish-fight-time) 0.0)
              (set! (-> self hooked-fish-poison-dps) 0.0)
              (set! (-> self hooked-fish-slot) slot)
              (fisher-begin-hook-transition! self fish-proc hook-pos)
              (set! (-> self fish-hook-time) 0.28)
              (set! (-> self fish-scare-on-arrival?) #f)
              (set! (-> self lure-stop-active?) #f)
              (set! (-> self lure-stop-time) 0.0)
              (set! (-> self lure-sink-active?) #f)
              (set! (-> self lure-sink-time) 0.0)
              (set! (-> self tug-line-active?) #f)
              (set! (-> self tug-line-time) 0.0)
              (fisher-play-fish-bite-sound!)
              (set! (-> self fish-state) 'hook-window)

              (when *fisher-in-debug?*
                (format #t "[FISHER] MEGALOVIATHAN DETECTED ACTIVE FISHING LINE~%"))

              (return #t))))

        ((and
            (< (-> self dark-eco-displaced-slot) 0)
            (!= (-> self fish-state) 'reeling)
            (!= (-> self hooked-fish-slot) slot)
            (<=
              (vector-vector-distance hook-pos mega-face)
              (meters 1.25)))

          (when *fisher-in-debug?*
            (format #t "[FISHER] MEGALOVIATHAN HOOK CORRUPTION~%"))
          (fisher-debug-print-lure-loss! self "MEGALOVIATHAN HOOK CORRUPTION")
          (fisher-begin-lure-stolen-return! self)
          (set! (-> self fish-message) "LINE CORRUPTED")
          (set! (-> self fish-message-time) 1.75)
          (return #t)))))

  #f)

(defun fisher-update-gameplay-fish-one!
  ((self fisher-game) (slot int) (fish (pointer manipy)))

  (when fish
    (let ((fish-proc-basic
          (-> fish 0 self)))

      (when fish-proc-basic
        (let* ((fish-proc
              (the-as manipy fish-proc-basic))

            (dt (-> *display* seconds-per-frame))

            (wanted-pos (new 'stack-no-clear 'vector))

            (hook-target (new 'stack-no-clear 'vector))

            (distance (fisher-fish-distance self slot))

            (direction
              (fisher-fish-direction self slot)))

          (unless (fisher-megaloviathan-try-special! self slot fish-proc)
            (cond
            ((= slot (-> self hooked-fish-slot))
              (if
                (and
                  (logtest?
                    (-> fish-proc draw status)
                    (draw-status hidden))
                  (not
                    (and
                      (= (-> self location-id)
                         (the-as int (fisher-zone finalboss-nuclear)))
                      (= (fisher-fish-species self slot)
                         (the-as int (fisher-species nuclear-bombfish)))
                      (> (-> *fisher-finalboss-runtime* stage) 1)
                      (= (-> self fish-state) 'reeling))))

                (fisher-fish-scared-off! self slot)

                (cond
                ((= (-> self fish-state) 'approaching)
                  (fisher-hook-target! self hook-target)

                  (+!
                    (-> self fish-approach-speed)
                    (* *fisher-approach-acceleration* dt))

                  (let ((remaining
                        (fisher-move-manipy-toward!
                          fish-proc
                          hook-target
                          (meters (-> self fish-approach-speed)))))

                    (when
                      (<= remaining (meters 0.20))

                      (fisher-begin-hook-transition! self fish-proc hook-target)

                      (cond
                        ((-> self fish-scare-on-arrival?)
                          (set! (-> self fish-scare-on-arrival?) #f)

                          (fisher-fish-scared-off!
                            self
                            slot))

                        (else
                          (set!
                            (-> self fish-hook-time)
                            (if
                              (=
                                (-> self location-id)
                                (the-as int (fisher-zone maincave-dark-eco)))
                              0.28
                              (if
                                (fisher-species-snap-on-bite?
                                  (fisher-fish-species self slot))
                                0.45
                                1.15)))

                          (fisher-play-fish-bite-sound!)

                          (set! (-> self lure-sink-active?) #f)
                          (set! (-> self lure-sink-time) 0.0)

                          (set!
                            (-> self fish-state)
                            'hook-window))))))

                ((= (-> self fish-state) 'hook-window)
                  (fisher-hook-target! self hook-target)

                  (fisher-animate-hooked-fish! self fish-proc hook-target #f)

                  (-! (-> self fish-hook-time) dt)

                  (when
                    (<= (-> self fish-hook-time) 0.0)

                    (cond
                      ((fisher-species-snap-on-bite?
                          (fisher-fish-species self slot))
                        (fisher-fish-scared-off! self slot)
                        (fisher-debug-print-lure-loss! self "SNAP-ON-BITE HOOK WINDOW EXPIRED")
                        (fisher-begin-lure-stolen-return! self))

                      (else
                        (fisher-fish-scared-off!
                          self
                          slot)))))

                ((= (-> self fish-state) 'reeling)
                  (fisher-hook-target! self hook-target)

                  (fisher-animate-hooked-fish! self fish-proc hook-target (-> self fish-fighting?))

                  (when (> (-> self fish-hook-time) 0.0)
                    (-! (-> self fish-hook-time) dt)

                    (when (< (-> self fish-hook-time) 0.0)
                      (set! (-> self fish-hook-time) 0.0)))

                  (let* ((species (fisher-fish-species self slot))
                      (info (fisher-species-info-for species))
                      (button-fight? (= (-> info fight-mode) 1))
                      (finalboss-nuclear?
                        (and
                          (= (-> self location-id)
                             (the-as int (fisher-zone finalboss-nuclear)))
                          (= species
                             (the-as int (fisher-species nuclear-bombfish))))))

                    (unless finalboss-nuclear?
                      (when
                        (and
                          (not button-fight?)
                          (> (-> self fish-fight-time) 0.0))

                        (-! (-> self fish-fight-time) dt)
                        (set! (-> self fish-fighting?) #t)

                        (when
                          (<= (-> self fish-fight-time) 0.0)

                          (set! (-> self fish-fight-time) 0.0)
                          (set! (-> self fish-fighting?) #f)
                          (set! (-> self fish-hook-time)
                            (rand-vu-float-range
                              (fmax 0.85 (-> info fight-recover-min))
                              (fmax 0.85 (-> info fight-recover-max))))
                          (set! (-> self fish-fight-phase) (degrees 180.0))))

                      (when
                        (and
                          (<= (-> self fish-hook-time) 0.0)
                          (<= (-> self fish-fight-time) 0.0)
                          (not (-> self fish-fighting?)))

                        (cond
                          ((rand-vu-percent? (-> info fight-chance))
                            (fisher-play-random-fight-sound!)
                            (set! (-> self lure-stop-active?) #f)
                            (set! (-> self lure-stop-time) 0.0)
                            (set! (-> self lure-sink-active?) #f)
                            (set! (-> self lure-sink-time) 0.0)
                            (set! (-> self tug-line-active?) #f)
                            (set! (-> self tug-line-time) 0.0)
                            (set! (-> self fish-fighting?) #t)
                            (set! (-> self fish-fight-phase) 0.0)
                            (set! (-> self fish-fight-base-y) (-> self lure-pos y))

                            (cond
                              (button-fight?
                                (set! (-> self fish-fight-time) 0.0)
                                (fisher-start-button-fight! self))

                              (else
                                (set! (-> self fish-fight-time)
                                  (rand-vu-float-range 1.0 2.1)))))

                          (else
                            (set! (-> self fish-hook-time)
                              (rand-vu-float-range
                                (fmax 0.85 (-> info fight-recover-min))
                                (fmax 0.85 (-> info fight-recover-max))))))))))

                ((or
                    (= (-> self fish-state) 'catch-enter)
                    (= (-> self fish-state) 'catch-display)
                    (= (-> self fish-state) 'catch-exit)
                    (= (-> self fish-state) 'rare-enter)
                    (= (-> self fish-state) 'rare-display)
                    (= (-> self fish-state) 'rare-exit))
                  (fisher-catch-display-fish-position! self hook-target)

                  (set! (-> fish-proc root trans quad) (-> hook-target quad))

                  (fisher-set-manipy-facing! self slot fish-proc)
                  (fisher-apply-slot-appearance! self slot fish-proc #t)))))

            (else
              (fisher-fish-position! self slot wanted-pos)

              (cond
                ((> (fisher-fish-cooldown self slot) 0.0)
                  (let ((speed-scale
                        (if
                          (> (fisher-fish-cooldown self slot) 1.6)
                          1.35
                          1.0)))

                    (+! distance (* direction (fisher-fish-speed self slot) speed-scale dt))

                    (cond
                      ((<= distance (meters 3.5)) (set! distance (meters 3.5)) (fisher-set-fish-direction! self slot 1.0))

                      ((>= distance (fisher-playfield-far-distance self))
                        (set! distance (fisher-playfield-far-distance self))
                        (fisher-set-fish-direction!
                          self
                          slot
                          -1.0)))

                    (fisher-set-fish-distance! self slot distance)

                    (fisher-fish-position! self slot wanted-pos)

                    (set!
                      (-> fish-proc root trans quad)
                      (-> wanted-pos quad)))

                  (fisher-set-fish-cooldown!
                    self
                    slot
                    (fmax
                      0.0
                      (-
                        (fisher-fish-cooldown self slot)
                        dt))))

                (else
                  (when
                    (<= (fisher-fish-turn-time self slot) 0.0)

                    (+! distance (* direction (fisher-fish-speed self slot) dt))

                    (cond
                      ((<= distance (meters 3.5))
                        (set! distance (meters 3.5))

                        (fisher-start-manipy-turn!
                          self
                          slot
                          1.0))

                      ((>= distance (fisher-playfield-far-distance self))
                        (set! distance (fisher-playfield-far-distance self))

                        (fisher-start-manipy-turn!
                          self
                          slot
                          -1.0)))

                    (fisher-set-fish-distance!
                      self
                      slot
                      distance))

                  (fisher-fish-position! self slot wanted-pos)

                  (set!
                    (-> fish-proc root trans quad)
                    (-> wanted-pos quad))))

              (set! (-> fish-proc root trans quad) (-> wanted-pos quad))

              (fisher-set-manipy-facing! self slot fish-proc)

              (fisher-debug-draw-fish-cone! self slot fish-proc)

              (when
                (and
                  (= (-> self hooked-fish-slot) -1)
                  (= (-> self fish-state) 'free)
                  (= (-> self cast-state) 'line-active)

                  (!=
                    (fisher-fish-species self slot)
                    (the-as int (fisher-species megaloviathan)))

                  (not
                    (logtest?
                      (-> fish-proc draw status)
                      (draw-status hidden)))

                  (<= (fisher-fish-cooldown self slot) 0.0)
                  (fisher-manipy-can-sense-lure?
                    self
                    slot
                    fish-proc))

                (set! (-> self hooked-fish-slot) slot)

                (set!
                  (-> self fish-approach-speed)
                  (rand-vu-float-range
                    *fisher-approach-speed-min*
                    *fisher-approach-speed-max*))

                (set!
                  (-> self fish-state)
                  'approaching)))))

          (fisher-apply-slot-appearance!
            self
            slot
            fish-proc
            (or
              (= (-> self fish-state) 'catch-enter)
              (= (-> self fish-state) 'catch-display)
              (= (-> self fish-state) 'catch-exit)
              (= (-> self fish-state) 'rare-enter)
              (= (-> self fish-state) 'rare-display)
              (= (-> self fish-state) 'rare-exit)))

          (fisher-submit-power-cell-fish-particle! self slot fish-proc)

          (fisher-draw-manipy-fish-marker!
            fish)))))

  (none))

(defun fisher-world-to-screen!
  ((self fisher-game) (world-pos vector) (screen-pos vector))

  (when
    (and
      *camera*
      (> (-> *camera* num-slaves) 0))

    (let ((cam-slave (-> *camera* slave 0 0))
        (relative (new 'stack-no-clear 'vector))
        (forward (new 'stack-no-clear 'vector))
        (projected (new 'stack 'vector4w-2))
        (point (new 'stack-no-clear 'vector))
        (depth 0.0))

      (vector-copy! point world-pos)
      (set! (-> point w) 1.0)

      (vector-! relative point (-> cam-slave trans))
      (vector-copy! forward (-> cam-slave tracking inv-mat vector 2))
      (set! (-> forward w) 0.0)
      (singlefish-vector-normalize-safe! forward 1.0)
      (set! depth (vector-dot relative forward))

      (when (> depth (meters 0.10))
        (transform-point-qword!
          (-> projected vector 0)
          point)

        (set! (-> screen-pos x)
          (+
            256.0
            (/ (- (the float (-> projected vector 0 x)) 32768.0) 64.0)))
        (set! (-> screen-pos y)
          (+
            224.0
            (/ (- (the float (-> projected vector 0 y)) 32768.0) 64.0)))
        (set! (-> screen-pos z) depth)
        (set! (-> screen-pos w) 1.0)
        (return #t))))

  #f)

(defun fisher-draw-approaching-question! ((self fisher-game))
  (when
    (and
      (= (-> self fish-state) 'approaching)
      (>= (-> self hooked-fish-slot) 0)
      (-> self camera-underwater?))

    (let ((fish (fisher-fish-pointer self (-> self hooked-fish-slot))))
      (when (and fish (-> fish 0 self))
        (let ((head-pos (new 'stack-no-clear 'vector))
            (screen-pos (new 'stack-no-clear 'vector)))

          (vector-copy!
            head-pos
            (-> (the-as manipy (-> fish 0 self)) root trans))

          (+! (-> head-pos y) (meters 0.72))
          (set! (-> head-pos w) 1.0)

          (when (fisher-world-to-screen! self head-pos screen-pos)
            (let ((screen-x (the int (-> screen-pos x)))
                (screen-y (the int (-> screen-pos y))))
              (when
                (and
                  (> screen-x -32)
                  (< screen-x 544)
                  (> screen-y -32)
                  (< screen-y 440))
                (draw-fisher-large-font-scaled
                  "?"
                  screen-x
                  screen-y
                  0.72))))))))

  (none))

(defun fisher-update-all-fish-debug! ((self fisher-game))
  (dotimes (i *fisher-max-fish-slots*) (fisher-update-gameplay-fish-one! self i (fisher-fish-pointer self i)))

  (fisher-draw-approaching-question! self)

  (none))

(defun singlefish-end-session! ((self fisher-game))
  (fisher-set-resident-fish-visible! self #f)

  (set! *singlefish-session-active?* #t)
  (set! (-> self hooked-fish) #f)
  (set! (-> self hooked-fish-slot) -1)
  (set! (-> self fish-state) 'free)
  (set! (-> self fish-fighting?) #f)
  (fisher-clear-button-fight! self)
  (none))

(defun fisher-launch-camera-bubble! ((self fisher-game))
  (when
    (and *camera* (> (-> *camera* num-slaves) 0))
    (let ((cam-slave (-> *camera* slave 0 0))
        (bubble-pos (new 'stack-no-clear 'vector))
        (forward (new 'stack-no-clear 'vector))
        (right (new 'stack-no-clear 'vector))
        (lane (rand-vu-float-range (meters -5.5) (meters 5.5))))

      (vector-! forward (-> self lure-camera-look) (-> cam-slave trans))
      (set! (-> forward w) 0.0)
      (vector-normalize! forward 1.0)
      (vector-cross! right forward (-> *camera* local-down))
      (set! (-> right w) 0.0)
      (vector-normalize! right 1.0)
      (vector+float*! bubble-pos (-> cam-slave trans) forward (meters 6.0))
      (vector+float*! bubble-pos bubble-pos right lane)

      (cond
        ((= (-> self location-id) (the-as int (fisher-zone village3-lava)))
          (+! (-> bubble-pos y)
            (rand-vu-float-range (meters -2.5) (meters 1.5)))
          (when (>= (-> bubble-pos y) (-> self water-level))
            (set! (-> bubble-pos y)
              (- (-> self water-level) (meters 0.15)))))
        (else
          (vector+float*! bubble-pos bubble-pos (-> *camera* local-down) (meters 4.5))
          (when (>= (-> bubble-pos y) (-> self water-level))
            (set! (-> bubble-pos y)
              (- (-> self water-level) (meters 4.0))))))

      (set! (-> bubble-pos w) 1.0)
      (fisher-set-particle-fishbox-rotation! self)
      (cond
        ((= (-> self location-id) (the-as int (fisher-zone village3-lava)))
          (fisher-submit-lava-yellow-trail! self bubble-pos))
        (else
          (launch-particles
            :system *sp-particle-system-3d*
            (-> *part-id-table* 3570)
            bubble-pos)))))
  (none))

(defun fisher-update-camera-bubbles! ((self fisher-game))
  (let ((dt
        (-> *display* seconds-per-frame)))

    (cond
      ((and
          (-> self casted?)
          (< (-> self lure-pos y) (-> self water-level))
          (or
            (= (-> self location-id) (the-as int (fisher-zone village3-lava)))
            (-> self camera-underwater?)))

        (cond
          ((< (-> self bubble-time) 0.0)
            (+! (-> self bubble-time) dt)

            (when
              (>= (-> self bubble-time) 0.0)

              (fisher-launch-camera-bubble! self)

              (set!
                (-> self bubble-time)
                (if
                  (= (-> self location-id) (the-as int (fisher-zone village3-lava)))
                  (rand-vu-float-range 0.18 0.45)
                  (rand-vu-float-range 0.35 1.10))))
          )

          (else
            (-! (-> self bubble-time) dt)

            (when
              (<= (-> self bubble-time) 0.0)

              (fisher-launch-camera-bubble! self)

              (set!
                (-> self bubble-time)
                (if
                  (= (-> self location-id) (the-as int (fisher-zone village3-lava)))
                  (rand-vu-float-range 0.18 0.45)
                  (rand-vu-float-range 0.35 1.10))))
          )
        )
      )

      (else (set! (-> self bubble-time) -2.0))
    )
  )

  (none)
)

(defun fisher-start-cast! ((self fisher-game))
  (set! *fisher-line-hp-max*
    (cond
      ((fisher-finalboss-zone? self) 100.0)
      ((>= (fisher-current-level) *fisher-line-hp-upgrade-level*)
        *fisher-line-hp-upgrade-max*)
      (else
        (+ 15.0 (* 85.0 (-> self cast-charge))))))

  (fisher-reset-line-hp!)
  (set! (-> self electric-slot) -1)
  (fisher-reset-electric-cycle! self)

  (let ((cast-distance
        (if
          (fisher-finalboss-zone? self)
          *fisher-finalboss-lure-distance*
          (+
            (meters 3.5)
            (* (meters 52.0)
              (-> self cast-charge))))))

    (vector-copy! (-> self lure-cast-start) (target-pos 0))

    (play-sound-file "cast.wav" (the int (-> *setting-control* current sfx-volume)))

    (+! (-> self lure-cast-start y) (meters 1.4))

    (vector-copy! (-> self lure-cast-axis) (-> self playfield-axis))

    (vector+float*! (-> self lure-cast-end) (-> self lure-cast-start) (-> self lure-cast-axis) cast-distance)

    (set! (-> self lure-cast-end y) (-> self water-level))

    (set! (-> self lure-cast-end w) 1.0)

    (vector-copy! (-> self lure-pos) (-> self lure-cast-start))

    (fisher-remove-lure-snake! self)

    (let ((snake-anchor
          (new 'stack-no-clear 'vector))

        (snake-root
          (new 'stack-no-clear 'vector)))

      (vector-copy! snake-anchor (-> self lure-pos))

      (set! (-> snake-anchor w) 1.0)

      (vector-copy! snake-root snake-anchor)

      (-! (-> snake-root y) (meters 1.0666667))

      (set! (-> snake-root w) 1.0)

      (vector-copy! (-> self lure-snake-last-anchor) snake-anchor)

      (vector-reset! (-> self lure-snake-angle))

      (vector-reset! (-> self lure-snake-angular-speed))

      (set! (-> self lure-snake-flow-time) 0.0)

      (set! (-> self lure-snake) (spawn-fisher-lure-snake snake-root))
    )

    (let ((cam-slave
          (-> *camera* slave 0 0)))

      (vector-float*! (-> self lure-camera-offset) (-> self camera-axis) (- (-> self camera-radius)))

      (set! (-> self lure-camera-offset y) 0.0)

      (set! (-> self lure-camera-offset w) 0.0)

      (vector-copy! (-> self fisher-cam) (-> cam-slave trans))
    )

    (set! (-> self cast-time) 0.0)
    (set! (-> self camera-blend) 0.0)
    (set! (-> self cast-duration) 1.0)
    (set! (-> self casted?) #t)
    (set! (-> self reel-hint-time) 6.0)

    (set! (-> self lure-x-velocity) 0.0)
    (set! (-> self lure-y-velocity) 0.0)

    (set! (-> self cast-state) 'casting)
    (set! (-> self camera-state) 'follow-lure)
  )

  (none)
)

(defun fisher-update-cast-arc! ((self fisher-game))
  (let* ((dt (-> *display* seconds-per-frame))
      (t (fmin 1.0 (/ (-> self cast-time) (-> self cast-duration))))
      (arc-height
        (* (meters 5.0)
          (* 4.0
            t
            (- 1.0 t)))))

    (vector-lerp! (-> self lure-pos) (-> self lure-cast-start) (-> self lure-cast-end) t)

    (+! (-> self lure-pos y) arc-height)

    (+! (-> self cast-time) dt)

    (when (>= t 1.0)
      (vector-copy! (-> self lure-pos) (-> self lure-cast-end))

      (set! (-> self lure-x-velocity) 0.87)

      (set! (-> self lure-y-velocity) -2.0)

      (fisher-launch-water-entry-bubbles! self)
      (play-sound-file "splash.wav" (the int (-> *setting-control* current sfx-volume)))

      (set!
        (-> self cast-state)
        'water-entry))
  )

  (none)
)

(defun fisher-set-background-curtain-color!
  ((dst rgba)
    (base-color vector)
    (brightness float))

  (set!
    (-> dst r)
    (the uint8
      (fmax
        0.0
        (fmin
          255.0
          (* (-> base-color x) brightness)))))

  (set!
    (-> dst g)
    (the uint8
      (fmax
        0.0
        (fmin
          255.0
          (* (-> base-color y) brightness)))))

  (set!
    (-> dst b)
    (the uint8
      (fmax
        0.0
        (fmin
          255.0
          (* (-> base-color z) brightness)))))

  (set! (-> dst a) #xff)

  (none))

(defun fisher-update-background-curtain-colors! ()
  (let ((base-color
        (new 'stack-no-clear 'vector)))

    (fisher-background-color! base-color)

    (fisher-set-background-curtain-color! *fisher-curtain-color-0a* base-color 1.00)
    (fisher-set-background-curtain-color! *fisher-curtain-color-0b* base-color 1.00)

    (fisher-set-background-curtain-color! *fisher-curtain-color-1a* base-color 1.00)
    (fisher-set-background-curtain-color! *fisher-curtain-color-1b* base-color 1.00)

    (fisher-set-background-curtain-color! *fisher-curtain-color-2a* base-color 1.00)
    (fisher-set-background-curtain-color! *fisher-curtain-color-2b* base-color 1.00)

    (fisher-set-background-curtain-color! *fisher-curtain-color-3a* base-color 1.00)
    (fisher-set-background-curtain-color! *fisher-curtain-color-3b* base-color 1.00)

    (fisher-set-background-curtain-color! *fisher-curtain-color-4a* base-color 1.00)
    (fisher-set-background-curtain-color! *fisher-curtain-color-4b* base-color 1.00)

    (fisher-set-background-curtain-color! *fisher-curtain-color-5a* base-color 1.00)
    (fisher-set-background-curtain-color! *fisher-curtain-color-5b* base-color 1.00))

  (none))

(defun fisher-add-retail-flat-triangle!
  ((buf dma-buffer)
    (world-p0 vector)
    (world-p1 vector)
    (world-p2 vector)
    (color rgba))

  (let ((screen-points-a
        (new 'stack 'vector4w-2))

      (screen-points-b
        (new 'stack 'vector4w-2)))

    (set! (-> world-p0 w) 1.0)
    (set! (-> world-p1 w) 1.0)
    (set! (-> world-p2 w) 1.0)

    (when
      (and
        (transform-point-qword!
          (-> screen-points-a vector 0)
          world-p0)

        (transform-point-qword!
          (-> screen-points-a vector 1)
          world-p1)

        (transform-point-qword!
          (-> screen-points-b vector 0)
          world-p2))

      (set! (-> screen-points-a vector 0 w) 1)
      (set! (-> screen-points-a vector 1 w) 1)
      (set! (-> screen-points-b vector 0 w) 1)

      (set!
        (-> screen-points-b vector 1 x)
        (the-as int (-> color r)))

      (set!
        (-> screen-points-b vector 1 y)
        (the-as int (-> color g)))

      (set!
        (-> screen-points-b vector 1 z)
        (the-as int (-> color b)))

      (set!
        (-> screen-points-b vector 1 w)
        (the-as int (-> color a)))

      (dma-buffer-add-gif-tag
        buf
        (new 'static
          'gif-tag64
          :nloop 1
          :pre 1
          :nreg 6
          :prim (gif-prim tri))
        (gs-reg-list
          rgbaq
          xyzf2
          rgbaq
          xyzf2
          rgbaq
          xyzf2))

      (dma-buffer-add-uint128
        buf
        (-> screen-points-b quad 1)
        (-> screen-points-a quad 0)
        (-> screen-points-b quad 1)
        (-> screen-points-a quad 1)
        (-> screen-points-b quad 1)
        (-> screen-points-b quad 0))))

  (none))

(defun fisher-force-dark-eco-underwater-background! ()
  (dotimes (i 12)
    (set! (-> sky-base-polygons i col x) 7.0)
    (set! (-> sky-base-polygons i col y) 0.0)
    (set! (-> sky-base-polygons i col z) 18.0)
    (set! (-> sky-base-polygons i col w) 128.0))
  (fisher-force-underwater-horizon! 7.0 0.0 18.0)
  (none))

(defun fisher-submit-dark-eco-background! ((self fisher-game))
  (when
    (and
      (or
        (= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
        (= (-> self location-id) (the-as int (fisher-zone finalboss-nuclear))))
      *fisher-background-cloud-session-active?*
      (-> self casted?)
      (-> self camera-underwater?))

    (-! (-> self background-mist-time) (-> *display* seconds-per-frame))
    (when (<= (-> self background-mist-time) 0.0)
      (set! (-> self background-mist-time) 0.18)

      (let ((forward (new 'stack-no-clear 'vector))
          (side (new 'stack-no-clear 'vector))
          (center (new 'stack-no-clear 'vector))
          (particle-pos (new 'stack-no-clear 'vector)))

        (singlefish-vector-copy-safe! forward (-> self camera-axis))
        (set! (-> forward y) 0.0)
        (set! (-> forward w) 0.0)
        (singlefish-vector-normalize-safe! forward 1.0)

        (set! (-> side x) (-> forward z))
        (set! (-> side y) 0.0)
        (set! (-> side z) (- (-> forward x)))
        (set! (-> side w) 0.0)
        (singlefish-vector-normalize-safe! side 1.0)

        (singlefish-vector-add-scaled-safe!
          center
          (-> self fisher-cam)
          forward
          (if
            (= (-> self location-id) (the-as int (fisher-zone finalboss-nuclear)))
            (meters 25.5)
            (meters 27.0)))
        (singlefish-vector-add-scaled-safe!
          center
          center
          (-> self playfield-axis)
          (meters 27.75))
        (set! (-> center y) (+ (-> self water-level) (meters 16.0)))
        (set! (-> center w) 1.0)

        (dotimes (i 5)
          (singlefish-vector-add-scaled-safe!
            particle-pos
            center
            side
            (rand-vu-float-range (meters -48.0) (meters 48.0)))
          (set!
            (-> particle-pos y)
            (+
              (-> center y)
              (rand-vu-float-range (meters -32.0) (meters 18.0))))
          (set! (-> particle-pos w) 1.0)

          (launch-particles
            :system *sp-particle-system-3d*
            (-> *part-id-table* 3586)
            particle-pos))

        (dotimes (i 2)
          (singlefish-vector-add-scaled-safe!
            particle-pos
            center
            side
            (rand-vu-float-range (meters -52.0) (meters 52.0)))
          (set!
            (-> particle-pos y)
            (+
              (-> center y)
              (rand-vu-float-range (meters -34.0) (meters 20.0))))
          (set! (-> particle-pos w) 1.0)

          (process-spawn
            part-tracker
            :init
            part-tracker-init
            group-dark-eco-pool-nasty
            -1
            #f
            #f
            #f
            particle-pos
            :to
            *entity-pool*)))))

  (none))

(defun fisher-build-background-curtain-vertex!
  ((self fisher-game)
    (dst vector)
    (curtain-center vector)
    (curtain-forward vector)
    (curtain-side vector)
    (column int)
    (row int))

  (let* ((u
        (/ (the float column) 20.0))

      (v
        (/ (the float row) 12.0))

      (side-distance
        (+ (meters -180.0)
          (* (meters 360.0) u)))

      (base-y
        (+
          (if
            (or
              (=
                (-> self location-id)
                (the-as int (fisher-zone swamp-sludge)))
              (=
                (-> self location-id)
                (the-as int (fisher-zone village3-lava))))
            (-> curtain-center y)
            (-> self water-level))
          (meters -0.75)
          (* (meters -118.5) v)))

      (phase
        (-> self background-curtain-phase))

      (wave-angle-a
        (+
          phase
          (* (degrees 41.0) (the float column))
          (* (degrees 19.0) (the float row))))

      (wave-angle-b
        (+
          (* phase -0.63)
          (* (degrees 83.0) (the float column))
          (* (degrees -27.0) (the float row))))

      (wave-angle-y
        (+
          (* phase 0.78)
          (* (degrees 31.0) (the float column))
          (* (degrees 46.0) (the float row))))

      (forward-wave
        (if
          (=
            (-> self location-id)
            (the-as int (fisher-zone swamp-sludge)))
          0.0
          (+
            (* (meters 0.90) (sin wave-angle-a))
            (* (meters 0.38) (sin wave-angle-b)))))

      (vertical-wave
        (+
          (* (meters 0.24) (sin wave-angle-y))
          (* (meters 0.10) (sin wave-angle-b)))))

    (vector+float*!
      dst
      curtain-center
      curtain-side
      side-distance)

    (vector+float*!
      dst
      dst
      curtain-forward
      forward-wave)

    (set! (-> dst y) (+ base-y vertical-wave))
    (set! (-> dst w) 1.0))

  dst)

(defun fisher-draw-background-curtain!
  ((self fisher-game))

  (when
    (and
      (-> self casted?)
      (-> self camera-underwater?)
      (current-frame)
      (-> (current-frame) global-buf))

    (+!
      (-> self background-curtain-phase)
      (*
        (if
          (= (-> self location-id) (the-as int (fisher-zone village3-lava)))
          (degrees 48.0)
          (degrees 24.0))
        (-> *display* seconds-per-frame)))

    (let ((phase-limit
          (if
            (= (-> self location-id) (the-as int (fisher-zone village3-lava)))
            (degrees 720.0)
            (degrees 360.0))))
      (when
        (>= (-> self background-curtain-phase) phase-limit)
        (-! (-> self background-curtain-phase) phase-limit)))

    (let ((p00
          (new 'stack-no-clear 'vector))

        (p01
          (new 'stack-no-clear 'vector))

        (p10
          (new 'stack-no-clear 'vector))

        (p11
          (new 'stack-no-clear 'vector))

        (curtain-center
          (new 'stack-no-clear 'vector))

        (curtain-forward
          (new 'stack-no-clear 'vector))

        (curtain-side
          (new 'stack-no-clear 'vector))

        (curtain-color
          (new 'static 'rgba
            :r #x00
            :g #x00
            :b #x00
            :a #xff)))

      (vector-copy!
        curtain-forward
        (-> self camera-axis))

      (set! (-> curtain-forward y) 0.0)
      (set! (-> curtain-forward w) 0.0)

      (vector-normalize!
        curtain-forward
        1.0)

      (set! (-> curtain-side x) (-> curtain-forward z))
      (set! (-> curtain-side y) 0.0)
      (set! (-> curtain-side z) (- (-> curtain-forward x)))
      (set! (-> curtain-side w) 0.0)

      (vector-normalize!
        curtain-side
        1.0)

      (cond
        ((or
            (=
              (-> self location-id)
              (the-as int (fisher-zone swamp-sludge)))
            (=
              (-> self location-id)
              (the-as int (fisher-zone village3-lava)))
            (=
              (-> self location-id)
              (the-as int (fisher-zone maincave-dark-eco)))
            (=
              (-> self location-id)
              (the-as int (fisher-zone finalboss-nuclear))))
          (vector+float*!
            curtain-center
            (-> self fisher-cam)
            curtain-forward
            (if
              (or
                (= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
                (= (-> self location-id) (the-as int (fisher-zone finalboss-nuclear))))
              (meters 30.0)
              (meters 32.0)))

          (vector+float*!
            curtain-center
            curtain-center
            (-> self playfield-axis)
            (meters 27.75)))

        (else
          (vector+float*!
            curtain-center
            (-> self fisher-cam)
            curtain-forward
            (meters 92.0))

          (vector+float*!
            curtain-center
            curtain-center
            (-> self playfield-axis)
            (meters 27.75))))

      (cond
        ((=
            (-> self location-id)
            (the-as int (fisher-zone village3-lava)))
          (set!
            (-> curtain-center y)
            (+ (-> self water-level) (meters 34.0))))

        ((=
            (-> self location-id)
            (the-as int (fisher-zone swamp-sludge)))
          (set!
            (-> curtain-center y)
            (+ (-> self water-level) (meters 12.0))))

        ((or
            (= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
            (= (-> self location-id) (the-as int (fisher-zone finalboss-nuclear))))
          (set!
            (-> curtain-center y)
            (+ (-> self water-level) (meters 16.0))))

        (else
          (set! (-> curtain-center y) (-> self water-level))))
      (set! (-> curtain-center w) 1.0)

      (let ((active-curtain-color
              (new 'stack-no-clear 'vector)))

        (cond
          ((=
              (-> self location-id)
              (the-as int (fisher-zone misty-island)))
            (fisher-misty-curtain-color! active-curtain-color))

          ((=
              (-> self location-id)
              (the-as int (fisher-zone village2-electric)))
            (fisher-village2-curtain-color! active-curtain-color))

          ((=
              (-> self location-id)
              (the-as int (fisher-zone swamp-sludge)))
            (fisher-swamp-curtain-color! active-curtain-color))

          ((=
              (-> self location-id)
              (the-as int (fisher-zone village3-lava)))
            (fisher-village3-curtain-color! self active-curtain-color))

          ((or
              (= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
              (= (-> self location-id) (the-as int (fisher-zone finalboss-nuclear))))
            (set-vector! active-curtain-color 3.0 0.0 5.0 255.0))

          (else
            (set!
              (-> active-curtain-color quad)
              (-> *fisher-underwater-haze-color* quad))))

        (set!
          (-> curtain-color r)
          (the uint8
            (fmax
              0.0
              (fmin 255.0 (-> active-curtain-color x)))))

        (set!
          (-> curtain-color g)
          (the uint8
            (fmax
              0.0
              (fmin 255.0 (-> active-curtain-color y)))))

        (set!
          (-> curtain-color b)
          (the uint8
            (fmax
              0.0
              (fmin 255.0 (-> active-curtain-color z)))))

        (set! (-> curtain-color a) #xff))

      (with-dma-buffer-add-bucket
        ((buf (-> (current-frame) global-buf))
          (bucket-id sprite))

        (dma-buffer-add-gs-set
          buf
          (zbuf-1
            (new 'static
              'gs-zbuf
              :zbp #x1c0
              :psm (gs-psm ct24)))
          (test-1
            (new 'static
              'gs-test
              :ate #x0
              :zte #x1
              :ztst (gs-ztest greater-equal))))

        (with-cnt-vif-block
          (buf)

          (dotimes (row 12)
            (dotimes (column 20)
              (fisher-build-background-curtain-vertex!
                self
                p00
                curtain-center
                curtain-forward
                curtain-side
                column
                row)

              (fisher-build-background-curtain-vertex!
                self
                p01
                curtain-center
                curtain-forward
                curtain-side
                (+ column 1)
                row)

              (fisher-build-background-curtain-vertex!
                self
                p10
                curtain-center
                curtain-forward
                curtain-side
                column
                (+ row 1))

              (fisher-build-background-curtain-vertex!
                self
                p11
                curtain-center
                curtain-forward
                curtain-side
                (+ column 1)
                (+ row 1))

              (fisher-add-retail-flat-triangle!
                buf
                p00
                p01
                p10
                curtain-color)

              (fisher-add-retail-flat-triangle!
                buf
                p10
                p01
                p11
                curtain-color)))

          (dma-buffer-add-gif-tag
            buf
            (new 'static
              'gif-tag64
              :nloop 1
              :eop 1
              :nreg 1)
            (gs-reg-list prim))

          (dma-buffer-add-uint128
            buf
            (the-as uint128 0))))))

  (none))

(defun fisher-update-underwater-background! ((self fisher-game))
  (fisher-update-camera-water! self)
  (fisher-update-underwater-waves! self)
  (fisher-restore-sky-base-position!)

  (cond
    ((-> self camera-underwater?)
      (cond
        ((=
            (-> self location-id)
            (the-as int (fisher-zone swamp-sludge)))
          (fisher-force-swamp-underwater-background!))

        ((=
            (-> self location-id)
            (the-as int (fisher-zone village3-lava)))
          (fisher-force-lava-underwater-background! self))

        ((or
            (= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
            (= (-> self location-id) (the-as int (fisher-zone finalboss-nuclear))))
          (fisher-force-dark-eco-underwater-background!))

        (else
          (fisher-force-underwater-background!)))

      (when
        (!= (-> self location-id) (the-as int (fisher-zone sunken-voltage)))
        (when
          (!= (-> self location-id) (the-as int (fisher-zone snow-ice)))
          (fisher-draw-background-curtain! self))

        (when
          (and
            (!= (-> self location-id) (the-as int (fisher-zone village3-lava)))
            (!= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
            (!= (-> self location-id) (the-as int (fisher-zone finalboss-nuclear))))
          (fisher-submit-background-mist! self))

        (when
          (or
            (= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
            (= (-> self location-id) (the-as int (fisher-zone finalboss-nuclear))))
          (fisher-submit-dark-eco-background! self))

        (when
          (and
            (!= (-> self location-id) (the-as int (fisher-zone swamp-sludge)))
            (!= (-> self location-id) (the-as int (fisher-zone village3-lava)))
            (!= (-> self location-id) (the-as int (fisher-zone snow-ice)))
            (!= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
            (!= (-> self location-id) (the-as int (fisher-zone finalboss-nuclear))))
          (fisher-submit-god-rays! self))))

    (else
      (set!
        *fisher-underwater-haze-override?*
        #f)))

  (none)
)

(defun fisher-update-water-entry! ((self fisher-game))
  (let* ((dt
        (-> *display* seconds-per-frame))

      (entry-depth (meters 3.0))

      (entry-bottom (- (-> self water-level) entry-depth))

      (current-depth (fmax 0.0 (- (-> self water-level) (-> self lure-pos y))))

      (depth-progress (fmin 1.0 (/ current-depth entry-depth)))

      (smooth-progress (* depth-progress depth-progress (- 3.0 (* 2.0 depth-progress))))

      (level-speed-mult
        (fisher-level-lure-speed-multiplier))

      (starting-y-speed
        (* -2.0 level-speed-mult))

      (ending-y-speed
        (- (* (-> self lure-fall-speed) level-speed-mult))))

    (set!
      (-> self lure-y-velocity)
      (+
        (* starting-y-speed (- 1.0 smooth-progress))

        (* ending-y-speed
          smooth-progress)))

    (set! (-> self lure-x-velocity) (* 0.87 (- 1.0 smooth-progress)))

    (vector+float*! (-> self lure-pos) (-> self lure-pos) (-> self lure-cast-axis) (* (meters 1.0) (-> self lure-x-velocity) dt))

    (+! (-> self lure-pos y) (* (meters 1.0) (-> self lure-y-velocity) dt))

    (when (fisher-finalboss-zone? self)
      (fisher-finalboss-center-lure-horizontal! self))

    (when
      (<= (-> self lure-pos y) entry-bottom)

      (set! (-> self lure-pos y) entry-bottom)

      (set! (-> self lure-x-velocity) 0.0)

      (set!
        (-> self lure-y-velocity)
        (- (* (-> self lure-fall-speed) level-speed-mult)))

      (set!
        (-> self cast-state)
        'line-active))
  )

  (none)
)

(defun fisher-camera-follow-lure! ((self fisher-game))
  (when (and *camera* (> (-> *camera* num-slaves) 0))
    (let ((cam-slave (-> *camera* slave 0 0))
        (desired-camera (new 'stack-no-clear 'vector))
        (desired-look (new 'stack-no-clear 'vector))
        (camera-offset (new 'stack-no-clear 'vector))
        (reel-offset (new 'stack-no-clear 'vector))
        (forward (new 'stack-no-clear 'vector))
        (blend-value 0.0)
        (reel-blend-value 0.0)
        (blend-speed 2.5)
        (reel-zoom-speed 1.8)
        (reel-distance (meters 9.0)))

      (cond
        ((and
            (= (-> self fish-state) 'reeling)
            (>= (-> self hooked-fish-slot) 0))

          (+!
            (-> self reel-camera-blend)
            (* reel-zoom-speed (-> *display* seconds-per-frame)))

          (when (> (-> self reel-camera-blend) 1.0)
            (set! (-> self reel-camera-blend) 1.0)))

        (else
          (-!
            (-> self reel-camera-blend)
            (* 2.6 (-> *display* seconds-per-frame)))

          (when (< (-> self reel-camera-blend) 0.0)
            (set! (-> self reel-camera-blend) 0.0))))

      (set!
        reel-distance
        (if
          (fisher-finalboss-zone? self)
          (meters 9.5)
          (fmin
            (-> self camera-radius)
            (fisher-hooked-fish-camera-distance self))))

      (vector-copy! camera-offset (-> self lure-camera-offset))

      (vector-float*! reel-offset (-> self camera-axis) (- reel-distance))
      (set! (-> reel-offset y) 0.0)
      (set! (-> reel-offset w) 0.0)

      (set!
        reel-blend-value
        (parameter-ease-sin-clamp (-> self reel-camera-blend)))

      (vector-lerp!
        camera-offset
        (-> self lure-camera-offset)
        reel-offset
        reel-blend-value)

      (vector+! desired-camera (-> self lure-pos) camera-offset)

      (vector-copy! desired-look (-> self lure-pos))

      (+!
        (-> desired-look y)
        (if
          (and
            (>= (-> self hooked-fish-slot) 0)
            (or
              (= (fisher-fish-species self (-> self hooked-fish-slot)) 3)
              (= (fisher-fish-species self (-> self hooked-fish-slot))
                (the-as int (fisher-species fire-canyon-cellfish)))))
          (meters 1.15)
          (meters 0.5)))

      (when
        (< (-> self camera-blend) 1.0)

        (+! (-> self camera-blend) (* blend-speed (-> *display* seconds-per-frame)))

        (when
          (> (-> self camera-blend) 1.0)

          (set!
            (-> self camera-blend)
            1.0)))

      (set! blend-value (parameter-ease-sin-clamp (-> self camera-blend)))

      (vector-lerp! (-> self lure-camera-pos) (-> self fisher-cam) desired-camera blend-value)

      (vector-lerp! (-> self lure-camera-look) (-> self fisher-look) desired-look blend-value)

      (set! (-> cam-slave saved-pt quad) (-> self lure-camera-pos quad))

      (set! (-> cam-slave trans quad) (-> self lure-camera-pos quad))

      (vector-! forward (-> self lure-camera-look) (-> self lure-camera-pos))

      (let ((horizontal-length
            (sqrtf
              (+
                (* (-> forward x) (-> forward x))

                (* (-> forward z)
                  (-> forward z))))))

        (when (> horizontal-length 0.0)
          (set!
            (-> forward x)
            (*
              (/ (-> forward x) horizontal-length)

              (cos (degrees -5))))

          (set!
            (-> forward z)
            (*
              (/ (-> forward z) horizontal-length)

              (cos (degrees -5))))

          (set! (-> forward y) (sin (degrees -5)))

          (set!
            (-> forward w)
            0.0)))

      (vector-normalize! forward 1.0)

      (forward-down->inv-matrix (-> cam-slave tracking inv-mat) forward (-> *camera* local-down))))

  (none))

(defun fisher-camera-before-cast! ((self fisher-game))
  (when (and *camera* (> (-> *camera* num-slaves) 0))
    (let ((cam-slave (-> *camera* slave 0 0))
        (forward (new 'stack-no-clear 'vector))
        (look-pos (new 'stack-no-clear 'vector))
        (camera-pos (new 'stack-no-clear 'vector)))

      (cond
        ((= (-> self location-id) 1) (vector-copy! camera-pos (-> self fisher-cam)))

        (else
          (vector+float*! camera-pos (-> self pos) (-> self camera-axis) (- (-> self camera-radius)))

          (set! (-> camera-pos y) (-> self fisher-cam y))

          (set!
            (-> camera-pos w)
            1.0)))

      (vector-copy! look-pos (-> self pos))

      (+! (-> look-pos y) (meters 1.0))

      (vector-copy! (-> self fisher-look) look-pos)

      (set! (-> cam-slave saved-pt quad) (-> camera-pos quad))

      (set! (-> cam-slave trans quad) (-> camera-pos quad))

      (vector-! forward look-pos camera-pos)

      (vector-normalize! forward 1.0)

      (forward-down->inv-matrix (-> cam-slave tracking inv-mat) forward (-> *camera* local-down))
    )
  )

  (none)
)

(defun fisher-draw-line! ((self fisher-game))
  (when
    (and
      *target*
      (-> self casted?))

    (let ((line-start
          (new 'stack-no-clear 'vector))

        (line-end
          (new 'stack-no-clear 'vector))

        (line-color
          (new 'static 'rgba
            :r #x20
            :g #xe0
            :b #x40
            :a #xc0)))

      (let ((line-health-ratio
            (fmax
              0.0
              (fmin
                1.0
                (/ *fisher-line-hp* *fisher-line-hp-max*))))

          (line-color-blend
            0.0))

        (cond
          ((>= line-health-ratio 0.5)
            (set!
              line-color-blend
              (* (- 1.0 line-health-ratio) 2.0))

            (set!
              (-> line-color r)
              (the uint8
                (* 255.0 line-color-blend)))

            (set! (-> line-color g) #xff)
            (set! (-> line-color b) #x00))

          (else
            (set!
              line-color-blend
              (* line-health-ratio 2.0))

            (set! (-> line-color r) #xff)

            (set!
              (-> line-color g)
              (the uint8
                (* 255.0 line-color-blend)))

            (set! (-> line-color b) #x00)))

        (set! (-> line-color a) #xc0))

      (when
        (or
          (= (-> self electric-state) 'line-charge)
          (> (-> self electric-line-stun-time) 0.0))
        (set! (-> line-color r) #x18)
        (set! (-> line-color g) #xb8)
        (set! (-> line-color b) #xff)
        (set! (-> line-color a) #xe8))

      (vector-copy!
        line-start
        (target-pos 0))

      (+!
        (-> line-start y)
        (meters 3.25))

      (cond
        ((fisher-finalboss-zone? self)
          (vector-copy! line-end (-> self lure-pos))
          (set! (-> line-end w) 1.0))
        (else
          (fisher-hook-target! self line-end)))

      (fisher-draw-retail-line!
        self
        line-start
        line-end
        line-color)))

  (none))

(defun fisher-handle-fish-input! ((self fisher-game))
  (cond
    ((and
        (= (-> self fish-state) 'approaching)
        (cpad-pressed? 0 x))

      (cpad-clear! 0 x)
      (when (>= (-> self hooked-fish-slot) 0)
        (fisher-fish-scared-off!
          self
          (-> self hooked-fish-slot))))

    ((and
        (= (-> self fish-state) 'hook-window)
        (cpad-pressed? 0 x))

      (cpad-clear! 0 x)

      (when
        (and
          (= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
          (>= (-> self hooked-fish-slot) 0)
          (=
            (fisher-fish-species self (-> self hooked-fish-slot))
            (the-as int (fisher-species megaloviathan)))
          (>= (-> self dark-eco-displaced-slot) 0))
        (fisher-delete-resident-slot! self (-> self dark-eco-displaced-slot))
        (set! (-> self dark-eco-displaced-slot) -1))

      (set! (-> self fish-state) 'reeling)
      (set! (-> self fish-scare-on-arrival?) #f)
      (set! (-> self fish-reel-progress) 0.0)
      (set! (-> self fish-fight-phase) 0.0)
      (set! (-> self fish-fight-base-y) (-> self lure-pos y))
      (set! (-> self reel-camera-blend) 0.0)

      (set!
        (-> self hooked-fish-poison-dps)
        (if
          (and
            (>= (-> self hooked-fish-slot) 0)
            (=
              (fisher-fish-species self (-> self hooked-fish-slot))
              5))
          *fisher-poison-eelfish-dps*
          0.0))

      (set! (-> self fish-hook-time) 0.65)
      (set! (-> self fish-fight-time) 0.0)
      (set! (-> self fish-fighting?) #f)
      (set! (-> self lure-stop-active?) #f)
      (set! (-> self lure-stop-time) 0.0)
      (set! (-> self lure-sink-active?) #f)
      (set! (-> self lure-sink-time) 0.0)
      (set! (-> self tug-line-active?) #f)
      (set! (-> self tug-line-time) 0.0)
      (fisher-clear-button-fight! self)

      (when
        (and
          (fisher-finalboss-zone? self)
          (>= (-> self hooked-fish-slot) 0)
          (=
            (fisher-fish-species self (-> self hooked-fish-slot))
            (the-as int (fisher-species nuclear-bombfish))))
        (fisher-finalboss-begin-fight! self)))

    ((and
        (= (-> self fish-state) 'catch-display)
        (cpad-pressed? 0 x))

      (cpad-clear! 0 x)
      (set! (-> self fish-state) 'catch-exit)
      (set! (-> self catch-transition-time) 0.0))

    ((and
        (= (-> self fish-state) 'rare-display)
        (cpad-pressed? 0 x))

      (cpad-clear! 0 x)
      (set! (-> self fish-state) 'rare-exit)
      (set! (-> self catch-transition-time) 0.0)))

  (none))

(defun fisher-draw-fishing-clock! ()
  (when
    (and
      *fisher-session-active?*
      (>= (fisher-current-level) *fisher-fishing-clock-unlock-level*)
      *time-of-day-context*
      (current-frame)
      (-> (current-frame) global-buf))

    (let* ((time-value
          (-> *time-of-day-context* time))

        (hour-24
          (the int time-value))

        (minute
          (the int
            (*
              (- time-value (the float hour-24))
              60.0)))

        (hour-12
          (cond
            ((= hour-24 0) 12)
            ((> hour-24 12) (- hour-24 12))
            (else hour-24)))

        (am?
          (< hour-24 12))

        (clock-color
          (if
            (fisher-golden-hour?)
            (font-color yellow)
            (font-color green))))

      (clear matt-str)
      (clear *pc-encoded-matt-str*)

      (cond
        ((< minute 10)
          (format
            matt-str
            "~D:0~D ~A"
            hour-12
            minute
            (if am? "AM" "PM")))

        (else
          (format
            matt-str
            "~D:~D ~A"
            hour-12
            minute
            (if am? "AM" "PM"))))

      (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)

      (with-dma-buffer-add-bucket
        ((buf (-> (current-frame) global-buf))
          (bucket-id subtitle))

        (draw-string-xy-scaled
          *pc-encoded-matt-str*
          buf
          488
          18
          clock-color
          (font-flags large right shadow kerning)
          0.52))))

  (none))





(defun fisher-draw-lure-skill-message! ((self fisher-game))
  (when (> (-> self skill-message-time) 0.0)
    (when (-> self skill-message)
      (draw-fisher-large-font-scaled
        (the-as string (-> self skill-message))
        256
        116
        0.38))

    (-!
      (-> self skill-message-time)
      (-> *display* seconds-per-frame))

    (when (<= (-> self skill-message-time) 0.0)
      (set! (-> self skill-message-time) 0.0)
      (set! (-> self skill-message) #f)))

  (none))

(defun fisher-draw-fish-status! ((self fisher-game))
  (cond
    ((and
        (fisher-finalboss-zone? self)
        (= (-> self fish-state) 'reeling))
      (fisher-finalboss-draw-ui! self))
    (else

  (when
    (and
      (or *fisher-in-debug?* (>= (fisher-current-level) *fisher-rip-line-unlock-level*))
      (= (-> self fish-state) 'reeling)
      (-> self fish-fighting?)
      (not (-> self button-fight-data active?))
      (<= (-> self rip-line-cooldown) 0.0))

    (fisher-draw-reel-hint-text
      "<PAD_CIRCLE> TUG LINE"
      10
      138
      0.52))

  (when (> (-> self fish-message-time) 0.0)
    (when
      (-> self fish-message)

      (draw-mod-menu-text-custom
        (the-as string (-> self fish-message))
        256
        116
        #f
        #t
        #f))

    (-!
      (-> self fish-message-time)
      (-> *display* seconds-per-frame))

    (when
      (<= (-> self fish-message-time) 0.0)

      (set! (-> self fish-message-time) 0.0)
      (set! (-> self fish-message) #f)))

  (cond

    ((= (-> self fish-state) 'hook-window)
      (draw-mod-menu-text-custom
        "PRESS <PAD_X> TO HOOK"
        256
        116
        #f
        #t
        #f))

    ((and
        (= (-> self fish-state) 'reeling)

        (not
          (task-closed?
            (game-task fisher-game-tutorial-orbs)
            (task-status need-introduction))))

      (cond
        ((-> self button-fight-data active?)
          (none))

        ((-> self fish-fighting?)
          (draw-mod-menu-text-custom
            "DON'T REEL!"
            256
            116
            #f
            #t
            #f))

        (else
          (draw-mod-menu-text-custom
            "PRESS <PAD_X> TO REEL"
            256
            116
            #f
            #t
            #f)))))
    ))

  (none))

(defun fisher-format-catch-name! ((self fisher-game))
  (clear *fish-ui-str*)

  (cond
    ((= (-> self caught-fish-species) (the-as int (fisher-species nuclear-bombfish)))
      (format *fish-ui-str* "NUCLEAR BOMBFISH"))

    ((= (-> self caught-fish-suffix) 7)
      (format *fish-ui-str* "PRECURSOR FISH"))

    ((= (-> self caught-fish-suffix) 8)
      (format *fish-ui-str* "FORGOTTEN FISH"))

    ((= (-> self caught-fish-suffix) 9)
      (format *fish-ui-str* "FRICKED UP FISH"))

    ((= (-> self caught-fish-suffix) 10)
      (format *fish-ui-str* "PRECURSOR ORB-HUNTER"))

    ((= (-> self caught-fish-suffix) 11)
      (format *fish-ui-str* "ARCHIPELAGOLDFISH"))

    ((= (-> self caught-fish-suffix) 12)
      (format *fish-ui-str* "SPEC OPS FISH"))

    ((= (-> self caught-fish-suffix) 13)
      (format *fish-ui-str* "A COMPLICATED FISH"))

    ((= (-> self caught-fish-suffix) 14)
      (format *fish-ui-str* "L TETROMINO FISH"))

    ((= (-> self caught-fish-suffix) 15)
      (format *fish-ui-str* "PLATFORMIUS"))

    ((= (-> self caught-fish-suffix) 16)
      (format *fish-ui-str* "SCREAMING FISH"))

    ((and
        (= (-> self caught-fish-species)
          (the-as int (fisher-species fire-canyon-cellfish)))
        (= (-> self caught-power-cell-task)
          (the-as int (game-task citadel-buzzer))))
      (format *fish-ui-str* "CITADEL SCOUT FLY FISH"))

    ((and
        (= (-> self caught-fish-species)
          (the-as int (fisher-species fire-canyon-cellfish)))
        (or
          (= (-> self caught-power-cell-task)
            (the-as int (game-task lavatube-end)))
          (= (-> self caught-power-cell-task)
            (the-as int (game-task lavatube-buzzer)))))
      (format *fish-ui-str* "LAVA TUBE CELL FISH"))

    ((and
        (= (-> self caught-fish-species)
          (the-as int (fisher-species fire-canyon-cellfish)))
        (or
          (= (-> self caught-power-cell-task)
            (the-as int (game-task ogre-boss)))
          (= (-> self caught-power-cell-task)
            (the-as int (game-task ogre-end)))
          (= (-> self caught-power-cell-task)
            (the-as int (game-task ogre-buzzer)))))
      (format *fish-ui-str* "MOUNTAIN PASS CELL FISH"))

    ((= (-> self caught-fish-species) 4)
      (format *fish-ui-str* "SCOUT FLY"))

    (else
      (format
        *fish-ui-str*
        (fisher-suffix-name
          (-> self caught-fish-suffix)))

      (format *fish-ui-str* " ")

      (format
        *fish-ui-str*
        (fisher-species-name
          self
          (-> self caught-fish-species)))))

  *fish-ui-str*)

(defun fisher-draw-finalboss-catch-ui! ((self fisher-game))
  (when
    (or (= (-> self fish-state) 'catch-enter)
        (= (-> self fish-state) 'catch-display)
        (= (-> self fish-state) 'catch-exit))
    (let ((menu-offset (- (the int (-> self catch-menu-offset)) 20)))
      (with-dma-buffer-add-bucket
        ((buf (-> (current-frame) global-buf)) (bucket-id subtitle))
        (draw-sprite2d-xy buf 54 (+ 54 menu-offset) 404 174
          (new 'static 'rgba :r #x04 :g #x10 :b #x18 :a #xd4))
        (draw-sprite2d-xy buf 58 (+ 58 menu-offset) 396 166
          (new 'static 'rgba :r #x10 :g #x38 :b #x48 :a #xb8)))
      (draw-fisher-large-font-scaled "NUCLEAR BOMBFISH" 256 (+ 78 menu-offset) 0.58)
      (draw-fisher-large-font-scaled "9000.0 LBS" 256 (+ 112 menu-offset) 0.50)
      (draw-fisher-large-font-scaled
        "PRESS <PAD_X> TO CONTINUE"
        256 (+ 190 menu-offset) 0.46)))
  (none))

(defun fisher-draw-catch-ui! ((self fisher-game))
  (cond
    ((= (-> self caught-fish-species) (the-as int (fisher-species nuclear-bombfish)))
      (fisher-draw-finalboss-catch-ui! self))
    (else

  (when
    (or (= (-> self fish-state) 'catch-enter) (= (-> self fish-state) 'catch-display) (= (-> self fish-state) 'catch-exit))

    (let* ((menu-offset
          (-
            (the int (-> self catch-menu-offset))
            20))

        (whole-lbs (the int (/ (-> self caught-weight-tenths) 10)))

        (decimal-lbs
          (mod
            (-> self caught-weight-tenths)
            10))

        (carrier?
          (> (-> self caught-power-cell-task) 1))

        (panel-height
          (if carrier? 126 104)))

      (with-dma-buffer-add-bucket
        ((buf (-> (current-frame) global-buf)) (bucket-id subtitle))

        (draw-sprite2d-xy buf 82 (+ 84 menu-offset) 348 panel-height (new 'static 'rgba :r #x04 :g #x10 :b #x18 :a #xc8))

        (draw-sprite2d-xy
          buf
          86
          (+ 88 menu-offset)
          340
          (- panel-height 8)
          (new 'static 'rgba
            :r #x10
            :g #x38
            :b #x48
            :a #xa8)))

      (draw-fisher-large-font-scaled
        (fisher-format-catch-name! self)
        256
        (+ 102 menu-offset)
        0.60)

      (cond
        ((= (-> self caught-fish-species) 4)
          (clear *fish-ui-str*)
          (format
            *fish-ui-str*
            "LV. ~D   ~D.~D LBS"
            (-> self caught-fish-level)
            whole-lbs
            decimal-lbs)

          (draw-fisher-large-font-scaled
            *fish-ui-str*
            256
            (+ 128 menu-offset)
            0.52)

          (clear *fish-ui-str*)
          (format
            *fish-ui-str*
            "~D/7 CAUGHT"
            (-> self caught-buzzer-count))

          (draw-fisher-large-font-scaled
            *fish-ui-str*
            256
            (+ 150 menu-offset)
            0.52))

        (else
          (clear *fish-ui-str*)
          (format
            *fish-ui-str*
            "LV. ~D   ~D.~D LBS"
            (-> self caught-fish-level)
            whole-lbs
            decimal-lbs)

          (draw-fisher-large-font-scaled
            *fish-ui-str*
            256
            (+ 128 menu-offset)
            0.52)

          (clear *fish-ui-str*)
          (format
            *fish-ui-str*
            "WORTH: ~D ORBS   +~D XP"
            (-> self caught-orb-value)
            (-> self caught-fish-xp))

          (draw-fisher-large-font-scaled
            *fish-ui-str*
            256
            (+ 150 menu-offset)
            0.48)

          (when carrier?
            (draw-fisher-large-font-scaled
              "THE FISH HAD SWALLOWED A POWERCELL!"
              256
              (+ 170 menu-offset)
              0.40))))

      (clear *fish-ui-str*)
      (format *fish-ui-str* "PRESS <PAD_X> TO CONTINUE")
      (draw-fisher-large-font-scaled
        *fish-ui-str*
        256
        (+ (if carrier? 191 167) menu-offset)
        0.52)))
    ))

  (none))

