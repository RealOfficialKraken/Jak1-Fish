(defun fisher-swamp-species? ((species int))
  (or
    (= species (the-as int (fisher-species swamp-guppie)))
    (= species (the-as int (fisher-species sludge-crappie)))
    (= species (the-as int (fisher-species black-lurker-shark)))))

(defun fisher-reset-yellow-cycle! ((self fisher-game))
  (let ((data (-> self yellow-data)))
    (set! (-> data state) 'waiting)
    (set! (-> data timer)
      (rand-vu-float-range
        *fisher-yellow-cycle-min-seconds*
        *fisher-yellow-cycle-max-seconds*))
    (set! (-> data slot) -1)
    (set! (-> data projectile-time) 0.0)
    (vector-reset! (-> data position))
    (vector-reset! (-> data direction)))
  (none))

(defun fisher-find-yellow-slot ((self fisher-game))
  (let ((best-slot -1)
      (best-distance (meters 999999.0))
      (to-lure (new 'stack-no-clear 'vector))
      (forward (new 'stack-no-clear 'vector)))

    (dotimes (slot (-> self fish-count))
      (when
        (and
          (!= slot (-> self hooked-fish-slot))
          (fisher-swamp-species? (fisher-fish-species self slot))
          (<= (fisher-fish-turn-time self slot) 0.0))

        (let ((fish (fisher-fish-pointer self slot)))
          (when fish
            (let ((fish-proc
                  (the-as manipy (-> fish 0 self))))
              (when fish-proc
                (singlefish-vector-sub-safe!
                  to-lure
                  (-> self lure-pos)
                  (-> fish-proc root trans))

                (let ((distance (singlefish-vector-length-safe to-lure)))
                  (set! (-> to-lure y) 0.0)
                  (set! (-> to-lure w) 0.0)

                  (when
                    (> (singlefish-vector-length-safe to-lure) (meters 0.001))
                    (singlefish-vector-normalize-safe! to-lure 1.0)
                    (singlefish-vector-scale-safe!
                      forward
                      (-> self playfield-axis)
                      (fisher-fish-direction self slot))
                    (set! (-> forward y) 0.0)
                    (set! (-> forward w) 0.0)
                    (singlefish-vector-normalize-safe! forward 1.0)

                    (when
                      (and
                        (>= (vector-dot forward to-lure) 0.8191520)
                        (< distance best-distance))
                      (set! best-distance distance)
                      (set! best-slot slot))))))))))

    best-slot))

(defun fisher-submit-yellow-particle!
  ((self fisher-game) (pos vector) (channel int))

  (when
    (and
      (= (-> self location-id) (the-as int (fisher-zone swamp-sludge)))
      (-> self camera-underwater?))

    (launch-particles
      :system *sp-particle-system-3d*
      (-> *part-id-table* 3567)
      pos)
    (launch-particles
      :system *sp-particle-system-3d*
      (-> *part-id-table* 3568)
      pos)

    (when (= channel 0)
      (launch-particles
        :system *sp-particle-system-3d*
        (-> *part-id-table* 3566)
        pos)))

  (none))

(defun fisher-submit-yellow-explosion!
  ((self fisher-game) (pos vector))

  (when
    (and
      (= (-> self location-id) (the-as int (fisher-zone swamp-sludge)))
      (-> self camera-underwater?))
    (launch-particles
      :system *sp-particle-system-3d*
      (-> *part-id-table* 3564)
      pos)
    (launch-particles
      :system *sp-particle-system-3d*
      (-> *part-id-table* 3565)
      pos))

  (none))

(defun fisher-update-yellow-system! ((self fisher-game))
  (when
    (= (-> self location-id) (the-as int (fisher-zone swamp-sludge)))

    (let ((data (-> self yellow-data))
        (dt (-> *display* seconds-per-frame)))

      (cond
        ((or
            (not (-> self casted?))
            (!= (-> self cast-state) 'line-active))
          (when (!= (-> data state) 'waiting)
            (fisher-reset-yellow-cycle! self)))

        ((= (-> data state) 'waiting)
          (-! (-> data timer) dt)
          (when (<= (-> data timer) 0.0)
            (let ((slot (fisher-find-yellow-slot self)))
              (cond
                ((>= slot 0)
                  (set! (-> data slot) slot)
                  (set! (-> data state) 'charging)
                  (set! (-> data timer) 0.0)
                  (play-sound-file
                      "yellow-grab.wav"
                      (the int (-> *setting-control* current sfx-volume))))

                (else
                  (set! (-> data timer) 0.25))))))

        ((= (-> data state) 'charging)
          (let* ((slot (-> data slot))
              (fish
                (if
                  (and (>= slot 0) (< slot (-> self fish-count)))
                  (fisher-fish-pointer self slot)
                  (the-as (pointer manipy) #f))))

            (cond
              ((or
                  (not fish)
                  (= slot (-> self hooked-fish-slot))
                  (not (fisher-swamp-species?
                    (fisher-fish-species self slot))))
                (fisher-reset-yellow-cycle! self))

              (else
                (let ((fish-proc
                      (the-as manipy (-> fish 0 self))))
                  (cond
                    ((not fish-proc)
                      (fisher-reset-yellow-cycle! self))

                    (else
                      (vector-copy!
                        (-> data position)
                        (-> fish-proc root trans))
                      (fisher-submit-yellow-particle!
                        self
                        (-> data position)
                        0)
                      (+! (-> data timer) dt)

                      (when
                        (>= (-> data timer) *fisher-yellow-charge-seconds*)
                        (let ((hook-pos (new 'stack-no-clear 'vector)))
                          (fisher-hook-target! self hook-pos)
                          (singlefish-vector-sub-safe!
                            (-> data direction)
                            hook-pos
                            (-> data position))
                          (set! (-> data direction w) 0.0)

                          (cond
                            ((>
                                (singlefish-vector-length-safe
                                  (-> data direction))
                                (meters 0.001))
                              (singlefish-vector-normalize-safe!
                                (-> data direction)
                                1.0)
                              (set! (-> data state) 'projectile)
                              (set! (-> data projectile-time) 0.0)
                              (play-sound-file
                                "yellow-fire.wav"
                                (the int (-> *setting-control* current sfx-volume))))

                            (else
                              (fisher-reset-yellow-cycle! self))))))))))))

        ((= (-> data state) 'projectile)
          (let ((previous-pos (new 'stack-no-clear 'vector))
              (hook-pos (new 'stack-no-clear 'vector))
              (from-jak (new 'stack-no-clear 'vector))
              (distance 0.0))

            (vector-copy! previous-pos (-> data position))
            (vector+float*!
              (-> data position)
              (-> data position)
              (-> data direction)
              (* *fisher-yellow-projectile-speed* dt))
            (+! (-> data projectile-time) dt)

            (fisher-submit-yellow-particle!
              self
              (-> data position)
              1)

            (fisher-hook-target! self hook-pos)
            (vector-! from-jak (-> data position) (-> self fishing-player-pos))
            (set! distance (vector-dot from-jak (-> self playfield-axis)))

            (cond
              ((fisher-point-near-segment?
                  hook-pos
                  previous-pos
                  (-> data position)
                  *fisher-yellow-hook-hit-radius*)
                (fisher-submit-yellow-explosion! self hook-pos)
                (fisher-debug-print-lure-loss! self "YELLOW PROJECTILE HIT LURE")
                (fisher-begin-lure-stolen-return! self)
                (set! (-> self lure-destroyed?) #t)
                (set! (-> self fish-message) "LURE DESTROYED")
                (set! (-> self fish-message-time) 1.75)
                (fisher-reset-yellow-cycle! self))

              ((or
                  (<= distance (meters 3.5))
                  (>= distance (fisher-playfield-far-distance self))
                  (>= (-> data projectile-time) 24.0))
                (fisher-reset-yellow-cycle! self)))))

        (else
          (fisher-reset-yellow-cycle! self)))))

  (none))

(defun fisher-electric-species? ((species int))
  (or
    (= species (the-as int (fisher-species electric-grubfish)))
    (= species (the-as int (fisher-species electric-eelfish)))
    (= species (the-as int (fisher-species electric-lurker-shark)))))

(defun fisher-reset-electric-cycle! ((self fisher-game))
  (set! (-> self electric-state) 'waiting)
  (set! (-> self electric-timer)
    (rand-vu-float-range
      *fisher-electric-cycle-min-seconds*
      *fisher-electric-cycle-max-seconds*))
  (set! (-> self electric-line-time) 0.0)
  (set! (-> self electric-line-stun-time) 0.0)
  (set! (-> self electric-stun-triggered?) #f)
  (vector-reset! (-> self electric-projectile-pos))
  (vector-reset! (-> self electric-projectile-dir))
  (none))

(defun fisher-find-electric-slot ((self fisher-game))
  (when (> (-> self fish-count) 0)
    (let ((start (rand-vu-int-range 0 (- (-> self fish-count) 1)))
        (step 0)
        (slot 0)
        (previous-slot (-> self electric-slot)))

      (while (< step (-> self fish-count))
        (set! slot (mod (+ start step) (-> self fish-count)))
        (when
          (and
            (!= slot previous-slot)
            (!= slot (-> self hooked-fish-slot))
            (fisher-electric-species? (fisher-fish-species self slot))
            (fisher-fish-pointer self slot))
          (return slot))
        (+! step 1))

      (when
        (and
          (>= previous-slot 0)
          (< previous-slot (-> self fish-count))
          (!= previous-slot (-> self hooked-fish-slot))
          (fisher-electric-species?
            (fisher-fish-species self previous-slot))
          (fisher-fish-pointer self previous-slot))
        (return previous-slot))))
  -1)

(defun fisher-submit-electric-particle!
  ((self fisher-game) (pos vector) (channel int))

  (when
    (or
      (-> self camera-underwater?)
      (= (-> self location-id) (the-as int (fisher-zone sunken-voltage))))
    (launch-particles
      :system *sp-particle-system-3d*
      (-> *part-id-table* 3581)
      pos)

    (launch-particles
      :system *sp-particle-system-3d*
      (-> *part-id-table* 3582)
      pos)

    (cond
      ((= channel 0)
        (launch-particles
          :system *sp-particle-system-3d*
          (-> *part-id-table* 3583)
          pos))

      ((= channel 1)
        (launch-particles
          :system *sp-particle-system-3d*
          (-> *part-id-table* 3583)
          pos)
        (launch-particles
          :system *sp-particle-system-3d*
          (-> *part-id-table* 3583)
          pos))

      (else
        (launch-particles
          :system *sp-particle-system-3d*
          (-> *part-id-table* 3583)
          pos))))

  (none))

(defun fisher-point-near-segment?
  ((point vector) (line-start vector) (line-end vector) (radius float))
  (let ((line (new 'stack-no-clear 'vector))
      (to-point (new 'stack-no-clear 'vector))
      (closest (new 'stack-no-clear 'vector))
      (denom 0.0)
      (segment-t 0.0))
    (vector-! line line-end line-start)
    (vector-! to-point point line-start)
    (set! denom (vector-dot line line))
    (when (> denom 0.0001)
      (set! segment-t
        (fmax
          0.0
          (fmin
            1.0
            (/ (vector-dot to-point line) denom))))
      (vector+float*! closest line-start line segment-t)
      (return
        (<=
          (vector-vector-distance point closest)
          radius))))
  #f)

(defun fisher-electric-line-points!
  ((self fisher-game) (line-start vector) (line-end vector))
  (vector-copy! line-start (target-pos 0))
  (+! (-> line-start y) (meters 3.25))
  (set! (-> line-start w) 1.0)
  (fisher-hook-target! self line-end)
  (set! (-> line-end w) 1.0)
  (none))

(defun fisher-electric-projectile-hits-visible-line?
  ((self fisher-game) (previous-pos vector) (current-pos vector))

  (let ((projected
          (new 'stack 'vector4w-2))

      (projected-current
          (new 'stack 'vector4w-2))

      (line-world-start
          (new 'stack-no-clear 'vector))

      (line-start-x 0)
      (line-start-y 0)
      (line-end-x 512)
      (line-end-y 506)
      (projectile-old-x 0)
      (projectile-old-y 0)
      (projectile-new-x 0)
      (projectile-new-y 0)
      (line-dx 0)
      (line-dy 0)
      (shot-dx 0)
      (shot-dy 0)
      (offset-x 0)
      (offset-y 0)
      (denominator 0)
      (line-time-numerator 0)
      (shot-time-numerator 0))

    (vector-copy! line-world-start (target-pos 0))
    (+! (-> line-world-start y) (meters 3.25))
    (set! (-> line-world-start w) 1.0)

    (transform-point-qword!
      (-> projected vector 0)
      line-world-start)

    (transform-point-qword!
      (-> projected vector 1)
      previous-pos)

    (transform-point-qword!
      (-> projected-current vector 0)
      current-pos)

    (set! line-start-x
      (the int
        (/
          (max 512 (min 65024 (-> projected vector 0 x)))
          64)))
    (set! line-start-y
      (the int
        (/
          (max 512 (min 65024 (-> projected vector 0 y)))
          64)))

    (set! projectile-old-x
      (the int (/ (-> projected vector 1 x) 64)))
    (set! projectile-old-y
      (the int (/ (-> projected vector 1 y) 64)))
    (set! projectile-new-x
      (the int (/ (-> projected-current vector 0 x) 64)))
    (set! projectile-new-y
      (the int (/ (-> projected-current vector 0 y) 64)))

    (set! line-dx (- line-end-x line-start-x))
    (set! line-dy (- line-end-y line-start-y))
    (set! shot-dx (- projectile-new-x projectile-old-x))
    (set! shot-dy (- projectile-new-y projectile-old-y))
    (set! offset-x (- projectile-old-x line-start-x))
    (set! offset-y (- projectile-old-y line-start-y))

    (set! denominator
      (- (* line-dx shot-dy) (* line-dy shot-dx)))
    (set! line-time-numerator
      (- (* offset-x shot-dy) (* offset-y shot-dx)))
    (set! shot-time-numerator
      (- (* offset-x line-dy) (* offset-y line-dx)))

    (cond
      ((> denominator 0)
        (and
          (>= line-time-numerator 0)
          (<= line-time-numerator denominator)
          (>= shot-time-numerator 0)
          (<= shot-time-numerator denominator)))

      ((< denominator 0)
        (and
          (<= line-time-numerator 0)
          (>= line-time-numerator denominator)
          (<= shot-time-numerator 0)
          (>= shot-time-numerator denominator)))

      (else #f))))

(defun fisher-finish-voltage-shot! ((self fisher-game) (slot int))
  (when (!= (-> self voltage-data slot slot state) 4)
    (set! (-> self voltage-data slot slot state) 4)
    (when (> (-> self voltage-shots-remaining) 0)
      (-! (-> self voltage-shots-remaining) 1)))
  (none))

(defun fisher-reset-voltage-cycle! ((self fisher-game))
  (set! (-> self voltage-time) 0.0)
  (set! (-> self voltage-flash-time) 0.0)
  (set! (-> self voltage-active?) #f)
  (set! (-> self voltage-shots-remaining) 0)
  (dotimes (slot *fisher-max-fish-slots*)
    (set! (-> self voltage-data slot slot state) 0)
    (set! (-> self voltage-data slot slot timer) 0.0)
    (vector-reset! (-> self voltage-data slot slot position))
    (vector-reset! (-> self voltage-data slot slot direction)))
  (none))

(defun fisher-start-voltage-surge! ((self fisher-game))
  (set! (-> self voltage-time) *fisher-voltage-fill-seconds*)
  (set! (-> self voltage-flash-time) 0.0)
  (set! (-> self voltage-active?) #t)
  (set! (-> self voltage-shots-remaining) 0)

  (dotimes (slot *fisher-max-fish-slots*)
    (set! (-> self voltage-data slot slot state) 0)
    (set! (-> self voltage-data slot slot timer) 0.0))

  (dotimes (slot (-> self fish-count))
    (when (fisher-fish-pointer self slot)
      (set! (-> self voltage-data slot slot state) 1)
      (set! (-> self voltage-data slot slot timer)
        (rand-vu-float-range 0.0 *fisher-voltage-shot-spread-seconds*))
      (+! (-> self voltage-shots-remaining) 1)))

  (when (<= (-> self voltage-shots-remaining) 0)
    (fisher-reset-voltage-cycle! self))
  (none))

(defun fisher-update-sunken-line-charge! ((self fisher-game) (dt float))
  (when (> (-> self electric-line-stun-time) 0.0)
    (-! (-> self electric-line-stun-time) dt)
    (when (< (-> self electric-line-stun-time) 0.0)
      (set! (-> self electric-line-stun-time) 0.0)))

  (cond
    ((= (-> self electric-state) 'line-charge)
      (+! (-> self electric-line-time) dt)

      (let ((line-start (new 'stack-no-clear 'vector))
          (line-end (new 'stack-no-clear 'vector))
          (midpoint (new 'stack-no-clear 'vector))
          (to-start (new 'stack-no-clear 'vector))
          (to-end (new 'stack-no-clear 'vector))
          (particle-a (new 'stack-no-clear 'vector))
          (particle-b (new 'stack-no-clear 'vector))
          (progress
            (fmin
              1.0
              (/ (-> self electric-line-time)
                *fisher-electric-line-travel-seconds*))))

        (fisher-electric-line-points! self line-start line-end)
        (vector+! midpoint line-start line-end)
        (vector-float*! midpoint midpoint 0.5)
        (vector-! to-start line-start midpoint)
        (vector-! to-end line-end midpoint)
        (vector+float*! particle-a midpoint to-start progress)
        (vector+float*! particle-b midpoint to-end progress)
        (fisher-submit-electric-particle! self particle-a 2)
        (fisher-submit-electric-particle! self particle-b 3))

      (when
        (and
          (not (-> self electric-stun-triggered?))
          (-> self casted?)
          (= (-> self cast-state) 'line-active)
          (not (-> self fish-fighting?))
          (not (-> self button-fight-data active?))
          (cpad-hold? 0 x))
        (cpad-clear! 0 x)
        (set! (-> self electric-stun-triggered?) #t)
        (set! (-> self electric-line-stun-time)
          *fisher-electric-line-stun-seconds*)
        (fisher-show-lure-skill-message! self "LINE IS STUNNED!"))

      (when
        (>= (-> self electric-line-time)
          *fisher-electric-line-travel-seconds*)
        (cond
          ((-> self electric-stun-triggered?)
            (set! (-> self electric-state) 'stunned))
          (else
            (set! (-> self electric-state) 'waiting)
            (set! (-> self electric-line-time) 0.0)))))

    ((= (-> self electric-state) 'stunned)
      (when (<= (-> self electric-line-stun-time) 0.0)
        (set! (-> self electric-state) 'waiting)
        (set! (-> self electric-line-time) 0.0)
        (set! (-> self electric-stun-triggered?) #f))))
  (none))

(defun fisher-update-voltage-surge! ((self fisher-game))
  (when
    (= (-> self location-id) (the-as int (fisher-zone sunken-voltage)))
    (let ((dt (-> *display* seconds-per-frame)))
      (fisher-update-sunken-line-charge! self dt)

      (cond
        ((-> self voltage-active?)
          (+! (-> self voltage-flash-time) dt)

          (dotimes (slot *fisher-max-fish-slots*)
            (let ((state (-> self voltage-data slot slot state)))
              (cond
                ((= state 1)
                  (-! (-> self voltage-data slot slot timer) dt)
                  (when (<= (-> self voltage-data slot slot timer) 0.0)
                    (set! (-> self voltage-data slot slot state) 2)
                    (set! (-> self voltage-data slot slot timer)
                      *fisher-electric-charge-seconds*)
                    (play-sound-file
                      "zapping.mp3"
                      (the int (-> *setting-control* current sfx-volume)))))

                ((= state 2)
                  (let ((fish (fisher-fish-pointer self slot)))
                    (cond
                      ((not fish)
                        (fisher-finish-voltage-shot! self slot))
                      (else
                        (let ((fish-proc (-> fish 0 self)))
                          (cond
                            ((not fish-proc)
                              (fisher-finish-voltage-shot! self slot))
                            (else
                              (fisher-submit-electric-particle!
                                self
                                (-> (the-as manipy fish-proc) root trans)
                                0)
                              (-! (-> self voltage-data slot slot timer) dt)
                              (when
                                (<= (-> self voltage-data slot slot timer) 0.0)
                                (vector-copy!
                                  (-> self voltage-data slot slot position)
                                  (-> (the-as manipy fish-proc) root trans))
                                (vector-float*!
                                  (-> self voltage-data slot slot direction)
                                  (-> self playfield-axis)
                                  (fisher-fish-direction self slot))
                                (set! (-> self voltage-data slot slot direction y) 0.0)
                                (set! (-> self voltage-data slot slot direction w) 0.0)
                                (vector-normalize!
                                  (-> self voltage-data slot slot direction)
                                  1.0)
                                (set! (-> self voltage-data slot slot state) 3)
                                (play-sound-file
                                  "zap-blast.mp3"
                                  (the int (-> *setting-control* current sfx-volume)))))))))))

                ((= state 3)
                  (let ((previous-pos (new 'stack-no-clear 'vector))
                      (from-jak (new 'stack-no-clear 'vector))
                      (distance 0.0))
                    (vector-copy!
                      previous-pos
                      (-> self voltage-data slot slot position))
                    (vector+float*!
                      (-> self voltage-data slot slot position)
                      (-> self voltage-data slot slot position)
                      (-> self voltage-data slot slot direction)
                      (* *fisher-electric-projectile-speed* dt))
                    (fisher-submit-electric-particle!
                      self
                      (-> self voltage-data slot slot position)
                      1)
                    (vector-!
                      from-jak
                      (-> self voltage-data slot slot position)
                      (-> self fishing-player-pos))
                    (set! distance
                      (vector-dot from-jak (-> self playfield-axis)))

                    (cond
                      ((and
                          (-> self casted?)
                          (= (-> self cast-state) 'line-active)
                          (fisher-electric-projectile-hits-visible-line?
                            self
                            previous-pos
                            (-> self voltage-data slot slot position)))
                        (fisher-finish-voltage-shot! self slot)
                        (play-sound-file
                          "zap-impact.mp3"
                          (the int (-> *setting-control* current sfx-volume)))
                        (when
                          (and
                            (!= (-> self electric-state) 'line-charge)
                            (!= (-> self electric-state) 'stunned))
                          (set! (-> self electric-state) 'line-charge)
                          (set! (-> self electric-line-time) 0.0)
                          (set! (-> self electric-stun-triggered?) #f)))

                      ((or
                          (<= distance (meters 3.5))
                          (>= distance (fisher-playfield-far-distance self)))
                        (fisher-finish-voltage-shot! self slot))))))))

          (when (<= (-> self voltage-shots-remaining) 0)
            (fisher-reset-voltage-cycle! self)))

        (else
          (+! (-> self voltage-time) dt)
          (when (>= (-> self voltage-time) *fisher-voltage-fill-seconds*)
            (fisher-start-voltage-surge! self))))))
  (none))

(defun fisher-draw-voltage-meter! ((self fisher-game))
  (when
    (= (-> self location-id) (the-as int (fisher-zone sunken-voltage)))
    (let* ((ratio
            (if
              (-> self voltage-active?)
              1.0
              (fmax
                0.0
                (fmin
                  1.0
                  (/ (-> self voltage-time) *fisher-voltage-fill-seconds*)))))
        (fill-height (the int (* 116.0 ratio)))
        (fill-y (the int (- 414.0 fill-height)))
        (flash-on?
          (and
            (-> self voltage-active?)
            (> (sin (* (-> self voltage-flash-time) (degrees 720.0))) 0.0)))
        (fill-color
          (if
            flash-on?
            (new 'static 'rgba :r #xe0 :g #xff :b #xff :a #xe0)
            (new 'static 'rgba :r #x18 :g #xa8 :b #xe8 :a #xd0))))

      (draw-fisher-large-font-scaled "FISH VOLTAGE" 445 278 0.31)

      (with-dma-buffer-add-bucket
        ((buf (-> (current-frame) global-buf)) (bucket-id subtitle))
        (draw-sprite2d-xy
          buf 455 286 34 134
          (new 'static 'rgba :r #x00 :g #x00 :b #x00 :a #xa0))
        (draw-sprite2d-xy
          buf 459 290 26 126
          (new 'static 'rgba :r #x08 :g #x18 :b #x28 :a #xc0))
        (when (> fill-height 0)
          (draw-sprite2d-xy buf 464 fill-y 16 fill-height fill-color)
          (draw-sprite2d-xy
            buf 462 (- fill-y 2) 20 4
            (new 'static 'rgba :r #xa0 :g #xe8 :b #xff :a #xd0))))))
  (none))

(defun fisher-update-electric-system! ((self fisher-game))
  (when
    (=
      (-> self location-id)
      (the-as int (fisher-zone village2-electric)))

    (let ((dt (-> *display* seconds-per-frame)))
      (when (> (-> self electric-line-stun-time) 0.0)
        (-! (-> self electric-line-stun-time) dt)
        (when (< (-> self electric-line-stun-time) 0.0)
          (set! (-> self electric-line-stun-time) 0.0)))

      (when
        (and
          (-> self casted?)
          (= (-> self cast-state) 'line-active))

        (cond
      ((= (-> self electric-state) 'waiting)
        (-! (-> self electric-timer) dt)
        (when (<= (-> self electric-timer) 0.0)
          (let ((slot (fisher-find-electric-slot self)))
            (cond
              ((>= slot 0)
                (set! (-> self electric-slot) slot)
                (set! (-> self electric-state) 'charging)
                (set! (-> self electric-timer) 0.0)
                (play-sound-file
                  "zapping.mp3"
                  (the int (-> *setting-control* current sfx-volume))))
              (else
                (set! (-> self electric-timer) 1.0))))))

      ((= (-> self electric-state) 'charging)
        (let* ((slot (-> self electric-slot))
            (fish
              (if
                (and (>= slot 0) (< slot (-> self fish-count)))
                (fisher-fish-pointer self slot)
                (the-as (pointer manipy) #f))))
          (cond
            ((or
                (not fish)
                (= slot (-> self hooked-fish-slot))
                (not (fisher-electric-species?
                  (fisher-fish-species self slot))))
              (fisher-reset-electric-cycle! self))

            (else
              (+! (-> self electric-timer) dt)
              (let ((fish-proc (-> fish 0 self)))
                (when fish-proc
                  (let ((charge-pos
                        (new 'stack-no-clear 'vector)))
                    (vector-copy!
                      charge-pos
                      (-> (the-as manipy fish-proc) root trans))
                    (fisher-submit-electric-particle!
                      self
                      charge-pos
                      0))

                  (when
                    (>=
                      (-> self electric-timer)
                      *fisher-electric-charge-seconds*)
                    (vector-copy!
                      (-> self electric-projectile-pos)
                      (-> (the-as manipy fish-proc) root trans))
                    (vector-float*!
                      (-> self electric-projectile-dir)
                      (-> self playfield-axis)
                      (fisher-fish-direction self slot))
                    (set! (-> self electric-projectile-dir y) 0.0)
                    (set! (-> self electric-projectile-dir w) 0.0)
                    (vector-normalize!
                      (-> self electric-projectile-dir)
                      1.0)
                    (set! (-> self electric-state) 'projectile)
                    (set! (-> self electric-timer) 0.0)
                    (play-sound-file
                      "zap-blast.mp3"
                      (the int (-> *setting-control* current sfx-volume))))))))))

      ((= (-> self electric-state) 'projectile)
        (let ((previous-pos (new 'stack-no-clear 'vector))
            (from-jak (new 'stack-no-clear 'vector))
            (distance 0.0))

          (vector-copy!
            previous-pos
            (-> self electric-projectile-pos))

          (vector+float*!
            (-> self electric-projectile-pos)
            (-> self electric-projectile-pos)
            (-> self electric-projectile-dir)
            (* *fisher-electric-projectile-speed* dt))

          (fisher-submit-electric-particle!
            self
            (-> self electric-projectile-pos)
            1)

          (vector-!
            from-jak
            (-> self electric-projectile-pos)
            (-> self fishing-player-pos))
          (set! distance (vector-dot from-jak (-> self playfield-axis)))

          (cond
            ((fisher-electric-projectile-hits-visible-line?
                self
                previous-pos
                (-> self electric-projectile-pos))
              (set! (-> self electric-state) 'line-charge)
              (set! (-> self electric-line-time) 0.0)
              (set! (-> self electric-stun-triggered?) #f)
              (play-sound-file
                "zap-impact.mp3"
                (the int (-> *setting-control* current sfx-volume))))

            ((or
                (<= distance (meters 3.5))
                (>= distance (fisher-playfield-far-distance self)))
              (fisher-reset-electric-cycle! self)))))

      ((= (-> self electric-state) 'line-charge)
        (+! (-> self electric-line-time) dt)

        (let ((line-start (new 'stack-no-clear 'vector))
            (line-end (new 'stack-no-clear 'vector))
            (midpoint (new 'stack-no-clear 'vector))
            (to-start (new 'stack-no-clear 'vector))
            (to-end (new 'stack-no-clear 'vector))
            (particle-a (new 'stack-no-clear 'vector))
            (particle-b (new 'stack-no-clear 'vector))
            (progress
              (fmin
                1.0
                (/ (-> self electric-line-time)
                  *fisher-electric-line-travel-seconds*))))

          (fisher-electric-line-points! self line-start line-end)
          (vector+! midpoint line-start line-end)
          (vector-float*! midpoint midpoint 0.5)
          (vector-! to-start line-start midpoint)
          (vector-! to-end line-end midpoint)
          (vector+float*! particle-a midpoint to-start progress)
          (vector+float*! particle-b midpoint to-end progress)
          (fisher-submit-electric-particle! self particle-a 2)
          (fisher-submit-electric-particle! self particle-b 3))

        (when
          (and
            (not (-> self electric-stun-triggered?))
            (not (-> self fish-fighting?))
            (not (-> self button-fight-data active?))
            (or
              (= (-> self fish-state) 'free)
              (= (-> self fish-state) 'reeling))
            (cpad-hold? 0 x))
          (cpad-clear! 0 x)
          (set! (-> self electric-stun-triggered?) #t)
          (set! (-> self electric-line-stun-time)
            *fisher-electric-line-stun-seconds*)
          (fisher-show-lure-skill-message! self "LINE IS STUNNED!"))

        (when
          (>=
            (-> self electric-line-time)
            *fisher-electric-line-travel-seconds*)
          (cond
            ((-> self electric-stun-triggered?)
              (set! (-> self electric-state) 'stunned))
            (else
              (fisher-reset-electric-cycle! self)))))

      ((= (-> self electric-state) 'stunned)
        (when (<= (-> self electric-line-stun-time) 0.0)
          (fisher-reset-electric-cycle! self)))

          (else
            (fisher-reset-electric-cycle! self)))))

    )

  (none))

(defun fisher-submit-village3-lava-ambient! ((self fisher-game))
  (when
    (and
      (= (-> self location-id) (the-as int (fisher-zone village3-lava)))
      (-> self casted?)
      (-> self pool-rendered?))
    (-! (-> self background-mist-time) (-> *display* seconds-per-frame))
    (when (<= (-> self background-mist-time) 0.0)
      (set! (-> self background-mist-time)
        (rand-vu-float-range 0.20 0.42))

      (let ((lava-pos (new 'stack-no-clear 'vector))
          (side-axis (new 'stack-no-clear 'vector)))
        (set! (-> side-axis x) (-> self playfield-axis z))
        (set! (-> side-axis y) 0.0)
        (set! (-> side-axis z) (- (-> self playfield-axis x)))
        (set! (-> side-axis w) 0.0)
        (singlefish-vector-normalize-safe! side-axis 1.0)

        (fisher-submit-village3-heat-distortion! self side-axis)

        (singlefish-vector-add-scaled-safe!
          lava-pos
          (-> self fishing-player-pos)
          (-> self playfield-axis)
          (rand-vu-float-range (meters 24.0) (meters 62.0)))
        (singlefish-vector-add-scaled-safe!
          lava-pos
          lava-pos
          side-axis
          (rand-vu-float-range (meters -8.0) (meters 8.0)))
        (set! (-> lava-pos y)
          (- (-> self water-level)
            (rand-vu-float-range (meters 0.4) (meters 7.0))))
        (set! (-> lava-pos w) 1.0)

        (fisher-set-lava-puff-mode! self 5)
        (launch-particles
          :system *sp-particle-system-3d*
          (-> *part-id-table* 3573)
          lava-pos)

        (when (rand-vu-percent? 0.32)
          (fisher-submit-lava-yellow-trail! self lava-pos))

        (when (rand-vu-percent? 0.035)
          (set! (-> lava-pos y)
            (- (-> self water-level) (meters 33.0)))
          (dotimes (geyser-index 4)
            (+! (-> lava-pos y) (meters 1.15))
            (fisher-submit-lava-yellow-trail! self lava-pos))))))
  (none))

(defun fisher-incinerate-lure! ((self fisher-game))
  (when
    (and
      (-> self casted?)
      (!= (-> self cast-state) 'lure-stolen-return))
    (let ((hook-pos (new 'stack-no-clear 'vector)))
      (fisher-hook-target! self hook-pos)
      (fisher-set-lava-puff-mode! self 2)
      (launch-particles
        :system *sp-particle-system-3d*
        (-> *part-id-table* 3573)
        hook-pos)
      (fisher-set-lava-puff-mode! self 5)
      (launch-particles
        :system *sp-particle-system-3d*
        (-> *part-id-table* 3573)
        hook-pos))
    (fisher-debug-print-lure-loss! self "LAVA / FIRE INCINERATED LURE")
    (fisher-begin-lure-stolen-return! self)
    (set! (-> self lure-incinerated?) #t)
    (set! (-> self fish-message) "LURE INCINERATED")
    (set! (-> self fish-message-time) 2.0))
  (none))

(defun fisher-reset-lava-fire-cycle! ((self fisher-game))
  (set! (-> self lava-fire-state) 'waiting)
  (set! (-> self lava-fire-timer) *fisher-lava-fire-cycle-seconds*)
  (set! (-> self lava-fire-slot) -1)
  (set! (-> self lava-flame-time) 0.0)
  (none))

(defun fisher-find-lava-fire-slot ((self fisher-game))
  (when (> (-> self fish-count) 0)
    (dotimes (attempt 12)
      (let ((slot (rand-vu-int-range 0 (- (-> self fish-count) 1))))
        (when
          (and
            (!= slot (-> self hooked-fish-slot))
            (fisher-fish-pointer self slot)
            (-> (fisher-fish-pointer self slot) 0 self))
          (return slot))))

    (dotimes (slot (-> self fish-count))
      (when
        (and
          (!= slot (-> self hooked-fish-slot))
          (fisher-fish-pointer self slot)
          (-> (fisher-fish-pointer self slot) 0 self))
        (return slot))))
  -1)

(defun fisher-lava-fish-forward! ((fish-proc manipy) (dst vector))
  (let ((rot (new 'stack-no-clear 'matrix)))
    (quaternion->matrix rot (-> fish-proc root quat))
    (vector-copy! dst (-> rot vector 2))
    (set! (-> dst y) 0.0)
    (set! (-> dst w) 0.0)
    (singlefish-vector-normalize-safe! dst 1.0))
  dst)

(defun fisher-magma-serpent-touches-hook?
  ((self fisher-game) (slot int) (fish-proc manipy))

  (let ((hook-pos (new 'stack-no-clear 'vector))
      (relative (new 'stack-no-clear 'vector))
      (forward (new 'stack-no-clear 'vector))
      (side (new 'stack-no-clear 'vector))
      (along 0.0)
      (across 0.0)
      (vertical 0.0))

    (fisher-hook-target! self hook-pos)
    (fisher-lava-fish-forward! fish-proc forward)

    (singlefish-vector-add-scaled-safe!
      relative (-> fish-proc root trans) forward (meters 5.50))
    (vector-! relative hook-pos relative)

    (set! (-> side x) (-> forward z))
    (set! (-> side y) 0.0)
    (set! (-> side z) (- (-> forward x)))
    (set! (-> side w) 0.0)

    (set! along (fabs (vector-dot relative forward)))
    (set! across (fabs (vector-dot relative side)))
    (set! vertical (fabs (-> relative y)))

    (and
      (<= along (meters 5.50))
      (<= across (meters 1.95))
      (<= vertical (meters 1.75)))))

(defun fisher-submit-lava-fish-effects! ((self fisher-game))
  (when
    (and
      (= (-> self location-id) (the-as int (fisher-zone village3-lava)))
      (-> self pool-rendered?))

    (when (-> self camera-underwater?)
      (let ((dt (-> *display* seconds-per-frame)))
        (-! (-> self lava-trail-time) dt)
        (when (<= (-> self lava-trail-time) 0.0)
          (set! (-> self lava-trail-time) *fisher-lava-trail-interval-seconds*)
          (dotimes (slot (-> self fish-count))
            (let ((fish (fisher-fish-pointer self slot)))
              (when (and fish (-> fish 0 self))
                (let* ((fish-proc (the-as manipy (-> fish 0 self)))
                    (species (fisher-fish-species self slot))
                    (smoke-pos (new 'stack-no-clear 'vector))
                    (forward (new 'stack-no-clear 'vector)))
                  (fisher-lava-fish-forward! fish-proc forward)
                  (singlefish-vector-add-scaled-safe!
                    smoke-pos (-> fish-proc root trans) forward (meters -0.85))
                  (+! (-> smoke-pos y) (meters 0.18))
                  (set! (-> smoke-pos w) 1.0)
                  (fisher-set-lava-puff-mode! self 1)
                  (launch-particles
                    :system *sp-particle-system-3d*
                    (-> *part-id-table* 3573)
                    smoke-pos)

                  (when (= species (the-as int (fisher-species magma-serpent)))
                    (dotimes (body-index 4)
                      (let ((body-pos (new 'stack-no-clear 'vector))
                          (offset (* (meters 3.75)
                            (- (the float body-index) 1.5))))
                        (singlefish-vector-add-scaled-safe!
                          body-pos (-> fish-proc root trans) forward offset)
                        (+! (-> body-pos y) (meters 0.20))
                        (set! (-> body-pos w) 1.0)
                        (fisher-set-lava-puff-mode! self 4)
                        (launch-particles
                          :system *sp-particle-system-3d*
                          (-> *part-id-table* 3573)
                          body-pos)

                        (fisher-set-lava-puff-mode! self 5)
                        (launch-particles
                          :system *sp-particle-system-3d*
                          (-> *part-id-table* 3573)
                          body-pos)))))))))))

    (when
      (and
        (-> self casted?)
        (= (-> self cast-state) 'line-active)
        (= (-> self fish-state) 'free))
      (dotimes (slot (-> self fish-count))
        (let ((fish (fisher-fish-pointer self slot)))
          (when
            (and
              fish
              (-> fish 0 self)
              (= (fisher-fish-species self slot)
                (the-as int (fisher-species magma-serpent)))
              (fisher-magma-serpent-touches-hook?
                self slot (the-as manipy (-> fish 0 self))))
            (fisher-incinerate-lure! self)))))
    )
  (none))

(defun fisher-lava-flame-hits-hook?
  ((self fisher-game) (slot int) (fish-proc manipy))
  (let ((hook-pos (new 'stack-no-clear 'vector))
      (relative (new 'stack-no-clear 'vector))
      (forward (new 'stack-no-clear 'vector))
      (side (new 'stack-no-clear 'vector))
      (forward-distance 0.0)
      (side-distance 0.0)
      (vertical-distance 0.0)
      (remaining-distance 0.0)
      (forward-sign 1.0))
    (fisher-lava-fish-forward! fish-proc forward)
    (set! forward-sign
      (if (>= (vector-dot forward (-> self playfield-axis)) 0.0) 1.0 -1.0))
    (singlefish-vector-scale-safe!
      forward
      (-> self playfield-axis)
      forward-sign)
    (set! (-> side x) (-> forward z))
    (set! (-> side y) 0.0)
    (set! (-> side z) (- (-> forward x)))
    (set! (-> side w) 0.0)
    (fisher-hook-target! self hook-pos)
    (vector-! relative hook-pos (-> fish-proc root trans))
    (set! forward-distance (vector-dot relative forward))
    (set! side-distance (fabs (vector-dot relative side)))
    (set! vertical-distance (fabs (-> relative y)))
    (set! remaining-distance
      (if (> forward-sign 0.0)
        (- (fisher-playfield-far-distance self) (fisher-fish-distance self slot))
        (- (fisher-fish-distance self slot) (meters 3.5))))
    (and
      (>= forward-distance 0.0)
      (<= forward-distance (fmax 0.0 remaining-distance))
      (<= side-distance (meters 2.0))
      (<= vertical-distance (meters 2.5)))))

(defun fisher-submit-lava-flame-wall!
  ((self fisher-game) (slot int) (fish-proc manipy))
  (let ((forward (new 'stack-no-clear 'vector))
      (remaining-distance 0.0)
      (forward-sign 1.0))
    (fisher-lava-fish-forward! fish-proc forward)
    (set! forward-sign
      (if (>= (vector-dot forward (-> self playfield-axis)) 0.0) 1.0 -1.0))
    (singlefish-vector-scale-safe!
      forward
      (-> self playfield-axis)
      forward-sign)
    (set! remaining-distance
      (if (> forward-sign 0.0)
        (- (fisher-playfield-far-distance self) (fisher-fish-distance self slot))
        (- (fisher-fish-distance self slot) (meters 3.5))))

    (dotimes (depth-index 12)
      (let ((depth (* (fmax (meters 0.5) remaining-distance)
                    (/ (+ (the float depth-index) 0.5) 12.0))))
        (dotimes (height-index 3)
          (let ((flame-pos (new 'stack-no-clear 'vector)))
            (singlefish-vector-add-scaled-safe!
              flame-pos (-> fish-proc root trans) forward depth)
            (+! (-> flame-pos y)
              (* (meters 2.5) (- (the float height-index) 1.0)))
            (set! (-> flame-pos w) 1.0)
            (fisher-set-lava-puff-mode! self 3)
            (launch-particles
              :system *sp-particle-system-3d*
              (-> *part-id-table* 3573)
              flame-pos)
            (when (= height-index 1)
              (fisher-set-lava-puff-mode! self 5)
              (launch-particles
                :system *sp-particle-system-3d*
                (-> *part-id-table* 3573)
                flame-pos)))))))
  (none))



(deftype fisher-snowball-obstacle (process-drawable)
  ((owner        (pointer fisher-game))
   (side-axis    vector :inline)
   (move-dir     vector :inline)
   (spawn-pos    vector :inline)
   (despawn-pos  vector :inline)
   (side-sign    float)
   (target-side  float)
   (speed        float))
  (:states fisher-snowball-obstacle-idle))

(defun fisher-debug-draw-snowball-hitbox!
  ((self fisher-snowball-obstacle))

  (when *fisher-in-debug?*
    (let ((center (-> self root trans))
        (radius (meters 1.25))
        (p0 (new 'stack-no-clear 'vector))
        (p1 (new 'stack-no-clear 'vector))
        (cyan (new 'static 'rgba :r #x20 :g #xff :b #xff :a #xff)))

      (dotimes (i 24)
        (let* ((a0 (* (degrees 360.0) (/ (the float i) 24.0)))
            (a1 (* (degrees 360.0) (/ (the float (+ i 1)) 24.0)))
            (c0 (cos a0))
            (s0 (sin a0))
            (c1 (cos a1))
            (s1 (sin a1)))

          (singlefish-vector-copy-safe! p0 center)
          (singlefish-vector-copy-safe! p1 center)
          (+! (-> p0 x) (* radius c0))
          (+! (-> p0 y) (* radius s0))
          (+! (-> p1 x) (* radius c1))
          (+! (-> p1 y) (* radius s1))
          (set! (-> p0 w) 1.0)
          (set! (-> p1 w) 1.0)
          (fisher-debug-line! p0 p1 cyan)

          (singlefish-vector-copy-safe! p0 center)
          (singlefish-vector-copy-safe! p1 center)
          (+! (-> p0 x) (* radius c0))
          (+! (-> p0 z) (* radius s0))
          (+! (-> p1 x) (* radius c1))
          (+! (-> p1 z) (* radius s1))
          (set! (-> p0 w) 1.0)
          (set! (-> p1 w) 1.0)
          (fisher-debug-line! p0 p1 cyan)

          (singlefish-vector-copy-safe! p0 center)
          (singlefish-vector-copy-safe! p1 center)
          (+! (-> p0 y) (* radius c0))
          (+! (-> p0 z) (* radius s0))
          (+! (-> p1 y) (* radius c1))
          (+! (-> p1 z) (* radius s1))
          (set! (-> p0 w) 1.0)
          (set! (-> p1 w) 1.0)
          (fisher-debug-line! p0 p1 cyan)))

      (singlefish-vector-copy-safe! p0 center)
      (singlefish-vector-copy-safe! p1 center)
      (-! (-> p0 x) radius)
      (+! (-> p1 x) radius)
      (fisher-debug-line! p0 p1 cyan)

      (singlefish-vector-copy-safe! p0 center)
      (singlefish-vector-copy-safe! p1 center)
      (-! (-> p0 y) radius)
      (+! (-> p1 y) radius)
      (fisher-debug-line! p0 p1 cyan)

      (singlefish-vector-copy-safe! p0 center)
      (singlefish-vector-copy-safe! p1 center)
      (-! (-> p0 z) radius)
      (+! (-> p1 z) radius)
      (fisher-debug-line! p0 p1 cyan)))

  (none))

(defun fisher-debug-draw-snowball-trajectory!
  ((self fisher-snowball-obstacle))

  (when *fisher-in-debug?*
    (let ((yellow (new 'static 'rgba :r #xff :g #xff :b #x20 :a #xff))
        (red (new 'static 'rgba :r #xff :g #x20 :b #x20 :a #xff))
        (a (new 'stack-no-clear 'vector))
        (b (new 'stack-no-clear 'vector))
        (mark-size (meters 0.9)))

      (fisher-debug-line! (-> self spawn-pos) (-> self despawn-pos) yellow)

      (singlefish-vector-copy-safe! a (-> self despawn-pos))
      (singlefish-vector-copy-safe! b (-> self despawn-pos))
      (-! (-> a x) mark-size)
      (-! (-> a y) mark-size)
      (+! (-> b x) mark-size)
      (+! (-> b y) mark-size)
      (fisher-debug-line! a b red)

      (singlefish-vector-copy-safe! a (-> self despawn-pos))
      (singlefish-vector-copy-safe! b (-> self despawn-pos))
      (-! (-> a x) mark-size)
      (+! (-> a y) mark-size)
      (+! (-> b x) mark-size)
      (-! (-> b y) mark-size)
      (fisher-debug-line! a b red)

      (singlefish-vector-copy-safe! a (-> self despawn-pos))
      (singlefish-vector-copy-safe! b (-> self despawn-pos))
      (-! (-> a x) mark-size)
      (-! (-> a z) mark-size)
      (+! (-> b x) mark-size)
      (+! (-> b z) mark-size)
      (fisher-debug-line! a b red)

      (singlefish-vector-copy-safe! a (-> self despawn-pos))
      (singlefish-vector-copy-safe! b (-> self despawn-pos))
      (-! (-> a x) mark-size)
      (+! (-> a z) mark-size)
      (+! (-> b x) mark-size)
      (-! (-> b z) mark-size)
      (fisher-debug-line! a b red)))

  (none))

(defun fisher-snowball-hook-hit?
  ((owner fisher-game) (ball fisher-snowball-obstacle))
  (let ((snow-pos (-> ball root trans)))
    (when
      (and
        (-> owner casted?)
        (= (-> owner cast-state) 'line-active)

        (not (= (-> owner fish-state) 'reeling))

        (>= (vector-vector-distance snow-pos (-> ball spawn-pos)) (meters 10.0))
        (>= (vector-vector-distance snow-pos (-> ball despawn-pos)) (meters 10.0)))

      (let ((hook-pos (new 'stack-no-clear 'vector))
          (delta (new 'stack-no-clear 'vector))
          (hit-distance 0.0))

        (fisher-hook-target! owner hook-pos)

        (vector-! delta snow-pos hook-pos)
        (set! hit-distance (vector-length delta))

        (when (<= hit-distance (meters 1.25))
          (when *fisher-in-debug?*
            (format #t "[FISHER] SNOWBALL HOOK COLLISION TRUE~%")
            (format #t "[FISHER] snowball-pos: ~A~%" snow-pos)
            (format #t "[FISHER] hook-pos: ~A~%" hook-pos)
            (format #t "[FISHER] distance-to-hook: ~F~%" hit-distance)
            (format #t "[FISHER] hit-radius: ~F~%" (meters 1.25))
            (format
              #t
              "[FISHER] distance-from-spawn: ~F~%"
              (vector-vector-distance snow-pos (-> ball spawn-pos)))
            (format
              #t
              "[FISHER] distance-to-despawn: ~F~%"
              (vector-vector-distance snow-pos (-> ball despawn-pos))))

          (return #t)))))

  #f)

(defun fisher-snowball-obstacle-finish! ((self fisher-snowball-obstacle))
  (deactivate self)
  (none))

(defstate fisher-snowball-obstacle-idle (fisher-snowball-obstacle)
  :trans
  (behavior ()
    (let ((owner (the-as fisher-game (-> self owner)))
        (dt (-> *display* seconds-per-frame)))

      (cond
        ((or
            (not owner)
            (!= (-> owner location-id) (the-as int (fisher-zone snow-ice)))
            (not (-> owner casted?))
            (= (-> owner cast-state) 'lure-stolen-return))
          (fisher-snowball-obstacle-finish! self))

        (else
          (vector+float*!
            (-> self root trans)
            (-> self root trans)
            (-> self move-dir)
            (* (-> self speed) dt))
          (set! (-> self root trans w) 1.0)

          (fisher-debug-draw-snowball-hitbox! self)
          (fisher-debug-draw-snowball-trajectory! self)

          (cond
            ((fisher-snowball-hook-hit? owner self)
              (fisher-debug-print-lure-loss! owner "SNOWBALL HIT HOOK")
              (fisher-begin-lure-stolen-return! owner)
              (fisher-snowball-obstacle-finish! self))

            (else
              (let ((relative (new 'stack-no-clear 'vector)))
                (vector-! relative (-> self root trans) (-> owner fishing-player-pos))
                (when
                  (if (> (-> self side-sign) 0.0)
                    (<= (vector-dot relative (-> self side-axis)) (-> self target-side))
                    (>= (vector-dot relative (-> self side-axis)) (-> self target-side)))
                  (fisher-snowball-obstacle-finish! self)))))))))
  :code
  (behavior ()
    (ja-channel-set! 1)
    (ja :group! snow-ball-idle-ja :num! min)
    (transform-post)
    (loop
      (suspend)))
  :post ja-post)

(defbehavior fisher-snowball-obstacle-init fisher-snowball-obstacle
  ((owner fisher-game) (side-sign float) (forward-distance float) (spawn-y float))
  (let ((root
          (new 'process
            'collide-shape-moving
            self
            (collide-list-enum hit-by-others))))
    (set! (-> root dynam) (copy *standard-dynamics* 'process))
    (set! (-> root reaction) default-collision-reaction)
    (set! (-> root no-reaction)
      (the-as
        (function collide-shape-moving collide-shape-intersect vector vector none)
        nothing))

    (let ((prim
            (new 'process
              'collide-shape-prim-sphere
              root
              (the-as uint 0))))
      (set! (-> prim prim-core collide-as) (collide-kind enemy))
      (set! (-> prim collide-with) (collide-kind target))
      (set! (-> prim prim-core action) (collide-action solid))
      (set! (-> prim prim-core offense) (collide-offense indestructible))

      (set-vector! (-> prim local-sphere) 0.0 0.0 0.0 1.0)
      (set-root-prim! root prim))

    (backup-collide-with-as root)
    (set! (-> self root) root))

  (set! (-> self owner) (the-as (pointer fisher-game) owner))
  (set! (-> self side-sign) side-sign)
  (set! (-> self speed) (meters 3.25))

  (set! (-> self side-axis x) (-> owner camera-axis z))
  (set! (-> self side-axis y) 0.0)
  (set! (-> self side-axis z) (- (-> owner camera-axis x)))
  (set! (-> self side-axis w) 0.0)
  (vector-normalize! (-> self side-axis) 1.0)

  (let* ((play-side (new 'stack-no-clear 'vector))
      (near-distance (meters 3.5))
      (far-distance (fisher-playfield-far-distance owner))
      (half-width (meters 1.5))
      (forward-dot (vector-dot (-> owner playfield-axis) (-> self side-axis)))
      (near-proj (* near-distance forward-dot))
      (far-proj (* far-distance forward-dot))
      (lane-dot 0.0)
      (lane-proj 0.0)
      (left-edge 0.0)
      (right-edge 0.0)
      (spawn-proj 0.0)
      (base-proj (* forward-distance forward-dot))
      (side-offset 0.0))

    (set! (-> play-side x) (-> owner playfield-axis z))
    (set! (-> play-side y) 0.0)
    (set! (-> play-side z) (- (-> owner playfield-axis x)))
    (set! (-> play-side w) 0.0)
    (vector-normalize! play-side 1.0)

    (set! lane-dot (fabs (vector-dot play-side (-> self side-axis))))
    (set! lane-proj (* half-width lane-dot))

    (set! left-edge (- (fmin near-proj far-proj) lane-proj))
    (set! right-edge (+ (fmax near-proj far-proj) lane-proj))

    (set!
      spawn-proj
      (if (> side-sign 0.0)
        (+ right-edge (meters 10.0))
        (- left-edge (meters 10.0))))

    (set! side-offset (- spawn-proj base-proj))

    (singlefish-vector-add-scaled-safe!
      (-> self root trans)
      (-> owner fishing-player-pos)
      (-> owner playfield-axis)
      forward-distance)
    (singlefish-vector-add-scaled-safe!
      (-> self root trans)
      (-> self root trans)
      (-> self side-axis)
      side-offset)

    (set!
      (-> self target-side)
      (if (> side-sign 0.0)
        (- left-edge (meters 10.0))
        (+ right-edge (meters 10.0)))))

  (set! (-> self root trans y) spawn-y)
  (set! (-> self root trans w) 1.0)

  (singlefish-vector-scale-safe!
    (-> self move-dir)
    (-> self side-axis)
    (- side-sign))

  (singlefish-vector-copy-safe! (-> self spawn-pos) (-> self root trans))
  (let ((relative (new 'stack-no-clear 'vector))
      (current-side 0.0)
      (remaining-side 0.0))
    (vector-! relative (-> self root trans) (-> owner fishing-player-pos))
    (set! current-side (vector-dot relative (-> self side-axis)))
    (set! remaining-side (- (-> self target-side) current-side))
    (singlefish-vector-add-scaled-safe!
      (-> self despawn-pos)
      (-> self root trans)
      (-> self side-axis)
      remaining-side)
    (set! (-> self despawn-pos y) spawn-y)
    (set! (-> self despawn-pos w) 1.0))

  (set! (-> self root scale x) 0.65)
  (set! (-> self root scale y) 0.65)
  (set! (-> self root scale z) 0.65)
  (set! (-> self root scale w) 1.0)
  (quaternion-identity! (-> self root quat))

  (initialize-skeleton self *fisher-snow-ball-sgc* '())
  (logclear! (-> self mask) (process-mask actor-pause))
  (go fisher-snowball-obstacle-idle)
  (none))

(defun fisher-reset-snowball-obstacle! ((self fisher-game))
  (set! (-> self snowball-handle) (the-as handle #f))
  (set! (-> self snowball-spawn-timer) (rand-vu-float-range 1.8 3.5))
  (none))

(defun fisher-update-snowball-obstacle! ((self fisher-game))
  (cond
    ((!= (-> self location-id) (the-as int (fisher-zone snow-ice)))
      (fisher-reset-snowball-obstacle! self))

    ((or
        (not (-> self casted?))
        (not
          (or
            (= (-> self cast-state) 'casting)
            (= (-> self cast-state) 'water-entry)
            (= (-> self cast-state) 'line-active))))
      (fisher-reset-snowball-obstacle! self))

    (else
      (-! (-> self snowball-spawn-timer) (-> *display* seconds-per-frame))
      (when (<= (-> self snowball-spawn-timer) 0.0)
        (let* ((side-sign (if (rand-vu-percent? 0.5) 1.0 -1.0))
            (forward-distance
              (rand-vu-float-range
                (meters 7.0)
                (- (fisher-playfield-far-distance self) (meters 4.0))))
            (top-y (- (-> self water-level) (meters 2.0)))
            (bottom-y
              (+ (- (-> self water-level) (fisher-playfield-max-depth self))
                (meters 2.0)))
            (spawn-y (rand-vu-float-range bottom-y top-y)))

          (process-spawn
            fisher-snowball-obstacle
            :init fisher-snowball-obstacle-init
            self
            side-sign
            forward-distance
            spawn-y
            :to self)

          (set! (-> self snowball-spawn-timer)
            (rand-vu-float-range 1.8 3.5))))))

  (none))

(defun fisher-update-lava-fire-system! ((self fisher-game))
  (cond
    ((!= (-> self location-id) (the-as int (fisher-zone village3-lava)))
      (fisher-reset-lava-fire-cycle! self))

    ((or
        (not (-> self casted?))
        (!= (-> self cast-state) 'line-active)
        (!= (-> self fish-state) 'free))
      (fisher-reset-lava-fire-cycle! self))

    (else
      (let ((dt (-> *display* seconds-per-frame)))
        (cond
          ((= (-> self lava-fire-state) 'waiting)
            (-! (-> self lava-fire-timer) dt)
            (when (<= (-> self lava-fire-timer) 0.0)
              (let ((slot (fisher-find-lava-fire-slot self)))
                (cond
                  ((>= slot 0)
                    (set! (-> self lava-fire-slot) slot)
                    (set! (-> self lava-fire-state) 'charging)
                    (set! (-> self lava-fire-timer) 0.0))

                  (else
                    (set! (-> self lava-fire-timer) 1.0))))))

          ((= (-> self lava-fire-state) 'charging)
            (let ((slot (-> self lava-fire-slot)))
              (cond
                ((or
                    (< slot 0)
                    (not (fisher-fish-pointer self slot))
                    (not (-> (fisher-fish-pointer self slot) 0 self)))
                  (fisher-reset-lava-fire-cycle! self))

                (else
                  (let* ((fish-proc
                          (the-as manipy
                            (-> (fisher-fish-pointer self slot) 0 self)))
                         (charge-pos
                          (new 'stack-no-clear 'vector)))
                    (vector-copy! charge-pos (-> fish-proc root trans))
                    (+! (-> charge-pos y) (meters 0.15))
                    (set! (-> charge-pos w) 1.0)

                    (-! (-> self lava-flame-time) dt)
                    (when (<= (-> self lava-flame-time) 0.0)
                      (set! (-> self lava-flame-time) 0.085)
                      (fisher-set-lava-puff-mode! self 2)

                      (launch-particles
                        :system *sp-particle-system-3d*
                        (-> *part-id-table* 3573)
                        charge-pos)

)

                    (+! (-> self lava-fire-timer) dt)

                    (when
                      (>=
                        (-> self lava-fire-timer)
                        *fisher-lava-fire-charge-seconds*)
                      (set! (-> self lava-fire-state) 'firing)
                      (set! (-> self lava-fire-timer) 0.0)
                      (set! (-> self lava-flame-time) 0.0)))))))

          ((= (-> self lava-fire-state) 'firing)
            (let ((slot (-> self lava-fire-slot)))
              (cond
                ((or
                    (< slot 0)
                    (not (fisher-fish-pointer self slot))
                    (not (-> (fisher-fish-pointer self slot) 0 self)))
                  (fisher-reset-lava-fire-cycle! self))

                (else
                  (let ((fish-proc
                          (the-as manipy
                            (-> (fisher-fish-pointer self slot) 0 self))))
                    (+! (-> self lava-fire-timer) dt)
                    (-! (-> self lava-flame-time) dt)

                    (when (<= (-> self lava-flame-time) 0.0)
                      (set!
                        (-> self lava-flame-time)
                        *fisher-lava-flame-interval-seconds*)

                      (fisher-submit-lava-flame-wall!
                        self
                        slot
                        fish-proc))

                    (cond
                      ((fisher-lava-flame-hits-hook?
                          self
                          slot
                          fish-proc)
                        (fisher-incinerate-lure! self)
                        (fisher-reset-lava-fire-cycle! self))

                      ((>=
                          (-> self lava-fire-timer)
                          *fisher-lava-fire-duration-seconds*)
                        (fisher-reset-lava-fire-cycle! self))))))))

          (else
            (fisher-reset-lava-fire-cycle! self))))))

  (none))

(defun fisher-update-dark-eco-teleport! ((self fisher-game))
  (when
    (and
      (= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
      *fisher-session-active?*)
    (let ((dt (-> *display* seconds-per-frame)))
      (-! (-> self dark-eco-teleport-timer) dt)

      (when
        (and
          (<= (-> self dark-eco-teleport-timer) 10.0)
          (not (-> self dark-eco-warning-played?)))
        (set! (-> self dark-eco-warning-played?) #t)
        (play-sound-file
          "dark-eco-warning.mp3"
          (the int (-> *setting-control* current sfx-volume))))

      (when
        (<= (-> self dark-eco-teleport-timer) 0.0)
        (fisher-dark-eco-teleport-fish! self)
        (set! (-> self dark-eco-teleport-timer) 45.0)
        (set! (-> self dark-eco-warning-played?) #f)
        (when *fisher-in-debug?*
          (format #t "[FISHER] DARK ECO FISH TELEPORTED~%")))))

  (none))

(defun fisher-update-casting! ((self fisher-game))
  (when (not (fisher-finalboss-zone? self))
    (fisher-update-ability-cooldowns! self))
  (fisher-update-dark-eco-teleport! self)
  (fisher-update-voltage-surge! self)
  (fisher-update-electric-system! self)
  (fisher-update-yellow-system! self)
  (fisher-update-lava-fire-system! self)
  (fisher-update-snowball-obstacle! self)
  (fisher-submit-village3-lava-ambient! self)
  (fisher-submit-lava-fish-effects! self)
  (fisher-draw-voltage-meter! self)
  (fisher-handle-fish-input! self)
  (fisher-draw-playfield-debug! self)

  (dotimes (slot *fisher-max-fish-slots*) (fisher-debug-draw-logical-fish-marker! self slot))

  (fisher-update-all-fish-debug! self)

  (fisher-update-camera-water! self)
  (fisher-maintain-pool-rendering! self)

  (fisher-update-background-mist! self)

  (fisher-update-level-up-window!)

  (cond
    ((fisher-level-up-window-active?)
      (fisher-restore-normal-background!)
      (fisher-draw-level-up-window!))

    ((or
        *fisher-level-up-window-pending?*
        *fisher-level-up-window-request?*)

      (fisher-restore-normal-background!))

    ((= (-> self cast-state) 'ready)
      (fisher-restore-normal-background!)

      (if (> *fisher-lure-count* 0)
        (draw-mod-menu-text-custom "PRESS <PAD_X> TO CAST" 256 160 #f #t #f)
        (draw-mod-menu-text-custom "OUT OF LURES" 256 160 #f #t #f))

      (when (cpad-pressed? 0 x)
        (cpad-clear! 0 x)
        (when (> *fisher-lure-count* 0)
          (cond
            ((fisher-finalboss-zone? self)
              (set! (-> self cast-charge) 1.0)
              (set! (-> self cast-charge-direction) 0.0)
              (fisher-start-cast! self))
            (else
              (set! (-> self cast-state) 'charging)
              (set! (-> self cast-charge) 0.0)
              (set! (-> self cast-charge-direction) 1.0))))))

    ((= (-> self cast-state) 'charging)
      (fisher-restore-normal-background!)
      (fisher-draw-cast-bar (-> self cast-charge))

      (when (cpad-pressed? 0 x) (cpad-clear! 0 x) (fisher-start-cast! self))

      (when (= (-> self cast-state) 'charging)
        (+! (-> self cast-charge) (* (-> self cast-charge-direction) (-> *display* seconds-per-frame)))

        (cond
          ((>= (-> self cast-charge) 1.0) (set! (-> self cast-charge) 1.0) (set! (-> self cast-charge-direction) -1.0))

          ((<= (-> self cast-charge) 0.0)
            (set! (-> self cast-charge) 0.0)
            (fisher-reset-cast! self)))))

    ((= (-> self cast-state) 'casting)
      (fisher-update-cast-arc! self)
      (fisher-update-reel-hint! self)
      (fisher-camera-follow-lure! self)
      (fisher-update-underwater-background! self)
      (fisher-update-camera-bubbles! self)
      (fisher-update-lure-snake! self)
      (fisher-draw-line-hp-bar)
      (fisher-draw-line! self))

    ((= (-> self cast-state) 'water-entry)
      (fisher-update-water-entry! self)
      (fisher-camera-follow-lure! self)
      (fisher-update-reel-hint! self)
      (fisher-update-underwater-background! self)
      (fisher-update-camera-bubbles! self)
      (fisher-update-lure-snake! self)
      (fisher-draw-line-hp-bar)
      (fisher-draw-line! self))

    ((= (-> self cast-state) 'line-active)
      (cond
        ((or (= (-> self fish-state) 'free) (= (-> self fish-state) 'approaching)) (fisher-update-lure! self))

        ((= (-> self fish-state) 'reeling)
          (fisher-update-manipy-reeling! self)))

      (when (fisher-finalboss-zone? self)
        (fisher-finalboss-center-lure-horizontal! self))

      (cond
        ((= (-> self fish-state) 'reeling) (fisher-camera-follow-lure! self))

        (else
          (fisher-camera-follow-lure! self)))

      (fisher-update-reel-hint! self)
      (fisher-update-underwater-background! self)
      (fisher-update-camera-bubbles! self)
      (fisher-update-lure-snake! self)
      (fisher-draw-line-hp-bar)
      (fisher-draw-line! self))

    ((= (-> self cast-state) 'lure-stolen-return)
      (fisher-update-lure-stolen-return! self))

    ((= (-> self cast-state) 'power-cell-ui-wait)
      (fisher-restore-normal-background!)

      (when
        (and
          (not *fisher-xp-fly-active?*)
          (not *fisher-xp-bar-anim-active?*)
          (not (fisher-level-up-blocking?)))

        (set! (-> self cast-state) 'buzzer-exit)))

    ((= (-> self cast-state) 'buzzer-exit)
      (go-virtual exit))

    ((= (-> self cast-state) 'catch-transition) (fisher-restore-normal-background!) (fisher-update-catch-return! self))

    ((= (-> self cast-state) 'catch-display)
      (fisher-restore-normal-background!)
      (fisher-camera-catch-display! self)
      (fisher-update-catch-menu-animation! self)
      (fisher-draw-catch-ui! self)
      (fisher-draw-rare-fish-ui! self)))

  (fisher-update-xp-gain-animation!)

  (when
    (not (= (-> self cast-state) 'catch-transition))

    (fisher-draw-xp-meter!)

    (when
      (and
        (not (fisher-finalboss-zone? self))
        (not (fisher-modal-ui-active? self)))
      (fisher-draw-skill-cooldowns! self)))

  (fisher-draw-fish-status! self)
  (fisher-draw-lure-skill-message! self)
  (fisher-draw-button-fight! self)

  (when
    (and
      (not (fisher-finalboss-zone? self))
      (not (fisher-modal-ui-active? self)))
    (fisher-draw-lure-count))

  (fisher-draw-fishing-clock!)
  (none))

(defun fisher-face-jak-right-side! ((self fisher-game))
  (when *target*
    (let ((jak-forward (new 'stack-no-clear 'vector))
        (jak-rot (new 'stack-no-clear 'matrix)))

      (vector-copy! jak-forward (-> self playfield-axis))

      (set! (-> jak-forward y) 0.0)
      (set! (-> jak-forward w) 0.0)

      (vector-normalize! jak-forward 1.0)

      (forward-down->inv-matrix jak-rot jak-forward (-> *camera* local-down))

      (matrix->quaternion (-> *target* control quat-for-control) jak-rot)

      (quaternion-copy! (-> *target* control quat) (-> *target* control quat-for-control))

      (rot->dir-targ! (-> *target* control))
    )
  )

  (none)
)

(define *fisher-power-cell-camera-base-back*
  (new 'static 'vector))

(define *fisher-power-cell-camera-orbit-back*
  (new 'static 'vector))

(define *fisher-power-cell-camera-pos*
  (new 'static 'vector))

(define *fisher-power-cell-camera-look-pos*
  (new 'static 'vector))

(define *fisher-power-cell-camera-forward*
  (new 'static 'vector))

(defun fisher-power-cell-camera-controller ()
  (let ((elapsed 0.0)
        (orbit-duration 2.5)
        (zoom-duration 3.8)
        (shot-duration 0.42)
        (orbit-progress 0.0)
        (zoom-progress 0.0)
        (shot-progress 0.0)
        (ease 0.0)
        (orbit-angle 0.0)
        (camera-distance (meters 6.35))
        (camera-height (meters 2.45)))

    (when *camera*
      (send-event *camera* 'change-state cam-fixed 0))

    (while (and *fisher-power-cell-camera-active?* *target* *camera*)
      (+! elapsed (-> *display* seconds-per-frame))

      (let ((jak-yaw (y-angle (-> *target* control))))
        (set! (-> *fisher-power-cell-camera-base-back* x) (- (sin jak-yaw)))
        (set! (-> *fisher-power-cell-camera-base-back* y) 0.0)
        (set! (-> *fisher-power-cell-camera-base-back* z) (- (cos jak-yaw)))
        (set! (-> *fisher-power-cell-camera-base-back* w) 0.0)
        (vector-normalize! *fisher-power-cell-camera-base-back* 1.0))

      (cond
        ((< elapsed orbit-duration)
          (set! orbit-progress (fmin 1.0 (/ elapsed orbit-duration)))
          (set! ease (fisher-smoothstep orbit-progress))
          (set! orbit-angle (degrees (* 180.0 ease)))
          (set! camera-distance (meters 6.35))
          (set! camera-height
            (meters (+ 2.45 (* 0.30 (sin (* (degrees 180.0) ease)))))))

        ((< elapsed (+ orbit-duration zoom-duration))
          (set! zoom-progress
            (fmin 1.0 (/ (- elapsed orbit-duration) zoom-duration)))
          (set! ease (fisher-smoothstep zoom-progress))
          (set! orbit-angle (degrees 180.0))
          (set! camera-distance
            (meters (+ 6.35 (* 1.65 ease))))
          (set! camera-height
            (meters (+ 2.45 (* 0.30 ease)))))

        (else
          (set! shot-progress
            (fmin 1.0 (/ (- elapsed (+ orbit-duration zoom-duration)) shot-duration)))
          (set! ease (fisher-smoothstep shot-progress))
          (set! orbit-angle (degrees 180.0))
          (set! camera-distance
            (meters (+ 8.0 (* 4.0 ease))))
          (set! camera-height
            (meters (+ 2.75 (* 0.85 ease))))))

      (vector-rotate-y!
        *fisher-power-cell-camera-orbit-back*
        *fisher-power-cell-camera-base-back*
        orbit-angle)
      (vector-normalize! *fisher-power-cell-camera-orbit-back* 1.0)

      (vector+float*!
        *fisher-power-cell-camera-pos*
        (-> *target* control trans)
        *fisher-power-cell-camera-orbit-back*
        camera-distance)
      (+! (-> *fisher-power-cell-camera-pos* y) camera-height)
      (set! (-> *fisher-power-cell-camera-pos* w) 1.0)

      (vector-copy! *fisher-power-cell-camera-look-pos* (-> *target* control trans))
      (+! (-> *fisher-power-cell-camera-look-pos* y)
        (meters (+ 1.60 (* 0.30 shot-progress))))
      (set! (-> *fisher-power-cell-camera-look-pos* w) 1.0)

      (when (> (-> *camera* num-slaves) 0)
        (let ((cam-slave (-> *camera* slave 0 0)))
          (set! (-> cam-slave saved-pt quad) (-> *fisher-power-cell-camera-pos* quad))
          (set! (-> cam-slave trans quad) (-> *fisher-power-cell-camera-pos* quad))
          (vector-!
            *fisher-power-cell-camera-forward*
            *fisher-power-cell-camera-look-pos*
            *fisher-power-cell-camera-pos*)
          (vector-normalize! *fisher-power-cell-camera-forward* 1.0)
          (forward-down->inv-matrix
            (-> cam-slave tracking inv-mat)
            *fisher-power-cell-camera-forward*
            (-> *camera* local-down))))

      (suspend))

    (when *camera*
      (send-event *camera* 'change-state *camera-base-mode* (seconds 0.45))))
  (none))

(defbehavior fisher-buzzer-power-cell-reward fuel-cell ((task int))

  (initialize self)
  (set! (-> self fact pickup-type) (pickup-type fuel-cell))
  (set! (-> self fact pickup-amount) (the float task))
  (initialize-params self 0 (the-as float 1024.0))
  (logclear! (-> self mask) (process-mask actor-pause))
  (set! (-> self actor-pause) #f)

  (suspend)

  (when *target*
    (sound-play "pu-powercell")
    (clear-collide-with-as (-> self root))
    (logclear! (-> self mask) (process-mask actor-pause))
    (logclear! (-> self draw status) (draw-status hidden))

    (if (nonzero? (-> self sound))
      (stop! (-> self sound)))

    (while (handle->process (-> *game-info* other-camera-handle))
      (spool-push
        *art-control*
        (-> self victory-anim name)
        0
        self
        (the-as float -99.0))
      (suspend))

    (while (not (send-event *target* 'clone-anim self))
      (spool-push
        *art-control*
        (-> self victory-anim name)
        0
        self
        (the-as float -99.0))
      (suspend))

    (move-to-point! (-> self root) (-> *target* control trans))
    (set-yaw-angle-clear-roll-pitch!
      (-> self root)
      (y-angle (-> *target* control)))
    (move-to-ground
      (-> self root)
      (the-as float 40960.0)
      (the-as float 40960.0)
      #f
      (collide-kind background))
    (set! (-> self base quad) (-> self root trans quad))
    (set! (-> self old-base quad) (-> self root trans quad))
    (update-transforms! (-> self root))
    (ja-post)

    (set! (-> self draw bounds w) 32768.0)
    (logior! (-> self skel status) (janim-status inited))
    (logior! (-> self draw status) (draw-status hidden))

    (process-spawn
      fuel-cell
      :init fuel-cell-init-as-clone
      (process->handle self)
      task
      :name "fisher-visible-power-cell"
      :to self)

    (spool-push
      *art-control*
      (-> self victory-anim name)
      0
      self
      (the-as float -99.0))

    (send-event
      *target*
      'get-pickup
      (pickup-type fuel-cell)
      (the float task))

    (send-event *target* 'blend-shape #t)

    (add-setting! 'music-volume 'rel
      (-> *setting-control* current music-volume-movie) 0)
    (add-setting! 'sfx-volume 'rel
      (-> *setting-control* current sfx-volume-movie) 0)
    (add-setting! 'ambient-volume 'rel
      (-> *setting-control* current ambient-volume-movie) 0)

    (set! *fisher-power-cell-camera-active?* #t)
    (process-spawn-function
      process
      fisher-power-cell-camera-controller
      :name "fisher-power-cell-camera"
      :to *active-pool*)

    (auto-save-command 'auto-save 0 0 *default-pool*)

    (ja-play-spooled-anim
      (-> self victory-anim)
      (the-as art-joint-anim fuel-cell-idle-ja)
      (the-as art-joint-anim #f)
      (the-as (function process-drawable symbol) false-func))

    (set! (-> self state-object) #f)
    (when (nonzero? (-> self part))
      (kill-and-free-particles (-> self part)))
    (logior! (-> self draw status) (draw-status skip-bones hidden))

    (set! *fisher-power-cell-camera-active?* #f)

    (remove-setting! 'music-volume)
    (remove-setting! 'sfx-volume)
    (remove-setting! 'ambient-volume)
    (send-event *target* 'blend-shape #f)
    (send-event *target* 'end-mode)
    (send-event *camera* 'no-intro)
    (send-event *camera* 'clear-entity)
    (ja-channel-set! 0)

    (suspend)
    (suspend))

  (set! *fisher-power-cell-camera-active?* #f)
  (set! *fisher-power-cell-reward-active?* #f)

  (when *fisher-game*
    (let ((game (the-as fisher-game (-> *fisher-game* 0))))
      (fisher-add-power-cell-fish-slot! game)
      (fisher-add-fire-canyon-cellfish-slot! game)
      (fisher-add-mountain-pass-cellfish-slots! game)))

  (deactivate self)
  (none))

(defstate idle (fisher-game)
  :virtual #t
  :code
  (behavior ()
    (loop
      (when
        (and
          (not *fisher-power-cell-reward-active?*)
          (or
            (-> self buzzer-victory-pending?)
            (-> self power-cell-victory-pending?)))

        (let* ((carrier-reward?
              (-> self power-cell-victory-pending?))
            (reward-task
              (if
                carrier-reward?
                (-> self caught-power-cell-task)
                (-> self caught-buzzer-task))))

          (set! (-> self buzzer-victory-pending?) #f)
          (set! (-> self power-cell-victory-pending?) #f)
          (set! (-> self caught-buzzer-count) 0)
          (set! (-> self caught-buzzer-task) 0)
          (set! (-> self caught-power-cell-task) 0)

          (when
            (and
              (> reward-task 1)
              (not
                (task-complete?
                  *game-info*
                  (the-as game-task reward-task))))

            (set! *fisher-power-cell-reward-active?* #t)

            (process-spawn-function
              fuel-cell
              fisher-buzzer-power-cell-reward
              reward-task
              :name "fisher-power-cell-reward"
              :to *entity-pool*))))

      (when
        (and
          (not *fisher-power-cell-reward-active?*)
          (not (handle->process (-> *game-info* other-camera-handle)))
          (not (movie?))
          (<=
            (vector-vector-distance
              (target-pos 0)
              (-> self pos))
            (meters 5)))

        (cond
          ((cpad-pressed? 0 circle)
            (cpad-clear! 0 circle)

            (when
              (and
                *target*
                (process-grab? *target*))

              (set! (-> self camera-state) 'before-cast)
              (send-event *camera* 'change-state cam-fixed 0)
              (go-virtual fishing)))

          (else
            (draw-mod-menu-text-custom
              "PRESS <PAD_CIRCLE> TO START FISHING"
              256
              160
              #f
              #t
              #f))))

      (suspend))))

(defun fisher-maintain-player-control! ((self fisher-game))
  (when *target*
    (set! (-> *target* root trans quad) (-> self fishing-player-pos quad))
    (set! (-> *target* control trans quad) (-> self fishing-player-pos quad))
    (vector-reset! (-> *target* root transv))
    (set! *camera-read-analog* #f)
    (set! *external-cam-mode* #f))
  (none))

(defun fisher-session-invalid? ((self fisher-game))
  (or
    (not *target*)
    (> (vector-vector-distance (target-pos 0) (-> self fishing-player-pos)) (meters 18))))

(defstate fishing (fisher-game)
  :virtual #t

  :enter
  (behavior ()
    (set! *fisher-session-active?* #t)

    (when
      (= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
      (set! (-> self dark-eco-teleport-timer) 45.0)
      (set! (-> self dark-eco-warning-played?) #f)
      (set! (-> self dark-eco-displaced-slot) -1))

    (set! (-> *target* root trans quad) (-> self fishing-player-pos quad))

    (set! (-> *target* control trans quad) (-> self fishing-player-pos quad))

    (play-main-music
      (cond
        ((= (-> self location-id) (the-as int (fisher-zone finalboss-nuclear)))
          (cond
            ((= (-> *fisher-finalboss-runtime* stage) 2)
              "second-phase-final.mp3")
            ((= (-> *fisher-finalboss-runtime* stage) 3)
              "third-phase-final.mp3")
            (else
              "final-boss-fishing.mp3")))

        ((= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
          "dark-eco-pool-theme.mp3")

        ((= (-> self location-id) (the-as int (fisher-zone village3-lava)))
          "lava-pool-theme.mp3")

        ((or
            (= (-> self location-id) (the-as int (fisher-zone swamp-sludge)))
            (= (-> self location-id) (the-as int (fisher-zone village2-electric)))
            (= (-> self location-id) (the-as int (fisher-zone sunken-voltage))))
          "fishing-theme-b.mp3")

        (else
          "fishing-theme-a.wav"))
      (the int (-> *setting-control* current sfx-volume)))
    (set! (-> self stored-music-vol) (-> *setting-control* current music-volume))
    (set-setting! 'music-volume 'abs 0.0 0)
    (set! (-> self saved-camera-read-analog) *camera-read-analog*)

    (set! (-> self saved-external-cam-mode) *external-cam-mode*)

    (set! *camera-read-analog* #f)
    (set! *external-cam-mode* #f)

    (fisher-reset-cast! self)
    (singlefish-start-session! self)
    (fisher-finalboss-prepare-session! self)

    (set! *fisher-background-cloud-session-active?* #t)
    (set! *fisher-background-cloud-visible?* #f)
    (fisher-launch-background-mist! self)
  )

  :code
  (behavior ()
    (loop
      (when (fisher-session-invalid? self)
        (go-virtual exit))

      (fisher-maintain-player-control! self)

      (when (= (-> self camera-state) 'before-cast) (fisher-face-jak-right-side! self) (fisher-camera-before-cast! self))

      (fisher-update-casting! self)

      (when
        (and
          (= (-> self cast-state) 'ready)
          (= (-> self fish-state) 'free)
          (not *fisher-xp-fly-active?*)
          (not *fisher-xp-bar-anim-active?*)
          (not (fisher-level-up-blocking?))
          (cpad-pressed? 0 triangle))

        (cpad-clear! 0 triangle)
        (go-virtual exit)
      )

      (cpad-clear! 0 x)
      (cpad-clear! 0 circle)
      (cpad-clear! 0 square)
      (cpad-clear! 0 triangle)

      (suspend)
    )
  )
)

(defstate exit (fisher-game)
  :virtual #t
  :code
  (behavior ()
    (set! *camera-read-analog* (-> self saved-camera-read-analog))
    (set! *external-cam-mode* (-> self saved-external-cam-mode))
    (unless
      (and
        (fisher-finalboss-zone? self)
        *fisher-finalboss-hold-music-mute?*)
      (remove-setting! 'music-volume))
    (stop-main-music)
    (send-event *camera* 'change-state *camera-base-mode* (seconds 0.5))

    (singlefish-end-session! self)
    (fisher-remove-lure-snake! self)
    (set! *fisher-background-cloud-visible?* #f)
    (set! *fisher-background-cloud-session-active?* #f)
    (fisher-restore-normal-background!)

    (when *target*
      (process-release? *target*))

    (fisher-reset-cast! self)
    (set! *fisher-session-active?* #f)

    (go-virtual idle)
  )
)