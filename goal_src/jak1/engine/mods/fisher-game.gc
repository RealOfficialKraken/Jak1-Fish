            256
            (+ 140 menu-offset)
            0.46)

          (draw-fisher-large-font-scaled
            "RARE FISH ARE NOW SLIGHTLY EASIER TO FIND."
            256
            (+ 166 menu-offset)
            0.31))

        ((> skill-mask 0)
          (fisher-draw-level-up-title!
            "SKILLS UNLOCKED"
            256
            (+ 137 menu-offset)
            0.46)

          (when
            (nonzero? (logand skill-mask 1))
            (draw-fisher-large-font-scaled
              "<PAD_SQUARE> STOP LURE: 3 SEC / 20 SEC COOLDOWN."
              256
              (+ 157 menu-offset)
              0.30))

          (when
            (nonzero? (logand skill-mask 2))
            (fisher-draw-reel-hint-text-red
              "R1"
              74
              (+ 174 menu-offset)
              0.32)

            (fisher-draw-reel-hint-text
              " SINK LURE: 3X DOWN FOR 3.5 SECONDS."
              94
              (+ 174 menu-offset)
              0.30))

          (when
            (nonzero? (logand skill-mask 4))
            (fisher-draw-reel-hint-text-red
              "L1"
              74
              (+ 191 menu-offset)
              0.32)

            (fisher-draw-reel-hint-text
              " FAST REEL: 2X REEL FOR 2 SECONDS."
              94
              (+ 191 menu-offset)
              0.30))

          (when
            (nonzero? (logand skill-mask 16))
            (draw-fisher-large-font-scaled
              "<PAD_CIRCLE> TUG LINE: END A FISH'S FIGHTING"
              256
              (+ 207 menu-offset)
              0.27))

          (when
            (nonzero? (logand skill-mask 32))
            (fisher-draw-reel-hint-text-red
              "R2"
              74
              (+ 220 menu-offset)
              0.27)

            (fisher-draw-reel-hint-text
              " HEAL LINE: RESTORE 65 HP / 26 SEC."
              94
              (+ 220 menu-offset)
              0.25))))

      (draw-fisher-large-font-scaled
        "PRESS <PAD_X> TO CONTINUE"
        256
        (+ continue-y menu-offset)
        0.43)))

  (none))

(defun spawn-fisher-net-at ((pos vector))
  (let ((net
        (manipy-spawn
          pos
          #f
          *fish-net-sgc*
          #f
          :from *default-dead-pool*
          :to *default-pool*
          :name "test-fisher-net")))

    (when net
      (let ((net-proc
            (-> net 0 self))

          (rot
            (new 'stack-no-clear 'matrix)))

        (send-event net-proc 'anim-mode 'still)

        (send-event net-proc 'set-frame-num 10.0)

        (set! (-> (the-as manipy net-proc) root trans quad) (-> pos quad))

        (matrix-rotate-x! rot (degrees 180))

        (matrix->quaternion (-> (the-as manipy net-proc) root quat) rot)

        (send-event
          net-proc
          'max-vis-dist
          (meters 999999.0))))

    net)
)

(defun spawn-fisher-lure-snake ((pos vector))
  (let ((snake
        (manipy-spawn
          pos
          #f
          *junglesnake-sgc*
          #f
          :from *default-dead-pool*
          :to *default-pool*
          :name "fisher-lure-snake")))
    (when snake
      (let ((snake-proc
            (-> snake 0 self)))
        (send-event snake-proc 'anim-mode 'loop)
        (set! (-> (the-as manipy snake-proc) root trans quad) (-> pos quad))
        (set-vector! (-> (the-as manipy snake-proc) root scale) 0.0333333 0.0333333 0.0333333 1.0)
        (send-event
          snake-proc
          'max-vis-dist
          (meters 999999.0))))
    snake)
)

(defun fisher-restore-normal-background! ()
  (set! *fisher-underwater-haze-override?* #f)

  (none)
)

(defbehavior fisher-game-init-by-other fisher-game ((location-id int) (vec vector) (camera-vec vector) (water-height float) (angles vector))
  (set! (-> self location-id) location-id)
  (set! (-> self fish-data) *fisher-fish-runtime*)
  (set! (-> self button-fight-data) *fisher-button-fight-runtime*)
  (set! (-> self voltage-data) *fisher-voltage-runtime*)
  (set! (-> self yellow-data) *fisher-yellow-runtime*)
  (set! (-> self stored-music-vol) (-> *setting-control* current sfx-volume))
  (vector-copy! (-> self pos) vec)
  (vector-copy!
    (-> self fishing-player-pos)
    *fisher-spawn-player-pos*)
  (vector-copy! (-> self fisher-cam) camera-vec)
  (let ((camera-offset
        (new 'stack-no-clear 'vector)))
    (vector-! camera-offset camera-vec vec)
    (set! (-> camera-offset y) 0.0)
    (set! (-> camera-offset w) 0.0)
    (set! (-> self camera-radius) (vector-length camera-offset))
  )
  (vector-reset! (-> self lure-snake-angle))
  (vector-reset! (-> self lure-snake-angular-speed))
  (vector-reset! (-> self lure-snake-last-anchor))
  (set! (-> self lure-snake-flow-time) 0.0)
  (set! (-> self water-level) water-height)
  (set! (-> self camera-angle) (-> angles x))
  (set! (-> self playfield-angle) (-> angles y))
  (set! (-> self camera-axis x) (sin (-> self camera-angle)))
  (set! (-> self camera-axis y) 0.0)
  (set! (-> self camera-axis z) (cos (-> self camera-angle)))
  (set! (-> self camera-axis w) 0.0)
  (vector-normalize! (-> self camera-axis) 1.0)
  (set! (-> self playfield-axis x) (sin (-> self playfield-angle)))
  (set! (-> self playfield-axis y) 0.0)
  (set! (-> self playfield-axis z) (cos (-> self playfield-angle)))
  (set! (-> self playfield-axis w) 0.0)
  (vector-normalize! (-> self playfield-axis) 1.0)
  (set! (-> self saved-camera-read-analog) #t)
  (set! (-> self saved-external-cam-mode) #f)
  (set! (-> self casted?) #f)
  (set! (-> self camera-state) 'before-cast)
  (set! (-> self camera-underwater?) #f)
  (set! (-> self cast-state) 'ready)
  (set! (-> self cast-charge) 0.0)
  (set! (-> self cast-charge-direction) 0.0)
  (set! (-> self cast-time) 0.0)
  (set! (-> self cast-duration) 1.0)
  (set! (-> self camera-blend) 0.0)
  (set! (-> self lure-fall-speed) 1.25)
  (set! (-> self lure-reel-x-speed) 4.0)
  (set! (-> self lure-reel-y-speed) 3.0)

  (when
    (= (-> self location-id) (the-as int (fisher-zone swamp-sludge)))
    (set! (-> self lure-fall-speed) (* (-> self lure-fall-speed) 0.70))
    (set! (-> self lure-reel-x-speed) (* (-> self lure-reel-x-speed) 0.70))
    (set! (-> self lure-reel-y-speed) (* (-> self lure-reel-y-speed) 0.70)))

  (when
    (= (-> self location-id) (the-as int (fisher-zone finalboss-nuclear)))
    (set! (-> self lure-fall-speed) 5.0)
    (set! (-> self lure-reel-x-speed) 0.35)
    (set! (-> self lure-reel-y-speed) 0.28))

  (when
    (= (-> self location-id) (the-as int (fisher-zone snow-ice)))
    (set! (-> self lure-fall-speed) (* (-> self lure-fall-speed) 0.75))
    (set! (-> self lure-reel-x-speed) (* (-> self lure-reel-x-speed) 0.75))
    (set! (-> self lure-reel-y-speed) (* (-> self lure-reel-y-speed) 0.75)))

  (set! (-> self lure-x-velocity) 0.0)
  (set! (-> self reel-hint-time) 0.0)
  (fisher-reset-level-up-window!)
  (set! (-> self lure-stop-active?) #f)
  (set! (-> self lure-stop-used?) #f)
  (set! (-> self lure-stop-time) 0.0)
  (set! (-> self lure-stop-cooldown) 0.0)
  (set! (-> self lure-sink-active?) #f)
  (set! (-> self lure-sink-used?) #f)
  (set! (-> self lure-sink-time) 0.0)
  (set! (-> self lure-sink-cooldown) 0.0)
  (set! (-> self tug-line-active?) #f)
  (set! (-> self tug-line-time) 0.0)
  (set! (-> self tug-line-cooldown) 0.0)
  (set! (-> self rip-line-cooldown) 0.0)
  (set! (-> self heal-line-cooldown) 0.0)
  (set! (-> self lure-destroyed?) #f)
  (set! (-> self lure-incinerated?) #f)
  (set! (-> self lure-y-velocity) 0.0)
  (set! (-> self bubble-time) -2.0)
  (set! (-> self underwater-wave-time) 0.0)
  (set! (-> self background-mist-time) 0.0)
  (set! (-> self background-curtain-phase) 0.0)
  (set! (-> self hooked-fish) #f)
  (set! (-> self fish-state) 'free)
  (set! (-> self fish-scare-on-arrival?) #f)
  (set! (-> self fish-message) #f)
  (set! (-> self fish-message-time) 0.0)
  (set! (-> self skill-message) #f)
  (set! (-> self skill-message-time) 0.0)
  (set! (-> self fish-approach-speed) 2.20)
  (set! (-> self buzzer-victory-pending?) #f)
  (set! (-> self caught-buzzer-count) 0)
  (set! (-> self caught-buzzer-task) 0)
  (set! (-> self power-cell-victory-pending?) #f)
  (set! (-> self caught-power-cell-task) 0)
  (set! (-> self electric-state) 'waiting)
  (set! (-> self electric-timer)
    (rand-vu-float-range
      *fisher-electric-cycle-min-seconds*
      *fisher-electric-cycle-max-seconds*))
  (set! (-> self electric-slot) -1)
  (set! (-> self electric-line-time) 0.0)
  (set! (-> self electric-line-stun-time) 0.0)
  (set! (-> self electric-stun-triggered?) #f)
  (set! (-> self electric-charge-part)
    (the-as sparticle-launch-control 0))
  (set! (-> self electric-projectile-part)
    (the-as sparticle-launch-control 0))
  (set! (-> self electric-line-part-a)
    (the-as sparticle-launch-control 0))
  (set! (-> self electric-line-part-b)
    (the-as sparticle-launch-control 0))
  (vector-reset! (-> self electric-projectile-pos))
  (vector-reset! (-> self electric-projectile-dir))
  (set! (-> self voltage-time) 0.0)
  (set! (-> self voltage-flash-time) 0.0)
  (set! (-> self voltage-active?) #f)
  (set! (-> self voltage-shots-remaining) 0)
  (dotimes (voltage-slot *fisher-max-fish-slots*)
    (set! (-> self voltage-data slot voltage-slot state) 0)
    (set! (-> self voltage-data slot voltage-slot timer) 0.0)
    (vector-reset! (-> self voltage-data slot voltage-slot position))
    (vector-reset! (-> self voltage-data slot voltage-slot direction)))
  (set! (-> self yellow-data state) 'waiting)
  (set! (-> self yellow-data timer)
    (rand-vu-float-range
      *fisher-yellow-cycle-min-seconds*
      *fisher-yellow-cycle-max-seconds*))
  (set! (-> self yellow-data slot) -1)
  (set! (-> self yellow-data projectile-time) 0.0)
  (vector-reset! (-> self yellow-data position))
  (vector-reset! (-> self yellow-data direction))
  (set! (-> self lava-fire-state) 'waiting)
  (set! (-> self lava-fire-timer) *fisher-lava-fire-cycle-seconds*)
  (set! (-> self lava-fire-slot) -1)
  (set! (-> self lava-trail-time) 0.0)
  (set! (-> self lava-flame-time) 0.0)
  (set! (-> self snowball-spawn-timer) 2.5)
  (set! (-> self snowball-handle) (the-as handle #f))
  (set! (-> self dark-eco-teleport-timer) 45.0)
  (set! (-> self dark-eco-warning-played?) #f)
  (set! (-> self dark-eco-displaced-slot) -1)
  (set! (-> self fish-count) 0)
  (dotimes (slot-index *fisher-max-fish-slots*)
    (set! (-> self fish-data slot slot-index visual)
      (the-as (pointer manipy) #f))
    (set! (-> self fish-data slot slot-index species) 0)
    (set! (-> self fish-data slot slot-index level) 1)
    (set! (-> self fish-data slot slot-index suffix) 2)
    (set! (-> self fish-data slot slot-index weight-tenths) 10)
    (set! (-> self fish-data slot slot-index power-cell-task) 0)
    (set! (-> self fish-data slot slot-index distance) 0.0)
    (set! (-> self fish-data slot slot-index lane) 0.0)
    (set! (-> self fish-data slot slot-index depth) 0.0)
    (set! (-> self fish-data slot slot-index direction) 1.0)
    (set! (-> self fish-data slot slot-index speed) 1.0)
    (set! (-> self fish-data slot slot-index cooldown) 0.0)
    (set! (-> self fish-data slot slot-index turn-time) 0.0)
    (set! (-> self fish-data slot slot-index turn-old-direction) 1.0)
    (set! (-> self fish-data slot slot-index turn-side) 1.0))

  (fisher-clear-button-fight! self)

  (vector-reset! (-> self lure-pos))

  (vector-reset! (-> self lure-cast-start))

  (vector-reset! (-> self lure-cast-end))

  (vector-reset! (-> self lure-cast-axis))

  (vector-reset! (-> self lure-camera-offset))

  (vector-reset! (-> self lure-camera-pos))

  (vector-reset! (-> self lure-camera-look))

  (spawn-fisher-net-at (-> self pos))

  (set! (-> self lure-snake) (the-as (pointer manipy) #f))

  (go-virtual idle)
)

(defun spawn-fisher-game
  ((location-id int)
    (fishnet-pos vector)
    (player-pos vector)
    (camera-pos vector)
    (water-height float)
    (camera-angle float)
    (playfield-angle float))

  (let ((angles
        (new 'stack-no-clear 'vector)))

    (set! (-> angles x) camera-angle)
    (set! (-> angles y) playfield-angle)
    (set! (-> angles z) 0.0)
    (set! (-> angles w) 0.0)

    (vector-copy!
      *fisher-spawn-player-pos*
      player-pos)

    (set!
      *fisher-game*
      (process-spawn
        fisher-game
        location-id
        fishnet-pos
        camera-pos
        water-height
        angles
        :name "fisher-game"
        *active-pool*)))

  (none))

(defun fisher-update-underwater-waves! ((self fisher-game))
  (let ((dt
        (-> *display* seconds-per-frame)))

    (when
      (> (-> self underwater-wave-time) 0.0)

      (-! (-> self underwater-wave-time) dt)

      (when
        (< (-> self underwater-wave-time) 0.0)

        (set!
          (-> self underwater-wave-time)
          0.0))
    )

    (when
      (and
        (-> self camera-underwater?)
        (<= (-> self underwater-wave-time) 0.0)
        (!= (-> self location-id) (the-as int (fisher-zone village3-lava))))

      (play-sound-file "water-waves.mp3" (the int (* (the float (-> *setting-control* current sfx-volume)) 1.0)))

      (set!
        (-> self underwater-wave-time)
        49.0))
  )

  (none)
)

(defun fisher-force-underwater-horizon!
  ((r float) (g float) (b float))

  (set-vector! *fisher-underwater-haze-color* r g b 128.0)

  (set! *fisher-underwater-haze-override?* #t)

  (none)
)

(defun fisher-remove-lure-snake! ((self fisher-game))
  (when
    (-> self lure-snake)

    (deactivate (-> (-> self lure-snake) 0))

    (set! (-> self lure-snake) (the-as (pointer manipy) #f))
  )
  (vector-reset! (-> self lure-snake-angle))

  (vector-reset! (-> self lure-snake-angular-speed))

  (vector-reset! (-> self lure-snake-last-anchor))

  (set! (-> self lure-snake-flow-time) 0.0)

  (none)
)

(defun fisher-draw-hook-point-debug!
  ((self fisher-game))

  (when *fisher-in-debug?*
    (let ((hook-point
          (new 'stack-no-clear 'vector))

        (left (new 'stack-no-clear 'vector))

        (right (new 'stack-no-clear 'vector))

        (top (new 'stack-no-clear 'vector))

        (bottom (new 'stack-no-clear 'vector))

        (front (new 'stack-no-clear 'vector))

        (back (new 'stack-no-clear 'vector))

        (color
          (new 'static 'rgba
            :r #xff
            :g #x30
            :b #xff
            :a #xff)))

      (fisher-hook-target! self hook-point)

      (singlefish-vector-copy-safe! left hook-point)
      (singlefish-vector-copy-safe! right hook-point)
      (singlefish-vector-copy-safe! top hook-point)
      (singlefish-vector-copy-safe! bottom hook-point)
      (singlefish-vector-copy-safe! front hook-point)
      (singlefish-vector-copy-safe! back hook-point)

      (-! (-> left x) (meters 0.35))
      (+! (-> right x) (meters 0.35))
      (+! (-> top y) (meters 0.35))
      (-! (-> bottom y) (meters 0.35))
      (+! (-> front z) (meters 0.35))
      (-! (-> back z) (meters 0.35))

      (fisher-debug-line! left right color)
      (fisher-debug-line! top bottom color)
      (fisher-debug-line! front back color)))

  (none))

(defun fisher-update-lure-snake! ((self fisher-game))
  (when
    (and (-> self casted?) (-> self lure-snake))

    (let* ((snake-proc
          (-> (-> self lure-snake) 0 self))

        (snake (the-as manipy snake-proc))

        (dt (-> *display* seconds-per-frame))

        (anchor (new 'stack-no-clear 'vector))

        (movement (new 'stack-no-clear 'vector))

        (target-angle (new 'stack-no-clear 'vector))

        (pivot-offset (new 'stack-no-clear 'vector))

        (rotated-pivot (new 'stack-no-clear 'vector))

        (root-pos (new 'stack-no-clear 'vector))

        (rot (new 'stack-no-clear 'matrix))

        (forward-speed 0.0)

        (vertical-speed 0.0)

        (spring 0.0)

        (damping
          0.0))

      (vector-copy! anchor (-> self lure-pos))

      (set! (-> anchor w) 1.0)

      (vector-! movement anchor (-> self lure-snake-last-anchor))

      (when (> dt 0.0)
        (set! forward-speed (/ (/ (vector-dot movement (-> self lure-cast-axis)) (meters 1.0)) dt))

        (set! vertical-speed (/ (/ (-> movement y) (meters 1.0)) dt))
      )

      (+! (-> self lure-snake-flow-time) dt)

      (cond
        ((= (-> self cast-state) 'casting)
          (set! spring 4.0)

          (set! damping 1.4)

          (set! (-> target-angle x) (degrees (fmax -75.0 (fmin 75.0 (* vertical-speed 15.0)))))

          (set!
            (-> target-angle y)
            (degrees
              (+
                (* forward-speed 11.0)

                (* 28.0
                  (sin
                    (*
                      (degrees 210.0)
                      (-> self lure-snake-flow-time)))))))

          (set! (-> target-angle z) (degrees (fmax -65.0 (fmin 65.0 (* forward-speed -13.0)))))
        )

        (else
          (set! spring 19.0)

          (set! damping 2.0)

          (set!
            (-> target-angle x)
            (degrees
              (+
                (fmax -24.0 (fmin 24.0 (* vertical-speed 3.0)))

                (* 7.0
                  (sin
                    (*
                      (degrees 38.0)
                      (-> self lure-snake-flow-time)))))))

          (set!
            (-> target-angle y)
            (degrees
              (+
                (* forward-speed 1.8)

                (* 10.0
                  (sin
                    (*
                      (degrees 25.0)
                      (-> self lure-snake-flow-time)))))))

          (set!
            (-> target-angle z)
            (degrees
              (+
                (fmax -28.0 (fmin 28.0 (* forward-speed -3.2)))

                (* 6.0
                  (cos
                    (*
                      (degrees 31.0)
                      (-> self lure-snake-flow-time)))))))
        )
      )

      (set! (-> target-angle w) 0.0)

      (+!
        (-> self lure-snake-angular-speed x)
        (*
          (-
            (* (- (-> target-angle x) (-> self lure-snake-angle x)) spring)

            (*
              (-> self lure-snake-angular-speed x)
              damping))
          dt))

      (+!
        (-> self lure-snake-angular-speed y)
        (*
          (-
            (* (- (-> target-angle y) (-> self lure-snake-angle y)) spring)

            (*
              (-> self lure-snake-angular-speed y)
              damping))
          dt))

      (+!
        (-> self lure-snake-angular-speed z)
        (*
          (-
            (* (- (-> target-angle z) (-> self lure-snake-angle z)) spring)

            (*
              (-> self lure-snake-angular-speed z)
              damping))
          dt))

      (+! (-> self lure-snake-angle x) (* (-> self lure-snake-angular-speed x) dt))

      (+! (-> self lure-snake-angle y) (* (-> self lure-snake-angular-speed y) dt))

      (+! (-> self lure-snake-angle z) (* (-> self lure-snake-angular-speed z) dt))

      (cond
        ((and
            (= (-> self fish-state) 'reeling)
            (>= (-> self hooked-fish-slot) 0))

          (let ((hook-facing
                (new 'stack-no-clear 'vector))

              (hook-down
                (new 'stack-no-clear 'vector)))

            (singlefish-vector-copy-safe! hook-facing (-> self hooked-fish-facing))

            (set! (-> hook-facing w) 0.0)

            (when
              (<= (singlefish-vector-length-safe hook-facing) 0.001)

              (singlefish-vector-scale-safe! hook-facing (-> self playfield-axis) -1.0)

              (set! (-> hook-facing y) 0.72))

            (singlefish-vector-normalize-safe! hook-facing -1.0)

            (set-vector! hook-down 0.0 -1.0 0.0 0.0)

            (forward-down->inv-matrix
              rot
              hook-facing
              hook-down)))

        (else
          (matrix-rotate-xyz!
            rot
            (-> self lure-snake-angle))))

      (matrix->quaternion (-> snake root quat) rot)

      (set-vector! pivot-offset 0.0 (meters 1.0666667) 0.0 0.0)

      (vector-matrix*! rotated-pivot pivot-offset rot)

      (vector-! root-pos anchor rotated-pivot)

      (set! (-> root-pos w) 1.0)

      (set! (-> snake root trans quad) (-> root-pos quad))

      (fisher-draw-hook-point-debug! self)

      (set-vector! (-> snake root scale) 0.0333333 0.0333333 0.0333333 1.0)

      (vector-copy! (-> self lure-snake-last-anchor) anchor)
    )
  )

  (none)
)

(defun fisher-draw-lure-count ()
  (clear matt-str)
  (clear *pc-encoded-matt-str*)
  (format matt-str "LURES ~D/~D" *fisher-lure-count* (fisher-lure-capacity))
  (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)
  (with-dma-buffer-add-bucket
    ((buf (-> (current-frame) global-buf))
      (bucket-id subtitle))
    (draw-string-xy-scaled
      *pc-encoded-matt-str*
      buf
      114
      187
      (if (= *fisher-lure-count* 0)
        (font-color red)
        (font-color white))
      (font-flags large shadow kerning)
      0.50))
  (none))

(defun fisher-reset-line-hp! ()
  (set! *fisher-line-hp* *fisher-line-hp-max*)

  (set! *fisher-line-broken?* #f)

  (none)
)

(defun fisher-damage-line! ((damage float))
  (-! *fisher-line-hp* damage)

  (when
    (<= *fisher-line-hp* 0.0)

    (set! *fisher-line-hp* 0.0)

    (set!
      *fisher-line-broken?*
      #t))

  (none)
)

(defun fisher-draw-line-hp-number ()
  (let ((display-hp
        (the int
          (fmax
            0.0
            (fmin
              *fisher-line-hp-max*
              *fisher-line-hp*)))))

    (clear matt-str)
    (clear *pc-encoded-matt-str*)

    (format matt-str "~D" display-hp)

    (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)

    (with-dma-buffer-add-bucket
      ((buf (-> (current-frame) global-buf)) (bucket-id subtitle))

      (let ((font-ctx
            (new 'stack
              'font-context
              *font-default-matrix*
              472
              39
              0.0
              (font-color white)
              (font-flags large middle shadow kerning))))

        (draw-string *pc-encoded-matt-str* buf font-ctx)
      )
    )
  )

  (none)
)

(defun fisher-draw-line-hp-bar ()
  (let* ((health-ratio
        (fmax
          0.0
          (fmin
            1.0
            (/ *fisher-line-hp*
              *fisher-line-hp-max*))))

      (fill-height (the int (* 120.0 health-ratio)))

      (fill-y (the int (- 188.0 fill-height)))

      (hp-color
        (new 'static 'rgba
          :r #x20
          :g #xe0
          :b #x40
          :a #xc0)))

    (let ((line-health-ratio
          (fmax
            0.0
            (fmin
              1.0
              (/ *fisher-line-hp* *fisher-line-hp-max*))))

        (line-color-blend
          0.0))

      (cond
        ((>= line-health-ratio 0.5)
          (set!
            line-color-blend
            (* (- 1.0 line-health-ratio) 2.0))

          (set!
            (-> hp-color r)
            (the uint8
              (* 255.0 line-color-blend)))

          (set! (-> hp-color g) #xff)
          (set! (-> hp-color b) #x00))

        (else
          (set!
            line-color-blend
            (* line-health-ratio 2.0))

          (set! (-> hp-color r) #xff)

          (set!
            (-> hp-color g)
            (the uint8
              (* 255.0 line-color-blend)))

          (set! (-> hp-color b) #x00)))

      (set! (-> hp-color a) #xc0))

    (fisher-draw-line-hp-number)

    (with-dma-buffer-add-bucket
      ((buf (-> (current-frame) global-buf)) (bucket-id subtitle))

      (draw-sprite2d-xy buf 455 61 34 134 (new 'static 'rgba :r #x08 :g #x0c :b #x10 :a #xb0))

      (draw-sprite2d-xy buf 458 64 28 128 (new 'static 'rgba :r #x58 :g #x60 :b #x68 :a #xd0))

      (draw-sprite2d-xy buf 462 68 20 120 (new 'static 'rgba :r #x08 :g #x0a :b #x0c :a #xd0))

      (when (> fill-height 0)
        (draw-sprite2d-xy buf 464 fill-y 16 fill-height hp-color)

        (draw-sprite2d-xy buf 462 (- fill-y 2) 20 4 hp-color)
      )

      (draw-sprite2d-xy buf 458 58 28 6 (new 'static 'rgba :r #x78 :g #x80 :b #x88 :a #xd0))

      (draw-sprite2d-xy buf 458 192 28 6 (new 'static 'rgba :r #x78 :g #x80 :b #x88 :a #xd0))

      (dotimes (i 11)
        (let ((stud-y
              (+ 67
                (* i 12))))

          (draw-sprite2d-xy buf 452 stud-y 6 3 (new 'static 'rgba :r #x98 :g #xa0 :b #xa8 :a #xe0))

          (draw-sprite2d-xy buf 486 stud-y 6 3 (new 'static 'rgba :r #x98 :g #xa0 :b #xa8 :a #xe0))
        )
      )
    )
  )

  (none)
)

(defun fisher-draw-reel-hint-text
  ((text string)
    (text-x-pos int)
    (text-y-pos int)
    (text-scale float))

  (clear matt-str)
  (clear *pc-encoded-matt-str*)

  (format matt-str text)

  (pc-encode-utf8-string
    matt-str
    *pc-encoded-matt-str*)

  (with-dma-buffer-add-bucket
    ((buf (-> (current-frame) global-buf))
      (bucket-id subtitle))

