(defun fisher-update-reel-hint! ((self fisher-game))
  (cond
    ((fisher-finalboss-zone? self)
      (set! (-> self reel-hint-time) 0.0))
    (else

  (when
    (> (-> self reel-hint-time) 0.0)

    (when
      (or *fisher-in-debug?* (>= (fisher-current-level) *fisher-tug-line-unlock-level*))

      (fisher-draw-reel-hint-text-red
        "L1"
        10
        150
        0.55)

      (fisher-draw-reel-hint-text
        " FAST REEL"
        25
        150
        0.55))

    (when
      (or *fisher-in-debug?* (>= (fisher-current-level) *fisher-sink-lure-unlock-level*))

      (fisher-draw-reel-hint-text-red
        "R1"
        10
        162
        0.55)

      (fisher-draw-reel-hint-text
        " SINK LURE"
        25
        162
        0.55))

    (when
      (or *fisher-in-debug?* (>= (fisher-current-level) *fisher-stop-lure-unlock-level*))

      (fisher-draw-reel-hint-text
        "<PAD_SQUARE> STOP LURE"
        10
        174
        0.55))

    (fisher-draw-reel-hint-text
      "<PAD_X> REEL"
      10
      186
      0.55)

    (-! (-> self reel-hint-time) (-> *display* seconds-per-frame))

    (when
      (< (-> self reel-hint-time) 0.0)

      (set!
        (-> self reel-hint-time)
        0.0)))
    ))

  (none))

(defun fisher-launch-water-entry-bubbles! ((self fisher-game))
  (let ((spray-pos (new 'stack-no-clear 'vector)))
    (vector-copy! spray-pos (-> self lure-pos))
    (set! (-> spray-pos y) (- (-> self water-level) (meters 0.05)))
    (set! (-> spray-pos w) 1.0)
    (fisher-set-particle-fishbox-rotation! self)

    (cond
      ((= (-> self location-id) (the-as int (fisher-zone village3-lava)))
        (fisher-submit-lava-yellow-trail! self spray-pos))
      (else
        (launch-particles
          :system *sp-particle-system-3d*
          (-> *part-id-table* 3571)
          spray-pos))))
  (none))

(defun fisher-misty-curtain-color!
  ((dst vector))

  (let ((hour
          (if
            *time-of-day-context*
            (-> *time-of-day-context* time)
            12.0))

        (blend 0.0))

    (cond
      ((and (>= hour 4.0) (< hour 7.0))
        (set! blend (/ (- hour 4.0) 3.0))
        (set! (-> dst x) (+ 16.0 (* (- 43.0 16.0) blend)))
        (set! (-> dst y) (+ 78.0 (* (- 88.0 78.0) blend)))
        (set! (-> dst z) (+ 91.0 (* (- 76.0 91.0) blend))))

      ((and (>= hour 7.0) (< hour 9.0))
        (set! blend (/ (- hour 7.0) 2.0))
        (set! (-> dst x) 43.0)
        (set! (-> dst y) (+ 88.0 (* (- 100.0 88.0) blend)))
        (set! (-> dst z) (+ 76.0 (* (- 112.0 76.0) blend))))

      ((and (>= hour 9.0) (< hour 12.0))
        (set! blend (/ (- hour 9.0) 3.0))
        (set! (-> dst x) (+ 43.0 (* (- 65.0 43.0) blend)))
        (set! (-> dst y) (+ 100.0 (* (- 117.0 100.0) blend)))
        (set! (-> dst z) (+ 112.0 (* (- 146.0 112.0) blend))))

      ((and (>= hour 12.0) (< hour 15.0))
        (set! (-> dst x) 65.0)
        (set! (-> dst y) 117.0)
        (set! (-> dst z) 146.0))

      ((and (>= hour 15.0) (< hour 18.0))
        (set! blend (/ (- hour 15.0) 3.0))
        (set! (-> dst x) (+ 65.0 (* (- 54.0 65.0) blend)))
        (set! (-> dst y) (+ 117.0 (* (- 95.0 117.0) blend)))
        (set! (-> dst z) (+ 146.0 (* (- 86.0 146.0) blend))))

      ((and (>= hour 18.0) (< hour 19.0))
        (set! blend (- hour 18.0))
        (set! (-> dst x) (+ 54.0 (* (- 9.0 54.0) blend)))
        (set! (-> dst y) (+ 95.0 (* (- 58.0 95.0) blend)))
        (set! (-> dst z) (+ 86.0 (* (- 94.0 86.0) blend))))

      ((and (>= hour 19.0) (< hour 23.0))
        (set! blend (/ (- hour 19.0) 4.0))
        (set! (-> dst x) (+ 9.0 (* (- 11.0 9.0) blend)))
        (set! (-> dst y) (+ 58.0 (* (- 46.0 58.0) blend)))
        (set! (-> dst z) (+ 94.0 (* (- 78.0 94.0) blend))))

      ((>= hour 23.0)
        (set! blend (/ (- hour 23.0) 5.0))
        (set! (-> dst x) (+ 11.0 (* (- 16.0 11.0) blend)))
        (set! (-> dst y) (+ 46.0 (* (- 78.0 46.0) blend)))
        (set! (-> dst z) (+ 78.0 (* (- 91.0 78.0) blend))))

      (else
        (set! blend (/ (+ hour 1.0) 5.0))
        (set! (-> dst x) (+ 11.0 (* (- 16.0 11.0) blend)))
        (set! (-> dst y) (+ 46.0 (* (- 78.0 46.0) blend)))
        (set! (-> dst z) (+ 78.0 (* (- 91.0 78.0) blend)))))

    (set! (-> dst w) 1.0))

  dst)

