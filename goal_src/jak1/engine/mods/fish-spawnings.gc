(defbehavior swimmer-pontoonfive-init-by-other
  swimmer-pontoonfive
  ((spawn-pos vector)
   (rotation-degrees float))

  (set!
    (-> self visual)
    (the-as (pointer manipy) #f))


  (logior!
    (-> self mask)
    (process-mask platform))

  (rigid-body-platform-method-30 self)
  (rigid-body-platform-method-31 self)

  (set!
    (-> self root-overlay trans quad)
    (-> spawn-pos quad))

  (quaternion-axis-angle!
    (-> self root-overlay quat)
    0.0
    1.0
    0.0
    (degrees rotation-degrees))

  (set!
    (-> self anchor-point quad)
    (-> self root-overlay trans quad))

  (set! (-> self water-anim) #f)

  (set!
    (-> self root-overlay pause-adjust-distance)
    -122880.0)

  ;; Use a separate local manipy for guaranteed visual submission.
  (set!
    (-> self visual)
    (manipy-spawn
      spawn-pos
      #f
      *swimmer-pontoonfive-sg*
      #f
      :from *default-dead-pool*
      :to *default-pool*
      :name "swimmer-pontoonfive-visual"))

  (when (-> self visual)
    (let ((visual-proc
          (the-as manipy
            (-> (-> self visual) 0 self))))

      (send-event visual-proc 'anim-mode 'loop)

      (send-event
        visual-proc
        'max-vis-dist
        (meters 999999.0))

      (set!
        (-> visual-proc root trans quad)
        (-> self root-overlay trans quad))

      (set!
        (-> visual-proc root quat quad)
        (-> self root-overlay quat quad))))

  ;; Finalize the rigid body after assigning the runtime transform.
  (logclear!
    (-> self draw status)
    (draw-status hidden))

  (logior!
    (-> self skel status)
    (janim-status inited))

  (transform-post)
  (ja-post)

  (go-virtual swimmer-pontoon-float))

