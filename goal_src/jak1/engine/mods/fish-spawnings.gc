  (none))

(defun fisher-roll-standard-fish-suffix ()
  (let ((roll
        (rand-vu-int-range 0 99999)))

    (cond
      ((fisher-green-sun-hour?)
        (cond
          ((< roll 26000) 0)
          ((< roll 47000) 1)
          ((< roll 76000) 2)
          ((< roll 87000) 3)
          ((< roll 96750) 4)
          ((< roll 99750) 5)
          (else 6)))

      ((fisher-golden-hour?)
        (cond
          ((< roll 31000) 0)
          ((< roll 55500) 1)
          ((< roll 85000) 2)
          ((< roll 92500) 3)
          ((< roll 97900) 4)
          ((< roll 99900) 5)
          (else 6)))

      (else
        (cond
          ((< roll 35000) 0)
          ((< roll 62000) 1)
          ((< roll 93000) 2)
          ((< roll 97000) 3)
          ((< roll 99490) 4)
          ((< roll 99990) 5)
          (else 6))))))

(defun fisher-rare-suffix-for-location ((self fisher-game))
  (cond
    ((= (-> self location-id) (the-as int (fisher-zone sandover-dock))) 7)
    ((= (-> self location-id) (the-as int (fisher-zone jungle-pillar))) 8)
    ((= (-> self location-id) (the-as int (fisher-zone sentinel-pontoon))) 9)
    ((= (-> self location-id) (the-as int (fisher-zone misty-island))) 10)
    ((= (-> self location-id) (the-as int (fisher-zone village2-electric))) 11)
    ((= (-> self location-id) (the-as int (fisher-zone sunken-voltage))) 12)
    ((= (-> self location-id) (the-as int (fisher-zone swamp-sludge))) 13)
    ((= (-> self location-id) (the-as int (fisher-zone village3-lava))) 14)
    ((= (-> self location-id) (the-as int (fisher-zone snow-ice))) 15)
    ((= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco))) 16)
    (else -1)))

(defun fisher-roll-fish-suffix ((self fisher-game))
  (let ((rare-suffix (fisher-rare-suffix-for-location self)))
    (cond
      ((< rare-suffix 0)
        (fisher-roll-standard-fish-suffix))

      (*fisher-in-debug?*
        rare-suffix)

      (else
        (let ((rare-roll (rand-vu-int-range 0 99999))
            (rare-threshold
              (cond
                ((>= (fisher-current-level) *fisher-level-cap*)
                  (if (fisher-golden-hour?) 900 375))
                (else
                  (if (fisher-golden-hour?) 667 250)))))
          (if (< rare-roll rare-threshold)
            rare-suffix
            (fisher-roll-standard-fish-suffix)))))))

(defun fisher-rare-fish? ((suffix int))
  (and (>= suffix 7) (<= suffix 16)))

(defun fisher-apply-rare-slot-type! ((self fisher-game) (slot int))
  (let ((suffix (fisher-fish-suffix self slot)))
    (cond
      ((or (= suffix 7) (= suffix 11) (= suffix 14) (= suffix 15) (= suffix 16))
        (fisher-set-fish-species! self slot 1))
      ((or (= suffix 8) (= suffix 9) (= suffix 10) (= suffix 12) (= suffix 13))
        (fisher-set-fish-species! self slot 0))))
  (none))

(defun fisher-suffix-name ((suffix int))
  (cond
    ((= suffix 0) "MALNUTRITIONED")
    ((= suffix 1) "STRESSED")
    ((= suffix 2) "HEALTHY")
    ((= suffix 3) "MUTANT")
    ((= suffix 4) "RARE")
    ((= suffix 5) "MEGA")
    ((= suffix 6) "GOLDEN")
    ((= suffix 7) "PRECURSOR")
    ((= suffix 8) "FORGOTTEN")
    ((= suffix 9) "FRICKED UP")
    ((= suffix 10) "ORB-HUNTER")
    ((= suffix 11) "ARCHIPELAGOLD")
    ((= suffix 12) "SPEC OPS")
    ((= suffix 13) "COMPLICATED")
    ((= suffix 14) "L TETROMINO")
    ((= suffix 15) "PLATFORMIUS")
    (else "SCREAMING")))

(defun fisher-species-name
  ((self fisher-game) (species int))

  (cond
    ((and
        (= species (the-as int (fisher-species fire-canyon-cellfish)))
        (= (-> self caught-power-cell-task)
          (the-as int (game-task citadel-buzzer))))
      "CITADEL SCOUT FLY FISH")

    ((and
        (= species (the-as int (fisher-species fire-canyon-cellfish)))
        (or
          (= (-> self caught-power-cell-task) (the-as int (game-task lavatube-end)))
          (= (-> self caught-power-cell-task) (the-as int (game-task lavatube-buzzer)))))
      "LAVA TUBE CELL FISH")

    ((and
        (= species (the-as int (fisher-species fire-canyon-cellfish)))
        (or
          (= (-> self caught-power-cell-task) (the-as int (game-task ogre-end)))
          (= (-> self caught-power-cell-task) (the-as int (game-task ogre-buzzer)))))
      "MOUNTAIN PASS CELL FISH")

    (else
      (-> (fisher-species-info-for species) name))))

(defun fisher-suffix-value-multiplier ((suffix int))
  (cond
    ((= suffix 0) 0.50)
    ((= suffix 1) 0.75)
    ((= suffix 2) 1.00)
    ((= suffix 3) 1.50)
    ((= suffix 4) 2.00)
    ((= suffix 5) 3.00)
    ((= suffix 6) 5.00)
    (else 1.00)))

(defun fisher-roll-fish-weight-tenths
  ((self fisher-game) (slot int))

  (let* ((species
        (fisher-fish-species self slot))

      (suffix
        (fisher-fish-suffix self slot))

      (info
        (fisher-species-info-for species))

      (base-weight
        (rand-vu-int-range
          (-> info min-weight-tenths)
          (-> info max-weight-tenths))))

    (when (= species (the-as int (fisher-species nuclear-bombfish)))
      (return 90000))

    (when
      (and
        (= (-> self location-id) (the-as int (fisher-zone village3-lava)))
        (not (fisher-rare-fish? suffix))
        (or
          (= species (the-as int (fisher-species lava-drum)))
          (= species (the-as int (fisher-species magma-serpent)))
          (= species (the-as int (fisher-species inferno-shark)))))
      (return base-weight))

    (when
      (and
        (= (-> self location-id) (the-as int (fisher-zone snow-ice)))
        (not (fisher-rare-fish? suffix))
        (or
          (= species (the-as int (fisher-species frost-biter)))
          (= species (the-as int (fisher-species crystal-fish)))
          (= species (the-as int (fisher-species ice-shark)))))
      (return base-weight))

    (when
      (and
        (= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
        (or
          (= species (the-as int (fisher-species helix-voidfish)))
          (= species (the-as int (fisher-species dark-precursor-fangfish)))
          (= species (the-as int (fisher-species phantasm-shark)))
          (= species (the-as int (fisher-species megaloviathan)))))
      (return base-weight))

    (cond
      ((= suffix 7) (rand-vu-int-range 100 151))
      ((= suffix 8) (rand-vu-int-range 70 121))
      ((= suffix 9) (rand-vu-int-range 1 7))
      ((= suffix 10) (rand-vu-int-range 140 241))
      ((= suffix 11) (rand-vu-int-range 100 201))
      ((= suffix 12) (rand-vu-int-range 120 161))
      ((= suffix 13) (rand-vu-int-range 200 301))
      ((= suffix 14) 250)
      ((= suffix 15) 1000)
      ((= suffix 16) (rand-vu-int-range 30 51))

      ((= species 3) 260)
      ((= species 5) base-weight)

      ((= suffix 0)
        (max
          1
          (the int
            (*
              (the float base-weight)
              (rand-vu-float-range 0.45 0.65)))))

      ((= suffix 1)
        (max
          1
          (the int
            (*
              (the float base-weight)
              (rand-vu-float-range 0.72 0.88)))))

      ((= suffix 5) (* base-weight 2))
      ((= suffix 6) (* base-weight 18))
      (else base-weight))))


(defun fisher-roll-level-for-current-zone ((self fisher-game))
  (let ((zone
          (fisher-zone-info-for
            (the-as fisher-zone (-> self location-id)))))
    (fisher-roll-level-in-range
      (-> zone level-min)
      (-> zone level-max))))

(defun fisher-roll-level-for-slot ((self fisher-game) (slot int))
  (if
    (= (-> self location-id) (the-as int (fisher-zone village3-lava)))
    (cond
      ((= (fisher-fish-species self slot)
          (the-as int (fisher-species inferno-shark)))
        (fisher-roll-level-in-range 15 17))
      ((= (fisher-fish-species self slot)
          (the-as int (fisher-species magma-serpent)))
        (fisher-roll-level-in-range 17 20))
      (else
        (fisher-roll-level-in-range 18 20)))
    (fisher-roll-level-for-current-zone self)))

(defun fisher-refresh-active-slot-levels! ((self fisher-game))
  (dotimes (slot (-> self fish-count))
    (fisher-set-fish-level!
      self
      slot
      (fisher-roll-level-for-slot self slot)))
  (none))

(defun fisher-randomize-fish-level-and-weight!
  ((self fisher-game) (slot int))

  (fisher-apply-rare-slot-type! self slot)

  (fisher-set-fish-level!
    self
    slot
    (fisher-roll-level-for-slot self slot))

  (fisher-set-fish-weight-tenths!
    self
    slot
    (fisher-roll-fish-weight-tenths self slot))

  (none))

(defun fisher-clear-power-cell-tasks! ((self fisher-game))
  (dotimes (slot *fisher-max-fish-slots*)
    (fisher-set-fish-power-cell-task! self slot 0))
  (none))

(defun fisher-configure-random-fish-slot!
  ((self fisher-game) (slot int) (species int))
  (fisher-set-fish-species! self slot species)
  (fisher-set-fish-suffix!
    self
    slot
    (if
      (or
        (= species (the-as int (fisher-species magma-serpent)))
        (= species (the-as int (fisher-species megaloviathan))))
      2
      (fisher-roll-fish-suffix self)))
  (fisher-randomize-fish-level-and-weight! self slot)
  (none))

(defun fisher-assign-table-slots!
  ((self fisher-game) (eco-count int) (largemouth-count int) (babak-count int))

  (let* ((requested-count
        (+ eco-count largemouth-count babak-count))

      (new-count (min *fisher-max-fish-slots* requested-count))

      (babak-slots (min babak-count new-count))

      (largemouth-slots (min largemouth-count (- new-count babak-slots)))

      (i
        0))

    (set! (-> self fish-count) new-count)

    (fisher-clear-power-cell-tasks! self)

    (while (< i new-count)
      (cond
        ((< i babak-slots) (fisher-set-fish-species! self i 2))

        ((< i (+ babak-slots largemouth-slots)) (fisher-set-fish-species! self i 1))

        (else
          (fisher-set-fish-species!
            self
            i
            0)))

      (fisher-set-fish-suffix! self i (fisher-roll-fish-suffix self))
      (fisher-randomize-fish-level-and-weight! self i)

      (+! i 1)))

  (none))

(defun fisher-add-lurker-shark-slot!
  ((self fisher-game))

  (when
    (and
      (> (-> self fish-count) 0)
      (rand-vu-percent? 0.50))

    (let ((slot
          (- (-> self fish-count) 1)))

      (fisher-set-fish-species! self slot 3)
      (fisher-set-fish-suffix! self slot (fisher-roll-standard-fish-suffix))
      (fisher-set-fish-level!
        self
        slot
        (fisher-roll-level-for-current-zone self))
      (fisher-set-fish-weight-tenths! self slot 260)))

  (none))

(defun fisher-power-cell-task-count-for-location ((self fisher-game))
  (cond
    ((= (-> self location-id) 4) 5)
    ((= (-> self location-id) 5) 3)
    ((= (-> self location-id) 6) 9)
    ((= (-> self location-id) 7) 9)
    ((= (-> self location-id) (the-as int (fisher-zone village3-lava))) 1)
    ((= (-> self location-id) (the-as int (fisher-zone snow-ice))) 6)
    ((= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco))) 5)
    ((or (= (-> self location-id) 1) (= (-> self location-id) 3)) 4)
    (else 0)))

(defun fisher-power-cell-task-for-location-index
  ((self fisher-game) (index int))
  (cond
    ((= (-> self location-id) 3)
      (cond
        ((= index 0) (game-task beach-ecorocks))
        ((= index 1) (game-task beach-pelican))
        ((= index 2) (game-task beach-gimmie))
        (else (game-task beach-sentinel))))

    ((= (-> self location-id) 1)
      (cond
        ((= index 0) (game-task jungle-tower))
        ((= index 1) (game-task jungle-plant))
        ((= index 2) (game-task jungle-canyon-end))
        (else (game-task jungle-temple-door))))

    ((= (-> self location-id) 4)
      (cond
        ((= index 0) (game-task misty-boat))
        ((= index 1) (game-task misty-warehouse))
        ((= index 2) (game-task misty-bike))
        ((= index 3) (game-task misty-bike-jump))
        (else (game-task misty-eco-challenge))))

    ((= (-> self location-id) 5)
      (cond
        ((= index 0) (game-task firecanyon-buzzer))
        ((= index 1) (game-task rolling-lake))
        (else (game-task rolling-buzzer))))

    ((= (-> self location-id) 6)
      (cond
        ((= index 0) (game-task sunken-platforms))
        ((= index 1) (game-task sunken-pipe))
        ((= index 2) (game-task sunken-slide))
        ((= index 3) (game-task sunken-sharks))
        ((= index 4) (game-task sunken-top-of-helix))
        ((= index 5) (game-task sunken-spinning-room))
        ((= index 6) (game-task sunken-room))
        ((= index 7) (game-task rolling-lake))
        (else (game-task rolling-buzzer))))

    ((= (-> self location-id) 7)
      (cond
        ((= index 0) (game-task swamp-arm))
        ((= index 1) (game-task swamp-battle))
        ((= index 2) (game-task swamp-flutflut))
        ((= index 3) (game-task swamp-tether-1))
        ((= index 4) (game-task swamp-tether-2))
        ((= index 5) (game-task swamp-tether-3))
        ((= index 6) (game-task swamp-tether-4))
        ((= index 7) (game-task rolling-lake))
        (else (game-task rolling-buzzer))))

    ((= (-> self location-id) (the-as int (fisher-zone village3-lava)))
      (game-task village3-extra1))

    ((= (-> self location-id) (the-as int (fisher-zone snow-ice)))
      (cond
        ((= index 0) (game-task snow-eggtop))
        ((= index 1) (game-task snow-fort))
        ((= index 2) (game-task snow-ball))
        ((= index 3) (game-task snow-bunnies))
        ((= index 4) (game-task snow-bumpers))
        (else (game-task snow-cage))))

    ((= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
      (cond
        ((= index 0) (game-task cave-dark-climb))
        ((= index 1) (game-task cave-robot-climb))
        ((= index 2) (game-task cave-swing-poles))
        ((= index 3) (game-task cave-spider-tunnel))
        (else (game-task cave-platforms))))

    (else (game-task none))))

(defun fisher-find-missing-power-cell-task ((self fisher-game))
  (let* ((task-count (fisher-power-cell-task-count-for-location self))
      (start
        (if
          (> task-count 0)
          (rand-vu-int-range 0 (- task-count 1))
          0))
      (step 0)
      (task (game-task none)))

    (while (< step task-count)
      (set! task
        (fisher-power-cell-task-for-location-index
          self
          (mod (+ start step) task-count)))

      (when
        (and
          (> (the int task) 1)
          (not (task-complete? *game-info* task)))
        (return task))

      (+! step 1))

    (game-task none)))

(defun fisher-has-power-cell-fish? ((self fisher-game))
  (dotimes (slot (-> self fish-count))
    (let ((task (fisher-fish-power-cell-task self slot)))
      (when
        (and
          (> task 1)
          (!= task (the-as int (game-task ogre-end))))
        (return #t))))
  #f)

(defun fisher-add-power-cell-fish-slot! ((self fisher-game))
  (when
    (and
      (or
        (= (-> self location-id) 1)
        (= (-> self location-id) 3)
        (= (-> self location-id) 4)
        (= (-> self location-id) 5)
        (= (-> self location-id) 6)
        (= (-> self location-id) 7)
        (= (-> self location-id) (the-as int (fisher-zone village3-lava)))
        (= (-> self location-id) (the-as int (fisher-zone snow-ice)))
        (= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco))))
      (> (-> self fish-count) 0)
      (not (fisher-has-power-cell-fish? self))
      (rand-vu-percent?
        (if *fisher-in-debug?* 0.90 *fisher-power-cell-fish-chance*)))

    (let ((task (fisher-find-missing-power-cell-task self)))
      (when (> (the int task) 1)
        (let ((start-slot (rand-vu-int-range 0 (- (-> self fish-count) 1)))
            (step 0)
            (slot -1)
            (candidate 0))

          (while (and (< step (-> self fish-count)) (< slot 0))
            (set! candidate (mod (+ start-slot step) (-> self fish-count)))
            (when
              (and
                (!= (fisher-fish-species self candidate) 4)
                (!=
                  (fisher-fish-species self candidate)
                  (the-as int (fisher-species megaloviathan)))
                (<= (fisher-fish-power-cell-task self candidate) 1)
                (not
                  (or
                    (and
                      (or
                        (= (-> self location-id)
                          (the-as int (fisher-zone village2-electric)))
                        (= (-> self location-id)
                          (the-as int (fisher-zone sunken-voltage))))
                      (= (fisher-fish-species self candidate)
                        (the-as int (fisher-species electric-lurker-shark))))
                    (and
                      (= (-> self location-id)
                        (the-as int (fisher-zone swamp-sludge)))
                      (= (fisher-fish-species self candidate)
                        (the-as int (fisher-species black-lurker-shark)))))))
              (set! slot candidate))
            (+! step 1))

          (when (>= slot 0)
            (fisher-set-fish-power-cell-task! self slot (the int task))

            (fisher-set-fish-weight-tenths!
              self
              slot
              (max
                1
                (the int
                  (+
                    (*
                      (the float (fisher-fish-weight-tenths self slot))
                      1.70)
                    0.5)))))))))

  (none))

(defun fisher-mountain-pass-cellfish-location? ((self fisher-game))
  (or
    (= (-> self location-id) (the-as int (fisher-zone village2-electric)))
    (= (-> self location-id) (the-as int (fisher-zone sunken-voltage)))
    (= (-> self location-id) (the-as int (fisher-zone swamp-sludge)))))

(defun fisher-has-power-cell-task? ((self fisher-game) (task game-task))
  (dotimes (slot (-> self fish-count))
    (when
      (= (fisher-fish-power-cell-task self slot) (the int task))
      (return #t)))
  #f)

(defun fisher-mountain-pass-cellfish-eligible? ((self fisher-game))
  (and
    (fisher-mountain-pass-cellfish-location? self)
    *target*
    (>=
      (the int
        (the float
          (send-event
            *target*
            'query
            'pickup
            (pickup-type fuel-cell))))
      45)))

(defun fisher-add-one-mountain-pass-cellfish!
  ((self fisher-game) (task game-task))

  (when
    (and
      (> (-> self fish-count) 0)
      (not (task-complete? *game-info* task))
      (not (fisher-has-power-cell-task? self task)))

    (let ((step 0)
        (slot -1)
        (candidate 0))

      (while (and (< step (-> self fish-count)) (< slot 0))
        (set! candidate step)
        (when
          (and
            (!= (fisher-fish-species self candidate)
              (the-as int (fisher-species scout-fly)))
            (<= (fisher-fish-power-cell-task self candidate) 1)
            (not
              (or
                (= (fisher-fish-species self candidate)
                  (the-as int (fisher-species electric-lurker-shark)))
                (= (fisher-fish-species self candidate)
                  (the-as int (fisher-species black-lurker-shark))))))
          (set! slot candidate))
        (+! step 1))

      (when (>= slot 0)
        (fisher-set-fish-species!
          self
          slot
          (the-as int (fisher-species fire-canyon-cellfish)))
        (fisher-set-fish-suffix! self slot 2)
        (fisher-set-fish-level!
          self
          slot
          (fisher-roll-level-for-current-zone self))
        (fisher-set-fish-weight-tenths!
          self
          slot
          (rand-vu-int-range 100 140))
        (fisher-set-fish-power-cell-task! self slot (the int task))

        (let ((old-fish (fisher-fish-pointer self slot)))
          (when old-fish
            (fisher-destroy-manipy! old-fish)
            (fisher-set-fish-pointer!
              self
              slot
              (the-as (pointer manipy) #f)))

          (when (-> self pool-rendered?)
            (fisher-set-fish-pointer!
              self
              slot
              (fisher-spawn-gameplay-fish self slot)))))))

  (none))

(defun fisher-add-mountain-pass-cellfish-slots! ((self fisher-game))
  (when (fisher-mountain-pass-cellfish-eligible? self)
    (fisher-add-one-mountain-pass-cellfish! self (game-task ogre-end)))
  (none))

(defun fisher-add-village3-mountain-pass-cellfish-slots! ((self fisher-game))
  (when
    (and
      (= (-> self location-id) (the-as int (fisher-zone village3-lava)))
      *target*
      (>=
        (the int
          (the float
            (send-event
              *target*
              'query
              'pickup
              (pickup-type fuel-cell))))
        45))
    (fisher-add-one-mountain-pass-cellfish! self (game-task ogre-end))
    (fisher-add-one-mountain-pass-cellfish! self (game-task ogre-buzzer)))
  (none))

(defun fisher-lava-tube-cellfish-eligible? ((self fisher-game))
  (and
    (= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
    *target*
    (>=
      (the int
        (the float
          (send-event
            *target*
            'query
            'pickup
            (pickup-type fuel-cell))))
      72)
    (or
      (not (task-complete? *game-info* (game-task lavatube-end)))
      (not (task-complete? *game-info* (game-task lavatube-buzzer))))))

(defun fisher-add-one-lava-tube-cellfish!
  ((self fisher-game) (task game-task))

  (when
    (and
      (> (-> self fish-count) 0)
      (not (task-complete? *game-info* task))
      (not (fisher-has-power-cell-task? self task))
      (!= (-> self caught-power-cell-task) (the int task)))

    (let ((step 0)
        (slot -1)
        (candidate 0))

      (while (and (< step (-> self fish-count)) (< slot 0))
        (set! candidate step)
        (when
          (and
            (!= (fisher-fish-species self candidate)
              (the-as int (fisher-species scout-fly)))
            (!= (fisher-fish-species self candidate)
              (the-as int (fisher-species megaloviathan)))
            (!= (fisher-fish-species self candidate)
              (the-as int (fisher-species phantasm-shark)))
            (<= (fisher-fish-power-cell-task self candidate) 1))
          (set! slot candidate))
        (+! step 1))

      (when (>= slot 0)
        (fisher-set-fish-species!
          self
          slot
          (the-as int (fisher-species fire-canyon-cellfish)))
        (fisher-set-fish-suffix! self slot 2)
        (fisher-set-fish-level!
          self
          slot
          (fisher-roll-level-for-current-zone self))
        (fisher-set-fish-weight-tenths!
          self
          slot
          (rand-vu-int-range 100 140))
        (fisher-set-fish-power-cell-task! self slot (the int task))

        (fisher-set-fish-depth!
          self
          slot
          (rand-vu-float-range (meters 30.0) (meters 33.0)))

        (let ((old-fish (fisher-fish-pointer self slot)))
          (when old-fish
            (fisher-destroy-manipy! old-fish)
            (fisher-set-fish-pointer!
              self
              slot
              (the-as (pointer manipy) #f)))

          (when (-> self pool-rendered?)
            (fisher-set-fish-pointer!
              self
              slot
              (fisher-spawn-gameplay-fish self slot)))))))

  (none))

(defun fisher-add-lava-tube-cellfish-slots! ((self fisher-game))
  (when (fisher-lava-tube-cellfish-eligible? self)
    (fisher-add-one-lava-tube-cellfish! self (game-task lavatube-end))
    (fisher-add-one-lava-tube-cellfish! self (game-task lavatube-buzzer)))
  (none))

(defun fisher-citadel-buzzer-cellfish-eligible? ((self fisher-game))
  (and
    (= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
    (not (task-complete? *game-info* (game-task citadel-buzzer)))))

(defun fisher-add-citadel-buzzer-cellfish-slot! ((self fisher-game))
  (when
    (and
      (fisher-citadel-buzzer-cellfish-eligible? self)
      (> (-> self fish-count) 0)
      (not
        (fisher-has-power-cell-task?
          self
          (game-task citadel-buzzer)))
      (!=
        (-> self caught-power-cell-task)
        (the-as int (game-task citadel-buzzer))))

    (let ((step 0)
        (slot -1)
        (candidate 0))

      (while (and (< step (-> self fish-count)) (< slot 0))
        (set! candidate step)
        (when
          (and
            (!= (fisher-fish-species self candidate)
              (the-as int (fisher-species scout-fly)))
            (!= (fisher-fish-species self candidate)
              (the-as int (fisher-species megaloviathan)))
            (!= (fisher-fish-species self candidate)
              (the-as int (fisher-species phantasm-shark)))
            (<= (fisher-fish-power-cell-task self candidate) 1))
          (set! slot candidate))
        (+! step 1))

      (when (>= slot 0)
        (fisher-set-fish-species!
          self
          slot
          (the-as int (fisher-species fire-canyon-cellfish)))
        (fisher-set-fish-suffix! self slot 2)
        (fisher-set-fish-level!
          self
          slot
          (fisher-roll-level-for-current-zone self))
        (fisher-set-fish-weight-tenths!
          self
          slot
          (rand-vu-int-range 100 140))
        (fisher-set-fish-power-cell-task!
          self
          slot
          (the-as int (game-task citadel-buzzer)))
        (fisher-set-fish-depth!
          self
          slot
          (rand-vu-float-range (meters 30.0) (meters 33.0)))

        (let ((old-fish (fisher-fish-pointer self slot)))
          (when old-fish
            (fisher-destroy-manipy! old-fish)
            (fisher-set-fish-pointer!
              self
              slot
              (the-as (pointer manipy) #f)))
          (when (-> self pool-rendered?)
            (fisher-set-fish-pointer!
              self
              slot
              (fisher-spawn-gameplay-fish self slot)))))))

  (none))

(defun fisher-existing-zone? ((self fisher-game))
  (and
    (>= (-> self location-id) 0)
    (< (-> self location-id) *fisher-zone-count*)
    (->
      (fisher-zone-info-for (-> self location-id))
      fire-canyon-cellfish?)))

(defun fisher-default-species-for-location ((self fisher-game))
  (cond
    ((= (-> self location-id) (the-as int (fisher-zone jungle-pillar)))
      (the-as int (fisher-species babak-ecofish)))

    ((= (-> self location-id) (the-as int (fisher-zone misty-island)))
      (the-as int (fisher-species poisonous-eelfish)))

    ((or
        (= (-> self location-id) (the-as int (fisher-zone village2-electric)))
        (= (-> self location-id) (the-as int (fisher-zone sunken-voltage))))
      (the-as int (fisher-species electric-eelfish)))

    ((= (-> self location-id) (the-as int (fisher-zone swamp-sludge)))
      (the-as int (fisher-species sludge-crappie)))

    ((= (-> self location-id) (the-as int (fisher-zone village3-lava)))
      (the-as int (fisher-species inferno-shark)))

    ((= (-> self location-id) (the-as int (fisher-zone snow-ice)))
      (the-as int (fisher-species ice-shark)))

    ((= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
      (the-as int (fisher-species phantasm-shark)))

    (else
      (the-as int (fisher-species eco-drum)))))

(defun fisher-has-species? ((self fisher-game) (species int))
  (dotimes (slot (-> self fish-count))
    (when (= (fisher-fish-species self slot) species)
      (return #t)))
  #f)

(defun fisher-daytime? ()
  (let ((hour
        (if
          *time-of-day-context*
          (-> *time-of-day-context* time)
          12.0)))

    (and
      (>= hour 6.0)
      (< hour 18.0))))

(defun fisher-fire-canyon-cellfish-eligible? ((self fisher-game))
  (and
    (not
      (task-complete?
        *game-info*
        (game-task firecanyon-end)))
    (or
      *fisher-in-debug?*
      (and
        *target*
        (fisher-existing-zone? self)
        (fisher-daytime?)
        (>=
          (the int
            (the float
              (send-event
                *target*
                'query
                'pickup
                (pickup-type fuel-cell))))
          20)))))

(defun fisher-add-fire-canyon-cellfish-slot! ((self fisher-game))
  (when
    (and
      (> (-> self fish-count) 0)
      (fisher-fire-canyon-cellfish-eligible? self)
      (not
        (fisher-has-species?
          self
          (the-as int (fisher-species fire-canyon-cellfish))))
      (not
        (fisher-has-species?
          self
          (the-as int (fisher-species lurker-shark))))
      (rand-vu-percent?
        (if *fisher-in-debug?* 1.0 *fisher-power-cell-fish-chance*)))

    (let ((start-slot (rand-vu-int-range 0 (- (-> self fish-count) 1)))
        (step 0)
        (slot -1)
        (candidate 0))

      (while
        (and
          (< step (-> self fish-count))
          (< slot 0))

        (set! candidate
          (mod (+ start-slot step) (-> self fish-count)))

        (when
          (and
            (!= (fisher-fish-species self candidate)
              (the-as int (fisher-species scout-fly)))
            (<= (fisher-fish-power-cell-task self candidate) 1))

          (set! slot candidate))

        (+! step 1))

      (when (>= slot 0)
        (fisher-set-fish-species!
          self
          slot
          (the-as int (fisher-species fire-canyon-cellfish)))
        (fisher-set-fish-suffix! self slot 2)
        (fisher-set-fish-level!
          self
          slot
          (fisher-roll-level-for-current-zone self))
        (fisher-set-fish-weight-tenths!
          self
          slot
          (rand-vu-int-range 100 140))
        (fisher-set-fish-power-cell-task!
          self
          slot
          (the-as int (game-task firecanyon-end)))

        (let ((old-fish (fisher-fish-pointer self slot)))
          (when old-fish
            (fisher-destroy-manipy! old-fish)
            (fisher-set-fish-pointer!
              self
              slot
              (the-as (pointer manipy) #f)))))))

  (none))

(defun fisher-buzzer-index-active? ((self fisher-game) (index int))
  (dotimes (slot (-> self fish-count))
    (when
      (and
        (= (fisher-fish-species self slot)
          (the-as int (fisher-species scout-fly)))
        (= (fisher-fish-weight-tenths self slot) index))
      (return #t)))
  #f)

(defun fisher-find-passive-buzzer-index
  ((self fisher-game) (task game-task))

  (let ((start (rand-vu-int-range 0 6))
      (step 0)
      (index 0))

    (while (< step 7)
      (set! index (mod (+ start step) 7))

      (when
        (and
          (not (got-buzzer? *game-info* task index))
          (not (fisher-buzzer-index-active? self index)))
        (return index))

      (+! step 1))

    -1))

(defun fisher-roll-passive-special-for-slot!
  ((self fisher-game) (slot int))


  (when
    (or
      (and
        (or
          (= (-> self location-id) (the-as int (fisher-zone village2-electric)))
          (= (-> self location-id) (the-as int (fisher-zone sunken-voltage))))
        (= (fisher-fish-species self slot)
          (the-as int (fisher-species electric-lurker-shark))))
      (and
        (= (-> self location-id) (the-as int (fisher-zone swamp-sludge)))
        (= (fisher-fish-species self slot)
          (the-as int (fisher-species black-lurker-shark))))
      (and
        (= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
        (= (fisher-fish-species self slot)
          (the-as int (fisher-species megaloviathan))))
      (= (fisher-fish-species self slot)
        (the-as int (fisher-species lurker-shark))))
    (return #f))

  (when
    (and
      (fisher-fire-canyon-cellfish-eligible? self)
      (not
        (fisher-has-species?
          self
          (the-as int (fisher-species fire-canyon-cellfish))))
      (not
        (fisher-has-species?
          self
          (the-as int (fisher-species lurker-shark))))
      (rand-vu-percent?
        (if *fisher-in-debug?* 1.0 *fisher-power-cell-fish-chance*)))

    (fisher-set-fish-species!
      self
      slot
      (the-as int (fisher-species fire-canyon-cellfish)))
    (fisher-set-fish-suffix! self slot 2)
    (fisher-set-fish-level!
      self
      slot
      (fisher-roll-level-for-current-zone self))
    (fisher-set-fish-weight-tenths!
      self
      slot
      (rand-vu-int-range 100 140))
    (fisher-set-fish-power-cell-task!
      self
      slot
      (the-as int (game-task firecanyon-end)))
    (return #t))

  (when
    (!= (-> self location-id) (the-as int (fisher-zone training-lagoon)))

    (let* ((buzzer-task (fisher-buzzer-task-for-location self))
        (buzzer-collected (buzzer-count *game-info* buzzer-task))
        (buzzer-index
          (if
            (and
              (< buzzer-collected 7)
              (rand-vu-percent? (if *fisher-in-debug?* 0.90 0.33)))
            (fisher-find-passive-buzzer-index self buzzer-task)
            -1)))

      (when (>= buzzer-index 0)
        (fisher-set-fish-species!
          self
          slot
          (the-as int (fisher-species scout-fly)))
        (fisher-set-fish-power-cell-task! self slot 0)
        (fisher-set-fish-suffix! self slot 2)
        (fisher-set-fish-level!
          self
          slot
          (fisher-roll-level-for-current-zone self))
        (fisher-set-fish-weight-tenths! self slot buzzer-index)
        (cond
          ((= (-> self location-id) (the-as int (fisher-zone village3-lava)))
            (fisher-set-fish-depth! self slot (meters 27.5)))
          ((= (-> self location-id) (the-as int (fisher-zone snow-ice)))
            (fisher-set-fish-depth! self slot (meters 19.2))))
        (return #t))))

  (when
    (and
      (or
        (= (-> self location-id) 1)
        (= (-> self location-id) 3)
        (= (-> self location-id) 4)
        (= (-> self location-id) 5)
        (= (-> self location-id) 6)
        (= (-> self location-id) 7)
        (= (-> self location-id) (the-as int (fisher-zone village3-lava)))
        (= (-> self location-id) (the-as int (fisher-zone snow-ice)))
        (= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco))))
      (not (fisher-has-power-cell-fish? self))
      (rand-vu-percent?
        (if *fisher-in-debug?* 0.90 *fisher-power-cell-fish-chance*)))

    (let ((task (fisher-find-missing-power-cell-task self)))
      (when (> (the int task) 1)
        (fisher-set-fish-power-cell-task! self slot (the int task))
        (fisher-set-fish-weight-tenths!
          self
          slot
          (max
            1
            (the int
              (+
                (*
                  (the float (fisher-fish-weight-tenths self slot))
                  1.70)
                0.5))))
        (return #t))))

  #f)

(defun fisher-buzzer-task-for-location ((self fisher-game))
  (cond
    ((= (-> self location-id) 1) (game-task jungle-buzzer))
    ((= (-> self location-id) 2) (game-task training-buzzer))
    ((= (-> self location-id) 3) (game-task beach-buzzer))
    ((= (-> self location-id) 4) (game-task misty-buzzer))
    ((= (-> self location-id) 5) (game-task village2-buzzer))
    ((= (-> self location-id) 6) (game-task sunken-buzzer))
    ((= (-> self location-id) 7) (game-task swamp-buzzer))
    ((= (-> self location-id) (the-as int (fisher-zone village3-lava)))
      (game-task village3-buzzer))
    ((= (-> self location-id) (the-as int (fisher-zone snow-ice)))
      (game-task snow-buzzer))
    ((= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
      (game-task cave-buzzer))
    (else (game-task village1-buzzer))))

(defun fisher-find-missing-buzzer-index
  ((task game-task) (start int) (exclude int))

  (let ((step 0)
      (index 0))

    (while (< step 7)
      (set! index (mod (+ start step) 7))

      (when
        (and
          (!= index exclude)
          (not (got-buzzer? *game-info* task index)))

        (return index))

      (+! step 1))

    -1))

(defun fisher-add-buzzer-fish-slots! ((self fisher-game))
  (let* ((task (fisher-buzzer-task-for-location self))
      (collected (buzzer-count *game-info* task))
      (remaining (- 7 collected))
      (spawn-count 0)
      (first-index -1)
      (second-index -1)
      (start-index (rand-vu-int-range 0 6)))

    (when
      (and
        (!= (-> self location-id) (the-as int (fisher-zone training-lagoon)))
        (> remaining 0)
        (> (-> self fish-count) 0)
        (rand-vu-percent? (if *fisher-in-debug?* 0.90 0.33)))

      (set! spawn-count 1)

      (set! first-index
        (fisher-find-missing-buzzer-index task start-index -1))

      (when (>= first-index 0)
        (let ((slot (- (-> self fish-count) 1)))
          (while
            (and
              (>= slot 0)
              (or
                (> (fisher-fish-power-cell-task self slot) 1)
                (= (fisher-fish-species self slot)
                  (the-as int (fisher-species electric-lurker-shark)))
                (= (fisher-fish-species self slot)
                  (the-as int (fisher-species black-lurker-shark)))
                (= (fisher-fish-species self slot)
                  (the-as int (fisher-species lurker-shark)))
                (= (fisher-fish-species self slot)
                  (the-as int (fisher-species inferno-shark)))
                (= (fisher-fish-species self slot)
                  (the-as int (fisher-species megaloviathan)))))
            (-! slot 1))

          (when (>= slot 0)
            (fisher-set-fish-species! self slot 4)
            (fisher-set-fish-power-cell-task! self slot 0)
            (fisher-set-fish-suffix! self slot 2)
            (fisher-set-fish-level!
              self
              slot
              (fisher-roll-level-for-current-zone self))
            (fisher-set-fish-weight-tenths! self slot first-index)
            (cond
              ((= (-> self location-id) (the-as int (fisher-zone village3-lava)))
                (fisher-set-fish-depth! self slot (meters 27.5)))
              ((= (-> self location-id) (the-as int (fisher-zone snow-ice)))
                (fisher-set-fish-depth! self slot (meters 19.2))))

            (let ((old-fish (fisher-fish-pointer self slot)))
              (when old-fish
                (fisher-destroy-manipy! old-fish)
                (fisher-set-fish-pointer!
                  self
                  slot
                  (the-as (pointer manipy) #f)))))))

      (when (= spawn-count 2)
        (set! second-index
          (fisher-find-missing-buzzer-index task (+ start-index 1) first-index))

        (when (>= second-index 0)
          (let ((slot (- (-> self fish-count) 2)))
            (fisher-set-fish-species! self slot 4)
            (fisher-set-fish-power-cell-task! self slot 0)
            (fisher-set-fish-suffix! self slot 2)
            (fisher-set-fish-level!
              self
              slot
              (fisher-roll-level-in-range
                (-> self fish-level-min)
                (-> self fish-level-max)))
            (fisher-set-fish-weight-tenths! self slot second-index)
            (cond
              ((= (-> self location-id) (the-as int (fisher-zone village3-lava)))
                (fisher-set-fish-depth! self slot (meters 27.5)))
              ((= (-> self location-id) (the-as int (fisher-zone snow-ice)))
                (fisher-set-fish-depth! self slot (meters 19.2))))

            (let ((old-fish (fisher-fish-pointer self slot)))
              (when old-fish
                (fisher-destroy-manipy! old-fish)
                (fisher-set-fish-pointer!
                  self
                  slot
                  (the-as (pointer manipy) #f))))))))

    (none)))

(defun fisher-configure-sandover-table! ((self fisher-game))
  (let ((zone (fisher-zone-info-for (fisher-zone sandover-dock))))
    (set! (-> self fish-level-min) (-> zone level-min))
    (set! (-> self fish-level-max) (-> zone level-max))

  (let ((eco-count 0)
      (largemouth-count 0))

    (cond
      ((fisher-golden-hour?)
        (set! eco-count (rand-vu-int-range (-> zone golden-min 0) (-> zone golden-max 0)))
        (set! largemouth-count (rand-vu-int-range (-> zone golden-min 1) (-> zone golden-max 1))))

      (else
        (set! eco-count (rand-vu-int-range (-> zone normal-min 0) (-> zone normal-max 0)))
        (set! largemouth-count (rand-vu-int-range (-> zone normal-min 1) (-> zone normal-max 1)))))

    (set! (-> self sandover-eco-count) eco-count)
    (set! (-> self sandover-largemouth-count) largemouth-count)

    (fisher-assign-table-slots!
      self
      eco-count
      largemouth-count
      0))

  (none)))

(defun fisher-configure-training-lagoon-table! ((self fisher-game))
  (let* ((zone (fisher-zone-info-for (fisher-zone training-lagoon)))
      (eco-count (rand-vu-int-range (-> zone normal-min 0) (-> zone normal-max 0)))
      (largemouth-count (rand-vu-int-range (-> zone normal-min 1) (-> zone normal-max 1))))

    (set! (-> self fish-level-min) (-> zone level-min))
    (set! (-> self fish-level-max) (-> zone level-max))
    (set! (-> self sandover-eco-count) eco-count)
    (set! (-> self sandover-largemouth-count) largemouth-count)

    (fisher-assign-table-slots!
      self
      eco-count
      largemouth-count
      0))

  (none))

(defun fisher-configure-jungle-pillar-table! ((self fisher-game))
  (let* ((zone (fisher-zone-info-for (fisher-zone jungle-pillar)))
      (golden? (fisher-golden-hour?))
      (total-count
        (if golden?
          (rand-vu-int-range (-> zone golden-fish-count-min) (-> zone golden-fish-count-max))
          (rand-vu-int-range (-> zone normal-fish-count-min) (-> zone normal-fish-count-max))))
      (babak-count
        (if golden?
          (rand-vu-int-range (-> zone golden-min 0) (-> zone golden-max 0))
          (rand-vu-int-range (-> zone normal-min 0) (-> zone normal-max 0))))
      (remaining-count (- total-count babak-count))
      (largemouth-count (rand-vu-int-range 1 remaining-count))
      (eco-count (- remaining-count largemouth-count)))

    (set! (-> self fish-level-min) (-> zone level-min))
    (set! (-> self fish-level-max) (-> zone level-max))
    (set! (-> self sandover-eco-count) eco-count)
    (set! (-> self sandover-largemouth-count) largemouth-count)

    (fisher-assign-table-slots! self eco-count largemouth-count babak-count)

    (when (> (-> zone shark-chance) 0.0)
      (fisher-add-lurker-shark-slot! self)))

  (none))

(defun fisher-configure-sentinel-pontoon-table! ((self fisher-game))
  (let* ((zone (fisher-zone-info-for (fisher-zone sentinel-pontoon)))
      (golden? (fisher-golden-hour?))
      (total-count
        (if golden?
          (rand-vu-int-range (-> zone golden-fish-count-min) (-> zone golden-fish-count-max))
          (rand-vu-int-range (-> zone normal-fish-count-min) (-> zone normal-fish-count-max))))
      (babak-count (rand-vu-int-range 1 (- total-count 2)))
      (remaining-count (- total-count babak-count))
      (largemouth-count (rand-vu-int-range 1 (- remaining-count 1)))
      (eco-count (- remaining-count largemouth-count)))

    (set! (-> self fish-level-min) (-> zone level-min))
    (set! (-> self fish-level-max) (-> zone level-max))
    (set! (-> self sandover-eco-count) eco-count)
    (set! (-> self sandover-largemouth-count) largemouth-count)

    (fisher-assign-table-slots! self eco-count largemouth-count babak-count)

    (when (> (-> zone shark-chance) 0.0)
      (fisher-add-lurker-shark-slot! self)))

  (none))

(defun fisher-configure-misty-table! ((self fisher-game))
  (let* ((zone (fisher-zone-info-for (fisher-zone misty-island)))
      (golden? (fisher-golden-hour?))
      (largemouth-count
        (if golden?
          (rand-vu-int-range (-> zone golden-min 0) (-> zone golden-max 0))
          (rand-vu-int-range (-> zone normal-min 0) (-> zone normal-max 0))))
      (babak-count
        (if golden?
          (rand-vu-int-range (-> zone golden-min 1) (-> zone golden-max 1))
          (rand-vu-int-range (-> zone normal-min 1) (-> zone normal-max 1))))
      (eel-count
        (if golden?
          (rand-vu-int-range (-> zone golden-min 2) (-> zone golden-max 2))
          (rand-vu-int-range (-> zone normal-min 2) (-> zone normal-max 2))))
      (shark-count (if (rand-vu-percent? (-> zone shark-chance)) 1 0))
      (slot 0))

    (set! (-> self fish-level-min) (-> zone level-min))
    (set! (-> self fish-level-max) (-> zone level-max))
    (set! (-> self fish-count)
      (min *fisher-max-fish-slots* (+ largemouth-count babak-count eel-count shark-count)))
    (set! (-> self sandover-eco-count) eel-count)
    (set! (-> self sandover-largemouth-count) largemouth-count)

    (fisher-clear-power-cell-tasks! self)

    (when (> shark-count 0)
      (fisher-configure-random-fish-slot! self slot (the-as int (fisher-species lurker-shark)))
      (+! slot 1))

    (dotimes (i babak-count)
      (when (< slot (-> self fish-count))
        (fisher-configure-random-fish-slot! self slot (the-as int (fisher-species babak-ecofish)))
        (+! slot 1)))

    (dotimes (i largemouth-count)
      (when (< slot (-> self fish-count))
        (fisher-configure-random-fish-slot! self slot (the-as int (fisher-species largemouth-ecofish)))
        (+! slot 1)))

    (while (< slot (-> self fish-count))
      (fisher-configure-random-fish-slot! self slot (the-as int (fisher-species poisonous-eelfish)))
      (+! slot 1)))

  (none))


(defun fisher-configure-village2-table! ((self fisher-game))
