(defun swimmer-pontoonfive-initialize-collision!
  ((self swimmer-pontoonfive))

  (let ((shape
        (new 'process
          'collide-shape
          self
          (collide-list-enum hit-by-player))))

    (let ((mesh
          (new 'process
            'collide-shape-prim-mesh
            shape
            (the-as uint 0)
            (the-as uint 0))))

      (set! (-> mesh prim-core collide-as) (collide-kind ground-object))
      (set! (-> mesh collide-with) (collide-kind target))

      (set!
        (-> mesh prim-core action)
        (collide-action solid rider-plat-sticky))

      (set!
        (-> mesh prim-core offense)
        (collide-offense indestructible))

      (set! (-> mesh transform-index) 0)

      (set-vector!
        (-> mesh local-sphere)
        0.0
        0.0
        0.0
        18432.0)

      (set-root-prim! shape mesh))

    (set! (-> shape nav-radius) 12288.0)
    (backup-collide-with-as shape)
    (set! (-> self root) shape))

  (none))

(defun swimmer-pontoonten-initialize-collision!
  ((self swimmer-pontoonten))

  (let ((shape
        (new 'process
          'collide-shape
          self
          (collide-list-enum hit-by-player))))

    (let ((mesh
          (new 'process
            'collide-shape-prim-mesh
            shape
            (the-as uint 0)
            (the-as uint 0))))

      (set! (-> mesh prim-core collide-as) (collide-kind ground-object))
      (set! (-> mesh collide-with) (collide-kind target))

      (set!
        (-> mesh prim-core action)
        (collide-action solid rider-plat-sticky))

      (set!
        (-> mesh prim-core offense)
        (collide-offense indestructible))

      (set! (-> mesh transform-index) 0)

      (set-vector!
        (-> mesh local-sphere)
        0.0
        0.0
        0.0
        25395.2)

      (set-root-prim! shape mesh))

    (set! (-> shape nav-radius) 20480.0)
    (backup-collide-with-as shape)
    (set! (-> self root) shape))

  (none))

(defstate swimmer-pontoon-die (swimmer-pontoon)
  :code
  (behavior ()
    (cleanup-for-death self)
    (deactivate self)))

(defstate swimmer-pontoon-idle (swimmer-pontoon)
  :event
  (behavior
    ((proc process)
      (argc int)
      (message symbol)
      (block event-message-block))

    (case message
      (('die)
        (go swimmer-pontoon-die))))

  :enter
  (behavior ()
    (cond
      ((= (-> self pontoon-type) 0)
        (ja-no-eval
          :group! pontoonfive-idle-ja
          :num! (seek!)
          :frame-num 0.0))

      (else
        (ja-no-eval
          :group! pontoonten-idle-ja
          :num! (seek!)
          :frame-num 0.0))))

  :code
  (behavior ()
    (loop
      (suspend)
      (ja :num! (seek!))))

  :post ja-post)

(defbehavior swimmer-pontoonfive-init-by-other
  swimmer-pontoonfive
  ((spawn-pos vector)
    (rotation-degrees float))

  (set! (-> self pontoon-type) 0)

  (logior!
    (-> self mask)
    (process-mask platform))

  (logclear!
    (-> self mask)
    (process-mask actor-pause))

  (swimmer-pontoonfive-initialize-collision! self)

  (initialize-skeleton
    self
    *swimmer-pontoonfive-sg*
    '())

  (find-collision-meshes (the-as collide-shape (-> self root)))

  (#when PC_PORT
    (set!
      (-> self skel postbind-function)
      process-drawable-joint-callback-pc))

  (set! (-> self root trans quad) (-> spawn-pos quad))
  (set! (-> self root trans w) 1.0)

  (quaternion-axis-angle!
    (-> self root quat)
    0.0
    1.0
    0.0
    (degrees rotation-degrees))

  (vector-identity! (-> self root scale))

  (set! (-> self root pause-adjust-distance) -122880.0)
  (set! (-> self draw force-lod) 0)

  (logclear!
    (-> self draw status)
    (draw-status hidden))

  (transform-post)

  (go swimmer-pontoon-idle))

(defbehavior swimmer-pontoonten-init-by-other
  swimmer-pontoonten
  ((spawn-pos vector)
    (rotation-degrees float))

  (set! (-> self pontoon-type) 1)

  (logior!
    (-> self mask)
    (process-mask platform))

  (logclear!
    (-> self mask)
    (process-mask actor-pause))

  (swimmer-pontoonten-initialize-collision! self)

  (initialize-skeleton
    self
    *swimmer-pontoonten-sg*
    '())

  (find-collision-meshes (the-as collide-shape (-> self root)))

  (#when PC_PORT
    (set!
      (-> self skel postbind-function)
      process-drawable-joint-callback-pc))

  (set! (-> self root trans quad) (-> spawn-pos quad))
  (set! (-> self root trans w) 1.0)

  (quaternion-axis-angle!
    (-> self root quat)
    0.0
    1.0
    0.0
    (degrees rotation-degrees))

  (vector-identity! (-> self root scale))

  (set! (-> self root pause-adjust-distance) -122880.0)
  (set! (-> self draw force-lod) 0)

  (logclear!
    (-> self draw status)
    (draw-status hidden))

  (transform-post)

  (go swimmer-pontoon-idle))

(defun spawn-pontoon-swimmer
  ((spawn-pos vector)
    (pontoon-type int)
    (rotation-degrees float))

  (cond
    ((= pontoon-type 0)
      (process-spawn
        swimmer-pontoonfive
        spawn-pos
        rotation-degrees
        :name "swimmer-pontoonfive"
        :to *active-pool*))

    ((= pontoon-type 1)
      (process-spawn
        swimmer-pontoonten
        spawn-pos
        rotation-degrees
        :name "swimmer-pontoonten"
        :to *active-pool*))

    (else
      (format
        0
        "spawn-pontoon-swimmer: invalid type ~D; use 0 or 1.~%"
        pontoon-type)))

  (none))

(defun maintain-training-pontoon! ()
  (let ((inside
        (when *level*
          (level-get-target-inside *level*))))

    (cond
      ((and
          inside
          (= (-> inside name) 'training))

        (when
          (not *training-pontoon-spawned?*)

          (spawn-pontoon-swimmer
            (new 'static 'vector
              :x (meters -1330.3963)
              :y (meters 0.3323)
              :z (meters 925.1775)
              :w 1.0)
            0
            0.0)

          (set! *training-pontoon-spawned?* #t)))

      (else
        (set! *training-pontoon-spawned?* #f))))

  (none))

(defun maintain-sentinel-pontoon! ()
