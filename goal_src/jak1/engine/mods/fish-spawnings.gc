(defun fisher-fish-distance ((self fisher-game) (slot int))
  (-> self fish-data slot slot distance))

(defun fisher-fish-lane ((self fisher-game) (slot int))
  (-> self fish-data slot slot lane))

(defun fisher-fish-depth ((self fisher-game) (slot int))
  (-> self fish-data slot slot depth))

(defun fisher-fish-direction ((self fisher-game) (slot int))
  (-> self fish-data slot slot direction))

(defun fisher-fish-speed ((self fisher-game) (slot int))
  (-> self fish-data slot slot speed))

(defun fisher-set-fish-distance! ((self fisher-game) (slot int) (value float))
  (set! (-> self fish-data slot slot distance) value)
  (none))

(defun fisher-set-fish-lane! ((self fisher-game) (slot int) (value float))
  (set! (-> self fish-data slot slot lane) value)
  (none))

(defun fisher-set-fish-depth! ((self fisher-game) (slot int) (value float))
  ;; Village3 Scout Flies live on deepwater; Snow Scout Flies live on the
  ;; bottom plane.  Enforce both at the shared setter.
  (set!
    (-> self fish-data slot slot depth)
    (cond
      ((and
          (= (-> self location-id) (the-as int (fisher-zone village3-lava)))
          (= (fisher-fish-species self slot)
            (the-as int (fisher-species scout-fly))))
        (meters 27.5))
      ((and
          (= (-> self location-id) (the-as int (fisher-zone snow-ice)))
          (= (fisher-fish-species self slot)
            (the-as int (fisher-species scout-fly))))
        (meters 19.2))
      (else value)))
  (none))

(defun fisher-set-fish-direction! ((self fisher-game) (slot int) (value float))
  (set! (-> self fish-data slot slot direction) value)
  (none))

(defun fisher-set-fish-speed! ((self fisher-game) (slot int) (value float))
  (set! (-> self fish-data slot slot speed) value)
  (none))

