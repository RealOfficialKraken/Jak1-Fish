;;-*-Lisp-*-
(in-package goal)
(bundles "JUN.DGO")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Fish tables, fish-slot management, gameplay fish spawning, fishing-area spawning, and pontoons
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defskelgroup *swimmer-pontoonfive-sg*
  pontoonfive
  pontoonfive-lod0-jg
  pontoonfive-idle-ja
  ((pontoonfive-lod0-mg (meters 20))
   (pontoonfive-lod1-mg (meters 40))
   (pontoonfive-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 5)
  :longest-edge (meters 3.5))

(defskelgroup *swimmer-pontoonten-sg*
  pontoonten
  pontoonten-lod0-jg
  pontoonten-idle-ja
  ((pontoonten-lod0-mg (meters 20))
   (pontoonten-lod1-mg (meters 40))
   (pontoonten-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 7)
  :longest-edge (meters 4))

(defstate swimmer-pontoon-die (swimmer-pontoon)
  :code
  (behavior ()
    (when (-> self visual)
      (deactivate
        (-> (-> self visual) 0))

      (set!
        (-> self visual)
        (the-as (pointer manipy) #f)))

    (cleanup-for-death self)
    (deactivate self)))

(defstate swimmer-pontoon-float (swimmer-pontoon)
  :virtual #t

  :event
  (behavior
    ((proc process)
     (argc int)
     (message symbol)
     (block event-message-block))

    (case message
      (('die)
        (go swimmer-pontoon-die))

      (else
        (rigid-body-platform-event-handler
          proc
          argc
          message
          block))))

  :code
  (behavior ()
    (loop
      ;; The rigid body owns collision and buoyancy. Keep the independent
      ;; pontoon visual locked to that rigid-body transform.
      (when (-> self visual)
        (let ((visual-proc
              (the-as manipy
                (-> (-> self visual) 0 self))))

          (set!
            (-> visual-proc root trans quad)
            (-> self root-overlay trans quad))

          (set!
            (-> visual-proc root quat quad)
            (-> self root-overlay quat quad))))

      (suspend)))

  :post rigid-body-platform-post)

(defmethod rigid-body-platform-method-23
  ((this swimmer-pontoon) (time-step float))

  (call-parent-method this time-step)

  (rigid-body-platform-method-27
    this
    (-> this anchor-point))

  0
  (none))

(defmethod rigid-body-platform-method-30
  ((this swimmer-pontoonfive))

  (let ((moving-shape
        (new 'process
          'collide-shape-moving
          this
          (collide-list-enum hit-by-player))))

    (set!
      (-> moving-shape dynam)
      (copy *standard-dynamics* 'process))

    (set!
      (-> moving-shape reaction)
      default-collision-reaction)

    (set!
      (-> moving-shape no-reaction)
      (the-as
        (function
          collide-shape-moving
          collide-shape-intersect
          vector
          vector
          none)
        nothing))

    (alloc-riders moving-shape 1)

    (let ((mesh
          (new 'process
            'collide-shape-prim-mesh
            moving-shape
            (the-as uint 0)
            (the-as uint 0))))

      (set!
        (-> mesh prim-core collide-as)
        (collide-kind enemy))

      (set!
        (-> mesh collide-with)
        (collide-kind target))

      (set!
        (-> mesh prim-core action)
        (collide-action solid rider-plat-sticky))

      (set!
        (-> mesh prim-core offense)
        (collide-offense indestructible))

      (set! (-> mesh transform-index) 0)

      (set-vector!
        (-> mesh local-sphere)
        0.0
        0.0
        0.0
        18432.0)

      (set-root-prim! moving-shape mesh))

    (set!
      (-> moving-shape nav-radius)
      (* 0.75
        (-> moving-shape root-prim local-sphere w)))

    (backup-collide-with-as moving-shape)

    (set!
      (-> this root-overlay)
      moving-shape))

  0
  (none))

(defmethod rigid-body-platform-method-31
  ((this swimmer-pontoonfive))

  (initialize-skeleton
    this
    *swimmer-pontoonfive-sg*
    '())

  (rigid-body-platform-method-29
    this
    *swimmer-pontoonfive-constants*)

  (set! (-> this float-height-offset) 6144.0)
  (set! (-> this root-overlay nav-radius) 12288.0)

  (let ((point
        (-> this control-point-array data 0)))
    (set-vector!
      (-> point local-pos)
      9216.0
      0.0
      12083.2
      1.0))

  (let ((point
        (-> this control-point-array data 1)))
    (set-vector!
      (-> point local-pos)
      9216.0
      0.0
      -12083.2
      1.0))

  (let ((point
        (-> this control-point-array data 2)))
    (set-vector!
      (-> point local-pos)
      -9216.0
      0.0
      -12083.2
      1.0))

  (let ((point
        (-> this control-point-array data 3)))
    (set-vector!
      (-> point local-pos)
      -9216.0
      0.0
      12083.2
      1.0))

  0
  (none))

