    2 4 5 8 12 14 1.0)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone sentinel-pontoon)) 0 (fisher-species eco-drum) 1 2 4 5)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone sentinel-pontoon)) 1 (fisher-species largemouth-ecofish) 2 3 4 5)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone sentinel-pontoon)) 2 (fisher-species babak-ecofish) 2 3 4 4)

  (fisher-set-zone-info!
    (fisher-zone-info-for (fisher-zone misty-island))
    8 13 7 11 10 17 0.38)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone misty-island)) 0 (fisher-species largemouth-ecofish) 1 3 3 4)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone misty-island)) 1 (fisher-species babak-ecofish) 1 1 1 2)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone misty-island)) 2 (fisher-species poisonous-eelfish) 5 6 6 10)

  (fisher-set-zone-info!
    (fisher-zone-info-for (fisher-zone village2-electric))
    10 13 12 18 18 22 0.0)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone village2-electric)) 0 (fisher-species electric-lurker-shark) 2 2 2 2)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone village2-electric)) 1 (fisher-species electric-grubfish) 2 4 4 8)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone village2-electric)) 2 (fisher-species electric-eelfish) 8 12 12 16)

  (fisher-set-zone-info!
    (fisher-zone-info-for (fisher-zone sunken-voltage))
    13 16 11 14 16 21 0.0)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone sunken-voltage)) 0 (fisher-species electric-lurker-shark) 1 1 1 1)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone sunken-voltage)) 1 (fisher-species electric-grubfish) 6 8 9 12)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone sunken-voltage)) 2 (fisher-species electric-eelfish) 4 5 6 8)

  (fisher-set-zone-info!
    (fisher-zone-info-for (fisher-zone swamp-sludge))
    14 17 11 13 17 21 0.0)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone swamp-sludge)) 0 (fisher-species black-lurker-shark) 1 1 1 1)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone swamp-sludge)) 1 (fisher-species swamp-guppie) 5 6 8 10)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone swamp-sludge)) 2 (fisher-species sludge-crappie) 5 6 8 10)

  ;; First Hub 3 pool. Inferno Sharks occupy the lower 15-17 band while the
  ;; two heavy lava species occupy 18-20.
  (fisher-set-zone-info!
    (fisher-zone-info-for (fisher-zone village3-lava))
    15 20 15 19 20 27 0.0)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone village3-lava)) 0 (fisher-species lava-drum) 4 5 6 7)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone village3-lava)) 1 (fisher-species magma-serpent) 3 3 4 4)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone village3-lava)) 2 (fisher-species inferno-shark) 8 10 10 14)


  ;; Snow pool.  Custom builder below enforces the exact requested species
  ;; counts; these ranges are also used as replacement weights.
  (fisher-set-zone-info!
    (fisher-zone-info-for (fisher-zone snow-ice))
    18 20 15 19 19 26 0.0)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone snow-ice)) 0 (fisher-species frost-biter) 4 5 5 7)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone snow-ice)) 1 (fisher-species crystal-fish) 1 2 2 3)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone snow-ice)) 2 (fisher-species ice-shark) 10 12 12 16)

  ;; Main Cave dark-eco pool.  Fishing levels continue upward from Snow.
  ;; Megaloviathan is always exactly one resident and is kept in slot zero by
  ;; the custom builder below.
  (fisher-set-zone-info!
    (fisher-zone-info-for (fisher-zone maincave-dark-eco))
    21 25 6 19 14 25 0.0)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone maincave-dark-eco)) 0 (fisher-species helix-voidfish) 2 10 5 10)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone maincave-dark-eco)) 1 (fisher-species dark-precursor-fangfish) 2 6 6 10)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone maincave-dark-eco)) 2 (fisher-species phantasm-shark) 1 2 2 4)
  (fisher-set-zone-species-range! (fisher-zone-info-for (fisher-zone maincave-dark-eco)) 3 (fisher-species megaloviathan) 1 1 1 1)

  ;; Final Boss has exactly one authored resident; no random growth, rares,
  ;; Scout Flies, or Power Cell carriers are ever injected into this zone.
  (fisher-set-zone-info!
    (fisher-zone-info-for (fisher-zone finalboss-nuclear))
    20 20 1 1 1 1 0.0)
  (fisher-set-zone-species-range!
    (fisher-zone-info-for (fisher-zone finalboss-nuclear))
    0 (fisher-species nuclear-bombfish) 1 1 1 1)

  (set! (-> (fisher-zone-info-for (fisher-zone sandover-dock)) fire-canyon-cellfish?) #t)
  (set! (-> (fisher-zone-info-for (fisher-zone jungle-pillar)) fire-canyon-cellfish?) #t)
  (set! (-> (fisher-zone-info-for (fisher-zone training-lagoon)) fire-canyon-cellfish?) #t)
  (set! (-> (fisher-zone-info-for (fisher-zone sentinel-pontoon)) fire-canyon-cellfish?) #t)
  (set! (-> (fisher-zone-info-for (fisher-zone misty-island)) fire-canyon-cellfish?) #t)

  (none))

(fisher-initialize-definition-tables!)

(defun swimmer-pontoonfive-initialize-collision!
  ((self swimmer-pontoonfive))

  (let ((shape
        (new 'process
          'collide-shape
          self
          (collide-list-enum hit-by-player))))

    (let ((mesh
          (new 'process
            'collide-shape-prim-mesh
            shape
            (the-as uint 0)
            (the-as uint 0))))

      (set! (-> mesh prim-core collide-as) (collide-kind ground-object))
      (set! (-> mesh collide-with) (collide-kind target))

      (set!
        (-> mesh prim-core action)
        (collide-action solid rider-plat-sticky))

      (set!
        (-> mesh prim-core offense)
        (collide-offense indestructible))

      (set! (-> mesh transform-index) 0)

      (set-vector!
        (-> mesh local-sphere)
        0.0
        0.0
        0.0
        18432.0)

      (set-root-prim! shape mesh))

    (set! (-> shape nav-radius) 12288.0)
    (backup-collide-with-as shape)
    (set! (-> self root) shape))

  (none))

(defun swimmer-pontoonten-initialize-collision!
  ((self swimmer-pontoonten))

  (let ((shape
        (new 'process
          'collide-shape
          self
          (collide-list-enum hit-by-player))))

    (let ((mesh
          (new 'process
            'collide-shape-prim-mesh
            shape
            (the-as uint 0)
            (the-as uint 0))))

      (set! (-> mesh prim-core collide-as) (collide-kind ground-object))
      (set! (-> mesh collide-with) (collide-kind target))

      (set!
        (-> mesh prim-core action)
        (collide-action solid rider-plat-sticky))

      (set!
        (-> mesh prim-core offense)
        (collide-offense indestructible))

      (set! (-> mesh transform-index) 0)

      (set-vector!
        (-> mesh local-sphere)
        0.0
        0.0
        0.0
        25395.2)

      (set-root-prim! shape mesh))

    (set! (-> shape nav-radius) 20480.0)
    (backup-collide-with-as shape)
    (set! (-> self root) shape))

  (none))

(defstate swimmer-pontoon-die (swimmer-pontoon)
  :code
  (behavior ()
    (cleanup-for-death self)
    (deactivate self)))

(defstate swimmer-pontoon-idle (swimmer-pontoon)
  :event
  (behavior
    ((proc process)
      (argc int)
      (message symbol)
      (block event-message-block))

    (case message
      (('die)
        (go swimmer-pontoon-die))))

  :enter
  (behavior ()
    (cond
      ((= (-> self pontoon-type) 0)
        (ja-no-eval
          :group! pontoonfive-idle-ja
          :num! (seek!)
          :frame-num 0.0))

      (else
        (ja-no-eval
          :group! pontoonten-idle-ja
          :num! (seek!)
          :frame-num 0.0))))

  :code
  (behavior ()
    (loop
      (suspend)
      (ja :num! (seek!))))

  :post ja-post)

(defbehavior swimmer-pontoonfive-init-by-other
  swimmer-pontoonfive
  ((spawn-pos vector)
    (rotation-degrees float))

  (set! (-> self pontoon-type) 0)

  (logior!
    (-> self mask)
    (process-mask platform))

  (logclear!
    (-> self mask)
    (process-mask actor-pause))

  (swimmer-pontoonfive-initialize-collision! self)

  (initialize-skeleton
    self
    *swimmer-pontoonfive-sg*
    '())

  (find-collision-meshes (the-as collide-shape (-> self root)))

  (#when PC_PORT
    (set!
      (-> self skel postbind-function)
      process-drawable-joint-callback-pc))

  (set! (-> self root trans quad) (-> spawn-pos quad))
  (set! (-> self root trans w) 1.0)

  (quaternion-axis-angle!
    (-> self root quat)
    0.0
    1.0
    0.0
    (degrees rotation-degrees))

  (vector-identity! (-> self root scale))

  (set! (-> self root pause-adjust-distance) -122880.0)
  (set! (-> self draw force-lod) 0)

  (logclear!
    (-> self draw status)
    (draw-status hidden))

  (transform-post)

  (go swimmer-pontoon-idle))

(defbehavior swimmer-pontoonten-init-by-other
  swimmer-pontoonten
  ((spawn-pos vector)
    (rotation-degrees float))

  (set! (-> self pontoon-type) 1)

  (logior!
    (-> self mask)
    (process-mask platform))

  (logclear!
    (-> self mask)
    (process-mask actor-pause))

  (swimmer-pontoonten-initialize-collision! self)

  (initialize-skeleton
    self
    *swimmer-pontoonten-sg*
    '())

  (find-collision-meshes (the-as collide-shape (-> self root)))

  (#when PC_PORT
    (set!
      (-> self skel postbind-function)
      process-drawable-joint-callback-pc))

  (set! (-> self root trans quad) (-> spawn-pos quad))
  (set! (-> self root trans w) 1.0)

  (quaternion-axis-angle!
    (-> self root quat)
    0.0
    1.0
    0.0
    (degrees rotation-degrees))

  (vector-identity! (-> self root scale))

  (set! (-> self root pause-adjust-distance) -122880.0)
  (set! (-> self draw force-lod) 0)

  (logclear!
    (-> self draw status)
    (draw-status hidden))

  (transform-post)

  (go swimmer-pontoon-idle))

(defun spawn-pontoon-swimmer
  ((spawn-pos vector)
    (pontoon-type int)
    (rotation-degrees float))

  (cond
    ((= pontoon-type 0)
      (process-spawn
        swimmer-pontoonfive
        spawn-pos
        rotation-degrees
        :name "swimmer-pontoonfive"
        :to *active-pool*))

    ((= pontoon-type 1)
      (process-spawn
        swimmer-pontoonten
        spawn-pos
        rotation-degrees
        :name "swimmer-pontoonten"
        :to *active-pool*))

    (else
      (format
        0
        "spawn-pontoon-swimmer: invalid type ~D; use 0 or 1.~%"
        pontoon-type)))

  (none))

(defun maintain-training-pontoon! ()
  (let ((inside
        (when *level*
          (level-get-target-inside *level*))))

    (cond
      ((and
          inside
          (= (-> inside name) 'training))

        (when
          (not *training-pontoon-spawned?*)

          (spawn-pontoon-swimmer
            (new 'static 'vector
              :x (meters -1330.3963)
              :y (meters 0.3323)
              :z (meters 925.1775)
              :w 1.0)
            0
            0.0)

          (set! *training-pontoon-spawned?* #t)))

      (else
        (set! *training-pontoon-spawned?* #f))))

  (none))

(defun maintain-sentinel-pontoon! ()
  (let ((inside
        (when *level*
          (level-get-target-inside *level*))))

    (cond
      ((and
          inside
          (= (-> inside name) 'beach))

        (when
          (not *sentinel-pontoon-spawned?*)

          (spawn-pontoon-swimmer
            (new 'static 'vector
              :x (meters -291.4279)
              :y (meters 0.4322)
              :z (meters -273.1889)
              :w 1.0)
            0
            157.46)

          (set! *sentinel-pontoon-spawned?* #t)))

      (else
        (set! *sentinel-pontoon-spawned?* #f))))

  (none))

