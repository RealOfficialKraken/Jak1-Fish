;;-*-Lisp-*-
(in-package goal)
(bundles "JUN.DGO")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Fish tables, fish-slot management, gameplay fish spawning, fishing-area spawning, and pontoons
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defskelgroup *swimmer-pontoonfive-sg*
  pontoonfive
  pontoonfive-lod0-jg
  pontoonfive-idle-ja
  ((pontoonfive-lod0-mg (meters 20))
   (pontoonfive-lod1-mg (meters 40))
   (pontoonfive-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 5)
  :longest-edge (meters 3.5))

(defskelgroup *swimmer-pontoonten-sg*
  pontoonten
  pontoonten-lod0-jg
  pontoonten-idle-ja
  ((pontoonten-lod0-mg (meters 20))
   (pontoonten-lod1-mg (meters 40))
   (pontoonten-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 7)
  :longest-edge (meters 4))

(defun swimmer-pontoonfive-initialize-collision!
  ((self swimmer-pontoonfive))

  ;; Use collision mesh 0 embedded in the loaded pontoon art group.
  ;; initialize-skeleton installs the jgeo; find-collision-meshes resolves
  ;; this primitive's mesh-id against that jgeo afterward.
  (let ((shape
        (new 'process
          'collide-shape
          self
          (collide-list-enum hit-by-player))))

    (let ((mesh
          (new 'process
            'collide-shape-prim-mesh
            shape
            (the-as uint 0)
            (the-as uint 0))))

      (set! (-> mesh prim-core collide-as) (collide-kind ground-object))
      (set! (-> mesh collide-with) (collide-kind target))

      (set!
        (-> mesh prim-core action)
        (collide-action solid rider-plat-sticky))

      (set!
        (-> mesh prim-core offense)
        (collide-offense indestructible))

      (set! (-> mesh transform-index) 0)

      ;; Broad-phase bound only. The actual flat pontoon collision comes
      ;; from the collide-mesh stored in the art group's jgeo.
      (set-vector!
        (-> mesh local-sphere)
        0.0
        0.0
        0.0
        18432.0)

      (set-root-prim! shape mesh))

    (set! (-> shape nav-radius) 12288.0)
    (backup-collide-with-as shape)
    (set! (-> self root) shape))

  (none))

(defun swimmer-pontoonten-initialize-collision!
  ((self swimmer-pontoonten))

  ;; Use collision mesh 0 embedded in the loaded pontoon art group.
  ;; initialize-skeleton installs the jgeo; find-collision-meshes resolves
  ;; this primitive's mesh-id against that jgeo afterward.
  (let ((shape
        (new 'process
          'collide-shape
          self
          (collide-list-enum hit-by-player))))

    (let ((mesh
          (new 'process
            'collide-shape-prim-mesh
            shape
            (the-as uint 0)
            (the-as uint 0))))

      (set! (-> mesh prim-core collide-as) (collide-kind ground-object))
      (set! (-> mesh collide-with) (collide-kind target))

      (set!
        (-> mesh prim-core action)
        (collide-action solid rider-plat-sticky))

      (set!
        (-> mesh prim-core offense)
        (collide-offense indestructible))

      (set! (-> mesh transform-index) 0)

      ;; Broad-phase bound only. The actual flat pontoon collision comes
      ;; from the collide-mesh stored in the art group's jgeo.
      (set-vector!
        (-> mesh local-sphere)
        0.0
        0.0
        0.0
        25395.2)

      (set-root-prim! shape mesh))

    (set! (-> shape nav-radius) 20480.0)
    (backup-collide-with-as shape)
    (set! (-> self root) shape))

  (none))

(defstate swimmer-pontoon-die (swimmer-pontoon)
  :code
  (behavior ()
    (cleanup-for-death self)
    (deactivate self)))

(defstate swimmer-pontoon-idle (swimmer-pontoon)
  :event
  (behavior
    ((proc process)
     (argc int)
     (message symbol)
     (block event-message-block))

    (case message
      (('die)
        (go swimmer-pontoon-die))))

  :enter
  (behavior ()
    (cond
      ((= (-> self pontoon-type) 0)
        (ja-no-eval
          :group! pontoonfive-idle-ja
          :num! (seek!)
          :frame-num 0.0))

      (else
        (ja-no-eval
          :group! pontoonten-idle-ja
          :num! (seek!)
          :frame-num 0.0))))

  :code
  (behavior ()
    (loop
      (suspend)
      (ja :num! (seek!))))

  :post ja-post)

(defbehavior swimmer-pontoonfive-init-by-other
  swimmer-pontoonfive
  ((spawn-pos vector)
   (rotation-degrees float))

  (set! (-> self pontoon-type) 0)

  (logior!
    (-> self mask)
    (process-mask platform))

  (logclear!
    (-> self mask)
    (process-mask actor-pause))

  ;; Build collision first so it becomes the drawable root.
  (swimmer-pontoonfive-initialize-collision! self)

  ;; Build the pontoon model directly from the loaded art group.
  (initialize-skeleton
    self
    *swimmer-pontoonfive-sg*
    '())

  ;; Resolve mesh-id 0 from pontoonfive's loaded jgeo collision group.
  (find-collision-meshes (the-as collide-shape (-> self root)))

  (#when PC_PORT
    (set!
      (-> self skel postbind-function)
      process-drawable-joint-callback-pc))

  (set! (-> self root trans quad) (-> spawn-pos quad))
  (set! (-> self root trans w) 1.0)

  (quaternion-axis-angle!
    (-> self root quat)
    0.0
    1.0
    0.0
    (degrees rotation-degrees))

  (vector-identity! (-> self root scale))

  (set! (-> self root pause-adjust-distance) -122880.0)
  (set! (-> self draw force-lod) 0)

  (logclear!
    (-> self draw status)
    (draw-status hidden))

  (transform-post)

  (go swimmer-pontoon-idle))

(defbehavior swimmer-pontoonten-init-by-other
  swimmer-pontoonten
  ((spawn-pos vector)
   (rotation-degrees float))

  (set! (-> self pontoon-type) 1)

  (logior!
    (-> self mask)
    (process-mask platform))

  (logclear!
    (-> self mask)
    (process-mask actor-pause))

  ;; Build collision first so it becomes the drawable root.
  (swimmer-pontoonten-initialize-collision! self)

  ;; Build the pontoon model directly from the loaded art group.
  (initialize-skeleton
    self
    *swimmer-pontoonten-sg*
    '())

  ;; Resolve mesh-id 0 from pontoonten's loaded jgeo collision group.
  (find-collision-meshes (the-as collide-shape (-> self root)))

  (#when PC_PORT
    (set!
      (-> self skel postbind-function)
      process-drawable-joint-callback-pc))

  (set! (-> self root trans quad) (-> spawn-pos quad))
  (set! (-> self root trans w) 1.0)

  (quaternion-axis-angle!
    (-> self root quat)
    0.0
    1.0
    0.0
    (degrees rotation-degrees))

  (vector-identity! (-> self root scale))

  (set! (-> self root pause-adjust-distance) -122880.0)
  (set! (-> self draw force-lod) 0)

  (logclear!
    (-> self draw status)
    (draw-status hidden))

  (transform-post)

  (go swimmer-pontoon-idle))

(defun spawn-pontoon-swimmer
  ((spawn-pos vector)
   (pontoon-type int)
   (rotation-degrees float))

  (cond
    ((= pontoon-type 0)
      (process-spawn
        swimmer-pontoonfive
        spawn-pos
        rotation-degrees
        :name "swimmer-pontoonfive"
        :to *active-pool*))

    ((= pontoon-type 1)
      (process-spawn
        swimmer-pontoonten
        spawn-pos
        rotation-degrees
        :name "swimmer-pontoonten"
        :to *active-pool*))

    (else
      (format
        0
        "spawn-pontoon-swimmer: invalid type ~D; use 0 or 1.~%"
        pontoon-type)))

  (none))

(defun maintain-training-pontoon! ()
  (let ((inside
        (when *level*
          (level-get-target-inside *level*))))

    (cond
      ((and
          inside
          (= (-> inside name) 'training))

        (when
          (not *training-pontoon-spawned?*)

          (spawn-pontoon-swimmer
            (new 'static 'vector
              :x (meters -1330.3963)
              :y (meters 0.3323)
              :z (meters 925.1775)
              :w 1.0)
            0
            0.0)

          (set! *training-pontoon-spawned?* #t)))

      (else
        (set! *training-pontoon-spawned?* #f))))

  (none))

(defun maintain-sentinel-pontoon! ()
  (let ((inside
        (when *level*
          (level-get-target-inside *level*))))

    (cond
      ((and
          inside
          (= (-> inside name) 'beach))

        (when
          (not *sentinel-pontoon-spawned?*)

          (spawn-pontoon-swimmer
            (new 'static 'vector
              :x (meters -291.4279)
              :y (meters 0.4322)
              :z (meters -273.1889)
              :w 1.0)
            0
            157.46)

          (set! *sentinel-pontoon-spawned?* #t)))

      (else
        (set! *sentinel-pontoon-spawned?* #f))))

  (none))

(defun maintain-misty-pontoon! ()
  (let ((inside
        (when *level*
          (level-get-target-inside *level*))))

    (cond
      ((and
          inside
          (= (-> inside name) 'misty))

        (when
          (not *misty-pontoon-spawned?*)

          ;; Misty Island fishing pontoon. The fishing spot, player position,
          ;; camera and playfield vectors will be supplied separately.
          (spawn-pontoon-swimmer
            (new 'static 'vector
              :x (meters 103.0353)
              :y (meters 0.6031)
              :z (meters 990.2777)
              :w 1.0)
            0
            0.0)

          (set! *misty-pontoon-spawned?* #t)))

      (else
        (set! *misty-pontoon-spawned?* #f))))

  (none))

