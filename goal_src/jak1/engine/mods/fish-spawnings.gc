    (dotimes (i grub-count)
      (when (< slot (-> self fish-count))
        (fisher-configure-random-fish-slot!
          self slot (the-as int (fisher-species electric-grubfish)))
        (+! slot 1)))

    (while (< slot (-> self fish-count))
      (fisher-configure-random-fish-slot!
        self slot (the-as int (fisher-species electric-eelfish)))
      (+! slot 1)))

  (none))


