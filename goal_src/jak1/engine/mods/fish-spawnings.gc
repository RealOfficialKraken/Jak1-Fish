    "TUBE POWER CELL!"
    ""

    "HE BE SWIMMIN IN THE DARK ECO"
    "POOLS OF SPIDER CAVE ONLY!"
    "ATTRACTED ONLY AFTER 72"
    "CELLS HAVE BEEN COLLECTED!"

    "ONLY THEN, WILL YE BE ABLE TO CROSS"
    "THE LAVA TUBE"
    ""
    ""))

(define *fisher-man-dialogue-buffer-0*
  (new 'global 'string 256 (the string #f)))

(define *fisher-man-dialogue-buffer-1*
  (new 'global 'string 256 (the string #f)))

(define *fisher-man-dialogue-buffer-2*
  (new 'global 'string 256 (the string #f)))

(define *fisher-man-dialogue-buffer-3*
  (new 'global 'string 256 (the string #f)))

(defun fisher-man-valid-dialogue?
  ((dialogue-type int))

  (and
    (>= dialogue-type 0)
    (< dialogue-type *fisher-man-dialogue-count*)))

(defun fisher-man-select-dialogue!
  ((self fisher-man))

  (cond
    ((= (-> self dialogue-type) 4)
      (set! (-> self dialogue-kind) 9)
      (set! *fisher-man-dialogue-page-count* 4))

    ((= (-> self dialogue-type) 3)
      (set! (-> self dialogue-kind) 8)
      (set! *fisher-man-dialogue-page-count* 4))

    ((= (-> self dialogue-type) 2)
      (set! (-> self dialogue-kind) 7)
      (set! *fisher-man-dialogue-page-count* 2))

    ((= (-> self dialogue-type) 1)
      (let ((old-hint (-> self dialogue-hint-index))
          (new-hint (rand-vu-int-range 0 (- *fisher-man-hint-count* 1))))

        (when
          (and
            (> *fisher-man-hint-count* 1)
            (= new-hint old-hint))

          (+! new-hint 1)

          (when
            (>= new-hint *fisher-man-hint-count*)

            (set! new-hint 0)))

        (set! (-> self dialogue-hint-index) new-hint))

      (set! (-> self dialogue-kind) 4)
      (set! *fisher-man-dialogue-page-count* 1))

    ((not
        (task-closed?
          (game-task fisher-game-tutorial)
          (task-status need-introduction)))

      (set! (-> self dialogue-kind) 0)
      (set! *fisher-man-dialogue-page-count* 6))

    ((task-closed?
        (game-task fisher-game-tutorial-orbs)
        (task-status need-introduction))

      (set! (-> self dialogue-kind) 3)
      (set! *fisher-man-dialogue-page-count* 1))

    ((>=
        (the-as float
          (send-event
            *target*
            'query
            'pickup
            (pickup-type money)))
        10.0)

      (set! (-> self dialogue-kind) 2)
      (set! *fisher-man-dialogue-page-count* 7))

    (else
      (set! (-> self dialogue-kind) 1)
      (set! *fisher-man-dialogue-page-count* 3)))

  (none))

(defun fisher-man-dialogue-line
  ((self fisher-man)
    (line-index int))

  (let ((index
        (+ (* (-> self dialogue-page) 4)
          line-index)))

    (cond
      ((or
          (< (-> self dialogue-page) 0)
          (>= (-> self dialogue-page)
            *fisher-man-dialogue-page-count*)
          (< line-index 0)
          (>= line-index 4))
        "")

      ((= (-> self dialogue-kind) 0)
        (-> *fisher-man-tutorial-dialogue-lines* data index))

      ((= (-> self dialogue-kind) 2)
        (-> *fisher-man-orb-complete-dialogue-lines* data index))

      ((= (-> self dialogue-kind) 3)
        (-> *fisher-man-completed-dialogue-lines* data index))

      ((= (-> self dialogue-kind) 4)
        (->
          *fisher-man-hint-dialogue-lines*
          data
          (+
            (* (-> self dialogue-hint-index) 4)
            line-index)))

      ((= (-> self dialogue-kind) 5)
        (-> *fisher-man-refill-dialogue-lines* data index))

      ((= (-> self dialogue-kind) 6)
        (-> *fisher-man-tutorial-lures-dialogue-lines* data index))

      ((= (-> self dialogue-kind) 7)
        (-> *fisher-man-mountain-pass-dialogue-lines* data index))

      ((= (-> self dialogue-kind) 8)
        (-> *fisher-man-firecanyon-dialogue-lines* data index))

      ((= (-> self dialogue-kind) 9)
        (-> *fisher-man-lavatube-dialogue-lines* data index))

      (else
        (-> *fisher-man-orb-reminder-dialogue-lines* data index)))))

(defun fisher-man-draw-dialogue-text
  ((text string)
    (text-x-pos int)
    (text-y-pos int))

  (clear matt-str)
  (clear *pc-encoded-matt-str*)

  (format matt-str text)

  (pc-encode-utf8-string
    matt-str
    *pc-encoded-matt-str*)

  (with-dma-buffer-add-bucket
    ((buf (-> (current-frame) global-buf))
      (bucket-id subtitle))

    (draw-string-xy-scaled
      *pc-encoded-matt-str*
      buf
      text-x-pos
      text-y-pos
      (font-color white)
      (font-flags large shadow middle kerning)
      0.50))

  (none))

(defun fisher-man-dialogue-total-length
  ((self fisher-man))

  (+
    (length (fisher-man-dialogue-line self 0))
    (length (fisher-man-dialogue-line self 1))
    (length (fisher-man-dialogue-line self 2))
    (length (fisher-man-dialogue-line self 3))))

(defun fisher-man-visible-dialogue-line!
  ((self fisher-man)
    (line-index int)
    (dst string))

  (let* ((line-0
        (fisher-man-dialogue-line
          self
          0))

      (line-1
        (fisher-man-dialogue-line
          self
          1))

      (line-2
        (fisher-man-dialogue-line
          self
          2))

      (line
        (fisher-man-dialogue-line
          self
          line-index))

      (line-start
        (cond
          ((= line-index 0)
            0)

          ((= line-index 1)
            (length line-0))

          ((= line-index 2)
            (+
              (length line-0)
              (length line-1)))

          (else
            (+
              (length line-0)
              (length line-1)
              (length line-2)))))

      (visible-count
        (-
          (-> self dialogue-char-count)
          line-start))

      (line-length
        (length line)))

    (cond
      ((<= visible-count 0)
        (clear dst))

      ((>= visible-count line-length)
        (copy-string<-string dst line))

      (else
        (substring!
          dst
          line
          0
          visible-count)))))

(defun fisher-man-release-jak!
  ((self fisher-man))

  (when
    (and
      (-> self dialogue-grabbed?)
      *target*)

    (process-release? *target*))

  (set!
    (-> self dialogue-grabbed?)
    #f)

  (none))

(defun fisher-man-near-jak?
  ((self fisher-man))

  (and
    *target*
    (<=
      (vector-vector-distance
        (-> self root trans)
        (target-pos 0))
      (meters 8.5))))

(defun fisher-man-draw-small-text
  ((text string)
    (text-x-pos int)
    (text-y-pos int))

  (clear matt-str)
  (clear *pc-encoded-matt-str*)

  (format matt-str text)

  (pc-encode-utf8-string
    matt-str
    *pc-encoded-matt-str*)

  (with-dma-buffer-add-bucket
    ((buf (-> (current-frame) global-buf))
      (bucket-id subtitle))

    (draw-string-xy-scaled
      *pc-encoded-matt-str*
      buf
      text-x-pos
      text-y-pos
      (font-color white)
      (font-flags large middle shadow kerning)
      0.55))

  (none))

(defun fisher-man-draw-dialogue-box!
  ((self fisher-man))

  (with-dma-buffer-add-bucket
    ((buf (-> (current-frame) global-buf))
      (bucket-id subtitle))

    (draw-sprite2d-xy
      buf
      34
      139
      444
      80
      (new 'static 'rgba
        :r #x04
        :g #x08
        :b #x0c
        :a #xe8))

    (draw-sprite2d-xy
      buf
      39
      144
      434
      70
      (new 'static 'rgba
        :r #x14
        :g #x28
        :b #x34
        :a #xd8)))

  (fisher-man-draw-dialogue-text
    (fisher-man-visible-dialogue-line!
      self
      0
      *fisher-man-dialogue-buffer-0*)
    256
    153)

  (fisher-man-draw-dialogue-text
    (fisher-man-visible-dialogue-line!
      self
      1
      *fisher-man-dialogue-buffer-1*)
    256
    168)

  (fisher-man-draw-dialogue-text
    (fisher-man-visible-dialogue-line!
      self
      2
      *fisher-man-dialogue-buffer-2*)
    256
    183)

  (fisher-man-draw-dialogue-text
    (fisher-man-visible-dialogue-line!
      self
      3
      *fisher-man-dialogue-buffer-3*)
    256
    198)

  (fisher-man-draw-small-text
    "<PAD_X>"
    446
    205)

  (fisher-man-draw-small-text
    "<PAD_TRIANGLE> EXIT"
    421
    114)

  (none))

(defun fisher-man-idle-interaction!
  ((self fisher-man))

  (let ((start-dialogue? #f))

    (when
      (and
        (not (paused?))
        (or
          (not *fisher-geologist*)
          (not (-> *fisher-geologist* 0 dialogue-grabbed?)))
        (fisher-man-valid-dialogue?
          (-> self dialogue-type))
        (fisher-man-near-jak? self))

      (fisher-man-draw-small-text
        "PRESS <PAD_CIRCLE> TO TALK."
        356
        170)

      (when
        (cpad-pressed? 0 circle)

        (cpad-clear! 0 circle)
        (set! start-dialogue? #t)))

    start-dialogue?))

(defun fisher-man-initialize-collision!
  ((self fisher-man))

  (let ((shape
        (new 'process
          'collide-shape
          self
          (collide-list-enum hit-by-player))))

    (let ((group
          (new 'process
            'collide-shape-prim-group
            shape
            (the-as uint 2)
            0)))

      (set! (-> group prim-core collide-as) (collide-kind enemy))
      (set! (-> group collide-with) (collide-kind target))
      (set! (-> group prim-core action) (collide-action solid))
      (set! (-> group prim-core offense) (collide-offense indestructible))

      (set-vector!
        (-> group local-sphere)
        6144.0
        0.0
        4096.0
        14336.0)

      (set-root-prim! shape group)

      (let ((body
            (new 'process
              'collide-shape-prim-sphere
              shape
              (the-as uint 0))))

        (set! (-> body prim-core collide-as) (collide-kind enemy))
        (set! (-> body collide-with) (collide-kind target))
        (set! (-> body prim-core action) (collide-action solid))
        (set! (-> body prim-core offense) (collide-offense indestructible))
        (set! (-> body transform-index) 3)

        (set-vector!
          (-> body local-sphere)
          0.0
          0.0
          0.0
          6553.6)

        (append-prim group body))

      (let ((upper
            (new 'process
              'collide-shape-prim-sphere
              shape
              (the-as uint 0))))

        (set! (-> upper prim-core collide-as) (collide-kind enemy))
        (set! (-> upper collide-with) (collide-kind target))
        (set! (-> upper prim-core action) (collide-action solid))
        (set! (-> upper prim-core offense) (collide-offense indestructible))
        (set! (-> upper transform-index) 57)

        (set-vector!
          (-> upper local-sphere)
          0.0
          4096.0
          0.0
          4096.0)

        (append-prim group upper)))

    (set!
      (-> shape nav-radius)
      (* 0.75
        (-> shape root-prim local-sphere w)))

    (backup-collide-with-as shape)

    (set! (-> self root) shape))

  (none))

(defun fisher-man-initialize-taskable!
  ((self fisher-man))

  (stack-size-set! (-> self main-thread) 512)

  (set! (-> self tasks) *fisher-man-tasks*)
  (set! (-> self will-talk) #f)
  (set! (-> self bounce-away) #f)
  (set! (-> self skippable) #f)
  (set! (-> self blend-on-exit) (the-as art-joint-anim #f))
  (set! (-> self camera) (the-as handle #f))
  (set! (-> self cell-x) (the-as handle #f))
  (set! (-> self cell-for-task) (game-task none))

  (set! (-> self center-joint-index) 3)
  (set! (-> self cam-joint-index) 49)
  (set! (-> self neck-joint-index) 33)

  (set! (-> self cur-trans-hook) nothing)
  (set! (-> self been-kicked) #f)

  (set! (-> self sound-flava) (music-flava default))
  (set! (-> self have-flava) #f)
  (set! (-> self music) #f)
  (set! (-> self have-music) #f)

  (ambient-control-method-9 (-> self ambient))

  (none))

(defmethod should-display?
  ((this fisher-man))

  #t)

(defmethod process-taskable-method-38
  ((this fisher-man))

  (none))

(defmethod process-taskable-method-43
  ((this fisher-man))

  #f)

(defbehavior fisher-man-init-by-other fisher-man ((spawn-pos vector) (dialogue-type int) (level-name symbol))

  (set! (-> self dialogue-type) dialogue-type)
  (set! (-> self dialogue-kind) 0)
  (set! (-> self dialogue-page) 0)
  (set! (-> self dialogue-hint-index) -1)
  (set! (-> self level-name) level-name)

  (set! (-> self dialogue-char-count) 0)
  (set! (-> self dialogue-char-timer) 0.0)
  (set! (-> self dialogue-grabbed?) #f)
  (set! (-> self dialogue-release-pending?) #f)
  (set! (-> self shop-offset) 150.0)
  (set! (-> self shop-message-time) 0.0)

  (logclear! (-> self mask) (process-mask actor-pause))

  (fisher-man-initialize-taskable! self)
  (fisher-man-initialize-collision! self)

  (initialize-skeleton
    self
    *fisher-sgc*
    '())

  (logior!
    (-> self skel status)
    (janim-status eye))

  (#when PC_PORT
    (set!
      (-> self skel postbind-function)
      process-drawable-joint-callback-pc))

  (set! (-> self draw origin-joint-index) (the-as uint 3))
  (set! (-> self draw shadow-joint-index) (the-as uint 3))
  (set! (-> self center-joint-index) 3)
  (set! (-> self cam-joint-index) 49)
  (set! (-> self neck-joint-index) 33)
  (set! (-> self draw-bounds-y-offset) (-> self draw bounds y))
  (set! (-> self root pause-adjust-distance) -122880.0)
  (set! (-> self shadow-backup) (-> self draw shadow))

  (logclear!
    (-> self draw status)
    (draw-status hidden))

  (set! (-> self root trans quad) (-> spawn-pos quad))
  (set! (-> self root trans w) 1.0)

  (set! (-> self draw force-lod) 0)

  (ja
    :group! fisher-idle-more-often-ja)

  (transform-post)

  (go idle))

(defstate idle (fisher-man)

  :enter
  (behavior ()
    (when (not (-> self dialogue-release-pending?))
      (fisher-man-release-jak! self)))

  :code
  (behavior ()
    (when (-> self dialogue-release-pending?)
      (when *target*
        (process-grab? *target*))
      (suspend))

    (loop
      (when (-> self dialogue-release-pending?)
        (cond
          ((and *target* (cpad-hold? 0 x))
            (process-grab? *target*))
          (else
            (fisher-man-release-jak! self)
            (set! (-> self dialogue-release-pending?) #f))))
      (when
        (and *level* *target* (= (pause-allowed?) #t) (>= (vector-vector-distance (-> self root trans) (target-pos 0)) (meters 100)) (!= (-> (level-get-target-inside *level*) name) (-> self level-name)))

        (fisher-man-release-jak! self)
        (set! *fisher-man* #f)
        (kill-by-name "fisher-man" *active-pool*)
      )

      (ja-no-eval
        :group! fisher-idle-more-often-ja
        :num! (seek!)
        :frame-num 0.0)

      (until
        (ja-done? 0)

        (when (-> self dialogue-release-pending?)
          (cond
            ((and *target* (cpad-hold? 0 x))
              (process-grab? *target*))
            (else
              (fisher-man-release-jak! self)
              (set! (-> self dialogue-release-pending?) #f))))

        (when
          (fisher-man-idle-interaction! self)

          (go dialogue))

        (suspend)

        (ja
          :num! (seek!)))

      (ja-no-eval
        :group! fisher-idle-less-often-ja
        :num! (seek!)
        :frame-num 0.0)

      (until
        (ja-done? 0)

        (when (-> self dialogue-release-pending?)
          (cond
            ((and *target* (cpad-hold? 0 x))
              (process-grab? *target*))
            (else
              (fisher-man-release-jak! self)
              (set! (-> self dialogue-release-pending?) #f))))

        (when
          (fisher-man-idle-interaction! self)

          (go dialogue))

        (suspend)

        (ja
          :num! (seek!)))))

  :post transform-post)

(defstate dialogue
  (fisher-man)

  :enter
  (behavior ()
    (fisher-man-select-dialogue! self)
    (set! (-> self dialogue-page) 0)
    (set! (-> self dialogue-char-count) 0)
    (set! (-> self dialogue-char-timer) 0.0)
    (set! (-> self dialogue-grabbed?) #f)
    (set! (-> self dialogue-release-pending?) #f)

    (when *target*
      (process-grab? *target*)
      (set! (-> self dialogue-grabbed?) #t))

    (ja-no-eval
      :group! fisher-idle-more-often-ja
      :num! (seek!)
      :frame-num 0.0))

  :exit
  (behavior ()
    (cond
      ((-> self dialogue-release-pending?)
        (when *target*
          (process-grab? *target*)))
      (else
        (fisher-man-release-jak! self))))

  :code
  (behavior ()
    (loop
      (when
        (and
          *level*
          *target*
          (= (pause-allowed?) #t)
          (!=
            (-> (level-get-target-inside *level*) name)
            (-> self level-name))
          (>=
            (vector-vector-distance
              (-> self root trans)
              (target-pos 0))
            (meters 100)))

        (fisher-man-release-jak! self)
        (set! *fisher-man* #f)
        (kill-by-name "fisher-man" *active-pool*))

      (fisher-man-draw-dialogue-box! self)

      (+!
        (-> self dialogue-char-timer)
        (-> *display* seconds-per-frame))

      (while
        (and
          (>= (-> self dialogue-char-timer) 0.025)
          (<
            (-> self dialogue-char-count)
            (fisher-man-dialogue-total-length self)))

        (-! (-> self dialogue-char-timer) 0.025)
        (+! (-> self dialogue-char-count) 1))
      (when
        (cpad-pressed? 0 x)

        (cpad-clear! 0 x)

        (cond
          ((<
              (-> self dialogue-char-count)
              (fisher-man-dialogue-total-length self))

            (set!
              (-> self dialogue-char-count)
              (fisher-man-dialogue-total-length self))

            (set! (-> self dialogue-char-timer) 0.0))

          ((<
              (-> self dialogue-page)
              (- *fisher-man-dialogue-page-count* 1))

            (+! (-> self dialogue-page) 1)
            (set! (-> self dialogue-char-count) 0)
            (set! (-> self dialogue-char-timer) 0.0))

          ((= (-> self dialogue-kind) 0)
            (close-specific-task!
              (game-task fisher-game-tutorial)
              (task-status need-introduction))

            (auto-save-command
              'auto-save
              0
              0
              *default-pool*)

            (fisher-refill-lures!)
            (set! (-> self dialogue-kind) 6)
            (set! *fisher-man-dialogue-page-count* 2)
            (set! (-> self dialogue-page) 0)
            (set! (-> self dialogue-char-count) 0)
            (set! (-> self dialogue-char-timer) 0.0))

          ((= (-> self dialogue-kind) 2)
            (send-event
              *target*
              'get-pickup
              (pickup-type money)
              -10.0)

            (dotimes (buzzer-index 7)
              (when
                (not
                  (got-buzzer?
                    *game-info*
                    (game-task training-buzzer)
                    buzzer-index))

                (send-event
                  *target*
                  'get-pickup
                  (pickup-type buzzer)
                  (the float
                    (logior
                      (the int (game-task training-buzzer))
                      (ash buzzer-index 16))))

                (runs-on-fly-pickup)))

            (send-event
              *target*
              'get-pickup
              (pickup-type fuel-cell)
              (the float (game-task training-gimmie)))

            (send-event
              *target*
              'get-pickup
              (pickup-type fuel-cell)
              (the float (game-task training-door)))

            (send-event
              *target*
              'get-pickup
              (pickup-type fuel-cell)
              (the float (game-task training-climb)))

            (send-event
              *target*
              'get-pickup
              (pickup-type fuel-cell)
              (the float (game-task training-buzzer)))

            (close-specific-task!
              (game-task fisher-game-tutorial-orbs)
              (task-status need-introduction))

            (auto-save-command
              'auto-save
              0
              0
              *default-pool*)

            (fisher-refill-lures!)
            (set! (-> self dialogue-kind) 5)
            (set! *fisher-man-dialogue-page-count* 1)
            (set! (-> self dialogue-page) 0)
            (set! (-> self dialogue-char-count) 0)
            (set! (-> self dialogue-char-timer) 0.0))

          ((or
              (= (-> self dialogue-kind) 5)
              (= (-> self dialogue-kind) 6)
              (= (-> self dialogue-kind) 7)
              (= (-> self dialogue-kind) 8)
              (= (-> self dialogue-kind) 9))
            (set! (-> self dialogue-release-pending?) #t)
            (go idle))

          (else
            (fisher-refill-lures!)
            (set! (-> self dialogue-kind) 5)
            (set! *fisher-man-dialogue-page-count* 1)
            (set! (-> self dialogue-page) 0)
            (set! (-> self dialogue-char-count) 0)
            (set! (-> self dialogue-char-timer) 0.0))))

      (when
        (cpad-pressed? 0 triangle)

        (cpad-clear! 0 triangle)
        (set! (-> self dialogue-release-pending?) #t)
        (go idle))

      (suspend)

      (ja
        :num! (seek!))))

  :post transform-post)


(defun spawn-fisher-man
  ((spawn-pos vector)
    (dialogue-type int)
    (level-name symbol))

  (when *fisher-man*
    (set! *fisher-man* #f)
    (kill-by-name "fisher-man" *active-pool*)
  )

  (set!
    *fisher-man*
    (process-spawn
      fisher-man
      spawn-pos
      dialogue-type
      level-name
      :name "fisher-man"
      :to *active-pool*))

  (none))

(defun kill-fisher-man ()
  (when
    (and
      *fisher-man*
      (-> *fisher-man* 0 dialogue-grabbed?))

    (process-release? *target*))

  (when *fisher-man*
    (kill-by-name "fisher-man" *active-pool*))

  (set! *fisher-man* #f)

  (none))

(define *fisher-geologist-bg-color* (new 'static 'rgba :r #x00 :g #x00 :b #x00 :a #xff))

(define *fisher-catalog-world-preview-active?* #f)

(define *fisher-catalog-hud-unit-scale* 0.14)
(define *fisher-catalog-hud-fit-scale* 1.0)
(define *fisher-catalog-attachment-spawn-scale* 1.0)

(define *fisher-geologist-dialogue-buffer-0*
  (new 'global 'string 256 (the string #f)))

(define *fisher-geologist-dialogue-buffer-1*
  (new 'global 'string 256 (the string #f)))

(define *fisher-geologist-dialogue-buffer-2*
  (new 'global 'string 256 (the string #f)))

(define *fisher-geologist-dialogue-buffer-3*
  (new 'global 'string 256 (the string #f)))

(defun fisher-geologist-dialogue-line
  ((self fisher-geologist)
    (line-index int))
  (cond
    ((or (< line-index 0) (>= line-index 4))
      "")
    ((task-closed?
        (game-task fisher-geologist-intro)
        (task-status need-introduction))
      (cond
        ((or (< (-> self dialogue-page) 0) (>= (-> self dialogue-page) 6))
          "")
        (else
          (->
            *fisher-geologist-repeat-dialogue-lines*
            data
            (+ (* (-> self dialogue-page) 4) line-index)))))
    ((or (< (-> self dialogue-page) 0) (>= (-> self dialogue-page) 4))
      "")
    (else
      (->
        *fisher-geologist-dialogue-lines*
        data
        (+ (* (-> self dialogue-page) 4) line-index)))))

(defun fisher-geologist-dialogue-total-length
  ((self fisher-geologist))
  (+
    (length (fisher-geologist-dialogue-line self 0))
    (length (fisher-geologist-dialogue-line self 1))
    (length (fisher-geologist-dialogue-line self 2))
    (length (fisher-geologist-dialogue-line self 3))))

(defun fisher-geologist-visible-dialogue-line!
  ((self fisher-geologist)
    (line-index int)
    (dst string))
  (let* ((line-0 (fisher-geologist-dialogue-line self 0))
      (line-1 (fisher-geologist-dialogue-line self 1))
      (line-2 (fisher-geologist-dialogue-line self 2))
      (line (fisher-geologist-dialogue-line self line-index))
      (line-start
        (cond
          ((= line-index 0) 0)
          ((= line-index 1) (length line-0))
          ((= line-index 2) (+ (length line-0) (length line-1)))
          (else (+ (length line-0) (length line-1) (length line-2)))))
      (visible-count (- (-> self dialogue-char-count) line-start))
      (line-length (length line)))
    (cond
      ((<= visible-count 0)
        (clear dst))
      ((>= visible-count line-length)
        (copy-string<-string dst line))
      (else
        (substring! dst line 0 visible-count)))))

(defun fisher-catalog-task-for-row ((row int))
  (the-as game-task
    (cond
      ((< row 24) (+ 120 row))
      (else (+ 144 (- row 24))))))

(defun fisher-catalog-status-for-prefix ((prefix int))
  (cond
    ((= prefix 0) (task-status unknown))
    ((= prefix 1) (task-status need-hint))
    ((= prefix 2) (task-status need-introduction))
    ((= prefix 3) (task-status need-reminder-a))
    ((= prefix 4) (task-status need-reminder))
    ((= prefix 5) (task-status need-reward-speech))
    (else (task-status need-resolution))))

(defun fisher-catalog-gatekeeper-star-for-task ((task int))
  (cond
    ((= task (the-as int (game-task firecanyon-end))) 0)
    ((= task (the-as int (game-task ogre-end))) 1)
    ((= task (the-as int (game-task ogre-buzzer))) 2)
    ((= task (the-as int (game-task lavatube-end))) 3)
    ((= task (the-as int (game-task lavatube-buzzer))) 4)
    ((= task (the-as int (game-task citadel-buzzer))) 5)
    (else -1)))

(defun fisher-catalog-gatekeeper-task-for-star ((star int))
  (cond
    ((= star 0) (game-task firecanyon-end))
    ((= star 1) (game-task ogre-end))
    ((= star 2) (game-task ogre-buzzer))
    ((= star 3) (game-task lavatube-end))
    ((= star 4) (game-task lavatube-buzzer))
    ((= star 5) (game-task citadel-buzzer))
    (else (game-task none))))

(defun fisher-catalog-gatekeeper-star-caught? ((star int))
  (let ((reward-task (fisher-catalog-gatekeeper-task-for-star star)))
    (or
      *fisher-in-debug?*
      (and
        (> (the int reward-task) 1)
        (task-complete? *game-info* reward-task))
      (and
        (> star 0)
        (< star 6)
        (task-closed?
          (game-task catalog-fire-canyon-cell-shark)
          (fisher-catalog-status-for-prefix star))))))

(defun fisher-catalog-register-gatekeeper-catch! ((reward-task int))
  (let ((star (fisher-catalog-gatekeeper-star-for-task reward-task)))
    (when (>= star 0)
      (let ((status (fisher-catalog-status-for-prefix star)))
        (when
          (not
            (task-closed?
              (game-task catalog-fire-canyon-cell-shark)
              status))
          (close-specific-task!
            (game-task catalog-fire-canyon-cell-shark)
            status)
          (auto-save-command 'auto-save 0 0 *default-pool*)))))
  (none))

(defun fisher-catalog-base-unique? ((species int))
  (or
    (= species 4)
    (= species (the-as int (fisher-species magma-serpent)))
    (= species 22)
    (= species 23)))

(defun fisher-catalog-row-unique? ((row int))
  (or
    (>= row 24)
    (fisher-catalog-base-unique? row)))

(defun fisher-catalog-register-catch! ((species int) (suffix int))
  (cond
    ((= species (the-as int (fisher-species fire-canyon-cellfish)))
      (none))
    ((fisher-catalog-base-unique? species)
      (let ((task (the-as game-task (+ 120 species))))
        (when (not (task-closed? task (task-status unknown)))
          (close-specific-task! task (task-status unknown))
          (auto-save-command 'auto-save 0 0 *default-pool*))))
    ((fisher-rare-fish? suffix)
      (let ((task (the-as game-task (+ 144 (- suffix 7)))))
        (when (not (task-closed? task (task-status unknown)))
          (close-specific-task! task (task-status unknown))
          (auto-save-command 'auto-save 0 0 *default-pool*))))
    ((and (>= suffix 0) (<= suffix 6))
      (let ((task (the-as game-task (+ 120 species)))
          (status (fisher-catalog-status-for-prefix suffix)))
        (when (not (task-closed? task status))
          (close-specific-task! task status)
          (auto-save-command 'auto-save 0 0 *default-pool*)))))
  (none))

(defun fisher-catalog-prefix-caught? ((row int) (prefix int))
  (cond
    ((= row (the-as int (fisher-species fire-canyon-cellfish)))
      (fisher-catalog-gatekeeper-star-caught? prefix))
    (else
      (or
        *fisher-in-debug?*
        (and
          (not (fisher-catalog-row-unique? row))
          (task-closed?
            (fisher-catalog-task-for-row row)
            (fisher-catalog-status-for-prefix prefix)))))))

(defun fisher-catalog-row-discovered? ((row int))
  (if *fisher-in-debug?*
    #t
    (cond
      ((= row (the-as int (fisher-species fire-canyon-cellfish)))
        (let ((found? #f))
          (dotimes (star 6)
            (when (fisher-catalog-gatekeeper-star-caught? star)
              (set! found? #t)))
          found?))
      ((fisher-catalog-row-unique? row)
        (task-closed?
          (fisher-catalog-task-for-row row)
          (task-status unknown)))
      (else
        (let ((found? #f))
          (dotimes (prefix 7)
            (when (fisher-catalog-prefix-caught? row prefix)
              (set! found? #t)))
          found?)))))

(defun fisher-catalog-prefix-count ((row int))
  (let ((count 0))
    (cond
      ((= row (the-as int (fisher-species fire-canyon-cellfish)))
        (dotimes (star 6)
          (when (fisher-catalog-gatekeeper-star-caught? star)
            (+! count 1))))
      ((not (fisher-catalog-row-unique? row))
        (dotimes (prefix 7)
          (when (fisher-catalog-prefix-caught? row prefix)
            (+! count 1)))))
    count))

(defun fisher-catalog-discovered-count ()
  (let ((count 0))
    (dotimes (row *fisher-catalog-row-count*)
      (when (fisher-catalog-row-discovered? row)
        (+! count 1)))
    count))

(defun fisher-catalog-row-name ((row int))
  (cond
    ((= row (the-as int (fisher-species fire-canyon-cellfish)))
      "GATEKEEPER CELL SHARK")
    ((< row 24)
      (-> (fisher-species-info-for row) name))
    ((= row 24) "PRECURSOR FISH")
    ((= row 25) "FORGOTTEN FISH")
    ((= row 26) "FRICKED UP FISH")
    ((= row 27) "PRECURSOR ORB-HUNTER")
    ((= row 28) "ARCHIPELAGOLDFISH")
    ((= row 29) "SPEC OPS FISH")
    ((= row 30) "COMPLICATED FISH")
    ((= row 31) "L TETROMINO FISH")
    ((= row 32) "PLATFORMIUS")
    (else "SCREAMING FISH")))

(defun fisher-catalog-row-location ((row int))
  (cond
    ((or (= row 0) (= row 1) (= row 3) (= row 24)) "ANY HUB 1 AREA")
    ((or (= row 2) (= row 25)) "FORBIDDEN JUNGLE")
    ((= row 26) "SENTINEL BEACH")
    ((or (= row 5) (= row 27)) "MISTY ISLAND")
    ((= row 4) "ANY FISHING AREA")
    ((or (= row 6) (= row 7) (= row 8) (= row 9) (= row 28)) "ANY HUB 2 AREA")
    ((= row 29) "LOST PRECURSOR CITY")
    ((or (= row 10) (= row 11) (= row 12) (= row 30)) "BOGGY SWAMP")
    ((or (= row 13) (= row 14) (= row 15) (= row 31)) "VOLCANIC CRATER")
    ((or (= row 16) (= row 17) (= row 18) (= row 32)) "SNOWY MOUNTAIN")
    ((or (= row 19) (= row 20) (= row 21) (= row 22) (= row 33)) "SPIDER CAVE")
    (else "???")))

(defun fisher-catalog-row-zone ((row int))
  (cond
    ((or (= row 0) (= row 1) (= row 24))
      (the-as int (fisher-zone sandover-dock)))
    ((or (= row 2) (= row 3) (= row 25))
      (the-as int (fisher-zone jungle-pillar)))
    ((= row 26)
      (the-as int (fisher-zone sentinel-pontoon)))
    ((or (= row 5) (= row 27))
      (the-as int (fisher-zone misty-island)))
    ((= row 4)
      (the-as int (fisher-zone sandover-dock)))
    ((or (= row 6) (= row 7) (= row 8) (= row 9) (= row 28))
      (the-as int (fisher-zone village2-electric)))
    ((= row 29)
      (the-as int (fisher-zone sunken-voltage)))
    ((or (= row 10) (= row 11) (= row 12) (= row 30))
      (the-as int (fisher-zone swamp-sludge)))
    ((or (= row 13) (= row 14) (= row 15) (= row 31))
      (the-as int (fisher-zone village3-lava)))
    ((or (= row 16) (= row 17) (= row 18) (= row 32))
      (the-as int (fisher-zone snow-ice)))
    ((or (= row 19) (= row 20) (= row 21) (= row 22) (= row 33))
      (the-as int (fisher-zone maincave-dark-eco)))
    (else
      (the-as int (fisher-zone finalboss-nuclear)))))

(defun fisher-catalog-row-suffix ((row int))
  (if (>= row 24)
    (+ 7 (- row 24))
    -1))

(defun fisher-catalog-row-species ((row int))
  (cond
    ((< row 24) row)
    ((or (= row 24) (= row 28) (= row 31) (= row 32) (= row 33)) 1)
    (else 0)))

(defun fisher-catalog-row-skeleton ((row int))
  (let* ((species (fisher-catalog-row-species row))
      (row-suffix (fisher-catalog-row-suffix row))
      (suffix (if (< row-suffix 0) 2 row-suffix)))
    (fisher-display-skeleton-for species suffix)))

(defun fisher-catalog-background-color! ((row int) (dst rgba))
  (cond
    ((or (= row 0) (= row 1) (= row 24))
      (set! (-> dst r) 58) (set! (-> dst g) 126) (set! (-> dst b) 154))
    ((or (= row 2) (= row 3) (= row 25))
      (set! (-> dst r) 48) (set! (-> dst g) 105) (set! (-> dst b) 72))
    ((= row 26)
      (set! (-> dst r) 74) (set! (-> dst g) 145) (set! (-> dst b) 176))
    ((or (= row 5) (= row 27))
      (set! (-> dst r) 43) (set! (-> dst g) 88) (set! (-> dst b) 76))
    ((= row 4)
      (set! (-> dst r) 66) (set! (-> dst g) 112) (set! (-> dst b) 128))
    ((or (= row 6) (= row 7) (= row 8) (= row 9) (= row 28))
      (set! (-> dst r) 32) (set! (-> dst g) 103) (set! (-> dst b) 120))
    ((= row 29)
      (set! (-> dst r) 92) (set! (-> dst g) 151) (set! (-> dst b) 126))
    ((or (= row 10) (= row 11) (= row 12) (= row 30))
      (set! (-> dst r) 71) (set! (-> dst g) 91) (set! (-> dst b) 45))
    ((or (= row 13) (= row 14) (= row 15) (= row 31))
      (set! (-> dst r) 151) (set! (-> dst g) 61) (set! (-> dst b) 24))
    ((or (= row 16) (= row 17) (= row 18) (= row 32))
      (set! (-> dst r) 166) (set! (-> dst g) 201) (set! (-> dst b) 219))
    ((or (= row 19) (= row 20) (= row 21) (= row 22) (= row 33))
      (set! (-> dst r) 54) (set! (-> dst g) 48) (set! (-> dst b) 80))
    (else
      (set! (-> dst r) 126) (set! (-> dst g) 45) (set! (-> dst b) 24)))
  (set! (-> dst a) #x38)
  dst)

(defun fisher-catalog-lore-line ((row int) (line int))
  (cond
    ((= row 23)
      (cond
        ((= line 0) "THIS HERE FISH IS ONE OF A KIND!")
        ((= line 1) "BE CAREFUL THOUGH, IT CAN START TICKING")
        ((= line 2) "AT ANY MOMENT!")
        (else "")))
    ((= row 24)
      (cond
        ((= line 0) "THIS BAD BOY CAN MAKE A GROWN FISHERMAN CRY.")
        ((= line 1) "YE THOUGHT THE PRECURSORS DIDN'T WORK THEIR MAGIC")
        ((= line 2) "ACROSS THE FISH, DID YE? THIS HERE FISH WAS ONCE")
        ((= line 3) "SAID TO LEAD THE PRECURSORS TO THE LOCATION OF")
        ((= line 4) "BUILDING AN ANCIENT PRECURSOR CITY THAT IS LOST")
        ((= line 5) "TO TIME ITSELF! GOOD CATCH LAD!")
        (else "")))
    ((= row 25)
      (cond
        ((= line 0) "THIS FISH LIVES IN THE CRYSTAL CAVES FOUND BY")
        ((= line 1) "KUITAR FROM THE FORGOTTEN LANDS.")
        ((= line 2) "HOW DID IT SWIM ALL THE WAY OVER HERE?")
        (else "")))
    ((= row 26)
      (cond
        ((= line 0) "AVAST! YE---WHAT? WHAT THE FRICK IS THIS FISH?")
        ((= line 1) "DID ZED DESTROY MY MOD?")
        (else "")))
    ((= row 27)
      (cond
        ((= line 0) "YE BEST MAKE SURE TO SELL THAT FISH BEFORE BARG")
        ((= line 1) "HIDES IT AGAIN!")
        (else "")))
    ((= row 28)
      (cond
        ((= line 0) "THIS FISH BE FROM ANOTHER DIMENSION!")
        ((= line 1) "MARKUS HAS BEEN BUSY...")
        (else "")))
    ((= row 29)
      (cond
        ((= line 0) "DON'T TURN YOUR BACK ON THIS FISH!")
        ((= line 1) "IT'LL SNEAK UP ON YE. I KNOW IT NOT BE POSSIBLE,")
        ((= line 2) "BUT RUH WOULD WANT TO HAVE THIS FISH.")
        (else "")))
    ((= row 30)
      (cond
        ((= line 0) "IF YE DON'T CATCH THIS FISH FAST ENOUGH,")
        ((= line 1) "YE MAY BE PUNISHED. MIKE, CRASH THE GAME, PLEASE.")
        (else "")))
    ((= row 31)
      (cond
        ((= line 0) "GRATEFUL FOREST SAYS")
        ((= line 1) "WHERE DOES THE L TETROMINO FISH GO? THATS RIGHT!")
        ((= line 2) "IT GOES IN THE SQUARE HOLE!")
        (else "")))
    ((= row 32)
      (cond
        ((= line 0) "THIS HERE FISH STOLE A BUNCH OF PLATFORMS FROM")
        ((= line 1) "GRATEFUL FOREST, AND PUT IT ON ITS HEAD! MAYBE")
        ((= line 2) "IT CAN HELP YE GET TO THE TOP... ON SECOND THOUGHT,")
        ((= line 3) "MAYBE JUST SELL THIS FISH.")
        (else "")))
    ((= row 33)
      (cond
        ((= line 0) "THIS FISH BE NORMAL, EXCEPT IT HAS BEEN POUNDED")
        ((= line 1) "LIKE ONE TENDERIZES A YAKOW STEAK! YE BEST BE")
        ((= line 2) "PUTTIN THIS FISH OUT OF ITS MISERY, LAD.")
        (else "")))
    (else "")))

(defun fisher-geologist-draw-text
  ((text string) (x int) (y int) (scale float) (selected? symbol) (middle? symbol))
  (clear matt-str)
  (clear *pc-encoded-matt-str*)
  (format matt-str text)
  (pc-encode-utf8-string matt-str *pc-encoded-matt-str*)
  (with-dma-buffer-add-bucket
    ((buf (-> (current-frame) global-buf))
      (bucket-id subtitle))
    (cond
      (middle?
        (draw-string-xy-scaled
          *pc-encoded-matt-str*
          buf
          x
          y
          (if selected? (font-color red) (font-color white))
          (font-flags large middle shadow kerning)
          scale))
      (else
        (draw-string-xy-scaled
          *pc-encoded-matt-str*
          buf
          x
          y
          (if selected? (font-color red) (font-color white))
          (font-flags large shadow kerning)
          scale))))
  (none))

