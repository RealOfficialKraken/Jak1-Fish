;;-*-Lisp-*-
(in-package goal)
(bundles "JUN.DGO")

;;name: fish-spawnings.gc

(defskelgroup *swimmer-pontoonfive-sg*
  pontoonfive
  pontoonfive-lod0-jg
  pontoonfive-idle-ja
  ((pontoonfive-lod0-mg (meters 20))
    (pontoonfive-lod1-mg (meters 40))
    (pontoonfive-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 5)
  :longest-edge (meters 3.5))

(defskelgroup *swimmer-pontoonten-sg*
  pontoonten
  pontoonten-lod0-jg
  pontoonten-idle-ja
  ((pontoonten-lod0-mg (meters 20))
    (pontoonten-lod1-mg (meters 40))
    (pontoonten-lod2-mg (meters 999999)))
  :bounds (static-spherem 0 0 0 7)
  :longest-edge (meters 4))


(defun fisher-playfield-far-distance ((self fisher-game))
  (cond
    ((= (-> self location-id) (the-as int (fisher-zone sunken-voltage)))
      *fisher-sunken-far-distance*)
    ((= (-> self location-id) (the-as int (fisher-zone snow-ice)))
      (meters 70.6917))
    ((= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
      (meters 58.9957))
    ((= (-> self location-id) (the-as int (fisher-zone finalboss-nuclear)))
      (meters 25.4736))
    (else (meters 55.5))))

(defun fisher-playfield-max-depth ((self fisher-game))
  (cond
    ((= (-> self location-id) (the-as int (fisher-zone sunken-voltage)))
      *fisher-sunken-max-depth*)
    ((= (-> self location-id) (the-as int (fisher-zone snow-ice)))
      (meters 19.6246))
    ((= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
      (meters 34.5113))
    ((= (-> self location-id) (the-as int (fisher-zone finalboss-nuclear)))
      *fisher-finalboss-water-depth*)
    (else (meters 36.0))))

(defun fisher-set-zone-species-range!
  ((zone fisher-zone-info)
   (index int)
   (species fisher-species)
   (normal-min int)
   (normal-max int)
   (golden-min int)
   (golden-max int))

  (set! (-> zone species index) (the-as int species))
  (set! (-> zone normal-min index) normal-min)
  (set! (-> zone normal-max index) normal-max)
  (set! (-> zone golden-min index) golden-min)
  (set! (-> zone golden-max index) golden-max)
  (none))

;;macro'd because its more than 13 parameters (my first macro whaaat)

(defmacro fisher-set-species-info!
  (info
   name
   skeleton
   min-weight-tenths
   max-weight-tenths
   orb-value-multiplier
   catch-scale
   game-scale
   color-r
   color-g
   color-b
   depth-min
   depth-max)

  `(begin
    (set! (-> ,info name) ,name)
    (set! (-> ,info skeleton) ,skeleton)
    (set! (-> ,info min-weight-tenths) ,min-weight-tenths)
    (set! (-> ,info max-weight-tenths) ,max-weight-tenths)
    (set! (-> ,info orb-value-multiplier) ,orb-value-multiplier)
    (set! (-> ,info catch-scale) ,catch-scale)
    (set! (-> ,info game-scale) ,game-scale)
    (set! (-> ,info color-r) ,color-r)
    (set! (-> ,info color-g) ,color-g)
    (set! (-> ,info color-b) ,color-b)
    (set! (-> ,info depth-min) ,depth-min)
    (set! (-> ,info depth-max) ,depth-max)
    (none)))

(defun fisher-set-normal-fight-info! ((info fisher-species-info))
  (set! (-> info fight-chance) 0.25)
  (set! (-> info fight-mode) 0)
  (set! (-> info fight-pull-speed) (meters 1.35))
  (set! (-> info fight-recover-min) 0.75)
  (set! (-> info fight-recover-max) 1.50)
  (set! (-> info button-count-min) 0)
  (set! (-> info button-count-max) 0)
  (set! (-> info button-launch-min) 0.0)
  (set! (-> info button-launch-max) 0.0)
  (set! (-> info button-rise-speed) 0.0)
  (set! (-> info button-gravity) 0.0)
  (set! (-> info button-damage-scale) 1.0)
  (set! (-> info button-miss-scale) 1.0)
  (set! (-> info snap-on-bite?) #f)
  (none))

(defmacro fisher-set-button-fight-info!
  (info
   pull-speed
   recover-min
   recover-max
   fight-chance
   button-count-min
   button-count-max
   button-launch-min
   button-launch-max
   button-rise-speed
   button-gravity
   button-damage-scale
   button-miss-scale)

  `(begin
    (set! (-> ,info fight-mode) 1)
    (set! (-> ,info fight-pull-speed) ,pull-speed)
    (set! (-> ,info fight-recover-min) ,recover-min)
    (set! (-> ,info fight-recover-max) ,recover-max)
    (set! (-> ,info fight-chance) ,fight-chance)
    (set! (-> ,info button-count-min) ,button-count-min)
    (set! (-> ,info button-count-max) ,button-count-max)
    (set! (-> ,info button-launch-min) ,button-launch-min)
    (set! (-> ,info button-launch-max) ,button-launch-max)
    (set! (-> ,info button-rise-speed) ,button-rise-speed)
    (set! (-> ,info button-gravity) ,button-gravity)
    (set! (-> ,info button-damage-scale) ,button-damage-scale)
    (set! (-> ,info button-miss-scale) ,button-miss-scale)
    (none)))

(defun fisher-set-zone-info!
  ((info fisher-zone-info)
   (level-min int)
   (level-max int)
   (normal-fish-count-min int)
   (normal-fish-count-max int)
   (golden-fish-count-min int)
   (golden-fish-count-max int)
   (shark-chance float))

  (set! (-> info level-min) level-min)
  (set! (-> info level-max) level-max)
  (set! (-> info normal-fish-count-min) normal-fish-count-min)
  (set! (-> info normal-fish-count-max) normal-fish-count-max)
  (set! (-> info golden-fish-count-min) golden-fish-count-min)
  (set! (-> info golden-fish-count-max) golden-fish-count-max)
  (set! (-> info shark-chance) shark-chance)
  (none))

