(defun fisher-geologist-draw-star! ((x int) (y int) (filled? symbol))
  (with-dma-buffer-add-bucket
    ((buf (-> (current-frame) global-buf))
      (bucket-id sprite))
    (let ((color
          (if filled?
            (new 'static 'rgba :r #xf0 :g #x90 :b #x20 :a #xff)
            (new 'static 'rgba :r #x78 :g #x58 :b #x38 :a #xe8))))
      (draw-sprite2d-xy buf (+ x 6) y 1 1 color)
      (draw-sprite2d-xy buf (+ x 5) (+ y 1) 3 2 color)
      (draw-sprite2d-xy buf (+ x 4) (+ y 3) 5 1 color)
      (draw-sprite2d-xy buf x (+ y 4) 13 1 color)
      (draw-sprite2d-xy buf (+ x 1) (+ y 5) 11 1 color)
      (draw-sprite2d-xy buf (+ x 2) (+ y 6) 9 1 color)
      (draw-sprite2d-xy buf (+ x 3) (+ y 7) 7 1 color)
      (draw-sprite2d-xy buf (+ x 2) (+ y 8) 4 1 color)
      (draw-sprite2d-xy buf (+ x 7) (+ y 8) 4 1 color)
      (draw-sprite2d-xy buf (+ x 1) (+ y 9) 4 1 color)
      (draw-sprite2d-xy buf (+ x 8) (+ y 9) 4 1 color)
      (draw-sprite2d-xy buf x (+ y 10) 4 1 color)
      (draw-sprite2d-xy buf (+ x 9) (+ y 10) 4 1 color)))
  (none))

(defun fisher-geologist-draw-dialogue! ((self fisher-geologist))
  (with-dma-buffer-add-bucket
    ((buf (-> (current-frame) global-buf))
      (bucket-id subtitle))
    (draw-sprite2d-xy
      buf 34 139 444 80
      (new 'static 'rgba :r #x08 :g #x08 :b #x08 :a #xee))
    (draw-sprite2d-xy
      buf 39 144 434 70
      (new 'static 'rgba :r #x48 :g #x28 :b #x10 :a #xe8)))
  (fisher-geologist-draw-text
    (fisher-geologist-visible-dialogue-line! self 0 *fisher-geologist-dialogue-buffer-0*)
    256 153 0.50 #f #t)
  (fisher-geologist-draw-text
    (fisher-geologist-visible-dialogue-line! self 1 *fisher-geologist-dialogue-buffer-1*)
    256 168 0.50 #f #t)
  (fisher-geologist-draw-text
    (fisher-geologist-visible-dialogue-line! self 2 *fisher-geologist-dialogue-buffer-2*)
    256 183 0.50 #f #t)
  (fisher-geologist-draw-text
    (fisher-geologist-visible-dialogue-line! self 3 *fisher-geologist-dialogue-buffer-3*)
    256 198 0.50 #f #t)
  (fisher-geologist-draw-text "<PAD_X>" 446 205 0.55 #f #t)
  (fisher-geologist-draw-text "<PAD_TRIANGLE> EXIT" 421 114 0.55 #f #t)
  (none))


(defun fisher-draw-bones-catalog-hud-merc!
  ((draw draw-control) (dma-buf dma-buffer))
  (local-vars
    (at-2 int)
    (t2-10 vu-lights)
    (t3-3 uint128)
    (t3-4 uint128)
    (t3-5 uint128)
    (t3-6 uint128))

  (let ((buf dma-buf))
    (let* ((dma-start (-> buf base))
        (joints (+ (-> draw mgeo num-joints) 3))
        (bone-calc (the bone-calculation (&+ dma-start 16)))
        (bone-calc-size (* joints 128))
        (mat-data (the object (&+ dma-start 64)))
        (spr-work (scratchpad-object terrain-context)))

      (let ((mat-aligned (logand (the int mat-data) 48)))
        (when (nonzero? mat-aligned)
          (set! mat-data
            (&- (&+ (the pointer mat-data) 64) (the uint mat-aligned)))))

      (let ((regs (scratchpad-object bone-regs :offset 240)))
        (set! (-> regs joint-ptr)
          (the (inline-array joint) (-> draw jgeo data 0)))
        (set! (-> regs bone-ptr) (-> draw skeleton bones))
        (set! (-> regs num-bones) joints))

      (let ((t2-0 mat-data)
          (bone-mem (scratchpad-object bone-memory :offset 16))
          (bone-list *bone-calculation-list*)
          (t1-6 bone-calc))
        (let ((t4-0 (-> bone-mem work regs joint-ptr))
            (t5-0 (-> bone-mem work regs bone-ptr))
            (t6-1 (-> bone-mem work regs num-bones))
            (t7-0 t1-6))
          (set! (-> t7-0 flags) (bone-calc-flags bncfl01))
          (set! (-> t7-0 num-bones) t6-1)
          (set! (-> t7-0 matrix-area) (the (inline-array matrix) t2-0))
          (set! (-> t7-0 joints) t4-0)
          (set! (-> t7-0 bones) t5-0)
          (set! (-> t7-0 next) (the bone-calculation 0)))
        (when (nonzero? (-> bone-list next))
          (set! (-> bone-list next next) t1-6))
        (when (zero? (-> bone-list first))
          (set! (-> bone-list first) t1-6))
        (set! (-> bone-list next) t1-6))

      (&+ (the pointer bone-calc) 48)

      (let ((a2-2 (the object (+ (the uint mat-data) bone-calc-size))))
        (set!
          (-> (the (pointer uint128) dma-start))
          (logior
            (-> spr-work work foreground bone-mem work next-tag quad)
            (shl (the-as int a2-2) 32)))

        (when (= (-> draw data-format) 1)
          (let ((mgeo (-> draw lod-set lod 0 geo)))
            (dotimes (effect-idx (the-as int (-> mgeo header effect-count)))
              (set!
                (-> *merc-bucket-info* effect effect-idx color-fade)
                (new 'static 'rgba :r 0 :g 0 :b 0 :a 0))
              (set!
                (-> *merc-bucket-info* effect effect-idx use-mercneric)
                (the-as uint 0))
              (set!
                (-> *merc-bucket-info* effect effect-idx ignore-alpha)
                (the-as uint 0))

              (when (nonzero? (-> mgeo effect effect-idx envmap-usage))
                (set!
                  (-> *merc-bucket-info* effect effect-idx color-fade)
                  (new 'static 'rgba :r #x80 :g #x80 :b #x80 :a #x80))
                (set!
                  (-> *merc-bucket-info* effect effect-idx ignore-alpha)
                  (the-as uint 1)))))

          (when (logtest? *vu1-enable-user* (vu1-renderer-mask merc))
            (set!
              (-> buf base)
              (pc-merc-draw-request
                draw
                (the pointer a2-2)
                (the pointer mat-data)
                #f
                (the (pointer float) 0)))
            (set! a2-2 (-> buf base))))

        (let ((a0-17 (logand (the int a2-2) 48)))
          (when (nonzero? a0-17)
            (set! at-2 #x20000000)
            (set!
              (-> (the (pointer int128) a2-2))
              (the int128 at-2))
            (let ((v1-2 (the pointer a2-2)))
              (set! a2-2
                (+ (&- (the pointer a2-2) (the uint a0-17)) 64))
              (set!
                (-> (the (pointer uint32) (&+ v1-2 4)))
                (the int a2-2)))))

        (set! (-> buf base) (the pointer a2-2)))))

  0
  (none))

(defun fisher-dma-add-process-drawable-catalog-hud-merc!
  ((proc process-drawable)
    (draw draw-control)
    (arg2 symbol)
    (buf dma-buffer))

  (logclear! (-> draw status) (draw-status was-drawn))

  (when
    (zero?
      (logand
        (-> draw status)
        (draw-status hidden no-anim no-skeleton-update)))

    (let ((vu-lgt (the-as vu-lights (+ 64 (scratchpad-object int))))
        (merc-lgt (-> *merc-bucket-info* light))
        (lgt *hud-pc-lights*)
        (mult (-> draw color-mult))
        (emissive (-> draw color-emissive)))
      (set! (-> vu-lgt direction 0 quad) (-> lgt direction 0 quad))
      (set! (-> vu-lgt direction 1 quad) (-> lgt direction 1 quad))
      (set! (-> vu-lgt direction 2 quad) (-> lgt direction 2 quad))

      (set-vector!
        (-> vu-lgt color 0)
        (* (-> lgt color 0 x) (-> mult x))
        (* (-> lgt color 0 y) (-> mult y))
        (* (-> lgt color 0 z) (-> mult z))
        (* (-> lgt color 0 w) (-> mult w)))
      (set-vector!
        (-> vu-lgt color 1)
        (* (-> lgt color 1 x) (-> mult x))
        (* (-> lgt color 1 y) (-> mult y))
        (* (-> lgt color 1 z) (-> mult z))
        (* (-> lgt color 1 w) (-> mult w)))
      (set-vector!
        (-> vu-lgt color 2)
        (* (-> lgt color 2 x) (-> mult x))
        (* (-> lgt color 2 y) (-> mult y))
        (* (-> lgt color 2 z) (-> mult z))
        (* (-> lgt color 2 w) (-> mult w)))
      (set-vector!
        (-> vu-lgt ambient)
        (+ (* (-> lgt ambient x) (-> mult x)) (-> emissive x))
        (+ (* (-> lgt ambient y) (-> mult y)) (-> emissive y))
        (+ (* (-> lgt ambient z) (-> mult z)) (-> emissive z))
        (+ (* (-> lgt ambient w) (-> mult w)) (-> emissive w)))

      (set! (-> merc-lgt direction 0 quad) (-> vu-lgt direction 0 quad))
      (set! (-> merc-lgt direction 1 quad) (-> vu-lgt direction 1 quad))
      (set! (-> merc-lgt direction 2 quad) (-> vu-lgt direction 2 quad))
      (set! (-> merc-lgt color 0 quad) (-> vu-lgt color 0 quad))
      (set! (-> merc-lgt color 1 quad) (-> vu-lgt color 1 quad))
      (set! (-> merc-lgt color 2 quad) (-> vu-lgt color 2 quad))
      (set! (-> merc-lgt ambient quad) (-> vu-lgt ambient quad)))

    (set! (-> *merc-bucket-info* needs-clip) 0)
    (set! (-> *merc-bucket-info* need-mercprime-if-merc) 0)
    (set! (-> *merc-bucket-info* must-use-mercneric-for-clip) 0)

    (lod-set! draw 0)
    (logior! (-> draw status) (draw-status was-drawn))
    (fisher-draw-bones-catalog-hud-merc! draw buf))

  0
  (none))

(defun fisher-geologist-style-model! ((row int) (fish-proc manipy))
  (let* ((species (fisher-catalog-row-species row))
      (row-suffix (fisher-catalog-row-suffix row))
      (suffix (if (< row-suffix 0) 2 row-suffix))
      (location-id (fisher-catalog-row-zone row))
      (info (fisher-species-info-for species))
      (weight-tenths
        (the int
          (/
            (+
              (-> info min-weight-tenths)
              (-> info max-weight-tenths))
            2))))

    (fisher-apply-fish-appearance!
      species
      suffix
      0
      0
      location-id
      weight-tenths
      fish-proc
      #t)

    (when (= species (the-as int (fisher-species magma-serpent)))
      (*! (-> fish-proc root scale z) 1.25))

    (let ((largest
          (fmax
            (abs (-> fish-proc root scale x))
            (fmax
              (abs (-> fish-proc root scale y))
              (abs (-> fish-proc root scale z))))))
      (set! *fisher-catalog-hud-fit-scale*
        (if
          (> largest 0.0001)
          (/
            (cond
              ((= species (the-as int (fisher-species magma-serpent)))
                0.38)
              ((= species (the-as int (fisher-species megaloviathan)))
                0.36)
              (else
                0.19))
            largest)
          1.0))))

  (none))

(defun fisher-catalog-convert-manipy-tree-to-hud!
  ((model manipy) (unit-scale float))
  (let* ((sx (-> model root scale x))
      (sy (-> model root scale y))
      (sz (-> model root scale z))
      (tx (-> model root transv x))
      (ty (-> model root transv y))
      (tz (-> model root transv z))
      (aspect (/ 512.0 448.0)))

    (set-vector!
      (-> model root scale)
      (* sx unit-scale (-> *video-parms* relative-y-scale))
      (* sy unit-scale aspect (-> *video-parms* relative-y-scale))
      (* sz unit-scale (-> *video-parms* relative-y-scale))
      1.0)

    (set! (-> model root transv x) (* tx unit-scale))
    (set! (-> model root transv y) (* ty unit-scale aspect))
    (set! (-> model root transv z) (* tz unit-scale))

    (set!
      (-> model draw dma-add-func)
      fisher-dma-add-process-drawable-catalog-hud-merc!)

    (logior! (-> model mask) (process-mask pause))
    (logclear! (-> model mask) (process-mask menu progress))

    (set! (-> model draw force-lod) 0)
    (logclear! (-> model draw status) (draw-status hidden no-anim no-skeleton-update))
    (send-event model 'max-vis-dist (meters 999999.0)))

  (let ((child (-> model child)))
    (while child
      (let ((child-proc (ppointer->process child)))
        (when
          (and
            child-proc
            (type-type? (-> child-proc type) manipy))
          (fisher-catalog-convert-manipy-tree-to-hud!
            (the-as manipy child-proc)
            unit-scale)))
      (set! child (-> child 0 brother))))

  (none))

(defun fisher-geologist-remove-model! ((self fisher-geologist))
  (when (-> self catalog-model)
    (let ((proc (ppointer->process (-> self catalog-model))))
      (when proc
        (deactivate proc)))
    (set! (-> self catalog-model) (the-as (pointer manipy) #f)))
  (set! (-> self catalog-model-row) -1)
  (none))

(defun fisher-geologist-update-model-rotation! ((self fisher-geologist))
  (let* ((stick-x (the int (-> *cpad-list* cpads 0 rightx)))
      (step (* (degrees 110.0) (-> *display* seconds-per-frame))))
    (cond
      ((>= stick-x 150) (+! (-> self catalog-yaw) step))
      ((<= stick-x 106) (-! (-> self catalog-yaw) step))))
  (none))

(defun fisher-geologist-position-model! ((self fisher-geologist))
  (when (-> self catalog-model)
    (let ((fish-proc
          (the-as manipy (ppointer->process (-> self catalog-model)))))
      (when fish-proc
        (let* ((species (fisher-catalog-row-species (-> self catalog-index)))
            (suffix (fisher-catalog-row-suffix (-> self catalog-index)))
            (shark-model?
              (=
                (fisher-catalog-row-skeleton (-> self catalog-index))
                *sharkey-sgc*))
            (target-x -290.0)
            (target-y (+ 340.0 (if shark-model? 24.0 0.0)))
            (yaw-quat (new 'stack-no-clear 'quaternion))
            (flip-quat (new 'stack-no-clear 'quaternion)))

          (set!
            (-> fish-proc root trans x)
            (+
              (- target-x 256.0)
              (if
                (< (-> *video-parms* relative-x-scale) 1.0)
                -185.0
                0.0)))
          (set!
            (-> fish-proc root trans y)
            (- target-y (the float (-> *video-parms* screen-sy))))
          (set! (-> fish-proc root trans z) (meters 0.5))
          (set! (-> fish-proc root trans w) 1.0)

          (logclear!
            (-> fish-proc draw status)
            (draw-status hidden no-anim no-skeleton-update))
          (set! (-> fish-proc draw force-lod) 0)

          (quaternion-axis-angle!
            yaw-quat 0.0 1.0 0.0 (-> self catalog-yaw))
          (cond
            ((= suffix 16)
              (quaternion-axis-angle!
                flip-quat 0.0 0.0 1.0 (degrees 180.0))
              (quaternion*!
                (-> fish-proc root quat)
                flip-quat
                yaw-quat))
            (else
              (quaternion-copy!
                (-> fish-proc root quat)
                yaw-quat)))))))

  (none))

(defun fisher-geologist-refresh-model! ((self fisher-geologist))
  (when (!= (-> self catalog-model-row) (-> self catalog-index))
    (fisher-geologist-remove-model! self)
    (set! (-> self catalog-model-row) (-> self catalog-index))
    (set! (-> self catalog-yaw) (degrees 90.0))
    (set! (-> self catalog-pitch) 0.0)

    (when (fisher-catalog-row-discovered? (-> self catalog-index))
      (let ((spawn-pos (new 'stack-no-clear 'vector)))
        (set-vector! spawn-pos 0.0 0.0 0.0 1.0)
        (let ((model
              (the-as (pointer manipy)
                (manipy-spawn
                  spawn-pos
                  #f
                  (fisher-catalog-row-skeleton (-> self catalog-index))
                  #f
                  :from *default-dead-pool*
                  :to *display-pool*
                  :name "fisher-catalog-model"))))
          (when model
            (set! (-> self catalog-model) model)
            (let ((fish-proc (the-as manipy (ppointer->process model))))
              (when fish-proc
                (send-event fish-proc 'anim-mode 'loop)
                (fisher-randomize-manipy-anim-frame! fish-proc)
                (send-event fish-proc 'max-vis-dist (meters 999999.0))
                (set! (-> fish-proc draw force-lod) 0)
                (logclear!
                  (-> fish-proc draw status)
                  (draw-status hidden no-anim no-skeleton-update))

                (fisher-geologist-style-model!
                  (-> self catalog-index)
                  fish-proc)

                (let ((suffix
                      (fisher-catalog-row-suffix (-> self catalog-index)))
                    (species
                      (fisher-catalog-row-species (-> self catalog-index))))
                  (set! *fisher-catalog-attachment-spawn-scale* 1.0)

                  (when (fisher-rare-fish? suffix)
                    (fisher-spawn-rare-fish-attachments!
                      fish-proc suffix #t))

                  (when
                    (=
                      (fisher-catalog-row-zone (-> self catalog-index))
                      (the-as int (fisher-zone snow-ice)))
                    (fisher-spawn-snow-ice-crystal!
                      fish-proc species #t)))

                (fisher-catalog-convert-manipy-tree-to-hud!
                  fish-proc
                  (*
                    *fisher-catalog-hud-unit-scale*
                    *fisher-catalog-hud-fit-scale*)))))))))

  (fisher-geologist-position-model! self)
  (none))

(defun fisher-geologist-init-catalog-particles! ((self fisher-geologist))
  (set!
    (-> self catalog-gatekeeper-part)
    (create-launch-control (-> *part-group-id-table* 3601) self))
  (set!
    (-> self catalog-magma-part)
    (create-launch-control (-> *part-group-id-table* 3602) self))
  (set!
    (-> self catalog-forgotten-part)
    (create-launch-control (-> *part-group-id-table* 3603) self))
  (set!
    (-> self catalog-platformius-part)
    (create-launch-control (-> *part-group-id-table* 3604) self))

  (when (nonzero? (-> self catalog-gatekeeper-part))
    (set! (-> self catalog-gatekeeper-part matrix) -1))
  (when (nonzero? (-> self catalog-magma-part))
    (set! (-> self catalog-magma-part matrix) -1))
  (when (nonzero? (-> self catalog-forgotten-part))
    (set! (-> self catalog-forgotten-part matrix) -1))
  (when (nonzero? (-> self catalog-platformius-part))
    (set! (-> self catalog-platformius-part matrix) -1))

  (set! (-> self catalog-particle-row) -1)
  (none))

(defun fisher-geologist-stop-catalog-particles! ((self fisher-geologist))
  (when (nonzero? (-> self catalog-gatekeeper-part))
    (kill-particles (-> self catalog-gatekeeper-part)))
  (when (nonzero? (-> self catalog-magma-part))
    (kill-particles (-> self catalog-magma-part)))
  (when (nonzero? (-> self catalog-forgotten-part))
    (kill-particles (-> self catalog-forgotten-part)))
  (when (nonzero? (-> self catalog-platformius-part))
    (kill-particles (-> self catalog-platformius-part)))
  (set! (-> self catalog-particle-row) -1)
  (none))

(defun fisher-geologist-free-catalog-particles! ((self fisher-geologist))
  (when (nonzero? (-> self catalog-gatekeeper-part))
    (kill-and-free-particles (-> self catalog-gatekeeper-part))
    (set! (-> self catalog-gatekeeper-part) (the-as sparticle-launch-control 0)))
  (when (nonzero? (-> self catalog-magma-part))
    (kill-and-free-particles (-> self catalog-magma-part))
    (set! (-> self catalog-magma-part) (the-as sparticle-launch-control 0)))
  (when (nonzero? (-> self catalog-forgotten-part))
    (kill-and-free-particles (-> self catalog-forgotten-part))
    (set! (-> self catalog-forgotten-part) (the-as sparticle-launch-control 0)))
  (when (nonzero? (-> self catalog-platformius-part))
    (kill-and-free-particles (-> self catalog-platformius-part))
    (set! (-> self catalog-platformius-part) (the-as sparticle-launch-control 0)))
  (none))

(defun fisher-catalog-spawn-hud-particles!
  ((control sparticle-launch-control)
    (screen-x float)
    (screen-y float)
    (depth float))

  (when control
    (when (<= (-> control matrix) 0)
      (set! (-> control matrix) (sprite-allocate-user-hvdf)))

    (when (> (-> control matrix) 0)
      (let ((pos-x (- screen-x 256.0))
          (pos-y
            (*
              0.5
              (-
                (* screen-y (-> *video-parms* relative-y-scale))
                (the float (-> *video-parms* screen-sy))))))

        (set-vector!
          (sprite-get-user-hvdf (-> control matrix))
          (the float (+ (the int pos-x) 2048))
          (the float (+ (the int pos-y) 2048))
          (- (-> *math-camera* hvdf-off z) (* 1024.0 depth))
          (-> *math-camera* hvdf-off w))

        (spawn control *null-vector*))))

  (none))

(defun fisher-geologist-draw-rare-effects! ((self fisher-geologist))
  (when (-> self catalog-model)
    (let* ((row (-> self catalog-index))
        (species (fisher-catalog-row-species row))
        (suffix (fisher-catalog-row-suffix row)))

      (when (!= row (-> self catalog-particle-row))
        (fisher-geologist-stop-catalog-particles! self)
        (set! (-> self catalog-particle-row) row))

      (cond
        ((= species (the-as int (fisher-species fire-canyon-cellfish)))
          (fisher-catalog-spawn-hud-particles!
            (-> self catalog-gatekeeper-part)
            362.0
            79.0
            1.0))

        ((= species (the-as int (fisher-species magma-serpent)))
          (fisher-catalog-spawn-hud-particles!
            (-> self catalog-magma-part)
            362.0
            79.0
            1.0))

        ((= suffix 8)
          (fisher-catalog-spawn-hud-particles!
            (-> self catalog-forgotten-part)
            362.0
            79.0
            1.0))

        ((= suffix 15)
          (fisher-catalog-spawn-hud-particles!
            (-> self catalog-platformius-part)
            362.0
            79.0
            1.0))

        (else
          (when (!= (-> self catalog-particle-row) -1)
            (fisher-geologist-stop-catalog-particles! self))))))

  (none))

(defun fisher-geologist-draw-catalog! ((self fisher-geologist))
  (let* ((selected (-> self catalog-index))
      (last-start (- *fisher-catalog-row-count* 12))
      (start (max 0 (min last-start (- selected 5))))
      (discovered? (fisher-catalog-row-discovered? selected)))
    (fisher-catalog-background-color! selected *fisher-geologist-bg-color*)

    (with-dma-buffer-add-bucket
      ((buf (-> (current-frame) global-buf))
        (bucket-id sprite))
      (draw-sprite2d-xy buf 18 9 476 29 (new 'static 'rgba :r #x08 :g #x08 :b #x08 :a #xf4))
      (draw-sprite2d-xy buf 18 120 476 94 (new 'static 'rgba :r #x08 :g #x08 :b #x08 :a #xf4))
      (draw-sprite2d-xy buf 18 38 268 82 (new 'static 'rgba :r #x08 :g #x08 :b #x08 :a #xf4))
      (draw-sprite2d-xy buf 438 38 56 82 (new 'static 'rgba :r #x08 :g #x08 :b #x08 :a #xf4))

      (draw-sprite2d-xy buf 22 13 468 25 (new 'static 'rgba :r #x48 :g #x28 :b #x10 :a #xee))
      (draw-sprite2d-xy buf 22 120 468 90 (new 'static 'rgba :r #x48 :g #x28 :b #x10 :a #xee))
      (draw-sprite2d-xy buf 22 38 264 82 (new 'static 'rgba :r #x48 :g #x28 :b #x10 :a #xee))
      (draw-sprite2d-xy buf 438 38 52 82 (new 'static 'rgba :r #x48 :g #x28 :b #x10 :a #xee))

      (draw-sprite2d-xy buf 26 17 460 21 (new 'static 'rgba :r #x12 :g #x12 :b #x12 :a #xf2))
      (draw-sprite2d-xy buf 26 120 460 86 (new 'static 'rgba :r #x12 :g #x12 :b #x12 :a #xf2))
      (draw-sprite2d-xy buf 26 38 260 82 (new 'static 'rgba :r #x12 :g #x12 :b #x12 :a #xf2))
      (draw-sprite2d-xy buf 438 38 48 82 (new 'static 'rgba :r #x12 :g #x12 :b #x12 :a #xf2))

      (draw-sprite2d-xy buf 31 31 202 163 (new 'static 'rgba :r #x24 :g #x18 :b #x10 :a #xe8))

      (draw-sprite2d-xy buf 238 31 241 7 (new 'static 'rgba :r #x18 :g #x12 :b #x0c :a #xe8))
      (draw-sprite2d-xy buf 238 120 241 74 (new 'static 'rgba :r #x18 :g #x12 :b #x0c :a #xe8))
      (draw-sprite2d-xy buf 238 38 48 82 (new 'static 'rgba :r #x18 :g #x12 :b #x0c :a #xe8))
      (draw-sprite2d-xy buf 438 38 41 82 (new 'static 'rgba :r #x18 :g #x12 :b #x0c :a #xe8))

      (draw-sprite2d-xy buf 286 38 152 4 (new 'static 'rgba :r #x08 :g #x08 :b #x08 :a #xff))
      (draw-sprite2d-xy buf 286 116 152 4 (new 'static 'rgba :r #x08 :g #x08 :b #x08 :a #xff))
      (draw-sprite2d-xy buf 286 42 4 74 (new 'static 'rgba :r #x08 :g #x08 :b #x08 :a #xff))
      (draw-sprite2d-xy buf 434 42 4 74 (new 'static 'rgba :r #x08 :g #x08 :b #x08 :a #xff))

      (draw-sprite2d-xy buf 32 (+ 43 (* (- selected start) 12)) 198 12 (new 'static 'rgba :r #x38 :g #x18 :b #x10 :a #x90)))

    (when discovered?
      (fisher-geologist-draw-rare-effects! self))

    (fisher-geologist-draw-catalog-text "FISH CATALOGUE" 132 22 0.26 #f #t)
    (clear *fish-ui-str*)
    (format *fish-ui-str* "DISCOVERED ~D/~D" (fisher-catalog-discovered-count) *fisher-catalog-row-count*)
    (fisher-geologist-draw-catalog-text *fish-ui-str* 410 22 0.16 #f #t)

    (dotimes (i 12)
      (let ((row (+ start i)))
        (when (< row *fisher-catalog-row-count*)
          (fisher-geologist-draw-catalog-text
            (if (fisher-catalog-row-discovered? row)
              (fisher-catalog-row-name row)
              "???")
            38
            (+ 45 (* i 12))
            0.32
            (= row selected)
            #f)

          (clear *fish-ui-str*)
          (cond
            ((= row (the-as int (fisher-species fire-canyon-cellfish)))
              (format *fish-ui-str* "~D/6" (fisher-catalog-prefix-count row)))
            ((fisher-catalog-row-unique? row)
              (format *fish-ui-str* "~D/1" (if (fisher-catalog-row-discovered? row) 1 0)))
            (else
              (format *fish-ui-str* "~D/7" (fisher-catalog-prefix-count row))))
          (fisher-geologist-draw-catalog-text-right
            *fish-ui-str*
            226
            (+ 45 (* i 12))
            0.30
            (= row selected)))))

    (cond
      (discovered?
        (fisher-geologist-draw-catalog-text (fisher-catalog-row-name selected) 362 126 0.44 #f #t)
        (cond
          ((= selected (the-as int (fisher-species fire-canyon-cellfish)))
            (dotimes (star 6)
              (fisher-geologist-draw-star!
                (+ 318 (* star 16))
                135
                (fisher-catalog-gatekeeper-star-caught? star))))
          ((fisher-catalog-row-unique? selected)
            (fisher-geologist-draw-catalog-text "UNIQUE" 362 141 0.36 #f #t))
          (else
            (dotimes (prefix 7)
              (fisher-geologist-draw-star!
                (+ 310 (* prefix 16))
                135
                (fisher-catalog-prefix-caught? selected prefix)))))
        (when (not (string= (fisher-catalog-lore-line selected 0) ""))
          (dotimes (line 6)
            (fisher-geologist-draw-catalog-text
              (fisher-catalog-lore-line selected line)
              248
              (+ 149 (* line 6))
              0.19
              #f
              #f))))
      (else
        (fisher-geologist-draw-catalog-text "?" 362 83 1.04 #f #t)
        (fisher-geologist-draw-catalog-text "???" 362 126 0.44 #f #t)
        (fisher-geologist-draw-catalog-text "UNDISCOVERED" 362 148 0.34 #f #t)
        (fisher-geologist-draw-catalog-text "CAUGHT IN:" 248 165 0.28 #f #f)
        (fisher-geologist-draw-catalog-text (fisher-catalog-row-location selected) 248 178 0.29 #f #f)))
    (fisher-geologist-draw-catalog-text "<PAD_TRIANGLE> EXIT" 256 198 0.38 #f #t))
  (none))

(defun fisher-geologist-near-jak? ((self fisher-geologist))
  (and
    *target*
    (<=
      (vector-vector-distance
        (-> self root trans)
        (target-pos 0))
      (meters 8.5))))

(defun fisher-geologist-release-jak! ((self fisher-geologist))
  (when
    (and (-> self dialogue-grabbed?) *target*)
    (process-release? *target*))
  (set! (-> self dialogue-grabbed?) #f)
  (none))

(defun fisher-geologist-initialize-collision! ((self fisher-geologist))
  (let ((shape
        (new 'process
          'collide-shape
          self
          (collide-list-enum hit-by-player))))
    (let ((group
          (new 'process
            'collide-shape-prim-group
            shape
            (the-as uint 1)
            0)))
      (set! (-> group prim-core collide-as) (collide-kind enemy))
      (set! (-> group collide-with) (collide-kind target))
      (set! (-> group prim-core action) (collide-action solid))
      (set! (-> group prim-core offense) (collide-offense indestructible))
      (set-vector! (-> group local-sphere) 4096.0 0.0 4096.0 12288.0)
      (set-root-prim! shape group)
      (let ((body
            (new 'process
              'collide-shape-prim-sphere
              shape
              (the-as uint 0))))
        (set! (-> body prim-core collide-as) (collide-kind enemy))
        (set! (-> body collide-with) (collide-kind target))
        (set! (-> body prim-core action) (collide-action solid))
        (set! (-> body prim-core offense) (collide-offense indestructible))
        (set! (-> body transform-index) 3)
        (set-vector! (-> body local-sphere) 0.0 0.0 0.0 6144.0)
        (append-prim group body)))
    (set! (-> shape nav-radius) (* 0.75 (-> shape root-prim local-sphere w)))
    (backup-collide-with-as shape)
    (set! (-> self root) shape))
  (none))

(defun fisher-geologist-initialize-taskable! ((self fisher-geologist))
  (stack-size-set! (-> self main-thread) 512)
  (set! (-> self tasks) *fisher-geologist-intro-tasks*)
  (set! (-> self will-talk) #f)
  (set! (-> self bounce-away) #f)
  (set! (-> self skippable) #f)
  (set! (-> self blend-on-exit) (the-as art-joint-anim #f))
  (set! (-> self camera) (the-as handle #f))
  (set! (-> self cell-x) (the-as handle #f))
  (set! (-> self cell-for-task) (game-task none))
  (set! (-> self center-joint-index) 3)
  (set! (-> self cam-joint-index) 3)
  (set! (-> self neck-joint-index) 3)
  (set! (-> self cur-trans-hook) nothing)
  (set! (-> self been-kicked) #f)
  (set! (-> self sound-flava) (music-flava default))
  (set! (-> self have-flava) #f)
  (set! (-> self music) #f)
  (set! (-> self have-music) #f)
  (ambient-control-method-9 (-> self ambient))
  (none))

(defmethod should-display? ((this fisher-geologist)) #t)
(defmethod process-taskable-method-38 ((this fisher-geologist)) (none))
(defmethod process-taskable-method-43 ((this fisher-geologist)) #f)

(defmethod relocate ((this fisher-geologist) (offset int))
  (when (nonzero? (-> this catalog-gatekeeper-part))
    (set!
      (-> this catalog-gatekeeper-part)
      (the-as sparticle-launch-control
        (&+ (the-as pointer (-> this catalog-gatekeeper-part)) offset))))
  (when (nonzero? (-> this catalog-magma-part))
    (set!
      (-> this catalog-magma-part)
      (the-as sparticle-launch-control
        (&+ (the-as pointer (-> this catalog-magma-part)) offset))))
  (when (nonzero? (-> this catalog-forgotten-part))
    (set!
      (-> this catalog-forgotten-part)
      (the-as sparticle-launch-control
        (&+ (the-as pointer (-> this catalog-forgotten-part)) offset))))
  (when (nonzero? (-> this catalog-platformius-part))
    (set!
      (-> this catalog-platformius-part)
      (the-as sparticle-launch-control
        (&+ (the-as pointer (-> this catalog-platformius-part)) offset))))

  (the-as fisher-geologist
    ((method-of-type process-taskable relocate) this offset)))

(defmethod deactivate ((this fisher-geologist))
  (fisher-geologist-free-catalog-particles! this)
  ((method-of-type process-taskable deactivate) this)
  (none))

(defbehavior fisher-geologist-init-by-other fisher-geologist ((spawn-pos vector) (level-name symbol))
  (set! (-> self level-name) level-name)
  (set! (-> self dialogue-page) 0)
  (set! (-> self dialogue-char-count) 0)
  (set! (-> self dialogue-char-timer) 0.0)
  (set! (-> self dialogue-grabbed?) #f)
  (set! (-> self catalog-index) 0)
  (set! (-> self catalog-model) (the-as (pointer manipy) #f))
  (set! (-> self catalog-model-row) -1)
  (set! (-> self catalog-yaw) (degrees 90.0))
  (set! (-> self catalog-pitch) 0.0)
  (set! (-> self catalog-saved-camera-read-analog) #t)
  (set! (-> self catalog-particle-row) -1)
  (set! (-> self catalog-gatekeeper-part) (the-as sparticle-launch-control 0))
  (set! (-> self catalog-magma-part) (the-as sparticle-launch-control 0))
  (set! (-> self catalog-forgotten-part) (the-as sparticle-launch-control 0))
  (set! (-> self catalog-platformius-part) (the-as sparticle-launch-control 0))
  (logclear! (-> self mask) (process-mask actor-pause))
  (fisher-geologist-initialize-taskable! self)
  (fisher-geologist-init-catalog-particles! self)
  (fisher-geologist-initialize-collision! self)
  (initialize-skeleton self *geologist-sgc* '())
  (logior! (-> self skel status) (janim-status eye))
  (#when PC_PORT
    (set! (-> self skel postbind-function) process-drawable-joint-callback-pc))
  (set! (-> self draw origin-joint-index) (the-as uint 3))
  (set! (-> self draw shadow-joint-index) (the-as uint 3))
  (set! (-> self center-joint-index) 3)
  (set! (-> self cam-joint-index) 3)
  (set! (-> self neck-joint-index) 3)
  (set! (-> self draw-bounds-y-offset) (-> self draw bounds y))
  (set! (-> self root pause-adjust-distance) -122880.0)
  (set! (-> self shadow-backup) (-> self draw shadow))
  (logclear! (-> self draw status) (draw-status hidden))
  (set! (-> self root trans quad) (-> spawn-pos quad))
  (set! (-> self root trans w) 1.0)
  (set! (-> self draw force-lod) 0)
  (ja :group! geologist-idle-ja)
  (transform-post)
  (go fisher-geologist-idle))

(defstate fisher-geologist-idle (fisher-geologist)
  :enter
  (behavior ()
    (set! *fisher-catalog-world-preview-active?* #f)
    (fisher-geologist-stop-catalog-particles! self)
    (fisher-geologist-remove-model! self)
    (fisher-geologist-release-jak! self))
  :code
  (behavior ()
    (loop
      (ja-no-eval :group! geologist-idle-ja :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (when
          (and
            (not (paused?))
            (or
              (not *fisher-man*)
              (not (-> *fisher-man* 0 dialogue-grabbed?)))
            (fisher-geologist-near-jak? self))
          (fisher-geologist-draw-text "PRESS <PAD_CIRCLE> TO TALK." 356 170 0.55 #f #t)
          (when (cpad-pressed? 0 circle)
            (cpad-clear! 0 circle)
            (go fisher-geologist-dialogue)))
        (suspend)
        (ja :num! (seek!)))))
  :post transform-post)

(defstate fisher-geologist-dialogue (fisher-geologist)
  :enter
  (behavior ()
    (if
      (task-closed?
        (game-task fisher-geologist-intro)
        (task-status need-introduction))
      (set! (-> self dialogue-page) (rand-vu-int-range 0 5))
      (set! (-> self dialogue-page) 0))
    (set! (-> self dialogue-char-count) 0)
    (set! (-> self dialogue-char-timer) 0.0)
    (set! (-> self dialogue-grabbed?) #f)
    (when *target*
      (process-grab? *target*)
      (set! (-> self dialogue-grabbed?) #t))
    (ja-no-eval :group! geologist-idle-ja :num! (seek!) :frame-num 0.0))
  :exit
  (behavior ()
    (none))
  :code
  (behavior ()
    (loop
      (when *target*
        (process-grab? *target*)
        (set! (-> self dialogue-grabbed?) #t))
      (fisher-geologist-draw-dialogue! self)

      (+!
        (-> self dialogue-char-timer)
        (-> *display* seconds-per-frame))

      (while
        (and
          (>= (-> self dialogue-char-timer) 0.025)
          (<
            (-> self dialogue-char-count)
            (fisher-geologist-dialogue-total-length self)))
        (-! (-> self dialogue-char-timer) 0.025)
        (+! (-> self dialogue-char-count) 1))

      (when (cpad-pressed? 0 x)
        (cpad-clear! 0 x)
        (cond
          ((<
              (-> self dialogue-char-count)
              (fisher-geologist-dialogue-total-length self))
            (set!
              (-> self dialogue-char-count)
              (fisher-geologist-dialogue-total-length self))
            (set! (-> self dialogue-char-timer) 0.0))
          ((task-closed?
              (game-task fisher-geologist-intro)
              (task-status need-introduction))
            (go fisher-geologist-catalog))
          ((< (-> self dialogue-page) 3)
            (+! (-> self dialogue-page) 1)
            (set! (-> self dialogue-char-count) 0)
            (set! (-> self dialogue-char-timer) 0.0))
          (else
            (close-specific-task!
              (game-task fisher-geologist-intro)
              (task-status need-introduction))
            (auto-save-command 'auto-save 0 0 *default-pool*)
            (go fisher-geologist-catalog))))
      (when (cpad-pressed? 0 triangle)
        (cpad-clear! 0 triangle)
        (go fisher-geologist-idle))
      (suspend)
      (ja :num! (seek!))))
  :post transform-post)

(defstate fisher-geologist-catalog (fisher-geologist)
  :enter
  (behavior ()
    (set! (-> self catalog-saved-camera-read-analog) *camera-read-analog*)
    (set! *camera-read-analog* #f)
    (set! *fisher-catalog-world-preview-active?* #t)
    (fisher-geologist-stop-catalog-particles! self)
    (when *target*
      (process-grab? *target*)
      (set! (-> self dialogue-grabbed?) #t))
    (set! (-> self catalog-model-row) -1)
    (fisher-geologist-refresh-model! self)
    (ja-no-eval :group! geologist-idle-ja :num! (seek!) :frame-num 0.0))
  :exit
  (behavior ()
    (set! *camera-read-analog* (-> self catalog-saved-camera-read-analog))
    (set! *fisher-catalog-world-preview-active?* #f)
    (fisher-geologist-stop-catalog-particles! self)
    (fisher-geologist-remove-model! self)
    (fisher-geologist-release-jak! self))
  :code
  (behavior ()
    (loop
      (set! *camera-read-analog* #f)
      (set! *fisher-catalog-world-preview-active?* #t)
      (when *target*
        (process-grab? *target*)
        (set! (-> self dialogue-grabbed?) #t))
      (fisher-geologist-update-model-rotation! self)
      (fisher-geologist-refresh-model! self)
      (fisher-geologist-draw-catalog! self)
      (cond
        ((cpad-pressed? 0 up)
          (cpad-clear! 0 up)
          (set! (-> self catalog-index)
            (mod (+ (-> self catalog-index) (- *fisher-catalog-row-count* 1)) *fisher-catalog-row-count*))
          (fisher-geologist-refresh-model! self))
        ((cpad-pressed? 0 down)
          (cpad-clear! 0 down)
          (set! (-> self catalog-index)
            (mod (+ (-> self catalog-index) 1) *fisher-catalog-row-count*))
          (fisher-geologist-refresh-model! self))
        ((cpad-pressed? 0 triangle)
          (cpad-clear! 0 triangle)
          (go fisher-geologist-idle)))
      (suspend)
      (ja :num! (seek!))))
  :post transform-post)

(defun spawn-fisher-geologist ((spawn-pos vector) (level-name symbol))
  (when *fisher-geologist*
    (kill-fisher-geologist))
  (set!
    *fisher-geologist*
    (process-spawn
      fisher-geologist
      spawn-pos
      level-name
      :name "fisher-geologist"
      :to *active-pool*))
  (none))

(defun kill-fisher-geologist ()
  (set! *fisher-catalog-world-preview-active?* #f)
  (when *fisher-geologist*
    (fisher-geologist-remove-model! (-> *fisher-geologist* 0))
    (when
      (and
        (-> *fisher-geologist* 0 dialogue-grabbed?)
        *target*)
      (process-release? *target*))
    (kill-by-name "fisher-geologist" *active-pool*))
  (set! *fisher-geologist* #f)
  (none))
