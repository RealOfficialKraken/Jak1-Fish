(fisher-initialize-definition-tables!)

(defun swimmer-pontoonfive-initialize-collision!
  ((self swimmer-pontoonfive))

  (let ((shape
        (new 'process
          'collide-shape
          self
          (collide-list-enum hit-by-player))))

    (let ((mesh
          (new 'process
            'collide-shape-prim-mesh
            shape
            (the-as uint 0)
            (the-as uint 0))))

      (set! (-> mesh prim-core collide-as) (collide-kind ground-object))
      (set! (-> mesh collide-with) (collide-kind target))

      (set!
        (-> mesh prim-core action)
        (collide-action solid rider-plat-sticky))

      (set!
        (-> mesh prim-core offense)
        (collide-offense indestructible))

      (set! (-> mesh transform-index) 0)

      (set-vector!
        (-> mesh local-sphere)
        0.0
        0.0
        0.0
        18432.0)

      (set-root-prim! shape mesh))

    (set! (-> shape nav-radius) 12288.0)
    (backup-collide-with-as shape)
    (set! (-> self root) shape))

  (none))

(defun swimmer-pontoonten-initialize-collision!
  ((self swimmer-pontoonten))

  (let ((shape
        (new 'process
          'collide-shape
          self
          (collide-list-enum hit-by-player))))

    (let ((mesh
          (new 'process
            'collide-shape-prim-mesh
            shape
            (the-as uint 0)
            (the-as uint 0))))

      (set! (-> mesh prim-core collide-as) (collide-kind ground-object))
      (set! (-> mesh collide-with) (collide-kind target))

      (set!
        (-> mesh prim-core action)
        (collide-action solid rider-plat-sticky))

      (set!
        (-> mesh prim-core offense)
        (collide-offense indestructible))

      (set! (-> mesh transform-index) 0)

      (set-vector!
        (-> mesh local-sphere)
        0.0
        0.0
        0.0
        25395.2)

      (set-root-prim! shape mesh))

    (set! (-> shape nav-radius) 20480.0)
    (backup-collide-with-as shape)
    (set! (-> self root) shape))

  (none))

(defstate swimmer-pontoon-die (swimmer-pontoon)
  :code
  (behavior ()
    (cleanup-for-death self)
    (deactivate self)))

(defstate swimmer-pontoon-idle (swimmer-pontoon)
  :event
  (behavior
    ((proc process)
      (argc int)
      (message symbol)
      (block event-message-block))

    (case message
      (('die)
        (go swimmer-pontoon-die))))

  :enter
  (behavior ()
    (cond
      ((= (-> self pontoon-type) 0)
        (ja-no-eval
          :group! pontoonfive-idle-ja
          :num! (seek!)
          :frame-num 0.0))

      (else
        (ja-no-eval
          :group! pontoonten-idle-ja
          :num! (seek!)
          :frame-num 0.0))))

  :code
  (behavior ()
    (loop
      (suspend)
      (ja :num! (seek!))))

  :post ja-post)

(defbehavior swimmer-pontoonfive-init-by-other
  swimmer-pontoonfive
  ((spawn-pos vector)
    (rotation-degrees float))

  (set! (-> self pontoon-type) 0)

  (logior!
    (-> self mask)
    (process-mask platform))

  (logclear!
    (-> self mask)
    (process-mask actor-pause))

  (swimmer-pontoonfive-initialize-collision! self)

  (initialize-skeleton
    self
    *swimmer-pontoonfive-sg*
    '())

  (find-collision-meshes (the-as collide-shape (-> self root)))

  (#when PC_PORT
    (set!
      (-> self skel postbind-function)
      process-drawable-joint-callback-pc))

  (set! (-> self root trans quad) (-> spawn-pos quad))
  (set! (-> self root trans w) 1.0)

  (quaternion-axis-angle!
    (-> self root quat)
    0.0
    1.0
    0.0
    (degrees rotation-degrees))

  (vector-identity! (-> self root scale))

  (set! (-> self root pause-adjust-distance) -122880.0)
  (set! (-> self draw force-lod) 0)

  (logclear!
    (-> self draw status)
    (draw-status hidden))

  (transform-post)

  (go swimmer-pontoon-idle))

(defbehavior swimmer-pontoonten-init-by-other
  swimmer-pontoonten
  ((spawn-pos vector)
    (rotation-degrees float))

  (set! (-> self pontoon-type) 1)

  (logior!
    (-> self mask)
    (process-mask platform))

  (logclear!
    (-> self mask)
    (process-mask actor-pause))

  (swimmer-pontoonten-initialize-collision! self)

  (initialize-skeleton
    self
    *swimmer-pontoonten-sg*
    '())

  (find-collision-meshes (the-as collide-shape (-> self root)))

  (#when PC_PORT
    (set!
      (-> self skel postbind-function)
      process-drawable-joint-callback-pc))

  (set! (-> self root trans quad) (-> spawn-pos quad))
  (set! (-> self root trans w) 1.0)

  (quaternion-axis-angle!
    (-> self root quat)
    0.0
    1.0
    0.0
    (degrees rotation-degrees))

  (vector-identity! (-> self root scale))

  (set! (-> self root pause-adjust-distance) -122880.0)
  (set! (-> self draw force-lod) 0)

  (logclear!
    (-> self draw status)
    (draw-status hidden))

  (transform-post)

  (go swimmer-pontoon-idle))

(defun spawn-pontoon-swimmer
  ((spawn-pos vector)
    (pontoon-type int)
    (rotation-degrees float))

  (cond
    ((= pontoon-type 0)
      (process-spawn
        swimmer-pontoonfive
        spawn-pos
        rotation-degrees
        :name "swimmer-pontoonfive"
        :to *active-pool*))

    ((= pontoon-type 1)
      (process-spawn
        swimmer-pontoonten
        spawn-pos
        rotation-degrees
        :name "swimmer-pontoonten"
        :to *active-pool*))

    (else
      (format
        0
        "spawn-pontoon-swimmer: invalid type ~D; use 0 or 1.~%"
        pontoon-type)))

  (none))

(defun maintain-training-pontoon! ()
  (let ((inside
        (when *level*
          (level-get-target-inside *level*))))

    (cond
      ((and
          inside
          (= (-> inside name) 'training))

        (when
          (not *training-pontoon-spawned?*)

          (spawn-pontoon-swimmer
            (new 'static 'vector
              :x (meters -1330.3963)
              :y (meters 0.3323)
              :z (meters 925.1775)
              :w 1.0)
            0
            0.0)

          (set! *training-pontoon-spawned?* #t)))

      (else
        (set! *training-pontoon-spawned?* #f))))

  (none))

(defun maintain-sentinel-pontoon! ()
  (let ((inside
        (when *level*
          (level-get-target-inside *level*))))

    (cond
      ((and
          inside
          (= (-> inside name) 'beach))

        (when
          (not *sentinel-pontoon-spawned?*)

          (spawn-pontoon-swimmer
            (new 'static 'vector
              :x (meters -291.4279)
              :y (meters 0.4322)
              :z (meters -273.1889)
              :w 1.0)
            0
            157.46)

          (set! *sentinel-pontoon-spawned?* #t)))

      (else
        (set! *sentinel-pontoon-spawned?* #f))))

  (none))

(defun maintain-misty-pontoon! ()
  (let ((inside
        (when *level*
          (level-get-target-inside *level*))))

    (cond
      ((and
          inside
          (= (-> inside name) 'misty))

        (when
          (not *misty-pontoon-spawned?*)

          (spawn-pontoon-swimmer
            (new 'static 'vector
              :x (meters 103.0353)
              :y (meters 0.6031)
              :z (meters 990.2777)
              :w 1.0)
            0
            0.0)

          (set! *misty-pontoon-spawned?* #t)))

      (else
        (set! *misty-pontoon-spawned?* #f))))

  (none))

(defun fisher-fish-distance ((self fisher-game) (slot int))
  (-> self fish-data slot slot distance))

(defun fisher-fish-lane ((self fisher-game) (slot int))
  (-> self fish-data slot slot lane))

(defun fisher-fish-depth ((self fisher-game) (slot int))
  (-> self fish-data slot slot depth))

(defun fisher-fish-direction ((self fisher-game) (slot int))
  (-> self fish-data slot slot direction))

(defun fisher-fish-speed ((self fisher-game) (slot int))
  (-> self fish-data slot slot speed))

(defun fisher-set-fish-distance! ((self fisher-game) (slot int) (value float))
  (set! (-> self fish-data slot slot distance) value)
  (none))

(defun fisher-set-fish-lane! ((self fisher-game) (slot int) (value float))
  (set! (-> self fish-data slot slot lane) value)
  (none))

(defun fisher-set-fish-depth! ((self fisher-game) (slot int) (value float))
  (set! (-> self fish-data slot slot depth) value)
  (none))

(defun fisher-set-fish-direction! ((self fisher-game) (slot int) (value float))
  (set! (-> self fish-data slot slot direction) value)
  (none))

(defun fisher-set-fish-speed! ((self fisher-game) (slot int) (value float))
  (set! (-> self fish-data slot slot speed) value)
  (none))

(defun fisher-fish-turn-time ((self fisher-game) (slot int))
  (-> self fish-data slot slot turn-time))

(defun fisher-set-fish-turn-time! ((self fisher-game) (slot int) (value float))
  (set! (-> self fish-data slot slot turn-time) value)
  (none))

(defun fisher-fish-turn-old-direction ((self fisher-game) (slot int))
  (-> self fish-data slot slot turn-old-direction))

(defun fisher-set-fish-turn-old-direction! ((self fisher-game) (slot int) (value float))
  (set! (-> self fish-data slot slot turn-old-direction) value)
  (none))

(defun fisher-fish-turn-side ((self fisher-game) (slot int))
  (-> self fish-data slot slot turn-side))

(defun fisher-set-fish-turn-side! ((self fisher-game) (slot int) (value float))
  (set! (-> self fish-data slot slot turn-side) value)
  (none))

(defun fisher-start-manipy-turn!
  ((self fisher-game) (slot int) (new-direction float))

  (fisher-set-fish-turn-old-direction! self slot (fisher-fish-direction self slot))

  (fisher-set-fish-direction! self slot new-direction)

  (fisher-set-fish-turn-side! self slot (if (rand-vu-percent? 0.5) 1.0 -1.0))

  (fisher-set-fish-turn-time! self slot 0.0001)

  (none))

(defun fisher-fish-cooldown ((self fisher-game) (slot int))
  (-> self fish-data slot slot cooldown))

(defun fisher-set-fish-cooldown! ((self fisher-game) (slot int) (value float))
  (set! (-> self fish-data slot slot cooldown) value)
  (none))

(defun fisher-golden-hour? ()
  (let ((hour
        (if
          *time-of-day-context*
          (-> *time-of-day-context* time)
          12.0)))

    (or
      (>= hour 18.0)
      (< hour 6.0))))

(defun fisher-green-sun-hour? ()
  (let ((hour
        (if
          *time-of-day-context*
          (-> *time-of-day-context* time)
          12.0)))

    (and
      (>= hour 4.0)
      (< hour 5.0))))

(defun fisher-fish-species ((self fisher-game) (slot int))
  (-> self fish-data slot slot species))

(defun fisher-set-fish-species! ((self fisher-game) (slot int) (value int))
  (set! (-> self fish-data slot slot species) value)
  (none))

(defun fisher-fish-suffix ((self fisher-game) (slot int))
  (-> self fish-data slot slot suffix))

(defun fisher-set-fish-suffix! ((self fisher-game) (slot int) (value int))
  (set! (-> self fish-data slot slot suffix) value)
  (none))

(defun fisher-fish-level ((self fisher-game) (slot int))
  (-> self fish-data slot slot level))

(defun fisher-set-fish-level! ((self fisher-game) (slot int) (value int))
  (set!
    (-> self fish-data slot slot level)
    (max 1 (min *fisher-level-cap* value)))
  (none))

(defun fisher-fish-weight-tenths ((self fisher-game) (slot int))
  (-> self fish-data slot slot weight-tenths))

(defun fisher-set-fish-weight-tenths! ((self fisher-game) (slot int) (value int))
  (set! (-> self fish-data slot slot weight-tenths) value)
  (none))

(defun fisher-fish-power-cell-task ((self fisher-game) (slot int))
  (-> self fish-data slot slot power-cell-task))

(defun fisher-set-fish-power-cell-task! ((self fisher-game) (slot int) (value int))
  (set! (-> self fish-data slot slot power-cell-task) value)
  (none))

(defun fisher-roll-standard-fish-suffix ()
  (let ((roll
        (rand-vu-int-range 0 99999)))

    (cond
      ((fisher-green-sun-hour?)
        (cond
          ((< roll 26000) 0)
          ((< roll 47000) 1)
          ((< roll 76000) 2)
          ((< roll 87000) 3)
          ((< roll 96750) 4)
          ((< roll 99750) 5)
          (else 6)))

      ((fisher-golden-hour?)
        (cond
          ((< roll 31000) 0)
          ((< roll 55500) 1)
          ((< roll 85000) 2)
          ((< roll 92500) 3)
          ((< roll 97900) 4)
          ((< roll 99900) 5)
          (else 6)))

      (else
        (cond
          ((< roll 35000) 0)
          ((< roll 62000) 1)
          ((< roll 93000) 2)
          ((< roll 97000) 3)
          ((< roll 99490) 4)
          ((< roll 99990) 5)
          (else 6))))))

(defun fisher-roll-fish-suffix ()
  ;; Debug mode deliberately makes every generated ordinary slot one of the
  ;; ten special rare fish, with an even 10% share for each rare.
  (cond
    (*fisher-in-debug?*
      (+ 7 (rand-vu-int-range 0 9)))

    (else
      ;; Combined special-rare odds:
      ;;   normal hours: 250 / 100000, approximately 1 in 400
      ;;   golden hours: 667 / 100000, approximately 1 in 150
      ;; Once the rare roll succeeds, choose evenly among all ten rare fish.
      (let ((rare-roll (rand-vu-int-range 0 99999))
          (rare-threshold (if (fisher-golden-hour?) 667 250)))
        (if (< rare-roll rare-threshold)
          (+ 7 (rand-vu-int-range 0 9))
          (fisher-roll-standard-fish-suffix))))))

(defun fisher-rare-fish? ((suffix int))
  (and (>= suffix 7) (<= suffix 16)))

(defun fisher-apply-rare-slot-type! ((self fisher-game) (slot int))
  (let ((suffix (fisher-fish-suffix self slot)))
    (cond
      ((or (= suffix 7) (= suffix 11) (= suffix 14) (= suffix 15) (= suffix 16))
        (fisher-set-fish-species! self slot 1))
      ((or (= suffix 8) (= suffix 9) (= suffix 10) (= suffix 12) (= suffix 13))
        (fisher-set-fish-species! self slot 0))))
  (none))

(defun fisher-suffix-name ((suffix int))
  (cond
    ((= suffix 0) "MALNUTRITIONED")
    ((= suffix 1) "STRESSED")
    ((= suffix 2) "HEALTHY")
    ((= suffix 3) "MUTANT")
    ((= suffix 4) "RARE")
    ((= suffix 5) "MEGA")
    ((= suffix 6) "GOLDEN")
    ((= suffix 7) "PRECURSOR")
    ((= suffix 8) "ORACLE")
    ((= suffix 9) "FRICKED UP")
    ((= suffix 10) "ORB-HUNTER")
    ((= suffix 11) "ARCHIPELAGOLD")
    ((= suffix 12) "SPEC OPS")
    ((= suffix 13) "COMPLICATED")
    ((= suffix 14) "L TETROMINO")
    ((= suffix 15) "PLATFORMIUS")
    (else "SCREAMING")))

(defun fisher-species-name
  ((self fisher-game) (species int))

  (if
    (and
      (= species (the-as int (fisher-species fire-canyon-cellfish)))
      (or
        (= (-> self caught-power-cell-task) (the-as int (game-task ogre-boss)))
        (= (-> self caught-power-cell-task) (the-as int (game-task ogre-end)))))
    "MOUNTAIN PASS CELL FISH"
    (-> (fisher-species-info-for species) name)))

(defun fisher-suffix-value-multiplier ((suffix int))
  (cond
    ((= suffix 0) 0.50)
    ((= suffix 1) 0.75)
    ((= suffix 2) 1.00)
    ((= suffix 3) 1.50)
    ((= suffix 4) 2.00)
    ((= suffix 5) 3.00)
    ((= suffix 6) 5.00)
    (else 1.00)))

(defun fisher-roll-fish-weight-tenths
  ((self fisher-game) (slot int))

  (let* ((species
        (fisher-fish-species self slot))

      (suffix
        (fisher-fish-suffix self slot))

      (info
        (fisher-species-info-for species))

      (base-weight
        (rand-vu-int-range
          (-> info min-weight-tenths)
          (-> info max-weight-tenths))))

    (cond
      ((= suffix 7) (rand-vu-int-range 100 151))
      ((= suffix 8) (rand-vu-int-range 30 61))
      ((= suffix 9) (rand-vu-int-range 1 7))
      ((= suffix 10) (rand-vu-int-range 140 241))
      ((= suffix 11) (rand-vu-int-range 100 201))
      ((= suffix 12) (rand-vu-int-range 120 161))
      ((= suffix 13) (rand-vu-int-range 200 301))
      ((= suffix 14) 250)
      ((= suffix 15) 1000)
      ((= suffix 16) (rand-vu-int-range 30 51))

      ((= species 3) 260)
      ((= species 5) base-weight)

      ((= suffix 0)
        (max
          1
          (the int
            (*
              (the float base-weight)
              (rand-vu-float-range 0.45 0.65)))))

      ((= suffix 1)
        (max
          1
          (the int
            (*
              (the float base-weight)
              (rand-vu-float-range 0.72 0.88)))))

      ((= suffix 5) (* base-weight 2))
      ((= suffix 6) (* base-weight 18))
      (else base-weight))))


(defun fisher-roll-level-for-current-zone ((self fisher-game))
  ;; Roll directly from the active zone definition.  Do not depend on the
  ;; cached fish-level-min/max fields, which can still be at their default
  ;; values while a persistent/hidden pool is being configured.
  (let ((zone
          (fisher-zone-info-for
            (the-as fisher-zone (-> self location-id)))))
    (fisher-roll-level-in-range
      (-> zone level-min)
      (-> zone level-max))))

(defun fisher-refresh-active-slot-levels! ((self fisher-game))
  ;; Every live table slot owns its level.  Re-assert valid zone levels after
  ;; initial table construction and hidden population growth so no slot can
  ;; remain at the initialization default of level 1 unless the zone itself is
  ;; level 1 (training).
  (dotimes (slot (-> self fish-count))
    (fisher-set-fish-level!
      self
      slot
      (fisher-roll-level-for-current-zone self)))
  (none))

(defun fisher-randomize-fish-level-and-weight!
  ((self fisher-game) (slot int))

  (fisher-apply-rare-slot-type! self slot)

  (fisher-set-fish-level!
    self
    slot
    (fisher-roll-level-for-current-zone self))

  (fisher-set-fish-weight-tenths!
    self
    slot
    (fisher-roll-fish-weight-tenths self slot))

  (none))

(defun fisher-clear-power-cell-tasks! ((self fisher-game))
  (dotimes (slot *fisher-max-fish-slots*)
    (fisher-set-fish-power-cell-task! self slot 0))
  (none))

(defun fisher-configure-random-fish-slot!
  ((self fisher-game) (slot int) (species int))
  (fisher-set-fish-species! self slot species)
  (fisher-set-fish-suffix! self slot (fisher-roll-fish-suffix))
  (fisher-randomize-fish-level-and-weight! self slot)
  (none))

(defun fisher-assign-table-slots!
  ((self fisher-game) (eco-count int) (largemouth-count int) (babak-count int))

  (let* ((requested-count
        (+ eco-count largemouth-count babak-count))

      (new-count (min *fisher-max-fish-slots* requested-count))

      (babak-slots (min babak-count new-count))

      (largemouth-slots (min largemouth-count (- new-count babak-slots)))

      (i
        0))

    (set! (-> self fish-count) new-count)

    (fisher-clear-power-cell-tasks! self)

    (while (< i new-count)
      (cond
        ((< i babak-slots) (fisher-set-fish-species! self i 2))

        ((< i (+ babak-slots largemouth-slots)) (fisher-set-fish-species! self i 1))

        (else
          (fisher-set-fish-species!
            self
            i
            0)))

      (fisher-set-fish-suffix! self i (fisher-roll-fish-suffix))
      (fisher-randomize-fish-level-and-weight! self i)

      (+! i 1)))

  (none))

(defun fisher-add-lurker-shark-slot!
  ((self fisher-game))

  ;;
  (when
    (and
      (> (-> self fish-count) 0)
      (rand-vu-percent? 0.50))

    (let ((slot
          (- (-> self fish-count) 1)))

      (fisher-set-fish-species! self slot 3)
      (fisher-set-fish-suffix! self slot (fisher-roll-standard-fish-suffix))
      (fisher-set-fish-level!
        self
        slot
        (fisher-roll-level-for-current-zone self))
      (fisher-set-fish-weight-tenths! self slot 260)))

  (none))

(defun fisher-power-cell-task-count-for-location ((self fisher-game))
  (cond
    ((= (-> self location-id) 4) 5)
    ;; Every Hub 2 fishing pool also shares the two Basin reward cells:
    ;; rolling-lake and rolling-buzzer.  rolling-buzzer is awarded directly
    ;; as a power-cell fish; it does not add Basin Scout Fly fish here.
    ((= (-> self location-id) 5) 3)
    ((= (-> self location-id) 6) 9)
    ((= (-> self location-id) 7) 9)
    ((or (= (-> self location-id) 1) (= (-> self location-id) 3)) 4)
    (else 0)))

(defun fisher-power-cell-task-for-location-index
  ((self fisher-game) (index int))
  (cond
    ((= (-> self location-id) 3)
      (cond
        ((= index 0) (game-task beach-ecorocks))
        ((= index 1) (game-task beach-pelican))
        ((= index 2) (game-task beach-gimmie))
        (else (game-task beach-sentinel))))

    ((= (-> self location-id) 1)
      (cond
        ((= index 0) (game-task jungle-tower))
        ((= index 1) (game-task jungle-plant))
        ((= index 2) (game-task jungle-canyon-end))
        (else (game-task jungle-temple-door))))

    ((= (-> self location-id) 4)
      (cond
        ((= index 0) (game-task misty-boat))
        ((= index 1) (game-task misty-warehouse))
        ((= index 2) (game-task misty-bike))
        ((= index 3) (game-task misty-bike-jump))
        (else (game-task misty-eco-challenge))))

    ((= (-> self location-id) 5)
      (cond
        ((= index 0) (game-task firecanyon-buzzer))
        ((= index 1) (game-task rolling-lake))
        (else (game-task rolling-buzzer))))

    ((= (-> self location-id) 6)
      (cond
        ((= index 0) (game-task sunken-platforms))
        ((= index 1) (game-task sunken-pipe))
        ((= index 2) (game-task sunken-slide))
        ((= index 3) (game-task sunken-sharks))
        ((= index 4) (game-task sunken-top-of-helix))
        ((= index 5) (game-task sunken-spinning-room))
        ((= index 6) (game-task sunken-room))
        ((= index 7) (game-task rolling-lake))
        (else (game-task rolling-buzzer))))

    ;; swamp-billy is Protect Farthy's Snacks and is deliberately excluded.
    ((= (-> self location-id) 7)
      (cond
        ((= index 0) (game-task swamp-arm))
        ((= index 1) (game-task swamp-battle))
        ((= index 2) (game-task swamp-flutflut))
        ((= index 3) (game-task swamp-tether-1))
        ((= index 4) (game-task swamp-tether-2))
        ((= index 5) (game-task swamp-tether-3))
        ((= index 6) (game-task swamp-tether-4))
        ((= index 7) (game-task rolling-lake))
        (else (game-task rolling-buzzer))))

    (else (game-task none))))

(defun fisher-find-missing-power-cell-task ((self fisher-game))
  (let* ((task-count (fisher-power-cell-task-count-for-location self))
      (start
        (if
          (> task-count 0)
          (rand-vu-int-range 0 (- task-count 1))
          0))
      (step 0)
      (task (game-task none)))

    (while (< step task-count)
      (set! task
        (fisher-power-cell-task-for-location-index
          self
          (mod (+ start step) task-count)))

      (when
        (and
          (> (the int task) 1)
          (not (task-complete? *game-info* task)))
        (return task))

      (+! step 1))

    (game-task none)))

(defun fisher-has-power-cell-fish? ((self fisher-game))
  (dotimes (slot (-> self fish-count))
    (let ((task (fisher-fish-power-cell-task self slot)))
      (when
        (and
          (> task 1)
          (!= task (the-as int (game-task ogre-boss)))
          (!= task (the-as int (game-task ogre-end))))
        (return #t))))
  #f)

(defun fisher-add-power-cell-fish-slot! ((self fisher-game))
  (when
    (and
      (or
        (= (-> self location-id) 1)
        (= (-> self location-id) 3)
        (= (-> self location-id) 4)
        (= (-> self location-id) 5)
        (= (-> self location-id) 6)
        (= (-> self location-id) 7))
      (> (-> self fish-count) 0)
      (not (fisher-has-power-cell-fish? self))
      (rand-vu-percent?
        (if *fisher-in-debug?* 0.90 *fisher-power-cell-fish-chance*)))

    (let ((task (fisher-find-missing-power-cell-task self)))
      (when (> (the int task) 1)
        (let ((start-slot (rand-vu-int-range 0 (- (-> self fish-count) 1)))
            (step 0)
            (slot -1)
            (candidate 0))

          (while (and (< step (-> self fish-count)) (< slot 0))
            (set! candidate (mod (+ start-slot step) (-> self fish-count)))
            (when
              (and
                (!= (fisher-fish-species self candidate) 4)
                (<= (fisher-fish-power-cell-task self candidate) 1)
                (not
                  (or
                    (and
                      (or
                        (= (-> self location-id)
                          (the-as int (fisher-zone village2-electric)))
                        (= (-> self location-id)
                          (the-as int (fisher-zone sunken-voltage))))
                      (= (fisher-fish-species self candidate)
                        (the-as int (fisher-species electric-lurker-shark))))
                    (and
                      (= (-> self location-id)
                        (the-as int (fisher-zone swamp-sludge)))
                      (= (fisher-fish-species self candidate)
                        (the-as int (fisher-species black-lurker-shark)))))))
              (set! slot candidate))
            (+! step 1))

          (when (>= slot 0)
            (fisher-set-fish-power-cell-task! self slot (the int task))

            (fisher-set-fish-weight-tenths!
              self
              slot
              (max
                1
                (the int
                  (+
                    (*
                      (the float (fisher-fish-weight-tenths self slot))
                      1.70)
                    0.5)))))))))

  (none))

(defun fisher-mountain-pass-cellfish-location? ((self fisher-game))
  (or
    (= (-> self location-id) (the-as int (fisher-zone village2-electric)))
    (= (-> self location-id) (the-as int (fisher-zone sunken-voltage)))
    (= (-> self location-id) (the-as int (fisher-zone swamp-sludge)))))

(defun fisher-has-power-cell-task? ((self fisher-game) (task game-task))
  (dotimes (slot (-> self fish-count))
    (when
      (= (fisher-fish-power-cell-task self slot) (the int task))
      (return #t)))
  #f)

(defun fisher-mountain-pass-cellfish-eligible? ((self fisher-game))
  (and
    (fisher-mountain-pass-cellfish-location? self)
    *target*
    (>=
      (the int
        (the float
          (send-event
            *target*
            'query
            'pickup
            (pickup-type fuel-cell))))
      45)))

(defun fisher-add-one-mountain-pass-cellfish!
  ((self fisher-game) (task game-task))

  (when
    (and
      (> (-> self fish-count) 0)
      (not (task-complete? *game-info* task))
      (not (fisher-has-power-cell-task? self task)))

    (let ((step 0)
        (slot -1)
        (candidate 0))

      ;; Mountain Pass Cell Fish coexist with every shark.  Replace only a
      ;; normal non-collectible resident, never a Scout Fly, another cell
      ;; carrier, or a Hub 2 shark.  Search from the front of the active table
      ;; so both guaranteed fish survive normal/golden population reductions.
      (while (and (< step (-> self fish-count)) (< slot 0))
        (set! candidate step)
        (when
          (and
            (!= (fisher-fish-species self candidate)
              (the-as int (fisher-species scout-fly)))
            (<= (fisher-fish-power-cell-task self candidate) 1)
            (not
              (or
                (= (fisher-fish-species self candidate)
                  (the-as int (fisher-species electric-lurker-shark)))
                (= (fisher-fish-species self candidate)
                  (the-as int (fisher-species black-lurker-shark))))))
          (set! slot candidate))
        (+! step 1))

      (when (>= slot 0)
        (fisher-set-fish-species!
          self
          slot
          (the-as int (fisher-species fire-canyon-cellfish)))
        (fisher-set-fish-suffix! self slot 2)
        (fisher-set-fish-level!
          self
          slot
          (fisher-roll-level-for-current-zone self))
        (fisher-set-fish-weight-tenths!
          self
          slot
          (rand-vu-int-range 100 140))
        (fisher-set-fish-power-cell-task! self slot (the int task))

        (let ((old-fish (fisher-fish-pointer self slot)))
          (when old-fish
            (fisher-destroy-manipy! old-fish)
            (fisher-set-fish-pointer!
              self
              slot
              (the-as (pointer manipy) #f)))

          ;; In a persistent rendered pool, do not leave this guaranteed cell
          ;; fish as a missing slot.  fisher-refill-missing-fish! treats every
          ;; missing pointer as a caught ordinary fish and rerolls its logical
          ;; species/task, which immediately erased both Mountain Pass fish.
          ;; Spawn the newly assigned special resident now while the pool is
          ;; hidden so the refill pass cannot overwrite it.
          (when (-> self pool-rendered?)
            (fisher-set-fish-pointer!
              self
              slot
              (fisher-spawn-gameplay-fish self slot)))))))

  (none))

(defun fisher-add-mountain-pass-cellfish-slots! ((self fisher-game))
  (when (fisher-mountain-pass-cellfish-eligible? self)
    ;; One fish awards Defeat Klaww; the other awards Reach the End of
    ;; Mountain Pass.  Both are guaranteed while their task is missing.
    (fisher-add-one-mountain-pass-cellfish! self (game-task ogre-boss))
    (fisher-add-one-mountain-pass-cellfish! self (game-task ogre-end)))
  (none))

(defun fisher-existing-zone? ((self fisher-game))
  (and
    (>= (-> self location-id) 0)
    (< (-> self location-id) *fisher-zone-count*)
    (->
      (fisher-zone-info-for (-> self location-id))
      fire-canyon-cellfish?)))

(defun fisher-default-species-for-location ((self fisher-game))
  (cond
    ((= (-> self location-id) (the-as int (fisher-zone jungle-pillar)))
      (the-as int (fisher-species babak-ecofish)))

    ((= (-> self location-id) (the-as int (fisher-zone misty-island)))
      (the-as int (fisher-species poisonous-eelfish)))

    ((or
        (= (-> self location-id) (the-as int (fisher-zone village2-electric)))
        (= (-> self location-id) (the-as int (fisher-zone sunken-voltage))))
      (the-as int (fisher-species electric-eelfish)))

    ((= (-> self location-id) (the-as int (fisher-zone swamp-sludge)))
      (the-as int (fisher-species sludge-crappie)))

    (else
      (the-as int (fisher-species eco-drum)))))

(defun fisher-has-species? ((self fisher-game) (species int))
  (dotimes (slot (-> self fish-count))
    (when (= (fisher-fish-species self slot) species)
      (return #t)))
  #f)

(defun fisher-daytime? ()
  (let ((hour
        (if
          *time-of-day-context*
          (-> *time-of-day-context* time)
          12.0)))

    (and
      (>= hour 6.0)
      (< hour 18.0))))

(defun fisher-fire-canyon-cellfish-eligible? ((self fisher-game))
  ;; Completion is a hard gate, including debug mode.  Once this exact cell
  ;; has been awarded, the Fire Canyon Cell Fish may never spawn again.
  (and
    (not
      (task-complete?
        *game-info*
        (game-task firecanyon-end)))
    (or
      *fisher-in-debug?*
      (and
        *target*
        (fisher-existing-zone? self)
        (fisher-daytime?)
        (>=
          (the int
            (the float
              (send-event
                *target*
                'query
                'pickup
                (pickup-type fuel-cell))))
          20)))))

(defun fisher-add-fire-canyon-cellfish-slot! ((self fisher-game))
  (when
    (and
      (> (-> self fish-count) 0)
      (fisher-fire-canyon-cellfish-eligible? self)
      (not
        (fisher-has-species?
          self
          (the-as int (fisher-species fire-canyon-cellfish))))
      (rand-vu-percent?
        (if *fisher-in-debug?* 1.0 *fisher-power-cell-fish-chance*)))

    (let ((start-slot (rand-vu-int-range 0 (- (-> self fish-count) 1)))
        (step 0)
        (slot -1)
        (candidate 0))

      ;; A successful Fire Canyon Cell Fish roll takes priority over a Lurker
      ;; Shark.  Reusing the shark slot removes the shark without changing the
      ;; zone's configured fish count.
      (dotimes (i (-> self fish-count))
        (when
          (and
            (< slot 0)
            (=
              (fisher-fish-species self i)
              (the-as int (fisher-species lurker-shark))))
          (set! slot i)))

      ;; If there is no shark, replace a normal non-cell/non-scout resident.
      (while
        (and
          (< step (-> self fish-count))
          (< slot 0))

        (set! candidate
          (mod (+ start-slot step) (-> self fish-count)))

        (when
          (and
            (!= (fisher-fish-species self candidate)
              (the-as int (fisher-species scout-fly)))
            (<= (fisher-fish-power-cell-task self candidate) 1))

          (set! slot candidate))

        (+! step 1))

      (when (>= slot 0)
        (fisher-set-fish-species!
          self
          slot
          (the-as int (fisher-species fire-canyon-cellfish)))
        (fisher-set-fish-suffix! self slot 2)
        (fisher-set-fish-level!
          self
          slot
          (fisher-roll-level-for-current-zone self))
        (fisher-set-fish-weight-tenths!
          self
          slot
          (rand-vu-int-range 100 140))
        (fisher-set-fish-power-cell-task!
          self
          slot
          (the-as int (game-task firecanyon-end)))

        (let ((old-fish (fisher-fish-pointer self slot)))
          (when old-fish
            (fisher-destroy-manipy! old-fish)
            (fisher-set-fish-pointer!
              self
              slot
              (the-as (pointer manipy) #f)))))))

  (none))

(defun fisher-buzzer-index-active? ((self fisher-game) (index int))
  (dotimes (slot (-> self fish-count))
    (when
      (and
        (= (fisher-fish-species self slot)
          (the-as int (fisher-species scout-fly)))
        (= (fisher-fish-weight-tenths self slot) index))
      (return #t)))
  #f)

(defun fisher-find-passive-buzzer-index
  ((self fisher-game) (task game-task))

  (let ((start (rand-vu-int-range 0 6))
      (step 0)
      (index 0))

    (while (< step 7)
      (set! index (mod (+ start step) 7))

      (when
        (and
          (not (got-buzzer? *game-info* task index))
          (not (fisher-buzzer-index-active? self index)))
        (return index))

      (+! step 1))

    -1))

(defun fisher-roll-passive-special-for-slot!
  ((self fisher-game) (slot int))

  ;; Every replacement begins as a normal zone fish.  This helper may then
  ;; convert that exact new slot into any eligible passive special fish.
  ;; Preserve the guaranteed Electric Lurker Shark in both Hub 2 electric
  ;; pools instead of allowing a collectible conversion to replace it.
  (when
    (or
      (and
        (or
          (= (-> self location-id) (the-as int (fisher-zone village2-electric)))
          (= (-> self location-id) (the-as int (fisher-zone sunken-voltage))))
        (= (fisher-fish-species self slot)
          (the-as int (fisher-species electric-lurker-shark))))
      (and
        (= (-> self location-id) (the-as int (fisher-zone swamp-sludge)))
        (= (fisher-fish-species self slot)
          (the-as int (fisher-species black-lurker-shark)))))
    (return #f))

  (when
    (and
      (fisher-fire-canyon-cellfish-eligible? self)
      (not
        (fisher-has-species?
          self
          (the-as int (fisher-species fire-canyon-cellfish))))
      (rand-vu-percent?
        (if *fisher-in-debug?* 1.0 *fisher-power-cell-fish-chance*)))

    (fisher-set-fish-species!
      self
      slot
      (the-as int (fisher-species fire-canyon-cellfish)))
    (fisher-set-fish-suffix! self slot 2)
    (fisher-set-fish-level!
      self
      slot
      (fisher-roll-level-for-current-zone self))
    (fisher-set-fish-weight-tenths!
      self
      slot
      (rand-vu-int-range 100 140))
    (fisher-set-fish-power-cell-task!
      self
      slot
      (the-as int (game-task firecanyon-end)))
    (return #t))

  ;; Training awards all four of its cells through the Fisherman's
  ;; ten-orb quest.  Never convert a replacement resident into a Scout Fly
  ;; while fishing in the training lagoon.
  (when
    (!= (-> self location-id) (the-as int (fisher-zone training-lagoon)))

    (let* ((buzzer-task (fisher-buzzer-task-for-location self))
        (buzzer-collected (buzzer-count *game-info* buzzer-task))
        (buzzer-index
          (if
            (and
              (< buzzer-collected 7)
              (rand-vu-percent? (if *fisher-in-debug?* 0.90 0.33)))
            (fisher-find-passive-buzzer-index self buzzer-task)
            -1)))

      (when (>= buzzer-index 0)
        (fisher-set-fish-species!
          self
          slot
          (the-as int (fisher-species scout-fly)))
        (fisher-set-fish-power-cell-task! self slot 0)
        (fisher-set-fish-suffix! self slot 2)
        (fisher-set-fish-level!
          self
          slot
          (fisher-roll-level-for-current-zone self))
        (fisher-set-fish-weight-tenths! self slot buzzer-index)
        (return #t))))

  (when
    (and
      (or
        (= (-> self location-id) 1)
        (= (-> self location-id) 3)
        (= (-> self location-id) 4)
        (= (-> self location-id) 5)
        (= (-> self location-id) 6)
        (= (-> self location-id) 7))
      (not (fisher-has-power-cell-fish? self))
      (rand-vu-percent?
        (if *fisher-in-debug?* 0.90 *fisher-power-cell-fish-chance*)))

    (let ((task (fisher-find-missing-power-cell-task self)))
      (when (> (the int task) 1)
        (fisher-set-fish-power-cell-task! self slot (the int task))
        (fisher-set-fish-weight-tenths!
          self
          slot
          (max
            1
            (the int
              (+
                (*
                  (the float (fisher-fish-weight-tenths self slot))
                  1.70)
                0.5))))
        (return #t))))

  #f)

(defun fisher-buzzer-task-for-location ((self fisher-game))
  (cond
    ((= (-> self location-id) 1) (game-task jungle-buzzer))
    ((= (-> self location-id) 2) (game-task training-buzzer))
    ((= (-> self location-id) 3) (game-task beach-buzzer))
    ((= (-> self location-id) 4) (game-task misty-buzzer))
    ((= (-> self location-id) 5) (game-task village2-buzzer))
    ((= (-> self location-id) 6) (game-task sunken-buzzer))
    ((= (-> self location-id) 7) (game-task swamp-buzzer))
    (else (game-task village1-buzzer))))

(defun fisher-find-missing-buzzer-index
  ((task game-task) (start int) (exclude int))

  (let ((step 0)
      (index 0))

    (while (< step 7)
      (set! index (mod (+ start step) 7))

      (when
        (and
          (!= index exclude)
          (not (got-buzzer? *game-info* task index)))

        (return index))

      (+! step 1))

    -1))

(defun fisher-add-buzzer-fish-slots! ((self fisher-game))
  (let* ((task (fisher-buzzer-task-for-location self))
      (collected (buzzer-count *game-info* task))
      (remaining (- 7 collected))
      (spawn-count 0)
      (first-index -1)
      (second-index -1)
      (start-index (rand-vu-int-range 0 6)))

    (when
      (and
        ;; Training never owns Scout Fly fish.  The ten-orb Fisherman quest
        ;; directly awards all four training cells instead.
        (!= (-> self location-id) (the-as int (fisher-zone training-lagoon)))
        (> remaining 0)
        (> (-> self fish-count) 0)
        (rand-vu-percent? (if *fisher-in-debug?* 0.90 0.33)))

      (set! spawn-count 1)

      (set! first-index
        (fisher-find-missing-buzzer-index task start-index -1))

      (when (>= first-index 0)
        (let ((slot (- (-> self fish-count) 1)))
          ;; Do not let a Scout Fly insertion overwrite either Mountain Pass
          ;; Cell Fish, a local cell carrier, or a protected Hub 2 shark.
          (while
            (and
              (>= slot 0)
              (or
                (> (fisher-fish-power-cell-task self slot) 1)
                (= (fisher-fish-species self slot)
                  (the-as int (fisher-species electric-lurker-shark)))
                (= (fisher-fish-species self slot)
                  (the-as int (fisher-species black-lurker-shark)))))
            (-! slot 1))

          (when (>= slot 0)
            (fisher-set-fish-species! self slot 4)
            (fisher-set-fish-power-cell-task! self slot 0)
            (fisher-set-fish-suffix! self slot 2)
            (fisher-set-fish-level!
              self
              slot
              (fisher-roll-level-for-current-zone self))
            (fisher-set-fish-weight-tenths! self slot first-index)

            (let ((old-fish (fisher-fish-pointer self slot)))
              (when old-fish
                (fisher-destroy-manipy! old-fish)
                (fisher-set-fish-pointer!
                  self
                  slot
                  (the-as (pointer manipy) #f)))))))

      (when (= spawn-count 2)
        (set! second-index
          (fisher-find-missing-buzzer-index task (+ start-index 1) first-index))

        (when (>= second-index 0)
          (let ((slot (- (-> self fish-count) 2)))
            (fisher-set-fish-species! self slot 4)
            (fisher-set-fish-power-cell-task! self slot 0)
            (fisher-set-fish-suffix! self slot 2)
            (fisher-set-fish-level!
              self
              slot
              (fisher-roll-level-in-range
                (-> self fish-level-min)
                (-> self fish-level-max)))
            (fisher-set-fish-weight-tenths! self slot second-index)

            (let ((old-fish (fisher-fish-pointer self slot)))
              (when old-fish
                (fisher-destroy-manipy! old-fish)
                (fisher-set-fish-pointer!
                  self
                  slot
                  (the-as (pointer manipy) #f))))))))

    (none)))

(defun fisher-configure-sandover-table! ((self fisher-game))
  (let ((zone (fisher-zone-info-for (fisher-zone sandover-dock))))
    (set! (-> self fish-level-min) (-> zone level-min))
    (set! (-> self fish-level-max) (-> zone level-max))

  (let ((eco-count 0)
      (largemouth-count 0))

    (cond
      ((fisher-golden-hour?)
        (set! eco-count (rand-vu-int-range (-> zone golden-min 0) (-> zone golden-max 0)))
        (set! largemouth-count (rand-vu-int-range (-> zone golden-min 1) (-> zone golden-max 1))))

      (else
        (set! eco-count (rand-vu-int-range (-> zone normal-min 0) (-> zone normal-max 0)))
        (set! largemouth-count (rand-vu-int-range (-> zone normal-min 1) (-> zone normal-max 1)))))

    (set! (-> self sandover-eco-count) eco-count)
    (set! (-> self sandover-largemouth-count) largemouth-count)

    (fisher-assign-table-slots!
      self
      eco-count
      largemouth-count
      0))

  (none)))

(defun fisher-configure-training-lagoon-table! ((self fisher-game))
  (let* ((zone (fisher-zone-info-for (fisher-zone training-lagoon)))
      (eco-count (rand-vu-int-range (-> zone normal-min 0) (-> zone normal-max 0)))
      (largemouth-count (rand-vu-int-range (-> zone normal-min 1) (-> zone normal-max 1))))

    (set! (-> self fish-level-min) (-> zone level-min))
    (set! (-> self fish-level-max) (-> zone level-max))
    (set! (-> self sandover-eco-count) eco-count)
    (set! (-> self sandover-largemouth-count) largemouth-count)

    (fisher-assign-table-slots!
      self
      eco-count
      largemouth-count
      0))

  (none))

(defun fisher-configure-jungle-pillar-table! ((self fisher-game))
  (let* ((zone (fisher-zone-info-for (fisher-zone jungle-pillar)))
      (golden? (fisher-golden-hour?))
      (total-count
        (if golden?
          (rand-vu-int-range (-> zone golden-fish-count-min) (-> zone golden-fish-count-max))
          (rand-vu-int-range (-> zone normal-fish-count-min) (-> zone normal-fish-count-max))))
      (babak-count
        (if golden?
          (rand-vu-int-range (-> zone golden-min 0) (-> zone golden-max 0))
          (rand-vu-int-range (-> zone normal-min 0) (-> zone normal-max 0))))
      (remaining-count (- total-count babak-count))
      (largemouth-count (rand-vu-int-range 1 remaining-count))
      (eco-count (- remaining-count largemouth-count)))

    (set! (-> self fish-level-min) (-> zone level-min))
    (set! (-> self fish-level-max) (-> zone level-max))
    (set! (-> self sandover-eco-count) eco-count)
    (set! (-> self sandover-largemouth-count) largemouth-count)

    (fisher-assign-table-slots! self eco-count largemouth-count babak-count)

    (when (> (-> zone shark-chance) 0.0)
      (fisher-add-lurker-shark-slot! self)))

  (none))

(defun fisher-configure-sentinel-pontoon-table! ((self fisher-game))
  (let* ((zone (fisher-zone-info-for (fisher-zone sentinel-pontoon)))
      (golden? (fisher-golden-hour?))
      (total-count
        (if golden?
          (rand-vu-int-range (-> zone golden-fish-count-min) (-> zone golden-fish-count-max))
          (rand-vu-int-range (-> zone normal-fish-count-min) (-> zone normal-fish-count-max))))
      (babak-count (rand-vu-int-range 1 (- total-count 2)))
      (remaining-count (- total-count babak-count))
      (largemouth-count (rand-vu-int-range 1 (- remaining-count 1)))
      (eco-count (- remaining-count largemouth-count)))

    (set! (-> self fish-level-min) (-> zone level-min))
    (set! (-> self fish-level-max) (-> zone level-max))
    (set! (-> self sandover-eco-count) eco-count)
    (set! (-> self sandover-largemouth-count) largemouth-count)

    (fisher-assign-table-slots! self eco-count largemouth-count babak-count)

    (when (> (-> zone shark-chance) 0.0)
      (fisher-add-lurker-shark-slot! self)))

  (none))

(defun fisher-configure-misty-table! ((self fisher-game))
  (let* ((zone (fisher-zone-info-for (fisher-zone misty-island)))
      (golden? (fisher-golden-hour?))
      (largemouth-count
        (if golden?
          (rand-vu-int-range (-> zone golden-min 0) (-> zone golden-max 0))
          (rand-vu-int-range (-> zone normal-min 0) (-> zone normal-max 0))))
      (babak-count
        (if golden?
          (rand-vu-int-range (-> zone golden-min 1) (-> zone golden-max 1))
          (rand-vu-int-range (-> zone normal-min 1) (-> zone normal-max 1))))
      (eel-count
        (if golden?
          (rand-vu-int-range (-> zone golden-min 2) (-> zone golden-max 2))
          (rand-vu-int-range (-> zone normal-min 2) (-> zone normal-max 2))))
      (shark-count (if (rand-vu-percent? (-> zone shark-chance)) 1 0))
      (slot 0))

    (set! (-> self fish-level-min) (-> zone level-min))
    (set! (-> self fish-level-max) (-> zone level-max))
    (set! (-> self fish-count)
      (min *fisher-max-fish-slots* (+ largemouth-count babak-count eel-count shark-count)))
    (set! (-> self sandover-eco-count) eel-count)
    (set! (-> self sandover-largemouth-count) largemouth-count)

    (fisher-clear-power-cell-tasks! self)

    (when (> shark-count 0)
      (fisher-configure-random-fish-slot! self slot (the-as int (fisher-species lurker-shark)))
      (+! slot 1))

    (dotimes (i babak-count)
      (when (< slot (-> self fish-count))
        (fisher-configure-random-fish-slot! self slot (the-as int (fisher-species babak-ecofish)))
        (+! slot 1)))

    (dotimes (i largemouth-count)
      (when (< slot (-> self fish-count))
        (fisher-configure-random-fish-slot! self slot (the-as int (fisher-species largemouth-ecofish)))
        (+! slot 1)))

    (while (< slot (-> self fish-count))
      (fisher-configure-random-fish-slot! self slot (the-as int (fisher-species poisonous-eelfish)))
      (+! slot 1)))

  (none))


(defun fisher-configure-village2-table! ((self fisher-game))
  (let* ((zone (fisher-zone-info-for (fisher-zone village2-electric)))
      (golden? (fisher-golden-hour?))
      (grub-count
        (if golden?
          (rand-vu-int-range 4 8)
          (rand-vu-int-range 2 4)))
      (eel-count
        (if golden?
          (rand-vu-int-range 12 16)
          (rand-vu-int-range 8 12)))
      (shark-count 2)
      (slot 0))

    (set! (-> self fish-level-min) (-> zone level-min))
    (set! (-> self fish-level-max) (-> zone level-max))
    (set! (-> self fish-count)
      (min *fisher-max-fish-slots* (+ shark-count grub-count eel-count)))
    (fisher-clear-power-cell-tasks! self)

    (dotimes (i shark-count)
      (when (< slot (-> self fish-count))
        (fisher-set-fish-species!
          self slot (the-as int (fisher-species electric-lurker-shark)))
        (fisher-set-fish-suffix! self slot (fisher-roll-standard-fish-suffix))
        (fisher-set-fish-level! self slot (fisher-roll-level-for-current-zone self))
        (fisher-set-fish-weight-tenths! self slot (rand-vu-int-range 300 600))
        (+! slot 1)))

    (dotimes (i grub-count)
      (when (< slot (-> self fish-count))
        (fisher-configure-random-fish-slot!
          self slot (the-as int (fisher-species electric-grubfish)))
        (+! slot 1)))

    (while (< slot (-> self fish-count))
      (fisher-configure-random-fish-slot!
        self slot (the-as int (fisher-species electric-eelfish)))
      (+! slot 1)))

  (none))


(defun fisher-configure-sunken-table! ((self fisher-game))
  (let* ((zone (fisher-zone-info-for (fisher-zone sunken-voltage)))
      (golden? (fisher-golden-hour?))
      (grub-count
        (if golden?
          (rand-vu-int-range 9 12)
          (rand-vu-int-range 6 8)))
      (eel-count
        (if golden?
          (rand-vu-int-range 6 8)
          (rand-vu-int-range 4 5)))
      (shark-count 1)
      (slot 0))

    (set! (-> self fish-level-min) (-> zone level-min))
    (set! (-> self fish-level-max) (-> zone level-max))
    (set! (-> self fish-count)
      (min *fisher-max-fish-slots* (+ shark-count grub-count eel-count)))
    (fisher-clear-power-cell-tasks! self)

    (dotimes (i shark-count)
      (when (< slot (-> self fish-count))
        (fisher-set-fish-species!
          self slot (the-as int (fisher-species electric-lurker-shark)))
        (fisher-set-fish-suffix! self slot (fisher-roll-standard-fish-suffix))
        (fisher-set-fish-level! self slot (fisher-roll-level-for-current-zone self))
        (fisher-set-fish-weight-tenths! self slot (rand-vu-int-range 300 600))
        (+! slot 1)))

    (dotimes (i grub-count)
      (when (< slot (-> self fish-count))
        (fisher-configure-random-fish-slot!
          self slot (the-as int (fisher-species electric-grubfish)))
        (+! slot 1)))

    (while (< slot (-> self fish-count))
      (fisher-configure-random-fish-slot!
        self slot (the-as int (fisher-species electric-eelfish)))
      (+! slot 1)))

  (none))


(defun fisher-configure-swamp-table! ((self fisher-game))
  (let* ((zone (fisher-zone-info-for (fisher-zone swamp-sludge)))
      (golden? (fisher-golden-hour?))
      (guppie-count
        (if golden?
          (rand-vu-int-range 8 10)
          (rand-vu-int-range 5 6)))
      (crappie-count
        (if golden?
          (rand-vu-int-range 8 10)
          (rand-vu-int-range 5 6)))
      (shark-count 1)
      (slot 0))

    (set! (-> self fish-level-min) (-> zone level-min))
    (set! (-> self fish-level-max) (-> zone level-max))
    (set! (-> self fish-count)
      (min *fisher-max-fish-slots* (+ shark-count guppie-count crappie-count)))
    (fisher-clear-power-cell-tasks! self)

    ;; Keep the one Black Lurker Shark in slot zero so passive collectible
    ;; conversions at the end of the table never replace it.
    (when (< slot (-> self fish-count))
      (fisher-set-fish-species!
        self slot (the-as int (fisher-species black-lurker-shark)))
      (fisher-set-fish-suffix! self slot (fisher-roll-standard-fish-suffix))
      (fisher-set-fish-level! self slot (fisher-roll-level-for-current-zone self))
      (fisher-set-fish-weight-tenths! self slot (rand-vu-int-range 60 100))
      (+! slot 1))

    (dotimes (i guppie-count)
      (when (< slot (-> self fish-count))
        (fisher-configure-random-fish-slot!
          self slot (the-as int (fisher-species swamp-guppie)))
        (+! slot 1)))

    (while (< slot (-> self fish-count))
      (fisher-configure-random-fish-slot!
        self slot (the-as int (fisher-species sludge-crappie)))
      (+! slot 1)))

  (none))


(defun fisher-configure-zone-table! ((self fisher-game))
  ;; Build every ordinary population directly from fisher-zone-info.  The old
  ;; area-specific builders hardcoded species, and hidden growth randomized a
  ;; blank slot without assigning its species, which made it default to Eco Drum.
  (let* ((zone
          (fisher-zone-info-for
            (the-as fisher-zone (-> self location-id))))
         (golden? (fisher-golden-hour?))
         (target-count
          (min
            *fisher-max-fish-slots*
            (if golden?
              (rand-vu-int-range
                (-> zone golden-fish-count-min)
                (-> zone golden-fish-count-max))
              (rand-vu-int-range
                (-> zone normal-fish-count-min)
                (-> zone normal-fish-count-max)))))
         (slot 0)
         (index 0))

    (set! (-> self fish-level-min) (-> zone level-min))
    (set! (-> self fish-level-max) (-> zone level-max))
    (set! (-> self fish-count) target-count)
    (fisher-clear-power-cell-tasks! self)

    ;; Fill the explicit species ranges in table order.
    (while (and (< index 4) (< slot target-count))
      (let* ((range-max
              (if golden?
                (-> zone golden-max index)
                (-> zone normal-max index)))
             (range-min
              (if golden?
                (-> zone golden-min index)
                (-> zone normal-min index)))
             (species (-> zone species index))
             (count
              (if (> range-max 0)
                (rand-vu-int-range range-min range-max)
                0)))

        (dotimes (i count)
          (when (< slot target-count)
            (fisher-configure-random-fish-slot!
              self
              slot
              species)
            (+! slot 1))))
      (+! index 1))

    ;; If the rolled ranges did not reach the zone's total target, use the
    ;; first table species rather than silently falling back to species 0.
    (while (< slot target-count)
      (fisher-configure-random-fish-slot!
        self
        slot
        (-> zone species 0))
      (+! slot 1))

    ;; Shark chance replaces the last ordinary resident; it never raises count.
    (when
      (and
        (> target-count 0)
        (> (-> zone shark-chance) 0.0)
        (rand-vu-percent? (-> zone shark-chance)))
      (let ((shark-slot (- target-count 1)))
        (fisher-configure-random-fish-slot!
          self
          shark-slot
          (the-as int (fisher-species lurker-shark)))
        (fisher-set-fish-suffix!
          self
          shark-slot
          (fisher-roll-standard-fish-suffix))
        (fisher-set-fish-weight-tenths! self shark-slot 260))))

  (none))

(defun fisher-count-live-species ((self fisher-game) (species int))
  (let ((count 0))
    (dotimes (slot (-> self fish-count))
      (when
        (and
          (= (fisher-fish-species self slot) species)
          (fisher-fish-pointer self slot))
        (+! count 1)))
    count))

(defun fisher-table-species-for-new-slot
  ((self fisher-game) (golden? symbol))

  ;; Sunken always maintains exactly one electric shark.  Replacement slots
  ;; preserve the area's grubfish/eelfish population weighting.
  (when
    (= (-> self location-id) (the-as int (fisher-zone sunken-voltage)))
    (when
      (<
        (fisher-count-live-species
          self
          (the-as int (fisher-species electric-lurker-shark)))
        1)
      (return (the-as int (fisher-species electric-lurker-shark))))

    (let ((grub-weight (if golden? 12 8))
        (eel-weight (if golden? 8 5)))
      (if
        (< (rand-vu-int-range 0 (+ grub-weight eel-weight -1)) grub-weight)
        (return (the-as int (fisher-species electric-grubfish)))
        (return (the-as int (fisher-species electric-eelfish))))))

  ;; Village2 always maintains exactly two electric sharks.  Ordinary
  ;; replacement slots then alternate between grubfish and eelfish weights.
  (when
    (= (-> self location-id) (the-as int (fisher-zone village2-electric)))
    (when
      (<
        (fisher-count-live-species
          self
          (the-as int (fisher-species electric-lurker-shark)))
        2)
      (return (the-as int (fisher-species electric-lurker-shark))))

    (let ((grub-weight (if golden? 8 4))
        (eel-weight (if golden? 12 8)))
      (if
        (< (rand-vu-int-range 0 (+ grub-weight eel-weight -1)) grub-weight)
        (return (the-as int (fisher-species electric-grubfish)))
        (return (the-as int (fisher-species electric-eelfish))))))

  ;; Swamp always maintains one Black Lurker Shark.  Remaining replacement
  ;; slots use the current Guppie/Crappie population weights.
  (when
    (= (-> self location-id) (the-as int (fisher-zone swamp-sludge)))
    (when
      (<
        (fisher-count-live-species
          self
          (the-as int (fisher-species black-lurker-shark)))
        1)
      (return (the-as int (fisher-species black-lurker-shark))))

    (let ((guppie-weight (if golden? 10 6))
        (crappie-weight (if golden? 10 6)))
      (if
        (<
          (rand-vu-int-range
            0
            (+ guppie-weight crappie-weight -1))
          guppie-weight)
        (return (the-as int (fisher-species swamp-guppie)))
        (return (the-as int (fisher-species sludge-crappie))))))

  ;; Pick a configured species using the current table's maximum ranges as
  ;; weights.  This is used only when an invisible normal/golden transition
  ;; grows the live pool.
  (let* ((zone
          (fisher-zone-info-for
            (the-as fisher-zone (-> self location-id))))
         (w0 (if golden? (-> zone golden-max 0) (-> zone normal-max 0)))
         (w1 (if golden? (-> zone golden-max 1) (-> zone normal-max 1)))
         (w2 (if golden? (-> zone golden-max 2) (-> zone normal-max 2)))
         (w3 (if golden? (-> zone golden-max 3) (-> zone normal-max 3)))
         (total (+ w0 w1 w2 w3)))

    (when (<= total 0)
      (return (-> zone species 0)))

    (let ((roll (rand-vu-int-range 0 (- total 1))))
      (cond
        ((< roll w0) (-> zone species 0))
        ((< roll (+ w0 w1)) (-> zone species 1))
        ((< roll (+ w0 w1 w2)) (-> zone species 2))
        (else (-> zone species 3))))))

(defun fisher-configure-location-table! ((self fisher-game))
  (cond
    ((= (-> self location-id) (the-as int (fisher-zone village2-electric)))
      (fisher-configure-village2-table! self))
    ((= (-> self location-id) (the-as int (fisher-zone sunken-voltage)))
      (fisher-configure-sunken-table! self))
    ((= (-> self location-id) (the-as int (fisher-zone swamp-sludge)))
      (fisher-configure-swamp-table! self))
    (else
      (fisher-configure-zone-table! self)))

  ;; The training lagoon has no Scout Fly fish.  Its four training cells,
  ;; including the Scout Fly task cell, are awarded by the ten-orb quest.
  (when
    (!= (-> self location-id) (the-as int (fisher-zone training-lagoon)))
    (fisher-add-buzzer-fish-slots! self))

  (fisher-add-power-cell-fish-slot! self)
  (fisher-add-fire-canyon-cellfish-slot! self)
  (fisher-add-mountain-pass-cellfish-slots! self)

  ;; The logical table is the source of truth for gameplay/catch levels.
  (fisher-refresh-active-slot-levels! self)

  (none))

