  (none))

(defun fisher-golden-hour? ()
  (let ((hour
        (if
          *time-of-day-context*
          (-> *time-of-day-context* time)
          12.0)))

    (or
      (>= hour 18.0)
      (< hour 6.0))))

(defun fisher-green-sun-hour? ()
  (let ((hour
        (if
          *time-of-day-context*
          (-> *time-of-day-context* time)
          12.0)))

    (and
      (>= hour 4.0)
      (< hour 5.0))))

