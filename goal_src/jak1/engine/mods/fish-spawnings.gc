      ((= slot 15) (set! (-> self fish-weight-tenths-15) safe-value))
      ((= slot 16) (set! (-> self fish-weight-tenths-16) safe-value))
      ((= slot 17) (set! (-> self fish-weight-tenths-17) safe-value))
      ((= slot 18) (set! (-> self fish-weight-tenths-18) safe-value))
      ((= slot 19) (set! (-> self fish-weight-tenths-19) safe-value))
      ((= slot 20) (set! (-> self fish-weight-tenths-20) safe-value))
      (else (set! (-> self fish-weight-tenths-21) safe-value))))

  (none))

(defun fisher-fish-power-cell-task ((self fisher-game) (slot int))
  (cond
    ((= slot 0) (-> self fish-power-cell-task-0))
    ((= slot 1) (-> self fish-power-cell-task-1))
    ((= slot 2) (-> self fish-power-cell-task-2))
    ((= slot 3) (-> self fish-power-cell-task-3))
    ((= slot 4) (-> self fish-power-cell-task-4))
    ((= slot 5) (-> self fish-power-cell-task-5))
    ((= slot 6) (-> self fish-power-cell-task-6))
    ((= slot 7) (-> self fish-power-cell-task-7))
    ((= slot 8) (-> self fish-power-cell-task-8))
    ((= slot 9) (-> self fish-power-cell-task-9))
    ((= slot 10) (-> self fish-power-cell-task-10))
    ((= slot 11) (-> self fish-power-cell-task-11))
    ((= slot 12) (-> self fish-power-cell-task-12))
    ((= slot 13) (-> self fish-power-cell-task-13))
    ((= slot 14) (-> self fish-power-cell-task-14))
    ((= slot 15) (-> self fish-power-cell-task-15))
    ((= slot 16) (-> self fish-power-cell-task-16))
    ((= slot 17) (-> self fish-power-cell-task-17))
    ((= slot 18) (-> self fish-power-cell-task-18))
    ((= slot 19) (-> self fish-power-cell-task-19))
    ((= slot 20) (-> self fish-power-cell-task-20))
    (else (-> self fish-power-cell-task-21))))

(defun fisher-set-fish-power-cell-task!
  ((self fisher-game) (slot int) (value int))
  (cond
    ((= slot 0) (set! (-> self fish-power-cell-task-0) value))
    ((= slot 1) (set! (-> self fish-power-cell-task-1) value))
    ((= slot 2) (set! (-> self fish-power-cell-task-2) value))
    ((= slot 3) (set! (-> self fish-power-cell-task-3) value))
    ((= slot 4) (set! (-> self fish-power-cell-task-4) value))
    ((= slot 5) (set! (-> self fish-power-cell-task-5) value))
    ((= slot 6) (set! (-> self fish-power-cell-task-6) value))
    ((= slot 7) (set! (-> self fish-power-cell-task-7) value))
    ((= slot 8) (set! (-> self fish-power-cell-task-8) value))
    ((= slot 9) (set! (-> self fish-power-cell-task-9) value))
    ((= slot 10) (set! (-> self fish-power-cell-task-10) value))
    ((= slot 11) (set! (-> self fish-power-cell-task-11) value))
    ((= slot 12) (set! (-> self fish-power-cell-task-12) value))
    ((= slot 13) (set! (-> self fish-power-cell-task-13) value))
    ((= slot 14) (set! (-> self fish-power-cell-task-14) value))
    ((= slot 15) (set! (-> self fish-power-cell-task-15) value))
    ((= slot 16) (set! (-> self fish-power-cell-task-16) value))
    ((= slot 17) (set! (-> self fish-power-cell-task-17) value))
    ((= slot 18) (set! (-> self fish-power-cell-task-18) value))
    ((= slot 19) (set! (-> self fish-power-cell-task-19) value))
    ((= slot 20) (set! (-> self fish-power-cell-task-20) value))
    (else (set! (-> self fish-power-cell-task-21) value)))
  (none))


(defun fisher-roll-standard-fish-suffix ()
  (let ((roll
        (rand-vu-int-range 0 99999)))

    (cond
      ((fisher-green-sun-hour?)
        (cond
          ((< roll 26000) 0)
          ((< roll 47000) 1)
          ((< roll 76000) 2)
          ((< roll 87000) 3)
          ((< roll 96750) 4)
          ((< roll 99750) 5)
          (else 6)))

      ((fisher-golden-hour?)
        (cond
          ((< roll 31000) 0)
          ((< roll 55500) 1)
          ((< roll 85000) 2)
          ((< roll 92500) 3)
          ((< roll 97900) 4)
          ((< roll 99900) 5)
          (else 6)))

      (else
        (cond
          ((< roll 35000) 0)
          ((< roll 62000) 1)
          ((< roll 93000) 2)
          ((< roll 97000) 3)
          ((< roll 99490) 4)
          ((< roll 99990) 5)
          (else 6))))))


(defun fisher-roll-fish-suffix ()
  ;; Normal play: each custom rare is a 1-in-2000 roll per ordinary fish.
  ;; fisher-debug: each rare becomes a 10% roll, for a 40% total rare chance.
  ;; This is intentionally extreme so every custom catch can be tested quickly.
  (let ((rare-roll (rand-vu-int-range 0 99999)))
    (cond
      (*fisher-in-debug?*
        (cond
          ((< rare-roll 10000) 7)   ;; Precursor Fish
          ((< rare-roll 20000) 8)   ;; Oracle's Goldfish
          ((< rare-roll 30000) 9)   ;; Fricked Up Fish
          ((< rare-roll 40000) 10)  ;; Precursor Orb-Eater
          (else (fisher-roll-standard-fish-suffix))))
      (else
        (cond
          ((< rare-roll 50) 7)
          ((< rare-roll 100) 8)
          ((< rare-roll 150) 9)
          ((< rare-roll 200) 10)
          (else (fisher-roll-standard-fish-suffix)))))))

(defun fisher-rare-fish? ((suffix int))
  (and (>= suffix 7) (<= suffix 10)))

(defun fisher-apply-rare-slot-type! ((self fisher-game) (slot int))
  ;; Rare identity is stored in the suffix field. Force a safe ordinary species
  ;; underneath each rare so it never inherits Scout Fly, shark, or poisonous
  ;; EelFish mechanics merely because of the slot it replaced.
  (let ((suffix (fisher-fish-suffix self slot)))
    (cond
      ((= suffix 7) (fisher-set-fish-species! self slot 1))
      ((or (= suffix 8) (= suffix 9) (= suffix 10))
        (fisher-set-fish-species! self slot 0))))
  (none))

(defun fisher-suffix-name ((suffix int))
  (cond
    ((= suffix 0) "MALNUTRITIONED")
    ((= suffix 1) "STRESSED")
    ((= suffix 2) "HEALTHY")
    ((= suffix 3) "MUTANT")
    ((= suffix 4) "RARE")
    ((= suffix 5) "MEGA")
    ((= suffix 6) "GOLDEN")
    ((= suffix 7) "PRECURSOR")
    ((= suffix 8) "ORACLE")
    ((= suffix 9) "FRICKED UP")
    (else "ORB-EATER")))

(defun fisher-species-name
  ((self fisher-game) (species int))

  (cond
    ((= species 1)
      "LARGEMOUTH ECOFISH")

    ((= species 2)
      "BABAK ECOFISH")

    ((= species 3)
      "LURKER SHARK")

    ((= species 4)
      "SCOUT FLY")

    ((= species 5)
      "POISONOUS EELFISH")

    (else
      "ECO DRUM")))

(defun fisher-suffix-value-multiplier ((suffix int))
  (cond
    ((= suffix 0) 0.50)
    ((= suffix 1) 0.75)
    ((= suffix 2) 1.00)
    ((= suffix 3) 1.50)
    ((= suffix 4) 2.00)
    ((= suffix 5) 3.00)
    ((= suffix 6) 5.00)
    ;; Custom rares receive their authored bonus below; do not also apply the
    ;; Golden 5x multiplier merely because their IDs are greater than six.
    (else 1.00)))

(defun fisher-roll-fish-weight-tenths
  ((self fisher-game) (slot int))

  (let* ((species
          (fisher-fish-species self slot))

      (suffix
        (fisher-fish-suffix self slot))

      (base-weight
        (cond
          ;; Lurker Shark always weighs exactly 26.0 pounds.
          ((= species 3) 260)
          ((= species 5) (rand-vu-int-range 30 40))
          ((= species 1) (rand-vu-int-range 20 50))
          ((= species 2) (rand-vu-int-range 20 41))
          (else (rand-vu-int-range 10 20)))))

    (cond
      ;; Authored custom-rare ranges, in tenths of a pound.
      ((= suffix 7) (rand-vu-int-range 100 151))
      ((= suffix 8) (rand-vu-int-range 30 61))
      ((= suffix 9) (rand-vu-int-range 1 7))
      ((= suffix 10) (rand-vu-int-range 140 241))

      ;; Lurker Sharks and Poisonous EelFish retain their authored weight
      ;; ranges regardless of prefix. Prefix still affects orb value/color.
      ((= species 3) 260)
      ((= species 5) base-weight)

      ((= suffix 0)
        (max
          1
          (the int
            (*
              (the float base-weight)
              (rand-vu-float-range 0.45 0.65)))))

      ((= suffix 1)
        (max
          1
          (the int
            (*
              (the float base-weight)
              (rand-vu-float-range 0.72 0.88)))))

      ((= suffix 5) (* base-weight 2))
      ((= suffix 6) (* base-weight 18))
      (else base-weight))))

(defun fisher-randomize-fish-level-and-weight!
  ((self fisher-game) (slot int))

  (fisher-apply-rare-slot-type! self slot)

  (fisher-set-fish-level!
    self
    slot
    (fisher-roll-level-in-range
      (-> self fish-level-min)
      (-> self fish-level-max)))

  (fisher-set-fish-weight-tenths!
    self
    slot
    (fisher-roll-fish-weight-tenths self slot))

  (none))

(defun fisher-assign-table-slots!
  ((self fisher-game) (eco-count int) (largemouth-count int) (babak-count int))

  (let* ((requested-count
        (+ eco-count largemouth-count babak-count))

      (new-count (min 22 requested-count))

      (babak-slots (min babak-count new-count))

      (largemouth-slots (min largemouth-count (- new-count babak-slots)))

      (i
        0))

    (set! (-> self fish-count) new-count)

    ;; A newly configured session starts with no carried power-cell metadata.
    (dotimes (slot 22)
      (fisher-set-fish-power-cell-task! self slot 0))

    (while (< i new-count)
      (cond
        ((< i babak-slots) (fisher-set-fish-species! self i 2))

        ((< i (+ babak-slots largemouth-slots)) (fisher-set-fish-species! self i 1))

        (else
          (fisher-set-fish-species!
            self
            i
            0)))

      (fisher-set-fish-suffix! self i (fisher-roll-fish-suffix))

      (fisher-randomize-fish-level-and-weight! self i)

      (+! i 1)))

  (none))

(defun fisher-add-lurker-shark-slot!
  ((self fisher-game))

  ;; Sentinel Pontoon and Jungle Pillar have a 30% chance to replace one
  ;; already-generated fish with exactly one Lurker Shark.
  ;;
  ;; When the roll fails, the original fish remains in this slot, so the
  ;; location's total fish count never changes.
  (when
    (and
      (> (-> self fish-count) 0)
      (rand-vu-percent? 0.50))

    (let ((slot
          (- (-> self fish-count) 1)))

      (fisher-set-fish-species! self slot 3)
      (fisher-set-fish-suffix! self slot (fisher-roll-standard-fish-suffix))
      (fisher-set-fish-level!
        self
        slot
        (fisher-roll-level-in-range
          (-> self fish-level-min)
          (-> self fish-level-max)))
      (fisher-set-fish-weight-tenths! self slot 260)))

  (none))

(defun fisher-power-cell-task-count-for-location ((self fisher-game))
  (cond
    ((= (-> self location-id) 4) 5)
    ((or (= (-> self location-id) 1) (= (-> self location-id) 3)) 4)
    (else 0)))

(defun fisher-power-cell-task-for-location-index
  ((self fisher-game) (index int))
  (cond
    ;; Sentinel Pontoon / Sentinel Beach.
    ((= (-> self location-id) 3)
      (cond
        ((= index 0) (game-task beach-ecorocks))
        ((= index 1) (game-task beach-pelican))
        ((= index 2) (game-task beach-gimmie))
        (else (game-task beach-sentinel))))

    ;; Jungle Pillar / Forbidden Jungle.
    ((= (-> self location-id) 1)
      (cond
        ((= index 0) (game-task jungle-tower))
        ((= index 1) (game-task jungle-plant))
        ((= index 2) (game-task jungle-canyon-end))
        (else (game-task jungle-temple-door))))

    ;; Misty Island. The Muse and Cannon cells are intentionally excluded.
    ((= (-> self location-id) 4)
      (cond
        ((= index 0) (game-task misty-boat))
        ((= index 1) (game-task misty-warehouse))
        ((= index 2) (game-task misty-bike))
        ((= index 3) (game-task misty-bike-jump))
        (else (game-task misty-eco-challenge))))

    (else (game-task none))))

(defun fisher-find-missing-power-cell-task ((self fisher-game))
  (let* ((task-count (fisher-power-cell-task-count-for-location self))
      (start
        (if
          (> task-count 0)
          (rand-vu-int-range 0 (- task-count 1))
          0))
      (step 0)
      (task (game-task none)))

    (while (< step task-count)
      (set! task
        (fisher-power-cell-task-for-location-index
          self
          (mod (+ start step) task-count)))

      (when
        (and
          (> (the int task) 1)
          (not (task-complete? *game-info* task)))
        (return task))

      (+! step 1))

    (game-task none)))

(defun fisher-has-power-cell-fish? ((self fisher-game))
  (dotimes (slot (-> self fish-count))
    (when (> (fisher-fish-power-cell-task self slot) 1)
      (return #t)))
  #f)

(defun fisher-add-power-cell-fish-slot! ((self fisher-game))
  ;; Only Jungle Pillar and Sentinel Pontoon can use this mechanic. Exactly one
  ;; active fish may carry a cell, and only one of the four configured tasks
  ;; that Jak has not completed can be selected.
  (when
    (and
      (or
        (= (-> self location-id) 1)
        (= (-> self location-id) 3)
        (= (-> self location-id) 4))
      (> (-> self fish-count) 0)
      (not (fisher-has-power-cell-fish? self))
      (rand-vu-percent?
        (if *fisher-in-debug?* 0.90 *fisher-power-cell-fish-chance*)))

    (let ((task (fisher-find-missing-power-cell-task self)))
      (when (> (the int task) 1)
        (let ((start-slot (rand-vu-int-range 0 (- (-> self fish-count) 1)))
            (step 0)
            (slot -1)
            (candidate 0))

          ;; Scout Fly slots are excluded because their weight field stores the
          ;; unique 0..6 fly index. Every real fish species, including the
          ;; Lurker Shark, is eligible.
          (while (and (< step (-> self fish-count)) (< slot 0))
            (set! candidate (mod (+ start-slot step) (-> self fish-count)))
            (when (!= (fisher-fish-species self candidate) 4)
              (set! slot candidate))
            (+! step 1))

          (when (>= slot 0)
            (fisher-set-fish-power-cell-task! self slot (the int task))

            ;; The extra 70% weight affects reeling/fighting and the displayed
            ;; pounds. Orb worth is calculated later from the recovered base
            ;; weight, so the cell itself never increases the orb reward.
            (fisher-set-fish-weight-tenths!
              self
              slot
              (max
                1
                (the int
                  (+
                    (*
                      (the float (fisher-fish-weight-tenths self slot))
                      1.70)
                    0.5)))))))))

  (none))

(defun fisher-buzzer-task-for-location ((self fisher-game))
  (cond
    ((= (-> self location-id) 1) (game-task jungle-buzzer))
    ((= (-> self location-id) 2) (game-task training-buzzer))
    ((= (-> self location-id) 3) (game-task beach-buzzer))
    ((= (-> self location-id) 4) (game-task misty-buzzer))
    (else (game-task village1-buzzer))))

(defun fisher-find-missing-buzzer-index
  ((task game-task) (start int) (exclude int))

  (let ((step 0)
      (index 0))

    (while (< step 7)
      (set! index (mod (+ start step) 7))

      (when
        (and
          (!= index exclude)
          (not (got-buzzer? *game-info* task index)))

        (return index))

      (+! step 1))

    -1))

(defun fisher-add-buzzer-fish-slots! ((self fisher-game))
  ;; One overall 50% roll whenever a Scout Fly group is eligible. These replace ordinary fish,
  ;; so the total number of fish in the area does not increase.
  (let* ((task (fisher-buzzer-task-for-location self))
      (collected (buzzer-count *game-info* task))
      (remaining (- 7 collected))
      (spawn-count 0)
      (first-index -1)
      (second-index -1)
      (start-index (rand-vu-int-range 0 6)))

    (when
      (and
        (> remaining 0)
        (> (-> self fish-count) 0)
        (rand-vu-percent? (if *fisher-in-debug?* 0.90 0.50)))

      (set! spawn-count 1)

      ;; If at least two flies are missing, a successful school has a 35%
      ;; chance to contain a second scout fly.
      (when
        (and
          (> remaining 1)
          (> (-> self fish-count) 1)
          (rand-vu-percent? (if *fisher-in-debug?* 0.75 0.35)))

        (set! spawn-count 2))

      (set! first-index
        (fisher-find-missing-buzzer-index task start-index -1))

      (when (>= first-index 0)
        (let ((slot (- (-> self fish-count) 1)))
          (fisher-set-fish-species! self slot 4)
          (fisher-set-fish-power-cell-task! self slot 0)
          (fisher-set-fish-suffix! self slot 2)
          (fisher-set-fish-level!
            self
            slot
            (fisher-roll-level-in-range
              (-> self fish-level-min)
              (-> self fish-level-max)))
          ;; Species 4 uses the weight field to retain its unique 0..6 fly ID.
          (fisher-set-fish-weight-tenths! self slot first-index)

          ;; During a live reroll this slot may still contain an ordinary fish
          ;; process. Remove it so fisher-refill-missing-fish! creates the
          ;; correct Scout Fly process using *buzzer-sgc*.
          (let ((old-fish (fisher-fish-pointer self slot)))
            (when old-fish
              (deactivate (-> old-fish 0))
              (fisher-set-fish-pointer!
                self
                slot
                (the-as (pointer manipy) #f))))))

      (when (= spawn-count 2)
        (set! second-index
          (fisher-find-missing-buzzer-index task (+ start-index 1) first-index))

        (when (>= second-index 0)
          (let ((slot (- (-> self fish-count) 2)))
            (fisher-set-fish-species! self slot 4)
            (fisher-set-fish-power-cell-task! self slot 0)
            (fisher-set-fish-suffix! self slot 2)
            (fisher-set-fish-level!
              self
              slot
              (fisher-roll-level-in-range
                (-> self fish-level-min)
                (-> self fish-level-max)))
            (fisher-set-fish-weight-tenths! self slot second-index)

            ;; As above, force a live ordinary-fish process to be recreated as
            ;; the selected Scout Fly.
            (let ((old-fish (fisher-fish-pointer self slot)))
              (when old-fish
                (deactivate (-> old-fish 0))
                (fisher-set-fish-pointer!
                  self
                  slot
                  (the-as (pointer manipy) #f))))))))

  (none)))

(defun fisher-configure-sandover-table! ((self fisher-game))
  (set! (-> self fish-level-min) 1)
  (set! (-> self fish-level-max) 3)

  (let ((eco-count 0)
      (largemouth-count 0))

    (cond
      ((fisher-golden-hour?) (set! eco-count (rand-vu-int-range 6 8)) (set! largemouth-count (rand-vu-int-range 2 6)))

      (else
        (set! eco-count (rand-vu-int-range 2 3))
        (set! largemouth-count (rand-vu-int-range 1 3))))

    (set! (-> self sandover-eco-count) eco-count)
    (set! (-> self sandover-largemouth-count) largemouth-count)

    (fisher-assign-table-slots!
      self
      eco-count
      largemouth-count
      0))

  (none))

(defun fisher-configure-training-lagoon-table! ((self fisher-game))
  (set! (-> self fish-level-min) 1)
  (set! (-> self fish-level-max) 1)

  (let ((eco-count
        (rand-vu-int-range 2 3))

      (largemouth-count
        (rand-vu-int-range 4 5)))

    (set! (-> self sandover-eco-count) eco-count)

    ;; Training uses the secondary species slot for Largemouth Ecofish.
    (set! (-> self sandover-largemouth-count) largemouth-count)

    (fisher-assign-table-slots!
      self
      eco-count
      largemouth-count
      0))

  (none))

(defun fisher-configure-jungle-pillar-table! ((self fisher-game))
  (set! (-> self fish-level-min) 5)
  (set! (-> self fish-level-max) 8)

  (let ((total-count 0)
      (eco-count 0)
      (largemouth-count 0)
      (babak-count 0)
      (remaining-count 0))

    (cond
      ((fisher-golden-hour?) (set! total-count (rand-vu-int-range 16 23)) (set! babak-count (rand-vu-int-range 4 7)))

      (else
        (set! total-count (rand-vu-int-range 8 15))
        (set! babak-count (rand-vu-int-range 1 4))))

    (set! remaining-count (- total-count babak-count))

    (set! largemouth-count (rand-vu-int-range 1 remaining-count))

    (set! eco-count (- remaining-count largemouth-count))

    (set! (-> self sandover-eco-count) eco-count)
    (set! (-> self sandover-largemouth-count) largemouth-count)

    (fisher-assign-table-slots!
      self
      eco-count
      largemouth-count
      babak-count)

    (fisher-add-lurker-shark-slot! self))

  (none))

(defun fisher-configure-sentinel-pontoon-table! ((self fisher-game))
  (set! (-> self fish-level-min) 2)
  (set! (-> self fish-level-max) 4)

  (let ((total-count 0)
      (eco-count 0)
      (largemouth-count 0)
      (babak-count 0)
      (remaining-count 0))

    (if
      (fisher-golden-hour?)
      (set! total-count (rand-vu-int-range 12 14))
      (set! total-count (rand-vu-int-range 5 8)))

    ;; Keep all three Sentinel species represented while allowing the
    ;; exact mix to vary each time the fishing session is configured.
    (set! babak-count (rand-vu-int-range 1 (- total-count 2)))
    (set! remaining-count (- total-count babak-count))
    (set! largemouth-count (rand-vu-int-range 1 (- remaining-count 1)))
    (set! eco-count (- remaining-count largemouth-count))

    (set! (-> self sandover-eco-count) eco-count)
    (set! (-> self sandover-largemouth-count) largemouth-count)

    (fisher-assign-table-slots!
      self
      eco-count
      largemouth-count
      babak-count)

    (fisher-add-lurker-shark-slot! self))

  (none))

(defun fisher-configure-misty-table! ((self fisher-game))
  (set! (-> self fish-level-min) 8)
  (set! (-> self fish-level-max) 13)

  (let ((largemouth-count 0)
      (babak-count 0)
      (eel-count 0)
      (shark-count 0)
      (slot 0))

    (cond
      ((fisher-golden-hour?)
        (set! largemouth-count (rand-vu-int-range 3 4))
        (set! babak-count (rand-vu-int-range 1 2))
        (set! eel-count (rand-vu-int-range 6 10)))

      (else
        (set! largemouth-count (rand-vu-int-range 1 3))
        (set! babak-count 1)
        (set! eel-count (rand-vu-int-range 5 6))))

    ;; Misty has a 38% chance to include exactly one Lurker Shark in addition
    ;; to the requested Largemouth, Babak, and Poisonous EelFish counts.
    (when (rand-vu-percent? 0.38)
      (set! shark-count 1))

    (set!
      (-> self fish-count)
      (min
        22
        (+ largemouth-count babak-count eel-count shark-count)))

    (set! (-> self sandover-eco-count) eel-count)
    (set! (-> self sandover-largemouth-count) largemouth-count)

    (dotimes (i 22)
      (fisher-set-fish-power-cell-task! self i 0))

    ;; Put the shark first so later Scout Fly replacements cannot erase a
    ;; successful 38% shark roll.
    (when (> shark-count 0)
      (fisher-set-fish-species! self slot 3)
      (fisher-set-fish-suffix! self slot (fisher-roll-fish-suffix))
      (fisher-randomize-fish-level-and-weight! self slot)
      (+! slot 1))

    (dotimes (i babak-count)
      (when (< slot (-> self fish-count))
        (fisher-set-fish-species! self slot 2)
        (fisher-set-fish-suffix! self slot (fisher-roll-fish-suffix))
        (fisher-randomize-fish-level-and-weight! self slot)
        (+! slot 1)))

    (dotimes (i largemouth-count)
      (when (< slot (-> self fish-count))
        (fisher-set-fish-species! self slot 1)
        (fisher-set-fish-suffix! self slot (fisher-roll-fish-suffix))
        (fisher-randomize-fish-level-and-weight! self slot)
        (+! slot 1)))

    (while (< slot (-> self fish-count))
      (fisher-set-fish-species! self slot 5)
      (fisher-set-fish-suffix! self slot (fisher-roll-fish-suffix))
      (fisher-randomize-fish-level-and-weight! self slot)
      (+! slot 1)))

  (none))

(defun fisher-configure-location-table! ((self fisher-game))
  (cond
    ((= (-> self location-id) 1)
      (fisher-configure-jungle-pillar-table! self))

    ((= (-> self location-id) 2)
      (fisher-configure-training-lagoon-table! self))

    ((= (-> self location-id) 3)
      (fisher-configure-sentinel-pontoon-table! self))

    ((= (-> self location-id) 4)
      (fisher-configure-misty-table! self))

    (else
      (fisher-configure-sandover-table! self)))

  (fisher-add-buzzer-fish-slots! self)
  (fisher-add-power-cell-fish-slot! self)

  (none))

(define *fisher-precursor-attachment-offset-game*
  (new 'static 'vector :y (meters 0.22) :w 0.0))

(define *fisher-precursor-attachment-offset-catch*
  (new 'static 'vector :y (meters 0.40) :w 0.0))

(define *fisher-oracle-attachment-offset-game*
  (new 'static 'vector :y (meters 0.20) :w 0.0))

(define *fisher-oracle-attachment-offset-catch*
  (new 'static 'vector :y (meters 0.38) :w 0.0))

(define *fisher-orb-attachment-offset-a-game*
  (new 'static 'vector :x (meters -0.15) :y (meters 0.02) :z (meters 0.10) :w 0.0))

(define *fisher-orb-attachment-offset-b-game*
  (new 'static 'vector :x (meters 0.00) :y (meters 0.16) :z (meters -0.04) :w 0.0))

(define *fisher-orb-attachment-offset-c-game*
  (new 'static 'vector :x (meters 0.15) :y (meters -0.02) :z (meters 0.08) :w 0.0))

(define *fisher-orb-attachment-offset-a-catch*
  (new 'static 'vector :x (meters -0.27) :y (meters 0.04) :z (meters 0.16) :w 0.0))

(define *fisher-orb-attachment-offset-b-catch*
  (new 'static 'vector :x (meters 0.00) :y (meters 0.28) :z (meters -0.07) :w 0.0))

(define *fisher-orb-attachment-offset-c-catch*
  (new 'static 'vector :x (meters 0.27) :y (meters -0.04) :z (meters 0.13) :w 0.0))

(defun fisher-update-rare-attachment-transform! ((self manipy))
  (let ((parent-proc (ppointer->process (-> self parent)))
      (offset (-> self root transv)))

    (when
      (and
        parent-proc
        offset
        (type-type? (-> parent-proc type) process-drawable))

      (let ((parent-drawable (the-as process-drawable parent-proc))
          (rotation (new 'stack-no-clear 'matrix))
          (rotated-offset (new 'stack-no-clear 'vector)))

        ;; Keep each attachment in the fish's local space. This is important
        ;; for the three precursor orbs: they should turn with the fish rather
        ;; than remaining at fixed world-space offsets.
        (quaternion->matrix rotation (-> parent-drawable root quat))
        (vector-rotate*! rotated-offset offset rotation)
        (set! (-> rotated-offset w) 0.0)

        (vector+!
          (-> self root trans)
          (-> parent-drawable root trans)
          rotated-offset)

        (set! (-> self root trans w) 1.0)

        (quaternion-copy!
          (-> self root quat)
          (-> parent-drawable root quat)))))

  (none))

(defbehavior fisher-rare-attachment-trans manipy ()
  (fisher-update-rare-attachment-transform! self)
  (none))

(defbehavior fisher-precursor-towertop-trans manipy ()
  (fisher-update-rare-attachment-transform! self)

  ;; The retail towertop state advances towertop-idle-ja with a 0.4 seek rate.
  ;; Keep the miniature tower on Precursor Fish spinning at that same rate.
  (ja :group! towertop-idle-ja :num! (loop! 0.4))

  (none))

(defun fisher-spawn-rare-attachment!
  ((fish-proc manipy)
   (skel skeleton-group)
   (offset vector)
   (scale float)
   (attachment-name string))

  (let ((attachment
        (manipy-spawn
          (-> fish-proc root trans)
          #f
          skel
          #f
          :from *default-dead-pool*
          :to fish-proc
          :name attachment-name)))

    (when attachment
      (let ((attachment-proc
            (the-as manipy (ppointer->process attachment))))

        (when attachment-proc
          (set! (-> attachment-proc root transv quad) (-> offset quad))
          (set! (-> attachment-proc root transv w) 0.0)
          (send-event attachment-proc 'max-vis-dist (meters 999999.0))

          (set-vector!
            (-> attachment-proc root scale)
            scale scale scale 1.0)

          (cond
            ((= skel *towertop-sgc*)
              ;; The custom trans hook advances the animation at the retail
              ;; tower's exact 0.4 rate, so the normal manipy loop must stay off.
              (send-event attachment-proc 'anim-mode 'still)
              (send-event
                attachment-proc
                'trans-hook
                fisher-precursor-towertop-trans))

            (else
              (send-event attachment-proc 'anim-mode 'loop)
              (send-event
                attachment-proc
                'trans-hook
                fisher-rare-attachment-trans)))))))

  (none))

(defun fisher-spawn-rare-fish-attachments!
  ((fish-proc manipy) (suffix int) (catch-display? symbol))

  (cond
    ((= suffix 7)
      (fisher-spawn-rare-attachment!
        fish-proc
        *towertop-sgc*
        (if catch-display?
          *fisher-precursor-attachment-offset-catch*
          *fisher-precursor-attachment-offset-game*)
        (if catch-display? 0.025 0.015)
        "fisher-precursor-towertop"))

    ((= suffix 8)
      (fisher-spawn-rare-attachment!
        fish-proc
        *oracle-sgc*
        (if catch-display?
          *fisher-oracle-attachment-offset-catch*
          *fisher-oracle-attachment-offset-game*)
        (if catch-display? 0.16 0.10)
        "fisher-oracle-statue"))

    ((= suffix 10)
      (fisher-spawn-rare-attachment!
        fish-proc *money-sgc*
        (if catch-display?
          *fisher-orb-attachment-offset-a-catch*
          *fisher-orb-attachment-offset-a-game*)
        (if catch-display? 0.65 0.42)
        "fisher-orb-eater-orb-a")

      (fisher-spawn-rare-attachment!
        fish-proc *money-sgc*
        (if catch-display?
          *fisher-orb-attachment-offset-b-catch*
          *fisher-orb-attachment-offset-b-game*)
        (if catch-display? 0.58 0.38)
        "fisher-orb-eater-orb-b")

      (fisher-spawn-rare-attachment!
        fish-proc *money-sgc*
        (if catch-display?
          *fisher-orb-attachment-offset-c-catch*
          *fisher-orb-attachment-offset-c-game*)
        (if catch-display? 0.62 0.40)
        "fisher-orb-eater-orb-c")))

  (none))

(defun fisher-apply-slot-appearance!
  ((self fisher-game) (slot int) (fish-proc manipy) (catch-display? symbol))

  (let* ((suffix
        (fisher-fish-suffix self slot))

      (species (fisher-fish-species self slot))

      (power-cell-task (fisher-fish-power-cell-task self slot))

      (base-scale
        (cond
          ((= species 3) (if catch-display? 0.78 0.56))

          ((= species 4) (if catch-display? 0.72 0.48))

          ((= species 5) (if catch-display? 0.88 0.66))

          ((= species 2) (if catch-display? 0.95 0.75))

          (catch-display? 0.55)

          (else
            0.30)))

      (x-scale 1.0)

      (y-scale 1.0)

      (z-scale 1.0)

      ;; Shark art must retain its authored colors.
      (r (cond ((= species 4) 1.00) ((= species 3) 1.00) ((= species 5) 0.38) ((= species 1) 0.32) ((= species 2) 1.00) (else 0.25)))

      (g (cond ((= species 4) 1.00) ((= species 3) 1.00) ((= species 5) 1.00) ((= species 1) 0.78) ((= species 2) 1.00) (else 0.88)))

      (b
        (cond
          ((= species 4) 1.00)
          ((= species 3) 1.00)
          ((= species 5) 0.30)
          ((= species 1) 0.25)
          ((= species 2) 1.00)
          (else 1.00))))

    ;; Custom rares own their body shape and color. They intentionally skip the
    ;; ordinary prefix deformation/color rules below.
    (cond
      ((= suffix 7)
        ;; Precursor Fish: bronze fishb body.
        (set! r 0.62)
        (set! g 0.36)
        (set! b 0.12)
        (set! base-scale (if catch-display? 0.62 0.34)))

      ((= suffix 8)
        ;; Oracle's Goldfish: rich gold/orange body.
        (set! r 1.00)
        (set! g 0.56)
        (set! b 0.06)
        (set! base-scale (if catch-display? 0.62 0.34)))

      ((= suffix 9)
        ;; Fricked Up Fish: unnaturally thin, stretched, and sickly.
        (set! r 0.56)
        (set! g 0.82)
        (set! b 0.62)
        (set! base-scale (if catch-display? 0.68 0.38))
        (set! x-scale 0.13)
        (set! y-scale 0.20)
        (set! z-scale 2.35))

      ((= suffix 10)
        ;; Precursor Orb-Eater: swollen warm-colored body around the orbs.
        (set! r 0.82)
        (set! g 0.48)
        (set! b 0.16)
        (set! base-scale (if catch-display? 0.68 0.38))
        (set! x-scale 1.18)
        (set! y-scale 1.12)
        (set! z-scale 1.18)))

    ;; Prefix shape/size effects remain available. The shark preserves its
    ;; authored color except for Mutant and Golden.
    (when
      (and (not (fisher-rare-fish? suffix)) (= suffix 0))
      (set! x-scale 0.84)
      (set! z-scale 1.10))

    (when
      (and (not (fisher-rare-fish? suffix)) (= suffix 5))
      (*! x-scale 2.0)
      (*! y-scale 2.0)
      (*! z-scale 2.0))

    (when
      (and
        (not (fisher-rare-fish? suffix))
        (!= species 4)
        (or
          (!= species 3)
          (= suffix 3)
          (= suffix 6)))

      (cond
        ((= suffix 1) (*! r 0.72) (*! g 0.72) (*! b 0.72))

        ((= suffix 3)
        (let ((color-roll
              (mod
                (+ (* slot 3) species)
                5)))

          (cond
            ((= color-roll 0) (set! r 0.20) (set! g 0.95) (set! b 0.25))

            ((= color-roll 1) (set! r 0.65) (set! g 0.20) (set! b 1.00))

            ((= color-roll 2) (set! r 0.10) (set! g 0.85) (set! b 0.95))

            ((= color-roll 3) (set! r 0.95) (set! g 0.15) (set! b 0.55))

            (else
              (set! r 0.85)
              (set! g 0.85)
              (set! b 0.15)))))

      ((= suffix 4) (*! r 1.10) (*! g 1.10) (*! b 1.10))

        ((= suffix 6)
          (set! r 1.00)
          (set! g 0.72)
          (set! b 0.06))))

    (set-vector! (-> fish-proc root scale) (* base-scale x-scale) (* base-scale y-scale) (* base-scale z-scale) 1.0)

    (set! (-> fish-proc draw color-mult r) r)
    (set! (-> fish-proc draw color-mult g) g)
    (set! (-> fish-proc draw color-mult b) b)
    (set! (-> fish-proc draw color-mult a) 1.0)

    ;; The carried-cell glow is supplied by the cloned 3D fuel-cell
    ;; starflash particle. Keep the fish material itself neutral.
    (set! (-> fish-proc draw color-emissive r) 0.0)
    (set! (-> fish-proc draw color-emissive g) 0.0)
    (set! (-> fish-proc draw color-emissive b) 0.0)
    (set! (-> fish-proc draw color-emissive a) 1.0))

  (none))

(defun fisher-fish-pointer
  ((self fisher-game) (slot int))

  (cond
    ((= slot 0) (-> self fish-0))
    ((= slot 1) (-> self fish-1))
    ((= slot 2) (-> self fish-2))
    ((= slot 3) (-> self fish-3))
    ((= slot 4) (-> self fish-4))
    ((= slot 5) (-> self fish-5))
    ((= slot 6) (-> self fish-6))
    ((= slot 7) (-> self fish-7))
    ((= slot 8) (-> self fish-8))
    ((= slot 9) (-> self fish-9))
    ((= slot 10) (-> self fish-10))
    ((= slot 11) (-> self fish-11))
    ((= slot 12) (-> self fish-12))
    ((= slot 13) (-> self fish-13))
    ((= slot 14) (-> self fish-14))
    ((= slot 15) (-> self fish-15))
    ((= slot 16) (-> self fish-16))
    ((= slot 17) (-> self fish-17))
    ((= slot 18) (-> self fish-18))
    ((= slot 19) (-> self fish-19))
    ((= slot 20) (-> self fish-20))
    (else (-> self fish-21))))

(defun fisher-set-fish-pointer!
  ((self fisher-game) (slot int) (fish (pointer manipy)))

  (cond
    ((= slot 0) (set! (-> self fish-0) fish))
    ((= slot 1) (set! (-> self fish-1) fish))
    ((= slot 2) (set! (-> self fish-2) fish))
    ((= slot 3) (set! (-> self fish-3) fish))
    ((= slot 4) (set! (-> self fish-4) fish))
    ((= slot 5) (set! (-> self fish-5) fish))
    ((= slot 6) (set! (-> self fish-6) fish))
    ((= slot 7) (set! (-> self fish-7) fish))
    ((= slot 8) (set! (-> self fish-8) fish))
    ((= slot 9) (set! (-> self fish-9) fish))
    ((= slot 10) (set! (-> self fish-10) fish))
    ((= slot 11) (set! (-> self fish-11) fish))
    ((= slot 12) (set! (-> self fish-12) fish))
    ((= slot 13) (set! (-> self fish-13) fish))
    ((= slot 14) (set! (-> self fish-14) fish))
    ((= slot 15) (set! (-> self fish-15) fish))
    ((= slot 16) (set! (-> self fish-16) fish))
    ((= slot 17) (set! (-> self fish-17) fish))
    ((= slot 18) (set! (-> self fish-18) fish))
    ((= slot 19) (set! (-> self fish-19) fish))
    ((= slot 20) (set! (-> self fish-20) fish))
    (else (set! (-> self fish-21) fish)))

  (none))

(defun fisher-randomize-fish-slot!
  ((self fisher-game) (slot int))

  (fisher-set-fish-distance! self slot (rand-vu-float-range (meters 4.0) (meters 55.0)))

  (fisher-set-fish-lane! self slot (rand-vu-float-range (meters -1.35) (meters 1.35)))

  (fisher-set-fish-depth!
    self
    slot
    (cond
      ((= (fisher-fish-species self slot) 1) (rand-vu-float-range (meters 18.0) (meters 21.0)))

      ((= (fisher-fish-species self slot) 2) (rand-vu-float-range (meters 26.0) (meters 29.0)))

      ;; Lurker Shark is always a deepwater fish.
      ((= (fisher-fish-species self slot) 3)
        (rand-vu-float-range (meters 30.0) (meters 33.0)))

      ;; Scout flies stay in the visible middle/deep band.
      ((= (fisher-fish-species self slot) 4)
        (rand-vu-float-range (meters 17.0) (meters 22.0)))

      ;; Poisonous EelFish patrol the middle/deep water.
      ((= (fisher-fish-species self slot) 5)
        (rand-vu-float-range (meters 21.0) (meters 26.0)))

      (else
        (rand-vu-float-range
          (meters 10.0)
          (meters 13.0)))))

  (fisher-set-fish-direction! self slot (if (rand-vu-percent? 0.5) 1.0 -1.0))

  (fisher-set-fish-speed! self slot (rand-vu-float-range (meters 0.75) (meters 1.55)))

  (fisher-set-fish-cooldown! self slot 0.0)

  (fisher-set-fish-turn-time! self slot 0.0)

  (fisher-set-fish-turn-old-direction! self slot (fisher-fish-direction self slot))

  ;; A scout-fly slot stores its unique fly index in fish-weight-tenths.
  ;; Do not overwrite that index when randomizing its movement.
  (when (!= (fisher-fish-species self slot) 4)
    (fisher-set-fish-suffix! self slot (fisher-roll-fish-suffix))
    (fisher-randomize-fish-level-and-weight! self slot)

    ;; Reapply the 70% carried-cell weight after rolling a fresh base weight.
    (when (> (fisher-fish-power-cell-task self slot) 1)
      (fisher-set-fish-weight-tenths!
        self
        slot
        (max
          1
          (the int
            (+
              (*
                (the float (fisher-fish-weight-tenths self slot))
                1.70)
              0.5))))))

  (none))

(defun fisher-fish-position!
  ((self fisher-game) (slot int) (dst vector))

  (let ((side-axis
        (new 'stack-no-clear 'vector)))

    (set! (-> side-axis x) (-> self playfield-axis z))
    (set! (-> side-axis y) 0.0)
    (set! (-> side-axis z) (- (-> self playfield-axis x)))
    (set! (-> side-axis w) 0.0)

    (singlefish-vector-normalize-safe! side-axis 1.0)

    (singlefish-vector-add-scaled-safe! dst (-> self fishing-player-pos) (-> self playfield-axis) (fisher-fish-distance self slot))

    (singlefish-vector-add-scaled-safe! dst dst side-axis (fisher-fish-lane self slot))

    (set! (-> dst y) (- (-> self water-level) (fisher-fish-depth self slot)))

    (set! (-> dst w) 1.0))

  dst)

(defun fisher-set-manipy-facing!
  ((self fisher-game) (slot int) (fish-proc manipy))

  (let ((forward
        (new 'stack-no-clear 'vector))

      (side-forward (new 'stack-no-clear 'vector))

      (side-axis (new 'stack-no-clear 'vector))

      (down (new 'stack-no-clear 'vector))

      (rot (new 'stack-no-clear 'matrix))

      (turn-time
        (fisher-fish-turn-time self slot)))

    (cond
      ((> turn-time 0.0)
        (let* ((duration
              0.42)

            (progress (fmin 1.0 (/ turn-time duration)))

            (angle
              (* (degrees 180.0) progress)))

          (singlefish-vector-scale-safe! forward (-> self playfield-axis) (* (fisher-fish-turn-old-direction self slot) (cos angle)))

          (set! (-> side-axis x) (-> self playfield-axis z))
          (set! (-> side-axis y) 0.0)
          (set! (-> side-axis z) (- (-> self playfield-axis x)))
          (set! (-> side-axis w) 0.0)

          (singlefish-vector-normalize-safe! side-axis 1.0)

          (singlefish-vector-scale-safe! side-forward side-axis (* (fisher-fish-turn-side self slot) (sin angle)))

          (singlefish-vector-add-safe! forward forward side-forward)

          (+! turn-time (-> *display* seconds-per-frame))

          (if
            (>= turn-time duration)

            (fisher-set-fish-turn-time! self slot 0.0)

            (fisher-set-fish-turn-time!
              self
              slot
              turn-time))))

      (else
        (singlefish-vector-scale-safe!
          forward
          (-> self playfield-axis)
          (fisher-fish-direction self slot))))

    (set! (-> forward y) 0.0)
    (set! (-> forward w) 0.0)

    (singlefish-vector-normalize-safe! forward 1.0)

    (set-vector! down 0.0 -1.0 0.0 0.0)

    (forward-down->inv-matrix rot forward down)

    (matrix->quaternion
      (-> fish-proc root quat)
      rot))

  (none))

(defun fisher-spawn-gameplay-fish
  ((owner fisher-game) (slot int))

  (let ((pos
        (new 'stack-no-clear 'vector))

      (fish
        (the-as (pointer manipy) #f)))

    (fisher-fish-position! owner slot pos)

    (set!
      fish
      (the-as
        (pointer manipy)
        (manipy-spawn
          pos
          #f
          (cond
            ((= (fisher-fish-suffix owner slot) 7) *catch-fishb-sgc*)
            ((= (fisher-fish-suffix owner slot) 8) *catch-fishc-sgc*)
            ((or (= (fisher-fish-suffix owner slot) 9)
                 (= (fisher-fish-suffix owner slot) 10)) *catch-fisha-sgc*)

            ((= (fisher-fish-species owner slot) 1) *catch-fishb-sgc*)

            ((= (fisher-fish-species owner slot) 2) *fisher-junglefish-sg*)

            ((= (fisher-fish-species owner slot) 3) *sharkey-sgc*)

            ((= (fisher-fish-species owner slot) 4) *buzzer-sgc*)

            ((= (fisher-fish-species owner slot) 5) *catch-fishc-sgc*)

            (else
              *catch-fisha-sgc*))
          #f
          :from *default-dead-pool*
          :to *default-pool*
          :name "fisher-gameplay-fish")))

    (when fish
      (let ((fish-proc
            (-> fish 0 self)))

        (when fish-proc
          (send-event fish-proc 'anim-mode 'loop)
          (send-event fish-proc 'max-vis-dist (meters 999999.0))

          (set! (-> (the-as manipy fish-proc) root trans quad) (-> pos quad))

          (fisher-apply-slot-appearance! owner slot (the-as manipy fish-proc) #f)

          (fisher-set-manipy-facing!
            owner
            slot
            (the-as manipy fish-proc))

          (fisher-spawn-rare-fish-attachments!
            (the-as manipy fish-proc)
            (fisher-fish-suffix owner slot)
            #f))))

    fish))

(defun fisher-refill-missing-fish! ((self fisher-game))
  (dotimes (i 22)
    (when
      (and (< i (-> self fish-count)) (not (fisher-fish-pointer self i)))

      (fisher-randomize-fish-slot! self i)

      (fisher-set-fish-pointer!
        self
        i
        (fisher-spawn-gameplay-fish
          self
          i))))

  (none))

(defun singlefish-start-session! ((self fisher-game))
  (dotimes (i 22)
    (let ((old-fish
          (fisher-fish-pointer self i)))

      (when old-fish (deactivate (-> old-fish 0)))

      (fisher-set-fish-pointer!
        self
        i
        (the-as (pointer manipy) #f))))

  (+! *singlefish-session-id* 1)
  (set! *singlefish-session-active?* #t)
  (set! (-> self hooked-fish) #f)
  (set! (-> self hooked-fish-slot) -1)
  (set! (-> self fish-state) 'free)

  (fisher-configure-location-table! self)

  (set! (-> self fish-hook-time) 0.0)
  (set! (-> self fish-reel-progress) 0.0)
  (set! (-> self fish-fight-time) 0.0)
  (set! (-> self fish-fighting?) #f)

  (dotimes (i 22)
    (fisher-randomize-fish-slot! self i)

    (fisher-set-fish-pointer!
      self
      i
      (if
        (< i (-> self fish-count))
        (fisher-spawn-gameplay-fish self i)
        (the-as (pointer manipy) #f))))

  (none))

(defun fisher-manipy-distance-to-lure
  ((self fisher-game) (fish-proc manipy))

  (let ((delta
        (new 'stack-no-clear 'vector)))

    (singlefish-vector-sub-safe! delta (-> self lure-pos) (-> fish-proc root trans))

    (singlefish-vector-length-safe
      delta)))

(defun fisher-debug-draw-logical-fish-marker!
  ((self fisher-game) (slot int))

  (when
    (and *fisher-in-debug?* (< slot (-> self fish-count)))

    (let ((center (new 'stack-no-clear 'vector))
        (left (new 'stack-no-clear 'vector))
        (right (new 'stack-no-clear 'vector))
        (top (new 'stack-no-clear 'vector))
        (bottom (new 'stack-no-clear 'vector))
        (front (new 'stack-no-clear 'vector))
        (back (new 'stack-no-clear 'vector))
        (color
          (if
            (= (fisher-fish-species self slot) 2)
            (new 'static 'rgba :r #xff :g #x20 :b #xff :a #xff)
            (new 'static 'rgba :r #xff :g #xff :b #xff :a #xff))))

      (fisher-fish-position! self slot center)
      (singlefish-vector-copy-safe! left center)
      (singlefish-vector-copy-safe! right center)
      (singlefish-vector-copy-safe! top center)
      (singlefish-vector-copy-safe! bottom center)
      (singlefish-vector-copy-safe! front center)
      (singlefish-vector-copy-safe! back center)

      (-! (-> left x) (meters 0.6))
      (+! (-> right x) (meters 0.6))
      (+! (-> top y) (meters 0.6))
      (-! (-> bottom y) (meters 0.6))
      (+! (-> front z) (meters 0.6))
      (-! (-> back z) (meters 0.6))

      (fisher-debug-line! left right color)
      (fisher-debug-line! top bottom color)
      (fisher-debug-line! front back color)))

  (none))

(defun fisher-debug-draw-fish-cone!
  ((self fisher-game) (slot int) (fish-proc manipy))

  (when *fisher-in-debug?*
    (let ((origin
          (new 'stack-no-clear 'vector))

        (forward (new 'stack-no-clear 'vector))

        (upper-edge (new 'stack-no-clear 'vector))

        (forward-end (new 'stack-no-clear 'vector))

        (upper-end (new 'stack-no-clear 'vector))

        (arc-a (new 'stack-no-clear 'vector))

        (arc-b (new 'stack-no-clear 'vector))

        (color (new 'static 'rgba :r #x20 :g #xff :b #xff :a #xff))

        (range
          (meters 4.0)))

      (singlefish-vector-copy-safe! origin (-> fish-proc root trans))

      (singlefish-vector-scale-safe! forward (-> self playfield-axis) (fisher-fish-direction self slot))

      (set! (-> forward y) 0.0)
      (set! (-> forward w) 0.0)

      (singlefish-vector-normalize-safe! forward 1.0)

      (set! (-> upper-edge x) (* (-> forward x) 0.8191520))

      (set! (-> upper-edge y) 0.5735764)

      (set! (-> upper-edge z) (* (-> forward z) 0.8191520))

      (set! (-> upper-edge w) 0.0)

      (singlefish-vector-normalize-safe! upper-edge 1.0)

      (singlefish-vector-add-scaled-safe! forward-end origin forward range)

      (singlefish-vector-add-scaled-safe! upper-end origin upper-edge range)

      (fisher-debug-line! origin forward-end color)

      (fisher-debug-line! origin upper-end color)

      (dotimes (i 7)
        (let ((angle-a
              (* 5.0 (the float i)))

            (angle-b (* 5.0 (the float (+ i 1))))

            (dir-a (new 'stack-no-clear 'vector))

            (dir-b
              (new 'stack-no-clear 'vector)))

          (set! (-> dir-a x) (* (-> forward x) (cos (degrees angle-a))))

          (set! (-> dir-a y) (sin (degrees angle-a)))

          (set! (-> dir-a z) (* (-> forward z) (cos (degrees angle-a))))

          (set! (-> dir-a w) 0.0)

          (set! (-> dir-b x) (* (-> forward x) (cos (degrees angle-b))))

          (set! (-> dir-b y) (sin (degrees angle-b)))

          (set! (-> dir-b z) (* (-> forward z) (cos (degrees angle-b))))

          (set! (-> dir-b w) 0.0)

          (singlefish-vector-add-scaled-safe! arc-a origin dir-a range)

          (singlefish-vector-add-scaled-safe! arc-b origin dir-b range)

          (fisher-debug-line!
            arc-a
            arc-b
            color)))))

  (none))

(defun fisher-manipy-can-sense-lure?
  ((self fisher-game) (slot int) (fish-proc manipy))

  (let ((to-lure
        (new 'stack-no-clear 'vector))

      (forward (new 'stack-no-clear 'vector))

      (distance 0.0)

      (horizontal-distance 0.0)

      (facing-dot
        0.0))

    (singlefish-vector-sub-safe! to-lure (-> self lure-pos) (-> fish-proc root trans))

    (set! distance (singlefish-vector-length-safe to-lure))

    (set! (-> to-lure y) 0.0)
    (set! (-> to-lure w) 0.0)

    (set! horizontal-distance (singlefish-vector-length-safe to-lure))

    (when (> horizontal-distance (meters 0.001)) (singlefish-vector-normalize-safe! to-lure 1.0))

    (singlefish-vector-scale-safe! forward (-> self playfield-axis) (fisher-fish-direction self slot))

    (set! (-> forward y) 0.0)
    (set! (-> forward w) 0.0)

    (singlefish-vector-normalize-safe! forward 1.0)

    (set! facing-dot (vector-dot forward to-lure))

    (and
      (<= distance (meters 5.0))
      (> horizontal-distance (meters 0.001))
      (>= facing-dot 0.8191520))))

(defun fisher-move-manipy-toward!
  ((fish-proc manipy) (target vector) (speed float))

  (let ((delta
        (new 'stack-no-clear 'vector))

      (distance 0.0)

      (step
        0.0))

    (singlefish-vector-sub-safe! delta target (-> fish-proc root trans))

    (set! distance (singlefish-vector-length-safe delta))

    (when (> distance (meters 0.001))
      (singlefish-vector-normalize-safe! delta 1.0)

      (set! step (fmin distance (* speed (-> *display* seconds-per-frame))))

      (singlefish-vector-add-scaled-safe!
        (-> fish-proc root trans)
        (-> fish-proc root trans)
        delta
        step))

    distance))

(defun fisher-fish-scared-off!
  ((self fisher-game) (slot int))

  (let ((fish
        (fisher-fish-pointer
          self
          slot))

      (from-origin (new 'stack-no-clear 'vector))

      (side-axis
        (new 'stack-no-clear 'vector)))

    (when fish
      (let ((fish-proc
            (the-as manipy
              (-> fish 0 self))))

        (singlefish-vector-sub-safe! from-origin (-> fish-proc root trans) (-> self fishing-player-pos))

        (set! (-> side-axis x) (-> self playfield-axis z))
        (set! (-> side-axis y) 0.0)
        (set! (-> side-axis z) (- (-> self playfield-axis x)))
        (set! (-> side-axis w) 0.0)

        (singlefish-vector-normalize-safe! side-axis 1.0)

        (fisher-set-fish-distance! self slot (fmax (meters 3.5) (fmin (meters 55.5) (vector-dot from-origin (-> self playfield-axis)))))

        (fisher-set-fish-lane! self slot (fmax (meters -1.5) (fmin (meters 1.5) (vector-dot from-origin side-axis))))

        (fisher-set-fish-depth!
          self
          slot
          (-
            (-> self water-level)
            (-> fish-proc root trans y))))))

  (fisher-set-fish-direction! self slot (if (rand-vu-percent? 0.5) 1.0 -1.0))

  (fisher-set-fish-turn-time! self slot 0.0)

  (fisher-set-fish-cooldown! self slot 2.0)

  (set! (-> self hooked-fish-slot) -1)
  (set! (-> self fish-state) 'free)
  (set! (-> self fish-scare-on-arrival?) #f)
  (set! (-> self fish-hook-time) 0.0)
  (set! (-> self fish-reel-progress) 0.0)
  (set! (-> self fish-fighting?) #f)
  (set! (-> self hooked-fish-poison-dps) 0.0)
  (set! (-> self fish-fight-time) 0.0)
  (set! (-> self fish-fight-phase) 0.0)
  (set! (-> self fish-message) "SCARED OFF")
  (set! (-> self fish-message-time) 1.5)

  (none))

(defun fisher-catch-buzzer-fish! ((self fisher-game) (slot int))
  (let* ((task (fisher-buzzer-task-for-location self))
      (buzzer-index (fisher-fish-weight-tenths self slot))
      (fish (fisher-fish-pointer self slot))
      (before-count (buzzer-count *game-info* task))
      (after-count before-count)
      (awarded? #f))

    ;; A live slot can never intentionally reuse a collected fly. Still, check
    ;; again here and recover by selecting another missing index if its stored
    ;; index became stale for any reason.
    (when
      (or
        (< buzzer-index 0)
        (>= buzzer-index 7)
        (got-buzzer? *game-info* task buzzer-index))

      (set!
        buzzer-index
        (fisher-find-missing-buzzer-index
          task
          (rand-vu-int-range 0 6)
          -1)))

    ;; Award the area-specific fly before drawing the loot menu.
    (when
      (and
        (>= buzzer-index 0)
        (< buzzer-index 7)
        (not (got-buzzer? *game-info* task buzzer-index)))

      (send-event
        *target*
        'get-pickup
        (pickup-type buzzer)
        (the float
          (logior
            (the int task)
            (ash buzzer-index 16))))

      (set! after-count (buzzer-count *game-info* task))
      (set! awarded? (> after-count before-count))

      (when awarded?
        (runs-on-fly-pickup)
        (close-specific-task! task (task-status need-hint))))

    ;; Give the normal scout-fly HUD fly-in immediately, while preserving the
    ;; reeled-in model for the fishing loot presentation.
    (when
      (and awarded? fish)
      (let* ((fish-proc (the-as manipy (-> fish 0 self)))
          (hud-fly
            (manipy-spawn
              (-> fish-proc root trans)
              #f
              *buzzer-sgc*
              #f
              :to *entity-pool*)))

        (when hud-fly
          (send-event
            (ppointer->process hud-fly)
            'become-hud-object
            (ppointer->process (-> *hud-parts* buzzers))))))

    (set! (-> self caught-fish-species) 4)
    (set! (-> self caught-fish-suffix) 2)
    (set! (-> self caught-fish-level) (fisher-fish-level self slot))
    ;; Scout Fly slots reuse fish-weight-tenths for their unique fly index.
    ;; Set only the caught-display value to 500 tenths = 50.0 pounds.
    (set! (-> self caught-weight-tenths) 500)
    (set! (-> self caught-orb-value) 0)
    (set! (-> self caught-fish-xp) 0)
    (set! (-> self caught-buzzer-task) (the int task))
    (set! (-> self caught-buzzer-count) (buzzer-count *game-info* task))

    ;; Only the seventh fly schedules the power-cell reward. All Scout Fly
    ;; catches still use the normal catch transition and loot-menu animation.
    (set!
      (-> self buzzer-victory-pending?)
      (and awarded? (>= (-> self caught-buzzer-count) 7)))

    (set! (-> self fish-state) 'catch-return)
    (set! (-> self cast-state) 'catch-transition)
    (set! (-> self catch-transition-time) 0.0)
    (set! (-> self catch-menu-offset) 150.0)
    (set! (-> self camera-state) 'before-cast)
    (set! (-> self casted?) #f)
    (set! (-> self fish-fighting?) #f)
    (set! (-> self fish-fight-time) 0.0)
    (set! (-> self fish-fight-phase) 0.0)
    (set! (-> self fish-fight-base-y) 0.0)
    (stop-sound-file "water-waves.wav")
    (fisher-remove-lure-snake! self))

  (none))

(defun fisher-finish-manipy-catch!
  ((self fisher-game) (slot int))

  (fisher-play-fish-win-sound!)

  (when (= (fisher-fish-species self slot) 4)
    (fisher-catch-buzzer-fish! self slot))

  ;; Scout Fly catches own their complete award/menu path.
  (unless (= (fisher-fish-species self slot) 4)
    (let* ((species (fisher-fish-species self slot))
        (suffix (fisher-fish-suffix self slot))
        (fish-level (fisher-fish-level self slot))
        (jak-level (fisher-current-level))
        (weight (fisher-fish-weight-tenths self slot))
        (power-cell-task (fisher-fish-power-cell-task self slot))

        ;; Recover the normal pre-cell weight for orb calculation. The displayed
        ;; weight and fight damage continue using the full 1.7x value.
        (orb-weight
          (if
            (> power-cell-task 1)
            (max
              1
              (the int
                (+
                  (/ (the float weight) 1.70)
                  0.5)))
            weight))

        (value-mult (fisher-suffix-value-multiplier suffix))
        (level-value-mult (fisher-level-worth-multiplier fish-level jak-level))
        (base-value
          (cond
            ((= species 3) 3.0)
            ((= species 5) 1.4)
            ((or (= species 1) (= species 2)) 2.0)
            (else 1.0)))
        (catch-xp
          (the int
            (+
              (*
                (the float (fisher-calculate-catch-xp fish-level suffix))
                (if (= species 3) 1.75 1.0))
              0.5)))
        (raw-orb-value
          (the int
            (+
              (*
                (the float orb-weight)
                0.1
                base-value
                value-mult
                level-value-mult
                0.5)
              0.5)))
        (levels-below (- jak-level fish-level)))

      ;; If the same cell was completed from another source during fishing,
      ;; safely downgrade this to an ordinary fish before any reward is queued.
      (when
        (and
          (> power-cell-task 1)
          (task-complete? *game-info* (the-as game-task power-cell-task)))
        (set! power-cell-task 0)
        (fisher-set-fish-power-cell-task! self slot 0))

      (set! (-> self caught-fish-species) species)
      (set! (-> self caught-fish-suffix) suffix)
      (set! (-> self caught-fish-level) fish-level)
      (set! (-> self caught-weight-tenths) weight)
      (set!
        (-> self caught-orb-value)
        (let ((final-orb-value
                (if
                  (= species 3)
                  ;; Lurker Shark pays one-third of its existing orb reward.
                  ;; This does not change its weight, XP, or fight strength.
                  (the int (+ (/ (the float raw-orb-value) 3.0) 0.5))
                  raw-orb-value)))
          (cond
            ;; The Orb-Eater's dialogue promises an exact 90-orb purchase.
            ((= suffix 10) 90)

            ;; Precursor Fish and Oracle's Goldfish add their rare bonus on top
            ;; of the otherwise-normal calculated value.
            ((= suffix 7) (+ (max 1 final-orb-value) 35))
            ((= suffix 8) (+ (max 1 final-orb-value) 50))

            ((>= levels-below 5) (max 0 final-orb-value))
            (else (max 1 final-orb-value)))))
      (set!
        (-> self caught-fish-xp)
        (fisher-accepted-xp-amount catch-xp))
      (set! (-> self caught-power-cell-task) power-cell-task)

      ;; Every ordinary fish, including a power-cell carrier, returns through
      ;; the standard fish-stat loot window. The carried cell is delayed until
      ;; the loot menu, XP animation, and optional level-up window are finished.
      (set! (-> self fish-state) 'catch-return)
      (set! (-> self cast-state) 'catch-transition)
      (set! (-> self catch-transition-time) 0.0)
      (set! (-> self catch-menu-offset) 150.0)
      (set! (-> self camera-state) 'before-cast)
      (set! (-> self casted?) #f)
      (set! (-> self fish-fighting?) #f)
      (set! (-> self fish-fight-time) 0.0)
      (set! (-> self fish-fight-phase) 0.0)
      (set! (-> self fish-fight-base-y) 0.0)
      (stop-sound-file "water-waves.wav")
      (fisher-remove-lure-snake! self)))

  (none))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Standalone fisherman NPC clone
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Custom fisherman dialogue
;;
;; The table is flat on purpose: every implemented dialogue occupies four
;; consecutive strings. Dialogue 0 uses entries 0-3, dialogue 1 would use
;; entries 4-7, and so on.
;;
;; To add another dialogue:
;;   1. append four strings,
;;   2. increase *fisher-man-dialogue-count*.
;;
;; To disable all dialogue, set the count to 0.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(define *fisher-man-dialogue-count* 2)

;; dialogue-kind:
;;   0 = first tutorial
;;   1 = waiting for 10 precursor orbs
;;   2 = 10-orb completion/reward
;;   3 = both tutorial tasks completed
;;   4 = village1 random fishing hint
(define *fisher-man-dialogue-page-count* 6)
(define *fisher-man-hint-count* 10)

