;; L Tetromino Fish: the base fish is the lower-left block; these three fish
;; finish the vertical three-block column and the lower-right foot.
;; The extra fish are spawned under an invisible pivot so the full shape can
;; rotate in randomized 90-degree Tetris-like turns once per second.
(define *fisher-tetromino-group-offset-game*
  (new 'static 'vector :w 0.0))
(define *fisher-tetromino-group-offset-catch*
  (new 'static 'vector :w 0.0))
(define *fisher-tetromino-a-game*
  (new 'static 'vector :y (meters 0.30) :w 0.0))
(define *fisher-tetromino-b-game*
  (new 'static 'vector :y (meters 0.60) :w 0.0))
(define *fisher-tetromino-c-game*
  (new 'static 'vector :z (meters 0.42) :w 0.0))
(define *fisher-tetromino-a-catch*
  (new 'static 'vector :y (meters 0.48) :w 0.0))
(define *fisher-tetromino-b-catch*
  (new 'static 'vector :y (meters 0.96) :w 0.0))
(define *fisher-tetromino-c-catch*
  (new 'static 'vector :z (meters 0.66) :w 0.0))

;; Platformius halo-group centers.
(define *fisher-platformius-group-offset-game*
  (new 'static 'vector :y (meters 0.72) :w 0.0))
(define *fisher-platformius-group-offset-catch*
  (new 'static 'vector :y (meters 1.15) :w 0.0))

(defun fisher-update-rare-attachment-transform! ((self manipy))
  (let ((parent-proc (ppointer->process (-> self parent)))
      (offset (-> self root transv)))

    ;; Rare attachments are independent drawable manipys.  Hiding the parent
    ;; fish does not automatically hide these children, so synchronize their
    ;; draw distance every frame with the persistent fishbox visibility.
    (send-event
      self
      'max-vis-dist
      (if (or *fisher-resident-fish-visible?* in-main-menu?)
        (meters 999999.0)
        (meters 0.0)))

    (when
      (and
        parent-proc
        offset
        (type-type? (-> parent-proc type) process-drawable))

      (let ((parent-drawable (the-as process-drawable parent-proc))
          (rotation (new 'stack-no-clear 'matrix))
          (rotated-offset (new 'stack-no-clear 'vector)))

        (quaternion->matrix rotation (-> parent-drawable root quat))
        (vector-rotate*! rotated-offset offset rotation)
        (set! (-> rotated-offset w) 0.0)

        (vector+!
          (-> self root trans)
          (-> parent-drawable root trans)
          rotated-offset)

        (set! (-> self root trans w) 1.0)

        (quaternion-copy!
          (-> self root quat)
          (-> parent-drawable root quat)))))

  (none))

(defbehavior fisher-rare-attachment-trans manipy ()
  (fisher-update-rare-attachment-transform! self)
  (none))


(defun fisher-update-rare-attachment-rotated!
  ((self manipy)
    (axis-x float)
    (axis-y float)
    (axis-z float)
    (angle float))

  (fisher-update-rare-attachment-transform! self)

  (let ((parent-quat (new 'stack-no-clear 'quaternion))
      (relative-quat (new 'stack-no-clear 'quaternion)))
    (quaternion-copy! parent-quat (-> self root quat))
    (quaternion-axis-angle! relative-quat axis-x axis-y axis-z angle)
    (quaternion*! (-> self root quat) parent-quat relative-quat))

  (none))

(defbehavior fisher-complicated-x-trans manipy ()
  (fisher-update-rare-attachment-rotated! self 1.0 0.0 0.0 (degrees 90.0))
  (none))

(defbehavior fisher-complicated-z-trans manipy ()
  (fisher-update-rare-attachment-rotated! self 0.0 0.0 1.0 (degrees 90.0))
  (none))

(defbehavior fisher-complicated-back-trans manipy ()
  (fisher-update-rare-attachment-rotated! self 0.0 1.0 0.0 (degrees 180.0))
  (none))

(defbehavior fisher-archipelago-orb-group-trans manipy ()
  (fisher-update-rare-attachment-transform! self)

  (let ((base-quat (new 'stack-no-clear 'quaternion))
      (x-quat (new 'stack-no-clear 'quaternion))
      (z-quat (new 'stack-no-clear 'quaternion))
      (spin-quat (new 'stack-no-clear 'quaternion))
      (tick (the float (current-time))))

    (quaternion-copy! base-quat (-> self root quat))
    (quaternion-axis-angle! x-quat 1.0 0.0 0.0 (* tick 32.768))
    (quaternion-axis-angle! z-quat 0.0 0.0 1.0 (* tick 49.152))
    (quaternion*! spin-quat x-quat z-quat)
    (quaternion*! (-> self root quat) base-quat spin-quat))

  (none))

(defun fisher-update-rare-attachment-offset-rotated!
  ((self manipy)
    (axis-x float)
    (axis-y float)
    (axis-z float)
    (angle float))

  (let ((parent-proc (ppointer->process (-> self parent)))
      (offset (-> self root transv)))

    (send-event
      self
      'max-vis-dist
      (if (or *fisher-resident-fish-visible?* in-main-menu?)
        (meters 999999.0)
        (meters 0.0)))

    (when
      (and
        parent-proc
        offset
        (type-type? (-> parent-proc type) process-drawable))

      (let ((parent-drawable (the-as process-drawable parent-proc))
          (relative-quat (new 'stack-no-clear 'quaternion))
          (relative-mat (new 'stack-no-clear 'matrix))
          (parent-mat (new 'stack-no-clear 'matrix))
          (local-rotated-offset (new 'stack-no-clear 'vector))
          (rotated-offset (new 'stack-no-clear 'vector)))

        (quaternion-axis-angle! relative-quat axis-x axis-y axis-z angle)
        (quaternion->matrix relative-mat relative-quat)
        (vector-rotate*! local-rotated-offset offset relative-mat)
        (set! (-> local-rotated-offset w) 0.0)

        (quaternion->matrix parent-mat (-> parent-drawable root quat))
        (vector-rotate*! rotated-offset local-rotated-offset parent-mat)
        (set! (-> rotated-offset w) 0.0)

        (vector+!
          (-> self root trans)
          (-> parent-drawable root trans)
          rotated-offset)

        (set! (-> self root trans w) 1.0)
        (quaternion-copy!
          (-> self root quat)
          (-> parent-drawable root quat)))))

  (none))


(defun fisher-tetromino-orientation-step ((step int))
  (case (mod step 16)
    ((0)  0)
    ((1)  1)
    ((2)  0)
    ((3)  3)
    ((4)  0)
    ((5)  1)
    ((6)  2)
    ((7)  1)
    ((8)  0)
    ((9)  3)
    ((10) 2)
    ((11) 3)
    ((12) 0)
    ((13) 1)
    ((14) 2)
    (else 3)))

(defun fisher-tetromino-orientation-angle ((step int))
  (* (the float (fisher-tetromino-orientation-step step))
     (degrees 90.0)))

(defun fisher-tetromino-current-angle ()
  (let ((frames (current-time))
      (period (seconds 1.0))
      (step 0)
      (phase 0.0)
      (ease 0.0)
      (from-angle 0.0)
      (to-angle 0.0)
      (delta 0.0))

    (set! step (the int (/ frames period)))
    (set! phase (/ (the float (mod frames period)) (the float period)))
    (set! ease (* phase phase (- 3.0 (* 2.0 phase))))

    (set! from-angle (fisher-tetromino-orientation-angle step))
    (set! to-angle (fisher-tetromino-orientation-angle (+ step 1)))
    (set! delta (- to-angle from-angle))

    (when (> delta (degrees 180.0))
      (-! delta (degrees 360.0)))
    (when (< delta (degrees -180.0))
      (+! delta (degrees 360.0)))

    (+ from-angle (* delta ease))))

(defbehavior fisher-tetromino-group-trans manipy ()
  (fisher-update-rare-attachment-transform! self)
  (none))

(defbehavior fisher-tetromino-piece-trans manipy ()
  (fisher-update-rare-attachment-offset-rotated!
    self 1.0 0.0 0.0 (fisher-tetromino-current-angle))
  (none))

(defbehavior fisher-platformius-halo-group-trans manipy ()
  (fisher-update-rare-attachment-rotated!
    self 0.0 1.0 0.0 (* (the float (current-time)) 43.690666))
  (none))

(defbehavior fisher-platformius-platform-trans manipy ()
  (fisher-update-rare-attachment-transform! self)

  (when (zero? (mod (current-time) 12))
    (launch-particles
      :system *sp-particle-system-3d*
      (-> *part-id-table* 3569)
      (-> self root trans)))

  (none))

;; Snow ice crystal: keep the *center* of the cavecrystal locked to the
;; center of its parent fish.  cavecrystal is authored from its bottom/base,
;; with its visual bounds centered 4.7m above that origin.  If we simply put
;; the root below the fish and then rotate it, the crystal rotates around that
;; base and swings underneath the fish.  Instead, build the final rotation
;; first, rotate the crystal's scaled center vector by that final rotation, and
;; subtract it from the fish center.  This makes the visual center the pivot.
(defun fisher-update-snow-ice-crystal-transform! ((self manipy))
  (let ((parent-proc (ppointer->process (-> self parent)))
      (seed (-> self root transv w)))

    ;; Attachment manipys do not inherit the parent's draw-status.  Mirror the
    ;; actual parent fish every frame so its crystal disappears on every path
    ;; that hides/deactivates the fish.
    (cond
      ((and
          parent-proc
          (type-type? (-> parent-proc type) process-drawable))
        (let ((parent-drawable (the-as process-drawable parent-proc)))
          (cond
            ((or
                (logtest? (-> parent-drawable draw status) (draw-status hidden))
                (<= (-> parent-drawable root scale x) 0.0001))
              (logior! (-> self draw status) (draw-status hidden))
              (send-event self 'max-vis-dist (meters 0.0)))
            (else
              (logclear! (-> self draw status) (draw-status hidden))
              (send-event self 'max-vis-dist (meters 999999.0))))))
      (else
        (logior! (-> self draw status) (draw-status hidden))
        (send-event self 'max-vis-dist (meters 0.0))))

    (when
      (and
        parent-proc
        (type-type? (-> parent-proc type) process-drawable))

      (let ((parent-drawable (the-as process-drawable parent-proc))
          (base-quat (new 'stack-no-clear 'quaternion))
          (yaw-quat (new 'stack-no-clear 'quaternion))
          (pitch-quat (new 'stack-no-clear 'quaternion))
          (relative-quat (new 'stack-no-clear 'quaternion))
          (parent-mat (new 'stack-no-clear 'matrix))
          (fish-center-local (new 'stack-no-clear 'vector))
          (fish-center-world-offset (new 'stack-no-clear 'vector))
          (fish-center-world (new 'stack-no-clear 'vector))
          (final-mat (new 'stack-no-clear 'matrix))
          (center-local (new 'stack-no-clear 'vector))
          (center-world-offset (new 'stack-no-clear 'vector)))

        ;; Stable random orientation for this spawn, relative to the fish.
        (quaternion-copy! base-quat (-> parent-drawable root quat))
        (quaternion-axis-angle! yaw-quat 0.0 1.0 0.0 seed)
        (quaternion-axis-angle! pitch-quat 1.0 0.0 0.0 (* seed 0.61803395))
        (quaternion*! relative-quat yaw-quat pitch-quat)
        (quaternion*! (-> self root quat) base-quat relative-quat)

        ;; The fish root sits near the lower middle of the model.  transv.xyz
        ;; stores a fish-local offset to the actual body center.  Rotate that
        ;; offset only by the PARENT fish orientation so the target point stays
        ;; in the center of the fish even while it pitches/turns.
        (set-vector!
          fish-center-local
          (-> self root transv x)
          (-> self root transv y)
          (-> self root transv z)
          0.0)
        (quaternion->matrix parent-mat (-> parent-drawable root quat))
        (vector-rotate*! fish-center-world-offset fish-center-local parent-mat)
        (set! (-> fish-center-world-offset w) 0.0)
        (vector+! fish-center-world (-> parent-drawable root trans) fish-center-world-offset)
        (set! (-> fish-center-world w) 1.0)

        ;; cavecrystal's authored visual center is (0, 4.7m, 0).  Include the
        ;; attachment's actual scale, rotate that center by the FINAL crystal
        ;; orientation, then move the crystal root so this point lands exactly
        ;; on the fish BODY center above. Rotation therefore happens around the
        ;; middle of the crystal while the whole shell sits center-middle in
        ;; the fish rather than bottom-middle.
        (set-vector!
          center-local
          0.0
          (* (meters 4.7) (-> self root scale y))
          0.0
          0.0)

        (quaternion->matrix final-mat (-> self root quat))
        (vector-rotate*! center-world-offset center-local final-mat)
        (set! (-> center-world-offset w) 0.0)

        (vector-!
          (-> self root trans)
          fish-center-world
          center-world-offset)
        (set! (-> self root trans w) 1.0))))

  (none))

(defbehavior fisher-snow-ice-crystal-trans manipy ()
  (fisher-update-snow-ice-crystal-transform! self)
  (none))

(defun fisher-spawn-snow-ice-crystal!
  ((fish-proc manipy) (species int) (catch-display? symbol))

  (when (!= species (the-as int (fisher-species scout-fly)))
    ;; Tight ice shell: 1/3.5 of the older shell scale, retaining the
    ;; per-species bound correction.
    (let* ((parent-scale (-> fish-proc root scale x))
        (scale
          (*
            parent-scale
            (if
              (= species (the-as int (fisher-species ice-shark)))
              0.55555554
              0.37037037)))
        (offset (new 'stack-no-clear 'vector)))

      ;; Store the parent fish's BODY-center target in fish-local space.
      ;; Lowered slightly from 2.0m to 1.6m so the crystal sits a little lower
      ;; around the fish while preserving the center-pivot rotation fix.
      (set-vector! offset 0.0 (* (meters 1.6) parent-scale) 0.0 0.0)

      (let ((attachment
            (fisher-spawn-rare-attachment!
              fish-proc
              *fisher-ice-crystal-sgc*
              offset
              scale
              "fisher-snow-ice-crystal")))

        (when attachment
          (let ((crystal (the-as manipy (ppointer->process attachment))))
            (when crystal
              ;; Store one random seed per spawn; the trans hook keeps this
              ;; orientation stable while following the fish.
              (set! (-> crystal root transv w)
                (rand-vu-float-range (degrees 0.0) (degrees 360.0)))
              (send-event crystal 'anim-mode 'still)
              (send-event crystal 'trans-hook fisher-snow-ice-crystal-trans)
              (set! (-> crystal draw color-mult r) 0.42)
              (set! (-> crystal draw color-mult g) 1.00)
              (set! (-> crystal draw color-mult b) 1.00)
              (set! (-> crystal draw color-mult a) 1.00)
              (set! (-> crystal draw color-emissive r) 0.08)
              (set! (-> crystal draw color-emissive g) 0.42)
              (set! (-> crystal draw color-emissive b) 0.48)
              (set! (-> crystal draw color-emissive a) 1.00)

              ;; Apply the center-pivot placement immediately so the crystal
              ;; never renders for one frame with its authored base at the fish
              ;; center before the trans-hook runs.
              (fisher-update-snow-ice-crystal-transform! crystal)))))))

  (none))

(defun fisher-configure-rare-orb!
  ((attachment (pointer manipy))
    (r float)
    (g float)
    (b float))

  (when attachment
    (let ((orb (the-as manipy (ppointer->process attachment))))
      (when orb
        ;; The six colors rotate as one group.  Do not let the money skeleton's
        ;; own idle animation spin each orb independently.
        (send-event orb 'anim-mode 'still)
        (set! (-> orb draw color-mult r) r)
        (set! (-> orb draw color-mult g) g)
        (set! (-> orb draw color-mult b) b)
        (set! (-> orb draw color-mult a) 1.0)
        (set! (-> orb draw color-emissive r) (* r 0.40))
        (set! (-> orb draw color-emissive g) (* g 0.40))
        (set! (-> orb draw color-emissive b) (* b 0.40))
        (set! (-> orb draw color-emissive a) 1.0))))

  (none))

(defun fisher-match-attachment-color!
  ((attachment (pointer manipy)) (parent manipy))

  (when attachment
    (let ((attachment-proc (the-as manipy (ppointer->process attachment))))
      (when attachment-proc
        (set! (-> attachment-proc draw color-mult quad)
          (-> parent draw color-mult quad))
        (set! (-> attachment-proc draw color-emissive quad)
          (-> parent draw color-emissive quad)))))

  (none))

(defbehavior fisher-precursor-towertop-trans manipy ()
  (fisher-update-rare-attachment-transform! self)

  (ja :group! towertop-idle-ja :num! (loop! 0.4))

  (none))

(defun fisher-spawn-rare-attachment!
  ((fish-proc manipy)
    (skel skeleton-group)
    (offset vector)
    (scale float)
    (attachment-name string))

  (let ((attachment
        (manipy-spawn
          (-> fish-proc root trans)
          #f
          skel
          #f
          :from *default-dead-pool*
          :to fish-proc
          :name attachment-name)))

    (when attachment
      (let ((attachment-proc
            (the-as manipy (ppointer->process attachment))))

        (when attachment-proc
          (set! (-> attachment-proc root transv quad) (-> offset quad))
          (set! (-> attachment-proc root transv w) 0.0)
          (send-event attachment-proc 'max-vis-dist (meters 999999.0))

          (set-vector!
            (-> attachment-proc root scale)
            scale scale scale 1.0)

          (cond
            ((= skel *towertop-sgc*)
              (send-event attachment-proc 'anim-mode 'still)
              (send-event
                attachment-proc
                'trans-hook
                fisher-precursor-towertop-trans))

            (else
              (send-event attachment-proc 'anim-mode 'loop)
              (send-event
                attachment-proc
                'trans-hook
                fisher-rare-attachment-trans))))))

    attachment))

(defun fisher-spawn-rare-fish-attachments!
  ((fish-proc manipy) (suffix int) (catch-display? symbol))

  (cond
    ((= suffix 7)
      (fisher-spawn-rare-attachment!
        fish-proc
        *towertop-sgc*
        (if catch-display?
          *fisher-precursor-attachment-offset-catch*
          *fisher-precursor-attachment-offset-game*)
        (if catch-display? 0.025 0.015)
        "fisher-precursor-towertop"))

    ((= suffix 8)
      (fisher-spawn-rare-attachment!
        fish-proc
        *oracle-sgc*
        (if catch-display?
          *fisher-oracle-attachment-offset-catch*
          *fisher-oracle-attachment-offset-game*)
        (if catch-display? 0.16 0.10)
        "fisher-oracle-statue"))

    ((= suffix 10)
      (fisher-spawn-rare-attachment!
        fish-proc *money-sgc*
        (if catch-display?
          *fisher-orb-attachment-offset-a-catch*
          *fisher-orb-attachment-offset-a-game*)
        (if catch-display? 0.65 0.42)
        "fisher-orb-eater-orb-a")

      (fisher-spawn-rare-attachment!
        fish-proc *money-sgc*
        (if catch-display?
          *fisher-orb-attachment-offset-b-catch*
          *fisher-orb-attachment-offset-b-game*)
        (if catch-display? 0.58 0.38)
        "fisher-orb-eater-orb-b")

      (fisher-spawn-rare-attachment!
        fish-proc *money-sgc*
        (if catch-display?
          *fisher-orb-attachment-offset-c-catch*
          *fisher-orb-attachment-offset-c-game*)
        (if catch-display? 0.62 0.40)
        "fisher-orb-eater-orb-c"))

    ((= suffix 11)
      ;; One invisible parent owns the X/Z spin.  The six child orbs only own
      ;; fixed local offsets, so the ring rotates as a single rigid group.
      (let ((group
            (fisher-spawn-rare-attachment!
              fish-proc
              *money-sgc*
              (if catch-display?
                *fisher-archipelago-group-offset-catch*
                *fisher-archipelago-group-offset-game*)
              0.001
              "fisher-archipelago-orb-group")))

        (when group
          (let ((group-proc (the-as manipy (ppointer->process group)))
              (orb-scale (if catch-display? 0.54 0.34)))

            (when group-proc
              (send-event group-proc 'anim-mode 'still)
              (send-event group-proc 'trans-hook fisher-archipelago-orb-group-trans)
              (set-vector! (-> group-proc draw color-mult) 0.0 0.0 0.0 0.0)
              (set-vector! (-> group-proc draw color-emissive) 0.0 0.0 0.0 0.0)

              (fisher-configure-rare-orb!
                (fisher-spawn-rare-attachment!
                  group-proc *money-sgc*
                  (if catch-display?
                    *fisher-archipelago-magenta-catch*
                    *fisher-archipelago-magenta-game*)
                  orb-scale "fisher-archipelago-orb-magenta")
                1.00 0.18 0.48)

              (fisher-configure-rare-orb!
                (fisher-spawn-rare-attachment!
                  group-proc *money-sgc*
                  (if catch-display?
                    *fisher-archipelago-green-catch*
                    *fisher-archipelago-green-game*)
                  orb-scale "fisher-archipelago-orb-green")
                0.18 1.00 0.36)

              (fisher-configure-rare-orb!
                (fisher-spawn-rare-attachment!
                  group-proc *money-sgc*
                  (if catch-display?
                    *fisher-archipelago-purple-catch*
                    *fisher-archipelago-purple-game*)
                  orb-scale "fisher-archipelago-orb-purple")
                0.64 0.24 1.00)

              (fisher-configure-rare-orb!
                (fisher-spawn-rare-attachment!
                  group-proc *money-sgc*
                  (if catch-display?
                    *fisher-archipelago-salmon-catch*
                    *fisher-archipelago-salmon-game*)
                  orb-scale "fisher-archipelago-orb-salmon")
                1.00 0.42 0.26)

              (fisher-configure-rare-orb!
                (fisher-spawn-rare-attachment!
                  group-proc *money-sgc*
                  (if catch-display?
                    *fisher-archipelago-blue-catch*
                    *fisher-archipelago-blue-game*)
                  orb-scale "fisher-archipelago-orb-blue")
                0.12 0.24 1.00)

              (fisher-configure-rare-orb!
                (fisher-spawn-rare-attachment!
                  group-proc *money-sgc*
                  (if catch-display?
                    *fisher-archipelago-yellow-catch*
                    *fisher-archipelago-yellow-game*)
                  orb-scale "fisher-archipelago-orb-yellow")
                1.00 0.84 0.20))))))

    ((= suffix 13)
      (let ((attachment
            (fisher-spawn-rare-attachment!
              fish-proc *catch-fisha-sgc*
              (if catch-display? *fisher-complicated-a-catch* *fisher-complicated-a-game*)
              (if catch-display? 0.32 0.27)
              "fisher-complicated-axis-x")))
        (when attachment
          (fisher-match-attachment-color! attachment fish-proc)
          (send-event (ppointer->process attachment) 'trans-hook fisher-complicated-x-trans)))

      (let ((attachment
            (fisher-spawn-rare-attachment!
              fish-proc *catch-fisha-sgc*
              (if catch-display? *fisher-complicated-b-catch* *fisher-complicated-b-game*)
              (if catch-display? 0.32 0.27)
              "fisher-complicated-axis-z")))
        (when attachment
          (fisher-match-attachment-color! attachment fish-proc)
          (send-event (ppointer->process attachment) 'trans-hook fisher-complicated-z-trans)))

      (let ((attachment
            (fisher-spawn-rare-attachment!
              fish-proc *catch-fisha-sgc*
              (if catch-display? *fisher-complicated-c-catch* *fisher-complicated-c-game*)
              (if catch-display? 0.32 0.27)
              "fisher-complicated-axis-back")))
        (when attachment
          (fisher-match-attachment-color! attachment fish-proc)
          (send-event (ppointer->process attachment) 'trans-hook fisher-complicated-back-trans))))

    ((= suffix 14)
      (let ((group
            (fisher-spawn-rare-attachment!
              fish-proc
              *money-sgc*
              (if catch-display?
                *fisher-tetromino-group-offset-catch*
                *fisher-tetromino-group-offset-game*)
              0.001
              "fisher-tetromino-group")))

        (when group
          (let ((group-proc (the-as manipy (ppointer->process group)))
              (fish-scale (if catch-display? 0.22 0.16)))

            (when group-proc
              (send-event group-proc 'anim-mode 'still)
              (send-event group-proc 'trans-hook fisher-tetromino-group-trans)
              (set-vector! (-> group-proc draw color-mult) 0.0 0.0 0.0 0.0)
              (set-vector! (-> group-proc draw color-emissive) 0.0 0.0 0.0 0.0)

              (let ((attachment
                    (fisher-spawn-rare-attachment!
                      group-proc *catch-fishb-sgc*
                      (if catch-display? *fisher-tetromino-a-catch* *fisher-tetromino-a-game*)
                      fish-scale
                      "fisher-tetromino-upper-a")))
                (when attachment
                  (send-event (the-as manipy (ppointer->process attachment)) 'trans-hook fisher-tetromino-piece-trans))
                (fisher-match-attachment-color! attachment fish-proc))

              (let ((attachment
                    (fisher-spawn-rare-attachment!
                      group-proc *catch-fishb-sgc*
                      (if catch-display? *fisher-tetromino-b-catch* *fisher-tetromino-b-game*)
                      fish-scale
                      "fisher-tetromino-upper-b")))
                (when attachment
                  (send-event (the-as manipy (ppointer->process attachment)) 'trans-hook fisher-tetromino-piece-trans))
                (fisher-match-attachment-color! attachment fish-proc))

              (let ((attachment
                    (fisher-spawn-rare-attachment!
                      group-proc *catch-fishb-sgc*
                      (if catch-display? *fisher-tetromino-c-catch* *fisher-tetromino-c-game*)
                      fish-scale
                      "fisher-tetromino-foot")))
                (when attachment
                  (send-event (the-as manipy (ppointer->process attachment)) 'trans-hook fisher-tetromino-piece-trans))
                (fisher-match-attachment-color! attachment fish-proc)))))))

    ((= suffix 15)
      (let ((group
            (fisher-spawn-rare-attachment!
              fish-proc
              *money-sgc*
              (if catch-display?
                *fisher-platformius-group-offset-catch*
                *fisher-platformius-group-offset-game*)
              0.001
              "fisher-platformius-halo-group")))

        (when group
          (let ((group-proc (the-as manipy (ppointer->process group)))
              (radius (if catch-display? (meters 0.82) (meters 0.50)))
              (plat-scale (if catch-display? 0.115 0.075)))

            (when group-proc
              (send-event group-proc 'anim-mode 'still)
              (send-event group-proc 'trans-hook fisher-platformius-halo-group-trans)
              (set-vector! (-> group-proc draw color-mult) 0.0 0.0 0.0 0.0)
              (set-vector! (-> group-proc draw color-emissive) 0.0 0.0 0.0 0.0)

              (dotimes (i 6)
                (let* ((angle (* 10922.666 (the float i)))
                    (offset (new 'stack-no-clear 'vector))
                    (platform (the-as (pointer manipy) #f)))
                  (set-vector!
                    offset
                    (* radius (cos angle))
                    0.0
                    (* radius (sin angle))
                    0.0)
                  (set!
                    platform
                    (fisher-spawn-rare-attachment!
                      group-proc
                      *fisher-platformius-plat-sgc*
                      offset
                      plat-scale
                      "fisher-platformius-platform"))
                  (when platform
                    (send-event
                      (ppointer->process platform)
                      'trans-hook
                      fisher-platformius-platform-trans)))))))))

  )
  (none))

(defun fisher-apply-slot-appearance!
  ((self fisher-game) (slot int) (fish-proc manipy) (catch-display? symbol))

  (let* ((suffix
        (fisher-fish-suffix self slot))

      (species (fisher-fish-species self slot))

      (power-cell-task (fisher-fish-power-cell-task self slot))

      (info
        (fisher-species-info-for species))

      (base-scale
        (if
          catch-display?
          (-> info catch-scale)
          (-> info game-scale)))

      (x-scale 1.0)

      (y-scale 1.0)

      (z-scale 1.0)

      (r (-> info color-r))

      (g (-> info color-g))

      (b (-> info color-b)))

    (cond
      ((= suffix 7)
        (set! r 0.62)
        (set! g 0.36)
        (set! b 0.12)
        (set! base-scale (if catch-display? 0.62 0.34)))

      ((= suffix 8)
        (set! r 1.00)
        (set! g 0.56)
        (set! b 0.06)
        (set! base-scale (if catch-display? 0.62 0.34)))

      ((= suffix 9)
        (set! r 0.56)
        (set! g 0.82)
        (set! b 0.62)
        (set! base-scale (if catch-display? 0.68 0.38))
        (set! x-scale 0.13)
        (set! y-scale 0.20)
        (set! z-scale 2.35))

      ((= suffix 10)
        (set! r 0.82)
        (set! g 0.48)
        (set! b 0.16)
        (set! base-scale (if catch-display? 0.68 0.38))
        (set! x-scale 1.18)
        (set! y-scale 1.12)
        (set! z-scale 1.18))

      ;; Archipelagoldfish uses the unaltered fishb material.
      ((= suffix 11)
        (set! r 1.00)
        (set! g 1.00)
        (set! b 1.00)
        (set! base-scale (if catch-display? 0.62 0.34)))

      ;; Spec Ops Fish is intentionally almost lightless.
      ((= suffix 12)
        (set! r 0.003)
        (set! g 0.003)
        (set! b 0.003)
        (set! base-scale (if catch-display? 0.64 0.35)))

      ((= suffix 13)
        (set! r 1.00)
        (set! g 1.00)
        (set! b 1.00)
        (set! base-scale (if catch-display? 0.64 0.34)))

      ;; The base fish is one of the four blocks.  Attachments use the same
      ;; compact scale to avoid intersections within the L silhouette.
      ((= suffix 14)
        (set! r 1.00)
        (set! g 1.00)
        (set! b 1.00)
        (set! base-scale (if catch-display? 0.44 0.16)))

      ;; Platformius and Screaming Fish have no body-color alterations.
      ((= suffix 15)
        (set! r 1.00)
        (set! g 1.00)
        (set! b 1.00)
        (set! base-scale (if catch-display? 0.62 0.34)))

      ((= suffix 16)
        (set! r 1.00)
        (set! g 1.00)
        (set! b 1.00)
        (set! base-scale (if catch-display? 0.62 0.34))))

    (when
      (and (not (fisher-rare-fish? suffix)) (= suffix 0))
      (set! x-scale 0.84)
      (set! z-scale 1.10))

    (when
      (and (not (fisher-rare-fish? suffix)) (= suffix 5))
      (*! x-scale 2.0)
      (*! y-scale 2.0)
      (*! z-scale 2.0))

    (when
      (and
        (not (fisher-rare-fish? suffix))
        (!= species 4)
        (or
          (!= species 3)
          (= suffix 3)
          (= suffix 6)))

      (cond
        ((= suffix 1) (*! r 0.72) (*! g 0.72) (*! b 0.72))

        ((= suffix 3)
          (let ((color-roll
                (mod
                  (+ (* slot 3) species)
                  5)))

            (cond
              ((= color-roll 0) (set! r 0.20) (set! g 0.95) (set! b 0.25))

              ((= color-roll 1) (set! r 0.65) (set! g 0.20) (set! b 1.00))

              ((= color-roll 2) (set! r 0.10) (set! g 0.85) (set! b 0.95))

              ((= color-roll 3) (set! r 0.95) (set! g 0.15) (set! b 0.55))

              (else
                (set! r 0.85)
                (set! g 0.85)
                (set! b 0.15)))))

        ((= suffix 4) (*! r 1.10) (*! g 1.10) (*! b 1.10))

        ((= suffix 6)
          (set! r 1.00)
          (set! g 0.72)
          (set! b 0.06))))

    ;; Mountain Pass Cell Fish reuse the Fire Canyon cell-shark mechanics
    ;; and red power-cell particle, but their body is blue.
    (when
      (and
        (= species (the-as int (fisher-species fire-canyon-cellfish)))
        (or
          (= power-cell-task (the-as int (game-task ogre-boss)))
          (= power-cell-task (the-as int (game-task ogre-end)))))
      (set! r 0.10)
      (set! g 0.42)
      (set! b 1.00))

    ;; The sludge-pool species keep their requested base colors for every
    ;; ordinary suffix.  Only Mutant, Golden, and the true rare fish may
    ;; override these colors.
    (when
      (and
        (not (fisher-rare-fish? suffix))
        (!= suffix 3)
        (!= suffix 6))
      (cond
        ((= species (the-as int (fisher-species swamp-guppie)))
          (set! r 1.00)
          (set! g 0.82)
          (set! b 0.06))
        ((= species (the-as int (fisher-species sludge-crappie)))
          (set! r 1.00)
          (set! g 1.00)
          (set! b 1.00))
        ((= species (the-as int (fisher-species black-lurker-shark)))
          (set! r 0.035)
          (set! g 0.040)
          (set! b 0.040))))

    ;; Village3's ordinary fish retain their authored lava colors even when
    ;; standard suffix tinting is present.  Mutant, Golden, and true rare fish
    ;; still keep their global suffix appearance.
    (when
      (and
        (not (fisher-rare-fish? suffix))
        (!= suffix 3)
        (!= suffix 6))
      (cond
        ((= species (the-as int (fisher-species lava-drum)))
          (set! r 1.00)
          (set! g 0.20)
          (set! b 0.005)
          (set! base-scale (if catch-display? 1.35 1.05)))

        ((= species (the-as int (fisher-species magma-serpent)))
          (set! r 1.00)
          (set! g 0.025)
          (set! b 0.005))

        ((= species (the-as int (fisher-species inferno-shark)))
          (set! r 1.00)
          (set! g 0.035)
          (set! b 0.005)
          (set! base-scale (if catch-display? 0.38 0.22)))))

    ;; Every Magma Serpent must use the stretched serpent proportions,
    ;; regardless of suffix.  Previously this lived inside the ordinary-fish
    ;; appearance branch, so Mutant, Golden, and rare Magma Serpents skipped
    ;; the stretch and appeared as ordinary-sized fishc models.
    (when
      (and
        (= (-> self location-id) (the-as int (fisher-zone village3-lava)))
        (= species (the-as int (fisher-species magma-serpent))))
      (set! base-scale (if catch-display? 3.00 2.16))
      (set! x-scale 0.62)
      (set! y-scale 0.70)
      (set! z-scale 3.65))

    ;; Snow fish are always bright cyan.  Keep the requested species size
    ;; hierarchy even if ordinary/rare suffix tinting ran above.
    (when
      (and
        (= (-> self location-id) (the-as int (fisher-zone snow-ice)))
        (!= species (the-as int (fisher-species scout-fly))))
      (set! r 0.05)
      (set! g 1.00)
      (set! b 1.00)
      (cond
        ((= species (the-as int (fisher-species frost-biter)))
          (set! base-scale (if catch-display? 0.70 0.42)))
        ((= species (the-as int (fisher-species crystal-fish)))
          (set! base-scale (if catch-display? 1.55 1.05)))
        ((= species (the-as int (fisher-species ice-shark)))
          (set! base-scale (if catch-display? 0.34 0.18))))
      (set! x-scale 1.0)
      (set! y-scale 1.0)
      (set! z-scale 1.0))

    ;; Main Cave dark-eco species always keep their authored body treatment,
    ;; even when the global suffix system changes ordinary colors.  The three
    ;; normal species scale strongly with weight so 3lb and 30/40lb specimens
    ;; are visibly different; Megaloviathan stays at its fixed ~1/3-pool-height
    ;; presentation scale.
    (when
      (= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
      (let* ((min-weight (the float (-> info min-weight-tenths)))
          (max-weight (the float (-> info max-weight-tenths)))
          (weight (the float (fisher-fish-weight-tenths self slot)))
          (weight-range (fmax 1.0 (- max-weight min-weight)))
          (weight-ratio
            (fmax 0.0 (fmin 1.0 (/ (- weight min-weight) weight-range))))
          (size-mult (+ 0.48 (* 1.22 weight-ratio))))

        (cond
          ((and
              (= species (the-as int (fisher-species fire-canyon-cellfish)))
              (or
                (= power-cell-task (the-as int (game-task lavatube-end)))
                (= power-cell-task (the-as int (game-task lavatube-buzzer)))
                (= power-cell-task (the-as int (game-task citadel-buzzer)))))
            ;; The final Lava Tube carriers are pure-black sharkey silhouettes.
            ;; Their reddish/orange Power Cell particle is still supplied by
            ;; the shared fire-canyon-cellfish particle path.
            (set! r 0.001)
            (set! g 0.001)
            (set! b 0.001)
            (set! base-scale (if catch-display? 0.195 0.14))
            (set! x-scale 1.0)
            (set! y-scale 1.0)
            (set! z-scale 1.0))

          ((= species (the-as int (fisher-species helix-voidfish)))
            (set! r 0.52)
            (set! g 0.005)
            (set! b 1.35)
            (set! base-scale
              (* (if catch-display? 0.90 0.58) size-mult))
            ;; Deliberately skinny/helix-like junglefish silhouette.
            (set! x-scale 0.44)
            (set! y-scale 0.55)
            (set! z-scale 1.28))

          ((= species (the-as int (fisher-species dark-precursor-fangfish)))
            (set! r 0.025)
            (set! g 0.001)
            (set! b 0.24)
            (set! base-scale
              (* (if catch-display? 0.88 0.56) size-mult))
            (set! x-scale 0.88)
            (set! y-scale 0.88)
            (set! z-scale 1.10))

          ((= species (the-as int (fisher-species phantasm-shark)))
            ;; Near-zero color multiplication makes the shark read as a
            ;; pitch-black silhouette; the large A multiplier below preserves
            ;; the requested dense/negative-looking material response.
            (set! r 0.001)
            (set! g 0.001)
            (set! b 0.001)
            (set! base-scale
              (* (if catch-display? 0.72 0.42) (+ 0.60 (* 1.35 weight-ratio))))
            (set! x-scale 1.0)
            (set! y-scale 1.0)
            (set! z-scale 1.0))

          ((= species (the-as int (fisher-species megaloviathan)))
            (set! r 0.015)
            (set! g 0.000)
            (set! b 0.060)
            (set! base-scale (if catch-display? 2.00 4.00))
            (set! x-scale 1.0)
            (set! y-scale 1.0)
            (set! z-scale 1.0)))))

    ;; Nuclear Bombfish: black sharkey silhouette, deliberately long and slim
    ;; without becoming a needle.  This override runs after the generic suffix
    ;; system so the boss fish cannot inherit Mutant/Golden/rare colors.
    (when
      (and
        (= (-> self location-id) (the-as int (fisher-zone finalboss-nuclear)))
        (= species (the-as int (fisher-species nuclear-bombfish))))
      (set! r 0.0)
      (set! g 0.0)
      (set! b 0.0)
      (set! base-scale (if catch-display? 0.74 0.44))
      (set! x-scale 0.62)
      (set! y-scale 0.72)
      (set! z-scale 1.55))

    ;; Catch/loot display fish are presentation models, not gameplay scale.
    ;; Keep them compact so the full fish and any rare attachment fit above
    ;; the loot window.
    (when catch-display?
      (*! base-scale 0.50))

    (set-vector! (-> fish-proc root scale) (* base-scale x-scale) (* base-scale y-scale) (* base-scale z-scale) 1.0)

    (set! (-> fish-proc draw color-mult r) r)
    (set! (-> fish-proc draw color-mult g) g)
    (set! (-> fish-proc draw color-mult b) b)
    (set! (-> fish-proc draw color-mult a) 1.0)

    ;; Dark-eco fish intentionally use alpha/color multiplication above the
    ;; ordinary 1.0 material value.  This is a material multiplier, not sprite
    ;; transparency, so values above one make the purple/black treatment read
    ;; much more aggressively in the dark pool.
    (when
      (= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
      (cond
        ((and
            (= species (the-as int (fisher-species fire-canyon-cellfish)))
            (or
              (= power-cell-task (the-as int (game-task lavatube-end)))
              (= power-cell-task (the-as int (game-task lavatube-buzzer)))
              (= power-cell-task (the-as int (game-task citadel-buzzer)))))
          (set! (-> fish-proc draw color-mult a) 6.00))
        ((= species (the-as int (fisher-species helix-voidfish)))
          (set! (-> fish-proc draw color-mult a) 2.40))
        ((= species (the-as int (fisher-species dark-precursor-fangfish)))
          (set! (-> fish-proc draw color-mult a) 3.50))
        ((= species (the-as int (fisher-species phantasm-shark)))
          (set! (-> fish-proc draw color-mult a) 8.00))
        ((= species (the-as int (fisher-species megaloviathan)))
          (set! (-> fish-proc draw color-mult a) 5.00))))

    (when
      (and
        (= (-> self location-id) (the-as int (fisher-zone finalboss-nuclear)))
        (= species (the-as int (fisher-species nuclear-bombfish))))
      (set! (-> fish-proc draw color-mult a) 8.00))

    (set! (-> fish-proc draw color-emissive r) 0.0)
    (set! (-> fish-proc draw color-emissive g) 0.0)
    (set! (-> fish-proc draw color-emissive b) 0.0)
    (set! (-> fish-proc draw color-emissive a) 1.0)

    (when
      (and
        (= (-> self location-id) (the-as int (fisher-zone village3-lava)))
        (not (fisher-rare-fish? suffix)))
      (cond
        ((= species (the-as int (fisher-species lava-drum)))
          (set! (-> fish-proc draw color-emissive r) 0.32)
          (set! (-> fish-proc draw color-emissive g) 0.055))
        ((= species (the-as int (fisher-species magma-serpent)))
          (set! (-> fish-proc draw color-emissive r) 0.28)
          (set! (-> fish-proc draw color-emissive g) 0.018))
        ((= species (the-as int (fisher-species inferno-shark)))
          (set! (-> fish-proc draw color-emissive r) 0.20)
          (set! (-> fish-proc draw color-emissive g) 0.012))))

    (when
      (and
        (= (-> self location-id) (the-as int (fisher-zone snow-ice)))
        (!= species (the-as int (fisher-species scout-fly))))
      (set! (-> fish-proc draw color-emissive r) 0.035)
      (set! (-> fish-proc draw color-emissive g) 0.18)
      (set! (-> fish-proc draw color-emissive b) 0.22))

    (when
      (= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
      (cond
        ((= species (the-as int (fisher-species helix-voidfish)))
          (set! (-> fish-proc draw color-emissive r) 0.08)
          (set! (-> fish-proc draw color-emissive b) 0.28))
        ((= species (the-as int (fisher-species dark-precursor-fangfish)))
          (set! (-> fish-proc draw color-emissive b) 0.055))))

    (when (and catch-display? (= suffix 16))
      (quaternion-axis-angle!
        (-> fish-proc root quat)
        0.0 0.0 1.0
        (degrees 180.0))))

  (none))

(defun fisher-fish-pointer ((self fisher-game) (slot int))
  (-> self fish-data slot slot visual))

(defun fisher-set-fish-pointer! ((self fisher-game) (slot int) (fish (pointer manipy)))
  (set! (-> self fish-data slot slot visual) fish)
  (none))

(defun fisher-delete-resident-slot! ((self fisher-game) (slot int))
  ;; Remove one resident without leaving a hole in the active prefix.  This is
  ;; used when Megaloviathan steals an already-hooked fish's place.
  (when
    (and
      (>= slot 0)
      (< slot (-> self fish-count)))
    (let* ((last-slot (- (-> self fish-count) 1))
        (victim (fisher-fish-pointer self slot)))

      (when victim
        (fisher-destroy-manipy! victim))

      (when (!= slot last-slot)
        (set! (-> self fish-data slot slot visual)
          (-> self fish-data slot last-slot visual))
        (set! (-> self fish-data slot slot species)
          (-> self fish-data slot last-slot species))
        (set! (-> self fish-data slot slot level)
          (-> self fish-data slot last-slot level))
        (set! (-> self fish-data slot slot suffix)
          (-> self fish-data slot last-slot suffix))
        (set! (-> self fish-data slot slot weight-tenths)
          (-> self fish-data slot last-slot weight-tenths))
        (set! (-> self fish-data slot slot power-cell-task)
          (-> self fish-data slot last-slot power-cell-task))
        (set! (-> self fish-data slot slot distance)
          (-> self fish-data slot last-slot distance))
        (set! (-> self fish-data slot slot lane)
          (-> self fish-data slot last-slot lane))
        (set! (-> self fish-data slot slot depth)
          (-> self fish-data slot last-slot depth))
        (set! (-> self fish-data slot slot direction)
          (-> self fish-data slot last-slot direction))
        (set! (-> self fish-data slot slot speed)
          (-> self fish-data slot last-slot speed))
        (set! (-> self fish-data slot slot cooldown)
          (-> self fish-data slot last-slot cooldown))
        (set! (-> self fish-data slot slot turn-time)
          (-> self fish-data slot last-slot turn-time))
        (set! (-> self fish-data slot slot turn-old-direction)
          (-> self fish-data slot last-slot turn-old-direction))
        (set! (-> self fish-data slot slot turn-side)
          (-> self fish-data slot last-slot turn-side)))

      (set! (-> self fish-data slot last-slot visual)
        (the-as (pointer manipy) #f))
      (-! (-> self fish-count) 1)))

  (none))

(defun fisher-dark-eco-teleport-fish! ((self fisher-game))
  ;; Pair fish randomly and swap complete logical positions.  Pair swaps
  ;; guarantee that two residents can never land on the same destination.
  ;; If the active count is odd, exactly one unpaired fish receives a fresh
  ;; random point in its species' authored depth band.
  (when
    (= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
    (let ((used-mask 0)
        (remaining (-> self fish-count))
        (slot-a -1)
        (slot-b -1))

      (while (> remaining 1)
        (set! slot-a -1)
        (set! slot-b -1)

        (while (< slot-a 0)
          (let ((candidate (rand-vu-int-range 0 (- (-> self fish-count) 1))))
            (when
              (zero? (logand used-mask (ash 1 candidate)))
              (set! slot-a candidate))))

        (set! used-mask (logior used-mask (ash 1 slot-a)))

        (while (< slot-b 0)
          (let ((candidate (rand-vu-int-range 0 (- (-> self fish-count) 1))))
            (when
              (zero? (logand used-mask (ash 1 candidate)))
              (set! slot-b candidate))))

        (set! used-mask (logior used-mask (ash 1 slot-b)))

        (let ((distance-a (fisher-fish-distance self slot-a))
            (lane-a (-> self fish-data slot slot-a lane))
            (depth-a (-> self fish-data slot slot-a depth)))
          (fisher-set-fish-distance!
            self slot-a (fisher-fish-distance self slot-b))
          (fisher-set-fish-lane!
            self slot-a (-> self fish-data slot slot-b lane))
          (fisher-set-fish-depth!
            self slot-a (-> self fish-data slot slot-b depth))

          (fisher-set-fish-distance! self slot-b distance-a)
          (fisher-set-fish-lane! self slot-b lane-a)
          (fisher-set-fish-depth! self slot-b depth-a))

        (-! remaining 2))

      (when (= remaining 1)
        (let ((odd-slot -1))
          (dotimes (slot (-> self fish-count))
            (when
              (and
                (< odd-slot 0)
                (zero? (logand used-mask (ash 1 slot))))
              (set! odd-slot slot)))

          (when (>= odd-slot 0)
            (let ((info
                    (fisher-species-info-for
                      (fisher-fish-species self odd-slot))))
              (fisher-set-fish-distance!
                self
                odd-slot
                (rand-vu-float-range
                  (meters 4.0)
                  (- (fisher-playfield-far-distance self) (meters 0.5))))
              (fisher-set-fish-lane!
                self odd-slot (rand-vu-float-range (meters -1.35) (meters 1.35)))
              (fisher-set-fish-depth!
                self
                odd-slot
                (rand-vu-float-range (-> info depth-min) (-> info depth-max))))))))

      ;; Teleport swaps preserve X/Z destinations, but the two giant predators
      ;; must remain down at the bottom instead of inheriting a topwater or
      ;; midwater fish's Y.  Re-pin their depth after every 45-second jump.
      (dotimes (slot (-> self fish-count))
        (let ((species (fisher-fish-species self slot)))
          (cond
            ((= species (the-as int (fisher-species megaloviathan)))
              (fisher-set-fish-depth!
                self
                slot
                (rand-vu-float-range (meters 30.0) (meters 33.5))))

            ((= species (the-as int (fisher-species phantasm-shark)))
              (fisher-set-fish-depth!
                self
                slot
                (rand-vu-float-range (meters 26.0) (meters 32.0))))))))

  (none))

(defun fisher-randomize-fish-slot!
  ((self fisher-game) (slot int))

  ;; The Final Boss pool is an authored vertical encounter.  Do not let any
  ;; generic randomizer move the Nuclear Bombfish away from its phase start.
  ;; Do this as a normal cond branch instead of using return: GOAL's return macro
  ;; has no named return target in this none-returning helper.
  (cond
    ((= (-> self location-id) (the-as int (fisher-zone finalboss-nuclear)))
      (when (= slot 0)
        (fisher-set-fish-distance! self slot *fisher-finalboss-lure-distance*)
        (fisher-set-fish-lane! self slot 0.0)
        (fisher-set-fish-depth!
          self slot
          (cond
            ((= (-> *fisher-finalboss-runtime* stage) 1) *fisher-finalboss-bottom-depth*)
            ((= (-> *fisher-finalboss-runtime* stage) 2) *fisher-finalboss-middle-depth*)
            (else *fisher-finalboss-topwater-depth*)))
        (fisher-set-fish-direction! self slot 1.0)
        (fisher-set-fish-speed! self slot (meters 0.035))
        (fisher-set-fish-cooldown! self slot 0.0)
        (fisher-set-fish-turn-time! self slot 0.0)
        (fisher-set-fish-turn-old-direction! self slot 1.0)
        (fisher-set-fish-turn-side! self slot 1.0)
        (fisher-set-fish-suffix! self slot 2)
        (fisher-set-fish-power-cell-task! self slot 0)
        (fisher-set-fish-level! self slot 20)
        (fisher-set-fish-weight-tenths! self slot 90000)))

    (else
      (fisher-set-fish-distance!
    self
    slot
    (rand-vu-float-range
      (meters 4.0)
      (- (fisher-playfield-far-distance self) (meters 0.5))))

  (fisher-set-fish-lane! self slot (rand-vu-float-range (meters -1.35) (meters 1.35)))

  (let ((info
        (fisher-species-info-for
          (fisher-fish-species self slot))))

    (cond
      ((and
          (= (-> self location-id) (the-as int (fisher-zone snow-ice)))
          (= (fisher-fish-species self slot)
            (the-as int (fisher-species scout-fly))))
        (fisher-set-fish-depth! self slot (meters 19.2)))

      ((and
          (= (-> self location-id) (the-as int (fisher-zone village3-lava)))
          (= (fisher-fish-species self slot)
            (the-as int (fisher-species scout-fly))))
        (fisher-set-fish-depth! self slot (meters 27.5)))
      ((= (-> self location-id) (the-as int (fisher-zone sunken-voltage)))
        (cond
          ((= (fisher-fish-species self slot)
              (the-as int (fisher-species electric-grubfish)))
            (fisher-set-fish-depth! self slot
              (rand-vu-float-range (meters 10.0) (meters 15.0))))
          ((= (fisher-fish-species self slot)
              (the-as int (fisher-species electric-eelfish)))
            (fisher-set-fish-depth! self slot
              (rand-vu-float-range (meters 16.0) (meters 18.2))))
          (else
            (fisher-set-fish-depth! self slot
              (rand-vu-float-range (meters 18.2) *fisher-sunken-max-depth*)))))
      (else
        (fisher-set-fish-depth!
          self
          slot
          (rand-vu-float-range
            (-> info depth-min)
            (-> info depth-max))))))

  (fisher-set-fish-direction! self slot (if (rand-vu-percent? 0.5) 1.0 -1.0))

  (fisher-set-fish-speed! self slot (rand-vu-float-range (meters 0.75) (meters 1.55)))

  (when
    (= (fisher-fish-species self slot)
      (the-as int (fisher-species electric-grubfish)))
    (fisher-set-fish-speed!
      self
      slot
      (* (fisher-fish-speed self slot) 1.5)))

  (cond
    ((or
        (= (fisher-fish-species self slot)
          (the-as int (fisher-species swamp-guppie)))
        (= (fisher-fish-species self slot)
          (the-as int (fisher-species black-lurker-shark))))
      (fisher-set-fish-speed!
        self
        slot
        (* (fisher-fish-speed self slot) 1.60)))

    ((= (fisher-fish-species self slot)
        (the-as int (fisher-species sludge-crappie)))
      (fisher-set-fish-speed!
        self
        slot
        (* (fisher-fish-speed self slot) 0.60)))

    ((= (fisher-fish-species self slot)
        (the-as int (fisher-species lava-drum)))
      (fisher-set-fish-speed!
        self
        slot
        (* (fisher-fish-speed self slot) 0.72)))

    ((= (fisher-fish-species self slot)
        (the-as int (fisher-species magma-serpent)))
      (fisher-set-fish-speed!
        self
        slot
        (* (fisher-fish-speed self slot) 0.27)))

    ((= (fisher-fish-species self slot)
        (the-as int (fisher-species inferno-shark)))
      (fisher-set-fish-speed!
        self
        slot
        (* (fisher-fish-speed self slot) 2.15)))

    ((= (fisher-fish-species self slot)
        (the-as int (fisher-species frost-biter)))
      (fisher-set-fish-speed! self slot (* (fisher-fish-speed self slot) 0.58)))

    ((= (fisher-fish-species self slot)
        (the-as int (fisher-species crystal-fish)))
      (fisher-set-fish-speed! self slot (* (fisher-fish-speed self slot) 0.52)))

    ((= (fisher-fish-species self slot)
        (the-as int (fisher-species ice-shark)))
      (fisher-set-fish-speed! self slot (* (fisher-fish-speed self slot) 2.65)))

    ((= (fisher-fish-species self slot)
        (the-as int (fisher-species helix-voidfish)))
      ;; normal speed: keep the base randomized rate
      (none))

    ((= (fisher-fish-species self slot)
        (the-as int (fisher-species dark-precursor-fangfish)))
      (fisher-set-fish-speed! self slot (* (fisher-fish-speed self slot) 0.55)))

    ((= (fisher-fish-species self slot)
        (the-as int (fisher-species phantasm-shark)))
      (fisher-set-fish-speed! self slot (* (fisher-fish-speed self slot) 2.85)))

    ((= (fisher-fish-species self slot)
        (the-as int (fisher-species megaloviathan)))
      (fisher-set-fish-speed! self slot (* (fisher-fish-speed self slot) 0.20))))

  (fisher-set-fish-cooldown! self slot 0.0)

  (fisher-set-fish-turn-time! self slot 0.0)

  (fisher-set-fish-turn-old-direction! self slot (fisher-fish-direction self slot))

  (when (!= (fisher-fish-species self slot) 4)
    (cond
      ((= (fisher-fish-species self slot)
          (the-as int (fisher-species fire-canyon-cellfish)))
        (fisher-set-fish-suffix! self slot 2)
        (fisher-set-fish-level!
          self
          slot
          (fisher-roll-level-for-current-zone self))
        (fisher-set-fish-weight-tenths!
          self
          slot
          (rand-vu-int-range 100 140)))

      ((= (fisher-fish-species self slot)
          (the-as int (fisher-species megaloviathan)))
        ;; Never let the giant become Mutant/Golden/rare or a hidden cell fish.
        (fisher-set-fish-suffix! self slot 2)
        (fisher-set-fish-power-cell-task! self slot 0)
        (fisher-set-fish-level!
          self
          slot
          (fisher-roll-level-for-current-zone self))
        (fisher-set-fish-weight-tenths!
          self
          slot
          (rand-vu-int-range 2000 4000)))

      (else
        (fisher-set-fish-suffix! self slot (fisher-roll-fish-suffix))
        (fisher-randomize-fish-level-and-weight! self slot)))

    (when (> (fisher-fish-power-cell-task self slot) 1)
      (fisher-set-fish-weight-tenths!
        self
        slot
        (max
          1
          (the int
            (+
              (*
                (the float (fisher-fish-weight-tenths self slot))
                1.70)
              0.5))))))
    ))

  (none))

(defun fisher-fish-position!
  ((self fisher-game) (slot int) (dst vector))

  (let ((side-axis
        (new 'stack-no-clear 'vector)))

    (set! (-> side-axis x) (-> self playfield-axis z))
    (set! (-> side-axis y) 0.0)
    (set! (-> side-axis z) (- (-> self playfield-axis x)))
    (set! (-> side-axis w) 0.0)

    (singlefish-vector-normalize-safe! side-axis 1.0)

    (singlefish-vector-add-scaled-safe! dst (-> self fishing-player-pos) (-> self playfield-axis) (fisher-fish-distance self slot))

    (singlefish-vector-add-scaled-safe! dst dst side-axis (fisher-fish-lane self slot))

    (set! (-> dst y) (- (-> self water-level) (fisher-fish-depth self slot)))

    (set! (-> dst w) 1.0))

  dst)

(defun fisher-set-manipy-facing!
  ((self fisher-game) (slot int) (fish-proc manipy))

  (let ((forward
        (new 'stack-no-clear 'vector))

      (side-forward (new 'stack-no-clear 'vector))

      (side-axis (new 'stack-no-clear 'vector))

      (down (new 'stack-no-clear 'vector))

      (rot (new 'stack-no-clear 'matrix))

      (turn-time
        (fisher-fish-turn-time self slot)))

    (cond
      ((> turn-time 0.0)
        (let* ((duration
              0.42)

            (progress (fmin 1.0 (/ turn-time duration)))

            (angle
              (* (degrees 180.0) progress)))

          (singlefish-vector-scale-safe! forward (-> self playfield-axis) (* (fisher-fish-turn-old-direction self slot) (cos angle)))

          (set! (-> side-axis x) (-> self playfield-axis z))
          (set! (-> side-axis y) 0.0)
          (set! (-> side-axis z) (- (-> self playfield-axis x)))
          (set! (-> side-axis w) 0.0)

          (singlefish-vector-normalize-safe! side-axis 1.0)

          (singlefish-vector-scale-safe! side-forward side-axis (* (fisher-fish-turn-side self slot) (sin angle)))

          (singlefish-vector-add-safe! forward forward side-forward)

          (+! turn-time (-> *display* seconds-per-frame))

          (if
            (>= turn-time duration)

            (fisher-set-fish-turn-time! self slot 0.0)

            (fisher-set-fish-turn-time!
              self
              slot
              turn-time))))

      (else
        (singlefish-vector-scale-safe!
          forward
          (-> self playfield-axis)
          (fisher-fish-direction self slot))))

    (set! (-> forward y) 0.0)
    (set! (-> forward w) 0.0)

    (singlefish-vector-normalize-safe! forward 1.0)

    (set-vector! down 0.0 -1.0 0.0 0.0)

    (forward-down->inv-matrix rot forward down)

    (matrix->quaternion
      (-> fish-proc root quat)
      rot)

    (when (= (fisher-fish-suffix self slot) 16)
      (let ((facing-quat (new 'stack-no-clear 'quaternion))
          (flip-quat (new 'stack-no-clear 'quaternion)))
        (quaternion-copy! facing-quat (-> fish-proc root quat))
        (quaternion-axis-angle! flip-quat 0.0 0.0 1.0 (degrees 180.0))
        (quaternion*! (-> fish-proc root quat) facing-quat flip-quat))))

  (none))

(defun fisher-randomize-manipy-anim-frame! ((fish-proc manipy))
  ;; Every resident fish uses the same looping flap animation.  Starting each
  ;; manipy on a different frame keeps the whole pool from moving in lockstep.
  (send-event
    fish-proc
    'set-frame-num
    (rand-vu-float-range 0.0 29.0))
  (none))

(defun fisher-spawn-gameplay-fish
  ((owner fisher-game) (slot int))

  (let ((pos
        (new 'stack-no-clear 'vector))

      (fish
        (the-as (pointer manipy) #f)))

    (fisher-fish-position! owner slot pos)

    (set!
      fish
      (the-as
        (pointer manipy)
        (manipy-spawn
          pos
          #f
          (cond
            ;; Main Cave species keep their authored body skeleton even when
            ;; the global rare-suffix system adds an attachment/effect.
            ((and
                (= (-> owner location-id) (the-as int (fisher-zone maincave-dark-eco)))
                (or
                  (= (fisher-fish-species owner slot) (the-as int (fisher-species helix-voidfish)))
                  (= (fisher-fish-species owner slot) (the-as int (fisher-species megaloviathan)))))
              *fisher-junglefish-sg*)
            ((and
                (= (-> owner location-id) (the-as int (fisher-zone maincave-dark-eco)))
                (= (fisher-fish-species owner slot) (the-as int (fisher-species dark-precursor-fangfish))))
              *catch-fishc-sgc*)
            ((and
                (= (-> owner location-id) (the-as int (fisher-zone maincave-dark-eco)))
                (= (fisher-fish-species owner slot) (the-as int (fisher-species phantasm-shark))))
              *sharkey-sgc*)

            ((or
                (= (fisher-fish-suffix owner slot) 7)
                (= (fisher-fish-suffix owner slot) 11)
                (= (fisher-fish-suffix owner slot) 14)
                (= (fisher-fish-suffix owner slot) 15)
                (= (fisher-fish-suffix owner slot) 16))
              *catch-fishb-sgc*)
            ((or
                (= (fisher-fish-suffix owner slot) 8)
                (= (fisher-fish-suffix owner slot) 12))
              *catch-fishc-sgc*)
            ((or
                (= (fisher-fish-suffix owner slot) 9)
                (= (fisher-fish-suffix owner slot) 10)
                (= (fisher-fish-suffix owner slot) 13))
              *catch-fisha-sgc*)
            (else
              (the-as skeleton-group
                (->
                  (fisher-species-info-for
                    (fisher-fish-species owner slot))
                  skeleton))))
          #f
          :from *default-dead-pool*
          :to *default-pool*
          :name "fisher-gameplay-fish")))

    (when fish
      (let ((fish-proc
            (-> fish 0 self)))

        (when fish-proc
          (send-event fish-proc 'anim-mode 'loop)
          (fisher-randomize-manipy-anim-frame! (the-as manipy fish-proc))

          ;; Manipys may be reused from the dead pool with draw-status hidden
          ;; still set.  Explicitly initialize BOTH visibility mechanisms here
          ;; so a newly spawned resident can never be logically active while
          ;; remaining invisible.
          (let ((show-now?
                  (and
                    (fisher-pool-visuals-needed? owner)
                    (< slot (-> owner fish-count)))))
            (cond
              (show-now?
                (logclear!
                  (-> (the-as manipy fish-proc) draw status)
                  (draw-status hidden)))
              (else
                (logior!
                  (-> (the-as manipy fish-proc) draw status)
                  (draw-status hidden))))

            (send-event
              fish-proc
              'max-vis-dist
              (if show-now?
                (meters 999999.0)
                (meters 0.0))))

          (set! (-> (the-as manipy fish-proc) root trans quad) (-> pos quad))

          (fisher-apply-slot-appearance! owner slot (the-as manipy fish-proc) #f)

          (fisher-set-manipy-facing!
            owner
            slot
            (the-as manipy fish-proc))

          (fisher-spawn-rare-fish-attachments!
            (the-as manipy fish-proc)
            (fisher-fish-suffix owner slot)
            #f)

          (when
            (= (-> owner location-id) (the-as int (fisher-zone snow-ice)))
            (fisher-spawn-snow-ice-crystal!
              (the-as manipy fish-proc)
              (fisher-fish-species owner slot)
              #f)))))

    fish))

(defun fisher-destroy-manipy! ((fish (pointer manipy)))
  ;; Never call cleanup-for-death on these temporary fishing manipys.  Their
  ;; drawable skeleton can already have been released by the animation/art
  ;; system by the time the catch transition removes them.  cleanup-for-death
  ;; then follows that stale skel pointer through ja-channel-set! and crashes.
  ;;
  ;; Hiding and deactivating the owning process is sufficient.  The slot is
  ;; cleared immediately by the caller, so no later code can reuse the ppointer.
  (when fish
    (let ((proc (-> fish 0 self)))
      (when proc
        (set-vector!
          (-> (the-as manipy proc) root scale)
          0.0
          0.0
          0.0
          1.0)
        (send-event proc 'max-vis-dist (meters 0.0))
        (deactivate proc))))
  (none))

(defun fisher-despawn-rendered-fish! ((self fisher-game))
  (dotimes (i *fisher-max-fish-slots*)
    (let ((fish (fisher-fish-pointer self i)))
      (when fish
        (when (-> fish 0 self)
          (fisher-destroy-manipy! fish))
        (fisher-set-fish-pointer!
          self
          i
          (the-as (pointer manipy) #f)))))
  (set! (-> self pool-rendered?) #f)
  (none))

(defun fisher-destroy-whole-pool! ((self fisher-game))
  ;; Blackout/distance teardown owns both layers: all resident manipy
  ;; processes and the logical table describing them.
  (fisher-despawn-rendered-fish! self)
  (dotimes (i *fisher-max-fish-slots*)
    (fisher-set-fish-pointer!
      self
      i
      (the-as (pointer manipy) #f)))
  (set! (-> self fish-count) 0)
  (set! (-> self pool-configured?) #f)
  (set! (-> self pool-rendered?) #f)
  (set! (-> self pool-golden?) #f)
  (set! (-> self hooked-fish) #f)
  (set! (-> self hooked-fish-slot) -1)
  (set! (-> self fish-state) 'free)
  (set! (-> self fish-fighting?) #f)
  (fisher-clear-button-fight! self)
  (none))

(defun fisher-spawn-rendered-fish! ((self fisher-game))
  ;; The fish processes validate this flag as soon as they begin running, so
  ;; activate the persistent fishbox before spawning any resident fish.
  (set! *singlefish-session-active?* #t)

  (dotimes (i *fisher-max-fish-slots*)
    (when
      (and
        (< i (-> self fish-count))
        (not (fisher-fish-pointer self i)))
      (fisher-set-fish-pointer!
        self
        i
        (fisher-spawn-gameplay-fish self i))))

  (set! (-> self pool-rendered?) #t)
  (none))

(defun fisher-rebuild-logical-pool! ((self fisher-game) (golden? symbol))
  (fisher-despawn-rendered-fish! self)
  (+! *singlefish-session-id* 1)
  (fisher-configure-location-table! self)
  (dotimes (i *fisher-max-fish-slots*)
    (fisher-randomize-fish-slot! self i))
  (set! (-> self pool-configured?) #t)
  (set! (-> self pool-golden?) golden?)
  (none))

(defun fisher-pool-visuals-needed? ((self fisher-game))
  (and
    *fisher-session-active?*
    (or
      (-> self camera-underwater?)
      ;; Keep the actual hooked fish visible while it rises out of the water
      ;; and travels toward Jak.  Without catch-return here, the persistent
      ;; pool visibility pass hides it as soon as the camera breaks surface.
      (= (-> self fish-state) 'catch-return)
      (= (-> self fish-state) 'catch-enter)
      (= (-> self fish-state) 'catch-display)
      (= (-> self fish-state) 'catch-exit)
      (= (-> self fish-state) 'rare-enter)
      (= (-> self fish-state) 'rare-display)
      (= (-> self fish-state) 'rare-exit))))

(defun fisher-pool-fish-invisible? ((self fisher-game))
  ;; A cast and every catch/rare transition are absolute population locks.
  ;; Reeling the lure completely in clears casted? before the hooked fish has
  ;; finished returning and releasing its slot.  Using casted? alone therefore
  ;; allowed a pending normal/golden-hour rebuild to destroy that fish from
  ;; inside its own update, producing an infinite execute loop.
  ;;
  ;; Outside fishing the resident pool is hidden and safe to reconcile.  While
  ;; fishing, reconciliation is legal only in the fully idle pre-cast state.
  (or
    (not *fisher-session-active?*)
    (and
      (not (-> self casted?))
      (= (-> self fish-state) 'free)
      (= (-> self cast-state) 'ready)
      (not (-> self hooked-fish))
      (< (-> self hooked-fish-slot) 0))))

(defun fisher-set-resident-fish-visible!
  ((self fisher-game) (visible? symbol))

  ;; Child attachment manipys read this from their transform behavior.
  (set! *fisher-resident-fish-visible?* visible?)

  ;; The persistent fishbox must keep every resident process alive so fish
  ;; retain their exact positions and continue swimming between fishing
  ;; sessions.  Visibility is therefore controlled only through draw distance;
  ;; never clear a slot, despawn a manipy, or rebuild the table here.
  (dotimes (i *fisher-max-fish-slots*)
    (let ((fish (fisher-fish-pointer self i)))
      (when fish
        (let ((fish-proc (-> fish 0 self)))
          (when fish-proc
            (let ((show-this? (and visible? (< i (-> self fish-count)))))
              ;; max-vis-dist alone is not a reliable visibility toggle for
              ;; reused manipys.  Set the drawable hidden bit explicitly too,
              ;; so every species is restored when casting and hidden on exit.
              (cond
                (show-this?
                  (logclear!
                    (-> (the-as manipy fish-proc) draw status)
                    (draw-status hidden)))
                (else
                  (logior!
                    (-> (the-as manipy fish-proc) draw status)
                    (draw-status hidden))))

              (send-event
                fish-proc
                'max-vis-dist
                (if show-this?
                  (meters 999999.0)
                  (meters 0.0)))))))))

  (none))

(defun fisher-remove-completed-special-fish! ((self fisher-game))
  ;; Persistent residents can outlive the moment their reward is completed.
  ;; Remove any now-invalid special while the pool is hidden; the normal refill
  ;; path will replace the empty slot and its hard gates prevent reassignment.
  (let ((buzzer-task (fisher-buzzer-task-for-location self)))
    (dotimes (slot (-> self fish-count))
      (let ((species (fisher-fish-species self slot))
          (cell-task (fisher-fish-power-cell-task self slot))
          (remove? #f))

        (when
          (= species (the-as int (fisher-species scout-fly)))
          (let ((index (fisher-fish-weight-tenths self slot)))
            (when
              (or
                (>= (buzzer-count *game-info* buzzer-task) 7)
                (< index 0)
                (>= index 7)
                (got-buzzer? *game-info* buzzer-task index))
              (set! remove? #t))))

        (when
          (and
            (= species
              (the-as int (fisher-species fire-canyon-cellfish)))
            (= cell-task (the-as int (game-task firecanyon-end)))
            (task-complete?
              *game-info*
              (game-task firecanyon-end)))
          (set! remove? #t))

        (when
          (and
            (> cell-task 1)
            (task-complete?
              *game-info*
              (the-as game-task cell-task)))
          (set! remove? #t))

        (when remove?
          (let ((fish (fisher-fish-pointer self slot)))
            (when fish
              (fisher-destroy-manipy! fish)))
          (fisher-set-fish-pointer!
            self
            slot
            (the-as (pointer manipy) #f))
          (fisher-set-fish-power-cell-task! self slot 0)))))

  (none))

(defun fisher-desired-population-count
  ((self fisher-game) (golden? symbol))

  ;; Preserve the Main Cave species-count contract when golden hours change
  ;; while the persistent fishbox is hidden.  One Megaloviathan is included
  ;; in both totals.
  (when
    (= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
    (return
      (min
        *fisher-max-fish-slots*
        (+
          1
          (if golden? (rand-vu-int-range 5 10) (rand-vu-int-range 2 10))
          (if golden? (rand-vu-int-range 6 10) (rand-vu-int-range 2 6))
          (if golden? (rand-vu-int-range 2 4) (rand-vu-int-range 1 2))))))

  (let* ((zone (fisher-zone-info-for (the-as fisher-zone (-> self location-id))))
      (count
        (if golden?
          (rand-vu-int-range
            (-> zone golden-fish-count-min)
            (-> zone golden-fish-count-max))
          (rand-vu-int-range
            (-> zone normal-fish-count-min)
            (-> zone normal-fish-count-max)))))

    (min *fisher-max-fish-slots* count)))

(defun fisher-apply-hidden-population-count!
  ((self fisher-game) (golden? symbol))

  ;; Golden-hour transitions must never rebuild or destroy the resident table.
  ;; A full rebuild can invalidate the fish currently completing a reel/catch
  ;; transition and trap that process in an execute loop.  Keep all resident
  ;; processes alive and change only how many slots are active/visible.
  (let ((old-count (-> self fish-count))
      (new-count (fisher-desired-population-count self golden?)))

    (set! (-> self fish-count) new-count)
    (set! (-> self pool-golden?) golden?)

    ;; When the table grows, reveal existing hidden residents or create only
    ;; the newly required slots.  Never touch slots below old-count.
    (when (> new-count old-count)
      (dotimes (offset (- new-count old-count))
        (let ((slot (+ old-count offset)))
          ;; Every newly activated resident starts as a normal zone fish, then
          ;; gets the same passive special-fish opportunity as a caught slot.
          (fisher-set-fish-species!
            self
            slot
            (fisher-table-species-for-new-slot self golden?))
          (fisher-set-fish-power-cell-task! self slot 0)
          (fisher-set-fish-suffix! self slot (fisher-roll-fish-suffix))
          (fisher-randomize-fish-slot! self slot)
          (fisher-roll-passive-special-for-slot! self slot)

          ;; If a resident process already exists in a hidden excess slot, its
          ;; old skeleton cannot be changed safely.  Deactivate it and replace
          ;; only while the pool is invisible.
          (when (fisher-fish-pointer self slot)
            (fisher-destroy-manipy! (fisher-fish-pointer self slot))
            (fisher-set-fish-pointer!
              self
              slot
              (the-as (pointer manipy) #f)))

          (fisher-set-fish-pointer!
            self
            slot
            (fisher-spawn-gameplay-fish self slot)))))

    ;; Revalidate active slots after a normal/golden population change.
    (fisher-refresh-active-slot-levels! self))

  (none))

(defun fisher-maintain-pool-rendering! ((self fisher-game))
  ;; A nearby fisher-game owns one persistent fishbox.  The resident processes
  ;; continue swimming while their drawables are hidden.  Creation, refill, and
  ;; normal/golden table reconciliation happen only while those fish are
  ;; invisible, never while the underwater pool is on screen.
  (set! *singlefish-session-active?* #t)

  (unless (-> self pool-configured?)
    (fisher-rebuild-logical-pool! self (fisher-golden-hour?)))

  (unless (-> self pool-rendered?)
    (fisher-spawn-rendered-fish! self))

  (when (fisher-pool-fish-invisible? self)
    ;; Completion gates apply to both new rolls and persistent residents.
    (fisher-remove-completed-special-fish! self)

    ;; The existing Hub 2 Mountain Pass carriers remain unchanged.
    (fisher-add-mountain-pass-cellfish-slots! self)

    ;; Village3 lava additionally carries only the two Mountain Pass rewards
    ;; that cannot otherwise be obtained with normal collectable processes
    ;; disabled: Reach the End + 7 Scout Flies.
    (fisher-add-village3-mountain-pass-cellfish-slots! self)

    ;; The two Lava Tube carriers are guaranteed in the Main Cave Dark Eco
    ;; pool once 72 cells are held.  Recheck while hidden so an already-created
    ;; persistent pool updates immediately when the threshold is reached.
    (fisher-add-lava-tube-cellfish-slots! self)

    ;; Keep Citadel's seven-fly reward represented by the Dark Eco shark.
    (fisher-add-citadel-buzzer-cellfish-slot! self)

    ;; Debug mode must guarantee that the Fire Canyon Cell Fish exists even
    ;; when the persistent fishbox was created before debug was enabled or was
    ;; carried through a blackout/load transition.  The insertion replaces an
    ;; existing resident slot, so it never exceeds the configured fish cap.
    (when
      (and
        *fisher-in-debug?*
        (not
          (fisher-has-species?
            self
            (the-as int (fisher-species fire-canyon-cellfish)))))
      (fisher-add-fire-canyon-cellfish-slot! self))

    (let ((golden? (fisher-golden-hour?)))
      (cond
        ((!= golden? (-> self pool-golden?))
          ;; Change only the active population count.  Resident fish beyond a
          ;; reduced count remain alive but hidden, and are reused if the table
          ;; grows again.  No table walk, despawn, or cleanup occurs here.
          (fisher-apply-hidden-population-count! self golden?))

        (else
          ;; Replace caught/missing residents only while the pool is hidden.
          (fisher-refill-missing-fish! self)))))

  ;; Keep the resident processes and logical table alive at all times, but do
  ;; not draw them while Jak is outside fishing or while the fishing camera is
  ;; above water.  Re-entering fishing reveals these exact same fish at their
  ;; continuously updated positions.
  (fisher-set-resident-fish-visible!
    self
    (fisher-pool-visuals-needed? self))

  (none))

(defun fisher-refill-missing-fish! ((self fisher-game))
  (dotimes (i *fisher-max-fish-slots*)
    (when
      (and (< i (-> self fish-count)) (not (fisher-fish-pointer self i)))

      ;; A caught slot must not retain its old species forever.  Roll a
      ;; fresh ordinary zone species first, then allow this exact replacement
      ;; to become any currently eligible special fish.
      (fisher-set-fish-species!
        self
        i
        (fisher-table-species-for-new-slot self (-> self pool-golden?)))
      (fisher-set-fish-power-cell-task! self i 0)
      (fisher-set-fish-suffix! self i (fisher-roll-fish-suffix))
      (fisher-randomize-fish-slot! self i)
      (fisher-roll-passive-special-for-slot! self i)

      (fisher-set-fish-pointer!
        self
        i
        (fisher-spawn-gameplay-fish
          self
          i))))

  (none))

(defun singlefish-start-session! ((self fisher-game))
  ;; Entering fishing reuses the existing fishbox exactly as it is.  Do not
  ;; rebuild, randomize, or respawn the resident fish here.
  (set! *singlefish-session-active?* #t)

  (unless (-> self pool-configured?)
    (fisher-rebuild-logical-pool! self (fisher-golden-hour?)))

  (unless (-> self pool-rendered?)
    (fisher-spawn-rendered-fish! self))

  (set! (-> self hooked-fish) #f)
  (set! (-> self hooked-fish-slot) -1)
  (set! (-> self fish-state) 'free)
  (set! (-> self fish-hook-time) 0.0)
  (set! (-> self fish-reel-progress) 0.0)
  (set! (-> self fish-fight-time) 0.0)
  (set! (-> self fish-fighting?) #f)
  (fisher-clear-button-fight! self)

  ;; The camera begins above water, so leave the logical fish hidden until
  ;; fisher-maintain-pool-rendering! decides they are needed.
  (none))

(defun fisher-manipy-distance-to-lure
  ((self fisher-game) (fish-proc manipy))

  (let ((delta
        (new 'stack-no-clear 'vector)))

    (singlefish-vector-sub-safe! delta (-> self lure-pos) (-> fish-proc root trans))

    (singlefish-vector-length-safe
      delta)))

(defun fisher-debug-draw-logical-fish-marker!
  ((self fisher-game) (slot int))

  (when
    (and *fisher-in-debug?* (< slot (-> self fish-count)))

    (let ((center (new 'stack-no-clear 'vector))
        (left (new 'stack-no-clear 'vector))
        (right (new 'stack-no-clear 'vector))
        (top (new 'stack-no-clear 'vector))
        (bottom (new 'stack-no-clear 'vector))
        (front (new 'stack-no-clear 'vector))
        (back (new 'stack-no-clear 'vector))
        (color
          (if
            (= (fisher-fish-species self slot) 2)
            (new 'static 'rgba :r #xff :g #x20 :b #xff :a #xff)
            (new 'static 'rgba :r #xff :g #xff :b #xff :a #xff))))

      (fisher-fish-position! self slot center)
      (singlefish-vector-copy-safe! left center)
      (singlefish-vector-copy-safe! right center)
      (singlefish-vector-copy-safe! top center)
      (singlefish-vector-copy-safe! bottom center)
      (singlefish-vector-copy-safe! front center)
      (singlefish-vector-copy-safe! back center)

      (-! (-> left x) (meters 0.6))
      (+! (-> right x) (meters 0.6))
      (+! (-> top y) (meters 0.6))
      (-! (-> bottom y) (meters 0.6))
      (+! (-> front z) (meters 0.6))
      (-! (-> back z) (meters 0.6))

      (fisher-debug-line! left right color)
      (fisher-debug-line! top bottom color)
      (fisher-debug-line! front back color)))

  (none))

(defun fisher-fish-lure-sense-range ((self fisher-game) (slot int))
  (if
    (= (fisher-fish-species self slot) (the-as int (fisher-species magma-serpent)))
    (meters 1.35)
    (meters 5.0)))

(defun fisher-fish-lure-sense-origin-offset ((self fisher-game) (slot int))
  (if
    (= (fisher-fish-species self slot) (the-as int (fisher-species magma-serpent)))
    (meters 10.0)
    0.0))

(defun fisher-fish-lure-sense-half-angle ((self fisher-game) (slot int))
  (if
    (= (fisher-fish-species self slot) (the-as int (fisher-species magma-serpent)))
    (degrees 20.0)
    (degrees 35.0)))

(defun fisher-fish-lure-sense-dot-min ((self fisher-game) (slot int))
  (cos (fisher-fish-lure-sense-half-angle self slot)))

(defun fisher-debug-draw-fish-cone!
  ((self fisher-game) (slot int) (fish-proc manipy))

  (when *fisher-in-debug?*
    (let* ((origin (new 'stack-no-clear 'vector))
        (forward (new 'stack-no-clear 'vector))
        (forward-end (new 'stack-no-clear 'vector))
        (upper-end (new 'stack-no-clear 'vector))
        (lower-end (new 'stack-no-clear 'vector))
        (arc-a (new 'stack-no-clear 'vector))
        (arc-b (new 'stack-no-clear 'vector))
        (color (new 'static 'rgba :r #x20 :g #xff :b #xff :a #xff))
        (range (fisher-fish-lure-sense-range self slot))
        (origin-offset (fisher-fish-lure-sense-origin-offset self slot))
        (cone-angle (fisher-fish-lure-sense-half-angle self slot))
        ;; The debug cone's end radius must come from the same live angle and
        ;; center-line range used by this fish's anticipation test.
        (cone-radius (* range (tan cone-angle))))

      (singlefish-vector-scale-safe!
        forward (-> self playfield-axis) (fisher-fish-direction self slot))
      (set! (-> forward y) 0.0)
      (set! (-> forward w) 0.0)
      (singlefish-vector-normalize-safe! forward 1.0)

      (singlefish-vector-copy-safe! origin (-> fish-proc root trans))
      (when (> origin-offset 0.0)
        (singlefish-vector-add-scaled-safe! origin origin forward origin-offset))

      ;; Range is the center-line length.  Build the cone cap at that exact
      ;; distance, then expand it by the fish's true cone radius.
      (singlefish-vector-add-scaled-safe! forward-end origin forward range)
      (singlefish-vector-copy-safe! upper-end forward-end)
      (singlefish-vector-copy-safe! lower-end forward-end)
      (+! (-> upper-end y) cone-radius)
      (-! (-> lower-end y) cone-radius)

      (fisher-debug-line! origin forward-end color)
      (fisher-debug-line! origin upper-end color)
      (fisher-debug-line! origin lower-end color)
      (fisher-debug-line! upper-end lower-end color)

      ;; Draw a curved profile between the lower and upper edges so changes to
      ;; species angle/range are immediately visible in debug mode.
      (dotimes (i 8)
        (let* ((t-a (/ (the float i) 8.0))
            (t-b (/ (the float (+ i 1)) 8.0))
            (y-a (* cone-radius (- (* t-a 2.0) 1.0)))
            (y-b (* cone-radius (- (* t-b 2.0) 1.0))))
          (singlefish-vector-copy-safe! arc-a forward-end)
          (singlefish-vector-copy-safe! arc-b forward-end)
          (+! (-> arc-a y) y-a)
          (+! (-> arc-b y) y-b)
          (fisher-debug-line! arc-a arc-b color)))))

  (none))

(defun fisher-manipy-can-sense-lure?
  ((self fisher-game) (slot int) (fish-proc manipy))

  (let ((to-lure (new 'stack-no-clear 'vector))
      (forward (new 'stack-no-clear 'vector))
      (sense-origin (new 'stack-no-clear 'vector))
      (distance 0.0)
      (horizontal-distance 0.0)
      (facing-dot 0.0)
      (sense-range (fisher-fish-lure-sense-range self slot))
      (origin-offset (fisher-fish-lure-sense-origin-offset self slot))
      (sense-dot-min (fisher-fish-lure-sense-dot-min self slot)))

    (singlefish-vector-scale-safe!
      forward (-> self playfield-axis) (fisher-fish-direction self slot))
    (set! (-> forward y) 0.0)
    (set! (-> forward w) 0.0)
    (singlefish-vector-normalize-safe! forward 1.0)

    (singlefish-vector-copy-safe! sense-origin (-> fish-proc root trans))

    (when (> origin-offset 0.0)
      (singlefish-vector-add-scaled-safe!
        sense-origin sense-origin forward origin-offset))

    (singlefish-vector-sub-safe! to-lure (-> self lure-pos) sense-origin)
    (set! distance (singlefish-vector-length-safe to-lure))

    ;; The Final Boss shaft is intentionally only a minimum-cast-width column.
    ;; Its one Nuclear Bombfish must be able to take the hook at the phase depth
    ;; without depending on which way its idle swim happened to be facing.  Keep
    ;; the ordinary facing cone everywhere else, but use a tight radial sense in
    ;; this one authored encounter.
    (when
      (and
        (= (-> self location-id) (the-as int (fisher-zone finalboss-nuclear)))
        (= (fisher-fish-species self slot)
           (the-as int (fisher-species nuclear-bombfish))))
      (return (<= distance (meters 5.0))))

    (set! (-> to-lure y) 0.0)
    (set! (-> to-lure w) 0.0)
    (set! horizontal-distance (singlefish-vector-length-safe to-lure))

    (when (> horizontal-distance (meters 0.001))
      (singlefish-vector-normalize-safe! to-lure 1.0))

    (set! facing-dot (vector-dot forward to-lure))

    (and
      (<= distance sense-range)
      (> horizontal-distance (meters 0.001))
      (>= facing-dot sense-dot-min))))

(defun fisher-move-manipy-toward!
  ((fish-proc manipy) (target vector) (speed float))

  (let ((delta
        (new 'stack-no-clear 'vector))

      (distance 0.0)

      (step
        0.0))

    (singlefish-vector-sub-safe! delta target (-> fish-proc root trans))

    (set! distance (singlefish-vector-length-safe delta))

    (when (> distance (meters 0.001))
      (singlefish-vector-normalize-safe! delta 1.0)

      (set! step (fmin distance (* speed (-> *display* seconds-per-frame))))

      (singlefish-vector-add-scaled-safe!
        (-> fish-proc root trans)
        (-> fish-proc root trans)
        delta
        step))

    distance))

(defun fisher-fish-scared-off!
  ((self fisher-game) (slot int))

  (let ((fish
        (fisher-fish-pointer
          self
          slot))

      (from-origin (new 'stack-no-clear 'vector))

      (side-axis
        (new 'stack-no-clear 'vector)))

    (when fish
      (let ((fish-proc
            (the-as manipy
              (-> fish 0 self))))

        (singlefish-vector-sub-safe! from-origin (-> fish-proc root trans) (-> self fishing-player-pos))

        (set! (-> side-axis x) (-> self playfield-axis z))
        (set! (-> side-axis y) 0.0)
        (set! (-> side-axis z) (- (-> self playfield-axis x)))
        (set! (-> side-axis w) 0.0)

        (singlefish-vector-normalize-safe! side-axis 1.0)

        (fisher-set-fish-distance!
          self
          slot
          (fmax
            (meters 3.5)
            (fmin
              (fisher-playfield-far-distance self)
              (vector-dot from-origin (-> self playfield-axis)))))

        (fisher-set-fish-lane! self slot (fmax (meters -1.5) (fmin (meters 1.5) (vector-dot from-origin side-axis))))

        (fisher-set-fish-depth!
          self
          slot
          (-
            (-> self water-level)
            (-> fish-proc root trans y))))))

  (fisher-set-fish-direction! self slot (if (rand-vu-percent? 0.5) 1.0 -1.0))

  (fisher-set-fish-turn-time! self slot 0.0)

  ;; A scared fish must wait seven seconds before it may sense and
  ;; approach the lure again.
  (fisher-set-fish-cooldown! self slot 7.0)

  (set! (-> self hooked-fish-slot) -1)
  (set! (-> self fish-state) 'free)
  (set! (-> self fish-scare-on-arrival?) #f)
  (set! (-> self fish-hook-time) 0.0)
  (set! (-> self fish-reel-progress) 0.0)
  (set! (-> self fish-fighting?) #f)
  (fisher-clear-button-fight! self)
  (set! (-> self hooked-fish-poison-dps) 0.0)
  (set! (-> self fish-fight-time) 0.0)
  (set! (-> self fish-fight-phase) 0.0)
  (set! (-> self fish-message) "SCARED OFF")
  (set! (-> self fish-message-time) 1.5)

  (none))

(defun fisher-catch-buzzer-fish! ((self fisher-game) (slot int))
  (let* ((task (fisher-buzzer-task-for-location self))
      (buzzer-index (fisher-fish-weight-tenths self slot))
      (fish (fisher-fish-pointer self slot))
      (before-count (buzzer-count *game-info* task))
      (after-count before-count)
      (awarded? #f))

    (when
      (or
        (< buzzer-index 0)
        (>= buzzer-index 7)
        (got-buzzer? *game-info* task buzzer-index))

      (set!
        buzzer-index
        (fisher-find-missing-buzzer-index
          task
          (rand-vu-int-range 0 6)
          -1)))

    (when
      (and
        (>= buzzer-index 0)
        (< buzzer-index 7)
        (not (got-buzzer? *game-info* task buzzer-index)))

      (send-event
        *target*
        'get-pickup
        (pickup-type buzzer)
        (the float
          (logior
            (the int task)
            (ash buzzer-index 16))))

      (set! after-count (buzzer-count *game-info* task))
      (set! awarded? (> after-count before-count))

      (when awarded?
        (runs-on-fly-pickup)
        (close-specific-task! task (task-status need-hint))))

    (when
      (and awarded? fish)
      (let* ((fish-proc (the-as manipy (-> fish 0 self)))
          (hud-fly
            (manipy-spawn
              (-> fish-proc root trans)
              #f
              *buzzer-sgc*
              #f
              :to *entity-pool*)))

        (when hud-fly
          (send-event
            (ppointer->process hud-fly)
            'become-hud-object
            (ppointer->process (-> *hud-parts* buzzers))))))

    (set! (-> self caught-fish-species) 4)
    (set! (-> self caught-fish-suffix) 2)
    (set! (-> self caught-fish-level) (fisher-fish-level self slot))
    (set! (-> self caught-weight-tenths) 500)
    (set! (-> self caught-orb-value) 0)
    (set! (-> self caught-fish-xp) 0)
    (set! (-> self caught-buzzer-task) (the int task))
    (set! (-> self caught-buzzer-count) (buzzer-count *game-info* task))

    (set!
      (-> self buzzer-victory-pending?)
      (and awarded? (>= (-> self caught-buzzer-count) 7)))

    (set! (-> self fish-state) 'catch-return)
    (set! (-> self cast-state) 'catch-transition)
    (set! (-> self catch-transition-time) 0.0)
    (set! (-> self catch-menu-offset) 150.0)
    (set! (-> self camera-state) 'before-cast)
    (set! (-> self casted?) #f)
    (set! (-> self fish-fighting?) #f)
    (set! (-> self fish-fight-time) 0.0)
    (set! (-> self fish-fight-phase) 0.0)
    (set! (-> self fish-fight-base-y) 0.0)
    (stop-sound-file "water-waves.wav")
    (fisher-remove-lure-snake! self))

  (none))

(defun fisher-finish-manipy-catch!
  ((self fisher-game) (slot int))

  (fisher-play-fish-win-sound!)

  (when (= (fisher-fish-species self slot) 4)
    (fisher-catch-buzzer-fish! self slot))

  (unless (= (fisher-fish-species self slot) 4)
    (let* ((species (fisher-fish-species self slot))
        (suffix (fisher-fish-suffix self slot))
        (fish-level (fisher-fish-level self slot))
        (jak-level (fisher-current-level))
        (weight (fisher-fish-weight-tenths self slot))
        (power-cell-task (fisher-fish-power-cell-task self slot))

        (orb-weight
          (cond
            ((= species (the-as int (fisher-species fire-canyon-cellfish)))
              130)

            ((> power-cell-task 1)
              (max
                1
                (the int
                  (+
                    (/ (the float weight) 1.70)
                    0.5))))

            (else weight)))

        (value-mult (fisher-suffix-value-multiplier suffix))
        (level-value-mult (fisher-level-worth-multiplier fish-level jak-level))
        (base-value
          (->
            (fisher-species-info-for species)
            orb-value-multiplier))
        (catch-xp
          (the int
            (+
              (*
                (the float (fisher-calculate-catch-xp fish-level suffix))
                (if (= species 3) 1.75 1.0))
              0.5)))
        (raw-orb-value
          (the int
            (+
              (*
                (the float orb-weight)
                0.1
                base-value
                value-mult
                level-value-mult
                0.5)
              0.5)))
        (levels-below (- jak-level fish-level)))

      (when (= suffix 16)
        (play-sound-file
          "OHHHH.mp3"
          (the int (-> *setting-control* current sfx-volume))))

      (when
        (and
          (> power-cell-task 1)
          (task-complete? *game-info* (the-as game-task power-cell-task)))
        (set! power-cell-task 0)
        (fisher-set-fish-power-cell-task! self slot 0))

      (set! (-> self caught-fish-species) species)
      (set! (-> self caught-fish-suffix) suffix)
      (set! (-> self caught-fish-level) fish-level)
      (set! (-> self caught-weight-tenths) weight)
      (set!
        (-> self caught-orb-value)
        (let* ((final-orb-value
                (cond
                  ((= species 3)
                    (the int (+ (/ (the float raw-orb-value) 3.0) 0.5)))
                  ((= species (the-as int (fisher-species fire-canyon-cellfish)))
                    (the int (+ (/ (the float raw-orb-value) 3.0) 0.5)))
                  (else raw-orb-value)))

            (uncapped-orb-value
              (cond
                ((= suffix 10) 90)

                ((= suffix 7) (+ (max 1 final-orb-value) 35))
                ((= suffix 8) (+ (max 1 final-orb-value) 50))

                ((>= levels-below 5) (max 0 final-orb-value))
                (else (max 1 final-orb-value)))))

          ;; Ordinary fish are capped at 50 calculated orbs, then receive a
          ;; fresh 1-8 orb pull bonus.  True rare fish retain their original
          ;; uncapped payout and do not use this normal-fish cap.
          (if
            (fisher-rare-fish? suffix)
            uncapped-orb-value
            (+
              (min 50 uncapped-orb-value)
              (rand-vu-int-range 1 9)))))
      (set!
        (-> self caught-fish-xp)
        (fisher-accepted-xp-amount catch-xp))
      (set! (-> self caught-power-cell-task) power-cell-task)

      (set! (-> self fish-state) 'catch-return)
      (set! (-> self cast-state) 'catch-transition)
      (set! (-> self catch-transition-time) 0.0)
      (set! (-> self catch-menu-offset) 150.0)
      (set! (-> self camera-state) 'before-cast)
      (set! (-> self casted?) #f)
      (set! (-> self fish-fighting?) #f)
      (fisher-clear-button-fight! self)
      (set! (-> self fish-fight-time) 0.0)
      (set! (-> self fish-fight-phase) 0.0)
      (set! (-> self fish-fight-base-y) 0.0)
      (stop-sound-file "water-waves.wav")
      (fisher-remove-lure-snake! self)

      ;; Inferno Sharks and the vertical Nuclear Bombfish encounter skip the
      ;; ordinary physical return-to-Jak path and go straight to the catch card.
      (when
        (or
          (= species (the-as int (fisher-species inferno-shark)))
          (= species (the-as int (fisher-species nuclear-bombfish))))
        (let ((caught-fish (fisher-fish-pointer self slot)))
          (when caught-fish
            (fisher-destroy-manipy! caught-fish)
            (fisher-set-fish-pointer! self slot (the-as (pointer manipy) #f))))
        (fisher-spawn-catch-display-fish! self)
        (set! (-> self fish-state) 'catch-enter)
        (set! (-> self cast-state) 'catch-display)
        (set! (-> self catch-transition-time) 0.0)
        (set! (-> self catch-menu-offset) 150.0))))

  (none))

