;; Ten one-page gameplay hints used only by the Village fisherman.
;; Each hint occupies exactly four strings.
(define *fisher-man-hint-dialogue-lines*
  (new 'static
    'boxed-array
    :type string

    "PUT SOME BACK INTO YER CAST, LAD!"
    "A FULLER CAST GIVES YE MORE LINE HEALTH."
    "A WEAK TOSS LEAVES LITTLE ROOM"
