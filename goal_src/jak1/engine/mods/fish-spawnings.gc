(defun fisher-configure-village3-table! ((self fisher-game))
  (let* ((zone (fisher-zone-info-for (fisher-zone village3-lava)))
      (golden? (fisher-golden-hour?))
      (drum-count
        (if golden?
          (rand-vu-int-range 6 7)
          (rand-vu-int-range 4 5)))
      (serpent-count (if golden? 4 3))
      (shark-count
        (if golden?
          (rand-vu-int-range 10 14)
          (rand-vu-int-range 8 10)))
      (slot 0))

    (set! (-> self fish-level-min) (-> zone level-min))
    (set! (-> self fish-level-max) (-> zone level-max))
    (set! (-> self fish-count)
      (min *fisher-max-fish-slots* (+ drum-count serpent-count shark-count)))
    (fisher-clear-power-cell-tasks! self)

    (dotimes (i drum-count)
      (when (< slot (-> self fish-count))
        (fisher-configure-random-fish-slot!
          self slot (the-as int (fisher-species lava-drum)))
        (+! slot 1)))

    (dotimes (i serpent-count)
      (when (< slot (-> self fish-count))
        (fisher-configure-random-fish-slot!
          self slot (the-as int (fisher-species magma-serpent)))
        (+! slot 1)))

    (while (< slot (-> self fish-count))
      (fisher-configure-random-fish-slot!
        self slot (the-as int (fisher-species inferno-shark)))
      (+! slot 1)))

  (none))

(defun fisher-configure-snow-table! ((self fisher-game))
  (let* ((zone (fisher-zone-info-for (fisher-zone snow-ice)))
      (golden? (fisher-golden-hour?))
      (frost-count
        (if golden?
          (rand-vu-int-range 5 7)
          (rand-vu-int-range 4 5)))
      (crystal-count
        (if golden?
          (rand-vu-int-range 2 3)
          (rand-vu-int-range 1 2)))
      (shark-count
        (if golden?
          (rand-vu-int-range 12 16)
          (rand-vu-int-range 10 12)))
      (slot 0))

    (set! (-> self fish-level-min) (-> zone level-min))
    (set! (-> self fish-level-max) (-> zone level-max))
    (set! (-> self fish-count)
      (min *fisher-max-fish-slots* (+ frost-count crystal-count shark-count)))
    (fisher-clear-power-cell-tasks! self)

    (dotimes (i frost-count)
      (when (< slot (-> self fish-count))
        (fisher-configure-random-fish-slot!
          self slot (the-as int (fisher-species frost-biter)))
        (+! slot 1)))

    (dotimes (i crystal-count)
      (when (< slot (-> self fish-count))
        (fisher-configure-random-fish-slot!
          self slot (the-as int (fisher-species crystal-fish)))
        (+! slot 1)))

    (while (< slot (-> self fish-count))
      (fisher-configure-random-fish-slot!
        self slot (the-as int (fisher-species ice-shark)))
      (+! slot 1)))

  (none))

(defun fisher-configure-dark-eco-table! ((self fisher-game))
  (let* ((zone (fisher-zone-info-for (fisher-zone maincave-dark-eco)))
      (golden? (fisher-golden-hour?))
      (helix-count
        (if golden?
          (rand-vu-int-range 5 10)
          (rand-vu-int-range 2 10)))
      (fang-count
        (if golden?
          (rand-vu-int-range 6 10)
          (rand-vu-int-range 2 6)))
      (phantasm-count
        (if golden?
          (rand-vu-int-range 2 4)
          (rand-vu-int-range 1 2)))
      (slot 0))

    (set! (-> self fish-level-min) (-> zone level-min))
    (set! (-> self fish-level-max) (-> zone level-max))
    (set! (-> self fish-count)
      (min
        *fisher-max-fish-slots*
        (+ 1 helix-count fang-count phantasm-count)))
    (fisher-clear-power-cell-tasks! self)

    (when (< slot (-> self fish-count))
      (fisher-set-fish-species!
        self slot (the-as int (fisher-species megaloviathan)))
      (fisher-set-fish-suffix! self slot 2)
      (fisher-set-fish-power-cell-task! self slot 0)
      (fisher-set-fish-level! self slot (fisher-roll-level-for-current-zone self))
      (fisher-set-fish-weight-tenths! self slot (rand-vu-int-range 2000 4000))
      (+! slot 1))

    (dotimes (i helix-count)
      (when (< slot (-> self fish-count))
        (fisher-configure-random-fish-slot!
          self slot (the-as int (fisher-species helix-voidfish)))
        (+! slot 1)))

    (dotimes (i fang-count)
      (when (< slot (-> self fish-count))
        (fisher-configure-random-fish-slot!
          self slot (the-as int (fisher-species dark-precursor-fangfish)))
        (+! slot 1)))

    (while (< slot (-> self fish-count))
      (fisher-configure-random-fish-slot!
        self slot (the-as int (fisher-species phantasm-shark)))
      (+! slot 1)))

  (none))

(defun fisher-configure-zone-table! ((self fisher-game))
  (let* ((zone
          (fisher-zone-info-for
            (the-as fisher-zone (-> self location-id))))
         (golden? (fisher-golden-hour?))
         (target-count
          (min
            *fisher-max-fish-slots*
            (if golden?
              (rand-vu-int-range
                (-> zone golden-fish-count-min)
                (-> zone golden-fish-count-max))
              (rand-vu-int-range
                (-> zone normal-fish-count-min)
                (-> zone normal-fish-count-max)))))
         (slot 0)
         (index 0))

    (set! (-> self fish-level-min) (-> zone level-min))
    (set! (-> self fish-level-max) (-> zone level-max))
    (set! (-> self fish-count) target-count)
    (fisher-clear-power-cell-tasks! self)

    (while (and (< index 4) (< slot target-count))
      (let* ((range-max
              (if golden?
                (-> zone golden-max index)
                (-> zone normal-max index)))
             (range-min
              (if golden?
                (-> zone golden-min index)
                (-> zone normal-min index)))
             (species (-> zone species index))
             (count
              (if (> range-max 0)
                (rand-vu-int-range range-min range-max)
                0)))

        (dotimes (i count)
          (when (< slot target-count)
            (fisher-configure-random-fish-slot!
              self
              slot
              species)
            (+! slot 1))))
      (+! index 1))

    (while (< slot target-count)
      (fisher-configure-random-fish-slot!
        self
        slot
        (-> zone species 0))
      (+! slot 1))

    (when
      (and
        (> target-count 0)
        (> (-> zone shark-chance) 0.0)
        (rand-vu-percent? (-> zone shark-chance)))
      (let ((shark-slot (- target-count 1)))
        (fisher-configure-random-fish-slot!
          self
          shark-slot
          (the-as int (fisher-species lurker-shark)))
        (fisher-set-fish-suffix!
          self
          shark-slot
          (fisher-roll-standard-fish-suffix))
        (fisher-set-fish-weight-tenths! self shark-slot 260))))

  (none))

(defun fisher-count-live-species ((self fisher-game) (species int))
  (let ((count 0))
    (dotimes (slot (-> self fish-count))
      (when
        (and
          (= (fisher-fish-species self slot) species)
          (fisher-fish-pointer self slot))
        (+! count 1)))
    count))

(defun fisher-table-species-for-new-slot
  ((self fisher-game) (golden? symbol))

  (when (= (-> self location-id) (the-as int (fisher-zone finalboss-nuclear)))
    (return (the-as int (fisher-species nuclear-bombfish))))

  (when
    (= (-> self location-id) (the-as int (fisher-zone sunken-voltage)))
    (when
      (<
        (fisher-count-live-species
          self
          (the-as int (fisher-species electric-lurker-shark)))
        1)
      (return (the-as int (fisher-species electric-lurker-shark))))

    (let ((grub-weight (if golden? 12 8))
        (eel-weight (if golden? 8 5)))
      (if
        (< (rand-vu-int-range 0 (+ grub-weight eel-weight -1)) grub-weight)
        (return (the-as int (fisher-species electric-grubfish)))
        (return (the-as int (fisher-species electric-eelfish))))))

  (when
    (= (-> self location-id) (the-as int (fisher-zone village2-electric)))
    (when
      (<
        (fisher-count-live-species
          self
          (the-as int (fisher-species electric-lurker-shark)))
        2)
      (return (the-as int (fisher-species electric-lurker-shark))))

    (let ((grub-weight (if golden? 8 4))
        (eel-weight (if golden? 12 8)))
      (if
        (< (rand-vu-int-range 0 (+ grub-weight eel-weight -1)) grub-weight)
        (return (the-as int (fisher-species electric-grubfish)))
        (return (the-as int (fisher-species electric-eelfish))))))

  (when
    (= (-> self location-id) (the-as int (fisher-zone swamp-sludge)))
    (when
      (<
        (fisher-count-live-species
          self
          (the-as int (fisher-species black-lurker-shark)))
        1)
      (return (the-as int (fisher-species black-lurker-shark))))

    (let ((guppie-weight (if golden? 10 6))
        (crappie-weight (if golden? 10 6)))
      (if
        (<
          (rand-vu-int-range
            0
            (+ guppie-weight crappie-weight -1))
          guppie-weight)
        (return (the-as int (fisher-species swamp-guppie)))
        (return (the-as int (fisher-species sludge-crappie))))))

  (when
    (= (-> self location-id) (the-as int (fisher-zone village3-lava)))
    (let ((drum-weight (if golden? 7 5))
        (serpent-weight (if golden? 6 4))
        (shark-weight (if golden? 14 10))
        (roll 0))
      (set! roll
        (rand-vu-int-range
          0
          (+ drum-weight serpent-weight shark-weight -1)))
      (cond
        ((< roll drum-weight)
          (return (the-as int (fisher-species lava-drum))))
        ((< roll (+ drum-weight serpent-weight))
          (return (the-as int (fisher-species magma-serpent))))
        (else
          (return (the-as int (fisher-species inferno-shark)))))))

  (when
    (= (-> self location-id) (the-as int (fisher-zone snow-ice)))
    (let ((frost-weight (if golden? 7 5))
        (crystal-weight (if golden? 3 2))
        (shark-weight (if golden? 16 12))
        (roll 0))
      (set! roll
        (rand-vu-int-range
          0
          (+ frost-weight crystal-weight shark-weight -1)))
      (cond
        ((< roll frost-weight)
          (return (the-as int (fisher-species frost-biter))))
        ((< roll (+ frost-weight crystal-weight))
          (return (the-as int (fisher-species crystal-fish))))
        (else
          (return (the-as int (fisher-species ice-shark)))))))

  (when
    (and
      (or
        (= (-> self location-id) (the-as int (fisher-zone jungle-pillar)))
        (= (-> self location-id) (the-as int (fisher-zone sentinel-pontoon)))
        (= (-> self location-id) (the-as int (fisher-zone misty-island))))
      (<
        (fisher-count-live-species
          self
          (the-as int (fisher-species lurker-shark)))
        1))
    (let ((hub1-zone
            (fisher-zone-info-for
              (the-as fisher-zone (-> self location-id)))))
      (when
        (and
          (> (-> hub1-zone shark-chance) 0.0)
          (rand-vu-percent? (-> hub1-zone shark-chance)))
        (return (the-as int (fisher-species lurker-shark))))))

  (when
    (= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
    (when
      (<
        (fisher-count-live-species
          self
          (the-as int (fisher-species megaloviathan)))
        1)
      (return (the-as int (fisher-species megaloviathan))))

    (let ((helix-weight (if golden? 10 10))
        (fang-weight (if golden? 10 6))
        (phantasm-weight (if golden? 4 2))
        (roll 0))
      (set! roll
        (rand-vu-int-range
          0
          (+ helix-weight fang-weight phantasm-weight -1)))
      (cond
        ((< roll helix-weight)
          (return (the-as int (fisher-species helix-voidfish))))
        ((< roll (+ helix-weight fang-weight))
          (return (the-as int (fisher-species dark-precursor-fangfish))))
        (else
          (return (the-as int (fisher-species phantasm-shark)))))))

  (let* ((zone
          (fisher-zone-info-for
            (the-as fisher-zone (-> self location-id))))
         (w0 (if golden? (-> zone golden-max 0) (-> zone normal-max 0)))
         (w1 (if golden? (-> zone golden-max 1) (-> zone normal-max 1)))
         (w2 (if golden? (-> zone golden-max 2) (-> zone normal-max 2)))
         (w3 (if golden? (-> zone golden-max 3) (-> zone normal-max 3)))
         (total (+ w0 w1 w2 w3)))

    (when (<= total 0)
      (return (-> zone species 0)))

    (let ((roll (rand-vu-int-range 0 (- total 1))))
      (cond
        ((< roll w0) (-> zone species 0))
        ((< roll (+ w0 w1)) (-> zone species 1))
        ((< roll (+ w0 w1 w2)) (-> zone species 2))
        (else (-> zone species 3))))))


(defun fisher-configure-finalboss-table! ((self fisher-game))
  (set! (-> self fish-level-min) 20)
  (set! (-> self fish-level-max) 20)
  (set! (-> self fish-count) 1)
  (fisher-clear-power-cell-tasks! self)

  (fisher-set-fish-species! self 0 (the-as int (fisher-species nuclear-bombfish)))
  (fisher-set-fish-suffix! self 0 2)
  (fisher-set-fish-power-cell-task! self 0 0)
  (fisher-set-fish-level! self 0 20)
  (fisher-set-fish-weight-tenths! self 0 90000)
  (none))

(defun fisher-configure-location-table! ((self fisher-game))
  (cond
    ((= (-> self location-id) (the-as int (fisher-zone finalboss-nuclear)))
      (fisher-configure-finalboss-table! self))
    ((= (-> self location-id) (the-as int (fisher-zone village2-electric)))
      (fisher-configure-village2-table! self))
    ((= (-> self location-id) (the-as int (fisher-zone sunken-voltage)))
      (fisher-configure-sunken-table! self))
    ((= (-> self location-id) (the-as int (fisher-zone swamp-sludge)))
      (fisher-configure-swamp-table! self))
    ((= (-> self location-id) (the-as int (fisher-zone village3-lava)))
      (fisher-configure-village3-table! self))
    ((= (-> self location-id) (the-as int (fisher-zone snow-ice)))
      (fisher-configure-snow-table! self))
    ((= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
      (fisher-configure-dark-eco-table! self))
    (else
      (fisher-configure-zone-table! self)))

  (cond
    ((= (-> self location-id) (the-as int (fisher-zone finalboss-nuclear)))
      (none))

    ((= (-> self location-id) (the-as int (fisher-zone maincave-dark-eco)))
      (fisher-add-buzzer-fish-slots! self)
      (fisher-add-power-cell-fish-slot! self)
      (fisher-add-lava-tube-cellfish-slots! self)
      (fisher-add-citadel-buzzer-cellfish-slot! self))

    ((= (-> self location-id) (the-as int (fisher-zone village3-lava)))
      (fisher-add-buzzer-fish-slots! self)
      (fisher-add-power-cell-fish-slot! self)
      (fisher-add-village3-mountain-pass-cellfish-slots! self))

    ((= (-> self location-id) (the-as int (fisher-zone snow-ice)))
      (fisher-add-buzzer-fish-slots! self)
      (fisher-add-power-cell-fish-slot! self))

    (else
      (when
        (!= (-> self location-id) (the-as int (fisher-zone training-lagoon)))
        (fisher-add-buzzer-fish-slots! self))

      (fisher-add-power-cell-fish-slot! self)
      (fisher-add-fire-canyon-cellfish-slot! self)
      (fisher-add-mountain-pass-cellfish-slots! self)))

  (fisher-refresh-active-slot-levels! self)

  (none))

