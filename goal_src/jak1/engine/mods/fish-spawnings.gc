  (go-virtual swimmer-pontoon-float))

(defun spawn-pontoon-swimmer
  ((spawn-pos vector)
   (pontoon-type int)
   (rotation-degrees float))

  (cond
    ((= pontoon-type 0)
      (process-spawn
        swimmer-pontoonfive
        spawn-pos
        rotation-degrees
        :name "swimmer-pontoonfive"
        *active-pool*))

    ((= pontoon-type 1)
      (process-spawn
        swimmer-pontoonten
        spawn-pos
        rotation-degrees
        :name "swimmer-pontoonten"
        *active-pool*))

    (else
      (format
        0
        "spawn-pontoon-swimmer: invalid type ~D; use 0 or 1.~%"
        pontoon-type)))

  (none))

(defun maintain-training-pontoon! ()
  (let ((inside
        (when *level*
          (level-get-target-inside *level*))))

    (cond
      ((and
          inside
          (= (-> inside name) 'training))

        (when
          (not *training-pontoon-spawned?*)

          (spawn-pontoon-swimmer
            (new 'static 'vector
              :x (meters -1330.3963)
              :y (meters 0.3323)
              :z (meters 925.1775)
              :w 1.0)
            0
            0.0)

          (set! *training-pontoon-spawned?* #t)))

      (else
        (set! *training-pontoon-spawned?* #f))))

  (none))

